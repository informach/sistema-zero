{
  "name": "sistemazero",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci .",
    "dev:tui": "bun run --watch packages/tui/src/index.tsx",
    "build:tui": "bun run --filter @sistemazero/tui build",
    "link:tui": "bun run build:tui && cd packages/tui && bun link",
    "dev:payments": "bun run --filter @sistemazero/payments dev",
    "test:payments": "bun run --filter @sistemazero/payments test",
    "dev:gateway": "bun run --filter @sistemazero/api-gateway dev",
    "test:gateway": "bun run --filter @sistemazero/api-gateway test",
    "dev:auth": "bun run --filter @sistemazero/auth dev",
    "test:auth": "bun run --filter @sistemazero/auth test",
    "db:auth:generate": "bun run --filter @sistemazero/auth db:generate",
    "db:auth:migrate": "bun run --filter @sistemazero/auth db:migrate",
    "dev:funnel": "bun run --filter @sistemazero/funnel dev",
    "build:funnel": "bun run --filter @sistemazero/funnel build",
    "test:funnel": "bun run --filter @sistemazero/funnel test",
    "db:funnel:generate": "bun run --filter @sistemazero/funnel db:generate",
    "db:funnel:migrate": "bun run --filter @sistemazero/funnel db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16"
  }
}
