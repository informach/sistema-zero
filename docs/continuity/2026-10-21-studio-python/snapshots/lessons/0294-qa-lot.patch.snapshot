--- /dev/null
+++ b/packages/community-kids/tests/e2e/windows/python-lesson-browser-owned.ps1
@@ -0,0 +1,99 @@
+param(
+ [ValidateSet('Plan','Run')][string]$Action='Plan',
+ [ValidateSet('adminBrowser','kidsBrowser')][string]$Role='adminBrowser',
+ [string]$ExpectedPlanSha256,[string]$ExpectedEnvSha256,
+ [string]$InputFile,[string]$ExpectedInputSha256,
+ [string]$NextStateFile,[string]$ExpectedNextStateSha256,
+ [datetimeoffset]$WindowEnd,[datetimeoffset]$StartCutoff
+)
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'python-lesson-process-ownership.ps1')
+. (Join-Path $PSScriptRoot 'python-lesson-browser-watch.ps1')
+if($Action -eq 'Plan'){Write-Output 'PREPARED ONLY. No launch, browser, HTTP or credentials read.';return}
+function Refuse-BrowserAdmission([string]$Reason, $Observation){
+ $refusals=Join-Path $PSScriptRoot 'refusals';[IO.Directory]::CreateDirectory($refusals)|Out-Null
+ Write-Durable @{state='admission-refused-before-start';role=$Role;reason=$Reason;observation=$Observation;at=[datetimeoffset]::UtcNow.ToString('o');runnerStarted=$false;browserStarted=$false} (Join-Path $refusals ($Role+'-'+[guid]::NewGuid().ToString('N')+'.json')) -Exclusive
+ throw $Reason
+}
+if($PSVersionTable.PSVersion -lt [version]'7.5'){throw 'PowerShell 7.5+ required'}
+$planPath=Join-Path $PSScriptRoot 'windows-plan.json'
+if((Get-FileHash -LiteralPath $planPath -Algorithm SHA256).Hash.ToLowerInvariant() -cne $ExpectedPlanSha256){throw 'Reviewed bound plan SHA required'}
+$plan=Get-Content -LiteralPath $planPath -Raw|ConvertFrom-Json -DateKind String
+if($plan.state -ne 'bound-to-actual-new-host-canonical-policy'){throw 'Actual fresh host bind required'}
+foreach($pin in $plan.hostPins){if((Get-FileHash -LiteralPath $pin.path -Algorithm SHA256).Hash.ToLowerInvariant() -cne $pin.sha256){throw 'Pinned input changed'}}
+$spec=$plan.roles.$Role
+if(-not $spec -or $spec.entryExport -cne $(if($Role -eq 'adminBrowser'){'runPythonLessonAdmin'}else{'runPythonLessonKids'})){throw 'Closed browser role/export required'}
+$envPath=Join-Path $PSScriptRoot "envs/$Role.json"
+if((Get-FileHash -LiteralPath $envPath -Algorithm SHA256).Hash.ToLowerInvariant() -cne $ExpectedEnvSha256){throw 'Reviewed browser environment SHA required'}
+$configuration=Get-Content -LiteralPath $envPath -Raw|ConvertFrom-Json
+if($configuration.role -cne $Role -or $configuration.version -ne 1 -or $configuration.env.PSObject.Properties.Name -ne 'NODE_ENV'){throw 'Closed browser environment required; credentials never belong in files'}
+$InputFile=[IO.Path]::GetFullPath($InputFile)
+$cachePrefix=[IO.Path]::GetFullPath((Join-Path $spec.cwd '.cache'))+[IO.Path]::DirectorySeparatorChar
+if(-not $InputFile.StartsWith($cachePrefix,[StringComparison]::OrdinalIgnoreCase)){throw 'Input must be an own QA cache file'}
+if((Get-FileHash -LiteralPath $InputFile -Algorithm SHA256).Hash.ToLowerInvariant() -cne $ExpectedInputSha256){throw 'Reviewed scenario input SHA required'}
+$NextStateFile=Owned-StatePath $NextStateFile
+if((Get-FileHash -LiteralPath $NextStateFile -Algorithm SHA256).Hash.ToLowerInvariant() -cne $ExpectedNextStateSha256){throw 'Exact Next state SHA required'}
+$next=Get-Content -LiteralPath $NextStateFile -Raw|ConvertFrom-Json -DateKind String
+$expectedNext=if($Role -eq 'adminBrowser'){'adminNext'}else{'kidsNext'}
+if($next.owner -cne $plan.owner -or $next.run -cne $plan.run -or $next.role -cne $expectedNext -or -not(Same-Witness $next.root (Process-Witness $next.root.processId))){throw 'Own live Next root witness required'}
+if($plan.roles.$expectedNext.prefixArgv.Count -ne 1 -or $plan.roles.$expectedNext.prefixArgv[0] -cne '--max-old-space-size=1536'){throw 'Reviewed Next heap1536 required'}
+if($next.root.executable -cne $plan.roles.$expectedNext.binary -or -not $next.root.cli.Contains($plan.adapter) -or -not $next.root.cli.Contains('--max-old-space-size=1536')){throw 'Next actual launch shape differs from reviewed heap/adapter'}
+foreach($oldState in @(Get-ChildItem -LiteralPath (Join-Path $PSScriptRoot 'windows-jobs') -Filter owned-process.json -Recurse -ErrorAction SilentlyContinue)) {
+ $old=Get-Content -LiteralPath $oldState.FullName -Raw|ConvertFrom-Json -DateKind String
+ if($old.role -in @('adminBrowser','kidsBrowser')){
+  foreach($w in @($old.root)+@($old.observedTree)){if($w -and (Same-Witness $w (Process-Witness $w.processId))){throw 'Another own browser tree is still present'}}
+ }
+}
+$now=[datetimeoffset]::UtcNow
+if($now -ge $StartCutoff -or $now.AddSeconds(360) -gt $WindowEnd){throw 'No remaining granted six-minute browser interval'}
+$deadline=$now.AddSeconds(360);$softDeadline=$deadline.AddSeconds(-30)
+$known=@{};$known["$($next.root.processId):$($next.root.createdAt)"]=$next.root
+do{$before=$known.Count;Capture-OwnedTree $next.root $known}while($known.Count -gt $before)
+$nextWorking=0.0
+foreach($w in $known.Values){if(-not(Same-Witness $w (Process-Witness $w.processId))){throw 'Next tree changed during admission'};$nextWorking+=(Get-Process -Id $w.processId -ErrorAction Stop).WorkingSet64/1MB}
+$audience=if($Role -eq 'adminBrowser'){'admin'}else{'kids'}
+$browserMiB=if($Role -eq 'adminBrowser'){1024}else{1536}
+if($nextWorking -gt 2048){Refuse-BrowserAdmission 'Next exceeded the approved fixed attempt envelope' @{nextTreeWorkingSetMiB=$nextWorking;nextTreeBudgetMiB=2048}}
+$requiredFree=[math]::Ceiling(($browserMiB+[math]::Max(0,2048-$nextWorking)+256+512)/256)*256
+$freeMiB=[double](Get-CimInstance Win32_OperatingSystem -Property FreePhysicalMemory).FreePhysicalMemory/1024
+if($freeMiB -lt $requiredFree){Refuse-BrowserAdmission 'Browser incremental preflight refused' @{nextTreeWorkingSetMiB=$nextWorking;observedFreeMiB=$freeMiB;requiredFreeMiB=$requiredFree}}
+$jobDir=Join-Path $PSScriptRoot ('windows-jobs/'+$Role+'-'+[guid]::NewGuid().ToString('N'));New-Item -ItemType Directory -Path $jobDir -ErrorAction Stop|Out-Null
+$admissionPath=Join-Path $jobDir 'admission.json'
+$admission=@{version=1;role=$audience;attemptId=[guid]::NewGuid().ToString();reviewedPlanSha256=$ExpectedPlanSha256;observedAt=[datetimeoffset]::UtcNow.ToString('o');nextTree=@{role=$expectedNext;processId=$next.root.processId;createdAt=$next.root.createdAt;executable=$next.root.executable;cliSha256=$next.root.cliSha256;workingSetMiB=$nextWorking};envelopes=@{browserMiB=$browserMiB;nextTreeMiB=2048;retainedBaseGrowthMiB=256;hostReserveMiB=512}}
+Write-Durable $admission $admissionPath -Exclusive
+$admissionSha=(Get-FileHash -LiteralPath $admissionPath -Algorithm SHA256).Hash.ToLowerInvariant()
+$homeDir=Join-Path $jobDir 'home';New-Item -ItemType Directory -Path $homeDir -ErrorAction Stop|Out-Null
+$StateFile=Join-Path $jobDir 'owned-process.json'
+$job=@{version=1;owner=$plan.owner;run=$plan.run;nonce=[guid]::NewGuid().ToString('N');role=$Role;cwd=$spec.cwd;entry=$spec.entry;entrySha256=$spec.entrySha256;entryExport=$spec.entryExport;argv=@($InputFile,(Join-Path $jobDir 'scenario'),$admissionPath,$admissionSha);stopRequest=(Join-Path $jobDir 'stop.request');signalReceipt=(Join-Path $jobDir 'signal.json');failureReceipt=(Join-Path $jobDir 'failure.json');claimFile=(Join-Path $jobDir 'owner.claim.json');claimReceipt=(Join-Path $jobDir 'claim-accepted.json');stateFile=$StateFile;envFile=$envPath;envSha256=$ExpectedEnvSha256;cleanPath=$plan.cleanPath;home=$homeDir;runComplete=(Join-Path $jobDir 'run-complete.json');completionAck=(Join-Path $jobDir 'completion-ack.json')}
+$jobPath=Join-Path $jobDir 'job.json';Write-Durable $job $jobPath -Exclusive
+$bootstrapEnv=@{NODE_OPTIONS='';BUN_OPTIONS='';NODE_PATH='';NODE_V8_COVERAGE='';NODE_USE_ENV_PROXY='';HTTP_PROXY='';HTTPS_PROXY='';ALL_PROXY='';HOME=$homeDir;USERPROFILE=$homeDir;PATH=$plan.cleanPath;NODE_ENV='test'}
+$credentialKeys=if($Role -eq 'adminBrowser'){@('STUDIO_LESSONS_QA_ADMIN_EMAIL','STUDIO_LESSONS_QA_ADMIN_PASSWORD')}else{@('STUDIO_LESSONS_QA_PARENT_EMAIL','STUDIO_LESSONS_QA_PARENT_PASSWORD','STUDIO_LESSONS_QA_LEARNER_ID')}
+foreach($key in $credentialKeys){$value=[Environment]::GetEnvironmentVariable($key);if(-not $value){throw 'Missing in-memory QA credentials'};$bootstrapEnv[$key]=$value}
+$argv=@($spec.prefixArgv)+@($plan.adapter,$jobPath)
+if(@($argv|Where-Object{$_ -match '[\s"]'}).Count){throw 'Reviewed fixed Windows argv shape required'}
+$process=$null
+try {
+ if([datetimeoffset]::UtcNow -ge $StartCutoff){throw 'Start cutoff passed during browser preflight'}
+ $process=Start-Process -FilePath $spec.binary -ArgumentList $argv -WorkingDirectory $spec.cwd -WindowStyle Hidden -PassThru -Environment $bootstrapEnv -RedirectStandardOutput (Join-Path $jobDir 'stdout.log') -RedirectStandardError (Join-Path $jobDir 'stderr.log')
+ $handle=$process.SafeHandle
+ if($handle.IsInvalid -or $handle.IsClosed){throw 'Exact newly launched handle required'}
+ $root=Process-Witness $process.Id
+ if(-not $root -or $root.executable -cne $spec.binary -or -not $root.cli.Contains($plan.adapter) -or -not $root.cli.Contains($jobPath)){throw 'Exact new browser runner witness required'}
+ $state=[pscustomobject]@{version=2;nonce=$job.nonce;owner=$plan.owner;run=$plan.run;role=$Role;status='witnessed-awaiting-app';root=$root;envSha256=$ExpectedEnvSha256;inputSha256=$ExpectedInputSha256;admissionSha256=$admissionSha;ports=@();observedTree=@();forced=$false;stopRequest=$job.stopRequest}
+ Save $state $StateFile
+ $pendingClaim=Join-Path $jobDir 'owner.claim.pending.json'
+ Write-Durable @{version=1;nonce=$job.nonce;pid=$process.Id;stateSha256=(Get-FileHash -LiteralPath $StateFile -Algorithm SHA256).Hash.ToLowerInvariant()} $pendingClaim -Exclusive
+ [IO.File]::Move($pendingClaim,$job.claimFile,$false)
+} catch {
+ # Before claim the adapter cannot import a scenario or create Chrome.
+ if($process -and -not(Test-Path -LiteralPath $job.claimFile) -and -not $process.HasExited){$process.Kill($true);$process.WaitForExit(5000)|Out-Null}
+ throw
+} finally {
+ foreach($key in $credentialKeys){$bootstrapEnv.Remove($key)}
+}
+Write-Output "START $Role PID=$($process.Id) deadline=$($deadline.ToString('o')); state=$StateFile"
+try {
+ $result=Watch-OwnedBrowser $process $state $StateFile $job $softDeadline $deadline
+ Write-Output "END $Role state=$($result.status) exit=$($result.processExitCode); stateFile=$StateFile"
+ if($result.status -ne 'completed-owned-tree-exited'){exit 1}
+} finally {$process.Dispose()}
diff --git a/packages/community-kids/tests/e2e/windows/python-lesson-browser-watch.ps1 b/packages/community-kids/tests/e2e/windows/python-lesson-browser-watch.ps1
new file mode 100644
index 000000000..e526fe05f
--- /dev/null
+++ b/packages/community-kids/tests/e2e/windows/python-lesson-browser-watch.ps1
@@ -0,0 +1,200 @@
+# Extends the existing witnessed operator protocol; no launch happens on import.
+function Retain-OwnedProcess($Witness, [Diagnostics.Process]$ExistingProcess=$null) {
+ $candidate=$ExistingProcess;$ownsProcess=$null -eq $ExistingProcess;$retained=$false
+ try {
+  if(-not $candidate){$candidate=[Diagnostics.Process]::GetProcessById($Witness.processId)}
+  # Pin the kernel process object before validating creation. Never reopen at stop.
+  $handle=$candidate.SafeHandle
+  if($handle.IsClosed -or $handle.IsInvalid -or $candidate.HasExited -or $candidate.Id -ne $Witness.processId){return $null}
+  $createdTicks=$candidate.StartTime.ToUniversalTime().Ticks
+  $witnessTicks=([datetimeoffset]$Witness.createdAt).UtcTicks
+  # CIM truncates its creation time to microseconds; Process exposes 100ns ticks.
+  if(($createdTicks-($createdTicks%10)) -ne ($witnessTicks-($witnessTicks%10))){return $null}
+  $retained=$true
+  return [pscustomobject]@{process=$candidate;safeHandle=$handle;processId=$candidate.Id;createdTicks=$createdTicks;ownsProcess=$ownsProcess}
+ } catch {return $null}
+ finally {if(-not $retained -and $ownsProcess -and $candidate){$candidate.Dispose()}}
+}
+
+function Retained-OwnedProcessObservation($Record) {
+ try {
+  if(-not $Record -or $Record.safeHandle.IsClosed -or $Record.safeHandle.IsInvalid){throw 'Retained process handle is unavailable'}
+  $Record.process.Refresh()
+  $hasExited=$Record.process.HasExited
+  if($hasExited -isnot [bool]){throw 'Retained process exit observation is unavailable'}
+  if($hasExited){return [pscustomobject]@{state='exited';failureName=$null}}
+  if($Record.process.Id -ne $Record.processId -or $Record.process.StartTime.ToUniversalTime().Ticks -ne $Record.createdTicks){throw 'Retained process identity is unconfirmed'}
+  return [pscustomobject]@{state='alive';failureName=$null}
+ } catch {return [pscustomobject]@{state='unknown';failureName=$_.Exception.GetType().Name}}
+}
+
+function Retained-OwnedProcessAlive($Record) {
+ if(-not $Record){return $false}
+ $observation=Retained-OwnedProcessObservation $Record
+ if($observation.state -eq 'unknown'){throw 'Retained process observation is unknown; exit is not confirmed.'}
+ return $observation.state -eq 'alive'
+}
+
+function Stop-RetainedOwnedProcess($Record) {
+ if(-not(Retained-OwnedProcessAlive $Record)){return $false}
+ # This exact Process retains its SafeHandle. No PID lookup/check-then-stop gap.
+ $Record.process.Kill()
+ return $true
+}
+
+function Save-OwnedMonitorResult($State, [string]$StateFile) {
+ try {Save $State $StateFile}
+ catch {
+  $State.status='NEG-monitor-persistence'
+  if(-not $State.primaryFailure){$State.primaryFailure='monitor-result-persistence-failed'}
+  $State.secondaryFailures+=@{phase='result-save';name=$_.Exception.GetType().Name}
+  $State.persistenceFallback=Join-Path (Split-Path $StateFile) 'monitor-failure.json'
+  try{Write-Durable $State $State.persistenceFallback -Exclusive:(-not(Test-Path -LiteralPath $State.persistenceFallback))}
+  catch{[Console]::Error.WriteLine('NEG: monitor result and fallback could not be persisted; inspect owned cleanup.');throw}
+ }
+}
+
+function Reconcile-RetainedOwnedProcesses($State,$Known,$Retained) {
+ $live=@();$exited=@();$unconfirmed=@($Known.Values|Where-Object{-not $Retained.ContainsKey("$($_.processId):$($_.createdAt)")}|ForEach-Object{$_.processId})
+ foreach($record in $Retained.Values){
+  $observation=Retained-OwnedProcessObservation $record
+  if($observation.state -eq 'alive'){$live+= $record.processId}
+  elseif($observation.state -eq 'exited'){$exited+= $record.processId}
+  elseif($observation.state -eq 'unknown'){
+   $unconfirmed+= $record.processId
+   $State.secondaryFailures+=@{phase='reconciliation-observation';processId=$record.processId;name=$observation.failureName}
+  }
+ }
+ if($unconfirmed.Count){$State.ownershipComplete=$false;if(-not $State.primaryFailure){$State.primaryFailure='retained-process-exit-unconfirmed'}}
+ $State.liveOwned=@($live);$State.provenExitedProcessIds=@($exited);$State.unconfirmedProcessIds=@($unconfirmed|Select-Object -Unique)
+ $State.cleanupConfirmed=$State.ownershipComplete -and -not $live.Count -and -not $unconfirmed.Count
+}
+
+function Capture-OwnedTree($Root, $Known, $Retained=$null) {
+ foreach($parent in @($Known.Values)) {
+  $current=Process-Witness $parent.processId
+  if(-not(Same-Witness $parent $current)){
+   $record=if($null -ne $Retained){$Retained["$($parent.processId):$($parent.createdAt)"]}else{$null}
+   if(Retained-OwnedProcessAlive $record){throw 'Live retained parent has no matching CIM witness; descendant discovery unconfirmed.'}
+   continue
+  }
+  foreach($child in @(Get-CimInstance Win32_Process -Filter "ParentProcessId=$($parent.processId)" -ErrorAction Stop)) {
+   $w=Process-Witness $child.ProcessId
+   if($w -and [datetimeoffset]$w.createdAt -ge [datetimeoffset]$parent.createdAt) {
+    $key="$($w.processId):$($w.createdAt)"
+    if(-not $Known.ContainsKey($key)){
+     $Known[$key]=$w
+     if($null -ne $Retained){$record=Retain-OwnedProcess $w;if($record){$Retained[$key]=$record}}
+    }
+   }
+  }
+ }
+}
+
+function Watch-OwnedBrowser($Process, $State, [string]$StateFile, $Job, [datetimeoffset]$SoftDeadline, [datetimeoffset]$HardDeadline) {
+ $known=@{};$known["$($State.root.processId):$($State.root.createdAt)"]=$State.root
+ $retained=@{};$rootRecord=$null
+ $stopRequested=$false;$complete=$null;$acknowledged=$false;$earlyExit=$false;$completionStableRounds=0
+ $State|Add-Member -NotePropertyMembers @{hardDeadline=$HardDeadline.ToString('o');softDeadline=$SoftDeadline.ToString('o');maxSampledTreeWorkingSetMiB=0;maxSampledTreePrivateMiB=0;primaryFailure=$null;secondaryFailures=@();processExitCode=$null;scenarioExitCode=$null;liveOwned=@();completedAt=$null;retainedHandleCount=0;descendantHandlesReleased=$false;monitorFailureName=$null;ownershipComplete=$true;cleanupConfirmed=$false;provenExitedProcessIds=@();unconfirmedProcessIds=@();persistenceFallback=$null} -Force
+ try {
+ $rootRecord=Retain-OwnedProcess $State.root $Process
+ if(-not $rootRecord){throw 'Cannot retain the witnessed root process object'}
+ $retained["$($State.root.processId):$($State.root.createdAt)"]=$rootRecord
+ # The adapter verifies the original state SHA before accepting the claim.
+ # Do not rewrite that state until it has durably acknowledged the claim.
+ while(-not(Test-Path -LiteralPath $Job.claimReceipt) -and (Same-Witness $State.root (Process-Witness $State.root.processId)) -and [datetimeoffset]::UtcNow -lt $HardDeadline){Start-Sleep -Milliseconds 25}
+ while($true) {
+  # Repeat discovery until every newly found parent has been visited this round.
+  do{$before=$known.Count;Capture-OwnedTree $State.root $known $retained}while($known.Count -gt $before)
+  $State.retainedHandleCount=$retained.Count
+  $live=[Collections.Generic.List[object]]::new();$working=0.0;$private=0.0
+  foreach($w in @($known.Values)) {
+   $record=$retained["$($w.processId):$($w.createdAt)"]
+   if(-not $record){
+    if(Same-Witness $w (Process-Witness $w.processId)){$live.Add($w);$State.ownershipComplete=$false;if(-not $State.primaryFailure){$State.primaryFailure='live-descendant-handle-unavailable; refuse PID-only stop'}}
+    continue
+   }
+   if(-not(Retained-OwnedProcessAlive $record)){continue}
+   $live.Add($w)
+   $metrics=$record.process
+   if($metrics){$working+=$metrics.WorkingSet64/1MB;$private+=$metrics.PrivateMemorySize64/1MB}
+  }
+  $State.maxSampledTreeWorkingSetMiB=[math]::Max($State.maxSampledTreeWorkingSetMiB,[math]::Round($working,2))
+  $State.maxSampledTreePrivateMiB=[math]::Max($State.maxSampledTreePrivateMiB,[math]::Round($private,2))
+  $State.observedTree=@($known.Values|ForEach-Object{[pscustomobject]@{processId=$_.processId;parentId=$_.parentId;createdAt=$_.createdAt;executable=$_.executable;cliSha256=$_.cliSha256}})
+  $State.liveOwned=@($live|ForEach-Object{$_.processId})
+  if(-not $complete -and (Test-Path -LiteralPath $Job.runComplete)) {
+   $complete=Get-Content -LiteralPath $Job.runComplete -Raw|ConvertFrom-Json -DateKind String
+   if($complete.pid -ne $State.root.processId -or $complete.nonce -cne $Job.nonce){throw 'Completion identity mismatch'}
+   $State.scenarioExitCode=[int]$complete.exitCode
+  }
+  $rootAlive=Retained-OwnedProcessAlive $rootRecord
+  if(-not $rootAlive -and -not $acknowledged) {
+   if(-not $earlyExit){$HardDeadline=[datetimeoffset]::MinValue.AddTicks([math]::Min($HardDeadline.Ticks,[datetimeoffset]::UtcNow.AddSeconds(30).Ticks))}
+   $earlyExit=$true
+   if(-not $State.primaryFailure){$State.primaryFailure='root-exited-before-completion-ack; descendant completeness unconfirmed'}
+  }
+  # A private Windows console host can only exit after its owning runner exits.
+  # Keep it in the witnessed tree and final reconciliation, but do not deadlock
+  # completion acknowledgement on that root-bound platform helper.
+  $consoleHost=Join-Path ([Environment]::GetFolderPath('System')) 'conhost.exe'
+  $children=@($live|Where-Object{ $_.processId -ne $State.root.processId -and -not($_.parentId -eq $State.root.processId -and [string]::Equals($_.executable,$consoleHost,[StringComparison]::OrdinalIgnoreCase)) })
+  if($complete -and $rootAlive -and -not $children.Count){$completionStableRounds++}else{$completionStableRounds=0}
+  if($completionStableRounds -ge 2 -and -not $acknowledged) {
+   # The adapter polls the final name before parsing: never expose partial JSON.
+   $pendingAck=$Job.completionAck+'.pending'
+   Write-Durable @{pid=$State.root.processId;nonce=$Job.nonce;at=[datetimeoffset]::UtcNow.ToString('o')} $pendingAck -Exclusive
+   [IO.File]::Move($pendingAck,$Job.completionAck,$false)
+   $acknowledged=$true
+  }
+  $Process.Refresh()
+  if($Process.HasExited){$State.processExitCode=$Process.ExitCode}
+  if(-not $live.Count) {break}
+  $now=[datetimeoffset]::UtcNow
+  if(($now -ge $SoftDeadline -or $earlyExit) -and -not $stopRequested) {
+   if(-not $State.primaryFailure){$State.primaryFailure='external-browser-deadline'}
+   if($rootAlive -and -not(Test-Path -LiteralPath $Job.stopRequest)){Write-Durable @{requestedAt=$now.ToString('o')} $Job.stopRequest -Exclusive}
+   $stopRequested=$true
+  }
+  if($now -ge $HardDeadline) {
+   if(-not $State.primaryFailure){$State.primaryFailure='external-browser-hard-deadline'}
+   # Only identities captured below this exact witnessed root are eligible.
+   # Forced cleanup is always NEG, even if every process exits afterward.
+   foreach($w in @($live|Sort-Object createdAt -Descending)) {
+    $record=$retained["$($w.processId):$($w.createdAt)"]
+    try{if(Stop-RetainedOwnedProcess $record){$State.forced=$true}}
+    catch{$State.ownershipComplete=$false;$State.secondaryFailures+=@{processId=$w.processId;name=$_.Exception.GetType().Name}}
+   }
+   break
+  }
+  $State.status='monitoring-owned-browser-tree';Save $State $StateFile
+  Start-Sleep -Milliseconds 100
+ }
+ Reconcile-RetainedOwnedProcesses $State $known $retained
+ $Process.Refresh()
+ if($Process.HasExited){$State.processExitCode=$Process.ExitCode}
+ $State.completedAt=[datetimeoffset]::UtcNow.ToString('o')
+ $State.status=if(-not $State.ownershipComplete -or $State.unconfirmedProcessIds.Count){'NEG-owned-cleanup-unconfirmed'}elseif($State.liveOwned.Count){'NEG-live-owned-residuals'}elseif($earlyExit -or $State.forced -or $State.primaryFailure){'NEG-abrupt-or-deadline-cleanup'}elseif(-not $acknowledged -or $State.scenarioExitCode -ne 0 -or $State.processExitCode -ne 0){'NEG-scenario-or-exit'}else{'completed-owned-tree-exited'}
+ } catch {
+  $State.monitorFailureName=$_.Exception.GetType().Name
+  if(-not $State.primaryFailure){$State.primaryFailure='owned-browser-monitor-failed'}
+  $State.status='NEG-monitor-failure';$State.ownershipComplete=$false
+  # Persist NEG before attempting cleanup. A broken state path must not bypass it.
+  try{Save-OwnedMonitorResult $State $StateFile}catch{$State.secondaryFailures+=@{phase='failure-save';name=$_.Exception.GetType().Name}}
+  try{if(Retained-OwnedProcessAlive $rootRecord){if(-not(Test-Path -LiteralPath $Job.stopRequest)){Write-Durable @{requestedAt=[datetimeoffset]::UtcNow.ToString('o');reason='monitor-failure'} $Job.stopRequest -Exclusive}}}catch{$State.secondaryFailures+=@{phase='stop-request';name=$_.Exception.GetType().Name}}
+  # Discovery may have failed, so act only on kernel objects already retained.
+  foreach($record in @($retained.Values|Sort-Object createdTicks -Descending)){
+   try{if(Stop-RetainedOwnedProcess $record){$State.forced=$true}}catch{$State.secondaryFailures+=@{phase='failure-cleanup';processId=$record.processId;name=$_.Exception.GetType().Name}}
+  }
+  Reconcile-RetainedOwnedProcesses $State $known $retained
+  $State.observedTree=@($known.Values|ForEach-Object{[pscustomobject]@{processId=$_.processId;parentId=$_.parentId;createdAt=$_.createdAt;executable=$_.executable;cliSha256=$_.cliSha256}})
+  try{$Process.Refresh();if($Process.HasExited){$State.processExitCode=$Process.ExitCode}}catch{$State.secondaryFailures+=@{phase='root-exit-observation';name=$_.Exception.GetType().Name};$State.unconfirmedProcessIds=@($State.unconfirmedProcessIds+$State.root.processId|Select-Object -Unique);$State.cleanupConfirmed=$false}
+  $State.retainedHandleCount=$retained.Count
+  $State.completedAt=[datetimeoffset]::UtcNow.ToString('o')
+ } finally {
+  foreach($record in $retained.Values){if($record.ownsProcess){$record.process.Dispose()}}
+  $State.descendantHandlesReleased=$true
+ }
+ Save-OwnedMonitorResult $State $StateFile
+ return $State
+}
diff --git a/packages/community-kids/tests/e2e/windows/python-lesson-process-ownership.ps1 b/packages/community-kids/tests/e2e/windows/python-lesson-process-ownership.ps1
new file mode 100644
index 000000000..25278617a
--- /dev/null
+++ b/packages/community-kids/tests/e2e/windows/python-lesson-process-ownership.ps1
@@ -0,0 +1,21 @@
+function Process-Witness([int]$ProcessId){
+ $p=Get-CimInstance Win32_Process -Filter "ProcessId=$ProcessId" -ErrorAction Stop
+ if(-not $p){return $null}
+ if(-not $p.ExecutablePath -or -not $p.CommandLine){throw 'No complete process witness; refuse ownership inference.'}
+ $bytes=[Text.Encoding]::UTF8.GetBytes($p.CommandLine);$hash=[Security.Cryptography.SHA256]::Create()
+ try{$cliSha=[BitConverter]::ToString($hash.ComputeHash($bytes)).Replace('-','').ToLowerInvariant()}finally{$hash.Dispose()}
+ return [pscustomobject]@{processId=[int]$p.ProcessId;parentId=[int]$p.ParentProcessId;createdAt=$p.CreationDate.ToUniversalTime().ToString('o');executable=$p.ExecutablePath;cliSha256=$cliSha;cli=$p.CommandLine}
+}
+function Same-Witness($before,$after){return $after -and $before.processId -eq $after.processId -and $before.createdAt -eq $after.createdAt -and $before.executable -eq $after.executable -and $before.cliSha256 -eq $after.cliSha256}
+function Write-Durable($value,[string]$path,[switch]$Exclusive){
+ $bytes=[Text.UTF8Encoding]::new($false).GetBytes(($value|ConvertTo-Json -Depth 12))
+ $mode=if($Exclusive){[IO.FileMode]::CreateNew}else{[IO.FileMode]::Create}
+ $stream=[IO.File]::Open($path,$mode,[IO.FileAccess]::Write,[IO.FileShare]::Read)
+ try{$stream.Write($bytes,0,$bytes.Length);$stream.Flush($true)}finally{$stream.Dispose()}
+}
+function Save($state,$path){Write-Durable $state $path}
+function Owned-StatePath([string]$path){
+ $absolute=[IO.Path]::GetFullPath($path);$prefix=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot 'windows-jobs'))+[IO.Path]::DirectorySeparatorChar
+ if(-not $absolute.StartsWith($prefix,[StringComparison]::OrdinalIgnoreCase)){throw 'State must be in this namespace windows-jobs.'}
+ return $absolute
+}
diff --git a/packages/community-kids/tests/e2e/windows/python-lesson-windows-entry.mjs b/packages/community-kids/tests/e2e/windows/python-lesson-windows-entry.mjs
new file mode 100644
index 000000000..024bcfd6c
--- /dev/null
+++ b/packages/community-kids/tests/e2e/windows/python-lesson-windows-entry.mjs
@@ -0,0 +1,162 @@
+// Trusted QA lifetime adapter; does not intercept auth/runtime/provider behavior.
+import { createHash } from 'node:crypto'
+import { existsSync, readFileSync, renameSync, writeFileSync } from 'node:fs'
+import { setTimeout as delay } from 'node:timers/promises'
+import { pathToFileURL } from 'node:url'
+
+const job = JSON.parse(readFileSync(process.argv[2], 'utf8'))
+const sha = (bytes) => createHash('sha256').update(bytes).digest('hex')
+let requested = false
+let phase = 'preclaim'
+try {
+  if (sha(readFileSync(job.entry)) !== job.entrySha256) throw new Error('Trusted QA entry changed')
+  const envBytes = readFileSync(job.envFile)
+  if (sha(envBytes) !== job.envSha256) throw new Error('Reviewed QA environment changed')
+  const environment = JSON.parse(envBytes.toString('utf8'))
+  if (environment.version !== 1 || environment.role !== job.role)
+    throw new Error('QA environment role mismatch')
+  const browserExports = {
+    adminBrowser: 'runPythonLessonAdmin',
+    kidsBrowser: 'runPythonLessonKids',
+  }
+  const credentialKeys = {
+    adminBrowser: ['STUDIO_LESSONS_QA_ADMIN_EMAIL', 'STUDIO_LESSONS_QA_ADMIN_PASSWORD'],
+    kidsBrowser: [
+      'STUDIO_LESSONS_QA_PARENT_EMAIL',
+      'STUDIO_LESSONS_QA_PARENT_PASSWORD',
+      'STUDIO_LESSONS_QA_LEARNER_ID',
+    ],
+  }
+  const ephemeral = {}
+  if (job.entryExport) {
+    if (browserExports[job.role] !== job.entryExport)
+      throw new Error('Closed browser export required')
+    for (const key of credentialKeys[job.role]) {
+      if (!process.env[key]) throw new Error('Missing in-memory QA credential')
+      ephemeral[key] = process.env[key]
+    }
+  }
+  const platform = Object.fromEntries(
+    ['SystemRoot', 'WINDIR', 'TEMP', 'TMP', 'COMSPEC']
+      .filter((key) => process.env[key])
+      .map((key) => [key, process.env[key]]),
+  )
+  for (const key of Object.keys(process.env)) delete process.env[key]
+  Object.assign(process.env, platform, environment.env, ephemeral, {
+    PATH: job.cleanPath,
+    USERPROFILE: job.home,
+    HOME: job.home,
+  })
+
+  // No application import, child, listener, port or remote work before durable claim.
+  // Referenced polling keeps this adapter alive only for this bounded handshake.
+  const deadline = performance.now() + 10_000
+  while (!existsSync(job.claimFile)) {
+    if (performance.now() >= deadline) throw new Error('QA owner claim deadline')
+    await delay(25)
+  }
+  if (performance.now() >= deadline) throw new Error('QA owner claim arrived after deadline')
+  const claim = JSON.parse(readFileSync(job.claimFile, 'utf8'))
+  const stateBytes = readFileSync(job.stateFile)
+  const state = JSON.parse(stateBytes.toString('utf8'))
+  if (
+    claim.version !== 1 ||
+    claim.pid !== process.pid ||
+    claim.nonce !== job.nonce ||
+    claim.stateSha256 !== sha(stateBytes) ||
+    state.root.processId !== process.pid ||
+    state.nonce !== job.nonce ||
+    state.owner !== job.owner ||
+    state.run !== job.run ||
+    state.status !== 'witnessed-awaiting-app' ||
+    state.role !== job.role
+  )
+    throw new Error('QA owner claim mismatch')
+  if (existsSync(job.stopRequest)) throw new Error('QA stop requested before app import')
+  writeFileSync(
+    job.claimReceipt,
+    JSON.stringify({
+      state: 'claim-accepted-not-ready',
+      pid: process.pid,
+      nonce: job.nonce,
+      at: new Date().toISOString(),
+    }),
+    { flag: 'wx' },
+  )
+  process.chdir(job.cwd)
+  process.argv = [process.execPath, job.entry, ...job.argv]
+  let delivered = false
+  const watch = setInterval(() => {
+    if (!existsSync(job.stopRequest)) return
+    requested = true
+    if (!delivered && process.listenerCount('SIGTERM') > 0) {
+      delivered = true
+      clearInterval(watch)
+      writeFileSync(
+        job.signalReceipt,
+        JSON.stringify({
+          state: 'delivered-to-existing-app-handler',
+          at: new Date().toISOString(),
+          pid: process.pid,
+          role: job.role,
+          method: 'QA file request -> existing SIGTERM event handler; not a native OS signal',
+        }),
+        { flag: 'wx' },
+      )
+      process.emit('SIGTERM')
+    }
+  }, 100)
+  watch.unref()
+  phase = 'app-import'
+  const entry = await import(pathToFileURL(job.entry).href)
+  if (job.entryExport) {
+    await entry[job.entryExport]()
+    const pendingCompletion = `${job.runComplete}.pending`
+    writeFileSync(
+      pendingCompletion,
+      JSON.stringify({
+        state: 'scenario-returned-not-resource-qualified',
+        exitCode: Number(process.exitCode ?? 0),
+        pid: process.pid,
+        nonce: job.nonce,
+        at: new Date().toISOString(),
+      }),
+      { flag: 'wx' },
+    )
+    renameSync(pendingCompletion, job.runComplete)
+    // Keep the witnessed root alive while the external owner reconciles Chrome.
+    const ackDeadline = performance.now() + 30_000
+    while (!existsSync(job.completionAck)) {
+      if (performance.now() >= ackDeadline)
+        throw new Error('External cleanup acknowledgement deadline')
+      await delay(25)
+    }
+    const ack = JSON.parse(readFileSync(job.completionAck, 'utf8'))
+    if (ack.pid !== process.pid || ack.nonce !== job.nonce)
+      throw new Error('External completion acknowledgement mismatch')
+  }
+} catch (error) {
+  let name = 'Error'
+  try {
+    if (typeof error?.name === 'string') name = error.name.slice(0, 80)
+  } catch {}
+  // Never persist arbitrary error message/stack/URL/env values.
+  try {
+    writeFileSync(
+      job.failureReceipt,
+      JSON.stringify({
+        state: 'failed',
+        phase,
+        name,
+        role: job.role,
+        pid: process.pid,
+        stopRequested: requested,
+      }),
+      { flag: 'wx' },
+    )
+  } catch {}
+  console.error(JSON.stringify({ state: 'qa-entry-failed', phase, name, pid: process.pid }))
+  process.exitCode = 1
+  if (phase === 'preclaim') process.exit(1) // No imported app/children to drain.
+  if (process.listenerCount('SIGTERM') > 0) process.emit('SIGTERM')
+}
