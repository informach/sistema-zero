+  hostedAdminOrigin?: string
+  audience?: 'adult' | 'kids'
+  variant?: 'hosted-js-pro'
   state: 'creating-empty-lesson' | 'empty-lesson-awaiting-admin-ui' | 'enrolled-before-call'
