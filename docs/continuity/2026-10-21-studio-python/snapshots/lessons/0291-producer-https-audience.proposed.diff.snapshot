 /** Exact local BFF only. Authentication is owned by the real Admin browser context. */
-export function pythonAdminOrigin(value: string) {
+export function pythonAdminOrigin(value: string, reviewedHostedOrigin?: string) {
+  if (reviewedHostedOrigin !== undefined) {
+    assert.equal(value, reviewedHostedOrigin, 'Exact Root-reviewed hosted Admin origin required')
+    const parsed = new URL(value)
+    assert.equal(parsed.protocol, 'https:')
+    assert.equal(parsed.origin, value)
+    return value
+  }
   assert.equal(value, 'http://localhost:43107', 'Use the reviewed exact Admin parent')
   return value
 }
