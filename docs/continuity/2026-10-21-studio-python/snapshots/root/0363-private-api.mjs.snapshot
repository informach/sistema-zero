      if (!consumed) {
        try { if (reader) await reader.cancel(); else await response?.body?.cancel(); } catch { cleanupFailed = true; }
      }
      try { reader?.releaseLock(); } catch { cleanupFailed = true; }
      if (failed) for (const chunk of chunks) chunk.fill(0);
    }
    if (failed || cleanupFailed) {
      result?.bytes.fill(0);
