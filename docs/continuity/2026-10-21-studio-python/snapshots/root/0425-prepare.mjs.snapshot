import assert from 'node:assert/strict';
import {readFileSync,writeFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {createRequire} from 'node:module';
import {resolve,join} from 'node:path';
import {execFileSync} from 'node:child_process';
const here=import.meta.dirname,root=resolve(here,'../../..'),sha=b=>createHash('sha256').update(b).digest('hex');
const proofPath='C:/Users/tocha/projects/sistema-zero-python-review/.cache/studio-python-l0/windows-job-object-node-r1/plan.json';
const bytes=readFileSync(proofPath);assert.equal(sha(bytes),'6f02482cf2fe52c29f9ea2584624b9d357e81610e027881ba1d2769f80ed2afc');
const proof=JSON.parse(bytes),pins=new Map();
const pin=path=>{path=resolve(path);const b=readFileSync(path),record={path,bytes:b.length,sha256:sha(b)};pins.set(path.toLowerCase(),record);return record;};
for(const p of proof.dependencies){const path=p.path.replace('sistema-zero-python-review/','sistema-zero-python/');const actual=pin(path);assert.equal(actual.bytes,p.bytes);assert.equal(actual.sha256,p.sha256);}
assert.equal(proof.dependencies.length,106);
for(const p of [proof.node,proof.chrome,proof.pwsh]){const actual=pin(p.path);assert.equal(actual.bytes,p.bytes);assert.equal(actual.sha256,p.sha256);}
const windows=join(root,'packages/community-kids/tests/e2e/windows');
for(const path of ['python-lesson-native-browser-owner.ps1','python-lesson-native-browser-common.ps1','python-lesson-native-browser-worker.mjs','python-lesson-windows-job.ps1','python-lesson-windows-job.cs'])pin(join(windows,path));
const leafDir=resolve(here,'../pro-legacy-staging-ui-owned-r6'),leaf=JSON.parse(readFileSync(join(leafDir,'plan.json')));
assert.equal(sha(readFileSync(join(leafDir,'plan.json'))),'12c255b11245539dcfde886b594230822624878e4e56fa2e1500fa77c80430e9');
for(const p of leaf.pins){const actual=pin(resolve(p.scope==='root'?root:leafDir,p.path));assert.equal(actual.bytes,p.bytes);assert.equal(actual.sha256,p.sha256);}
for(const path of ['plan.json','preparation-receipt.json'])pin(join(leafDir,path));
for(const path of ['run.mjs','prepare.mjs','functional-contract.mjs'])pin(join(here,path));
const uiModules=[];
for(const [packagePath,name,version] of [['packages/studio/package.json','fflate','0.8.3'],['packages/community-kids/package.json','@playwright/test','1.60.0']]){
 const require=createRequire(join(root,packagePath)),entry=require.resolve(name),metadata=require.resolve(name+'/package.json'),value=require(name);assert.equal(require(metadata).version,version);
 assert(name==='fflate'?typeof value.unzipSync==='function'&&typeof value.strFromU8==='function':typeof value.expect==='function');
 uiModules.push({name,entry,packagePath:metadata,version});pin(join(root,packagePath));pin(entry);pin(metadata);for(const path of Object.keys(require.cache))pin(path);
}
const playwrightEntry=[...pins.values()].find(p=>p.path.replaceAll('\\','/').endsWith('/playwright-core/index.mjs'))?.path;assert(playwrightEntry);
const head=execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).trim();assert.equal(head,'01f7d35a87a70e006004f9fa992713b067f3ad7a');
const draft={version:1,kind:'hosted-js-pro-node-job',resourceProfile:'hosted-functional-2048',functionalOnly:true,performanceQualified:false,attemptId:null,directory:null,node:proof.node,chrome:proof.chrome,binding:null,pins:[...pins.values()],providerEntry:join(leafDir,'provider-context.mjs'),playwrightEntry,scenarioEntry:join(leafDir,'run.mjs'),uiModules};
writeFileSync(join(here,'owner-plan.unbound.json'),JSON.stringify(draft,null,2)+'\n',{flag:'wx'});
const receipt={kind:'offline-caller-inputs',rootHead:head,proofPlanSha256:sha(bytes),leafPlanSha256:sha(readFileSync(join(leafDir,'plan.json'))),draftSha256:sha(readFileSync(join(here,'owner-plan.unbound.json'))),callerSha256:sha(readFileSync(join(here,'run.mjs'))),pins:draft.pins.length,proofDependenciesByteIdenticalAtRoot:106,uiModules,exportsVerified:true,processStarts:0,providerCalls:0,bindingCreated:false,operationalPlanCreated:false};
writeFileSync(join(here,'preparation-receipt.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify(receipt));
