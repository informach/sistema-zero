import assert from 'node:assert/strict';
import {spawn} from 'node:child_process';
import {homedir} from 'node:os';
import {win32} from 'node:path';
import {receiveRailwayProvider} from './provider-context.mjs';
const attemptId='00000000-0000-4000-8000-000000000001';
try{
 if(process.argv[2]==='cli'){
  assert.equal(homedir(),process.env.USERPROFILE);
  assert(!homedir().includes('qa-isolated-browser'));
  assert.equal(process.argv[3],win32.join(homedir(),'.ssh','id_ed25519'));
  assert.match(process.env.RAILWAY_API_TOKEN,/^[a-f0-9]{64}$/);
  assert.equal(process.env.RAILWAY_TOKEN,undefined);
  console.log(JSON.stringify({passed:true,tokenOnlyCli:true,originalIdentityPath:true}));
 }else{
  assert.equal(process.argv[2],'isolated-node');
  const oldIdentity=win32.join(homedir(),'.ssh','id_ed25519');
  assert(oldIdentity.includes('qa-isolated-browser'));
  assert.equal(process.env.RAILWAY_API_TOKEN,undefined);
  assert.equal(process.env.RAILWAY_TOKEN,undefined);
  const before=JSON.stringify(process.env);
  const provider=await receiveRailwayProvider(process.stdin,{attemptId});
  assert.equal(JSON.stringify(process.env),before);
  const transport=provider.takeSSHTransport();
  assert(!transport.identityPath.includes('qa-isolated-browser'));
  const args=[import.meta.filename,'cli',transport.identityPath];
  assert(!args.some(v=>v.includes(transport.env.RAILWAY_API_TOKEN)));
  const cli=spawn(process.execPath,args,{env:transport.env,windowsHide:true,stdio:['ignore','pipe','pipe']});
  delete transport.env.RAILWAY_API_TOKEN;provider.dispose();
  let output='',errorBytes=0;
  cli.stdout.on('data',b=>output+=b);cli.stderr.on('data',b=>errorBytes+=b.length);
  const closed=await new Promise((resolve,reject)=>{cli.once('error',reject);cli.once('close',(code,signal)=>resolve({code,signal}));});
  assert.deepEqual(closed,{code:0,signal:null});assert.equal(errorBytes,0);
  assert.deepEqual(JSON.parse(output),{passed:true,tokenOnlyCli:true,originalIdentityPath:true});
  assert.equal(JSON.stringify(process.env),before);
  console.log(JSON.stringify({passed:true,oldQaHomeIdentityWrong:true,oldTokenAbsent:true,privatePipeReceived:true,isolatedNodeEnvUnchanged:true,browserEnvironmentHasNoToken:true,cliChildPassed:true}));
 }
}catch{console.log(JSON.stringify({passed:false,category:'inert-provider-context-control'}));process.exitCode=1;}

