import assert from 'node:assert/strict';
import {spawn} from 'node:child_process';
import {randomBytes,randomUUID} from 'node:crypto';
import {readFileSync,writeFileSync,mkdirSync,existsSync,renameSync} from 'node:fs';
import {join,resolve,dirname} from 'node:path';
import {fileURLToPath} from 'node:url';
import {brotliCompressSync} from 'node:zlib';
import {context,sha,origin,serviceContexts,validateBinding,acceptRemoteLine,makeSecretSender} from './contract.mjs';
const here=dirname(fileURLToPath(import.meta.url)),root=resolve(here,'../../..');

export function verifyOffline(){
 const planBytes=readFileSync(join(here,'plan.json')),plan=JSON.parse(planBytes);
 assert.equal(plan.origin,origin);assert.deepEqual(plan.context,context);assert.deepEqual(plan.serviceContexts,serviceContexts);
 for(const p of plan.pins){const bytes=readFileSync(p.scope==='root'?resolve(root,p.path):resolve(here,p.path));assert.equal(bytes.length,p.bytes);assert.equal(sha(bytes),p.sha256);}
 assert.equal(sha(readFileSync(plan.cli.path)),plan.cli.sha256);
 const fixtureCheck=JSON.parse(readFileSync(join(here,'fixture-check.json')));
 assert.equal(sha(readFileSync(join(here,'legacy.szproject.json'))),fixtureCheck.fixtureSha256);
 return {plan,planSha256:sha(planBytes),fixtureCheck};
}

// Leaf of the reviewed Node + Job adapter: no browser launch/close, Job, PID kill,
// or process-tree cleanup claim. requestStop belongs to that same external owner.
// An SSH child remains retained/unknown until an actual close event.
export async function runOwnedScenario({browser,signal,requestStop,bindingPath,bindingSha256,provider}){
 assert(browser?.isConnected());assert(signal instanceof AbortSignal);assert.equal(typeof requestStop,'function');signal.throwIfAborted();
 assert.equal(typeof provider?.takeSSHTransport,'function');assert.equal(typeof provider?.dispose,'function');
 const {plan,planSha256,fixtureCheck}=verifyOffline();
 const bindingBytes=readFileSync(resolve(bindingPath));assert.equal(sha(bindingBytes),bindingSha256);
 const binding=validateBinding(JSON.parse(bindingBytes),planSha256);
 const out=join(here,'execution');assert(!existsSync(out),'Preserve the previous attempt');mkdirSync(out);
 const attemptId=binding.attemptId,actorId=randomUUID(),email='qa-pro-'+actorId+'@example.invalid';
 const receipt={phase:'initial',startedAt:new Date().toISOString(),attemptId,actorId,role:'staff',target:'staging',created:false,creationOutcome:'not-started',accountRetained:false,accountStatus:'not-created',secretValuesPersisted:false,rawErrorsPersisted:false,signalsSent:false,ssh:{started:false,closed:false,retained:false},ui:{passed:false},browser:{owner:'external-node-job-adapter',startedHere:false,processTreeAbsence:'owner-receipt-required'},failure:null,functionalPassed:false};
 const save=()=>{writeFileSync(join(out,'receipt.tmp'),JSON.stringify(receipt,null,2)+'\n');renameSync(join(out,'receipt.tmp'),join(out,'receipt.json'));};
 const overall=Date.now()+300000;
 let child=null,closed=false,secret=null,phase='initial',sshTimer=null,uiTimer=null,stopRequested=false;
 const checkTime=()=>{signal.throwIfAborted();assert(!stopRequested);assert(Date.now()<overall&&Date.now()<Date.parse(binding.expiresAt));};
 const stop=reason=>{
  if(stopRequested)return;stopRequested=true;receipt.failure??=reason;
  if(child&&!closed){receipt.ssh.retained=true;receipt.creationOutcome=receipt.created?'created':secret?.hasSent()?'unknown':'not-started';}
  try{child?.stdin.end();}catch{}
  try{save();}catch{receipt.failure='receipt-write-failed';}
  Promise.resolve().then(()=>requestStop(reason)).catch(()=>{receipt.ownerStopUnconfirmed=true;try{save();}catch{}});
 };
 const onAbort=()=>stop('owner-aborted');signal.addEventListener('abort',onAbort,{once:true});
 try{
  save();checkTime();phase='auth-producer';receipt.phase=phase;save();
  const spec={attemptId,actorId,email,role:'staff',context,pins:plan.authPins};
  const source='const SPEC='+JSON.stringify(spec)+';\n'+readFileSync(join(here,'remote.mjs'),'utf8');
  const compressed=brotliCompressSync(Buffer.from(source));
  const loader="const{brotliDecompressSync}=await import('node:zlib');await import('data:text/javascript;base64,'+brotliDecompressSync(Buffer.from('"+compressed.toString('base64')+"','base64')).toString('base64'));";
  assert(Buffer.byteLength(loader)<24576);
  // Captured by the owning caller before HOME isolation; transferred only by
  // its private pipe. Never derived from this Node's homedir/process.env.
  checkTime();const transport=provider.takeSSHTransport();
  const argv=['ssh','-p',context.RAILWAY_PROJECT_ID,'-e',context.RAILWAY_ENVIRONMENT_ID,'-s',context.RAILWAY_SERVICE_ID,'-i',transport.identityPath,'--','bun','--eval',loader];
  try{checkTime();child=spawn(plan.cli.path,argv,{cwd:root,env:transport.env,windowsHide:true,stdio:['pipe','pipe','pipe']});}
  finally{delete transport.env.RAILWAY_API_TOKEN;}
  receipt.ssh.started=true;receipt.ssh.pid=child.pid??null;
  secret=makeSecretSender(spec,()=>randomBytes(32).toString('hex'),body=>{
   checkTime();assert(!argv.some(x=>x.includes(JSON.parse(body).password)));
   receipt.creationOutcome='unknown';receipt.accountRetained=true;save();child.stdin.end(body);
  });
  let stdout='',stdoutBytes=0,stderrBytes=0,terminal=null,protocolFailure=false;
  const result=new Promise(resolveClosed=>{
   child.once('close',(code,sig)=>{closed=true;receipt.ssh.closed=true;receipt.ssh.retained=false;receipt.ssh.exitCode=code;receipt.ssh.signal=sig;resolveClosed();});
   child.once('error',()=>{protocolFailure=true;});
  });
  child.stdin.on('error',()=>{protocolFailure=true;});
  child.stdout.on('data',b=>{
   stdoutBytes+=b.length;if(stdoutBytes>16384){protocolFailure=true;stdout='';stop('ssh-output-budget');return;}
   stdout+=b.toString();let pos;
   while((pos=stdout.indexOf('\n'))>=0){const line=stdout.slice(0,pos);stdout=stdout.slice(pos+1);
    try{checkTime();const v=acceptRemoteLine(line,spec);
     if(v.kind==='ready'){assert.equal(terminal,null);secret.onReady(v);}
     else{assert.equal(terminal,null);terminal=v;if(v.created){receipt.created=true;receipt.accountRetained=true;receipt.accountStatus='active';receipt.creationOutcome='created';}}
     save();
    }catch{protocolFailure=true;stop('ssh-protocol-refused');}
   }
  });
  child.stderr.on('data',b=>{stderrBytes+=b.length;if(stderrBytes>16384){protocolFailure=true;stop('ssh-output-budget');}});
  sshTimer=setTimeout(()=>{receipt.ssh.timedOut=true;stop('ssh-deadline');},60000);
  save();await result;clearTimeout(sshTimer);sshTimer=null;
  receipt.ssh.stdoutBytes=stdoutBytes;receipt.ssh.stderrBytes=stderrBytes;assert.equal(stdout.trim(),'');stdout='';save();
  assert(!protocolFailure&&!receipt.ssh.timedOut&&terminal?.ok===true&&receipt.ssh.exitCode===0&&receipt.ssh.signal===null);checkTime();
  phase='ui';receipt.phase=phase;save();const {runUI}=await import('./ui.mjs');
  const project=JSON.parse(readFileSync(join(here,'legacy.szproject.json')));project.name='QA Pro legado '+attemptId.slice(0,8);
  uiTimer=setTimeout(()=>stop('ui-deadline'),180000);
  await runUI({browser,signal,email,password:secret.password(),project,fixtureCheck,expectedLockPath:resolve(root,plan.expectedLockPath),root,receipt,checkTime});
  clearTimeout(uiTimer);uiTimer=null;checkTime();receipt.functionalPassed=true;
 }catch{receipt.failure??=phase+'-failed';receipt.functionalPassed=false;if(child&&!closed){receipt.ssh.retained=true;stop('ssh-retained');}}
 finally{
  clearTimeout(sshTimer);clearTimeout(uiTimer);signal.removeEventListener('abort',onAbort);secret?.forget();provider.dispose();
  receipt.endedAt=new Date().toISOString();receipt.phase='terminal';receipt.accountRetained=receipt.created||receipt.creationOutcome==='unknown';
  receipt.cleanupLimitation='QA account and cloud project retained. Browser/Job cleanup belongs to the external adapter; no account deletion or suspension was attempted.';save();
 }
 return {passed:receipt.functionalPassed&&receipt.failure===null,receiptPath:join(out,'receipt.json'),accountRetained:receipt.accountRetained,sshClosed:receipt.ssh.closed,ownerCleanupRequired:true};
}

if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url)){
 try{assert.deepEqual(process.argv.slice(2),['--verify']);const v=verifyOffline();console.log(JSON.stringify({passed:true,mode:'offline',pins:v.plan.pins.length,remoteSourcePins:v.plan.authPins.length,fixtureFiles:v.fixtureCheck.files.length,actorCreated:false,providerCalls:0,browserStarted:false,adapterBindingRequired:true}));}
 catch{console.log(JSON.stringify({passed:false,phase:'offline-preflight',providerCalls:0,browserStarted:false}));process.exitCode=1;}
}

