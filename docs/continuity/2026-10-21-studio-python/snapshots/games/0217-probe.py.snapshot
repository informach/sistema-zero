"""Three official3000ms timers, dual-clock brackets, no game/audio. Separate window required."""
import argparse
import ast
import hashlib
import json
from pathlib import Path
import sys
import time
import traceback

HERE = Path(__file__).resolve().parent


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--packet-sha', required=True)
    args = parser.parse_args()
    assert sys.flags.isolated and sys.dont_write_bytecode and sys.version_info[:3] == (3, 14, 2)
    raw = (HERE / 'packet.json').read_bytes()
    assert hashlib.sha256(raw).hexdigest() == args.packet_sha
    packet = json.loads(raw)
    target = Path(packet['output']) / 'native.json'
    assert not target.exists()
    report = dict(state='running', python=sys.version, executable=sys.executable,
                  monotonicInfo=vars(time.get_clock_info('monotonic')), rows=[], observerEvents=[],
                  errors=[], cooperativeDeadline=False, rootMap=0, rootDestroy=0,
                  noGameAudio=True, nominalMs=3000, sourcePacketSha256=args.packet_sha)
    roots = []
    screen = None
    started = time.monotonic_ns()
    try:
        import turtle
        original_root = turtle._Root

        class HiddenRoot(original_root):
            def __init__(self):
                super().__init__()
                roots.append(self)
                self.withdraw()
                self.bind('<Map>', lambda event: report.__setitem__('rootMap', report['rootMap'] + int(event.widget is self)), add='+')
                self.bind('<Destroy>', lambda event: report.__setitem__('rootDestroy', report['rootDestroy'] + int(event.widget is self)), add='+')

            def setupcanvas(self, *values):
                assert self.state() == 'withdrawn'
                return super().setupcanvas(*values)

        turtle._Root = HiddenRoot
        try:
            screen = turtle.Screen()
        finally:
            turtle._Root = original_root
        root = screen.getcanvas().winfo_toplevel()
        assert root.state() == 'withdrawn'
        report['tclPatchlevel'] = root.tk.call('info', 'patchlevel')
        report['tkPatchlevel'] = root.tk.call('package', 'provide', 'Tk')

        def callback_error(kind, error, tb):
            report['errors'].append(dict(name=kind.__name__, message=str(error), traceback=''.join(traceback.format_exception(kind, error, tb))))
            screen.bye()

        root.report_callback_exception = callback_error

        def deadline():
            report['cooperativeDeadline'] = True
            screen.bye()

        root.after(30000, deadline)

        def snapshot():
            before = time.monotonic_ns()
            tcl_us = int(root.tk.call('clock', 'microseconds'))
            after = time.monotonic_ns()
            return dict(qpcBeforeNs=before, tclMicroseconds=tcl_us, qpcAfterNs=after)

        observer_path = Path(packet['observer']['path'])
        observer_raw = observer_path.read_bytes()
        assert hashlib.sha256(observer_raw).hexdigest() == packet['observer']['sha256']
        observer_ast = ast.parse(observer_raw)
        observed_screen = next(n for n in observer_ast.body if isinstance(n, ast.FunctionDef) and n.name == 'observed_screen')
        timer = next(n for n in observed_screen.body if isinstance(n, ast.FunctionDef) and n.name == 'timer')
        namespace = dict(time=time, _timers={}, real_timer=screen.ontimer,
                         emit=lambda event, value: report['observerEvents'].append(dict(event=event, value=value)))
        # Exact real observer TIMER AST; only emit is an external in-memory recorder.
        # No imports, main()/observed_screen(), game code, fake timer or fake Screen execute.
        exec(compile(ast.Module(body=[timer], type_ignores=[]), '<actual-observer-timer>', 'exec'), namespace)
        schedules = [('tk-after', lambda callback: screen.getcanvas().after(3000, callback)),
                     ('turtle-ontimer', lambda callback: screen.ontimer(callback, 3000)),
                     ('actual-observer-timer-AST', lambda callback: namespace['timer'](callback, 3000))]
        pending = None

        def schedule_next():
            nonlocal pending
            index = len(report['rows'])
            if index == len(schedules):
                screen.bye()
                return
            name, schedule = schedules[index]
            pending = dict(name=name, nominalMs=3000, callbackCount=0, registrationBefore=snapshot())
            schedule(fired)
            pending['registrationAfter'] = snapshot()

        def fired():
            firing = snapshot()  # First operation on entry into this callback.
            row = pending
            row['callbackCount'] += 1
            row['firing'] = firing
            first, last = row['registrationBefore'], row['registrationAfter']
            row['tclElapsedLowerUs'] = firing['tclMicroseconds'] - last['tclMicroseconds']
            row['tclElapsedUpperUs'] = firing['tclMicroseconds'] - first['tclMicroseconds']
            row['qpcElapsedLowerNs'] = firing['qpcBeforeNs'] - last['qpcAfterNs']
            row['qpcElapsedUpperNs'] = firing['qpcAfterNs'] - first['qpcBeforeNs']
            assert row['callbackCount'] == 1
            assert row['tclElapsedLowerUs'] <= row['tclElapsedUpperUs']
            assert row['qpcElapsedLowerNs'] <= row['qpcElapsedUpperNs']
            row['tclDeadlineDefinitelyMet'] = row['tclElapsedLowerUs'] >= 3000000
            row['qpcDefinitelyBelow3s'] = row['qpcElapsedUpperNs'] < 3000000000
            row['tclDefinitelyBelow3s'] = row['tclElapsedUpperUs'] < 3000000
            report['rows'].append(row)
            root.after_idle(schedule_next)

        schedule_next()
        screen.mainloop()
        assert not report['errors'] and not report['cooperativeDeadline']
        assert [row['name'] for row in report['rows']] == [name for name, _ in schedules]
        assert 'sz_audio' not in sys.modules and 'main' not in sys.modules and 'actors' not in sys.modules
        report['state'] = 'causal-control-completed-not-game-acceptance'
    except BaseException as error:
        report['errors'].append(dict(name=type(error).__name__, message=str(error), traceback=traceback.format_exc()))
    finally:
        if screen is not None and report['rootDestroy'] == 0:
            try:
                screen.bye()
            except BaseException as error:
                report['errors'].append(dict(cleanup='screen', message=str(error)))
        elif screen is None:
            for root in roots:
                try:
                    root.destroy()
                except BaseException as error:
                    report['errors'].append(dict(cleanup='partial-root', message=str(error)))
        if report['rootMap'] or report['rootDestroy'] != 1:
            report['errors'].append(dict(cleanup='root-lifecycle', message='Expected Map0/Destroy1'))
        if report['errors']:
            report['state'] = 'failed-preserved'
        report['elapsedNs'] = time.monotonic_ns() - started
        with target.open('x', encoding='utf-8') as stream:
            json.dump(report, stream, indent=2)
    print(json.dumps(dict(state=report['state'], samples=len(report['rows']), errors=report['errors'])))
    return 0 if report['state'] == 'causal-control-completed-not-game-acceptance' else 1


if __name__ == '__main__':
    sys.exit(main())
