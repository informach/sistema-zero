  "sources": [
    {
      "path": ".dockerignore",
      "sha256": "88c9a44240784ac5a6b4c89dfc641ab94e8c3456759509d8c49b197e2f3522bd",
      "bytes": 1161,
      "utf8": "node_modules\n**/node_modules\n.git\n.gitignore\n**/dist\n**/.next\nout\n**/*.tsbuildinfo\n**/*.log\n.env\n**/.env\n.env.*\ncerts\n**/certs\nsecrets\n**/secrets\n**/.local-fonts\n*.p12\n*.pfx\n*.pem\n*.key\n**/tests\n.claude\n.idea\n.DS_Store\n\n# Material de produção (PDFs dos cursos, Instagram, áudios dos relatos): nenhum serviço lê, e ele\n# não pode entrar nas imagens (full review de 10/10/2026: ~350 MB e áudio de depoimentos de pais).\noutput\n.tmp\ntmp\n.audits\n\n# Acervo editorial, planos e provas ficam no Git/local, nunca no contexto das imagens.\n# Regras ancoradas na raiz: os assets, manuais e fontes dos pacotes continuam disponíveis.\n/docs\n/.agents\n/.compozy\n/experiments\n/.cache\n/.sistemazero\n/.vscode\n/.github\n\n# Provas e saídas de teste não são entradas de build nem de runtime dos serviços.\n**/.cache\n**/__tests__\n**/*.test.*\n**/*.spec.*\n**/*.cases.ts\n**/*.cases.tsx\n**/e2e\n**/e2e-*\n**/qa\n**/playwright-report\n**/test-results\n**/coverage\n\n# Caches locais de ferramentas e ambientes Python; os fontes .astro/.py são preservados.\n**/.wrangler\n**/.turbo\n**/__pycache__\n**/.pytest_cache\n**/.mypy_cache\n**/.ruff_cache\n**/.venv\n**/venv\n**/*.pyc\n**/*.pyo\n**/.astro\n"
    },
    {
      "path": ".cache/python-reference-games/docker-context-proof-r1/Dockerfile",
      "sha256": "0837162982057d16f6c2363c396d2811f9839aeb2480f977ad955788e8c73e36",
      "bytes": 22,
      "utf8": "FROM scratch\nCOPY . /\n"
    },
    {
      "path": ".cache/python-reference-games/docker-context-proof-r1/verify.mjs",
      "sha256": "3919bf2e8c6dbd0971718f0b71c026607c3036b3b775be08e6fe53befc079743",
      "bytes": 4395,
      "utf8": "import { createHash } from 'node:crypto'\nimport { existsSync, lstatSync, readFileSync, readdirSync, writeFileSync } from 'node:fs'\nimport { resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst root = fileURLToPath(new URL('../../../', import.meta.url))\nconst exported = resolve(root, '.cache/python-reference-games/docker-context-proof-r1/export')\nconst receiptPath = resolve(root, '.cache/python-reference-games/docker-context-proof-r1/receipt.json')\nif (process.argv.length !== 2 || !existsSync(exported) || existsSync(receiptPath)) throw new Error('fresh-real-export-required')\nconst hash = bytes => createHash('sha256').update(bytes).digest('hex')\nconst receipt = { kind: 'docker-real-context-export-proof', scope: 'local BuildKit FROM scratch COPY export, not production image size or runtime qualification', state: 'NEG', checkedAt: new Date().toISOString(), dockerignoreSha256: hash(readFileSync(resolve(root, '.dockerignore'))), exportedFileCount: 0, exportedBytes: 0, excludedRootTreesAbsent: false, qaAbsent: false, requiredInputs: [] }\ntry {\n  for (const directory of ['docs', '.agents', '.compozy', 'experiments', '.cache', '.sistemazero', '.vscode', '.github'])\n    if (existsSync(resolve(exported, directory))) throw new Error('editorial-or-qa-root-present')\n  receipt.excludedRootTreesAbsent = true\n  function walk(directory) {\n    for (const entry of readdirSync(directory, { withFileTypes: true })) {\n      const path = resolve(directory, entry.name)\n      if (entry.isSymbolicLink()) continue // Required input byte checks below never rely on this count.\n      if (entry.isDirectory()) {\n        if (['.cache', '__tests__', 'e2e', 'qa', 'playwright-report', 'test-results', 'coverage', '.wrangler', '.turbo', '__pycache__', '.pytest_cache', '.mypy_cache', '.ruff_cache', '.venv', 'venv', '.astro'].includes(entry.name) || entry.name.startsWith('e2e-')) throw new Error('qa-or-tool-cache-directory-present')\n        walk(path)\n      } else if (entry.isFile()) {\n        if (/\\.(?:test|spec)\\.|\\.cases\\.tsx?$|\\.py[co]$/.test(entry.name)) throw new Error('test-or-python-cache-file-present')\n        receipt.exportedFileCount++\n        receipt.exportedBytes += lstatSync(path).size\n      }\n    }\n  }\n  walk(exported)\n  receipt.qaAbsent = true\n  const required = [\n    'package.json', 'bun.lock', 'patches/three@0.184.0.patch',\n    'scripts/release/start.mjs', 'scripts/release/kids-journey-bootstrap.mjs',\n    'packages/members/src/index.ts', 'packages/members/drizzle.config.ts',\n    'packages/members/src/infrastructure/persistence/drizzle/migrations/meta/_journal.json',\n    'packages/auth/src/index.ts', 'packages/auth/drizzle.config.ts',\n    'packages/auth/src/infrastructure/persistence/drizzle/migrations/meta/_journal.json',\n    'packages/catalog/scripts/seed.ts',\n    'packages/funnel/astro.config.mjs',\n    'packages/funnel/src/env.d.ts',\n    'packages/funnel/src/layouts/BaseLayout.astro',\n    'packages/fiscal/assets/fonts/arial.ttf',\n    'packages/fiscal/assets/fonts/arialbd.ttf',\n    'packages/fiscal/assets/fonts/micross.ttf',\n    'packages/messaging/assets/logo-sistema-zero-light.png',\n    'packages/member-shell/assets/live-camera/selfie_segmenter_landscape.tflite',\n    'packages/studio/src/official-extensions/scene-2d/docs.ts',\n    'packages/studio/src/examples/python/visualReferenceGames.manifest.ts',\n    'packages/studio/src/python/blocks/structureCatalog.ts',\n    'packages/helpdesk/src/application/ai/prompts.ts',\n    'packages/marketing/src/application/ai/ai-copy.service.ts',\n    '.railway/services/members.json', '.railway/services/auth.json',\n  ]\n  for (const path of required) {\n    const before = hash(readFileSync(resolve(root, path)))\n    if (hash(readFileSync(resolve(exported, path))) !== before) throw new Error('required-input-missing-or-changed')\n    receipt.requiredInputs.push({ path, sha256: before, matches: true })\n  }\n  receipt.state = 'PASS_LOCAL_DOCKER_CONTEXT'\n} catch (failure) {\n  receipt.failure = failure instanceof Error && /^[a-z]+(?:-[a-z]+)+$/.test(failure.message) ? failure.message : 'input-observation-failed'\n  process.exitCode = 1\n} finally {\n  writeFileSync(receiptPath, JSON.stringify(receipt, null, 2) + '\\n', { flag: 'wx' })\n}\nconsole.log(JSON.stringify({ state: receipt.state, exportedFileCount: receipt.exportedFileCount, exportedBytes: receipt.exportedBytes, failure: receipt.failure }))\n"
    },
    {
      "path": ".cache/python-reference-games/run-context-proof-r1.mjs",
      "sha256": "6cb13c977a66ff4426c6fc62ea861bd08eae8ae40a69572c2b22df8ee683ccf8",
      "bytes": 1804,
      "utf8": "import {execFile} from 'node:child_process'\nimport {writeFileSync,existsSync,readFileSync} from 'node:fs'\nimport {createHash} from 'node:crypto'\nconst base='.cache/python-reference-games/docker-context-proof-r1'\nif(existsSync(base+'/export')||existsSync(base+'/run-root.json'))throw new Error('Fresh output required')\nconst sha=x=>createHash('sha256').update(x).digest('hex')\nconst pins={ignore:'88c9a44240784ac5a6b4c89dfc641ab94e8c3456759509d8c49b197e2f3522bd',dockerfile:'0837162982057d16f6c2363c396d2811f9839aeb2480f977ad955788e8c73e36',verifier:'3919bf2e8c6dbd0971718f0b71c026607c3036b3b775be08e6fe53befc079743'}\nfor(const [path,pin]of [['.dockerignore',pins.ignore],[base+'/Dockerfile',pins.dockerfile],[base+'/verify.mjs',pins.verifier]])if(sha(readFileSync(path))!==pin)throw new Error('Input changed')\nconst receipt={kind:'owned-local-docker-context-execution',startedAt:new Date().toISOString(),pins,state:'RUNNING',timeoutMs:180000,noRunInstructions:true,noImageTag:true,noRegistryPush:true}\nwriteFileSync(base+'/run-root.json',JSON.stringify(receipt,null,2)+'\\n',{flag:'wx'})\nconst result=await new Promise(resolve=>execFile('docker',['build','--network=none','--file',base+'/Dockerfile','--output','type=local,dest='+base+'/export','--progress=plain','.'],{windowsHide:true,encoding:'utf8',timeout:180000,maxBuffer:4_000_000},(error,stdout,stderr)=>resolve({error,stdout,stderr})))\nwriteFileSync(base+'/build-root.log',result.stdout+'\\n'+result.stderr,{flag:'wx'})\nreceipt.state=result.error?'FAILED':'CONTEXT_EXPORTED';receipt.exitCode=result.error?.code??0;receipt.killed=result.error?.killed??false;receipt.completedAt=new Date().toISOString()\nwriteFileSync(base+'/run-root.json',JSON.stringify(receipt,null,2)+'\\n')\nconsole.log(JSON.stringify(receipt));if(result.error)process.exitCode=1\n"
    }
  ],
  "dockerignorePatch": {
    "base": "HEAD at archive creation",
    "sha256": "cd7caff18bbd02e32ade4033f68df816c08d790a63dbd84b404d323a4d0dfc52",
    "bytes": 914,
    "utf8": "diff --git a/.dockerignore b/.dockerignore\nindex 034397020..47e41192b 100644\n--- a/.dockerignore\n+++ b/.dockerignore\n@@ -30,3 +30,41 @@ output\n .tmp\n tmp\n .audits\n+\n+# Acervo editorial, planos e provas ficam no Git/local, nunca no contexto das imagens.\n+# Regras ancoradas na raiz: os assets, manuais e fontes dos pacotes continuam disponíveis.\n+/docs\n+/.agents\n+/.compozy\n+/experiments\n+/.cache\n+/.sistemazero\n+/.vscode\n+/.github\n+\n+# Provas e saídas de teste não são entradas de build nem de runtime dos serviços.\n+**/.cache\n+**/__tests__\n+**/*.test.*\n+**/*.spec.*\n+**/*.cases.ts\n+**/*.cases.tsx\n+**/e2e\n+**/e2e-*\n+**/qa\n+**/playwright-report\n+**/test-results\n+**/coverage\n+\n+# Caches locais de ferramentas e ambientes Python; os fontes .astro/.py são preservados.\n+**/.wrangler\n+**/.turbo\n+**/__pycache__\n+**/.pytest_cache\n+**/.mypy_cache\n+**/.ruff_cache\n+**/.venv\n+**/venv\n+**/*.pyc\n+**/*.pyo\n+**/.astro\n"
  },
