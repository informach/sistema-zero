    {
      "name": "receipt.json",
      "sha256": "227190598a4e55a5230cc574760b969e7c4a5a8d06f7c57d0463af70e9b98694",
      "bytes": 1218,
      "content": "{\n  \"kind\": \"orphan-drain-preparation-receipt\",\n  \"preparedOnly\": true,\n  \"remoteStarted\": false,\n  \"providerCalls\": 0,\n  \"destroyCalls\": 0,\n  \"gateQualified\": false,\n  \"inventoryBound\": false,\n  \"mappingQualified\": false,\n  \"externalReadbackRequired\": true,\n  \"controls\": {\n    \"passed\": 10,\n    \"failed\": 0,\n    \"skipped\": 0,\n    \"nodeVersion\": \"24.22.0\",\n    \"scope\": \"pure-inert-handler-and-argument-controls\"\n  },\n  \"syntaxChecks\": {\n    \"sources\": 3,\n    \"passed\": true\n  },\n  \"unboundCli\": {\n    \"exit\": 1,\n    \"code\": \"target-identity\",\n    \"remoteStarted\": false\n  },\n  \"plan\": {\n    \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/plan.json\",\n    \"sha256\": \"2c60c8a229660256c0f6a8deb2c08862ed29cc826e95cedc2f82df8f42c167da\",\n    \"bytes\": 4177\n  },\n  \"controlsLog\": {\n    \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/controls-final.log\",\n    \"sha256\": \"cfddbce15d442e165aa69491f60eec4863d94ca42f4d6dc259b3dacee0b252ae\",\n    \"bytes\": 1051\n  },\n  \"unboundLog\": {\n    \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/unbound-negative.log\",\n    \"sha256\": \"a08e80fd124d719f505bdc9d063c127acac47d1b7a4ee01b1e57886c2f99d5e0\",\n    \"bytes\": 72\n  },\n  \"allSourcePinsMatch\": true\n}\n"
