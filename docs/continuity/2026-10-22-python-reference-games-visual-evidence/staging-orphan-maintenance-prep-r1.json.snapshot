f7a81\",\n      \"bytes\": 307434\n    }\n  ],\n  \"contextPins\": [\n    {\n      \"path\": \".cache/python-reference-games/staging-language-instances-before-r2.json\",\n      \"sha256\": \"40bde73e5f6ff7c02b4ce11939ee9d311cb3900115a57b538f6debe40122c289\",\n      \"bytes\": 3551\n    },\n    {\n      \"path\": \".cache/python-reference-games/staging-language-app-before-r2.json\",\n      \"sha256\": \"6932d9ce8a4c97a86251cb347222be256ebf500d131fabe6d439f250d5e778d9\",\n      \"bytes\": 1541\n    }\n  ]\n}\n"
