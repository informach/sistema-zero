      "content": "{\n  \"kind\": \"orphan-drain-preview-preparation\",\n  \"version\": 1,\n  \"remoteStarted\": false,\n  \"gateQualified\": false,\n  \"accountId\": \"bcc0f2d44140e05b69152cba326132f8\",\n  \"worker\": \"sistemazero-studio-language-staging\",\n  \"sandboxNamespace\": \"fb9d81d3e52b489faf23ed8c74cea71a\",\n  \"applicationId\": \"a03225c7-85d7-4bd6-9919-a63ba03178af\",\n  \"actions\": [\n    \"verify-offline\",\n    \"inspect-mapping-no-RPC\",\n    \"destroy-serial-four\"\n  ],\n  \"inputRequired\": true,\n  \"externalReadbackRequired\": true,\n  \"pins\": [\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/contract.mjs\",\n      \"sha256\": \"773e73f2c8d9ba9bd0b947e4b9d4b96472baf0f66c29db08125f3a507687196d\",\n      \"bytes\": 3241\n    },\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/worker.mjs\",\n      \"sha256\": \"496e956204cd0b798d11dc0c808f37e4bba223beede9cb5f3181fa404d4df85b\",\n      \"bytes\": 4096\n    },\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/run.mjs\",\n      \"sha256\": \"635db6a210aaf0193b0e84a6f94b0d6d517b36e7e2003157ebb7fc784e4c75bb\",\n      \"bytes\": 8816\n    },\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/controls.test.mjs\",\n      \"sha256\": \"50b0efe05a875b827bc9426352a5ed9183408a2f4dcbdd7992b4649d2f6e1c3b\",\n      \"bytes\": 9011\n    },\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/wrangler.jsonc\",\n      \"sha256\": \"38ebdfb7f814df5d40bcbcaaf8defb3099b50879c3ebdf11094da2018b55a179\",\n      \"bytes\": 151\n    },\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/inventory.UNBOUND.json\",\n      \"sha256\": \"d4ce5998f7219be393eb9eb617d0b0589b472d92299f8c412220321fbf5e4a83\",\n      \"bytes\": 783\n    },\n    {\n      \"path\": \".cache/python-reference-games/orphan-drain-prep-r1/PLAN.md\",\n      \"sha256\": \"a34095ceb28ddf9c8b09270db