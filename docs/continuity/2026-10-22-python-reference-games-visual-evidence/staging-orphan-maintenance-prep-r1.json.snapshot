{
  "kind": "studio.python.staging-orphan-maintenance-preparation",
  "version": 1,
  "restoreDirectory": ".cache/python-reference-games/orphan-drain-prep-r1",
  "state": "prepared-and-inspect-only",
  "productDeployed": false,
  "destroyExecuted": false,
  "gateQualified": false,
  "files": [
    {
      "name": "contract.mjs",
      "sha256": "773e73f2c8d9ba9bd0b947e4b9d4b96472baf0f66c29db08125f3a507687196d",
      "bytes": 3241,
      "content": "export const ACCOUNT = 'bcc0f2d44140e05b69152cba326132f8'\nexport const WORKER = 'sistemazero-studio-language-staging'\nexport const OWNER_NAMESPACE = 'bf106446ef9e495997e39a02f008a526'\nexport const SANDBOX_NAMESPACE = 'fb9d81d3e52b489faf23ed8c74cea71a'\nexport const APPLICATION = 'a03225c7-85d7-4bd6-9919-a63ba03178af'\nexport const SESSION_NAMES = Object.freeze([\n  'language-08bc7d1bdf0555f56f0fcb79e48bace3',\n  'language-79fc6b3cb5975335cad66ef931530862',\n  'language-ba66df839a260f1ee2b52989e948c0f4',\n  'language-71793722eb6b64ef72a85cae73e31ebc',\n])\nexport const BODY_LIMIT = 256\nconst hex32 = /^[a-f0-9]{32}$/\nconst hex64 = /^[a-f0-9]{64}$/\nconst uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/\nexport function fail(code) { throw Object.assign(new Error(code), { code }) }\nfunction exact(value, keys) {\n  if (!value || typeof value !== 'object' || Array.isArray(value) ||\n      Object.keys(value).length !== keys.length || keys.some(key => !Object.hasOwn(value, key)))\n    fail('inventory-shape')\n}\n/** Metadata input is supplied by Root's independent inventory. There are no inferred target names. */\nexport function validateInventory(raw, now = Date.now()) {\n  exact(raw, ['accountId', 'worker', 'workerVersion', 'ownerNamespace', 'sandboxNamespace',\n    'applicationId', 'observedAt', 'expiresAt', 'targets'])\n  if (!hex32.test(raw.accountId) || raw.accountId !== ACCOUNT || raw.worker !== WORKER || !uuid.test(raw.workerVersion) ||\n      raw.ownerNamespace !== OWNER_NAMESPACE || raw.sandboxNamespace !== SANDBOX_NAMESPACE ||\n      raw.applicationId !== APPLICATION) fail('target-identity')\n  if (!Number.isSafeInteger(raw.observedAt) || !Number.isSafeInteger(raw.expiresAt) ||\n      raw.observedAt > now || raw.expiresAt <= now || raw.expiresAt - now > 180_000 ||\n      raw.observedAt >= raw.expiresAt) fail('inventory-window')\n  if (!Array.isArray(raw.targets) || raw.targets.length !== SESSION_NAMES.length) fail('target-count')\n  const instances = new Set(), names = new Set()\n  const targets = raw.targets.map(target => {\n    exact(target, ['sessionName', 'expectedInstanceId'])\n    if (!hex64.test(target.expectedInstanceId) || !SESSION_NAMES.includes(target.sessionName) || instances.has(target.expectedInstanceId) ||\n        names.has(target.sessionName)) fail('target-inventory')\n    instances.add(target.expectedInstanceId); names.add(target.sessionName)\n    return Object.freeze({ ...target })\n  })\n  return Object.freeze({ ...raw, targets: Object.freeze(targets) })\n}\n\nexport function parseArguments(argv) {\n  const parsed = {}, modes = new Set(['--verify', '--inspect', '--execute'])\n  for (let index = 0; index < argv.length; index++) {\n    const key = argv[index]\n    if (modes.has(key)) {\n      if (parsed.mode) fail('arguments')\n      parsed.mode = key.slice(2)\n    } else if (key === '--inventory' || key === '--output') {\n      const field = key.slice(2), value = argv[++index]\n      if (Object.hasOwn(parsed, field) || !value || value.startsWith('--')) fail('arguments')\n      parsed[field] = value\n    } else fail('arguments')\n  }\n  if (!parsed.mode || !parsed.inventory || (parsed.mode === 'verify' ? parsed.output !== undefined : !parsed.output))\n    fail('arguments')\n  return Object.freeze(parsed)\n}\n"
    },
    {
      "name": "worker.mjs",
      "sha256": "496e956204cd0b798d11dc0c808f37e4bba223beede9cb5f3181fa404d4df85b",
      "bytes": 4096,
      "content": "import { BODY_LIMIT, fail, validateInventory } from './contract.mjs'\nconst json = (value, status = 200) => Response.json(value, { status,\n  headers: { 'cache-control': 'no-store', 'x-content-type-options': 'nosniff' } })\nasync function sha256(value) {\n  const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value))\n  return [...new Uint8Array(bytes)].map(byte => byte.toString(16).padStart(2, '0')).join('')\n}\nasync function body(request) {\n  if (request.headers.get('content-type') !== 'application/json' || request.headers.has('content-encoding'))\n    fail('request-format')\n  const reader = request.body?.getReader()\n  if (!reader) fail('request-format')\n  let size = 0, text = ''\n  const decoder = new TextDecoder('utf-8', { fatal: true })\n  try {\n    for (;;) {\n      const next = await reader.read()\n      if (next.done) break\n      size += next.value.byteLength\n      if (size > BODY_LIMIT) { await reader.cancel(); fail('request-size') }\n      text += decoder.decode(next.value, { stream: true })\n    }\n    text += decoder.decode()\n    const value = JSON.parse(text)\n    if (!value || typeof value !== 'object' || Array.isArray(value) ||\n        Object.keys(value).length !== 1 || typeof value.sessionName !== 'string') fail('request-format')\n    return value.sessionName\n  } finally { reader.releaseLock() }\n}\n/** Pure constructor used by inert controls. Only namespace RPC destroy can mutate a resource. */\nexport function createDrainHandler(input, tokenHash, namespace, clock = () => Date.now()) {\n  const config = validateInventory(input, clock())\n  if (!/^[a-f0-9]{64}$/.test(tokenHash)) fail('token-hash')\n  const targets = new Map(config.targets.map(target => [target.sessionName, target]))\n  const attempted = new Set()\n  let pending = false, stopped = false\n  return async request => {\n    const url = new URL(request.url)\n    if (request.method !== 'POST' || !['/inspect', '/drain'].includes(url.pathname) || url.search) return json({ code: 'not-found' }, 404)\n    const header = request.headers.get('authorization') ?? ''\n    if (!/^Bearer [a-f0-9]{64}$/.test(header) || await sha256(header.slice(7)) !== tokenHash)\n      return json({ code: 'unauthorized' }, 401)\n    if (clock() >= config.expiresAt || stopped) return json({ code: 'window-closed' }, 410)\n    let target\n    try { target = targets.get(await body(request)) } catch { return json({ code: 'invalid-request' }, 400) }\n    if (!target) return json({ code: 'not-allowlisted' }, 403)\n    if (pending || attempted.has(target.sessionName)) return json({ code: 'already-attempted' }, 409)\n    if (clock() >= config.expiresAt) return json({ code: 'window-closed' }, 410)\n    // Derive the same object ID as SDK getContainer. Never look up a guessed owner.\n    let id\n    try {\n      id = namespace.idFromName(target.sessionName)\n      if (id.toString() !== target.expectedInstanceId) {\n        stopped = true\n        return json({ code: 'object-id-mismatch' }, 409)\n      }\n    } catch { return json({ code: 'object-id-unconfirmed' }, 503) }\n    if (url.pathname === '/inspect')\n      return json({ ...target, derivedDoId: id.toString(), mappingMatched: true,\n        destroyAcknowledged: false, withinWindow: clock() < config.expiresAt, externalReadbackRequired: true })\n    if (clock() >= config.expiresAt) return json({ code: 'window-closed' }, 410)\n    attempted.add(target.sessionName); pending = true\n    try {\n      await namespace.get(id).destroy()\n      return json({ ...target, derivedDoId: id.toString(), mappingMatched: true, destroyAcknowledged: true,\n        withinWindow: clock() < config.expiresAt, externalReadbackRequired: true })\n    } catch {\n      stopped = true\n      return json({ code: 'destroy-unconfirmed', externalReadbackRequired: true }, 503)\n    } finally { pending = false }\n  }\n}\nlet handler\nexport default {\n  async fetch(request, env) {\n    try {\n      handler ??= createDrainHandler(JSON.parse(env.DRAIN_CONFIG), env.DRAIN_TOKEN_SHA256, env.ORPHANS)\n      return await handler(request)\n    } catch { return json({ code: 'operator-unconfigured' }, 503) }\n  },\n}\n"
    },
    {
      "name": "run.mjs",
      "sha256": "635db6a210aaf0193b0e84a6f94b0d6d517b36e7e2003157ebb7fc784e4c75bb",
      "bytes": 8816,
      "content": "import { createHash, randomBytes } from 'node:crypto'\nimport { createRequire } from 'node:module'\nimport { readFile, writeFile } from 'node:fs/promises'\nimport { createServer } from 'node:net'\nimport { resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport { parseArguments, validateInventory, WORKER } from './contract.mjs'\nlet remoteStartAttempted = false\nconst home = fileURLToPath(new URL('.', import.meta.url))\nconst root = resolve(home, '../../..')\nconst hash = value => createHash('sha256').update(value).digest('hex')\nconst closed = error => ['inventory-shape', 'target-identity', 'inventory-window', 'target-count',\n  'target-inventory', 'missing-input', 'existing-output', 'mode', 'wrangler-pin', 'preview-start',\n  'preview-address', 'arguments', 'node-pin', 'operator-request', 'operator-ack', 'operator-window', 'preview-stop', 'pins'].includes(error?.code)\n  ? error.code : 'operator-unconfirmed'\nconst reject = code => { throw Object.assign(new Error(code), { code }) }\nasync function port() {\n  const server = createServer()\n  await new Promise((ok, no) => { server.once('error', no); server.listen({ host: '127.0.0.1', port: 0, exclusive: true }, ok) })\n  const selected = server.address().port\n  await new Promise((ok, no) => server.close(error => error ? no(error) : ok()))\n  return selected\n}\nasync function within(promise, milliseconds, code) {\n  let timer\n  try { return await Promise.race([promise, new Promise((_, no) => {\n    timer = setTimeout(() => no(Object.assign(new Error(code), { code })), milliseconds)\n  })]) } finally { clearTimeout(timer) }\n}\nasync function main() {\n  const args = parseArguments(process.argv.slice(2))\n  if (process.versions.node !== '24.22.0') reject('node-pin')\n  const inspect = args.mode === 'inspect'\n  const raw = await readFile(resolve(args.inventory))\n  const inventory = validateInventory(JSON.parse(raw))\n  const plan = JSON.parse(await readFile(new URL('./plan.json', import.meta.url)))\n  for (const pin of plan.pins) if (hash(await readFile(resolve(root, pin.path))) !== pin.sha256) reject('pins')\n  const require = createRequire(resolve(root, 'packages/studio-language-service/package.json'))\n  const pkg = require('wrangler/package.json')\n  if (pkg.version !== '4.120.1') reject('wrangler-pin')\n  if (args.mode === 'verify') {\n    console.log(JSON.stringify({ state: 'OFFLINE-ONLY', inputValidated: true, pinsValidated: true,\n      remoteStarted: false, gateQualified: false }))\n    return\n  }\n  const output = resolve(args.output)\n  // Reserve an entirely new receipt before any preview/remote request.\n  await writeFile(output, JSON.stringify({ state: 'RUNNING', gateQualified: false }), { flag: 'wx' })\n  const receipt = { state: 'NEG', gateQualified: false, worker: WORKER,\n    accountId: inventory.accountId, workerVersion: inventory.workerVersion,\n    ownerNamespace: inventory.ownerNamespace, sandboxNamespace: inventory.sandboxNamespace,\n    applicationId: inventory.applicationId, inventorySha256: hash(raw),\n    startedAt: new Date().toISOString(), remoteStarted: false, acknowledgements: [],\n    primary: null, previewStopped: false, previewStopState: 'not-started', cleanupFailure: null, externalReadbackRequired: true }\n  let preview, pendingStart, token\n  try {\n    const selectedPort = await port()\n    if (Date.now() >= inventory.expiresAt) reject('operator-window')\n    process.env.WRANGLER_LOG_SANITIZE = 'true'\n    process.env.WRANGLER_LOG = 'none'\n    process.env.WRANGLER_SEND_METRICS = 'false'\n    const { unstable_dev } = require('wrangler')\n    token = randomBytes(32).toString('hex')\n    remoteStartAttempted = true\n    receipt.remoteStarted = null // Startup may mutate preview state before readiness is returned.\n    pendingStart = unstable_dev(resolve(home, 'worker.mjs'), {\n      config: resolve(home, 'wrangler.jsonc'), local: false, accountId: inventory.accountId,\n      ip: '127.0.0.1', port: selectedPort, inspectorPort: 0, envFiles: [], persist: false,\n      durableObjects: [{ name: 'ORPHANS', class_name: 'PythonLanguageSandbox', script_name: WORKER }],\n      vars: { DRAIN_CONFIG: JSON.stringify(inventory), DRAIN_TOKEN_SHA256: hash(token) },\n      logLevel: 'none',\n      experimental: { watch: false, disableDevRegistry: true, disableExperimentalWarning: true,\n        enableContainers: false },\n    })\n    preview = await within(pendingStart, Math.min(45_000, inventory.expiresAt - Date.now()), 'preview-start')\n    receipt.remoteStarted = true\n    receipt.previewStopState = 'pending'\n    if (preview.address !== '127.0.0.1' || preview.port !== selectedPort) reject('preview-address')\n    for (const target of inventory.targets) {\n      if (Date.now() >= inventory.expiresAt) reject('operator-window')\n      // Never retry a request whose outcome is unknown. RPC cancellation is not inferred.\n      const response = await within(preview.fetch(inspect ? '/inspect' : '/drain', {\n        method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },\n        body: JSON.stringify({ sessionName: target.sessionName }),\n        signal: AbortSignal.timeout(Math.min(20_000, inventory.expiresAt - Date.now())),\n      }), Math.min(21_000, inventory.expiresAt - Date.now()), 'operator-request')\n      const bytes = await within(response.arrayBuffer(), Math.min(2000, inventory.expiresAt - Date.now()), 'operator-request')\n      if (bytes.byteLength > 1024) reject('operator-ack')\n      const ack = JSON.parse(new TextDecoder().decode(bytes))\n      if (response.status !== 200 || ack.sessionName !== target.sessionName ||\n          ack.expectedInstanceId !== target.expectedInstanceId || ack.derivedDoId !== target.expectedInstanceId ||\n          ack.mappingMatched !== true || ack.destroyAcknowledged !== !inspect || ack.withinWindow !== true ||\n          ack.externalReadbackRequired !== true) reject('operator-ack')\n      receipt.acknowledgements.push({ ...target, derivedDoId: ack.derivedDoId, mappingMatched: true, destroyAcknowledged: !inspect })\n      await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\n    }\n    receipt.state = inspect ? 'MAPPINGS-ONLY-NO-DESTROY' : 'ACKS-ONLY-AWAIT-EXTERNAL-READBACK'\n  } catch (error) { receipt.primary = closed(error) }\n  finally {\n    token = undefined\n    if (preview) {\n      try { await within(preview.stop(), 15_000, 'preview-stop'); receipt.previewStopped = true; receipt.previewStopState = 'confirmed' }\n      catch { receipt.primary ??= 'preview-stop'; receipt.previewStopState = 'unconfirmed'; receipt.cleanupFailure = 'preview-stop'; receipt.state = 'NEG' }\n    } else if (pendingStart) {\n      // A timed-out setup can still resolve. Record uncertainty before retaining its cleanup.\n      receipt.previewStopState = 'unconfirmed'\n      receipt.cleanupFailure = 'late-startup-unconfirmed'\n      await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\n      const lateCleanup = observeLateStartup(pendingStart, async update => {\n        Object.assign(receipt, update, { remoteStarted: update.cleanupFailure === 'preview-start-unconfirmed' ? null : true, cleanupObservedAt: new Date().toISOString() })\n        await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\n      })\n      // A deadline does not cancel startup. Keep its observer alive and report only closed state.\n      lateCleanup.catch(() => {\n        console.log(JSON.stringify({ state: 'NEG', code: 'late-cleanup-receipt-unconfirmed', gateQualified: false }))\n        process.exitCode = 1\n      })\n      try { await within(lateCleanup, 15_000, 'preview-stop') }\n      catch { receipt.primary ??= 'preview-stop'; receipt.state = 'NEG' }\n    }\n    receipt.finishedAt = new Date().toISOString()\n    await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\n  }\n  console.log(JSON.stringify({ state: receipt.state, acknowledgements: receipt.acknowledgements.length,\n    primary: receipt.primary, previewStopped: receipt.previewStopped, gateQualified: false }))\n  if (receipt.primary) process.exitCode = 1\n}\nexport function observeLateStartup(pendingStart, record) {\n  return pendingStart.then(async late => {\n    let update\n    try { await late.stop(); update = { previewStopped: true, previewStopState: 'confirmed-late', cleanupFailure: null } }\n    catch { update = { previewStopped: false, previewStopState: 'unconfirmed', cleanupFailure: 'preview-stop' } }\n    await record(update)\n  }, async () => {\n    await record({ previewStopped: false, previewStopState: 'unconfirmed', cleanupFailure: 'preview-start-unconfirmed' })\n  })\n}\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url))\n  main().catch(error => { console.log(JSON.stringify({ state: remoteStartAttempted ? 'NEG-OPERATION' : 'NEG-PRESTART', code: closed(error), gateQualified: false })); process.exitCode = 1 })\n"
    },
    {
      "name": "controls.test.mjs",
      "sha256": "50b0efe05a875b827bc9426352a5ed9183408a2f4dcbdd7992b4649d2f6e1c3b",
      "bytes": 9011,
      "content": "import { test } from 'node:test'\nimport assert from 'node:assert/strict'\nimport { createHash } from 'node:crypto'\nimport { ACCOUNT, APPLICATION, OWNER_NAMESPACE, SANDBOX_NAMESPACE, SESSION_NAMES, WORKER, parseArguments, validateInventory } from './contract.mjs'\nimport { createDrainHandler } from './worker.mjs'\nimport { observeLateStartup } from './run.mjs'\nconst now = 1000\nconst token = 'a'.repeat(64)\nconst tokenHash = createHash('sha256').update(token).digest('hex')\nfunction inventory() {\n  return { accountId: ACCOUNT, worker: WORKER,\n    workerVersion: '00000000-0000-4000-8000-000000000001', ownerNamespace: OWNER_NAMESPACE,\n    sandboxNamespace: SANDBOX_NAMESPACE, applicationId: APPLICATION, observedAt: 900, expiresAt: 61000,\n    targets: SESSION_NAMES.map((sessionName, index) => ({ sessionName, expectedInstanceId: String(index).repeat(64) })) }\n}\nfunction fixture(options = {}) {\n  const input = inventory(), calls = [], lookups = [], gets = []\n  const namespace = {\n    idFromName(name) {\n      lookups.push(name)\n      const target = input.targets.find(item => item.sessionName === name)\n      return { toString: () => options.wrongId ? 'e'.repeat(64) : target.expectedInstanceId }\n    },\n    get(id) { gets.push(id.toString()); return { async destroy() {\n      calls.push(id.toString())\n      await options.destroy?.()\n    } } },\n  }\n  const handler = createDrainHandler(input, tokenHash, namespace, options.clock ?? (() => now))\n  const request = (index = 0, init = {}) => handler(new Request('https://operator.invalid/drain', {\n    method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },\n    body: JSON.stringify({ sessionName: input.targets[index].sessionName }), ...init,\n  }))\n  return { input, handler, request, calls, lookups, gets }\n}\ntest('inventory requires every pin and four explicit names/provider IDs; no inferred DOID', () => {\n  assert.equal(validateInventory(inventory(), now).targets.length, 4)\n  for (const key of Object.keys(inventory())) {\n    const candidate = inventory(); delete candidate[key]\n    assert.throws(() => validateInventory(candidate, now))\n  }\n  for (const key of ['expectedInstanceId']) {\n    const candidate = inventory(); delete candidate.targets[0][key]\n    assert.throws(() => validateInventory(candidate, now))\n  }\n  const wrong = inventory(); wrong.targets[0].sessionName = 'language-' + 'f'.repeat(32)\n  assert.throws(() => validateInventory(wrong, now))\n  const duplicate = inventory(); duplicate.targets[1] = duplicate.targets[0]\n  assert.throws(() => validateInventory(duplicate, now))\n  for (const patch of [{ accountId: 'f'.repeat(32) }, { worker: 'production' }, { applicationId: 'a'.repeat(32) },\n    { sandboxNamespace: 'c'.repeat(32) }, { expiresAt: now }, { expiresAt: now + 180001 }])\n    assert.throws(() => validateInventory({ ...inventory(), ...patch }, now))\n})\ntest('actual handler uses the exact namespace DOID and serially acknowledges four destroys', async () => {\n  const f = fixture()\n  for (let index = 0; index < 4; index++) {\n    const response = await f.request(index)\n    assert.equal(response.status, 200)\n    assert.deepEqual(await response.json(), { ...f.input.targets[index], derivedDoId: f.input.targets[index].expectedInstanceId, mappingMatched: true, destroyAcknowledged: true,\n      withinWindow: true, externalReadbackRequired: true })\n  }\n  assert.deepEqual(f.lookups, SESSION_NAMES)\n  assert.deepEqual(f.calls, f.input.targets.map(target => target.expectedInstanceId))\n  assert.equal((await f.request(0)).status, 409)\n  assert.equal(f.calls.length, 4)\n})\ntest('bad authentication, malformed body, unknown target or DOID mismatch never calls destroy', async () => {\n  const f = fixture()\n  assert.equal((await f.request(0, { headers: { authorization: 'Bearer ' + 'c'.repeat(64) } })).status, 401)\n  assert.equal((await f.request(0, { body: JSON.stringify({ sessionName: 'language-' + 'f'.repeat(32) }) })).status, 403)\n  assert.equal((await f.request(0, { body: 'x'.repeat(257) })).status, 400)\n  assert.equal((await f.request(0, { body: JSON.stringify({ sessionName: SESSION_NAMES[0], extra: 'secret-sentinel' }) })).status, 400)\n  assert.deepEqual(f.calls, [])\n  const mismatch = fixture({ wrongId: true })\n  assert.equal((await mismatch.request()).status, 409)\n  assert.deepEqual(mismatch.calls, [])\n})\ntest('a pending RPC refuses overlap; its original promise must settle before the next target', async () => {\n  let release\n  const pending = new Promise(resolve => { release = resolve })\n  const f = fixture({ destroy: () => pending })\n  const first = f.request(0)\n  while (f.calls.length === 0) await new Promise(resolve => setTimeout(resolve, 0))\n  assert.equal((await f.request(1)).status, 409)\n  assert.equal(f.calls.length, 1)\n  release()\n  assert.equal((await first).status, 200)\n  assert.equal((await f.request(1)).status, 200)\n})\ntest('RPC failures stay unconfirmed, stop later operations and never expose errors/token/URL', async () => {\n  const f = fixture({ destroy() { throw new Error('secret-sentinel https://private.invalid/' + token) } })\n  const result = await f.request()\n  assert.equal(result.status, 503)\n  const text = await result.text()\n  assert.deepEqual(JSON.parse(text), { code: 'destroy-unconfirmed', externalReadbackRequired: true })\n  assert.equal(text.includes('secret-sentinel'), false)\n  assert.equal(text.includes(token), false)\n  assert.equal(text.includes('private.invalid'), false)\n  assert.equal((await f.request(1)).status, 410)\n  assert.equal(f.calls.length, 1)\n})\ntest('an already-expired deadline prevents every RPC', async () => {\n  let clock = now\n  const f = fixture({ clock: () => clock })\n  clock = 61000\n  assert.equal((await f.request()).status, 410)\n  assert.deepEqual(f.calls, [])\n})\n\ntest('inspect derives and compares all four IDs without getStub or destroy', async () => {\n  const f = fixture()\n  for (const target of f.input.targets) {\n    const response = await f.handler(new Request('https://operator.invalid/inspect', {\n      method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },\n      body: JSON.stringify({ sessionName: target.sessionName }),\n    }))\n    assert.equal(response.status, 200)\n    assert.deepEqual(await response.json(), { ...target, derivedDoId: target.expectedInstanceId,\n      mappingMatched: true, destroyAcknowledged: false, withinWindow: true, externalReadbackRequired: true })\n  }\n  assert.deepEqual(f.lookups, SESSION_NAMES)\n  assert.deepEqual(f.gets, [])\n  assert.deepEqual(f.calls, [])\n})\n\ntest('expiry while consuming a request body blocks the later destroy', async () => {\n  let clock = now\n  const f = fixture({ clock: () => clock })\n  const data = new TextEncoder().encode(JSON.stringify({ sessionName: SESSION_NAMES[0] }))\n  const body = new ReadableStream({ pull(controller) {\n    clock = 61000\n    controller.enqueue(data); controller.close()\n  } })\n  const response = await f.request(0, { body, duplex: 'half' })\n  assert.equal(response.status, 410)\n  assert.deepEqual(f.lookups, [])\n  assert.deepEqual(f.gets, [])\n  assert.deepEqual(f.calls, [])\n})\n\ntest('CLI rejects duplicate, unknown, missing and mixed mode arguments before any provider code', () => {\n  assert.deepEqual(parseArguments(['--verify', '--inventory', 'input.json']), { mode: 'verify', inventory: 'input.json' })\n  assert.deepEqual(parseArguments(['--inspect', '--inventory', 'input.json', '--output', 'out.json']),\n    { mode: 'inspect', inventory: 'input.json', output: 'out.json' })\n  for (const args of [[], ['--execute'], ['--unknown'], ['--verify','--verify','--inventory','input'],\n    ['--inspect','--execute','--inventory','input','--output','out'],\n    ['--execute','--inventory','input','--inventory','other','--output','out'],\n    ['--execute','--inventory','input','--output','--execute'],\n    ['--verify','--inventory','input','--output','out'], ['--execute','--inventory','input','positional']])\n    assert.throws(() => parseArguments(args))\n})\ntest('late startup cleanup records confirmation or closed failure without swallowing unknown', async () => {\n  let resolveStart\n  const pending = new Promise(resolve => { resolveStart = resolve })\n  const updates = []\n  let stopped = 0\n  const observer = observeLateStartup(pending, async update => updates.push(update))\n  assert.deepEqual(updates, [])\n  resolveStart({ async stop() { stopped++ } })\n  await observer\n  assert.equal(stopped, 1)\n  assert.deepEqual(updates, [{ previewStopped: true, previewStopState: 'confirmed-late', cleanupFailure: null }])\n  for (const promise of [Promise.reject(new Error('secret-sentinel')), Promise.resolve({\n    async stop() { throw new Error('secret-sentinel') },\n  })]) {\n    const result = []\n    await observeLateStartup(promise, async update => result.push(update))\n    assert.equal(result[0].previewStopped, false)\n    assert.equal(result[0].previewStopState, 'unconfirmed')\n    assert.equal(JSON.stringify(result).includes('secret-sentinel'), false)\n  }\n})\n"
    },
