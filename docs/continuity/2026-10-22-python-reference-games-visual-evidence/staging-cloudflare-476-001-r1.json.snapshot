      "contentUtf8": "import { execFile } from 'node:child_process'\nimport { createHash } from 'node:crypto'\nimport { closeSync, ftruncateSync, openSync, writeSync } from 'node:fs'\nimport { lstat, readFile } from 'node:fs/promises'\nimport { join, resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nexport const PROJECT = '415d5a1c-5f75-432c-8445-b395d0977ce3'\nexport const ENVIRONMENT = 'f634cff6-aafb-4804-8b69-172fad4e946e'\nexport const COMMUNITY = '9df1b493-4cea-4b36-bec8-7299f054c17d'\nconst HISTORICAL_SERVICE = 'e00eca0b-5323-4424-9b58-fdb073cfce82'\nexport const ORIGIN = 'https://sistemazero-studio-language-staging.helena-bcc.workers.dev'\nconst HISTORICAL_DIRECTORY = 'C:/Users/tocha/projects/sistema-zero-python/.cache/studio-python-l0'\nconst HEX64 = /^[a-f0-9]{64}$/\nconst HEX32 = /^[a-f0-9]{32}$/\nexport const RECEIPTS = Object.freeze([\n  'd5cafcaf227fc0b67982b6d7207a49938022e7ff2bdf39bb0aba25564ff688e9',\n  '6ca20838bd531ebe8a37b1cb0c7fff8a2ba795cfcd8d03f8674a2619f381a0af',\n  '91f0e48a05221ce91f2579d2a837e36f56d07059853d0f1c6caa2f106194869d',\n  '0f3ca11cbb796a1b07e99732e26570ac352e0eba2fdef44bb2ccb8d291884e16',\n  '10d18874941b264ad1bf06f54897e31c5b3eb08c04d5037fd0cddf895e7d65fd',\n  '72843eb9e94c133f0de41b1ddb34974d04ef01225aab4ae5016898cc4ea011a4',\n  'e76758a710557ca8c094a57e92c718f47b3802f2e8a30d99af6913ae6d337b2d',\n].map((sha256, index) => Object.freeze({\n  file: `staging-python-language-qualified-20261019-r${index + 1}.json`, sha256,\n})))\nconst digest = bytes => createHash('sha256').update(bytes).digest('hex')\nfunction fail(code) { throw Object.assign(new Error(code), { code }) }\nconst SAFE_CODES = new Set(['arguments', 'node-pin', 'receipt-file', 'receipt-hash', 'receipt-json',\n  'receipt-identity', 'receipt-cleanup', 'receipt-hashes', 'duplicate-target', 'railway-pin',\n  'railway-read', 'railway-config', 'request-timeout', 'close-http', 'close-ack', 'close-transport',\n  'existing-output', 'receipt-write', 'operation-unconfirmed'])\nexport const safeError = error => SAFE_CODES.has(error?.code) ? error.code : 'operation-unconfirmed'\n\nexport function parseArguments(argv) {\n  if (argv.length === 1 && argv[0] === '--verify') return { mode: 'verify' }\n  if (argv.length === 3 && argv[0] === '--execute' && argv[1] === '--output' && argv[2] && !argv[2].startsWith('--'))\n    return { mode: 'execute', output: resolve(argv[2]) }\n  fail('arguments')\n}\n\nexport function validateHistoricalReceipt(value) {\n  if (value?.kind !== 'staging-python-language-real-worker' || value.environment !== 'staging' ||\n      value.project !== PROJECT || value.environmentId !== ENVIRONMENT || value.serviceId !== HISTORICAL_SERVICE ||\n      value.origin !== ORIGIN || !HEX64.test(value.owner) || !HEX32.test(value.sessionId) ||\n      value.sourceExecuted !== false || value.configurationChanged !== false || value.retriesPerformed !== false ||\n      !['failed', 'passed'].includes(value.state)) fail('receipt-identity')\n  if (value.cleanup?.required !== true || value.cleanup.confirmed !== true || value.cleanup.retirementConfirmed !== true)\n    fail('receipt-cleanup')\n  if (!HEX64.test(value.harnessSha256) || !HEX64.test(value.fixtureSha256?.before) || !HEX64.test(value.fixtureSha256?.after) ||\n      !value.contracts || typeof value.contracts !== 'object' || Array.isArray(value.contracts) ||\n      Object.keys(value.contracts).length < 6 || Object.values(value.contracts).some(hash => typeof hash !== 'string' || !HEX64.test(hash)))\n    fail('receipt-hashes')\n  return Object.freeze({ owner: value.owner, sessionId: value.sessionId })\n}\n\nexport async function readTargets() {\n  const targets = [], owners = new Set(), sessions = new Set()\n  for (const pin of RECEIPTS) {\n    let bytes\n    try {\n      const path = join(HISTORICAL_DIRECTORY, pin.file), stat = await lstat(path)\n      if (!stat.isFile() || stat.isSymbolicLink() || stat.size > 32_768) fail('receipt-file')\n      bytes = await readFile(path)\n      if (bytes.byteLength > 32_768) fail('receipt-file')\n    } catch { fail('receipt-file') }\n    if (digest(bytes) !== pin.sha256) fail('receipt-hash')\n    let value\n    try { value = JSON.parse(bytes.toString('utf8')) } catch { fail('receipt-json') }\n    const target = validateHistoricalReceipt(value)\n    if (owners.has(target.owner) || sessions.has(target.sessionId)) fail('duplicate-target')\n    owners.add(target.owner); sessions.add(target.sessionId)\n    targets.push(Object.freeze({ ...target, receiptFile: pin.file, receiptSha256: pin.sha256 }))\n  }\n  return Object.freeze(targets)\n}\n\nexport function validateVariables(variables) {\n  if (variables?.STUDIO_PYTHON_LANGUAGE_URL !== ORIGIN ||\n      typeof variables.STUDIO_PYTHON_LANGUAGE_TOKEN !== 'string' ||\n      variables.STUDIO_PYTHON_LANGUAGE_TOKEN.length < 32 || variables.STUDIO_PYTHON_LANGUAGE_TOKEN.length > 4096 ||\n      /[\\r\\n]/.test(variables.STUDIO_PYTHON_LANGUAGE_TOKEN)) fail('railway-config')\n  return variables.STUDIO_PYTHON_LANGUAGE_TOKEN\n}\n\nasync function readCredential() {\n  const directory = join(process.env.APPDATA ?? '', 'npm/node_modules/@railway/cli')\n  let pkg\n  try { pkg = JSON.parse(await readFile(join(directory, 'package.json'), 'utf8')) } catch { fail('railway-pin') }\n  if (pkg.version !== '5.62.1') fail('railway-pin')\n  // Never use a shell, implicit linked project, inherited environment selection, or log child output.\n  let raw = await new Promise((ok, no) => {\n    execFile(join(directory, 'bin/railway.exe'), [\n      'variable', 'list', '--project', PROJECT, '--environment', ENVIRONMENT, '--service', COMMUNITY, '--json',\n    ], { encoding: 'utf8', windowsHide: true, timeout: 25_000, maxBuffer: 1_048_576 }, (error, stdout) => {\n      if (error) no(Object.assign(new Error('railway-read'), { code: 'railway-read' }))\n      else ok(stdout)\n    })\n  })\n  let variables\n  try { variables = JSON.parse(raw) } catch { fail('railway-config') }\n  finally { raw = undefined }\n  try { return validateVariables(variables) } finally { variables = undefined }\n}\n\nasync function readAck(response, signal) {\n  if (!response.body) fail('close-ack')\n  const reader = response.body.getReader(), parts = []\n  let bytes = 0, complete = false\n  try {\n    for (;;) {\n      signal.throwIfAborted()\n      const next = await reader.read()\n      if (next.done) { complete = true; break }\n      bytes += next.value.byteLength\n      if (bytes > 1024) fail('close-ack')\n      parts.push(next.value)\n    }\n    signal.throwIfAborted()\n    let result\n    try { result = JSON.parse(Buffer.concat(parts, bytes).toString('utf8')) } catch { fail('close-ack') }\n    if (result?.closed !== true) fail('close-ack')\n  } finally {\n    if (!complete) { try { await reader.cancel() } catch { /* Request outcome remains unconfirmed. */ } }\n    reader.releaseLock()\n  }\n}\n\n/** Test seam is at HTTP/checkpoint only; targets are always reloaded from pinned originals. */\nexport async function closeKnownSessions({ token, fetchImpl = fetch, checkpoint, timeoutMs = 20_000 }) {\n  const targets = await readTargets()\n  for (const target of targets) {\n    const attempt = { ...target, startedAt: new Date().toISOString(), state: 'pending', status: null, closed: false, remoteOutcomeUnknown: true }\n    await checkpoint(attempt)\n    const controller = new AbortController()\n    const timer = setTimeout(() => controller.abort(), timeoutMs)\n    try {\n      const response = await fetchImpl(`${ORIGIN}/v1/python-language/${target.owner}/${target.sessionId}`, {\n        method: 'DELETE', headers: { authorization: `Bearer ${token}` },\n        redirect: 'error', credentials: 'omit', cache: 'no-store', signal: controller.signal,\n      })\n      attempt.status = response.status\n      if (response.status !== 200) {\n        try { await response.body?.cancel() } catch { /* The non-200 status already fails this close. */ }\n        fail('close-http')\n      }\n      await readAck(response, controller.signal)\n      attempt.state = 'acknowledged'; attempt.closed = true; attempt.remoteOutcomeUnknown = false\n      attempt.finishedAt = new Date().toISOString()\n      await checkpoint(attempt)\n    } catch (error) {\n      attempt.state = error?.code === 'close-http' ? 'negative' : 'unknown'\n      attempt.failure = controller.signal.aborted ? 'request-timeout' : safeError(error) === 'operation-unconfirmed' ? 'close-transport' : safeError(error)\n      attempt.finishedAt = new Date().toISOString()\n      await checkpoint(attempt)\n      fail(attempt.failure)\n    } finally { clearTimeout(timer); controller.abort() }\n  }\n}\n\nasync function main() {\n  const args = parseArguments(process.argv.slice(2))\n  if (process.versions.node !== '24.22.0') fail('node-pin')\n  const targets = await readTargets()\n  if (args.mode === 'verify') {\n    console.log(JSON.stringify({ state: 'OFFLINE-ONLY', targets, credentialsRead: false, requestsSent: 0, gateQualified: false }))\n    return\n  }\n  let fd\n  try { fd = openSync(args.output, 'wx') } catch { fail('existing-output') }\n  const receipt = {\n    kind: 'staging-seven-known-language-sessions-close', state: 'RUNNING', startedAt: new Date().toISOString(),\n    origin: ORIGIN, project: PROJECT, environmentId: ENVIRONMENT, credentialService: COMMUNITY,\n    targets, attempts: [], failure: null, gateQualified: false, physicalCleanupVerified: false,\n    externalVersionNamespaceRevalidationRequired: true, externalReadbackRequired: true,\n    credentialsRecorded: false, retriesPerformed: false, configurationChanged: false,\n  }\n  function flush() {\n    try {\n      const bytes = Buffer.from(JSON.stringify(receipt, null, 2) + '\\n')\n      let written = 0\n      while (written < bytes.length) written += writeSync(fd, bytes, written, bytes.length - written, written)\n      ftruncateSync(fd, bytes.length)\n    } catch { fail('receipt-write') }\n  }\n  let token\n  try {\n    flush() // Exclusive receipt exists before credential access or any network operation.\n    token = await readCredential()\n    await closeKnownSessions({ token, checkpoint(attempt) {\n      const index = receipt.attempts.findIndex(row => row.sessionId === attempt.sessionId)\n      if (index < 0) receipt.attempts.push({ ...attempt })\n      else receipt.attempts[index] = { ...attempt }\n      flush()\n    } })\n    receipt.state = 'ACKS-ONLY-AWAIT-EXTERNAL-READBACK'\n  } catch (error) { receipt.state = 'NEG'; receipt.failure = safeError(error); process.exitCode = 1 }\n  finally {\n    token = undefined; receipt.finishedAt = new Date().toISOString()\n    try { flush() } finally { closeSync(fd) }\n  }\n  console.log(JSON.stringify({ state: receipt.state, acknowledged: receipt.attempts.filter(item => item.closed).length,\n    failure: receipt.failure, gateQualified: false, physicalCleanupVerified: false }))\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url))\n  main().catch(error => { console.log(JSON.stringify({ state: 'NEG', code: safeError(error), gateQualified: false })); process.exitCode = 1 })\n"
    },
    {
      "path": ".cache/python-reference-games/close-seven-language-sessions-r1/controls.test.mjs",
      "originalBytes": 7166,
      "originalSha256": "5443ca55d6175abd3891c210e0968db74087d0d36c08989a023922d08780301a",
      "representation": "exact-utf8",
      "role": "reviewed-helper-source; credentials accessed only at execution, never embedded",
      "contentUtf8": "import assert from 'node:assert/strict'\nimport { readFile } from 'node:fs/promises'\nimport test from 'node:test'\nimport { closeKnownSessions, ORIGIN, parseArguments, readTargets, RECEIPTS, safeError, validateHistoricalReceipt, validateVariables } from './run.mjs'\n\nconst TOKEN = 'inert-test-credential-never-used-on-a-network'\nconst historicRoot = 'C:/Users/tocha/projects/sistema-zero-python/.cache/studio-python-l0/'\nconst expectCode = (action, code) => assert.throws(action, error => safeError(error) === code)\n\ntest('offline originals have the seven exact pins, validated identities and unique known owners', async () => {\n  const targets = await readTargets()\n  assert.equal(targets.length, 7)\n  assert.equal(new Set(targets.map(target => target.owner)).size, 7)\n  assert.equal(new Set(targets.map(target => target.sessionId)).size, 7)\n  assert.deepEqual(targets.map(target => target.receiptSha256), RECEIPTS.map(pin => pin.sha256))\n  for (const target of targets) {\n    assert.match(target.owner, /^[a-f0-9]{64}$/)\n    assert.match(target.sessionId, /^[a-f0-9]{32}$/)\n  }\n})\n\ntest('receipt context, cleanup and internal hashes are fail closed', async () => {\n  const value = JSON.parse(await readFile(historicRoot + RECEIPTS[0].file, 'utf8'))\n  assert.doesNotThrow(() => validateHistoricalReceipt(value)) // Failed historical QA still confirmed its Close.\n  for (const patch of [{ environment: 'production' }, { project: 'wrong' }, { environmentId: 'wrong' },\n    { serviceId: 'wrong' }, { origin: 'https://example.invalid' }, { owner: 'a'.repeat(63) }, { sessionId: 'b'.repeat(33) },\n    { sourceExecuted: true }, { configurationChanged: true }])\n    expectCode(() => validateHistoricalReceipt({ ...value, ...patch }), 'receipt-identity')\n  for (const field of ['required', 'confirmed', 'retirementConfirmed'])\n    expectCode(() => validateHistoricalReceipt({ ...value, cleanup: { ...value.cleanup, [field]: false } }), 'receipt-cleanup')\n  expectCode(() => validateHistoricalReceipt({ ...value, harnessSha256: 'broken' }), 'receipt-hashes')\n  expectCode(() => validateHistoricalReceipt({ ...value, fixtureSha256: {} }), 'receipt-hashes')\n  expectCode(() => validateHistoricalReceipt({ ...value, contracts: { malformed: 'secret' } }), 'receipt-hashes')\n})\n\ntest('only explicit verify or execute with new output syntax is admitted', () => {\n  assert.deepEqual(parseArguments(['--verify']), { mode: 'verify' })\n  assert.equal(parseArguments(['--execute', '--output', 'receipt.json']).mode, 'execute')\n  for (const args of [[], ['--execute'], ['--verify', '--execute'], ['--execute', '--output', '--verify'],\n    ['--execute', '--origin', ORIGIN], ['--execute', '--output', 'r.json', '--retry']])\n    expectCode(() => parseArguments(args), 'arguments')\n})\n\ntest('credential reader admits only the exact staging origin and a bounded header-safe token', () => {\n  assert.equal(validateVariables({ STUDIO_PYTHON_LANGUAGE_URL: ORIGIN, STUDIO_PYTHON_LANGUAGE_TOKEN: TOKEN }), TOKEN)\n  for (const value of [null, {}, { STUDIO_PYTHON_LANGUAGE_URL: ORIGIN + '/', STUDIO_PYTHON_LANGUAGE_TOKEN: TOKEN },\n    { STUDIO_PYTHON_LANGUAGE_URL: ORIGIN, STUDIO_PYTHON_LANGUAGE_TOKEN: 'tiny' },\n    { STUDIO_PYTHON_LANGUAGE_URL: ORIGIN, STUDIO_PYTHON_LANGUAGE_TOKEN: TOKEN + '\\r\\nsecret' }])\n    expectCode(() => validateVariables(value), 'railway-config')\n  assert.equal(safeError(new Error(TOKEN)), 'operation-unconfirmed')\n})\n\ntest('seven DELETEs are serial, pinned, checkpointed before dispatch, and all ACKs are preserved', async () => {\n  const targets = await readTargets(), attempts = [], calls = []\n  let inFlight = 0\n  await closeKnownSessions({ token: TOKEN, checkpoint(attempt) { attempts.push(structuredClone(attempt)) },\n    async fetchImpl(url, request) {\n      const target = targets[calls.length]\n      assert.equal(inFlight++, 0)\n      assert.equal(attempts.at(-1).state, 'pending')\n      assert.equal(attempts.at(-1).sessionId, target.sessionId)\n      assert.equal(url, `${ORIGIN}/v1/python-language/${target.owner}/${target.sessionId}`)\n      assert.equal(request.method, 'DELETE')\n      assert.equal(request.headers.authorization, `Bearer ${TOKEN}`)\n      assert.equal(request.redirect, 'error')\n      calls.push(url)\n      await Promise.resolve()\n      inFlight--\n      return Response.json({ closed: true })\n    },\n  })\n  assert.equal(calls.length, 7)\n  assert.equal(attempts.length, 14)\n  assert.equal(attempts.filter(item => item.closed).length, 7)\n  assert.equal(attempts.at(-1).remoteOutcomeUnknown, false)\n  assert.equal(JSON.stringify(attempts).includes(TOKEN), false)\n})\n\ntest('negative HTTP stops immediately without retry and retains prior acknowledgements', async () => {\n  const attempts = []\n  let calls = 0\n  await assert.rejects(closeKnownSessions({ token: TOKEN, checkpoint(attempt) { attempts.push(structuredClone(attempt)) },\n    async fetchImpl() { return ++calls === 1 ? Response.json({ closed: true }) : Response.json({ error: TOKEN }, { status: 503 }) },\n  }), error => safeError(error) === 'close-http')\n  assert.equal(calls, 2)\n  assert.equal(attempts.filter(item => item.closed).length, 1)\n  assert.equal(attempts.at(-1).state, 'negative')\n  assert.equal(attempts.at(-1).remoteOutcomeUnknown, true)\n  assert.equal(JSON.stringify(attempts).includes(TOKEN), false)\n})\n\ntest('lost reply, invalid ACK, oversized ACK and body failure remain unknown and stop', async () => {\n  for (const response of [() => { throw new Error(`transport contains ${TOKEN}`) },\n    () => Response.json({ closed: false }), () => new Response('{malformed'),\n    () => Response.json({ closed: true, padding: 'x'.repeat(1024) }),\n    () => new Response(new ReadableStream({ start(controller) { controller.error(new Error(TOKEN)) } }))]) {\n    const attempts = []\n    let calls = 0\n    await assert.rejects(closeKnownSessions({ token: TOKEN, checkpoint(attempt) { attempts.push(structuredClone(attempt)) },\n      async fetchImpl() { calls++; return response() },\n    }))\n    assert.equal(calls, 1)\n    assert.equal(attempts.at(-1).state, 'unknown')\n    assert.equal(attempts.at(-1).remoteOutcomeUnknown, true)\n    assert.equal(JSON.stringify(attempts).includes(TOKEN), false)\n  }\n})\n\ntest('per-call deadline cancels the pending request and never dispatches the next owner', async () => {\n  const attempts = []\n  let calls = 0, aborted = false\n  await assert.rejects(closeKnownSessions({ token: TOKEN, timeoutMs: 5, checkpoint(attempt) { attempts.push(structuredClone(attempt)) },\n    fetchImpl(_url, { signal }) {\n      calls++\n      return new Promise((_ok, no) => signal.addEventListener('abort', () => {\n        aborted = true; no(signal.reason)\n      }, { once: true }))\n    },\n  }), error => safeError(error) === 'request-timeout')\n  assert.equal(aborted, true)\n  assert.equal(calls, 1)\n  assert.equal(attempts.at(-1).remoteOutcomeUnknown, true)\n})\n\ntest('failure to persist the pending checkpoint prevents any DELETE', async () => {\n  let calls = 0\n  await assert.rejects(closeKnownSessions({ token: TOKEN, checkpoint() { throw new Error('disk') },\n    async fetchImpl() { calls++; return Response.json({ closed: true }) },\n  }))\n  assert.equal(calls, 0)\n})\n"
    },
    {
      "path": ".cache/python-reference-games/close-seven-language-sessions-r1/PLAN.md",
      "originalBytes": 3395,
      "originalSha256": "0477bde30e745017a67c3ed563297e4753348acc95a6899a73fd1c39dde7ab08",
      "representation": "exact-utf8",
      "role": "reviewed-helper-source; credentials accessed only at execution, never embedded",
      "contentUtf8": "# Fechamento explícito de sete sessões QA antigas\n\nHelper privado preparado para a Root. **Nenhuma consulta Railway, requisição DELETE ou\nqualificação remota foi executada na preparação.** Não altera arquivos versionados.\n\nSomente os sete recibos `staging-python-language-qualified-20261019-r1..r7.json`\ndo cache histórico `C:/Users/tocha/projects/sistema-zero-python/.cache/studio-python-l0`\npodem fornecer os alvos. Os SHA256 completos estão fixados em `run.mjs`; os arquivos\ncontinuam inalterados. O leitor confere projeto, ambiente staging, serviço histórico\nAdmin, origem, owner64hex/session32hex, hashes internos e os dois ACKs históricos de\ncleanup/retirement. R1–R5 tiveram QA falho, mas Close confirmado; isso não vira aceite\nde execução. Os quatro órfãos sem owner confirmado não pertencem a este helper.\n\nAntes do modo execute, a Root deve ter CI verde, callers pausados e readback fresco\nque confirme o Worker antigo `2606bc1c-fc5d-4702-9ea8-6995955ff06e`, Owner\n`bf106446ef9e495997e39a02f008a526`, Sandbox `fb9d81d3e52b489faf23ed8c74cea71a`\ne migration tag histórica esperada. Este helper não inventa esse gate externo.\n\nUsar Node **24.22.0**. Exemplos a partir da raiz do worktree:\n\n```powershell\nnode .cache/python-reference-games/close-seven-language-sessions-r1/run.mjs --verify\n# SOMENTE a Root, depois dos gates externos; output ainda inexistente:\nnode .cache/python-reference-games/close-seven-language-sessions-r1/run.mjs --execute --output .cache/python-reference-games/seven-sessions-close-<rodada-nova>.json\n```\n\nVerify é inteiramente offline e não obtém credenciais. Execute reserva arquivo novo\ncom `wx` e grava RUNNING antes de consultar Railway. Usa a CLI local pinada **5.62.1**\ncom `variable list --project 415d5a1c-5f75-432c-8445-b395d0977ce3 --environment\nf634cff6-aafb-4804-8b69-172fad4e946e --service\n9df1b493-4cea-4b36-bec8-7299f054c17d --json`. Nenhuma seleção vem do link local.\nURL deve ser exatamente o Worker language-staging. Token somente RAM/header; não é\nargumento, log, hash ou dado de recibo. Stdout/stderr da CLI nunca são publicados.\n\nCada DELETE `/v1/python-language/<owner>/<sessionId>` tem prazo de20s incluindo corpo,\nredirect recusado e ACK limitado a1024bytes. Exige HTTP200 e `closed:true`. São sete\nchamadas seriais; não há retry, Open/Start, rotação de token ou criação de alvo. O\ncheckpoint pending precede a chamada; cada ACK atualiza o recibo. Qualquer erro,\nstatus negativo ou resposta incompleta interrompe a fila e preserva os anteriores.\nTodo resultado sem ACK válido mantém `remoteOutcomeUnknown:true`, inclusive HTTP\nnegativo: status sozinho não prova que nenhum efeito ocorreu. Não repetir cegamente.\n\nO resultado máximo é `ACKS-ONLY-AWAIT-EXTERNAL-READBACK`, sempre `gateQualified:false`\ne `physicalCleanupVerified:false`. A Root ainda precisa readback provider completo,\nconferência de ausência de live/pending e eventual drain separado dos quatro órfãos.\nEstes sete ACKs não reescrevem os recibos históricos nem provam eliminação física.\n\nControles `node --test .../controls.test.mjs` exercitam o helper real com fronteira\nHTTP inerte: pins locais, identidade, cleanup, credencial, serialidade, interrupção,\nprazo, corpo inválido e não vazamento. Não são prova de autenticação, RPC, Cloudflare,\nRailway ou cleanup hospedado. Não iniciam servidor nem contêiner.\n"
    },
    {
      "path": ".cache/python-reference-games/read-staging-platform-r1.ps1",
      "originalBytes": 4144,
      "originalSha256": "2a64454aac7aecae475599207443e18a4eb8d362f9ad714c7462d507470a8fa0",
      "representation": "exact-utf8",
      "role": "reviewed-helper-source; credentials accessed only at execution, never embedded",
      "contentUtf8": "param([Parameter(Mandatory=$true)][ValidatePattern('^[a-z0-9-]+$')][string]$RunName)\n$ErrorActionPreference='Stop'\n$destination=Join-Path $PSScriptRoot $RunName\nif(Test-Path -LiteralPath $destination){throw 'Read-only output already exists'}\n[void](New-Item -ItemType Directory -Path $destination)\n$auth=$null\n$headers=$null\ntry {\n  $authText=& 'C:/Users/tocha/projects/sistema-zero-python/.cache/studio-python-l0/node-v24.22.0/node-v24.22.0-win-x64/node.exe' 'packages/studio-runtime/node_modules/wrangler/bin/wrangler.js' auth token --json 2>$null\n  if($LASTEXITCODE -ne 0){throw 'Cloudflare authentication unavailable'}\n  $auth=($authText -join \"`n\")|ConvertFrom-Json\n  $authText=$null\n  if($auth.type -notin @('oauth','api_token') -or -not $auth.token){throw 'Expected token authentication'}\n  $headers=@{Authorization=('Bearer '+$auth.token)}\n  # The admission window covers the oldest GET, not just the final response.\n  $observedAt=[DateTime]::UtcNow\n  $api='https://api.cloudflare.com/client/v4/accounts/bcc0f2d44140e05b69152cba326132f8'\n  function Get-CloudflareRecord([string]$Path) {\n    $response=Invoke-RestMethod -Uri ($api+$Path) -Headers $headers -Method Get -TimeoutSec 30\n    if(-not $response.success){throw 'Cloudflare read failed'}\n    return $response\n  }\n  $workers=@()\n  $scriptMetadata=(Get-CloudflareRecord '/workers/scripts').result\n  foreach($worker in @('sistemazero-studio-runtime-staging','sistemazero-studio-language-staging')) {\n    $script=@($scriptMetadata | Where-Object id -eq $worker)\n    if($script.Count -ne 1 -or -not $script[0].migration_tag){throw 'Applied migration tag is unavailable'}\n    $deployment=(Get-CloudflareRecord \"/workers/scripts/$worker/deployments\").result.deployments[0]\n    if($deployment.versions.Count -ne 1 -or $deployment.versions[0].percentage -ne 100){throw 'Unexpected split deployment'}\n    $version=(Get-CloudflareRecord \"/workers/scripts/$worker/versions/$($deployment.versions[0].version_id)\").result\n    $bindings=@($version.resources.bindings | Where-Object type -eq 'durable_object_namespace' | Select-Object name,namespace_id,class_name,script_name)\n    $publicVars=@($version.resources.bindings | Where-Object { $_.type -eq 'plain_text' -and $_.name -in @('STUDIO_PYTHON_DISTRIBUTIONS_SHA256','STUDIO_PYTHON_PREVIEW_ORIGIN') } | Select-Object name,text)\n    $workers+=@{name=$worker;version=$version.id;deployment=$deployment.id;migrationTag=$script[0].migration_tag;bindings=$bindings;publicVars=$publicVars}\n  }\n  $application='a03225c7-85d7-4bd6-9919-a63ba03178af'\n  $app=(Get-CloudflareRecord \"/containers/applications/$application\").result\n  if($app.id -ne $application -or $app.name -ne 'sistemazero-studio-language-staging-pythonlanguagesandbox-staging' -or $app.durable_objects.namespace_id -ne 'fb9d81d3e52b489faf23ed8c74cea71a'){throw 'Application identity changed'}\n  $appPublic=@{id=$app.id;name=$app.name;namespaceId=$app.durable_objects.namespace_id;image=$app.configuration.image;health=$app.health;version=$app.version;updatedAt=$app.updated_at}\n  $instancesResponse=Get-CloudflareRecord \"/containers/dash/applications/$application/instances?per_page=100\"\n  if($instancesResponse.result_info.next_page_token){throw 'Container pagination requires continuation'}\n  $instances=$instancesResponse.result\n  $receipt=[ordered]@{kind='staging-platform-read-only';observedAt=$observedAt.ToString('o');readCompletedAt=[DateTime]::UtcNow.ToString('o');accountId='bcc0f2d44140e05b69152cba326132f8';workers=$workers;applicationId=$application;application=$appPublic;instances=$instances;result_info=$instancesResponse.result_info;configurationChanged=$false;secretsRecorded=$false}\n  $file=Join-Path $destination 'receipt.json'\n  [IO.File]::WriteAllText($file,($receipt|ConvertTo-Json -Depth 18),[Text.UTF8Encoding]::new($false))\n  @{receipt=$file;workers=$workers;instanceResultType=$instances.GetType().Name;configurationChanged=$false}|ConvertTo-Json -Depth 9\n} catch {\n  Write-Error 'Read-only Cloudflare inspection failed; no configuration was changed and credentials were not logged.'\n  exit 1\n} finally {\n  $auth=$null\n  $headers=$null\n  $authText=$null\n}\n"
    },
    {
      "path": ".cache/python-reference-games/prepare-fresh-orphan-inventory-r2.mjs",
      "originalBytes": 3900,
      "originalSha256": "45976c9d8ecabd2bf45d0ebe2895bb6fc0a19b52dd464d882e8ba33c61a1c163",
      "representation": "exact-utf8",
      "role": "reviewed-helper-source; credentials accessed only at execution, never embedded",
      "contentUtf8": "import { readFile, writeFile } from 'node:fs/promises'\nimport { resolve } from 'node:path'\nimport { ACCOUNT, APPLICATION, WORKER, OWNER_NAMESPACE, SANDBOX_NAMESPACE, SESSION_NAMES, validateInventory } from './orphan-drain-prep-r1/contract.mjs'\n\nconst [sourcePath, destinationPath] = process.argv.slice(2)\nif (!sourcePath || !destinationPath || process.argv.length !== 4) throw Error('Explicit fresh read and new output required')\nconst source = JSON.parse(await readFile(resolve(sourcePath), 'utf8'))\n// Wrangler's pinned dash reader normalizes an absent next_page_token to null.\nif (source.kind !== 'staging-platform-read-only' || source.accountId !== ACCOUNT || source.applicationId !== APPLICATION ||\n    source.configurationChanged !== false || source.result_info?.per_page !== 100 ||\n    (source.result_info.next_page_token ?? null) !== null) throw Error('Unqualified external read')\nconst workers = source.workers.filter(worker => worker.name === WORKER)\nif (workers.length !== 1 || workers[0].version !== '2606bc1c-fc5d-4702-9ea8-6995955ff06e' || workers[0].migrationTag !== 'v1') throw Error('Old Worker or migration changed')\nfor (const [name, id] of [['PythonLanguageOwner', OWNER_NAMESPACE], ['PythonLanguageSandbox', SANDBOX_NAMESPACE]]) {\n  const bindings = workers[0].bindings.filter(binding => binding.name === name)\n  if (bindings.length !== 1 || bindings[0].namespace_id !== id || bindings[0].class_name !== name || bindings[0].script_name !== null) throw Error('Namespace identity changed')\n}\nconst app = source.application\nif (app.id !== APPLICATION || app.namespaceId !== SANDBOX_NAMESPACE ||\n    app.name !== 'sistemazero-studio-language-staging-pythonlanguagesandbox-staging' || app.health.errors.length) throw Error('Application identity changed')\nfor (const state of ['active', 'assigned', 'scheduling', 'starting']) if (app.health.instances[state] !== 0) throw Error('Application still has live or pending work')\nif (!Array.isArray(source.instances.instances) || source.instances.instances.length !== 0) throw Error('Physical instances remain')\nconst history = JSON.parse(await readFile(new URL('./staging-language-instances-inspect-r1.json', import.meta.url), 'utf8')).instances\nconst records = source.instances.durable_objects\nif (!Array.isArray(records) || records.length !== 11 || history.length !== 11) throw Error('Historical inventory changed')\nconst seen = new Set()\nfor (const record of records) {\n  if (seen.has(record.id) || !history.some(expected => expected.id === record.id && expected.name === record.name && expected.state === 'inactive')) throw Error('Unknown or duplicate historical target')\n  seen.add(record.id)\n}\nconst observedAt = Date.parse(source.observedAt)\nconst readCompletedAt = Date.parse(source.readCompletedAt)\nif (!Number.isSafeInteger(observedAt) || !Number.isSafeInteger(readCompletedAt) ||\n    readCompletedAt < observedAt || readCompletedAt > Date.now() ||\n    readCompletedAt - observedAt >= 180_000) throw Error('External observation window expired or unqualified')\nconst inventory = validateInventory({ accountId: ACCOUNT, worker: WORKER, workerVersion: workers[0].version,\n  ownerNamespace: OWNER_NAMESPACE, sandboxNamespace: SANDBOX_NAMESPACE, applicationId: APPLICATION,\n  observedAt, expiresAt: observedAt + 180_000,\n  targets: SESSION_NAMES.map(sessionName => {\n    const rows = records.filter(record => record.name === sessionName)\n    if (rows.length !== 1) throw Error('Ambiguous target')\n    return { sessionName, expectedInstanceId: rows[0].id }\n  }),\n})\n// The lifetime starts at the actual external read, never at conversion time.\nawait writeFile(resolve(destinationPath), JSON.stringify(inventory, null, 2) + '\\n', { flag: 'wx' })\nconsole.log(JSON.stringify({ targetCount: inventory.targets.length, observedAt: source.observedAt,\n  expiresAt: new Date(inventory.expiresAt).toISOString(), remoteMutationPerformed: false }))\n"
    },
    {
      "path": ".cache/python-reference-games/prepare-live-promotion-001-r1.mjs",
      "originalBytes": 3876,
      "originalSha256": "e0d92db66d1b8920e130673c9088063391342a14e1178ab2ca7b072e0dcc159c",
      "representation": "exact-utf8",
      "role": "reviewed-helper-source; credentials accessed only at execution, never embedded",
      "contentUtf8": "import { execFile } from 'node:child_process'\nimport { readFile, writeFile } from 'node:fs/promises'\nimport { join } from 'node:path'\nimport { createHash } from 'node:crypto'\n\nconst root = process.cwd()\nconst output = join(root, '.cache/python-reference-games/staging-promotion-input-001-r1.json')\nconst railway = join(process.env.APPDATA, 'npm/node_modules/@railway/cli/bin/railway.exe')\nconst runtimeOrigin = 'https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev'\nconst services = {\n  members: 'aa282801-ffba-477c-af6d-394b2f4f9af9',\n  admin: 'e00eca0b-5323-4424-9b58-fdb073cfce82',\n  community: '9df1b493-4cea-4b36-bec8-7299f054c17d',\n  'community-kids': 'fc8a1b29-ac14-4dc9-a7b3-03d497b8bf4f',\n}\nconst equal = (a, b) => JSON.stringify(a) === JSON.stringify(b)\nasync function readVariables(service) {\n  const text = await new Promise((resolve, reject) => execFile(railway, [\n    'variable', 'list', '--project', '415d5a1c-5f75-432c-8445-b395d0977ce3',\n    '--environment', 'f634cff6-aafb-4804-8b69-172fad4e946e', '--service', service, '--json',\n  ], { timeout: 30_000, maxBuffer: 2_097_152, windowsHide: true, encoding: 'utf8' },\n  (error, stdout) => error ? reject(new Error('Variable read failed')) : resolve(stdout)))\n  return JSON.parse(text)\n}\ntry {\n  const rows = await Promise.all(Object.entries(services).map(async ([name, id]) => [name, await readVariables(id)]))\n  const variables = Object.fromEntries(rows)\n  for (const row of Object.values(variables)) {\n    if (row.STUDIO_AUTHORING_POLICY_JSON !== undefined || row.STUDIO_RUNTIME_HOSTS_JSON !== undefined)\n      throw new Error('Catalog baseline changed')\n  }\n  const record = JSON.parse(await readFile(join(root, '.cache/python-reference-games/platform-001-runtime-withdraw-r11/receipt.json'), 'utf8'))\n  const worker = record.workers.find(row => row.name === 'sistemazero-studio-runtime-staging')\n  if (worker?.version !== 'c31863f5-692a-41e2-8a34-f185089d5ef9' ||\n      worker.publicVars.some(row => row.name === 'STUDIO_PYTHON_DISTRIBUTIONS_SHA256') ||\n      worker.publicVars.find(row => row.name === 'STUDIO_PYTHON_PREVIEW_ORIGIN')?.text !== runtimeOrigin)\n    throw new Error('Runtime baseline mismatch')\n  const plan = JSON.parse(await readFile(join(root, 'docs/superpowers/plans/2026-10-22-python-current-candidate/canonical-plan.json'), 'utf8'))\n  const input = structuredClone(plan.input)\n  input.distribution.directory = 'C:/Users/tocha/projects/sistema-zero/.cache/python-visual-games/dist-r2/distributions/476d32e78da6b528730b8b0535ad026f64fe4e61c03f20a195a7438bc56ace2c'\n  input.baseline.previewOrigin = runtimeOrigin\n  for (const name of ['admin', 'community', 'community-kids']) {\n    const origins = JSON.parse(variables[name].STUDIO_PYTHON_FRAME_ORIGINS)\n    if (!equal(origins, [runtimeOrigin])) throw new Error('Frame origins changed')\n    input.baseline.frameOrigins[name] = origins\n  }\n  await writeFile(output, JSON.stringify(input, null, 2) + '\\n', { flag: 'wx' })\n  const publicReceipt = {\n    kind: 'staging-python-promotion-baseline', observedAt: new Date().toISOString(),\n    sourceCommit: '001ce078891cef0e03d5f9d3926653668e2b6c5f',\n    environment: 'staging', catalogAbsentAcrossApps: true, workerVersion: worker.version,\n    workerReferenceAbsent: true, preservedPreviewOrigin: runtimeOrigin,\n    preservedFrameOrigins: input.baseline.frameOrigins,\n    inputSha256: createHash('sha256').update(await readFile(output)).digest('hex'),\n    configurationChanged: false, secretsRecorded: false,\n  }\n  await writeFile(join(root, '.cache/python-reference-games/staging-promotion-baseline-001-r1.json'), JSON.stringify(publicReceipt, null, 2) + '\\n', { flag: 'wx' })\n  console.log(JSON.stringify(publicReceipt))\n} catch {\n  console.error('Public promotion baseline not prepared; inspect pins and provider access. No remote configuration changed.')\n  process.exitCode = 1\n}\n"
    },
    {
      "path": ".cache/python-reference-games/read-native-promotion-001-r1.ts",
      "originalBytes": 4212,
      "originalSha256": "a144fda9042565c694196dca01d0bcf3d6d61a1d4e256ceeab633bec97ab57c1",
      "representation": "exact-utf8",
      "role": "reviewed-helper-source; credentials accessed only at execution, never embedded",
      "contentUtf8": "import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'\nimport { tmpdir } from 'node:os'\nimport { join, resolve, sep } from 'node:path'\nimport { createHash } from 'node:crypto'\nimport { getPlatformProxy } from 'wrangler'\nimport { verifyPythonPromotionPlan } from '../../packages/studio-runtime/scripts/python-promotion-plan'\n\nconst planSha = '43f7c218d08b00d4a91dd360ffaf53970316d9d3048dd307e59289fc72fd6725'\nconst output = resolve('.cache/python-reference-games/staging-promotion-native-readback-001-r1.json')\nconst receipt: Record<string, unknown> = {\n  kind: 'staging-python-native-r2-readback', state: 'RUNNING',\n  startedAt: new Date().toISOString(), planSha256: planSha,\n  sourceCommit: '001ce078891cef0e03d5f9d3926653668e2b6c5f',\n  objects: [], configurationChanged: false, productionChanged: false,\n}\nlet platform: Awaited<ReturnType<typeof getPlatformProxy>> | undefined\nlet directory: string | undefined\nlet ownedReceipt = false\nlet failure = false\nconst hash = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex')\ntry {\n  const plan = await verifyPythonPromotionPlan(JSON.parse(await readFile('.cache/python-reference-games/staging-promotion-plan-001-r1.json', 'utf8')), planSha)\n  await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n', { flag: 'wx' })\n  ownedReceipt = true\n  directory = await mkdtemp(join(tmpdir(), 'sz-python-native-readback-'))\n  if (!resolve(directory).startsWith(resolve(tmpdir()) + sep + 'sz-python-native-readback-')) throw new Error('Temporary ownership')\n  const configPath = join(directory, 'wrangler.json')\n  await writeFile(configPath, JSON.stringify({ name: 'sistemazero-python-native-readback-staging',\n    account_id: plan.input.target.accountId, compatibility_date: '2026-07-01',\n    r2_buckets: [{ binding: 'PYTHON_RUNTIME', bucket_name: plan.input.target.bucketName, remote: true }],\n  }), { flag: 'wx' })\n  platform = await getPlatformProxy({ configPath, remoteBindings: true, persist: false, envFiles: [] })\n  const bucket = platform.env.PYTHON_RUNTIME as R2Bucket\n  const expected = plan.deployment.distribution.files.map(file => ({ key: plan.prefix + 'files/' + file.path, bytes: file.bytes, sha256: file.sha256 }))\n  expected.push({ key: plan.prefix + 'complete.json', bytes: 0, sha256: plan.markerSha256 })\n  expected.push({ key: plan.workerCatalog.key, bytes: plan.workerCatalog.bytes, sha256: plan.workerCatalog.sha256 })\n  const observed: unknown[] = []\n  for (const entry of expected) {\n    const object = await bucket.get(entry.key)\n    if (!object || !object.checksums.sha256 ||\n      Buffer.from(object.checksums.sha256).toString('hex') !== entry.sha256 ||\n      (entry.bytes !== 0 && object.size !== entry.bytes) || object.size > 24_000_000) throw new Error('Native object metadata')\n    const bytes = new Uint8Array(await object.arrayBuffer())\n    if (bytes.length !== object.size || hash(bytes) !== entry.sha256) throw new Error('Native object bytes')\n    observed.push({ ...entry, bytes: bytes.length, nativeSha256: true, bodySha256: true })\n    receipt.objects = observed\n    await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\n  }\n  receipt.state = 'READBACK_PASSED'\n} catch {\n  failure = true\n  receipt.state = 'FAILED'\n  receipt.failure = 'Readback or proxy operation did not complete; inspect public phase and pins without logging credentials.'\n} finally {\n  try { await platform?.dispose() } catch { failure = true; receipt.proxyCleanupFailed = true }\n  if (directory) {\n    try {\n      if (!resolve(directory).startsWith(resolve(tmpdir()) + sep + 'sz-python-native-readback-')) throw new Error('Cleanup ownership')\n      await rm(directory, { recursive: true, force: true })\n    } catch { failure = true; receipt.temporaryCleanupFailed = true }\n  }\n  receipt.completedAt = new Date().toISOString()\n  receipt.proxyDisposed = platform !== undefined && receipt.proxyCleanupFailed !== true\n  if (failure) receipt.state = 'FAILED'\n  if (ownedReceipt) await writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\n}\nconsole.log(JSON.stringify({ state: receipt.state, objects: (receipt.objects as unknown[]).length, proxyDisposed: receipt.proxyDisposed }))\nif (failure) process.exitCode = 1\n"
    },
