es\": 50\n        }\n      ],\n      \"durable_objects\": {\n        \"bindings\": [\n          {\n            \"class_name\": \"ProBuildSandbox\",\n            \"name\": \"ProBuildSandbox\"\n          },\n          {\n            \"class_name\": \"PythonInspectionJob\",\n            \"name\": \"PythonInspectionJobs\"\n          }\n        ]\n      },\n      \"ratelimits\": [\n        {\n          \"name\": \"PYTHON_UPLOAD_RATE_LIMITER\",\n          \"namespace_id\": \"27004\",\n          \"simple\": {\n            \"limit\": 120,\n            \"period\": 60\n          }\n        },\n        {\n          \"name\": \"BUILD_RATE_LIMITER\",\n          \"namespace_id\": \"27002\",\n          \"simple\": {\n            \"limit\": 10,\n            \"period\": 60\n          }\n        }\n      ]\n    }\n  },\n  \"account_id\": \"bcc0f2d44140e05b69152cba326132f8\"\n}\n"
