/9f3cdeb67749240be65b039846c516e590ebccaae2310fa105a0af8af1cc4ca7.gz\",\"encoding\":\"gzip\",\"path\":\"pyodide.asm.mjs\"},{\"artifactPath\":\"_http/gzip/37634a76b2c64e3f40311b9929c3290187e10253795bf14ab36e51d50fedfd16.gz\",\"encoding\":\"gzip\",\"path\":\"pyodide.mjs\"},{\"artifactPath\":\"_http/gzip/4cd1bbbee07ba2c205681fbf8ab609286bed6d7199f627bfafd8ae5442364eae.gz\",\"encoding\":\"gzip\",\"path\":\"standalone.mjs\"},{\"artifactPath\":\"_http/gzip/86528cc2b1afde5be792cb5d0665bf4921264825f161239ac964c1e90cb83a4f.gz\",\"encoding\":\"gzip\",\"path\":\"turtle-protocol.mjs\"},{\"artifactPath\":\"_http/gzip/79cef1e3f648d539941b0cca5520fb39db91dc5525ea50179b89fd37a3c11bcd.gz\",\"encoding\":\"gzip\",\"path\":\"turtle-renderer.mjs\"},{\"artifactPath\":\"_http/gzip/ebe7381dffd7fd3ce7e5d3ab7f23f05d28f93ed867bc06f066829a29152725ab.gz\",\"encoding\":\"gzip\",\"path\":\"worker.mjs\"}],\"previewHostAudioVersion\":1,\"providedModules\":[{\"browserArtifacts\":[{\"path\":\"worker.mjs\",\"sha256\":\"4f1928678999865c5caa954e9f551f3620d1a987bf05bf75967a187767f8dd10\"},{\"path\":\"frame.mjs\",\"sha256\":\"1fab674d7398af8cc3d586c190f14a93e028b9c57e8c9a22bb87c1db7a9c9b6e\"},{\"path\":\"standalone.mjs\",\"sha256\":\"eaea4c4e9a0d683b7b9f149cd4f049159991a1f5e2333ad529ed8f4c9510a9ad\"},{\"path\":\"playtest.mjs\",\"sha256\":\"4eb2ac1a702c4a9b1b983f9efd29358970e36da2e42f5f18d6045644346e2a59\"}],\"descriptor\":{\"api\":[{\"name\":\"play\",\"signature\":\"(path: str, *, loop: bool = False, volume: float = 1.0) -> int\",\"summary\":\"Começa um WAV sem esperar seu fim e devolve o identificador do som. loop repete; volume vai de 0 a 1.\"},{\"name\":\"stop\",\"signature\":\"(handle: int | None = None) -> None\",\"summary\":\"Para o som indicado por play. Sem argumento, para todos os sons desta execução.\"}],\"audio\":{\"assetsTotalBytes\":33554432,\"channels\":[1,2],\"container\":\"RIFF/WAVE\",\"encoding\":\"PCM16\",\"policy\":{\"commandsPerSecond\":64,\"durationSeconds\":600,\"fileBytes\":33554432,\"maximumSampleRate\":96000,\"minimumSampleRate\":8000,\"requestBytes\":2048,\"version\":1,\"voices\":16,\"wavChunks\":256}},\"browser\":{\"installation\":\"runtime-bundled\",\"lifetime\":\"execution-session\",\"notes\":[\"Disponível somente quando a release aprovada fornece este módulo; não precisa instalar pelo pip no navegador.\",\"Use o caminho relativo de um WAV dos materiais capturados do projeto. Não aceita URL, comando de shell ou arquivo externo.\",\"Clique em Jogar ou Executar para permitir o som. Stop, reinício ou fechamento da execução encerram as vozes.\",\"No navegador, a página e a sessão podem continuar abertas para o REPL depois que o arquivo inicial termina; o áudio acompanha essa sessão.\",\"Um módulo autoral com esse nome mantém a precedência normal do Python; não atribua a ele esta API.\"],\"paths\":\"captured-project-assets\",\"requiresUserGesture\":true},\"descriptorVersion\":1,\"importName\":\"sz_audio\",\"kind\":\"portable-audio\",\"native\":{\"dependencies\":{\"cffi\":\"2.1.1\",\"miniaudio\":\"1.71\",\"pycparser\":\"3.11\",\"setuptools\":\"84.2.0\"},\"distribution\":\"sistema-zero-audio\",\"installation\":\"exported-package\",\"lifetime\":\"process\",\"notes\":[\"Instale o pacote local e suas dependências pelo install.txt indicado no LEIA-ME da exportação, usando o Python do ambiente virtual na pasta principal do projeto.\",\"A instalação separada permite importar sz_audio mesmo quando o arquivo inicial está em uma subpasta; os requisitos e módulos autorais são preservados.\",\"As dependências nativas são separadas do lock do navegador. É necessário um dispositivo de saída disponível; a exportação não certifica a execução neste computador.\",\"play não bloqueia nem mantém o processo Python aberto. Um script curto pode terminar antes de o som tocar; no desktop, mantenha o laço normal do programa, como turtle.done() ou turtle.mainloop(). Encerrar o processo encerra o áudio.\",\"Não instale um pacote chamado turtle pelo pip. Turtle nativo usa a biblioteca padrão e o suporte gráfico Tk do computador.\"],\"requiresPython\":\">=3.14.2,<3.15\"},\"provider\":\"sistema-zero\",\"summary\":\"Som portátil do Sistema Zero. É um módulo separado de Turtle e da biblioteca padrão do Python.\",\"version\":\"1.0.0\"},\"descriptorArtifact\":{\"path\":\"python-modules/sz_audio/1.0.0/descriptor.json\",\"sha256\":\"6b5b150175565bf9360172a88819bef5200149cd8db55c62709d4934f126cf49\"},\"typingArtifact\":{\"path\":\"python-modules/sz_audio/1.0.0/__init__.pyi\",\"sha256\":\"a106c0445d95c7b37424f79c75e3a67969a126322e4ce298654b03b3f48e1a97\"}}],\"pyodideVersion\":\"314.0.7\",\"pythonVersion\":\"3.14.2\",\"version\":1},\"release\":{\"manifest\":{\"artifacts\":[{\"path\":\"LICENSE-pyodide.txt\",\"sha256\":\"1f256ecad192880510e84ad60474eab7589218784b9a50bc7ceee34c2b91f1d5\"},{\"path\":\"LICENSE-python.txt\",\"sha256\":\"b0e25a78cffb43f4d92de8b61ccfa1f1f98ecbc22330b54b5251e7b6ba010231\"},{\"path\":\"LICENSE-tk.txt\",\"sha256\":\"2cde822b93ca16ae535c954b7dfe658b4ad10df2a193628d1b358f1765e8b198\"},{\"path\":\"SOURCES.txt\",\"sha256\":\"1974e400ea27dd7b752c27452cd9cd8e70d8a6cdc5d5d6432fe3abadb6676185\"},{\"path\":\"_http/gzip/00cad5af5add00a7cbda70df5ce5fbb0572c1e5cdc464018a691eceda6fec0ba.gz\",\"sha256\":\"00cad5af5add00a7cbda70df5ce5fbb0572c1e5cdc464018a691eceda6fec0ba\"},{\"path\":\"_http/gzip/165465def5fb0a24e7a7ec131d18142781da1facf0d6b0294311922bce02511b.gz\",\"sha256\":\"165465def5fb0a24e7a7ec131d18142781da1facf0d6b0294311922bce02511b\"},{\"path\":\"_http/gzip/37634a76b2c64e3f40311b9929c3290187e10253795bf14ab36e51d50fedfd16.gz\",\"sha256\":\"37634a76b2c64e3f40311b9929c3290187e10253795bf14ab36e51d50fedfd16\"},{\"path\":\"_http/gzip/3b98f8c12d353655a4862875e8c301eb3e01774b8d67414ad8d6762f63c0e99a.gz\",\"sha256\":\"3b98f8c12d353655a4862875e8c301eb3e01774b8d67414ad8d6762f63c0e99a\"},{\"path\":\"_http/gzip/4cd1bbbee07ba2c205681fbf8ab609286bed6d7199f627bfafd8ae5442364eae.gz\",\"sha256\":\"4cd1bbbee07ba2c205681fbf8ab609286bed6d7199f627b