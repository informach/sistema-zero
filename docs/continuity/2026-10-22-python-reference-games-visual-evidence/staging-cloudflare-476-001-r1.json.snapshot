4b4c5c72e16834\"},{\"path\":\"worker.mjs\",\"sha256\":\"4f1928678999865c5caa954e9f551f3620d1a987bf05bf75967a187767f8dd10\"}],\"capabilities\":[\"edit\",\"execute\",\"pause\",\"publish\",\"export-source\",\"python-repl\",\"assist\"],\"extensions\":[{\"id\":\"python-turtle\",\"versions\":[\"1.0.0\"]}],\"kinds\":[\"classic\",\"pro\"],\"manifestVersion\":1,\"modes\":[\"blocks\",\"bridge\",\"code\"],\"profileId\":\"python-browser\",\"programmingLanguage\":\"python\",\"python\":{\"features\":[\"turtle-compound-shapes\"],\"packages\":[],\"providedModules\":[{\"browserArtifacts\":[{\"path\":\"worker.mjs\",\"sha256\":\"4f1928678999865c5caa954e9f551f3620d1a987bf05bf75967a187767f8dd10\"},{\"path\":\"frame.mjs\",\"sha256\":\"1fab674d7398af8cc3d586c190f14a93e028b9c57e8c9a22bb87c1db7a9c9b6e\"},{\"path\":\"standalone.mjs\",\"sha256\":\"eaea4c4e9a0d683b7b9f149cd4f049159991a1f5e2333ad529ed8f4c9510a9ad\"},{\"path\":\"playtest.mjs\",\"sha256\":\"4eb2ac1a702c4a9b1b983f9efd29358970e36da2e42f5f18d6045644346e2a59\"}],\"descriptor\":{\"api\":[{\"name\":\"play\",\"signature\":\"(path: str, *, loop: bool = False, volume: float = 1.0) -> int\",\"summary\":\"Começa um WAV sem esperar seu fim e devolve o identificador do som. loop repete; volume vai de 0 a 1.\"},{\"name\":\"stop\",\"signature\":\"(handle: int | None = None) -> None\",\"summary\":\"Para o som indicado por play. Sem argumento, para todos os sons desta execução.\"}],\"audio\":{\"assetsTotalBytes\":33554432,\"channels\":[1,2],\"container\":\"RIFF/WAVE\",\"encoding\":\"PCM16\",\"policy\":{\"commandsPerSecond\":64,\"durationSeconds\":600,\"fileBytes\":33554432,\"maximumSampleRate\":96000,\"minimumSampleRate\":8000,\"requestBytes\":2048,\"version\":1,\"voices\":16,\"wavChunks\":256}},\"browser\":{\"installation\":\"runtime-bundled\",\"lifetime\":\"execution-session\",\"notes\":[\"Disponível somente quando a release aprovada fornece este módulo; não precisa instalar pelo pip no navegador.\",\"Use o caminho relativo de um WAV dos materiais capturados do projeto. Não aceita URL, comando de shell ou arquivo externo.\",\"Clique em Jogar ou Executar para permitir o som. Stop, reinício ou fechamento da execução encerram as vozes.\",\"No navegador, a página e a sessão podem continuar abertas para o REPL depois que o arquivo inicial termina; o áudio acompanha essa sessão.\",\"Um módulo autoral com esse nome mantém a precedência normal do Python; não atribua a ele esta API.\"],\"paths\":\"captured-project-assets\",\"requiresUserGesture\":true},\"descriptorVersion\":1,\"importName\":\"sz_audio\",\"kind\":\"portable-audio\",\"native\":{\"dependencies\":{\"cffi\":\"2.1.1\",\"miniaudio\":\"1.71\",\"pycparser\":\"3.11\",\"setuptools\":\"84.2.0\"},\"distribution\":\"sistema-zero-audio\",\"installation\":\"exported-package\",\"lifetime\":\"process\",\"notes\":[\"Instale o pacote local e suas dependências pelo install.txt indicado no LEIA-ME da exportação, usando o Python do ambiente virtual na pasta principal do projeto.\",\"A instalação separada permite importar sz_audio mesmo quando o arquivo inicial está em uma subpasta; os requisitos e módulos autorais são preservados.\",\"As dependências nativas são separadas do lock do navegador. É necessário um dispositivo de saída disponível; a exportação não certifica a execução neste computador.\",\"play não bloqueia nem mantém o processo Python aberto. Um script curto pode terminar antes de o som tocar; no desktop, mantenha o laço normal do programa, como turtle.done() ou turtle.mainloop(). Encerrar o processo encerra o áudio.\",\"Não instale um pacote chamado turtle pelo pip. Turtle nativo usa a biblioteca padrão e o suporte gráfico Tk do computador.\"],\"requiresPython\":\">=3.14.2,<3.15\"},\"provider\":\"sistema-zero\",\"summary\":\"Som portátil do Sistema Zero. É um módulo separado de Turtle e da biblioteca padrão do Python.\",\"version\":\"1.0.0\"},\"descriptorArtifact\":{\"path\":\"python-modules/sz_audio/1.0.0/descriptor.json\",\"sha256\":\"6b5b150175565bf9360172a88819bef5200149cd8db55c62709d4934f126cf49\"},\"typingArtifact\":{\"path\":\"python-modules/sz_audio/1.0.0/__init__.pyi\",\"sha256\":\"a106c0445d95c7b37424f79c75e3a67969a126322e4ce298654b03b3f48e1a97\"}}],\"version\":\"3.14.2\"},\"releaseId\":\"2026-10-22-visual-games-3\",\"requiredBrowserFeatures\":[\"wasm\",\"worker\",\"jspi\",\"trusted-types\"],\"sourceTargets\":[\"browser\",\"desktop\"]},\"manifestSha256\":\"bc5710a137facb82e4f1a24df6e370406217f5fc4707c64861adf381d10d3e80\",\"profileId\":\"python-browser\",\"releaseId\":\"2026-10-22-visual-games-3\"}},\"input\":{\"baseline\":{\"frameOrigins\":{\"admin\":[\"https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev\"],\"community\":[\"https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev\"],\"community-kids\":[\"https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev\"]},\"hosts\":[],\"members\":null,\"previewOrigin\":\"https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev\",\"worker\":null},\"distribution\":{\"directory\":\"C:\\\\Users\\\\tocha\\\\projects\\\\sistema-zero\\\\.cache\\\\python-visual-games\\\\dist-r2\\\\distributions\\\\476d32e78da6b528730b8b0535ad026f64fe4e61c03f20a195a7438bc56ace2c\",\"sha256\":\"476d32e78da6b528730b8b0535ad026f64fe4e61c03f20a195a7438bc56ace2c\"},\"environment\":\"staging\",\"release\":{\"capabilities\":[\"edit\",\"execute\",\"pause\",\"publish\",\"export-source\",\"python-repl\",\"assist\"],\"profileId\":\"python-browser\",\"releaseId\":\"2026-10-22-visual-games-3\"},\"target\":{\"accountId\":\"bcc0f2d44140e05b69152cba326132f8\",\"bucketName\":\"sistemazero-studio-artifacts-staging\",\"parentOrigins\":[\"https://admin-staging-f8fe.up.railway.app\",\"https://community-staging-66f2.up.railway.app\",\"https://community-kids-staging.up.railway.app\"],\"runtimeOrigin\":\"https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev\"},\"version\":1},\"kind\":\"studio.python.runtime-promotion\",\"markerSha256\":\"d2b3c0df8029b873f023a922