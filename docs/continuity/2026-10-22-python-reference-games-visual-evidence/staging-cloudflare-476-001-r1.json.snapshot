      "contentUtf8": "{\n  \"$schema\": \"../../../packages/studio-language-service/node_modules/wrangler/config-schema.json\",\n  \"name\": \"sistemazero-studio-language\",\n  \"main\": \"../../../packages/studio-language-service/src/index.ts\",\n  \"compatibility_date\": \"2026-07-01\",\n  \"compatibility_flags\": [\n    \"nodejs_compat\"\n  ],\n  \"containers\": [\n    {\n      \"class_name\": \"PythonLanguageSandbox\",\n      \"image\": \"../../../packages/studio-language-service/Dockerfile\",\n      \"instance_type\": \"standard-2\",\n      \"max_instances\": 64\n    }\n  ],\n  \"durable_objects\": {\n    \"bindings\": [\n      {\n        \"class_name\": \"PythonLanguageSandbox\",\n        \"name\": \"PythonLanguageSandbox\"\n      },\n      {\n        \"class_name\": \"PythonLanguageSessions\",\n        \"name\": \"PythonLanguageSessions\"\n      }\n    ]\n  },\n  \"migrations\": [\n    {\n      \"new_sqlite_classes\": [\n        \"PythonLanguageSandbox\",\n        \"PythonLanguageOwner\"\n      ],\n      \"tag\": \"v1\"\n    },\n    {\n      \"tag\": \"language-sessions-initial\",\n      \"new_sqlite_classes\": [\n        \"PythonLanguageSessions\"\n      ],\n      \"deleted_classes\": [\n        \"PythonLanguageOwner\"\n      ]\n    }\n  ],\n  \"ratelimits\": [\n    {\n      \"name\": \"LANGUAGE_OPEN_LIMIT\",\n      \"namespace_id\": \"27011\",\n      \"simple\": {\n        \"limit\": 10,\n        \"period\": 60\n      }\n    },\n    {\n      \"name\": \"LANGUAGE_COMMAND_LIMIT\",\n      \"namespace_id\": \"27012\",\n      \"simple\": {\n        \"limit\": 600,\n        \"period\": 60\n      }\n    }\n  ],\n  \"env\": {\n    \"staging\": {\n      \"name\": \"sistemazero-studio-language-staging\",\n      \"containers\": [\n        {\n          \"class_name\": \"PythonLanguageSandbox\",\n          \"image\": \"registry.cloudflare.com/bcc0f2d44140e05b69152cba326132f8/sz-python-language-qa@sha256:b64cb8e24ac10eaeb2e0d298e9e3e7ec809b1aeea7778c145941e65cf0578320\",