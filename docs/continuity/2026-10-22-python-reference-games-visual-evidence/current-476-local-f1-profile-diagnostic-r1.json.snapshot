', 'analysis-worker.mjs', 'blockly-DeuTwL_n.js', 'boot-reader.mjs', 'bootResourceHost-BjXn_C05.js', 'bottomTabs-CPm-6miZ.js', 'catalog-CkJ9C74k.js', 'cn-BrylQflp.js', 'content-fingerprint-CkTVNl1d.js', 'contextEnvironment-CRedaoUK.js', 'contextEnvironmentCore-BW3i7Tov.js', 'controller-9MR2w0dO.js', 'controller-TcYJq0re.js', 'editor-BWimssVN.js', 'editor.api-Bx3n2d9h.js', 'frame.mjs', 'nodes-Zx46qMN1.js', 'observation-BNKLBnWE.js', 'persistence-BaGHiRgY.js', 'portable-path-Ba5y8eRv.js', 'project-capabilities-CcdGUnM-.js', 'project-continuity-Ce0-Whas.js', 'project-document-CeTzE4XL.js', 'projectStore-us9OTWgL.js', 'provider-CaO1-26j.js', 'pyodide.asm.mjs', 'pyodide.mjs', 'python-dependency-policy-CewlrFEd.js', 'python-runtime-distribution-Bak2oazg.js', 'pythonProjectValidation-Dyf7-FZj.js', 'react-B1GEbTQo.js', 'react-BQdL-_wy.js', 'registry-B95c9GR-.js', 'runtime-authorization-BkVwPFH4.js', 'runtime-catalog-CUKkz9MZ.js', 'runtime-identity-DaUVRFrO.js', 'schemas-BnqV3WKm.js', 'schemas-JYSZsLNF.js', 'snapshot-BuaDTBFP.js', 'structuralCodec-qdIpoZBb.js', 'turtle-protocol.mjs', 'turtle-renderer.mjs', 'turtle.py', 'uiStore-FzvNQ3v3.js', 'useFormatIssueLogger-CwTlfkSY.js', 'webFiles-v8DIWlrX.js', 'worker.mjs', 'workers-BLHfgwCz.js']\nCODE_TYPES = ['JS', 'other', 'wasm']\nNETWORK = ['ResourceSendRequest', 'ResourceWillSendRequest', 'ResourceReceiveResponse', 'ResourceReceivedData', 'ResourceFinish']\nMARKS = ['studio-python-execute-click', 'studio-python-first-useful-pixels']\n\nHULL = {'cat','dur','id','name','ph','pid','s','tdur','tid','ts','tts'}\nNETWORK_FIELDS = {\n 'ResourceSendRequest': {'fetchPriorityHint','frame','initiator','isLinkPreload','priority','renderBlocking','requestId','requestMethod','resourceType','url'},\n 'ResourceWillSendRequest': {'requestId'},\n 'ResourceReceiveResponse': {'connectionId','connectionReused','encodedDataLength','frame','fromCache','fromServiceWorker','headers','mimeType','protocol','requestId','responseTime','statusCode','timing'},\n 'ResourceReceivedData': {'encodedDataLength','frame','requestId'},\n 'ResourceFinish': {'decodedBodyLength','didFail','encodedDataLength','finishTime','requestId'},\n}\nTIMING = {'connectEnd','connectStart','dnsEnd','dnsStart','proxyEnd','proxyStart','pushEnd','pushStart','receiveHeadersEnd','receiveHeadersStart','requestTime','sendEnd','sendStart','sslEnd','sslStart','workerReady','workerStart'}\nSENSITIVE_KEY = re.compile(r'(?i)^(metadata|headers|authorization|proxy-authorization|cookie|set-cookie|postData|postDataEntries|requestBody|responseBody|payload|command_line|sessionId|scriptSource|sourceText|innerHTML|outerHTML|textContent|inputValue)$')\nSENSITIVE_VALUE = re.compile(r'(?i)(?:^[A-Z]:[/\\\\]|[/\\\\]Users[/\\\\]|/home/|\\bBearer\\s+[A-Za-z0-9._~+/-]{8,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|\\bgh[pousr]_[A-Za-z0-9]{20,}|\\bgithub_pat_[A-Za-z0-9_]{20,}|\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b|\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b|[\\w.+-]+@[\\w.-]+\\.[a-z]{2,})')\n\ndef require(ok,message):\n if not ok:raise ValueError(message)\n\ndef encode(value):\n return (json.dumps(value,ensure_ascii=False,allow_nan=False,separators=(',',':'))+'\\n').encode('utf-8')\n\ndef sha(value):\n return hashlib.sha256(value).hexdigest()\n\ndef group(event):\n name=event.get('name')\n if name in ['Profile','ProfileChunk']:return 'cpu'\n if name in NETWORK:return 'network'\n if name in MARKS:return 'mark'\n if event.get('ph') in ['X','B','E']:\n  require(name in TIMELINE_NAMES,'Unreviewed timeline name')\n  return 'timeline'\n return None\n\ndef urls(event):\n if event['name']=='ResourceSendRequest':yield event['args']['data']['url']\n if event['name']=='ProfileChunk':\n  for node in event['args']['data']['cpuProfile'].get('nodes',[]):\n   if node['callFrame'].get('url'):yield node['callFrame']['url']\n\ndef resource_label(url):\n parsed=urllib.parse.urlsplit(url)\n require(not parsed.username and not parsed.password,'Userinfo not allowed')\n if parsed.scheme in ['http','https']:\n  require(parsed.hostname in ['localhost','127.0.0.1','::1'],'External URL not reviewed')\n  name=parsed.path.rsplit('/',1)[-1]\n  return ('script',name) if name in SAFE_BASENAMES else ('local-request','resource')\n if parsed.scheme=='wasm':return ('wasm','module.wasm')\n if parsed.scheme=='blob':\n  opaque=bool(re.fullmatch(r'null/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',parsed.path))\n  nested=urllib.parse.urlsplit(parsed.path)\n  require(opaque or nested.hostname in ['localhost','127.0.0.1','::1'],'Unreviewed blob origin')\n  return ('blob','resource')\n require(parsed.scheme=='about' and parsed.path=='blank','Unreviewed URL form')\n return ('blank','resource')\n\ndef url_map(selected):\n mapping={};descriptors=[]\n for event in selected:\n  for original in urls(event):\n   if original in mapping:continue\n   kind,name=resource_label(original)\n   replacement='https://trace.invalid/resource/%04d/%s'%(len(mapping)+1,name)\n   mapping[original]=replacement\n   descriptors.append({'url':replacement,'resourceClass':kind,'approvedBasename':name})\n require(len(mapping)==len(set(mapping.values())),'Pseudonym collision')\n return mapping,descriptors\n\ndef validate_cpu(data,name):\n require(data.get('source')=='Internal','Unreviewed CPU source')\n if name=='Profile':\n  require(set(data)=={'source','startTime'} and type(data['startTime']) is int,'Profile schema changed')\n  return\n require(set(data)<={'columns','cpuProfile','lines','source','timeDeltas'},'ProfileChunk schema changed')\n profile=data['cpuProfile']\n require(set(profile)<={'nodes','samples','trace_ids'},'CPU profile schema changed')\n require(all(type(x) is int for x in profile['samples']+data['timeDeltas']),'Samples/deltas changed type')\n require(len(profile['samples'])==len(data['timeDeltas']),'Sample/delta count differs')\n for field in ['lines','columns']:\n  if field in data:require(all(type(x) is int for x in data[field]),'CPU positions changed type')\n for key,value in profile.get('trace_ids',{}).items():\n  require(key.isdigit() and type(value) is int,'CPU correlation schema changed')\n for node in profile.get('nodes',[]):\n  require(set(node)<={'callFrame','id','parent'} and type(node['id']) is int,'CPU node schema changed')\n  require('parent' not in node or type(node['parent']) is int,'CPU parent changed type')\n  frame=node['callFrame']\n  require(set(frame)<={'codeType','functionName','scriptId','columnNumber','lineNumber','url'},'CallFrame schema changed')\n  require(frame['codeType'] in CODE_TYPES and isinstance(frame['functionName'],str) and type(frame['scriptId']) is int,'CPU symbol changed type')\n  for field in ['lineNumber','columnNumber']:\n   if field in frame:require(type(frame[field]) is int,'CPU position changed type')\n\ndef project(event,mapping):\n category=group(event)\n require(category is not None,'Unselected event')\n require(set(event)<=HULL|{'args'} and event['cat'] in CATEGORIES,'Event envelope changed')\n result={key:copy.deepcopy(value) for key,value in event.items() if key!='args'}\n for key in ['pid','tid','ts','tts','dur','tdur']:\n  if key in result:require(type(result[key]) in [int,float],'Timing identity changed type')\n if category=='timeline':\n  result['args']={}\n  return result\n require(set(event.get('args',{}))=={'data'},'Event args changed')\n data=copy.deepcopy(event['args']['data'])\n if category=='cpu':\n  validate_cpu(data,event['name'])\n  for node in data.get('cpuProfile',{}).get('nodes',[]):\n   frame=node['callFrame']\n   if frame.get('url'):frame['url']=mapping[frame['url']]\n elif category=='network':\n  require(set(data)<=NETWORK_FIELDS[event['name']],'Network data schema changed')\n  data.pop('headers',None);data.pop('initiator',None)\n  if 'url' in data:data['url']=mapping[data['url']]\n  if 'timing' in data:\n   require(set(data['timing'])<=TIMING and all(type(v) in [int,float] for v in data['timing'].values()),'Network timing schema changed')\n  for key,value in data.items():\n   if key not in ['url','timing']:\n    require(type(value) in [int,float,bool,str],'Network payload changed')\n    if isinstance(value,str):require(bool(re.fullmatch(r'[A-Za-z0-9_./+;-]*',value)),'Unreviewed network string')\n else:\n  require(set(data)=={'callTime','navigationId','sampleTraceId','startTime'},'Mark schema changed')\n  require(bool(re.fullmatch(r'[a-fA-F0-9]{32}',data['navigationId'])),'Navigation identity changed')\n result['args']={'data':data}\n return result\n\ndef leaves(value,path=()):\n if isinstance(value,dict):\n  for key,child in value.items():yield from leaves(child,path+(key,))\n elif isinstance(value,list):\n  for index,child in enumerate(value):yield from leaves(child,path+(index,))\n else:yield path,value\n\ndef privacy(document,mapping):\n require(set(document)=={'traceEvents'},'Global metadata is forbidden')\n allowed=set(mapping.values());url_count=0\n for path,value in leaves(document):\n  require(not any(isinstance(key,str) and SENSITIVE_KEY.fullmatch(key) for key in path),'Forbidden field')\n  if not isinstance(value,str):continue\n  require(not SENSITIVE_VALUE.search(value),'Potential personal or credential data')\n  require('\\n' not in value and '\\r' not in value,'Multiline content forbidden')\n  if path and path[-1]=='url':\n   require(value=='' or value in allowed,'Unmapped URL')\n   if value:\n    parsed=urllib.parse.urlsplit(value)\n    require(parsed.hostname=='trace.invalid' and not parsed.query and not parsed.fragment and not parsed.username and not parsed.password,'Unsafe pseudonym')\n    url_count+=1\n  elif '://' in value:raise ValueError('URL outside allowlisted field')\n for event in document['traceEvents']:require(event['ph']!='M','Metadata events forbidden')\n return {'forbiddenFields':0,'sensitiveValuePatternMatches':0,'originalUrls':0,'queryOrFragmentUrls':0,'metadataEvents':0,'pseudonymUrlOccurrences':url_count}\n\ndef original_projection(event):\n # Independent equivalence projection: only declared field omissions.\n result=copy.deepcopy(event)\n if group(event)=='timeline':result['args']={}\n if group(event)=='network':\n  result['args']['data'].pop('headers',None)\n  result['args']['data'].pop('initiator',None)\n return result\n\ndef restore_urls(event,reverse):\n result=copy.deepcopy(event)\n if result['name']=='ResourceSendRequest':result['args']['data']['url']=reverse[result['args']['data']['url']]\n if result['name']=='ProfileChunk':\n  for node in result['args']['data']['cpuProfile'].get('nodes',[]):\n   frame=node['callFrame']\n   if frame.get('url'):frame['url']=reverse[frame['url']]\n return result\n\ndef verify(original,derived,mapping):\n selected=[e for e in original['traceEvents'] if group(e)]\n require(len(selected)==len(derived['traceEvents']),'Selected count differs')\n reverse={v:k for k,v in mapping.items()}\n require(len(reverse)==len(mapping),'URL map is not injective')\n expected_numbers=[];actual_numbers=[]\n for index,(before,after) in enumerate(zip(selected,derived['traceEvents'])):\n  expected=original_projection(before)\n  require(expected==restore_urls(after,reverse),'Ordered retained projection differs')\n  for path,value in leaves(expected):\n   if type(value) in [int,float,bool]:expected_numbers.append([index,list(path),type(value).__name__,value])\n  for path,value in leaves(after):\n   if type(value) in [int,float,bool]:actual_numbers.append([index,list(path),type(value).__name__,value])\n expected_numbers.sort(key=lambda row:(row[0],json.dumps(row[1])))\n actual_numbers.sort(key=lambda row:(row[0],json.dumps(row[1])))\n require(expected_numbers==actual_numbers,'Numeric values or positions differ')\n return {'orderedSelectedEventProjectionEqual':True,'numericProjectionEqual':True,'numericLeafCount':len(actual_numbers),'numericProjectionSha256':sha(encode(actual_numbers)),'urlMapInjective':True,'distinctPseudonymCount':len(mapping),'privacy':privacy(derived,mapping)}\n\ndef measurements(document,case):\n events=document['traceEvents'];marks={name:[e for e in events if e['name']==name] for name in MARKS}\n require(all(len(items)==1 for items in marks.values()),'Expected exactly one of each mark')\n start=marks[MARKS[0]][0]['ts'];end=marks[MARKS[1]][0]['ts']\n roles={'classic':{'host':[24452,28588],'frame':[28148,13012],'executionWorker':[28148,23036]},'pro':{'host':[3336,15872],'frame':[8252,26996],'executionWorker':[8252,20708]}}[case]\n candidates=[e for e in events if e['name']=='MessagePort::Accept' and [e['pid'],e['tid']]==roles['executionWorker'] and start<=e['ts']<=end and 'dur' in e]\n longest=max(candidates,key=lambda e:e['dur'])\n intervals=sorted((max(start,e['ts']),min(end,e['ts']+e['dur'])) for e in events if e['ph']=='X' and [e['pid'],e['tid']]==roles['host'] and e['ts']<end and e['ts']+e['dur']>start)\n total=0;left=right=None\n for a,b in intervals:\n  if left is None:left,right=a,b\n  elif a<=right:right=max(right,b)\n  else:total+=right-left;left,right=a,b\n if left is not None:total+=right-left\n return {'rolesPidTid':roles,'executeMarkTsUs':start,'firstUsefulPixelsMarkTsUs':end,'markIntervalUs':end-start,'hostCompleteEventUnionWithinMarksUs':total,'longestExecutionWorkerMessagePortWithinMarks':{k:longest[k] for k in ['pid','tid','ts','dur','tts','tdur'] if k in longest}}\n\ndef deterministic_gzip(body):\n buffer=io.BytesIO()\n with gzip.GzipFile(fileobj=buffer,mode='wb',filename='',mtime=0,compresslevel=9) as stream:stream.write(body)\n return buffer.getvalue()\n\ndef counts(document):\n events=document['traceEvents'];chunks=[e for e in events if e['name']=='ProfileChunk']\n return {'events':len(events),'groups':dict(collections.Counter(group(e) for e in events)),'phases':dict(collections.Counter(e['ph'] for e in events)),'profiles':sum(e['name']=='Profile' for e in events),'profileChunks':len(chunks),'nodes':sum(len(e['args']['data']['cpuProfile'].get('nodes',[])) for e in chunks),'samples':sum(len(e['args']['data']['cpuProfile']['samples']) for e in chunks),'timeDeltas':sum(len(e['args']['data']['timeDeltas']) for e in chunks),'networkEvents':{n:sum(e['name']==n for e in events) for n in NETWORK},'marks':{n:sum(e['name']==n for e in events) for n in MARKS}}\n\ndef extract(raw,case):\n require(case in EXPECTED and sha(raw)==EXPECTED[case],'Original identity mismatch')\n original=json.loads(raw)\n require(set(original)=={'traceEvents','metadata'},'Original top-level schema changed')\n selected=[e for e in original['traceEvents'] if group(e)]\n mapping,resources=url_map(selected)\n derived={'traceEvents':[project(e,mapping) for e in selected]}\n validation=verify(original,derived,mapping)\n before=measurements(original,case);after=measurements(derived,case)\n require(before==after,'Measurements changed')\n body=encode(derived);packed=deterministic_gzip(body)\n require(gzip.decompress(packed)==body and packed==deterministic_gzip(body),'Gzip roundtrip/determinism failed')\n controls={}\n for label in ['cpuSample','networkTiming','markTimestamp','metadataInjection','headerInjection']:\n  changed=copy.deepcopy(derived)\n  if label=='cpuSample':\n   event=next(e for e in changed['traceEvents'] if e['name']=='ProfileChunk' and e['args']['data']['cpuProfile']['samples'])\n   event['args']['data']['cpuProfile']['samples'][0]=-999\n  elif label=='networkTiming':\n   event=next(e for e in changed['traceEvents'] if e['name']=='ResourceReceiveResponse' and 'timing' in e['args']['data'])\n   event['args']['data']['timing']['receiveHeadersEnd']=-999\n  elif label=='markTimestamp':\n   next(e for e in changed['traceEvents'] if e['name']==MARKS[0])['ts']=-999\n  elif label=='metadataInjection':changed['metadata']={'command_line':'redacted-test'}\n  else:\n   next(e for e in changed['traceEvents'] if e['name']=='ResourceReceiveResponse')['args']['data']['headers']=[]\n  try:verify(original,changed,mapping)\n  except (ValueError,KeyError):controls[label]=True\n  else:raise ValueError('Negative control escaped')\n validation.update({'causalNegativeControlsRejected':controls,'measurementsEqual':True,'gzipRoundtripExact':True,'gzipDeterministic':True,'rawSha256MatchesExpected':True})\n return {'body':body,'gzip':packed,'summary':{'originalSha256':sha(raw),'originalBytes':len(raw),'jsonSha256':sha(body),'jsonBytes':len(body),'gzipSha256':sha(packed),'gzipBytes':len(packed),'originalEventCount':len(original['traceEvents']),'retained':counts(derived),'discardedEventCount':len(original['traceEvents'])-len(selected),'discardedPhaseCounts':dict(collections.Counter(e['ph'] for e in original['traceEvents'] if not group(e))),'validation':validation,'measurements':after,'resources':resources}}\n\ndef main():\n require(len(sys.argv)==4,'Usage: extractor.py classic|pro ORIGINAL.json OUTPUT.json.gz')\n case,input_path,output_path=sys.argv[1:]\n result=extract(pathlib.Path(input_path).read_bytes(),case);output=pathlib.Path(output_path)\n if output.exists():require(output.read_bytes()==result['gzip'],'Refusing to overwrite different bytes')\n else:\n  with output.open('xb') as stream:stream.write(result['gzip'])\n print(json.dumps(result['summary'],ensure_ascii=False,allow_nan=False))\n\nif __name__=='__main__':main()\n",
