t.workers.flatMap((worker) =>\n    worker.versions?.flatMap((version) => version.durableObjects.map((item) => item.namespace_id)) ?? []))\n  receipt.namespaceInventoryComplete = namespaces.complete\n  receipt.namespaces = namespaces.values.filter((value) =>\n    boundIds.has(value.id) || workerNames.includes(value.script))\n    .map((value) => pick(value, ['id', 'name', 'script', 'class', 'class_name', 'use_sqlite', 'environment']))\n  const applications = await get('/containers/applications')\n  if (applications) {\n    const allApps = Array.isArray(applications.result) ? applications.result : applications.result?.applications\n    assert(Array.isArray(allApps), 'unexpected-app-list-shape')\n    const ownApps = allApps.filter((app) => boundIds.has(app.durable_objects?.namespace_id) ||\n      workerNames.some((worker) => app.name?.startsWith(worker + '-') && !app.name?.includes('-staging')))\n    for (const listed of ownApps) {\n      assert(/^[a-f0-9-]{36}$/.test(listed.id))\n      const response = await get('/containers/applications/' + listed.id)\n      if (!response) continue\n      const app = response.result\n      const projected = {\n        id: app.id, name: app.name,\n        namespaceId: app.durable_objects?.namespace_id,\n        association: boundIds.has(app.durable_objects?.namespace_id) ? 'active-binding' : 'production-name-only',\n        version: app.version, createdAt: app.created_at, updatedAt: app.updated_at,\n        configuration: pick(app.configuration, ['image', 'instance_type', 'vcpu', 'memory_mib', 'disk_mb']),\n        constraints: pick(app.constraints, ['max_instances', 'max_concurrency']),\n        health: pick(app.health, ['active', 'assigned', 'scheduling', 'starting', 'stopping', 'stopped', 'failed']),\n        instances: [], durableObjects: [], instanceInventoryComplete: false, pages: 0,\n      }\n      receipt.applications.push(projected)\n      let next\n      for (let page = 0; page < 20; page++) {\n        const path = '/containers/dash/applications/' + app.id + '/instances?per_page=100' +\n          (next ? '&page_token=' + encodeURIComponent(next) : '')\n        const result = await get(path)\n        if (!result) break\n        const payload = result.result\n        assert(Array.isArray(payload.instances))\n        projected.instances.push(...payload.instances.map(projectInstance))\n        projected.durableObjects.push(...(payload.durable_objects ?? []).map((item) =>\n          pick(item, ['id', 'name', 'deployment_id', 'assigned_at'])))\n        projected.pages++\n        next = result.result_info?.next_page_token\n        if (!next) { projected.instanceInventoryComplete = true; break }\n      }\n      if (!projected.instanceInventoryComplete) receipt.issues.push({ app: app.id, code: 'instance-inventory-incomplete' })\n      await checkpoint()\n    }\n  }\n  const bucket = await get('/r2/buckets/' + bucketName)\n  if (bucket) {\n    assert.equal(bucket.result.name, bucketName)\n    receipt.bucket = {\n      ...pick(bucket.result, ['name', 'creation_date', 'location', 'storage_class', 'jurisdiction']),\n      lifecycle: null, managedDomain: null, customDomains: [],\n    }\n    const lifecycle = await get('/r2/buckets/' + bucketName + '/lifecycle')\n    if (lifecycle) receipt.bucket.lifecycle = {\n      rules: (lifecycle.result.rules ?? []).map((rule) => pick(rule, [\n        'id', 'enabled', 'conditions', 'deleteObjectsTransition', 'abortMultipartUploadsTransition',\n        'storageClassTransitions',\n      ])),\n    }\n    const managed = await get('/r2/buckets/' + bucketName + '/domains/managed')\n    if (managed) receipt.bucket.managedDomain = pick(managed.result, ['domain', 'enabled'])\n    const custom = await get('/r2/buckets/' + bucketName + '/domains/custom')\n    if (custom) receipt.bucket.customDomains = (custom.result.domains ?? []).map((domain) =>\n      pick(domain, ['domain', 'enabled', 'status', 'zoneId', 'zoneName']))\n  }\n  receipt.completedAt = new Date().toISOString