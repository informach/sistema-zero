N.stringify(receipt, null, 2) + '\\n', { flag: 'wx' })\nconst checkpoint = () => writeFile(output, JSON.stringify(receipt, null, 2) + '\\n')\nlet token\nasync function get(path) {\n  assert(path.startsWith('/containers/') && !path.includes('://'))\n  const response = await fetch('https://api.cloudflare.com/client/v4/accounts/' + accountId + path, {\n    method: 'GET', headers: { Authorization: 'Bearer ' + token },\n    redirect: 'error', signal: AbortSignal.timeout(30_000),\n  })\n  const entry = { path: path.replace(/([?&]page_token=)[^&]*/g, '$1[omitted]'),\n    observedAt: new Date().toISOString(), status: response.status, success: false }\n  receipt.requests.push(entry)\n  assert(Number(response.headers.get('content-length')) <= 16_000_000)\n  const reader = response.body.getReader()\n  const chunks = []\n  let size = 0\n  try {\n    while (true) {\n      const part = await reader.read()\n      if (part.done) break\n      size += part.value.byteLength\n      assert(size <= 16_000_000)\n      chunks.push(part.value)\n    }\n  } finally {\n    await reader.cancel().catch(() => {})\n    reader.releaseLock()\n  }\n  const body = JSON.parse(Buffer.concat(chunks).toString('utf8'))\n  entry.success = response.ok && body.success === true\n  entry.responseBytes = size\n  await checkpoint()\n  assert(entry.success)\n  return body\n}\nfunction publicInstance(instance) {\n  const fields = ['id', 'application_id', 'app_version', 'version', 'created_at', 'updated_at', 'location']\n  const result = Object.fromEntries(fields.flatMap((key) => instance[key] === undefined ? [] : [[key, instance[key]]]))\n  const status = instance.current_placement?.status ?? instance.status\n  result.status = typeof status === 'string' ? status : Object.fromEntries(\n    ['health', 'container_status', 'durable_object_status', 'status']\n      .flatMap((key) => status?.[key] === undefined ? [] : [[key, status[key]]]))\n  return result\n}\ntry {\n  let authText = execFileSync(process.execPath, [cli,