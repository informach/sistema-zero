pageSize = 100) {\n  const values = []\n  for (let page = 1; page <= 20; page++) {\n    const data = await get(path + (path.includes('?') ? '&' : '?') + 'per_page=' + pageSize + '&page=' + page)\n    if (!data) return { values, complete: false, pages: page }\n    assert(Array.isArray(data.result))\n    values.push(...data.result)\n    const info = data.result_info\n    if ((Number.isInteger(info?.total_pages) && page >= info.total_pages) || data.result.length < pageSize)\n      return { values, complete: true, pages: page }\n  }\n  receipt.issues.push({ path, code: 'pagination-cap' })\n  return { values, complete: false, pages: 20 }\n}\nfunction projectStatus(status) {\n  if (typeof status === 'string') return status\n  return pick(status, ['health', 'container_status', 'durable_object_status', 'status'])\n}\nfunction projectInstance(instance) {\n  return {\n    ...pick(instance, ['id', 'application_id', 'app_version', 'version', 'created_at', 'updated_at', 'location']),\n    status: projectStatus(instance.status),\n    currentPlacement: instance.current_placement ? {\n      ...pick(instance.current_placement, ['id', 'location', 'created_at', 'updated_at']),\n      status: projectStatus(instance.current_placement.status),\n    } : null,\n  }\n}\ntry {\n  assert.equal(process.versions.node, '24.22.0')\n  const wrangler = JSON.parse(await readFile(join(root, 'packages/studio-runtime/node_modules/wrangler/package.json'), 'utf8'))\n  assert.equal(wrangler.version, '4.120.1')\n  receipt.toolchain.wrangler = wrangler.version\n  receipt.toolchain.cliSha256 = sha(await readFile(cli))\n  for (const packageName of ['studio-runtime', 'studio-language-service']) {\n    const path = join(root, 'packages', packageName, 'wrangler.jsonc')\n    const bytes = await readFile(path)\n    const config = JSON.parse(bytes.toString('utf8'))\n    assert(workerNames.includes(config.name))\n    const bindings = Object.entries(config.vars ?? {}).map(([name, text]) => ({ name, text, type: 'plain