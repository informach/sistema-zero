stances.push(...data.result.instances.map(publicInstance))\n      projected.historicalDurableObjects.push(...data.result.durable_objects.map((item) => {\n        assert(typeof item.id === 'string' && typeof item.name === 'string')\n        return { id: item.id, name: item.name, assignedAt: item.assigned_at }\n      }))\n      projected.pages++\n      next = data.result_info?.next_page_token\n      if (!next) { projected.instanceInventoryComplete = true; break }\n    }\n    assert(projected.instanceInventoryComplete)\n    await checkpoint()\n  }\n  receipt.status = 'READ_COMPLETE'\n  receipt.completedAt = new Date().toISOString()\n  await checkpoint()\n  process.stdout.write(JSON.stringify({ path: output, sha256: sha(await readFile(output)),\n    status: receipt.status, applications: receipt.applications.map((app) => ({\n      name: app.name, id: app.id, health: app.health, physicalInstances: app.instances.length,\n      historicalDurableObjects: app.historicalDurableObjects.length, complete: app.instanceInventoryComplete,\n    })) }, null, 2) + '\\n')\n} catch {\n  receipt.status = 'READ_FAILED'\n  receipt.completedAt = new Date().toISOString()\n  receipt.issues.push({ code: 'sanitized-read-failure' })\n  await checkpoint()\n  process.stderr.write('Health supplement failed; inspect only the sanitized receipt.\\n')\n  process.exitCode = 1\n} finally {\n  token = undefined\n}\n"
