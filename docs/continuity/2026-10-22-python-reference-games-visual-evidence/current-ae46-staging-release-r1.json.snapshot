"fd\",\n      signature: \"(distance)\",\n      canonical: \"forward\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"fillcolor\",\n      signature: \"(*args)\",\n      canonical: \"fillcolor\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"filling\",\n      signature: \"()\",\n      canonical: \"filling\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"forward\",\n      signature: \"(distance)\",\n      canonical: \"forward\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"getscreen\",\n      signature: \"()\",\n      canonical: \"getscreen\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"goto\",\n      signature: \"(x, y=None)\",\n      canonical: \"goto\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"heading\",\n      signature: \"()\",\n      canonical: \"heading\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"hideturtle\",\n      signature: \"()\",\n      canonical: \"hideturtle\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"home\",\n      signature: \"()\",\n      canonical: \"home\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"ht\",\n      signature: \"()\",\n      canonical: \"hideturtle\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"isdown\",\n      signature: \"()\",\n      canonical: \"isdown\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"isvisible\",\n      signature: \"()\",\n      canonical: \"isvisible\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"left\",\n      signature: \"(angle)\",\n      canonical: \"left\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"lt\",\n      signature: \"(angle)\",\n      canonical: \"left\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"onclick\",\n      signature: \"(fun, btn=1, add=None)\",\n      canonical: \"onclick\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"ondrag\",\n      signature: \"(fun, btn=1, add=None)\",\n      canonical: \"ondrag\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"onrelease\",\n      signature: \"(fun, btn=1, add=None)\",\n      canonical: \"onrelease\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"pd\",\n      signature: \"()\",\n      canonical: \"pendown\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"pencolor\",\n      signature: \"(*args)\",\n      canonical: \"pencolor\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"pendown\",\n      signature: \"()\",\n      canonical: \"pendown\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"pensize\",\n      signature: \"(width=None)\",\n      canonical: \"pensize\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"penup\",\n      signature: \"()\",\n      canonical: \"penup\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"pos\",\n      signature: \"()\",\n      canonical: \"pos\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"position\",\n      signature: \"()\",\n      canonical: \"pos\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"pu\",\n      signature: \"()\",\n      canonical: \"penup\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"right\",\n      signature: \"(angle)\",\n      canonical: \"right\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"reset\",\n      signature: \"()\",\n      canonical: \"reset\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"rt\",\n      signature: \"(angle)\",\n      canonical: \"right\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"seth\",\n      signature: \"(to_angle)\",\n      canonical: \"setheading\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"setheading\",\n      signature: \"(to_angle)\",\n      canonical: \"setheading\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"setpos\",\n      signature: \"(x, y=None)\",\n      canonical: \"goto\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"setposition\",\n      signature: \"(x, y=None)\",\n      canonical: \"goto\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"setx\",\n      signature: \"(x)\",\n      canonical: \"setx\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"sety\",\n      signature: \"(y)\",\n      canonical: \"sety\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"shape\",\n      signature: \"(name=None)\",\n      canonical: \"shape\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"shapesize\",\n      signature: \"(stretch_wid=None, stretch_len=None, outline=None)\",\n      canonical: \"shapesize\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"showturtle\",\n      signature: \"()\",\n      canonical: \"showturtle\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"speed\",\n      signature: \"(speed=None)\",\n      canonical: \"speed\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"st\",\n      signature: \"()\",\n      canonical: \"showturtle\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"stamp\",\n      signature: \"()\",\n      canonical: \"stamp\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"towards\",\n      signature: \"(x, y=None)\",\n      canonical: \"towards\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"turtlesize\",\n      signature: \"(stretch_wid=None, stretch_len=None, outline=None)\",\n      canonical: \"shapesize\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"up\",\n      signature: \"()\",\n      canonical: \"penup\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"width\",\n      signature: \"(width=None)\",\n      canonical: \"pensize\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"write\",\n      signature: \"(arg, move=False, align='left', font=('Arial', 8, 'normal'))\",\n      canonical: \"write\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"xcor\",\n      signature: \"()\",\n      canonical: \"xcor\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"ycor\",\n      signature: \"()\",\n      canonical: \"ycor\",\n      receiver: \"Turtle\",\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"Screen\",\n      signature: \"()\",\n      canonical: \"Screen\",\n      receiver: null,\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"Turtle\",\n      signature: \"(shape='classic', undobuffersize=1000, visible=True)\",\n      canonical: \"Turtle\",\n      receiver: null,\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"Shape\",\n      signature: \"(type_, data=None)\",\n      canonical: \"Shape\",\n      receiver: null,\n      fixtureFamily: null\n    },\n    {\n      owner: \"turtle\",\n      name: \"done\",\n      signature: \"()\",\n      canonical: \"mainloop\",\n      receiver: \"Screen\",\n      fixtureFamily: null\n    }\n  ]\n};\n\n// packages/studio/src/python/extensions/turtle/labels.ts\nvar n = (value2) => integer2(String(value2));\nvar callback = () => name(\"ao_evento\");\nvar pair = (x, y) => node(\"Tuple\", { elts: [n(x), n(y)], ctx: node(\"Load\") });\nvar label = (title, category, level, help, args = []) => ({ title, category, level, help, args });\nvar common3 = {\n  Shape: label(\"criar forma composta\", \"Aparência e imagens\", 3, \"Cria uma forma feita de partes coloridas. Guarde em uma variável, adicione partes e registre a forma na tela.\", [text2(\"compound\")]),\n  addcomponent: label(\"adicionar parte à forma\", \"Aparência e imagens\", 3, \"Adiciona um polígono com cor de preenchimento e contorno à forma composta. Os pontos são pares de coordenadas Python.\", [\n    node(\"Tuple\", { elts: [pair(0, 10), pair(10, 0), pair(0, -10)], ctx: node(\"Load\") }),\n    text2(\"red\"),\n    text2(\"black\")\n  ]),\n  Turtle: label(\"criar tartaruga\", \"Tartarugas\", 1, \"Cria uma tartaruga. Guarde o resultado em uma variável para controlar essa tartaruga.\"),\n  Screen: label(\"abrir tela\", \"Tela\", 1, \"Obtém a tela compartilhada pelas tartarugas. Guarde o resultado para configurar a tela.\"),\n  clone: label(\"copiar tartaruga\", \"Tartarugas\", 2, \"Cria outra tartaruga com a mesma posição, aparência e estado da caneta.\"),\n  getscreen: label(\"tela da tartaruga\", \"Tartarugas\", 2, \"Devolve a tela à qual esta tartaruga pertence.\"),\n  forward: label(\"avançar\", \"Movimento\", 1, \"Anda na direção atual pela distância escolhida.\", [\n    n(100)\n  ]),\n  back: label(\"recuar\", \"Movimento\", 1, \"Anda para trás sem mudar a direção para a qual aponta.\", [\n    n(100)\n  ]),\n  left: label(\"virar à esquerda\", \"Movimento\", 1, \"Gira para a esquerda pelo ângulo em graus.\", [\n    n(90)\n  ]),\n  right: label(\"virar à direita\", \"Movimento\", 1, \"Gira para a direita pelo ângulo em graus.\", [\n    n(90)\n  ]),\n  goto: label(\"ir para posição\", \"Movimento\", 1, \"Vai até x e y sem mudar a direção. Também aceita um par de coordenadas.\", [n(0), n(0)]),\n  setx: label(\"mudar posição x\", \"Movimento\", 1, \"Muda só a coordenada horizontal.\", [n(100)]),\n  sety: label(\"mudar posição y\", \"Movimento\", 1, \"Muda só a coordenada vertical.\", [n(100)]),\n  home: label(\"voltar ao centro\", \"Movimento\", 1, \"Volta à posição inicial e aponta para a direção inicial.\"),\n  setheading: label(\"apontar na direção\", \"Movimento\", 1, \"Define a direção em graus. Na configuração normal, zero aponta para a direita.\", [n(90)]),\n  pos: label(\"posição atual\", \"Movimento\", 1, \"Devolve o par de coordenadas x e y da tartaruga.\"),\n  xcor: label(\"posição x\", \"Movimento\", 1, \"Devolve a coordenada horizontal atual.\"),\n  ycor: label(\"posição y\", \"Movimento\", 1, \"Devolve a coordenada vertical atual.\"),\n  heading: label(\"direção atual\", \"Movimento\", 1, \"Devolve a direção para a qual a tartaruga aponta.\"),\n  distance: label(\"distância até\", \"Movimento\", 2, \"Calcula a distância até uma posição ou outra tartaruga.\", [n(0), n(0)]),\n  towards: label(\"direção até\", \"Movimento\", 2, \"Calcula o ângulo que aponta para uma posição ou outra tartaruga.\", [n(0), n(0)]),\n  penup: label(\"levantar caneta\", \"Caneta e desenho\", 1, \"Permite mover a tartaruga sem desenhar uma linha.\"),\n  pendown: label(\"abaixar caneta\", \"Caneta e desenho\", 1, \"Faz os próximos movimentos desenharem uma linha.\"),\n  isdown: label(\"caneta está abaixada\", \"Caneta e desenho\", 2, \"Devolve verdadeiro se os movimentos estiverem desenhando.\"),\n  pensize: label(\"espessura da caneta\", \"Caneta e desenho\", 1, \"Com um número define a espessura. Sem argumentos devolve a espessura atual.\", [n(3)]),\n  pencolor: label(\"cor da caneta\", \"Caneta e desenho\", 1, \"Define a cor das linhas. Sem argumentos devolve a cor atual.\", [text2(\"blue\")]),\n  fillcolor: label(\"cor do preenchimento\", \"Caneta e desenho\", 1, \"Define a cor usada para preencher formas. Sem argumentos consulta a cor.\", [text2(\"gold\")]),\n  color: label(\"cores da tartaruga\", \"Caneta e desenho\", 1, \"Define as cores da caneta e do preenchimento. Sem argumentos devolve as duas cores.\", [text2(\"blue\"), text2(\"gold\")]),\n  circle: label(\"desenhar círculo ou arco\", \"Caneta e desenho\", 1, \"Desenha um círculo pelo raio. Pode receber também o ângulo do arco e o número de lados.\", [n(50)]),\n  dot: label(\"desenhar ponto\", \"Caneta e desenho\", 1, \"Desenha um ponto redondo na posição atual, com tamanho e cor opcionais.\", [n(10), text2(\"red\")]),\n  begin_fill: label(\"começar preenchimento\", \"Caneta e desenho\", 1, \"Marca o início do contorno que será preenchido por end_fill.\"),\n  end_fill: label(\"terminar preenchimento\", \"Caneta e desenho\", 1, \"Fecha e preenche a forma iniciada por begin_fill.\"),\n  filling: label(\"está preenchendo\", \"Caneta e desenho\", 2, \"Devolve verdadeiro entre begin_fill e end_fill.\"),\n  write: label(\"escrever no desenho\", \"Caneta e desenho\", 1, \"Escreve na posição atual. Aceita alinhamento, fonte e a opção de mover a tartaruga.\", [text2(\"Olá!\")]),\n  clear: label(\"apagar desenho da tartaruga\", \"Caneta e desenho\", 1, \"Apaga os desenhos desta tartaruga sem mudar sua posição ou estado.\"),\n  reset: label(\"reiniciar tartaruga\", \"Tartarugas\", 2, \"Apaga o desenho e restaura a posição e o estado inicial desta tartaruga.\"),\n  stamp: label(\"carimbar tartaruga\", \"Caneta e desenho\", 2, \"Deixa uma cópia da aparência no desenho e devolve o identificador do carimbo.\"),\n  clearstamp: label(\"apagar carimbo\", \"Caneta e desenho\", 2, \"Apaga o carimbo identificado pelo valor devolvido por stamp.\", [name(\"carimbo\")]),\n  clearstamps: label(\"apagar carimbos\", \"Caneta e desenho\", 2, \"Sem argumento apaga todos os carimbos desta tartaruga; um número limita quais apagar.\"),\n  shape: label(\"aparência da tartaruga\", \"Aparência e imagens\", 1, \"Escolhe uma forma conhecida ou uma imagem registrada. Sem argumento consulta o nome.\", [text2(\"turtle\")]),\n  shapesize: label(\"tamanho da forma\", \"Aparência e imagens\", 2, \"Altera a escala da forma geométrica e a espessura do contorno. Não redimensiona imagens.\", [n(2), n(2)]),\n  showturtle: label(\"mostrar tartaruga\", \"Aparência e imagens\", 1, \"Mostra a tartaruga sem alterar os desenhos existentes.\"),\n  hideturtle: label(\"esconder tartaruga\", \"Aparência e imagens\", 1, \"Esconde a tartaruga; ela ainda pode mover e desenhar.\"),\n  isvisible: label(\"tartaruga está visível\", \"Aparência e imagens\", 2, \"Devolve verdadeiro se a tartaruga estiver sendo mostrada.\"),\n  speed: label(\"velocidade do desenho\", \"Animação e tempo\", 1, \"Define a velocidade de animação dos movimentos. Zero desenha sem animação intermediária.\", [n(0)]),\n  onclick: label(\"ao clicar na tartaruga\", \"Eventos\", 2, \"Recebe uma função com x e y para quando esta tartaruga for clicada. None remove o evento.\", [callback()]),\n  onrelease: label(\"ao soltar na tartaruga\", \"Eventos\", 2, \"Recebe uma função com x e y para quando o botão do mouse for solto.\", [callback()]),\n  ondrag: label(\"ao arrastar tartaruga\", \"Eventos\", 2, \"Recebe uma função com x e y durante o arrasto com o mouse.\", [callback()]),\n  bgcolor: label(\"cor do fundo\", \"Tela\", 1, \"Define a cor do fundo da tela. Sem argumentos consulta a cor.\", [text2(\"white\")]),\n  bgpic: label(\"imagem do fundo\", \"Aparência e imagens\", 2, \"Usa uma imagem do projeto como fundo. Sem argumento consulta o nome; nopic remove a imagem.\", [text2(\"fundo.png\")]),\n  colormode: label(\"escala de cores\", \"Tela\", 2, \"Escolhe componentes RGB entre zero e um ou entre zero e 255.\", [n(255)]),\n  delay: label(\"intervalo de animação\", \"Animação e tempo\", 2, \"Define em milissegundos o intervalo de animação. Sem argumento consulta o valor.\", [n(10)]),\n  getshapes: label(\"nomes das formas\", \"Aparência e imagens\", 2, \"Devolve os nomes de formas e imagens disponíveis na tela.\"),\n  register_shape: label(\"registrar forma ou imagem\", \"Aparência e imagens\", 2, \"Registra uma imagem pelo caminho do projeto ou uma forma com pares de coordenadas.\", [text2(\"personagem.png\")]),\n  listen: label(\"receber teclado\", \"Eventos\", 1, \"Pede foco para a tela receber as teclas que foram configuradas.\"),\n  onkey: label(\"ao soltar tecla\", \"Eventos\", 2, \"Recebe uma função sem argumentos para quando a tecla for solta. Use listen para receber teclado.