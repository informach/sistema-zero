cts: distribution.files.map(({ path, sha256: sha2562 }) => ({ path, sha256: sha2562 })),\n    python: {\n      version: distribution.pythonVersion,\n      packages: [],\n      providedModules: distribution.providedModules,\n      features: distribution.features\n    }\n  }));\n  const deployment = { release, distribution };\n  const verified = await verifyStudioPythonDeployment(deployment);\n  const runtime = {\n    profileId: release.profileId,\n    releaseId: release.releaseId,\n    manifestSha256: release.manifestSha256\n  };\n  const members = input3.baseline.members ? structuredClone(input3.baseline.members) : {\n    version: 1,\n    catalog: { profiles: [], releases: [] },\n    releases: []\n  };\n  const worker = input3.baseline.worker ? structuredClone(input3.baseline.worker) : {\n    version: 1,\n    parentOrigins: [],\n    deployments: []\n  };\n  const existingRelease = members.catalog.releases.find((candidate) => candidate.profileId === release.profileId && candidate.releaseId === release.releaseId);\n  const existingDeployment = worker.deployments.find(({ deployment: candidate }) => candidate.release.profileId === release.profileId && candidate.release.releaseId === release.releaseId);\n  if (existingRelease && !same2(existingRelease, release) || existingDeployment && !same2(existingDeployment.deployment, deployment))\n    throw new Error(\"A identidade permanente já aponta para outro conteúdo.\");\n  const existingPolicy = members.releases.find((entry) => entry.runtime.manifestSha256 === release.manifestSha256);\n  const status = existingPolicy?.status ?? existingDeployment?.status ?? \"active\";\n  const codecs = [...PYTHON_PROGRAMMING_CODECS, ...PYTHON_TURTLE_CODECS].filter((codec2) => (codec2.requiredRuntimeFeatures ?? []).every((feature) => distribution.features.includes(feature)));\n  const catalog2 = describePythonCatalog(codecs);\n  const policy = {\n    runtime,\n    status,\n    proTemplateIds: [\"python-blank\"],\n    blockIds: catalog2.map(({ id }) => id).sort(),\n    categoryIds: [...new Set(catalog2.flatMap(({ path }) => path.slice(1)))].sort()\n  };\n  if (existingPolicy && !same2(existingPolicy, policy))\n    throw new Error(\"A curadoria existente da release é diferente.\");\n  if (!existingRelease)\n    members.catalog.releases.push(release);\n  if (!existingPolicy)\n    members.releases.push(policy);\n  const profile = members.catalog.profiles.find(({ id }) => id === release.profileId);\n  if (profile) {\n    if (!same2(profile.languages, [\"python\"]))\n      throw new Error(\"O perfil permanente pertence a outra linguagem.\");\n    profile.kinds = union2(profile.kinds, release.manifest.kinds);\n    profile.modes = union2(profile.modes, release.manifest.modes);\n    if (!profile.releases.some(({ id }) => id === release.releaseId))\n      profile.releases.push({ id: release.releaseId, manifestSha256: release.manifestSha256 });\n  } else\n    members.catalog.profiles.push({\n      id: release.profileId,\n      languages: [\"python\"],\n      kinds: release.manifest.kinds,\n      modes: release.manifest.modes,\n      levels: [],\n      releases: [{ id: release.releaseId, manifestSha256: release.manifestSha256 }]\n    });\n  if (!existingDeployment)\n    worker.deployments.push({ status, deployment });\n  worker.parentOrigins = union2(worker.parentOrigins, input3.target.parentOrigins);\n  const hosts = structuredClone(input3.baseline.hosts);\n  const host = hosts.find((entry) => entry.runtime.manifestSha256 === release.manifestSha256);\n  if (host && host.origin !== input3.target.runtimeOrigin)\n    throw new Error(\"O host anterior da release é diferente.\");\n  if (!host)\n    hosts.push({ runtime, origin: input3.target.runtimeOrigin });\n  const frameOrigins = {\n    admin: union2(input3.baseline.frameOrigins.admin, [input3.target.runtimeOrigin]),\n    community: union2(input3.baseline.frameOrigins.community, [input3.target.runtimeOrigin]),\n    \"community-kids\": union2(input3.baseline.frameOrigins[\"community-kids\"], [\n      input3.target.runtimeOrigin\n    ])\n  };\n  const configuration = {\n    worker,\n    members,\n    hosts,\n    previewOrigin: input3.target.runtimeOrigin,\n    frameOrigins\n  };\n  await validateConfiguration(configuration);\n  const workerCatalog = await describePythonRuntimeConfiguration(worker);\n  const workerBindings = {\n    STUDIO_PYTHON_DISTRIBUTIONS_SHA256: workerCatalog.sha256,\n    STUDIO_PYTHON_PREVIEW_ORIGIN: configuration.previewOrigin\n  };\n  if (Object.values(workerBindings).some((value2) => Buffer.byteLength(value2) > 5000))\n    throw new Error(\"Uma variável do Worker excede o limite operacional de 5KB.\");\n  const body2 = {\n    kind: \"studio.python.runtime-promotion\",\n    version: 1,\n    input: input3,\n    baselineSha256: await sha256Hex(canonicalJson(input3.baseline)),\n    configuration,\n    workerCatalog,\n    workerBindings,\n    configurationSha256: await sha256Hex(canonicalJson(configuration)),\n    deployment,\n    prefix: studioPythonRuntimePrefix(release.manifestSha256),\n    markerSha256: verified.markerSha256,\n    authoringCatalogSha256: await sha256Hex(canonicalJson(catalog2)),\n    defaults: { programmingLanguage: \"javascript\", installedExtensions: [] }\n  };\n  return { ...body2, planSha256: await sha256Hex(canonicalJson(body2)) };\n}\nasync function verifyPythonPromotionPlan(raw, expectedSha256) {\n  const envelope = exports_external.object({ input: PythonPromotionInputSchema, planSha256: StudioSha256Schema }).parse(raw);\n  StudioSha256Schema.parse(expectedSha256);\n  if (envelope.planSha256 !== expectedSha256)\n    throw new Error(\"SHA do plano diferente do esperado.\");\n  const prepared = await preparePythonPromotion(envelope.input);\n  if (prepared.planSha256 !== expectedSha256 || !same2(raw, prepared))\n    throw new Error(\"O plano foi alterado ou não corresponde ao catálogo e artefatos atuais.\");\n  return prepared;\n}\n\n// packages/studio-runtime/scripts/qualify-python-execution.ts\nvar STAGING_PYTHON_RUNTIME_ORIGIN = \"https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev\";\nvar PYTHON_EXECUTION_QUALIFICATION_LIMITS = Object.freeze({\n  workMs: 240000,\n  cleanupMs: 60000,\n  totalMs: 300000,\n  requestMs: 90000,\n  smallRequestMs: 15000,\n  cleanupRequestMs: 1e4,\n  planBytes: 2000000\n});\nvar hash2 = (value2) => createHash3(\"sha256\").update(value2).digest(\"hex\");\nvar ackSchema = exports_external.strictObject({ ok: exports_external.literal(true) });\nvar openSchema = exports_external.strictObject({ ok: exports_external.literal(true), input: StudioPythonInputReferenceSchema });\nvar reportSchema = exports_external.strictObject({ ok: exports_external.literal(true), report: exports_external.unknown() });\nvar validationSchema = reportSchema.extend({ preview: exports_external.unknown().optional() });\nvar denialSchema = exports_external.object({ ok: exports_external.literal(false), code: exports_external.string() });\nfunction parsePythonExecutionOptions(args) {\n  const [mode, ...flags] = args;\n  assert2(mode === \"preflight\" || mode === \"run\", \"Use preflight or run explicitly.\");\n  const names2 = [\n    \"environment\",\n    \"base-url\",\n    \"plan\",\n    \"plan-sha256\",\n    \"manifest-sha256\",\n    \"distribution-sha256\",\n    \"parent-origin\",\n    \"out\"\n  ];\n  const values = new Map;\n  for (const flag of flags) {\n    const match = /^--([a-z0-9-]+)=(.+)$/.exec(flag);\n    assert2(match && names2.includes(match[1]) && !values.has(match[1]), \"Invalid or repeated argument.\");\n    values.set(match[1], match[2]);\n  }\n  assert2(names2.every((name2) => values.has(name2)), \"Every public pin and path is required.\");\n  const get = (name2) => values.get(name2);\n  assert2.equal(get(\"environment\"), \"staging\");\n  assert2.equal(get(\"base-url\"), STAGING_PYTHON_RUNTIME_ORIGIN);\n  for (const key of [\"plan-sha256\", \"manifest-sha256\", \"distribution-sha256\"])\n    assert2(/^[a-f0-9]{64}$/.test(get(key)), \"Invalid SHA-256.\");\n  const parent = new URL(get(\"parent-origin\"));\n  assert2(parent.protocol === \"https:\" && parent.origin === get(\"parent-origin\") && !parent.username && !parent.password && parent.origin !== get(\"base-url\"), \"Invalid parent origin.\");\n  return Object.freeze({\n    mode,\n    environment: \"staging\",\n    baseUrl: get(\"base-url\"),\n    planPath: resolve3(get(\"plan\")),\n    planSha256: get(\"plan-sha256\"),\n    manifestSha256: get(\"manifest-sha256\"),\n    distributionSha256: get(\"distribution-sha256\"),\n    parentOrigin: parent.origin,\n    directory: resolve3(get(\"out\"))\n  });\n}\nasync function pinPythonExecutionPlan(raw, options) {\n  const plan = await verifyPythonPromotionPlan(raw, options.planSha256);\n  assert2.equal(plan.input.environment, options.environment);\n  assert2.equal(plan.input.target.runtimeOrigin, options.baseUrl);\n  assert2(plan.configuration.worker?.parentOrigins.includes(options.parentOrigin), \"Parent origin is absent from the final approved plan.\");\n  const deployment = await verifyStudioPythonDeployment(plan.deployment);\n  assert2.equal(deployment.release.manifestSha256, options.manifestSha256);\n  assert2.equal(deployment.distributionSha256, options.distributionSha256);\n  assert2(deployment.release.manifest.extensions.some((item) => item.id === \"python-turtle\" && item.versions.includes(\"1.0.0\")), \"Turtle 1.0.0 is required.\");\n  assert2([\"inspect.mjs\", \"playtest.mjs\"].every((path) => deployment.distribution.files.some((file2) => file2.path === path)), \"Inspection/playtest artifacts are required.\");\n  return deployment;\n}\nvar imageBytes = () => Buffer.from(\"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==\", \"base64\");\nvar sourceFixtures = [\n  {\n    name: \"inspection-no-execution\",\n    main: `import helper\nraise RuntimeError(\"qa-main-must-not-run\")\n`,\n    helper: `raise RuntimeError(\"qa-helper-must-not-run\")\n`\n  },\n  { name: \"compile-rejection\", main: `def broken(:\n    pass\n`, helper: `VALUE = 7\n` },\n  {\n    name: \"turtle-input-and-capture\",\n    main: [\n      \"import turtle\",\n      \"from helper import greeting\",\n      \"screen = turtle.Screen()\",\n      \"screen.setup(320, 240)\",\n      \"actor = turtle.Turtle()\",\n      \"actor.speed(0)\",\n      'screen.addshape(\"hero.png\")',\n      'actor.shape(\"hero.png\")',\n      \"def pressed():\",\n      \"    actor.forward(10)\",\n      '    print(\"qa-key-fired\")',\n      \"def clicked(x, y):\",\n      \"    actor.goto(x, y)\",\n      '    print(\"qa-click-fired\")',\n      'screen.onkey(pressed, \"space\")',\n      \"screen.onclick(clicked)\",\n      \"screen.listen()\",\n      'print(\"Nome?\")',\n      \"answer = input()\",\n      \"print(greeting(answer))\",\n      \"screen.mainloop()\",\n      \"\"\n    ].join(`\n`),\n    helper: `def greeting(name):\n    return \"qa-stdin-\" + name\n`\n  }\n];\nfunction evidence(name2, revision, files) {\n  return {\n    name: name2,\n    requestId: randomUUID(),\n    executionId: `qa-${randomUUID()}`,\n    revision,\n    files,\n    admission: \"not-sent\",\n    oraclePassed: false,\n    previewRequested: false,\n    previewRemoveAcknowledged: false,\n    previewRetirementConfirmed: false,\n    inputRemoveAcknowledged: false,\n    inputRetirementConfirmed: false\n  };\n}\nasync function createPythonExecutionRun(options, deployment) {\n  assert2.equal(deployment.release.manifestSha256, options.manifestSha256);\n  assert2.equal(deployment.distributionSha256, options.distributionSha256);\n  const owner = Array.from(randomBytes(32), (byte) => byte.toString(16).padStart(2, \"0\")).join(\"\");\n  const projectId = `qa-runtime-${randomUUID()}`;\n  const cases = [];\n  for (const fixture of sourceFixtures) {\n    const files = new Map([\n      [\"main.py\", Buffer.from(fixture.main)],\n      [\"helper.py\", Buffer.from(fixture.helper)]\n    ]);\n    const graphical = fixture.name === \"turtle-input-and-capture\";\n    if (graphical)\n      files.set(\"hero.png\", imageBytes());\n    const content = StudioPythonExecutionContentSchema.parse({\n      version: 1,\n      configuration: {\n        runtime: {\n          profileId: deployment.release.profileId,\n          releaseId: deployment.release.releaseId,\n          manifestSha256: options.manifestSha256\n        },\n        extensions: graphical ? [{ id: \"python-turtle\", version: \"1.0.0\" }] : [],\n        python: {\n          entrypoint: \"main.py\",\n          dependencyLock: {\n            lockVersion: 1,\n            target: \"browser\",\n            pythonVersion: deployment.distribution.pythonVersion,\n            runtimeManifestSha256: options.manifestSha256,\n            requirementsSha256: hash2(\"\"),\n            packages: []\n          }\n        }\n      },\n      directories: [],\n      files: [...files].map(([path, bytes]) => ({\n        path,\n        kind: path.endsWith(\".py\") ? \"source\" : \"asset\",\n        sha256: hash2(bytes),\n        byteLength: bytes.length\n      }))\n    });\n    const snapshot = await verifyStudioPythonExecutionMetadata({\n      ...content,\n      projectId,\n      revision: await studioPythonExecutionRevision(content)\n    });\n    const recipe = StudioPythonPlaytestRecipeSchema.parse({\n      version: 1,\n      observeMs: 1000,\n      stdin: graphical ? [\"Lia\"] : [],\n      keys: graphical ? [\"Space\"] : [],\n      clicks: graphical ? [{ x: 0.25, y: 0.25, button: \"left\" }] : [],\n      requireGraphics: graphical\n    });\n    const state = evidence(fixture.name, snapshot.revision, snapshot.files.map(({ path, sha256: sha2562, byteLength }) => ({ path, sha256: sha2562, byteLength })));\n    if (fixture.name !== \"inspection-no-execution\")\n      state.recipeSha256 = hash2(canonicalJson(recipe));\n    cases.push({\n      files,\n      snapshot,\n      recipe,\n      state\n    });\n  }\n  const receipt = {\n    version: 1,\n    kind: \"studio.python.remote-execution-qualification\",\n    environment: options.environment,\n    baseUrl: options.baseUrl,\n    parentOrigin: options.parentOrigin,\n    planSha256: options.planSha256,\n    manifestSha256: options.manifestSha256,\n    distributionSha256: options.distributionSha256,\n    pythonVersion: deployment.distribution.pythonVersion,\n    owner,\n    projectId,\n    status: \"RUNNING\",\n    phase: \"reserved\",\n    startedAt: new Date().toISOString(),\n    endedAt: null,\n    cases: cases.map((item) => item.state),\n    negativeAdmissions: [],\n    checks: [],\n    remoteOutcomeUnknown: false,\n    logicalCleanupConfirmed: false,\n    apiQualified: false,\n    cancellationQualified: false,\n    physicalCleanupVerified: false,\n    hostedUI: false,\n    contextualAuthorization: false,\n    publicGameExecution: false,\n    performance: false,\n    overallQualified: false,\n    failures: []\n  };\n  return { receipt, cases };\n}\nasync function readBinary(response, maximum, signal) {\n  const declared = response.headers.get(\"content-length\");\n  assert2(declared === null || /^\\d+$/.test(declared) && Number(declared) <= maximum, \"Body limit.\");\n  assert2(response.body, \"Missing response body.\");\n  const reader = response.body.getReader();\n  const chunks = [];\n  let length = 0;\n  let complete = false;\n  try {\n    while (true) {\n      const part = await awaitWithSignal(() => reader.read(), signal);\n      if (part.done) {\n        complete = true;\n        break;\n      }\n      length += part.value.length;\n      assert2(length <= maximum, \"Body limit.\");\n      chunks.push(part.value);\n    }\n    const bytes = new Uint8Array(length);\n    let offset = 0;\n    for (const chunk of chunks) {\n      bytes.set(chunk, offset);\n      offset += chunk.length;\n    }\n    return bytes;\n  } finally {\n    if (!complete)\n      await awaitWithSignal(() => reader.cancel(), AbortSignal.timeout(1000)).catch(() => {});\n    reader.releaseLock();\n  }\n}\nasync function qualifyPythonExecution(input3) {\n  const { deployment, run, checkpoint, saveCapture } = input3;\n  const options = Object.freeze({ ...input3.options });\n  assert2(options.baseUrl === STAGING_PYTHON_RUNTIME_ORIGIN && options.environment === \"staging\");\n  assert2(input3.token.trim() === input3.token && input3.token.length > 0 && !/[\\r\\n]/.test(input3.token));\n  const cases = run.cases.map((item) => ({\n    ...item,\n    snapshot: structuredClone(item.snapshot),\n    recipe: structuredClone(item.recipe),\n    files: new Map([...item.files].map(([path, bytes]) => [path, Uint8Array.from(bytes)]))\n  }));\n  const token = input3.token;\n  const fetchPort = input3.fetchImpl ?? fetch;\n  const receipt = run.receipt;\n  const resources = [];\n  const failures = [];\n  const total = AbortSignal.timeout(PYTHON_EXECUTION_QUALIFICATION_LIMITS.totalMs);\n  const work = AbortSignal.any([\n    total,\n    AbortSignal.timeout(PYTHON_EXECUTION_QUALIFICATION_LIMITS.workMs),\n    ...input3.signal ? [input3.signal] : []\n  ]);\n  let finalCleanup;\n  const persist = async (signal = work) => {\n    try {\n      await awaitWithSignal(checkpoint, signal);\n    } catch (error48) {\n      receipt.failures.push({ phase: receipt.phase, kind: \"checkpoint\" });\n      throw error48;\n    }\n  };\n  const wire = async (name2, path, params = {}) => {\n    receipt.phase = name2;\n    const scope = params.cleanup ? finalCleanup ?? total : work;\n    const signal = AbortSignal.any([\n      scope,\n      AbortSignal.timeout(params.cleanup ? PYTHON_EXECUTION_QUALIFICATION_LIMITS.cleanupRequestMs : path.endsWith(\"/validate\") || path.endsWith(\"/inspect\") ? PYTHON_EXECUTION_QUALIFICATION_LIMITS.requestMs : PYTHON_EXECUTION_QUALIFICATION_LIMITS.smallRequestMs)\n    ]);\n    if (params.cleanup) {\n      try {\n        await persist(AbortSignal.any([scope, AbortSignal.timeout(1000)]));\n      } catch (error48) {\n        failures.push(error48);\n      }\n    } else\n      await persist(signal);\n    signal.throwIfAborted();\n    const headers = {};\n    if (!params.anonymous)\n      headers.Authorization = `Bearer ${token}`;\n    if (params.ref)\n      headers[\"X-Studio-Python-Input\"] = JSON.stringify(params.ref);\n    const body2 = params.bytes ? new Blob([Uint8Array.from(params.bytes)]) : params.body === undefined ? undefined : JSON.stringify(params.body);\n    if (body2 !== undefined)\n      headers[\"Content-Type\"] = params.bytes ? \"application/octet-stream\" : \"application/json\";\n    const response = await awaitWithSignal(() => {\n      params.onDispatch?.();\n      return fetchPort(new URL(path, options.baseUrl), {\n        method: body2 === undefined ? \"GET\" : \"POST\",\n        body: body2,\n        headers,\n        signal,\n        redirect: \"error\"\n      });\n    }, signal, (late) => {\n      late.body?.cancel().catch(() => {});\n    });\n    try {\n      const value2 = params.binary ? await readBinary(response, STUDIO_PYTHON_PLAYTEST_LIMITS.captureBytes, signal) : await readJsonBodyWithLimit(response, STUDIO_PYTHON_VALIDATION_LIMITS.responseBytes, signal);\n      receipt.checks.push({ name: name2, status: response.status, passed: false });\n      return { status: response.status, headers: response.headers, value: value2 };\n    } catch (error48) {\n      response.body?.cancel().catch(() => {});\n      throw error48;\n    }\n  };\n  const pass2 = () => {\n    receipt.checks[receipt.checks.length - 1].passed = true;\n  };\n  const retire = async (resource) => {\n    if (resource.cleanupAttempted)\n      return;\n    resource.cleanupAttempted = true;\n    const { state, ref } = resource;\n    if (state.previewRequested) {\n      try {\n        const removed = await wire(`${state.name}:remove-preview`, \"/v1/python/previews/remove\", {\n          body: ref,\n          cleanup: true\n        });\n        assert2.equal(removed.status, 200);\n        ackSchema.parse(removed.value);\n        state.previewRemoveAcknowledged = true;\n        pass2();\n        if (resource.previewUrl) {\n          const absent = await wire(`${state.name}:preview-retired`, resource.previewUrl, {\n            anonymous: true,\n            cleanup: true,\n            binary: true\n          });\n          assert2.equal(absent.status, 404);\n          state.previewRetirementConfirmed = true;\n          pass2();\n        }\n      } catch (error48) {\n        failures.push(error48);\n        receipt.failures.push({ phase: receipt.phase, kind: \"cleanup\" });\n      }\n    }\n    try {\n      const removed = await wire(`${state.name}:remove-input`, \"/v1/python/inputs/remove\", {\n        body: ref,\n        cleanup: true\n      });\n      assert2.equal(removed.status, 200);\n      ackSchema.parse(removed.value);\n      state.inputRemoveAcknowledged = true;\n      pass2();\n      const absent = await wire(`${state.name}:input-retired`, \"/v1/python/inspect\", {\n        body: StudioPythonInspectionRequestSchema.parse({\n          version: 1,\n          input: ref,\n          structure: false\n        }),\n        cleanup: true\n      });\n      assert2.equal(absent.status, 410);\n      denialSchema.parse(absent.value);\n      state.inputRetirementConfirmed = true;\n      pass2();\n    } catch (error48) {\n      failures.push(error48);\n      receipt.failures.push({ phase: receipt.phase, kind: \"cleanup\" });\n    }\n  };\n  const admit = async (item, expected, anonymous = false) => {\n    const state = item.state;\n    if (expected !== 200)\n      receipt.negativeAdmissions.push(state);\n    const body2 = StudioPythonInputOpenSchema.parse({\n      version: 1,\n      owner: receipt.owner,\n      requestId: state.requestId,\n      executionId: state.executionId,\n      snapshot: item.snapshot\n    });\n    let dispatched = false;\n    let acknowledged = false;\n    try {\n      const result = await wire(`${state.name}:open`, \"/v1/python/inputs\", {\n        body: body2,\n        anonymous,\n        onDispatch: () => {\n          dispatched = true;\n          state.admission = \"pending\";\n        }\n      });\n      if (result.status === 200) {\n        const ref = openSchema.parse(result.value).input;\n        assert2(ref.owner === body2.owner && ref.requestId === body2.requestId && ref.executionId === body2.executionId && ref.projectId === body2.snapshot.projectId && ref.revision === body2.snapshot.revision && ref.expiresAt > Date.now() && ref.expiresAt <= Date.now() + STUDIO_PYTHON_INPUT_LIMITS.lifetimeMs, \"Admission mismatch.\");\n        const resource = { ref, state, cleanupAttempted: false };\n        resources.push(resource);\n        state.admission = \"known\";\n        acknowledged = true;\n        assert2.equal(result.status, expected);\n        pass2();\n        await persist();\n        return resource;\n      }\n      denialSchema.parse(result.value);\n      const provenPreAdmissionDenial = anonymous && expected === 401 && result.status === 401 || !anonymous && expected === 409 && result.status === 409 && body2.snapshot.configuration.runtime.manifestSha256 !== options.manifestSha256;\n      if (provenPreAdmissionDenial) {\n        state.admission = \"denied\";\n        acknowledged = true;\n      }\n      assert2.equal(result.status, expected);\n      pass2();\n      return;\n    } catch (error48) {\n      if (dispatched && !acknowledged) {\n        state.admission = \"unknown\";\n        receipt.remoteOutcomeUnknown = true;\n      }\n      throw error48;\n    }\n  };\n  try {\n    const metadata3 = await wire(\"deployment\", `/v1/runtime-deployments/${options.manifestSha256}`, {\n      anonymous: true\n    });\n    assert2.equal(metadata3.status, 200);\n    const served = await verifyStudioPythonDeployment(metadata3.value);\n    assert2.equal(served.release.manifestSha256, options.manifestSha256);\n    assert2.equal(served.distributionSha256, options.distributionSha256);\n    assert2.equal(canonicalJson(served.release), canonicalJson(deployment.release));\n    pass2();\n    const base2 = cases[0];\n    await admit({ ...base2, state: evidence(\"anonymous-refused\", base2.snapshot.revision, []) }, 401, true);\n    const changed = structuredClone(base2.snapshot);\n    const unknownManifest = hash2(`unapproved-qa-${randomUUID()}`);\n    changed.configuration.runtime.manifestSha256 = unknownManifest;\n    changed.configuration.python.dependencyLock.runtimeManifestSha256 = unknownManifest;\n    const { projectId: _id, revision: _revision, ...changedContent } = changed;\n    changed.revision = await studioPythonExecutionRevision(changedContent);\n    await admit({\n      ...base2,\n      snapshot: changed,\n      state: evidence(\"unapproved-release-refused\", changed.revision, [])\n    }, 409);\n    for (const item of cases) {\n      const resource = await admit(item, 200);\n      assert2(resource);\n      const { state, ref } = resource;\n      const wrongOwner = { ...ref, owner: hash2(`different-owner-${receipt.owner}`) };\n      const refused = await wire(`${state.name}:owner-refused`, \"/v1/python/inspect\", {\n        body: StudioPythonInspectionRequestSchema.parse({\n          version: 1,\n          input: wrongOwner,\n          structure: false\n        })\n      });\n      assert2.equal(refused.status, 409);\n      denialSchema.parse(refused.value);\n      pass2();\n      for (const file2 of item.snapshot.files) {\n        const bytes = item.files.get(file2.path);\n        assert2(bytes && hash2(bytes) === file2.sha256 && bytes.byteLength === file2.byteLength);\n        const uploaded = await wire(`${state.name}:upload:${file2.path}`, `/v1/python/files/${file2.sha256}`, { bytes, ref });\n        assert2.equal(uploaded.status, 200);\n        const ack = exports_external.strictObject({\n          ok: exports_external.literal(true),\n          file: exports_external.strictObject({\n            sha256: exports_external.string(),\n            bytes: exports_external.number()\n          })\n        }).parse(uploaded.value);\n        assert2.equal(ack.file.sha256, file2.sha256);\n        assert2.equal(ack.file.bytes, file2.byteLength);\n        pass2();\n      }\n      if (state.name === \"inspection-no-execution\") {\n        const inspected = await wire(`${state.name}:inspect`, \"/v1/python/inspect\", {\n          body: StudioPythonInspectionRequestSchema.parse({\n            version: 1,\n            input: ref,\n            structure: false\n          })\n        });\n        assert2.equal(inspected.status, 200);\n        const report = await verifyStudioPythonInspectionReport(reportSchema.parse(inspected.value).report, item.snapshot);\n        assert2.equal(report.status, \"passed\");\n        state.compilePassed = true;\n        state.noExecutionReported = true;\n        state.reportSha256 = hash2(canonicalJson(report));\n        pass2();\n      } else {\n        state.previewRequested = item.recipe.requireGraphics;\n        const validated = await wire(`${state.name}:validate`, \"/v1/python/validate\", {\n          body: StudioPythonValidationRequestSchema.parse({\n            version: 1,\n            input: ref,\n            structure: false,\n            recipe: item.recipe,\n            ...state.previewRequested ? { preview: { parentOrigin: options.parentOrigin } } : {}\n          })\n        });\n        assert2.equal(validated.status, 200);\n        const envelope = validationSchema.parse(validated.value);\n        const report = await verifyStudioPythonValidationReport(envelope.report, item.snapshot, item.recipe, false);\n        state.reportSha256 = hash2(canonicalJson(report));\n        state.compilePassed = report.inspection.status === \"passed\";\n        if (!state.previewRequested) {\n          assert2.equal(report.status, \"failed\");\n          assert2.equal(report.inspection.status, \"failed\");\n          assert2.equal(report.execution, undefined);\n          assert2.equal(envelope.preview, undefined);\n          state.noExecutionReported = true;\n          pass2();\n        } else {\n          assert2.equal(report.status, \"passed\");\n          const execution = report.execution;\n          assert2(execution?.capture && execution.omittedChars === 0 && execution.stderr === \"\");\n          state.callbacks = {\n            stdin: execution.stdout.split(/\\r?\\n/).includes(\"qa-stdin-Lia\"),\n            key: execution.stdout.split(/\\r?\\n/).includes(\"qa-key-fired\"),\n            click: execution.stdout.split(/\\r?\\n/).includes(\"qa-click-fired\")\n          };\n          assert2(Object.values(state.callbacks).every(Boolean), \"Callbacks did not produce their causal markers.\");\n          const preview = verifyStudioPythonPreviewReference(envelope.preview, {\n            projectId: item.snapshot.projectId,\n            revision: item.snapshot.revision,\n            runtimeManifestSha256: options.manifestSha256,\n            serviceOrigin: options.baseUrl,\n            parentOrigin: options.parentOrigin,\n            now: Date.now()\n          });\n          resource.previewUrl = preview.url;\n          pass2();\n          const capture = await wire(`${state.name}:capture`, new URL(\"python-playtest.png\", preview.url).href, { anonymous: true, binary: true });\n          assert2.equal(capture.status, 200);\n          assert2.equal(capture.headers.get(\"content-type\"), \"image/png\");\n          assert2(capture.value instanceof Uint8Array);\n          const verified = await verifyStudioPythonPlaytestCapture(execution.capture, capture.value);\n          const { path: _path, ...publicCapture } = verified;\n          state.capture = publicCapture;\n          const png = capture.value;\n          if (saveCapture)\n            await awaitWithSignal(() => saveCapture(png), work);\n          pass2();\n        }\n      }\n      state.oraclePassed = true;\n      await retire(resource);\n      await persist();\n      assert2.equal(failures.length, 0, \"Cleanup failed; no further case will be admitted.\");\n      work.throwIfAborted();\n    }\n  } catch (error48) {\n    failures.push(error48);\n    receipt.failures.push({ phase: receipt.phase, kind: \"operation\" });\n  } finally {\n    finalCleanup = AbortSignal.any([\n      total,\n      AbortSignal.timeout(PYTHON_EXECUTION_QUALIFICATION_LIMITS.cleanupMs)\n    ]);\n    for (const resource of resources)\n      await retire(resource);\n    receipt.logicalCleanupConfirmed = resources.length > 0 && !receipt.remoteOutcomeUnknown && resources.every(({ state, previewUrl }) => state.inputRemoveAcknowledged && state.inputRetirementConfirmed && (!state.previewRequested || state.previewRemoveAcknowledged && (!previewUrl || state.previewRetirementConfirmed)));\n    receipt.apiQualified = failures.length === 0 && receipt.logicalCleanupConfirmed && receipt.cases.every((state) => state.oraclePassed);\n    receipt.status = receipt.apiQualified ? \"API_PASSED\" : \"FAILED\";\n    receipt.endedAt = new Date().toISOString();\n    try {\n      await persist(finalCleanup);\n    } catch (error48) {\n      failures.push(error48);\n      receipt.status = \"FAILED\";\n      receipt.apiQualified = false;\n    }\n  }\n  if (failures.length === 1)\n    throw failures[0];\n  if (failures.length > 1)\n    throw new AggregateError(failures, \"Runtime qualification and/or cleanup failed.\");\n  return receipt;\n}\nasync function runPythonExecutionCli(args) {\n  assert2(!process.versions.bun && process.versions.node === \"24.22.0\", \"Use Node 24.22.0 for the remote operator.\");\n  const options = parsePythonExecutionOptions(args);\n  const info = await lstat2(options.planPath);\n  assert2(info.isFile() && !info.isSymbolicLink() && info.size <= PYTHON_EXECUTION_QUALIFICATION_LIMITS.planBytes, \"Plan must be a bounded regular file.\");\n  const bytes = await readFile2(options.planPath);\n  assert2(bytes.length <= PYTHON_EXECUTION_QUALIFICATION_LIMITS.planBytes);\n  const deployment = await pinPythonExecutionPlan(JSON.parse(new TextDecoder(\"utf-8\", { ignoreBOM: true }).decode(bytes)), options);\n  const run = await createPythonExecutionRun(options, deployment);\n  await mkdir(options.directory, { recursive: false });\n  const output = await open(resolve3(options.directory, \"receipt.json\"), \"wx\");\n  let writing = Promise.resolve();\n  const checkpoint = () => {\n    const json2 = `${JSON.stringify(run.receipt, null, 2)}\n`;\n    const pending = writing.then(async () => {\n      await output.truncate(0);\n      await output.write(json2, 0, \"utf8\");\n      await output.sync();\n    });\n    writing = pending.catch(() => {});\n    return pending;\n  };\n  const controller = new AbortController;\n  const abort = () => controller.abort(new Error(\"Operator interrupted.\"));\n  process.on(\"SIGINT\", abort);\n  process.on(\"SIGTERM\", abort);\n  const errors3 = [];\n  try {\n    await checkpoint();\n    if (options.mode === \"preflight\") {\n      run.receipt.status = \"PREFLIGHT_ONLY\";\n      run.receipt.phase = \"offline-inputs-verified\";\n      run.receipt.endedAt = new Date().toISOString();\n      await checkpoint();\n    } else {\n      const token = process.env.STUDIO_PYTHON_RUNTIME_TOKEN;\n      assert2(token, \"STUDIO_PYTHON_RUNTIME_TOKEN is required in memory.\");\n      await qualifyPythonExecution({\n        options,\n        deployment,\n        run,\n        token,\n        checkpoint,\n        signal: controller.signal,\n        saveCapture: (png) => writeFile(resolve3(options.directory, \"python-playtest.png\"), png, { flag: \"wx\" })\n      });\n    }\n  } catch (error48) {\n    errors3.push(error48);\n    run.receipt.status = \"FAILED\";\n    run.receipt.apiQualified = false;\n    run.receipt.endedAt = new Date().toISOString();\n    try {\n      await checkpoint();\n    } catch (failure) {\n      errors3.push(failure);\n    }\n  } finally {\n    process.off(\"SIGINT\", abort);\n    process.off(\"SIGTERM\", abort);\n    await writing;\n    try {\n      await output.close();\n    } catch (error48) {\n      errors3.push(error48);\n    }\n  }\n  if (errors3.length === 1)\n    throw errors3[0];\n  if (errors3.length > 1)\n    throw new AggregateError(errors3, \"Operator failed; inspect the sanitized receipt.\");\n}\nif (process.argv[1] && resolve3(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  runPythonExecutionCli(process.argv.slice(2)).catch(() => {\n    process.stderr.write(`Runtime qualification failed. Inspect the new sanitized receipt; no automatic retry.\n`);\n    process.exitCode = 1;\n  });\n}\nexport {\n  runPythonExecutionCli,\n  qualifyPythonExecution,\n  pinPythonExecutionPlan,\n  parsePythonExecutionOptions,\n  createPythonExecutionRun,\n  STAGING_PYTHON_RUNTIME_ORIGIN,\n  PYTHON_EXECUTION_QUALIFICATION_LIMITS\n};\n"
    },
