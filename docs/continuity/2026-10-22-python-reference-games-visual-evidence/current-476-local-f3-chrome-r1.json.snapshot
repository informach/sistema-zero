  "supervisor": {
    "sha256": "11f1787f08d248ae957b4271563c3d9a7d4c7cc698a28d1d8aa3392e6a258e37",
    "content": "param([Parameter(Mandatory=$true)][string]$RunName, [ValidateSet('F1','F3')][string]$Mode='F3', [ValidateSet('chrome','edge','msedge')][string]$Project='chrome')\n$ErrorActionPreference='Stop'\n$workspace='C:\\Users\\tocha\\projects\\sistema-zero-python-review-fixes'\n$packet=Join-Path $workspace '.cache\\python-reference-games'\nif($RunName -notmatch '^[a-z0-9-]+$'){throw 'Invalid run namespace'}\n$output=Join-Path $packet $RunName\nif(Test-Path -LiteralPath $output){throw 'Output namespace already used'}\n$listeners=@(Get-CimInstance -Namespace root/StandardCimv2 -ClassName MSFT_NetTCPConnection -Filter 'State = 2' | Where-Object LocalPort -in @(5297,5298))\nif($listeners.Count){throw 'A UI port is already owned; no process was stopped'}\n$node='C:\\Users\\tocha\\projects\\sistema-zero-python\\.cache\\studio-python-l0\\node-v24.22.0\\node-v24.22.0-win-x64\\node.exe'\n$bun='C:\\Users\\tocha\\projects\\sistema-zero-python\\.cache\\studio-python-l0\\bun-1.4.3-isolated\\extracted\\bun-windows-x64\\bun.exe'\nif((Get-FileHash -LiteralPath $bun -Algorithm SHA256).Hash.ToLowerInvariant() -ne '095db4abae203d42f29fdec26da4a882fcde6333cdd84e40c0c7828c0cf543f6'){throw 'Bun pin mismatch'}\nif((Get-FileHash -LiteralPath $node -Algorithm SHA256).Hash.ToLowerInvariant() -ne 'ba93f9a70bd86fce3ebbb39ec758501458453467aa92a34a0a3602d1e3fc2b9c'){throw 'Node pin mismatch'}\n[void](New-Item -ItemType Directory -Path $output)\n$profileDir=Join-Path $output 'profile'\nforeach($suffix in @('AppData\\Local','AppData\\Roaming','temp')){[void](New-Item -ItemType Directory -Path (Join-Path $profileDir $suffix) -Force)}\n$info=[Diagnostics.ProcessStartInfo]::new()\n$info.FileName=$node\n$info.WorkingDirectory=Join-Path $workspace 'packages\\studio'\n$info.UseShellExecute=$false\n$info.CreateNoWindow=$true\n$info.RedirectStandardOutput=$true\n$info.RedirectStandardError=$true\n$info.Environment.Clear()\nforeach($name in @('SYSTEMROOT','WINDIR','SYSTEMDRIVE','COMSPEC','PROGRAMDATA','PROGRAMFILES','PROGRAMFILES(X86)','COMMONPROGRAMFILES','COMMONPROGRAMFILES(X86)')){\n  $value=[Environment]::GetEnvironmentVariable($name)\n  if($null -ne $value){$info.Environment[$name]=$value}\n}\n$info.Environment['PATH']=(Split-Path $bun -Parent)+';'+(Split-Path $node -Parent)+';'+$env:SYSTEMROOT+'\\System32'\n$info.Environment['USERPROFILE']=$profileDir\n$info.Environment['LOCALAPPDATA']=Join-Path $profileDir 'AppData\\Local'\n$info.Environment['APPDATA']=Join-Path $profileDir 'AppData\\Roaming'\n$info.Environment['TEMP']=Join-Path $profileDir 'temp'\n$info.Environment['TMP']=Join-Path $profileDir 'temp'\n$info.Environment['CI']='true'\n$info.Environment['NO_COLOR']='1'\n$info.Environment['DEBUG']='pw:browser'\n$info.Environment['NODE_OPTIONS']='--max-old-space-size=2304'\n$info.Environment['SZ_VISUAL_UI_OUTPUT']=$output\n$dist='476d32e78da6b528730b8b0535ad026f64fe4e61c03f20a195a7438bc56ace2c'\n$info.Environment['PYTHON_PROBE_DISTRIBUTION_DIRECTORY']='C:/Users/tocha/projects/sistema-zero/.cache/python-visual-games/dist-r2/distributions/'+$dist\n$info.Environment['PYTHON_PROBE_DISTRIBUTION_SHA256']=$dist\n$releasePath=Join-Path $packet 'staging-release-476-r1.json'\n$release=Get-Content -LiteralPath $releasePath -Raw | ConvertFrom-Json\n$info.Environment['PYTHON_PROBE_RELEASE_FILE']=$releasePath\n$info.Environment['PYTHON_PROBE_RELEASE_MANIFEST_SHA256']=$release.manifestSha256\n$info.Environment['PYTHON_PROBE_OUTPUT_DIR']=$output\n$info.Environment['SZ_PACMAN_QA_DISTRIBUTION']=$dist\nif($Mode -eq 'F3') {\n  $config=Join-Path $workspace 'packages/studio/playwright.python-games.config.ts'\n  $spec='python-f3-performance.spec.ts'\n  $info.Environment['SZ_F3_PLAY_MS']='600000'\n  $deadlineSeconds=840\n  if($Project -eq 'msedge'){$Project='edge'}\n} else {\n  $config=Join-Path $workspace 'packages/studio/playwright.python-live.config.ts'\n  $spec='live-performance.spec.ts'\n  $info.Environment['PYTHON_LIVE_WORKLOAD']='f1'\n  $info.Environment['PYTHON_LIVE_OUTPUT_DIR']=$output\n  $info.Environment['PYTHON_PROBE_NETWORK']='reference'\n  $deadlineSeconds=2700\n  if($Project -eq 'edge'){$Project='msedge'}\n}\nforeach($argument in @('node_modules/@playwright/test/cli.js','test','--config',$config,$spec,'--project',$Project,'--workers=1','--retries=0','--max-failures=1')){$info.ArgumentList.Add($argument)}\nif($Mode -eq 'F1'){$info.ArgumentList.Add('--repeat-each=30')}\n$before=Get-CimInstance Win32_OperatingSystem\n$cpu=Get-CimInstance Win32_Processor | Select-Object Name,NumberOfCores,NumberOfLogicalProcessors\n$gpu=Get-CimInstance Win32_VideoController | Select-Object Name,DriverVersion,CurrentHorizontalResolution,CurrentVerticalResolution,CurrentRefreshRate\n$sourceCommit=(git -C $workspace rev-parse HEAD).Trim()\n$child=[Diagnostics.Process]::new()\n$child.StartInfo=$info\n$start=[DateTime]::UtcNow\nif(-not $child.Start()){throw 'Runner did not start'}\n$birth=$child.StartTime.ToUniversalTime().Ticks\n$stdoutTask=$child.StandardOutput.ReadToEndAsync()\n$stderrTask=$child.StandardError.ReadToEndAsync()\nWrite-Output ('START '+$Mode+' project='+$Project+' pid='+$child.Id+' output='+$output)\n$watch=[Diagnostics.Stopwatch]::StartNew()\n$owners=[Collections.Generic.HashSet[int]]::new()\nwhile(-not $child.HasExited -and $watch.Elapsed.TotalSeconds -lt $deadlineSeconds){\n  Start-Sleep -Milliseconds 1000\n  foreach($listener in @(Get-CimInstance -Namespace root/StandardCimv2 -ClassName MSFT_NetTCPConnection -Filter 'State = 2' | Where-Object LocalPort -in @(5297,5298))){[void]$owners.Add([int]$listener.OwningProcess)}\n}\n$deadline=-not $child.HasExited\nif($deadline){\n  $same=Get-Process -Id $child.Id -ErrorAction Stop\n  if($same.StartTime.ToUniversalTime().Ticks -ne $birth){throw 'Runner PID ownership changed'}\n  $child.Kill($true)\n}\n$child.WaitForExit()\n$stdout=$stdoutTask.GetAwaiter().GetResult()\n$stderr=$stderrTask.GetAwaiter().GetResult()\n[IO.File]::WriteAllText((Join-Path $output 'stdout.log'),$stdout,[Text.UTF8Encoding]::new($false))\n[IO.File]::WriteAllText((Join-Path $output 'stderr.log'),$stderr,[Text.UTF8Encoding]::new($false))\n$browserIds=@([regex]::Matches($stderr,'\\[pid=(\\d+)\\]') | ForEach-Object {[int]$_.Groups[1].Value} | Sort-Object -Unique)\n$known=@($child.Id)+@($owners)+$browserIds\n$remaining=@(Get-CimInstance Win32_Process | Where-Object {$_.ProcessId -in $known} | Select-Object -ExpandProperty ProcessId)\n$openPorts=@(Get-CimInstance -Namespace root/StandardCimv2 -ClassName MSFT_NetTCPConnection -Filter 'State = 2' | Where-Object LocalPort -in @(5297,5298) | Select-Object LocalPort,OwningProcess)\n$receipt=[ordered]@{kind='studio-python-local-performance';mode=$Mode;project=$Project;sourceCommit=$sourceCommit;startedAt=$start.ToString('o');elapsedMs=$watch.ElapsedMilliseconds;creatorPid=$child.Id;birthTicks=$birth;exitCode=$child.ExitCode;deadline=$deadline;deadlineSeconds=$deadlineSeconds;distributionSha256=$dist;releaseSha256=$release.manifestSha256;node='24.22.0';bun='1.4.3';windows=$before.Caption;osVersion=$before.Version;totalMemoryMiB=$before.TotalVisibleMemorySize/1024;freeBeforeMiB=$before.FreePhysicalMemory/1024;cpu=$cpu;gpu=$gpu;serverPids=@($owners);browserPids=$browserIds;remainingKnownPids=$remaining;openPorts=$openPorts;cleanupConfirmed=($remaining.Count -eq 0 -and $openPorts.Count -eq 0);nativeMemoryAttributionQualified=$false;referencePcAcceptance=$false;hostedAcceptance=$false;audioAudibilityAccepted=$false;supervisorSha256=(Get-FileHash -LiteralPath $PSCommandPath -Algorithm SHA256).Hash.ToLowerInvariant()}\n[IO.File]::WriteAllText((Join-Path $output 'receipt.json'),($receipt|ConvertTo-Json -Depth 6),[Text.UTF8Encoding]::new($false))\n$child.Dispose()\n$receipt|ConvertTo-Json -Depth 6\nif($deadline -or $receipt.exitCode -ne 0 -or -not $receipt.cleanupConfirmed){exit 1}\n"
  },
  "limits": [
    "Local controlled browser fixture, not hosted user workflow",
    "16 GB Windows test machine, not the deferred 8 GB reference computer",
