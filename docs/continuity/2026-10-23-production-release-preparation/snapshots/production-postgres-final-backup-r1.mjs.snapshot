async function recoveryPath(path, exists) {
  check(isAbsolute(path), 'ABSOLUTE_RECOVERY_PATH_REQUIRED');
  const actual = exists ? await realpath(path) : join(await realpath(dirname(path)), path.split(/[\\/]/).at(-1));
  const rel = relative(PROJECTS, actual); check(rel.startsWith('..') || isAbsolute(rel), 'RECOVERY_PATH_INSIDE_CHECKOUT'); return actual;
}
export async function main(args = process.argv.slice(2)) {
  check(process.versions.node === '24.22.0' && !process.versions.bun && args.length === 6 && /^production-postgres-final-[a-z0-9-]{1,30}$/.test(args[0]), 'ARGUMENTS_OR_NODE_INVALID');
