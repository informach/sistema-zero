export function identityFromFile(bytes) {
  guard(bytes instanceof Uint8Array && bytes.byteLength > 0 && bytes.byteLength <= 8192, 'IDENTITY_FILE_SIZE')
  let text; try { text = new TextDecoder('utf-8', { fatal: true }).decode(bytes) } catch { throw new Refusal('IDENTITY_FILE_UTF8') }
