  guard(lines.length === 1, 'IDENTITY_FILE_CONTENT'); mutationRequest(lines[0]); return lines[0]
}
export async function consumeExistingIdentity(deps) {
  await deps.verifyAcl(); const identity = identityFromFile(await deps.read())
  guard((await deps.recipient(identity)).trim() === PINS.publicRecipient, 'IDENTITY_RECIPIENT_MISMATCH')
  return identity
}
export function assertAcl(value, directory = true) {
  guard(object(value) && typeof value.currentSid === 'string' && value.ownerSid === value.currentSid && (!directory || value.protected === true) && Array.isArray(value.rules) && value.rules.length > 0, 'ACL_INVALID')
