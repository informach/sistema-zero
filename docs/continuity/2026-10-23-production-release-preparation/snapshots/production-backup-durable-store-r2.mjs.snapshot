  guard(value.rules.every(r => allowed.has(r.sid) && r.type === 'Allow') && value.rules.some(r => r.sid === value.currentSid && (r.rights & 0x1f01ff) === 0x1f01ff), 'ACL_NOT_PRIVATE')
}
export function validateBucket(metadata, managed, custom, lifecycle) {
  guard(metadata?.name === PINS.bucket && managed?.enabled === false && Array.isArray(custom?.domains) && custom.domains.length === 0 && Array.isArray(lifecycle?.rules), 'BUCKET_NOT_PRIVATE')
