}
export function validateContext(reply) {
  const e = reply?.data?.environment, pending = reply?.data?.deployments
  guard(!reply?.errors && e?.id === PINS.environment && e.projectId === PINS.project && e.name === 'production' && e.serviceInstances?.pageInfo?.hasNextPage === false && Array.isArray(e.serviceInstances.edges) &&
    Array.isArray(pending?.edges) && pending.edges.length === 0 && pending.pageInfo?.hasNextPage === false, 'PRODUCTION_CONTEXT_INVALID')
  const rows = e.serviceInstances.edges.map(({ node: s }) => {
    guard(uuid(s?.serviceId) && s.environmentId === PINS.environment && Array.isArray(s.activeDeployments), 'SERVICE_CONTEXT_INVALID')
    const active = s.activeDeployments.map(d => { guard(uuid(d.id) && d.serviceId === s.serviceId && d.environmentId === PINS.environment && d.projectId === PINS.project && d.status === 'SUCCESS', 'ACTIVE_DEPLOYMENT_INVALID'); return d.id }).sort()
    guard(new Set(active).size === active.length && active.length <= 1, 'ACTIVE_DEPLOYMENT_AMBIGUOUS'); return { serviceId: s.serviceId, active }
  }).sort((a, b) => a.serviceId.localeCompare(b.serviceId))
  guard(rows.length > 0 && rows.length <= 100 && new Set(rows.map(r => r.serviceId)).size === rows.length, 'SERVICE_INVENTORY_INVALID'); return rows
}
export function assertNoReferences(maps, identity) {
  guard(Array.isArray(maps) && maps.length > 0, 'SERVICE_VARIABLES_MISSING')
  for (const m of maps) for (const value of [m.raw, m.rendered]) {
    guard(object(value) && Object.values(value).every(v => v === null || typeof v === 'string') && !own(value, PINS.key), 'IDENTITY_EXPOSED_TO_APPLICATION')
    guard(Object.values(value).every(v => typeof v !== 'string' || (!v.includes(PINS.key) && (!identity || !v.includes(identity)))), 'IDENTITY_REFERENCE_PRESENT')
  }
}
export function assertSharedReferences(shared, identity) {
  guard(Object.entries(shared).every(([key, value]) => key === PINS.key || typeof value !== 'string' || (!value.includes(PINS.key) && (!identity || !value.includes(identity)))), 'SHARED_REFERENCE_PRESENT')
}
export function assertUnchanged(before, after, identity) {
  guard(JSON.stringify(before.context) === JSON.stringify(after.context), 'DEPLOYMENTS_CHANGED')
  assertNoReferences(after.maps, identity)
  assertSharedReferences(after.shared, identity)
  guard(before.maps.length === after.maps.length && before.maps.every((v, i) => v.serviceId === after.maps[i].serviceId && sameMap(v.raw, after.maps[i].raw) && sameMap(v.rendered, after.maps[i].rendered)), 'APPLICATION_VARIABLES_CHANGED')
