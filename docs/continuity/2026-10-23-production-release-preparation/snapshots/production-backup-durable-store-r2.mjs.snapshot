  await deps.checkpoint({ acknowledged, state: acknowledged ? 'ACK_READBACK_PENDING' : 'ACK_UNKNOWN_READBACK_PENDING' })
  try { await deps.readback(); readbackMatched = true } catch { /* No replay or automatic repair. */ }
  const result = { state: acknowledged ? readbackMatched ? 'STORED_VERIFIED' : 'ACK_READBACK_UNCONFIRMED' : readbackMatched ? 'ACK_UNKNOWN_READBACK_MATCHED' : 'ACK_UNKNOWN_READBACK_UNCONFIRMED',
    acknowledged, readbackMatched, remoteOutcomeUnknown: !acknowledged }
  await deps.checkpoint(result); return acknowledged && readbackMatched
