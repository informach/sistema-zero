}
export async function reserve(directory, mode, record) {
  guard(['bucket', 'identity'].includes(mode), 'INTENT_OPERATION'); const h = await open(join(directory, `production-backup-store-${mode}.intent.json`), 'wx', 0o600)
  try { await h.writeFile(JSON.stringify(record) + '\n'); await h.sync() } finally { await h.close() }
}
export async function writeOnce(deps) {
