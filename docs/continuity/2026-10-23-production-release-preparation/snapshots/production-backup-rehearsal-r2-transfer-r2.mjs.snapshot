/** Private Root-only caller. Import is inert; fixed rehearsal, never the final fenced backup. */
import { execFile } from 'node:child_process'
import { createHash } from 'node:crypto'
import { lstat, mkdir, open, readFile, realpath, rename } from 'node:fs/promises'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { PINS as STORE, validateBucket, writeOnce } from './production-backup-durable-store-r2.mjs'
import { PINS as CF, boundedResponse, environmentFor } from './staging-reconcile-cron-activate-r2.mjs'
const FILE = fileURLToPath(import.meta.url), CACHE = dirname(FILE), ROOT = resolve(CACHE, '../..')
export const PINS = Object.freeze({ bucket: STORE.bucket, account: STORE.account, storeSha256: '219a4806e9f79839f131ef59e0874e390eba9df35f25fefb19fbd1badfc6bd0b',
  restoreReceipt: 'production-postgres-rehearsal-root-r1/receipt.json', restoreReceiptSha256: '3f8293eb899e5350cbd922257f01b211b956c564f1b072cffbbacfbb4ff7cbf9',
  ciphertextPath: join(STORE.identityDirectory, 'database-rehearsal-r1.dump.age'), ciphertextBytes: 2303491, ciphertextSha256: 'f23a35b1dfb7db5708d05464148a5a5801d3b7ca0a07d50e7b424e58c7b22c00' })
const sha = value => createHash('sha256').update(value).digest('hex')
class Refusal extends Error { constructor(code) { super(code); this.code = code } }
const guard = (ok, code) => { if (!ok) throw new Refusal(code) }
export const executionEnvironment = parent => ({ ...environmentFor(parent), WRANGLER_HIDE_BANNER: 'true' })
export function argumentsFor(argv) {
  guard(argv.length === 1 && /^production-backup-rehearsal-transfer-[a-z0-9-]+$/.test(argv[0]), 'ARGUMENTS')
  return { run: argv[0], key: `rehearsal/${argv[0]}/${PINS.ciphertextSha256}.dump.age`, download: join(STORE.identityDirectory, `${argv[0]}.download.dump.age`) }
}
export function validateRestore(value) {
  guard(value?.kind === 'production-postgres-logical-rehearsal' && value.state === 'LOCAL_LOGICAL_RESTORE_REHEARSAL_VERIFIED_NOT_FINAL_BACKUP' && value.restoreQualified === true && value.finalCiphertextVerified === true && value.finalPreMigrationBackup === false && value.productionWritersFenced === false, 'RESTORE_NOT_QUALIFIED')
  guard(resolve(value.ciphertextPath) === resolve(PINS.ciphertextPath) && value.verification?.authenticatedThroughEof === true && value.clone?.cleanup === 'OWN_CID_REMOVED_VERIFIED' && value.clone?.state === 'ISOLATED_CLONE_PROOF_PASSED', 'RESTORE_BINDING')
  for (const part of [value.capture?.ciphertext, value.verification?.ciphertext]) guard(part?.bytes === PINS.ciphertextBytes && part.sha256 === PINS.ciphertextSha256 && part.streamEnded === true, 'RESTORE_CIPHERTEXT_PIN')
  guard(value.restoreAttempt?.ciphertextSha256 === PINS.ciphertextSha256 && value.restoreAttempt.state === 'CONSUMED_AUTHENTICATED_ARCHIVE' && value.restoreAttempt.childExits?.length === 2 && value.restoreAttempt.childExits.every(v => v.exitCode === 0), 'RESTORE_CHILDREN')
}
const clean = value => value.toString('utf8').replace(/\x1b\[[0-9;]*m/g, '').trim()
export function missingObject(result) {
  // Wrangler4.120.1 handleError writes exactly one logger LF before the canonical error.
  const noObjectBytes = result.stdout.length === 0 || (result.stdout.length === 1 && result.stdout[0] === 0x0a)
  return result.code === 1 && noObjectBytes && /^(?:X|✘)?\s*\[ERROR\]\s+The specified key does not exist\.$/.test(clean(result.stderr))
}
export function catalogDisabled(result) {
  const lines = clean(result.stdout).split(/\r?\n/).map(v => v.trim()).filter(Boolean)
  return result.code === 0 && result.stderr.length === 0 && lines.length === 2 && lines[0] === `Getting data catalog status for '${PINS.bucket}'...` && lines[1] === `Data catalog is not enabled for bucket '${PINS.bucket}'. Please use 'wrangler r2 bucket catalog enable ${PINS.bucket}' to first enable the data catalog on this bucket.`
}
export function invocation(mode, args, empty) {
  const target = `${PINS.bucket}/${args.key}`, tail = ['--config', join(ROOT, STORE.config), '--env-file', empty]
  const action = mode === 'catalog' ? ['r2', 'bucket', 'catalog', 'get', PINS.bucket] : mode === 'get' ? ['r2', 'object', 'get', target, '--remote', '--pipe'] : mode === 'put' ? ['r2', 'object', 'put', target, '--remote', '--file', PINS.ciphertextPath, '--content-type', 'application/octet-stream', '--cache-control', 'no-store'] : mode === 'auth' ? ['auth', 'token', '--json'] : null
  guard(action, 'OPERATION'); return ['--no-warnings', join(ROOT, CF.cli), ...action, ...tail]
}
export async function reserve(directory, value) {
  const h = await open(join(directory, 'production-backup-rehearsal-r1-upload.intent.json'), 'wx', 0o600)
  try { await h.writeFile(JSON.stringify(value) + '\n'); await h.sync() } finally { await h.close() }
}
export async function downloadExclusive(path, receive, expected) {
  const h = await open(path, 'wx', 0o600)
  try {
    const bytes = await receive(); guard(bytes.length === expected.bytes && sha(bytes) === expected.sha256, 'DOWNLOADED_CIPHERTEXT_MISMATCH')
    await h.writeFile(bytes); await h.sync()
  } finally { await h.close() }
  const bytes = await readFile(path); guard(bytes.length === expected.bytes && sha(bytes) === expected.sha256, 'DOWNLOADED_FILE_MISMATCH')
  return { bytes: bytes.length, sha256: sha(bytes), exclusiveFile: true, synced: true }
}
export async function main(argv = process.argv.slice(2)) {
  const args = argumentsFor(argv); guard(process.versions.node === CF.node && !process.versions.bun && process.platform === 'win32', 'NODE_RUNTIME')
  const out = join(CACHE, args.run); await mkdir(out); const start = Date.now(), deadline = start + 300_000
  const receipt = { kind: 'production-rehearsal-ciphertext-r2-transfer', state: 'RUNNING', startedAt: new Date(start).toISOString(), sourceSha256: sha(await readFile(FILE)), pins: PINS, key: args.key,
    mutationAttempts: 0, putInvocations: 0, operatorRetries: 0, remoteOutcomeUnknown: false, ciphertextReadbackVerified: false, finalPreMigrationBackup: false, sourceWritersFenced: false,
    keyReads: 0, keyRotations: 0, sql: 0, ssh: 0, rawCliOutputRecorded: false, atomicCreateOnlyAvailable: false, externalConfigurationAndKeyExclusivityRequired: true, wranglerCatalogConflictRetryBranchPresent: true }
  const save = async patch => { Object.assign(receipt, patch); const h = await open(join(out, 'receipt.pending'), 'w', 0o600); try { await h.writeFile(JSON.stringify(receipt, null, 2) + '\n'); await h.sync() } finally { await h.close() }; await rename(join(out, 'receipt.pending'), join(out, 'receipt.json')) }
  const env = executionEnvironment(process.env)
  const command = (values, maxBuffer = 65536) => new Promise(resolveCommand => {
    guard(Date.now() < deadline, 'DEADLINE')
    const child = execFile(process.execPath, values, { cwd: out, env, windowsHide: true, shell: false, encoding: 'buffer', maxBuffer, timeout: Math.min(90_000, deadline - Date.now()) }, (error, stdout, stderr) => resolveCommand({ code: error?.code ?? 0, stdout, stderr }))
    child.stdin?.on('error', () => {}); child.stdin?.end()
  })
  let token
  try {
    await save({})
    for (const [path, expected] of [[FILE, receipt.sourceSha256], [join(ROOT, CF.cli), CF.cliSha], [join(ROOT, STORE.config), STORE.configSha], [join(CACHE, 'production-backup-durable-store-r2.mjs'), PINS.storeSha256], [join(CACHE, 'staging-reconcile-cron-activate-r2.mjs'), STORE.helperSha], [join(CACHE, PINS.restoreReceipt), PINS.restoreReceiptSha256]]) guard(sha(await readFile(path)) === expected, 'SOURCE_PIN')
    validateRestore(JSON.parse(await readFile(join(CACHE, PINS.restoreReceipt), 'utf8')))
    const checkCiphertext = async () => { const info = await lstat(PINS.ciphertextPath); guard(info.isFile() && !info.isSymbolicLink() && info.size === PINS.ciphertextBytes && resolve(await realpath(PINS.ciphertextPath)).toLowerCase() === resolve(PINS.ciphertextPath).toLowerCase(), 'CIPHERTEXT_PATH'); guard(sha(await readFile(PINS.ciphertextPath)) === PINS.ciphertextSha256, 'CIPHERTEXT_HASH') }
    await checkCiphertext()
    guard(resolve(await realpath(STORE.identityDirectory)).toLowerCase() === resolve(STORE.identityDirectory).toLowerCase(), 'DIRECTORY_ALIAS')
    const empty = join(out, 'empty-public.env'), h = await open(empty, 'wx', 0o600); await h.sync(); await h.close()
    const auth = await command(invocation('auth', args, empty)); guard(auth.code === 0, 'AUTH_UNCONFIRMED'); const credentials = JSON.parse(auth.stdout.toString('utf8')); guard(typeof credentials.token === 'string' && credentials.token.length >= 16, 'AUTH_SHAPE'); token = credentials.token; delete credentials.token
    const privateBucket = async () => {
      const values = []
      for (const suffix of ['', '/domains/managed', '/domains/custom', '/lifecycle']) {
        guard(Date.now() < deadline, 'DEADLINE'); const response = await fetch(`https://api.cloudflare.com/client/v4/accounts/${PINS.account}/r2/buckets/${PINS.bucket}${suffix}`, { redirect: 'error', headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(Math.min(15000, deadline - Date.now())) })
        if (response.status !== 200) { await response.body?.cancel(); throw new Refusal('BUCKET_READ_UNCONFIRMED') }
        const value = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(await boundedResponse(response, 1048576))); guard(value.success === true && Array.isArray(value.errors) && value.errors.length === 0, 'BUCKET_API_UNCONFIRMED'); values.push(value.result)
      }
      const projected = validateBucket(...values); guard(catalogDisabled(await command(invocation('catalog', args, empty))), 'CATALOG_DISABLED_UNCONFIRMED'); return projected
    }
    const result = await writeOnce({
      preflight: async () => { await save({ bucket: await privateBucket() }); guard(missingObject(await command(invocation('get', args, empty))), 'OBJECT_ABSENCE_UNCONFIRMED'); await checkCiphertext(); await save({ officialMissingObjectVerified: true, catalogDisabledBefore: true }) },
      reserve: () => reserve(CACHE, { kind: 'one-rehearsal-ciphertext-upload', key: args.key, bucket: PINS.bucket, restoreReceiptSha256: PINS.restoreReceiptSha256, ciphertextSha256: PINS.ciphertextSha256, run: args.run, at: new Date().toISOString() }),
      checkpoint: patch => save({ ...patch, putInvocations: patch.mutationAttempts ?? receipt.putInvocations }),
      send: async () => { const answer = await command(invocation('put', args, empty)); return answer.code === 0 && !/Data catalog is enabled|fallback value in non-interactive context/i.test(clean(answer.stdout)) },
      readback: async () => {
        const downloaded = await downloadExclusive(args.download, async () => { const v = await command(invocation('get', args, empty), PINS.ciphertextBytes + 65536); guard(v.code === 0 && v.stderr.length === 0, 'DOWNLOAD_UNCONFIRMED'); return v.stdout }, { bytes: PINS.ciphertextBytes, sha256: PINS.ciphertextSha256 })
        await checkCiphertext(); await save({ bucket: await privateBucket(), catalogDisabledAfter: true, downloaded, downloadPath: args.download, ciphertextReadbackVerified: true })
      } })
    if (result) await save({ state: 'CIPHERTEXT_UPLOAD_DOWNLOAD_VERIFIED_NOT_FINAL_BACKUP' })
    return result ? 0 : 1
  } catch (error) { await save({ state: receipt.mutationAttempts ? 'UPLOAD_OR_READBACK_UNCONFIRMED_NO_RETRY' : 'REFUSED_BEFORE_UPLOAD', failureCode: error instanceof Refusal ? error.code : 'LOCAL_OR_PROVIDER_UNCONFIRMED' }); return 1 }
  finally { token = undefined; await save({ finishedAt: new Date().toISOString(), durationMs: Date.now() - start }); console.log(JSON.stringify({ output: args.run, state: receipt.state, putInvocations: receipt.putInvocations, ciphertextReadbackVerified: receipt.ciphertextReadbackVerified, remoteOutcomeUnknown: receipt.remoteOutcomeUnknown })) }
}
if (process.argv[1] && resolve(process.argv[1]) === FILE) main().then(code => { process.exitCode = code }, () => { console.error('LOCAL_TRANSFER_UNCONFIRMED'); process.exitCode = 1 })
