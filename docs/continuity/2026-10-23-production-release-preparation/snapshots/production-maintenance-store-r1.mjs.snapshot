const FILE = fileURLToPath(import.meta.url), CACHE = dirname(FILE), ROOT = resolve(CACHE, '../..')
export const KEY = 'RELEASE_MAINTENANCE_MODE'
export const PINS = Object.freeze({ project: '415d5a1c-5f75-432c-8445-b395d0977ce3', environment: '19c212a5-85c0-493c-9630-a7a0569e8412', node: '24.22.0', railway: 'railway 5.62.1', phase: 'store-full-only',
