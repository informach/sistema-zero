import { execFile } from 'node:child_process'
import { createHash } from 'node:crypto'
import { open, readFile } from 'node:fs/promises'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

const FILE = fileURLToPath(import.meta.url), CACHE = dirname(FILE), ROOT = resolve(CACHE, '../..')
const project = '415d5a1c-5f75-432c-8445-b395d0977ce3', environment = '19c212a5-85c0-493c-9630-a7a0569e8412'
const priorName = 'production-pensa-writer-images-readonly-r2-final.json'
const priorSha = '309b0351b9853149947ce432fb615fdb01868054bc963c6fb61d0062fdbf86de'
const sha = bytes => createHash('sha256').update(bytes).digest('hex')
class Refusal extends Error { constructor(code) { super(code); this.code = code } }
const check = (condition, code) => { if (!condition) throw new Refusal(code) }
const object = value => value !== null && typeof value === 'object' && !Array.isArray(value)
const absent = value => value === null || value === undefined || value === '' || (Array.isArray(value) && value.length === 0)
const cli = join(process.env.APPDATA, 'npm/node_modules/@railway/cli/bin/railway.exe')
export function nativeEnvironment(source) {
  const env = { ...source, CI: 'true', NO_COLOR: '1' }
  for (const key of ['RAILWAY_TOKEN', 'RAILWAY_API_TOKEN', 'RAILWAY_PROJECT_TOKEN', 'RAILWAY_API']) delete env[key]
  return env
}
const env = nativeEnvironment(process.env)
let startedAt, deadline
let calls = 0
const native = (argv, input = '') => new Promise((accept, reject) => {
  check(Date.now() < deadline, 'READ_DEADLINE')
  const child = execFile(cli, argv, { cwd: ROOT, env, windowsHide: true, encoding: 'utf8', timeout: Math.min(20000, deadline - Date.now()), maxBuffer: 8388608 }, (error, stdout) => error ? reject(new Refusal('NATIVE_QUERY_UNCONFIRMED')) : accept(stdout))
  child.stdin?.on('error', () => {}); child.stdin?.end(input)
})
const fields = 'id projectId environmentId serviceId status deploymentStopped snapshotId meta'
const query = `query($e:String!,$s:String!,$input:DeploymentListInput!){serviceInstance(environmentId:$e,serviceId:$s){serviceId environmentId preDeployCommand startCommand resolvedFileConfig{deploymentId commitHash fileManifest}activeDeployments{${fields}}latestDeployment{${fields}}}deployments(first:20,input:$input){edges{node{id status}}pageInfo{hasNextPage}}}`
async function observe(target) {
  calls++
  const raw = JSON.parse(await native(['api', '--compact', query, '--variables', '@-'], JSON.stringify({ e: environment, s: target.serviceId, input: { projectId: project, environmentId: environment, serviceId: target.serviceId, status: { notIn: ['SUCCESS', 'FAILED', 'CRASHED', 'REMOVED', 'SKIPPED'] } } })))
  check(raw.data && !raw.errors, 'QUERY_UNCONFIRMED')
  const i = raw.data.serviceInstance, d = i?.latestDeployment, expected = target.before
  check(i?.serviceId === target.serviceId && i.environmentId === environment && d?.id === expected.deploymentId && d.projectId === project && d.environmentId === environment && d.serviceId === target.serviceId && d.status === 'SUCCESS' && d.deploymentStopped === false && d.meta?.commitHash === expected.commit && d.meta?.imageDigest === expected.imageDigest && d.snapshotId === expected.snapshotId, 'DEPLOYMENT_IDENTITY_CHANGED')
  check(i.activeDeployments?.length === 1 && i.activeDeployments[0].id === d.id && i.activeDeployments[0].status === 'SUCCESS' && raw.data.deployments?.edges?.length === 0 && raw.data.deployments.pageInfo?.hasNextPage === false, 'ACTIVE_OR_PENDING_CHANGED')
  const deployed = d.meta?.serviceManifest?.deploy, file = i.resolvedFileConfig
  check(object(deployed) && Object.hasOwn(deployed, 'preDeployCommand') && Object.hasOwn(deployed, 'startCommand') && object(file?.fileManifest) && file.deploymentId === d.id && file.commitHash === expected.commit && (file.fileManifest.deploy === undefined || object(file.fileManifest.deploy)), 'COMMAND_SOURCE_SHAPE_UNCONFIRMED')
  const projectCommand = key => ({ configuredAbsent: absent(i[key]), deploymentManifestAbsent: absent(deployed[key]), resolvedFileConfigAbsent: absent(file.fileManifest.deploy?.[key]) })
  return { deploymentId: d.id, snapshotId: d.snapshotId, commit: expected.commit, imageDigest: expected.imageDigest, uniqueSuccess: true, noPending: true, resolvedFileDeploymentMatches: true, resolvedFileCommitMatches: true, preDeploy: projectCommand('preDeployCommand'), startOverride: projectCommand('startCommand') }
}
async function collect() {
  startedAt = new Date().toISOString(); deadline = Date.now() + 90000; calls = 0
  check(process.versions.node === '24.22.0', 'NODE_VERSION')
  check((await native(['--version'])).trim() === 'railway 5.62.1', 'RAILWAY_VERSION')
  const originalBytes = await readFile(join(CACHE, priorName)); check(sha(originalBytes) === priorSha, 'PRIOR_RECEIPT_CHANGED')
  const prior = JSON.parse(originalBytes)
  check(prior.projectId === project && prior.environmentId === environment && prior.state === 'FIVE_ACTIVE_IMAGES_AND_INSTALLED_LAUNCHERS_VERIFIED', 'PRIOR_CONTEXT_INVALID')
  const targets = ['Admin', 'Adult', 'Kids'].map(name => { const values = prior.targets.filter(value => value.name === name); check(values.length === 1, 'TARGET_MISSING'); return values[0] })
  const receipt = { kind: 'production-next-predeploy-readonly', version: 1, startedAt, projectId: project, environmentId: environment, priorReceipt: { path: priorName, sha256: priorSha }, sourceSha256: sha(await readFile(FILE)), providerMutations: 0, sshCalls: 0, sqlCalls: 0, variablesQueried: false, commandValuesOrHashesRecorded: false, rawMetadataPersisted: false, maintenanceStarted: false, targets: [] }
  for (const target of targets) {
    const row = { name: target.name, serviceId: target.serviceId, state: 'READING' }; receipt.targets.push(row)
    try {
      row.before = await observe(target); row.after = await observe(target)
      check(JSON.stringify(row.before) === JSON.stringify(row.after), 'CONTEXT_CHANGED_DURING_READ')
      row.preDeployAbsent = Object.values(row.after.preDeploy).every(value => value === true)
      row.startOverrideAbsent = Object.values(row.after.startOverride).every(value => value === true)
      row.state = row.preDeployAbsent && row.startOverrideAbsent ? 'ABSENCE_COHERENT_UNIQUE_SUCCESS' : 'COMMAND_CONFIGURATION_MISMATCH'
    } catch (error) { row.state = 'READ_UNCONFIRMED'; row.failureCode = error instanceof Refusal ? error.code : 'SANITIZED_LOCAL_OR_PROVIDER_FAILURE' }
    console.log(JSON.stringify({ name: row.name, state: row.state, failureCode: row.failureCode ?? null }))
  }
  receipt.state = receipt.targets.every(row => row.state === 'ABSENCE_COHERENT_UNIQUE_SUCCESS') ? 'THREE_NEXT_PREDEPLOY_AND_START_OVERRIDES_ABSENT' : 'READ_HAS_MISMATCH_OR_UNCONFIRMED'
  Object.assign(receipt, { finishedAt: new Date().toISOString(), graphqlCalls: calls, maximumConcurrency: 1, limits: ['Only current declared configuration and exact active deployment manifests were read. No process argv or OCI image config was inspected.', 'This is a fresh observation, not maintenance activation, process retirement or a writer fence.', 'Absent preDeploy/start overrides were required in service configuration, deployment manifest and resolved file configuration. Any unexpected command is projected only as a mismatch boolean.'] })
  return receipt
}
export function outputFile(name) {
  check(/^production-next-predeploy-readonly-r2-[a-z0-9-]{1,50}\.json$/.test(name ?? ''), 'OUTPUT_NAME_INVALID')
  return join(CACHE, name)
}
export async function main(name) {
  const path = outputFile(name), handle = await open(path, 'wx', 0o600)
  try {
    const receipt = await collect()
    await handle.writeFile(JSON.stringify(receipt, null, 2) + '\n'); await handle.sync()
    console.log(JSON.stringify({ state: receipt.state, receiptSha256: sha(await readFile(path)), graphqlCalls: calls, providerMutations: 0 }))
    return receipt.state === 'THREE_NEXT_PREDEPLOY_AND_START_OVERRIDES_ABSENT' ? 0 : 1
  } finally { await handle.close() }
}
if (process.argv[1] && resolve(process.argv[1]) === FILE) {
  const task = process.argv.length === 3 ? main(process.argv[2]) : Promise.reject(new Refusal('ARGUMENTS'))
  task.then(code => { process.exitCode = code }, error => { console.error(error instanceof Refusal ? error.code : 'SANITIZED_READ_FAILURE'); process.exitCode = 1 })
}
