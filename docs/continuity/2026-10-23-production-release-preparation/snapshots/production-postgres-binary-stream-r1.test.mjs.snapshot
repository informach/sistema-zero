import test from 'node:test';
import assert from 'node:assert/strict';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { createHash } from 'node:crypto';
import { mkdtemp, writeFile, readFile, rm, lstat } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { dirname, join, resolve, relative } from 'node:path';
import { captureEncryptedDump, verifyEncryptedDump } from './production-postgres-binary-stream-r1.mjs';

// Real age, ephemeral TEST-ONLY identity in a private OS temp directory outside Git.
// No production key, pg_dump, DB, network, Docker, Railway or SSH invocation.
const AGE = join(process.env.LOCALAPPDATA, 'Microsoft/WinGet/Packages/FiloSottile.age_Microsoft.Winget.Source_8wekyb3d8bbwe/age/age.exe');
const AGE_SHA = '2821a4ed191da07372acd302e5f6feae7a7985e285e1417765ebe74025af45f0';
const KEYGEN_SHA = '1549c7049be32695594bedd09bbd352a94b6013a9d5c43364f3c6cd7a09ab61c';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const exec = promisify(execFile);
const common = { ageExe: AGE, ageSha256: AGE_SHA, timeoutMs: 3000, maxBytes: 1024 * 1024 };
function producer({ bytes = 262149, prefix = 'PGDMP', exit = 0, hang = false, stderrBytes = 0 } = {}) {
  const source = `
    if (process.stdin.isTTY || process.stdout.isTTY || process.stderr.isTTY) process.exit(86);
    const b = Buffer.alloc(${bytes}); for (let i=0;i<b.length;i++) b[i]=i%256;
    Buffer.from(${JSON.stringify(prefix)},'ascii').copy(b);
    if (${stderrBytes}>0) process.stderr.write(Buffer.alloc(${stderrBytes}, 83));
    const {once} = await import('node:events');
    for(let p=0;p<b.length;p+=997) if(!process.stdout.write(b.subarray(p,p+997))) await once(process.stdout,'drain');
    process.stdout.end();
    if (${hang}) setInterval(()=>{},1000); else process.exitCode=${exit};
  `;
  return { command: process.execPath, args: ['--input-type=module', '-e', source] };
}

await test('real binary/age transport, adversarial EOF, and exclusive artifacts', async t => {
  assert.equal(process.versions.node, '24.22.0');
  const base = resolve(tmpdir()), dir = await mkdtemp(join(base, 'sz-pg-binary-synthetic-'));
  let sequence = 0;
  const next = () => join(dir, `synthetic-${++sequence}.age`);
  const identityPath = join(dir, 'TEST-ONLY-EPHEMERAL-IDENTITY.txt');
  try {
    const keygen = join(dirname(AGE), 'age-keygen.exe');
    assert.equal(sha(await readFile(keygen)), KEYGEN_SHA, 'test keygen binary pin must match before invocation');
    let generated;
    try { generated = await exec(keygen, [], { encoding: 'buffer', windowsHide: true, timeout: 3000, maxBuffer: 4096 }); }
    catch { throw new Error('SYNTHETIC_KEYGEN_FAILED_RAW_OUTPUT_DISCARDED'); }
    const recipient = generated.stdout.toString('ascii').match(/^# public key: (age1[a-z0-9]+)$/m)?.[1];
    assert.ok(recipient, 'test identity must supply a recipient');
    await writeFile(identityPath, generated.stdout, { flag: 'wx', mode: 0o600 });
    generated.stdout.fill(0); generated.stderr.fill(0);
    const capture = (input = producer(), outputPath = next(), overrides = {}) =>
      captureEncryptedDump({ ...common, producer: input, recipient, outputPath, ...overrides });
    const verify = (inputPath, expected, overrides = {}) =>
      verifyEncryptedDump({ ...common, identityPath, inputPath, expected, ...overrides });

    let good, goodPath;
    await t.test('all 256 byte values survive fragmented non-TTY process pipes and real encryption', async () => {
      goodPath = next(); good = await capture(producer(), goodPath);
      assert.equal(good.state, 'ENCRYPTED_STREAM_CAPTURED_NOT_RESTORE_QUALIFIED');
      assert.equal(good.synced, true); assert.equal(good.transport.cleanup, 'OWNED_CHILD_HANDLES_CLOSED');
      assert.equal(good.transport.processes.length, 2);
      assert.ok(good.transport.processes.every(p => p.exitCode === 0 && p.closed && p.stderrBytes === 0));
      const synthetic = Buffer.alloc(262149); for (let i = 0; i < synthetic.length; i++) synthetic[i] = i % 256;
      Buffer.from('PGDMP').copy(synthetic);
      assert.equal(good.plaintext.bytes, synthetic.length); assert.equal(good.plaintext.sha256, sha(synthetic));
      assert.equal(good.ciphertext.sha256, sha(await readFile(goodPath)));
      const verified = await verify(goodPath, good);
      assert.equal(verified.state, 'AUTHENTICATED_BYTES_VERIFIED_NOT_RESTORE_QUALIFIED');
      assert.equal(verified.authenticatedThroughEof, true);
      assert.equal(verified.plaintext.sha256, good.plaintext.sha256);
      assert.equal(verified.formatVerified, false); assert.equal(verified.restoreQualified, false);
    });
    await t.test('truncated ciphertext emits partial plaintext but never qualifies', async () => {
      const bytes = await readFile(goodPath), path = next();
      await writeFile(path, bytes.subarray(0, bytes.length - 20), { flag: 'wx' });
      const result = await verify(path, good);
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.authenticatedThroughEof, false);
      assert.ok(result.plaintext.bytes > 0 && result.plaintext.bytes < good.plaintext.bytes);
      assert.ok(result.transport.processes.some(p => p.exitCode !== 0));
      assert.equal(result.restoreQualified, false);
    });
    await t.test('last ciphertext authentication tag mutation never qualifies after partial output', async () => {
      const bytes = await readFile(goodPath), path = next(); bytes[bytes.length - 1] ^= 1;
      await writeFile(path, bytes, { flag: 'wx' });
      const result = await verify(path, good);
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.authenticatedThroughEof, false);
      assert.ok(result.plaintext.bytes > 0); assert.equal(result.restoreQualified, false);
    });
    await t.test('valid decryption must also match expected plaintext and ciphertext exactly', async () => {
      const wrongPlain = structuredClone(good); wrongPlain.plaintext.sha256 = '0'.repeat(64);
      const a = await verify(goodPath, wrongPlain); assert.equal(a.failure, 'PLAINTEXT_MISMATCH');
      assert.equal(a.authenticatedThroughEof, false);
      const wrongCipher = structuredClone(good); wrongCipher.ciphertext.bytes++;
      const b = await verify(goodPath, wrongCipher); assert.equal(b.failure, 'CIPHERTEXT_MISMATCH');
      assert.equal(b.authenticatedThroughEof, false);
    });
    await t.test('producer exit failure is rejected even when a complete ciphertext was emitted', async () => {
      const path = next(), result = await capture(producer({ exit: 23 }), path);
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.failure, 'CHILD_EXIT_UNCONFIRMED');
      assert.equal(result.outputCreated, true); assert.ok((await lstat(path)).size > 0);
      assert.ok(result.transport.processes.some(p => p.role === 'producer' && p.exitCode === 23));
    });
    await t.test('text/relay status output and a short prefix cannot masquerade as a dump', async () => {
      const text = await capture(producer({ prefix: '{"ok"' }));
      assert.equal(text.state, 'UNQUALIFIED'); assert.equal(text.failure, 'PGDMP_PREFIX_MISSING');
      const short = await capture(producer({ bytes: 3 }));
      assert.equal(short.state, 'UNQUALIFIED'); assert.equal(short.failure, 'PGDMP_PREFIX_MISSING');
    });
    await t.test('PGDMP alone is explicitly not PostgreSQL format or restore qualification', async () => {
      const result = await capture(producer({ bytes: 5 }));
      assert.equal(result.state, 'ENCRYPTED_STREAM_CAPTURED_NOT_RESTORE_QUALIFIED');
      assert.equal(result.formatVerified, false); assert.equal(result.restoreQualified, false);
    });
    await t.test('exclusive output refuses overwrite without spawning or damaging prior bytes', async () => {
      const before = sha(await readFile(goodPath)), result = await capture(producer(), goodPath);
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.outputCreated, false);
      assert.equal(result.transport, undefined); assert.equal(sha(await readFile(goodPath)), before);
    });
    await t.test('size budget failure preserves an unqualified artifact', async () => {
      const path = next(), result = await capture(producer(), path, { maxBytes: 1000 });
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.failure, 'BYTE_LIMIT_EXCEEDED');
      assert.equal(result.outputCreated, true); assert.ok((await lstat(path)).isFile());
    });
    await t.test('unclosed producer times out and cannot claim descendant cleanup', async () => {
      const result = await capture(producer({ bytes: 100, hang: true }), next(), { timeoutMs: 250 });
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.failure, 'DEADLINE_EXCEEDED');
      assert.equal(result.transport.cleanup, 'UNCONFIRMED');
    });
    await t.test('stderr is bounded, counted, never copied into receipts', async () => {
      const result = await capture(producer({ stderrBytes: 70 * 1024 }));
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.failure, 'STDERR_LIMIT_EXCEEDED');
      assert.ok(result.transport.processes.some(p => p.stderrBytes > 64 * 1024));
      assert.ok(!JSON.stringify(result).includes('S'.repeat(30)));
    });
    await t.test('age binary drift fails before output creation and child invocation', async () => {
      const result = await capture(producer(), next(), { ageSha256: '0'.repeat(64) });
      assert.equal(result.state, 'UNQUALIFIED'); assert.equal(result.failure, 'AGE_PIN_CHANGED');
      assert.equal(result.outputCreated, false); assert.equal(result.transport, undefined);
    });
  } finally {
    const resolved = resolve(dir), child = relative(base, resolved);
    assert.ok(child.startsWith('sz-pg-binary-synthetic-') && !child.includes('..') && dirname(resolved) === base);
    await rm(resolved, { recursive: true });
    await assert.rejects(lstat(resolved), { code: 'ENOENT' });
  }
});
