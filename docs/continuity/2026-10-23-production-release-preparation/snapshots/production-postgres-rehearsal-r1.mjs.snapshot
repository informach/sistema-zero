const sha = bytes => createHash('sha256').update(bytes).digest('hex');
class Refusal extends Error { constructor(code) { super(code); this.code = code; } }
const check = (ok, code) => { if (!ok) throw new Refusal(code); };
const code = error => error instanceof Refusal ? error.code : 'REHEARSAL_UNCONFIRMED';
const PINS_LOCAL = {
  'production-postgres-binary-stream-r1.mjs': '50307de586dd01b06d312cbfe78d382ef094eee6613be7e77e657f18cd8d0b08',
  'production-postgres-execution-preflight-r1.mjs': 'f0502c6ccea1598468df94a08bb825fdb551ac7b817cd67f324b9a856bd4bab7',
