const absent = x => x === undefined || x === null || x === '' || (Array.isArray(x) && !x.length)
function commandEquals(x, expected) { return expected === null ? absent(x) : x === expected || (Array.isArray(x) && x.length === 1 && x[0] === expected) }
function deployment(raw, service) {
  const t = SERVICES[service]
