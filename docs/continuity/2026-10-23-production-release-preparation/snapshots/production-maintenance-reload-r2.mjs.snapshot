export function validateHttp(p, service, candidate, now = Date.now()) {
  guard(p?.kind === 'production-maintenance-http' && p.version === 1 && p.state === 'LOCAL_FULL_HTTP_VERIFIED' && p.operatorSha256 === PINS.httpSha256 && p.remoteProgramSha256 === PINS.remoteHttpSha256 && p.projectId === PINS.project && p.environmentId === PINS.environment && p.service === service && p.serviceId === SERVICES[service].id && same(p.candidate, candidate) && p.identityVerified === true && p.ready === true && p.blocked === true && p.providerMutations === 0, 'HTTP_PROOF_UNQUALIFIED')
