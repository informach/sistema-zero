const fields = 'id projectId environmentId serviceId createdAt status deploymentStopped canRedeploy snapshotId meta instances{id status}'
const contextQuery = `query($e:String!,${names.map((_, i) => `$i${i}:DeploymentListInput!`).join(',')}){${names.map((s, i) => `s${i}:serviceInstance(serviceId:"${SERVICES[s].id}",environmentId:$e){serviceId environmentId preDeployCommand startCommand resolvedFileConfig{deploymentId commitHash fileManifest}activeDeployments{${fields}}latestDeployment{${fields}}}p${i}:deployments(first:20,input:$i${i}){edges{node{${fields}}}pageInfo{hasNextPage}}o${i}:deployment(id:"${SERVICES[s].deployment}"){${fields}}`).join('\n')}}`
const contextVars = { e: PINS.environment, ...Object.fromEntries(names.map((s, i) => [`i${i}`, { projectId: PINS.project, environmentId: PINS.environment, serviceId: SERVICES[s].id, status: { notIn: ['SUCCESS', 'FAILED', 'CRASHED', 'REMOVED', 'SKIPPED'] } }])) }
export function nativeEnvironment(source) {
  const env = { ...source, CI: 'true', NO_COLOR: '1' }
  for (const key of ['RAILWAY_TOKEN', 'RAILWAY_API_TOKEN', 'RAILWAY_PROJECT_TOKEN', 'RAILWAY_API']) delete env[key]
  return env
}
export async function main(argv = process.argv.slice(2)) {
  const args = argumentsFor(argv); guard(process.versions.node === '24.22.0' && !process.versions.bun, 'NODE_VERSION')
  const out = join(CACHE, args.run); await mkdir(out)
  const start = Date.now(), deadline = start + LIMITS.operationMs, operatorSha = sha(await readFile(FILE))
  const receipt = { kind: 'production-maintenance-reload', version: 1, mode: args.mode, service: args.service,
    projectId: PINS.project, environmentId: PINS.environment, state: 'PREPARING', startedAt: new Date(start).toISOString(),
    operatorSha256: operatorSha, pins: PINS, mutationAttempts: 0, remoteOutcomeUnknown: false,
    noBuildProven: false, skipPreDeployProven: false, sqlNotExecutedByProviderProven: false,
    appDataOrSecretsRecorded: false, crossProcessSecretEqualityProven: false, publicEdgeQualified: false, retries: 0, rollbacks: 0 }
  const save = async patch => { Object.assign(receipt, patch); const h = await open(join(out, 'receipt.tmp'), 'w', 0o600); try { await h.writeFile(JSON.stringify(receipt, null, 2) + '\n'); await h.sync() } finally { await h.close() } await rename(join(out, 'receipt.tmp'), join(out, 'receipt.json')) }
  const cli = join(process.env.APPDATA, 'npm/node_modules/@railway/cli/bin/railway.exe')
