const FILE = fileURLToPath(import.meta.url), CACHE = dirname(FILE), ROOT = resolve(CACHE, '../..')
const KEY = 'RELEASE_MAINTENANCE_MODE', names = Object.keys(SERVICES)
const sha = x => createHash('sha256').update(x).digest('hex')
