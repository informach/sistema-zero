export function mutationRequest(service) { guard(ORDER.includes(service), 'SERVICE_INVALID'); return { query: 'mutation OldImageFullMaintenance($id:String!){deploymentRedeploy(id:$id,usePreviousImageTag:true){id status snapshotId}}', variables: { id: SERVICES[service].deployment } } }
export function acknowledge(value, service) {
