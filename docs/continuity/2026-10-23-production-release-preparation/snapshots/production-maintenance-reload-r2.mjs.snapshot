function allFull(maps) { validateMaps(maps); for (const service of names) guard(maps[service].declared[KEY] === 'full' && maps[service].rendered[KEY] === 'full', 'FULL_NOT_STORED_ON_ALL_FIVE') }
export function compareSnapshot(snapshot, expected, declared, services) {
