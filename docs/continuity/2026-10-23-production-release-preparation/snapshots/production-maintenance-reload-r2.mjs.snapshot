  const native = (argv, stdin = '') => new Promise((yes, no) => { guard(Date.now() < deadline, 'DEADLINE'); const child = execFile(cli, argv, { cwd: ROOT, env, windowsHide: true, encoding: 'utf8', timeout: Math.min(LIMITS.commandMs, deadline - Date.now()), maxBuffer: LIMITS.bytes }, (e, stdout) => e ? no(new Refusal('CLI_UNCONFIRMED')) : yes(stdout)); child.stdin?.on('error', () => {}); child.stdin?.end(stdin) })
  const api = async (q, v) => { guard(/^query\b/.test(q) && !/\bmutation\b/.test(q), 'QUERY_REQUIRED'); const r = JSON.parse(await native(['api', '--compact', q, '--variables', '@-'], JSON.stringify(v))); guard(r.data && !r.errors, 'API_UNCONFIRMED'); return r.data }
  const context = async () => projectContext(await api(contextQuery, contextVars))
  const allMaps = []
  const configuration = async () => {
    const raw = await api(`query($p:String!,$e:String!){${names.map((s, i) => `d${i}:variables(projectId:$p,environmentId:$e,serviceId:"${SERVICES[s].id}",unrendered:true)r${i}:variablesForServiceDeployment(projectId:$p,environmentId:$e,serviceId:"${SERVICES[s].id}")`).join('\n')}}`, { p: PINS.project, e: PINS.environment })
    const maps = Object.fromEntries(names.map((s, i) => [s, { declared: raw[`d${i}`], rendered: raw[`r${i}`] }]))
    allMaps.push(maps); allFull(maps)
    const services = projectServices(await api('query($p:String!){project(id:$p){id services(first:50){edges{node{id name projectId deletedAt}}pageInfo{hasNextPage}}}}', { p: PINS.project }))
    // Refuse unsupported authoring expressions before a reload, not only after snapshot creation.
    for (const s of names) for (const value of Object.values(maps[s].declared)) declaredValue(value, services)
    return { maps, services }
  }
  const snapshot = async d => (await api('query($d:String!){deploymentSnapshot(deploymentId:$d){id variables}}', { d })).deploymentSnapshot
  try {
    await save({})
    for (const [file, expected] of [['production-maintenance-store-r1.mjs', PINS.storeSha256], ['staging-members-image-reload-r1.mjs', PINS.referenceHelperSha256], ['production-maintenance-http-r2.mjs', PINS.httpSha256]]) guard(sha(await readFile(join(CACHE, file))) === expected, 'IMPORT_PIN_CHANGED')
    const inputRef = { path: args.input.replaceAll('\\', '/'), sha256: args.expected }, input = await readPinned(inputRef)
    let planRef = inputRef
    if (args.mode !== 'check') {
      guard(input.kind === receipt.kind && input.version === 1 && input.service === args.service && input.operatorSha256 === operatorSha && input.projectId === PINS.project && input.environmentId === PINS.environment && reference(input.plan), 'PRIOR_RECEIPT_INVALID')
      if (args.mode === 'apply') { guard(input.mode === 'check' && input.state === 'READ_ONLY_READY' && input.mutationAttempts === 0, 'CHECK_INVALID'); fresh(input.finishedAt, LIMITS.checkMs, Date.now(), 'CHECK_STALE') }
      else if (args.mode === 'verify') guard(input.mode === 'apply' && input.state === 'IMAGE_AND_RETIREMENT_VERIFIED_HTTP_REQUIRED' && input.remoteOutcomeUnknown === false && input.acknowledged === true && input.variablesPreserved === true && input.imageVerified === true && input.oldRetired === true && input.snapshotVerified === true && input.mutationAttempts === 1, 'APPLY_NOT_QUALIFIED')
      else guard(input.mode === 'apply' && input.mutationAttempts === 1 && input.remoteOutcomeUnknown === true && Number.isFinite(Date.parse(input.dispatchStartedAt)), 'UNKNOWN_APPLY_REQUIRED')
      planRef = input.plan
    }
    const plan = args.mode === 'check' ? input : await readPinned(planRef)
    // After dispatch, verify may outlive the plan; it cannot cause another mutation.
    const observationOnly = ['verify', 'diagnose'].includes(args.mode)
    validatePlan(plan, args.service, observationOnly ? Date.parse(input.startedAt) : Date.now())
    await readPinned(plan.maintenancePlan, true)
    const evidence = Object.fromEntries(await Promise.all(Object.entries(plan.evidence).map(async ([k, r]) => [k, await readPinned(r)])))
    // The pinned image proofs attest immutable old artifacts. Their original observation window stays explicit.
    validateEvidence(evidence, Math.max(...Object.values(evidence).map(p => Date.parse(p.finishedAt))))
    const journal = plan.journalReadback === null ? null : await readPinned(plan.journalReadback)
    validateJournalReadback(journal, args.service, observationOnly ? Date.parse(input.startedAt) : Date.now())
    const phase1 = Object.fromEntries(await Promise.all(Object.entries(plan.phase1).map(async ([k, r]) => [k, await readPinned(r)]))); validatePhase1(phase1)
    const previous = Object.fromEntries(await Promise.all(Object.entries(plan.previous).map(async ([k, r]) => [k, await readPinned(r)]))); validatePrevious(previous, args.service, operatorSha)
    receipt.plan = planRef; receipt.predecessors = plan.previous
    guard((await native(['--version'])).trim() === 'railway 5.62.1', 'CLI_VERSION')
    const preflight = async () => {
      validatePlan(plan, args.service); validateJournalReadback(journal, args.service)
      const before = await context(); baselineContext(before, args.service, previous)
      const config = await configuration(), after = await context(); guard(same(before, after), 'CONTEXT_CHANGED_DURING_PREFLIGHT')
      if (args.mode === 'apply') guard(same(input.baselineContext, after), 'CONTEXT_CHANGED_SINCE_CHECK')
      for (const [s, p] of Object.entries(previous)) compareSnapshot(await snapshot(p.candidate.id), p.candidate.snapshotId, config.maps[s].declared, config.services)
      const finalConfig = await configuration(); preserveMaps(config.maps, finalConfig.maps, args.service); guard(same(config.services, finalConfig.services), 'REFERENCE_MAP_CHANGED')
      const finalContext = await context(); baselineContext(finalContext, args.service, previous); guard(same(after, finalContext), 'FINAL_PREFLIGHT_CONTEXT_CHANGED')
      await save({ baselineContext: finalContext, fullStoredOnFive: true, imageEvidence: plan.evidence, phase1Receipts: plan.phase1 })
      return { ...finalConfig, context: finalContext }
    }
    if (args.mode === 'diagnose') {
      const c = await context(), selected = c[args.service], since = Date.parse(input.dispatchStartedAt) - 5000
      const candidates = [selected.latest, ...selected.active, ...selected.pending].filter((d, i, rows) => d.id !== SERVICES[args.service].deployment && Date.parse(d.createdAt) >= since && rows.findIndex(x => x.id === d.id) === i)
      await save({ state: 'ACK_UNKNOWN_DIAGNOSTIC_ONLY', unknownApplyReceipt: inputRef, remoteOutcomeUnknown: true,
        observedContext: c, candidatesSinceIntent: candidates, observedAt: new Date().toISOString(), qualified: false })
    } else if (args.mode === 'check') {
      const a = await preflight(), b = await preflight(); preserveMaps(a.maps, b.maps, args.service); guard(same(a.services, b.services), 'REFERENCE_MAP_CHANGED')
      await save({ state: 'READ_ONLY_READY', mapsStableWithinCheck: true })
    } else if (args.mode === 'apply') {
      await reloadOnce(args.service, previous, { preflight, context, configuration, snapshot, now: Date.now,
        wait: ms => new Promise(r => setTimeout(r, ms)), checkpoint: save,
        reserve: async () => { validatePlan(plan, args.service); validateJournalReadback(journal, args.service); await reserveIntent(CACHE, args.service, { kind: 'production-maintenance-reload-intent', projectId: PINS.project, environmentId: PINS.environment, service: args.service, oldDeployment: SERVICES[args.service].deployment, operatorSha256: operatorSha, checkReceipt: inputRef, plan: planRef, createdAt: new Date().toISOString(), retryAllowed: false }) },
        send: async r => JSON.parse(await native(['api', '--compact', r.query, '--variables', '@-'], JSON.stringify(r.variables))), diagnose: context })
    } else {
      const httpRef = { path: args.httpPath.replaceAll('\\', '/'), sha256: args.httpHash }, http = await readPinned(httpRef)
      validateHttp(http, args.service, input.candidate)
      guard(same(http.reloadReceipt, inputRef), 'HTTP_RECEIPT_NOT_BOUND_TO_APPLY')
      const c = await context(); stable(c[args.service], args.service, input.candidate)
      for (const s of ORDER.filter(s => s !== args.service)) stable(c[s], s, previous[s]?.candidate ?? { id: SERVICES[s].deployment, snapshotId: SERVICES[s].snapshot }, !previous[s])
      const conf = await configuration(); compareSnapshot(await snapshot(input.candidate.id), input.candidate.snapshotId, conf.maps[args.service].declared, conf.services)
      const afterConf = await configuration(); preserveMaps(conf.maps, afterConf.maps, args.service); guard(same(conf.services, afterConf.services), 'REFERENCE_MAP_CHANGED')
      const final = await context(); guard(same(c, final), 'VERIFY_CONTEXT_CHANGED'); validateHttp(http, args.service, input.candidate)
      await save({ state: 'OLD_IMAGE_FULL_MAINTENANCE_VERIFIED', candidate: final[args.service].latest,
        applyReceipt: inputRef, httpReceipt: httpRef, imageVerified: true, oldRetired: true, snapshotVerified: true, fullHttpVerified: true,
        finalContext: final, qualified: true })
    }
  } catch (e) { await save({ state: receipt.mutationAttempts ? 'RELOAD_UNCONFIRMED_NO_REPLAY' : 'REFUSED_BEFORE_MUTATION', failureCode: e instanceof Refusal ? e.code : 'LOCAL_OR_PROVIDER_UNCONFIRMED', qualified: false }) }
  finally { for (const maps of allMaps) for (const entry of Object.values(maps)) for (const values of Object.values(entry)) if (obj(values)) for (const k of Object.keys(values)) delete values[k]; await save({ finishedAt: new Date().toISOString() }) }
  console.log(JSON.stringify({ output: args.run, service: args.service, state: receipt.state, mutationAttempts: receipt.mutationAttempts, remoteOutcomeUnknown: receipt.remoteOutcomeUnknown }))
  return ['READ_ONLY_READY', 'IMAGE_AND_RETIREMENT_VERIFIED_HTTP_REQUIRED', 'OLD_IMAGE_FULL_MAINTENANCE_VERIFIED'].includes(receipt.state) ? 0 : 1
}
if (process.argv[1] && resolve(process.argv[1]) === FILE) main().then(code => { process.exitCode = code }, () => { console.error('LOCAL_INITIALIZATION_OR_RECEIPT_UNCONFIRMED'); process.exitCode = 1 })
