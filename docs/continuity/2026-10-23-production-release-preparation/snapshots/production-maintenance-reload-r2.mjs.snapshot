}
export function validateJournalReadback(proof, service, now = Date.now()) {
  if (!['hub', 'members'].includes(service)) { guard(proof === null, 'UNEXPECTED_JOURNAL_READBACK'); return }
  validateJournalAge(proof, service, now)
  guard(proof?.kind === 'production-old-image-migration-readonly' && proof.version === 1 && proof.state === 'BOTH_OLD_IMAGE_JOURNALS_MATCH_DATABASE' && proof.projectId === PINS.project && proof.environmentId === PINS.environment && proof.mutations === 0 && proof.migratorExecuted === false && proof.appImported === false && Array.isArray(proof.targets), 'JOURNAL_READBACK_INVALID')
  const rows = proof.targets.filter(x => x.name === service), t = SERVICES[service], row = rows[0]
