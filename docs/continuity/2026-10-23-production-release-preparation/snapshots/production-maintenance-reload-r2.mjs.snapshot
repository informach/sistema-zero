function retired(c, t) { return c.old.id === t.deployment && c.old.status === 'REMOVED' && c.old.stopped === true && !c.active.some(x => x.id === t.deployment) && c.old.instances.length > 0 && c.old.instances.every(x => x.status === 'REMOVED') }
export function baselineContext(context, selected, previous) {
  for (const service of ORDER) stable(context[service], service, previous[service]?.candidate ?? { id: SERVICES[service].deployment, snapshotId: SERVICES[service].snapshot }, !previous[service])
}
export function evaluate(c, service, ack) {
