      "content": {
        "kind": "interactive",
        "required": true,
        "title": "Como escolher um lugar para a chave",
        "semPerguntaFinal": true,
        "instructions": "Clique no número de Posição horizontal x, apague o 211, escreva 160 e clique fora do campo. Observe para onde a chave foi. Depois, sem mexer no x, faça o mesmo em Posição vertical y: troque 53 por 250 e clique fora do campo. Compare as duas mudanças. Se quiser repetir, clique em Recomeçar.",
        "hints": [],
        "activity": {
          "type": "experimentation",
          "scene": "lighthouse-position",
          "cenario": "farol",
          "setup": {
            "goals": ["mover-horizontal", "mover-vertical"]
          }
        }
      }
    }
