            "id": "direcional",
            "label": "Em Ao iniciar, use Ativar controles clássicos com só as quatro direções.",
            "rule": {
              "type": "usesBlock",
              "blockType": "sz_g2d_enable_classic_controls",
              "area": "start",
              "fields": {
                "MODE": "directions"
              }
            }
          },
          {
            "id": "andar",
            "label": "Dentro de A cada quadro do jogo, mova o personagem.",
            "rule": {
              "type": "usesBlock",
              "blockType": "sz_g2d_update_each_frame",
              "area": "loops",
              "inputBlocks": {
                "BODY": {
                  "blockType": "sz_g2d_top_down",
                  "fields": {
                    "SPRITE": "personagem"
                  }
                }
              }
            }
          },
          {
            "id": "andar-cima",
            "label": "Com a seta para cima, o personagem sobe.",
            "rule": {
              "type": "behavior",
              "observation": {
                "type": "idleBeforeAction",
                "idleMs": 80
              },
              "steps": [
                {
                  "action": "press",
                  "key": "ArrowUp",
                  "holdMs": 80
                }
              ],
              "expect": {
                "target": {
                  "kind": "spritePosition",
