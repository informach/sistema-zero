{"formatVersion":2,"projectTools":["sz_frame_events","sz_frame_loops","sz_frame_start","sz_g3d_animate","sz_g3d_camera_look_at","sz_g3d_create_fullscreen_scene","sz_g3d_create_group","sz_g3d_create_model","sz_g3d_create_model_file","sz_g3d_dt","sz_g3d_for_each_in_group","sz_g3d_hud_text","sz_g3d_key_down","sz_g3d_on_key","sz_g3d_play_note","sz_g3d_set_camera","sz_g3d_set_fog","sz_g3d_set_position","sz_g3d_set_screen_text","sz_g3d_set_sky","sz_g3d_set_velocity","sz_g3d_set_visible","sz_g3d_spawn_copy","sz_g3d_update_group_no_gravity","sz_js_if_else","sz_js_var_assign","sz_js_var_create","sz_math_arithmetic","sz_val_bool","sz_val_compare","sz_val_number","sz_val_text","sz_val_variable"],"id":"construtor-patrulha-espacial-disparo","name":"Patrulha Espacial | disparo","createdAt":1795532400000,"updatedAt":1795532400000,"mode":"blocks","files":{"index.html":"<!doctype html>\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Patrulha Espacial | disparo</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n","style.css":"","script.js":"SZGame3D.runProject(function __szProjectRun() {\n  const __szProjectRunContext = window.__SZProjectLifecycle.begin(() => SZGame3D.restart());\n  // Ao iniciar\n  const cena = SZGame3D.createFullscreenScene(\"#020617\");\n  SZGame3D.setSky(cena, \"#020617\", \"#312e81\");\n  SZGame3D.setFog(cena, \"#0b1030\", 30, 75);\n  SZGame3D.setCameraPosition(cena, 0, 8, 12);\n  const cenario = SZGame3D.createModelFile(cena, \"cenario-orbita\", 180);\n  const alvoCamera = SZGame3D.createModel(cena);\n  SZGame3D.setPosition(alvoCamera, 0, 1, -12);\n  SZGame3D.cameraLookAt(cena, alvoCamera);\n  const nave = SZGame3D.createModelFile(cena, \"nave-falcao-azul\", 3);\n  SZGame3D.setPosition(nave, 0, 1, 0);\n  const moldeAsteroide = SZGame3D.createModelFile(cena, \"asteroide-rocha-lunar\", 1.8);\n  SZGame3D.setVisible(moldeAsteroide, \"hide\");\n  const moldeTiro = SZGame3D.createModelFile(cena, \"laser-ciano\", 0.9);\n  SZGame3D.setVisible(moldeTiro, \"hide\");\n  const tiros = SZGame3D.createGroup();\n  const asteroides = SZGame3D.createGroup();\n  let naveX = 0;\n  let alvoAtivo = true;\n  let velocidadeTiros = 0;\n  let velocidadeAsteroides = 0;\n  let estado = \"inicio\";\n  SZGame3D.setScreenText(\"fim\", \"Vamos tentar outra vez?\", \"Sua nave pode abrir esta rota. Volte ao início para uma nova patrulha.\", \"Voltar ao início\");\n  SZGame3D.setScreenText(\"vitoria\", \"Rota liberada!\", \"Você abriu passagem por 20 asteroides. A patrulha pode continuar!\", \"Voltar ao início\");\n  SZGame3D.hudText(\"top-center\", \"PATRULHA ESPACIAL | Projeto inicial\");\n  SZGame3D.hudText(\"bottom-center\", \"ENTER: começar | SETAS: mover\");\n  // Quando acontecer\n  SZGame3D.onKey(\"Enter\", () => {\n    if (estado === \"inicio\") {\n      estado = \"jogando\";\n      SZGame3D.hudText(\"top-center\", \"PATRULHA ESPACIAL | Conheça a nave\");\n      SZGame3D.hudText(\"bottom-center\", \"SETAS: mover | Tiros, asteroides e regras serão construídos nas aulas.\");\n    }\n  });\n  SZGame3D.onKey(\"Space\", () => {\n    if (estado === \"jogando\") {\n      SZGame3D.spawnCopy(tiros, moldeTiro, 0, 1, -1.6);\n      SZGame3D.playNote(880, 60);\n    }\n  });\n  // Enquanto estiver rodando\n  SZGame3D.animate(cena, () => {\n    if (estado === \"jogando\") {\n      if (SZGame3D.keyDown(\"ArrowLeft\")) {\n        naveX = naveX - 7 * SZGame3D.dt(cena);\n      }\n      if (SZGame3D.keyDown(\"ArrowRight\")) {\n        naveX = naveX + 7 * SZGame3D.dt(cena);\n      }\n      if (naveX < -5.2) {\n        naveX = -5.2;\n      }\n      if (naveX > 5.2) {\n        naveX = 5.2;\n      }\n      SZGame3D.setPosition(nave, naveX, 1, 0);\n      SZGame3D.forEachInGroup(tiros, (tiro) => {\n        SZGame3D.setVelocity(tiro, 0, 0, velocidadeTiros);\n      });\n      SZGame3D.updateGroupNoGravity(tiros);\n      SZGame3D.forEachInGroup(asteroides, (asteroide) => {\n        SZGame3D.setVelocity(asteroide, 0, 0, velocidadeAsteroides);\n      });\n      SZGame3D.updateGroupNoGravity(asteroides);\n      SZGame3D.forEachInGroup(asteroides, (asteroide) => {\n        alvoAtivo = true;\n        SZGame3D.forEachInGroup(tiros, (tiro) => {\n          if (alvoAtivo) {\n\n          }\n        });\n      });\n    }\n  });\n});\n"},"extraFiles":[],"assets":[{"id":"construtor-espaco-nave-falcao-azul","name":"nave-falcao-azul","kind":"model3d","source":"library","libId":"modelo-curso:032cb675aa1bd8b543a76ac6d792a97d4248c190d24c839859752bd3374ddad4","originalFileName":"nave-falcao-azul.glb","dataUrl":"data:model/gltf-binary;base64,Z2xURgIAAADMAAAAuAAAAEpTT057ImFzc2V0Ijp7InZlcnNpb24iOiIyLjAiLCJnZW5lcmF0b3IiOiJTaXN0ZW1hIFplcm8iLCJleHRyYXMiOnsic3pNb2RlbG9DdXJzbyI6IjAzMmNiNjc1YWExYmQ4YjU0M2E3NmFjNmQ3OTJhOTdkNDI0OGMxOTBkMjRjODM5ODU5NzUyYmQzMzc0ZGRhZDQifX0sInNjZW5lIjowLCJzY2VuZXMiOlt7Im5vZGVzIjpbXX1dfSAg"},{"id":"construtor-espaco-nave-exploradora-coral","name":"nave-exploradora-coral","kind":"model3d","source":"library","libId":"modelo-curso:a229f25ffe0e57d7fcc119f4f9775ea227df9f2dc66e91db16689859f51ebf03","originalFileName":"nave-exploradora-coral.glb","dataUrl":"data:model/gltf-binary;base64,Z2xURgIAAADMAAAAuAAAAEpTT057ImFzc2V0Ijp7InZlcnNpb24iOiIyLjAiLCJnZW5lcmF0b3IiOiJTaXN0ZW1hIFplcm8iLCJleHRyYXMiOnsic3pNb2RlbG9DdXJzbyI6ImEyMjlmMjVmZmUwZTU3ZDdmY2MxMTlmNGY5Nzc1ZWEyMjdkZjlmMmRjNjZlOTFkYjE2Njg5ODU5ZjUxZWJmMDMifX0sInNjZW5lIjowLCJzY2VuZXMiOlt7Im5vZGVzIjpbXX1dfSAg"},{"id":"construtor-espaco-nave-arraia-lilas","name":"nave-arraia-lilas","kind":"model3d","source":"library","libId":"modelo-curso:d5f59b23586f2f1131a765e88e4a8aea18d515dadde8f0df29844b2b48aebe63","originalFileName":"nave-arraia-lilas.glb","dataUrl":"data:model/gltf-binary;base64,Z2xURgIAAADMAAAAuAAAAEpTT057ImFzc2V0Ijp7InZlcnNpb24iOiIyLjAiLCJnZW5lcmF0b3IiOiJTaXN0ZW1hIFplcm8iLCJleHRyYXMiOnsic3p