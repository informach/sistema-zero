            "index.html": "<!doctype html>\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Nave contra Asteroides</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
            "style.css": "",
            "script.js": "SZGame2D.onStart(function __szProjectRun() {\n  const __szProjectRunContext = window.__SZProjectLifecycle.begin(() => SZGame2D.restart());\n  // Ao iniciar\n  SZGame2D.setupStage(800, 480, \"#07162e\");\n  const nave = SZGame2D.createShip({ x: 400, y: 410, w: 54, h: 62, body: \"#35e8ff\", wings: \"#2568ff\" });\n  const tiros = SZGame2D.createGroup();\n  const asteroides = SZGame2D.createGroup();\n  // Quando acontecer\n  SZGame2D.onKey(\"Space\", () => {\n    SZGame2D.spawnBullet(tiros, { x: SZGame2D.centerX(nave), y: SZGame2D.spriteY(nave), radius: 5, color: \"#9cff57\", vx: 0, vy: -9 });\n    SZGame2D.playFx(\"shoot\");\n  }, \"nave-ref-40\");\n  // Enquanto estiver rodando\n  // O jogo roda 60 passos por segundo: cada volta desenha um \"quadro\" do filme.\n  SZGame2D.gameLoop(function update() {\n    SZGame2D.clear();\n    SZGame2D.drawStarfield(ctx, 1);\n    SZGame2D.arrowsX(nave, 7);\n    SZGame2D.clampToScreen(nave, ctx);\n    SZGame2D.drawSprite(ctx, nave);\n    SZGame2D.updateGroup(tiros);\n    SZGame2D.pruneOffscreen(ctx, tiros, 40, (sprite) => {\n\n    });\n    SZGame2D.drawGroup(ctx, tiros);\n    SZGame2D.updateGroup(asteroides);\n    SZGame2D.pruneOffscreen(ctx, asteroides, 40, (sprite) => {\n\n    });\n    SZGame2D.drawGroup(ctx, asteroides);\n    SZGame2D.overlapGroups(tiros, asteroides, (tiro, asteroide) => {\n      SZGame2D.removeFromGroup(tiros, tiro);\n      SZGame2D.removeFromGroup(asteroides, asteroide);\n      SZGame2D.explodeSprite(asteroide, \"#ffb13b\");\n      SZGame2D.playFx(\"explosion\");\n    });\n  }, \"nave-ref-12\");\n  SZGame2D.gameLoop(function __szPeriodicLoop() {\n    if (SZGame2D.everyFrames(\"cada\", 40)) {\n      SZGame2D.spawnAsteroid(asteroides, { x: SZGame2D.randomX(), y: -30, size: 40, color: \"#8d8f9b\", vx: 0, vy: 3 });\n    }\n  });\n}, \"__sz-project\");\n"
          },
