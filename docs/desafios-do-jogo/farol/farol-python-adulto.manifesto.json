          "files": {
            "main.py": "WIDTH = 640\nHEIGHT = 480\nTITLE = \"Meu jogo do Arquipélago\"\n\nguia = Rect((60, 220), (40, 40))\nestrela = Rect((420, 220), (40, 40))\npontos = 0\n\n\npegou = False\n\n\ndef update():\n    global pontos, pegou\n    if keyboard.right:\n        guia.x = guia.x + 4\n    if keyboard.left:\n        guia.x = guia.x - 4\n    if guia.colliderect(estrela) and not pegou:\n        pegou = True\n        pontos = pontos + 1\n        estrela.x = 700\n\n\ndef on_key_down(key):\n    global pontos, pegou\n    if key == keys.R:\n        pontos = 0\n        pegou = False\n        guia.x = 60\n        estrela.x = 420\n\n\ndef draw():\n    screen.fill((26, 40, 84))\n    screen.draw.filled_circle(estrela.center, 18, (255, 220, 90))\n    screen.draw.filled_rect(guia, (120, 220, 200))\n    screen.draw.text(\"Pontos: \" + str(pontos), (16, 12), fontsize=32)\n",
            "requirements.txt": ""
          }
