        "left": "0",
        "min-width": "100%",
        "text-align": "center",
        "font-size": "0.7em",
        "color": "white",
        "z-index": "1"
      }
    },
    {
      "selector": "#results",
      "declarations": {
        "position": "absolute",
        "top": "0",
        "left": "0",
        "min-width": "100%",
        "min-height": "100%",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "visibility": "hidden",
        "z-index": "1"
      }
    },
    {
      "selector": "#results.visivel",
      "declarations": {
        "visibility": "visible"
      }
    },
    {
      "selector": "#results-box",
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "background-color": "#0f172a",
        "color": "white",
        "text-align": "center",
        "padding": "24px"
      }
    },
    {
      "selector": "#results-box button",
      "declarations": {
        "background-color": "#4ade80",
        "color": "#022c22",
        "padding": "16px 32px",
        "font-family": "inherit",
        "cursor": "pointer",
        "border": "none"
      }
    }
