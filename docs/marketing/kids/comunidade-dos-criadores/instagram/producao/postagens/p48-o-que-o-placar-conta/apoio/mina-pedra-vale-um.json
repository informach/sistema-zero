                        }
                      }
                    ],
                    "else": [
                      {
                        "type": "g3d:spawnInSwarm",
                        "swarmVar": "pedras",
                        "originalVar": "moldePedra",
                        "x": {
                          "type": "var",
                          "name": "coluna"
                        },
                        "y": {
                          "type": "num",
                          "value": 0
                        },
                        "z": {
                          "type": "var",
                          "name": "linha"
                        }
                      }
                    ]
