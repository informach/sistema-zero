                        "arg": {
                          "type": "binop",
                          "op": "*",
                          "left": {
                            "type": "randomFloat"
                          },
                          "right": {
                            "type": "num",
                            "value": 9
                          }
                        }
                      },
                      "right": {
                        "type": "num",
                        "value": 4
                      }
                    },
                    "kind": "const"
                  },
                  {
                    "type": "var",
                    "name": "linha",
                    "value": {
                      "type": "binop",
                      "op": "-",
                      "left": {
                        "type": "mathUnary",
                        "fn": "floor",
                        "arg": {
                          "type": "binop",
                          "op": "*",
                          "left": {
                            "type": "randomFloat"
                          },
                          "right": {
                            "type": "num",
                            "value": 9
                          }
                        }
                      },
                      "right": {
                        "type": "num",
                        "value": 4
                      }
                    },
                    "kind": "const"
                  },
