        {
          "type": "text",
          "text": " de 10    Tempo: "
        },
        {
          "type": "element",
          "tag": "span",
          "id": "tempo",
          "text": "50"
        },
        {
          "type": "text",
          "text": "s"
        }
      ]
    },
    {
      "type": "element",
      "tag": "div",
      "id": "dica",
