{
  "html": [],
  "css": [
    {
      "selector": "body",
      "declarations": {
        "background": "#0b1020",
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "min-height": "100vh",
        "margin": "0"
      }
    },
    {
      "selector": "canvas",
      "declarations": {
        "border": "2px solid #4ade80",
        "background": "#11172a"
      }
    }
  ],
  "version": 2,
  "behavior": {
    "molds": [],
    "start": [
      {
        "type": "g2d:setupStage",
        "width": 320,
        "height": 200,
        "bg": "#d4ecf8",
        "__id": "exemplo-mini-plataforma"
      },
      {
        "type": "g2d:setStageDescription",
        "description": "Herói que anda, pula com gravidade e fica preso na tela (setas).",
        "__id": "exemplo-mini-plataforma-descricao"
      },
      {
        "type": "g2d:createImageSprite",
        "varName": "heroi",
        "x": 64,
        "y": 140,
        "w": 24,
        "h": 24,
        "image": "data:image/svg+xml;base64,"
      },
      {
        "type": "g2d:createSprite",
        "varName": "inicio",
        "x": 0,
        "y": 164,
        "w": 110,
        "h": 36,
        "color": "#5c9d43"
      },
      {
        "type": "g2d:createSprite",
        "varName": "destino",
        "x": 156,
        "y": 120,
        "w": 164,
        "h": 80,
        "color": "#5c9d43"
      },
      {
        "type": "g2d:createSprite",
        "varName": "teto",
        "x": 70,
        "y": 34,
        "w": 206,
        "h": 22,
        "color": "#a56b40"
      }
    ],
    "events": [],
    "loops": [
      {
        "type": "g2d:updateEachFrame",
        "body": [
          {
            "type": "g2d:clear"
          },
          {
            "type": "g2d:applyGravity",
            "spriteVar": "heroi"
          },
          {
            "type": "g2d:platformer",
            "spriteVar": "heroi",
            "ctxVar": "ctx",
            "speed": 4,
            "jump": 9
          },
          {
            "type": "g2d:collidePlatform",
            "spriteVar": "heroi",
            "otherVar": "inicio"
          },
          {
            "type": "g2d:collidePlatform",
            "spriteVar": "heroi",
            "otherVar": "destino"
          },
          {
            "type": "g2d:collideSprite",
            "spriteVar": "heroi",
            "otherVar": "teto"
          },
          {
            "type": "g2d:clampToScreen",
            "spriteVar": "heroi",
            "ctxVar": "ctx"
          },
          {
            "type": "g2d:drawSprite",
            "spriteVar": "inicio",
            "ctxVar": "ctx"
          },
          {
            "type": "g2d:drawSprite",
            "spriteVar": "destino",
            "ctxVar": "ctx"
          },
          {
            "type": "g2d:drawSprite",
            "spriteVar": "teto",
            "ctxVar": "ctx"
          },
          {
            "type": "g2d:drawSprite",
            "spriteVar": "heroi",
            "ctxVar": "ctx"
          }
        ]
      }
    ]
  },
  "extensions": [
    {
      "extensionId": "game-2d"
    }
  ]
}