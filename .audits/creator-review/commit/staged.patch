+    <MoldaTaskGuide
+      profileId="child-a"
+      handoff={handoff}
+      persistence={{ load: async () => null, loadAll: async () => [] }}
+      onProgress={() => {}}
+      onOpenAsset={() => {}}
+      onReturn={() => {
+        returned = true
+      }}
+      hasOpenCreation={async () => true}
+    />,
