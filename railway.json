{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/payments/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "bun run --filter @sistemazero/payments db:migrate",
    "startCommand": "bun run --filter @sistemazero/payments start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
