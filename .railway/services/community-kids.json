{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/community-kids/Dockerfile",
    "watchPatterns": [
      "/packages/community-kids/**",
      "/packages/core/**",
      "/packages/member-shell/**",
      "/packages/helpdesk-contracts/**",
      "/packages/molda/**",
      "/packages/pensa/**",
      "/packages/pinta/**",
      "/packages/studio/**",
      "/packages/ui/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/scripts/release/**",
      "/.railway/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "restartPolicyMaxRetries": 3
  }
}
