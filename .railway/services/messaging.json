{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/messaging/Dockerfile",
    "watchPatterns": [
      "/packages/messaging/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/messaging db:deploy"],
    "startCommand": "bun run --filter @sistemazero/messaging start",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
