{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/marketing/Dockerfile",
    "watchPatterns": [
      "/packages/marketing/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**",
      "/packages/marketing-import/**",
      "/packages/marketing-contracts/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/marketing db:migrate"],
    "startCommand": "bun run --filter @sistemazero/marketing start",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
