{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/helpdesk/Dockerfile",
    "watchPatterns": [
      "/packages/helpdesk/**",
      "/packages/helpdesk-contracts/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/helpdesk db:migrate"],
    "startCommand": "bun run --filter @sistemazero/helpdesk start",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
