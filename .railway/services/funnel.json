{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/funnel/Dockerfile",
    "watchPatterns": [
      "/packages/funnel/**",
      "/packages/core/**",
      "/packages/ui/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/funnel db:migrate"],
    "startCommand": "bun packages/funnel/scripts/start.mjs",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
