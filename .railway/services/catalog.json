{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/catalog/Dockerfile",
    "watchPatterns": [
      "/packages/catalog/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/catalog db:deploy"],
    "startCommand": "bun run --filter @sistemazero/catalog start",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
