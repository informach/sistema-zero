{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/api-gateway/Dockerfile",
    "watchPatterns": [
      "/packages/api-gateway/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "startCommand": "bun run --filter @sistemazero/api-gateway start",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
