{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/marketing-app/Dockerfile",
    "watchPatterns": [
      "/packages/marketing-app/**",
      "/packages/ui/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**",
      "/packages/marketing-contracts/**",
      "/packages/marketing-workbench/**",
      "/packages/marketing-production/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "restartPolicyMaxRetries": 3
  }
}
