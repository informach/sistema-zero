{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/helpdesk-app/Dockerfile",
    "watchPatterns": [
      "/packages/helpdesk-app/**",
      "/packages/helpdesk-contracts/**",
      "/packages/ui/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "restartPolicyMaxRetries": 3
  }
}
