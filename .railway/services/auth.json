{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/auth/Dockerfile",
    "watchPatterns": [
      "/packages/auth/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/.railway/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/auth db:migrate"],
    "startCommand": "bun run --filter @sistemazero/auth start",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
