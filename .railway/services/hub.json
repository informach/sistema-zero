{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/hub/Dockerfile",
    "watchPatterns": [
      "/packages/hub/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/scripts/release/**",
      "/.railway/**"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun run --filter @sistemazero/hub db:migrate"],
    "startCommand": "bun scripts/release/start.mjs packages/hub/src/index.ts",
    "healthcheckPath": "/readyz",
    "restartPolicyMaxRetries": 3
  }
}
