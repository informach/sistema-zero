# @sistemazero/referrals — exemplo de configuração
# ⚠️ Regra do monorepo: NÃO deixe chave opcional com valor VAZIO (KEY=) — o Zod
# distingue AUSENTE de VAZIO e um vazio quebra o boot. Comente o que não usar.

# ── Básico ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# APP_ENV distingue prod de staging no Railway (obrigatório com NODE_ENV=production).
# APP_ENV=staging
PORT=3012
# Railway private networking é IPv6 — em deploy use HOST=:: (default).
# HOST=::
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
# DATABASE_POOL_MAX=10

# ── Integrações S2S (via api-gateway, consumer HMAC `referrals`) ─────────────
# Em deploy: http://api-gateway.railway.internal:3000
# GATEWAY_URL=http://localhost:3000
# Secret do consumer HMAC de borda `referrals` no gateway (o MESMO valor lá).
# REFERRALS_HMAC_SECRET=troque-por-32-chars-aleatorios
# S2S_TIMEOUT_MS=10000

# ── Produto / links públicos ─────────────────────────────────────────────────
# Curso do presente Kids (slug no members; default cade-todo-mundo).
# SCHOLARSHIP_COURSE_SLUG=cade-todo-mundo
# Curso do presente adulto (clone adulto publicado no Admin; default cade-todo-mundo-adulto).
# SCHOLARSHIP_ADULT_COURSE_SLUG=cade-todo-mundo-adulto
# Base pública do funil (landings /bolsa e /embaixador dos links enviados).
# FUNNEL_PUBLIC_URL=http://localhost:4321
# Base do app kids (link de definir senha do presente Kids).
# KIDS_COMMUNITY_URL=http://localhost:3008
# Base do app adulto (links dos e-mails do presente adulto). SEM default: ausente, o presente
# adulto fica indisponível (link "não disponível", resgate 503, convite adulto recusado e o
# painel do embaixador sem link adulto); o Kids segue normal. Em produção não pode ser localhost.
# COMMUNITY_URL=http://localhost:3007

# ── Conversões (bolsista → assinatura da Comunidade) ─────────────────────────
# Ofertas que contam como assinatura (csv). O default já inclui as adultas:
# CONVERSION_OFFER_SLUGS=comunidade-dos-criadores-mensal,comunidade-dos-criadores-anual,comunidade-dos-criadores-adulto-mensal,comunidade-dos-criadores-adulto-anual

# ── Regras ───────────────────────────────────────────────────────────────────
# INVITE_DAILY_LIMIT=50
# REDEMPTION_LEASE_MS=90000

# ── Borda própria ────────────────────────────────────────────────────────────
# Prova de origem do gateway nas rotas /referrals/* (header-inject de lá).
# INTERNAL_API_TOKEN=troque-por-32-chars-aleatorios
# REQUIRE_ADMIN=true
# METRICS_TOKEN=troque-por-32-chars-aleatorios
# SENTRY_DSN=
