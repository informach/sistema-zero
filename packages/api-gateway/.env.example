# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/api-gateway — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA commite o `.env` (já está no .gitignore).
# A config DECLARATIVA de rotas/serviços fica em `gateway.config.ts` (não aqui).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
# debug | info | warn | error. Em `debug`, o access log inclui um evento extra
# `gateway.headers` com os headers de req/resp (sensíveis redigidos como [REDACTED]).
LOG_LEVEL=info

# ── Estado compartilhado (rate limit, cache de sessão/JWKS, circuit breaker) ──
# memory  = por instância (dev / 1 réplica)
# redis   = compartilhado entre réplicas (produção / escala) — exige REDIS_URL
STATE_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# ── Config declarativa do gateway ────────────────────────────────────────────
# Caminho de um módulo .ts com `export default` (relativo à pasta do pacote)…
GATEWAY_CONFIG_PATH=./gateway.config.ts
# …ou, alternativamente, a config inline em JSON (tem prioridade se definida):
# GATEWAY_CONFIG_JSON=

# ── Borda / proxy ─────────────────────────────────────────────────────────────
# Confie no X-Forwarded-For só atrás de proxy/LB confiável (ex.: Railway).
TRUST_PROXY=false
# Nº de proxies confiáveis (IP do cliente = N-ésima entrada do XFF a partir da direita).
TRUSTED_PROXY_HOPS=1
# Teto do corpo da requisição (bytes). 1 MB (maior que o payments pois é streamado).
MAX_REQUEST_BODY_BYTES=1048576

# ── Defaults de proxy (sobrescrevíveis por serviço/rota na config) ────────────
DEFAULT_TIMEOUT_MS=15000
# Retry só vale para métodos idempotentes (GET/HEAD/PUT/DELETE). Nunca POST.
DEFAULT_RETRIES=0

# ── Rate limit global default (por identidade: principal → IP) ────────────────
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WINDOW_MS=60000

# ── Safety-net GLOBAL por IP (sobre TODAS as rotas) ───────────────────────────
# Teto agregado por IP de tráfego ANÔNIMO (clientes autenticados são isentos —
# ex.: o funil, IP único de egress). Defesa contra flood espalhado por várias
# rotas. Teto alto = não atrapalha uso normal. 0 = desabilita o stage.
GLOBAL_RATE_LIMIT_PER_MINUTE=1200
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ── Auth JWT (emissor = @sistemazero/auth) ────────────────────────────────────
# A estratégia "jwt" liga quando JWT_HS256_SECRET e/ou JWT_JWKS_URL existem
# (obrigatório se alguma rota usar "jwt"; validado no boot). Configure UM dos modos:
#  (a) HS256 — segredo simétrico, MESMO valor do JWT_HS256_SECRET do auth:
# JWT_HS256_SECRET=troque-este-segredo-de-no-minimo-32-caracteres
#  (b) RS256 — verifica via JWKS do auth (o gateway nunca segura a chave privada):
# JWT_JWKS_URL=http://localhost:3002/auth/.well-known/jwks.json
# Em ambos os casos, valide emissor/audiência (devem casar com o auth):
# JWT_ISSUER=sistemazero-auth
# JWT_AUDIENCE=sistemazero
# Algoritmos aceitos (CSV) — pin contra alg-confusion/downgrade. Default: deriva das chaves.
# JWT_ALGORITHMS=RS256,HS256
JWT_CACHE_TTL_MS=300000
SESSION_TTL_SECONDS=3600

# ── Auth HMAC (clientes sistema-a-sistema do gateway) ─────────────────────────
HMAC_TOLERANCE_SECONDS=300

# ── Re-assinatura ao upstream (rotas com upstreamAuth: 'resign') ──────────────
# Credenciais do gateway COMO consumidor do upstream (cadastre como consumer
# `gateway` no payments: `bun run db:seed --id gateway --secret <GATEWAY_HMAC_SECRET>`).
# As rotas /payments do funil usam resign → estes são OBRIGATÓRIOS (validado no boot).
GATEWAY_CONSUMER_ID=gateway
GATEWAY_HMAC_SECRET=

# ── Funil (@sistemazero/funnel) — BFF de pagamentos ───────────────────────────
# URL do funil (upstream do webhook). Local: http://localhost:4321
FUNNEL_URL=http://localhost:4321
# Segredo HMAC de borda do funil (MESMO valor no .env do funil). Sem ele, o funil
# não consegue chamar /payments (401).
FUNNEL_HMAC_SECRET=
# Token interno injetado ao encaminhar o webhook do payments ao funil (o funil
# confere). MESMO valor no .env do funil.
FUNNEL_INTERNAL_TOKEN=
# CIDRs autorizados a assinar como `funnel` (defesa em profundidade). Default: tudo.
# FUNNEL_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# ── Resiliência ───────────────────────────────────────────────────────────────
HEALTH_PROBE_INTERVAL_MS=5000
CB_FAILURE_RATE=0.5
CB_MIN_THROUGHPUT=20
CB_COOLDOWN_MS=10000

# ── Upstreams ─────────────────────────────────────────────────────────────────
# URL do serviço de pagamentos (lida pelo gateway.config.ts).
# Local: http://localhost:3001 · Railway (rede privada): http://payments.railway.internal:3001
PAYMENTS_URL=http://localhost:3001
# URL do serviço de identidade @sistemazero/auth (lida pelo gateway.config.ts).
# Local: http://localhost:3002 · Railway (rede privada): http://auth.railway.internal:3002
AUTH_URL=http://localhost:3002
