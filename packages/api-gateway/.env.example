# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/api-gateway — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA commite o `.env` (já está no .gitignore).
# A config DECLARATIVA de rotas/serviços fica em `gateway.config.ts` (não aqui).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
# debug | info | warn | error. Em `debug`, o access log inclui um evento extra
# `gateway.headers` com os headers de req/resp (sensíveis redigidos como [REDACTED]).
LOG_LEVEL=info

# ── Estado compartilhado (rate limit, cache de sessão/JWKS, circuit breaker) ──
# memory  = por instância (dev / 1 réplica)
# redis   = compartilhado entre réplicas (produção / escala) — exige REDIS_URL
STATE_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# ── Config declarativa do gateway ────────────────────────────────────────────
# Caminho de um módulo .ts com `export default` (relativo à pasta do pacote)…
GATEWAY_CONFIG_PATH=./gateway.config.ts
# …ou, alternativamente, a config inline em JSON (tem prioridade se definida):
# GATEWAY_CONFIG_JSON=

# ── Borda / proxy ─────────────────────────────────────────────────────────────
# Confie no X-Forwarded-For só atrás de proxy/LB confiável (ex.: Railway).
# ⚠️ Em PRODUÇÃO o boot EXIGE que esta variável seja definida EXPLICITAMENTE
# (true atrás de proxy/domínio público; false só com tráfego direto/rede privada):
# o default silencioso (false) atrás de proxy faria todos os clientes
# compartilharem o IP do edge num único balde de rate limit.
TRUST_PROXY=false
# Nº de proxies confiáveis (IP do cliente = N-ésima entrada do XFF a partir da direita).
TRUSTED_PROXY_HOPS=1
# Teto GLOBAL do corpo da requisição (bytes). 2 MB: os lotes de evento da SendGrid
# (webhooks → messaging) chegam até ~2 MB — 1 MB na borda os perderia (413) em
# silêncio. Rotas individuais AFINAM via `maxBodyBytes` no gateway.config.ts
# (as públicas de JSON pequeno usam 64 KB); aumentar por rota acima do global
# falha no boot (o teto do servidor venceria).
MAX_REQUEST_BODY_BYTES=2097152
# Espera (ms) do drain no SIGTERM: /readyz vira 503 → o LB para de rotear → as
# requisições em voo terminam. Em PRODUÇÃO, sem a env, o default é 5000 (5s);
# fora de produção, 0 (sem espera).
# SHUTDOWN_DRAIN_MS=5000

# ── Observabilidade ───────────────────────────────────────────────────────────
# Token do GET /metrics e do snapshot detalhado do /readyz (o gateway é a BORDA
# pública). Header `x-metrics-token` ou `Authorization: Bearer <token>`.
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot). Vazio = aberto (só dev).
METRICS_TOKEN=

# ── Rate limit global default (por identidade: principal → IP) ────────────────
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WINDOW_MS=60000

# ── Safety-net GLOBAL por IP (sobre TODAS as rotas) ───────────────────────────
# Teto agregado por IP de tráfego ANÔNIMO (clientes autenticados são isentos —
# ex.: o funil, IP único de egress). Defesa contra flood espalhado por várias
# rotas. Teto alto = não atrapalha uso normal. 0 = desabilita o stage.
GLOBAL_RATE_LIMIT_PER_MINUTE=1200
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ── Auth JWT (emissor = @sistemazero/auth) ────────────────────────────────────
# A estratégia "jwt" liga quando JWT_HS256_SECRET e/ou JWT_JWKS_URL existem
# (obrigatório se alguma rota usar "jwt"; validado no boot). Configure UM dos modos:
#  (a) HS256 — segredo simétrico, MESMO valor do JWT_HS256_SECRET do auth:
# JWT_HS256_SECRET=troque-este-segredo-de-no-minimo-32-caracteres
#  (b) RS256 — verifica via JWKS do auth (o gateway nunca segura a chave privada):
# JWT_JWKS_URL=http://localhost:3002/auth/.well-known/jwks.json
# Em ambos os casos, valide emissor/audiência (devem casar com o auth).
# ⚠️ Em PRODUÇÃO, se alguma rota usa "jwt", AMBOS são OBRIGATÓRIOS (fail-fast no
# boot): verificar assinatura sem amarrar emissor/audiência aceitaria qualquer
# token assinado com a mesma chave para outro contexto.
# JWT_ISSUER=sistemazero-auth
# JWT_AUDIENCE=sistemazero
# Algoritmos aceitos (CSV) — pin contra alg-confusion/downgrade. Default: deriva das chaves.
# JWT_ALGORITHMS=RS256,HS256

# ── Auth HMAC (clientes sistema-a-sistema do gateway) ─────────────────────────
HMAC_TOLERANCE_SECONDS=300

# ── Re-assinatura ao upstream (rotas com upstreamAuth: 'resign') ──────────────
# Credenciais do gateway COMO consumidor do upstream (cadastre como consumer
# `gateway` no payments: `bun run db:seed --id gateway --secret <GATEWAY_HMAC_SECRET>`).
# As rotas /payments do funil usam resign → estes são OBRIGATÓRIOS (validado no boot).
# GATEWAY_HMAC_SECRET deve ter ≥16 chars; segredo curto falha no boot.
GATEWAY_CONSUMER_ID=gateway
GATEWAY_HMAC_SECRET=

# ── Funil (@sistemazero/funnel) — BFF de pagamentos ───────────────────────────
# URL do funil (upstream do webhook). Local: http://localhost:4321
FUNNEL_URL=http://localhost:4321
# Segredo HMAC de borda do funil (MESMO valor no .env do funil). Sem ele, o funil
# não consegue chamar /payments (401).
FUNNEL_HMAC_SECRET=
# Token interno injetado ao encaminhar o webhook do payments ao funil (o funil
# confere). MESMO valor no .env do funil.
FUNNEL_INTERNAL_TOKEN=
# CIDRs autorizados a assinar como `funnel` (defesa em profundidade). Default:
# tudo — ⚠️ em PRODUÇÃO restrinja à rede privada (Railway: fd00::/8); deixar
# aberto reduz a defesa ao segredo HMAC sozinho (o boot loga warn em prod).
# FUNNEL_ALLOWED_CIDRS=fd00::/8

# ── Resiliência ───────────────────────────────────────────────────────────────
HEALTH_PROBE_INTERVAL_MS=5000
CB_FAILURE_RATE=0.5
CB_MIN_THROUGHPUT=20
CB_COOLDOWN_MS=10000

# ── Upstreams ─────────────────────────────────────────────────────────────────
# Em produção, nenhum *_URL de upstream pode apontar para localhost/loopback; use
# os hosts internos do PaaS/rede privada.

# URL do serviço de pagamentos (lida pelo gateway.config.ts).
# Local: http://localhost:3001 · Railway (rede privada): http://payments.railway.internal:3001
PAYMENTS_URL=http://localhost:3001
# Token interno injetado nas rotas ADMIN (`/payments/admin/*` — estorno!) e
# "minhas compras" (`/payments/my*`) — prova ao payments que os X-Auth-User-*
# vieram do gateway. MESMO valor no INTERNAL_API_TOKEN do payments. Vazio =
# injeção desligada (só dev/local). ≥16 chars; OBRIGATÓRIO em produção
# (fail-fast no boot). As rotas consumer (`/payments`,`/payments/:id`) têm HMAC
# próprio e ficam de fora.
PAYMENTS_INTERNAL_TOKEN=
# URL do serviço de identidade @sistemazero/auth (lida pelo gateway.config.ts).
# Local: http://localhost:3002 · Railway (rede privada): http://auth.railway.internal:3002
AUTH_URL=http://localhost:3002
# URL do serviço de catálogo @sistemazero/catalog (lida pelo gateway.config.ts).
# Local: http://localhost:3003 · Railway (rede privada): http://catalog.railway.internal:3003
CATALOG_URL=http://localhost:3003
# Token interno injetado nas rotas admin/escrita + redeem do catálogo (defesa em
# profundidade) — prova ao catalog que a chamada veio do gateway. MESMO valor no
# INTERNAL_API_TOKEN do catalog (e no CATALOG_INTERNAL_TOKEN do members, que chama
# a rota S2S de entitlements direto). Vazio = injeção desligada (só dev/local).
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
CATALOG_INTERNAL_TOKEN=
# URL do serviço de área de membros @sistemazero/members (lida pelo gateway.config.ts).
# Local: http://localhost:3004 · Railway (rede privada): http://members.railway.internal:3004
MEMBERS_URL=http://localhost:3004
# Token interno injetado nas rotas do ALUNO e do ADMIN (members) como defesa em
# profundidade — prova ao members que a chamada veio do gateway. MESMO valor no
# INTERNAL_API_TOKEN do members. Vazio = injeção desligada (só dev/local).
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
MEMBERS_INTERNAL_TOKEN=
# ── Members como consumer HMAC (report SEMANAL dos pais via /messaging/send) ──
# Segredo HMAC de borda do members (MESMO valor no MEMBERS_HMAC_SECRET do members).
# Cadastro CONDICIONAL (espelha auth/fiscal): vazio = consumer `members` não existe
# (report desligado; só dev). ≥16 chars quando presente.
# MEMBERS_HMAC_SECRET=
# CIDRs autorizados a assinar como `members`. Default: tudo — em produção restrinja.
# MEMBERS_ALLOWED_CIDRS=fd00::/8
# URL do serviço de mensageria @sistemazero/messaging (lida pelo gateway.config.ts).
# Local: http://localhost:3006 · Railway (rede privada): http://messaging.railway.internal:3006
MESSAGING_URL=http://localhost:3006
# Token interno injetado nas rotas de envio S2S + admin da mensageria (defesa em
# profundidade) — MESMO valor no MESSAGING_INTERNAL_TOKEN do messaging. Vazio =
# injeção desligada (só dev/local). ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
MESSAGING_INTERNAL_TOKEN=

# URL do serviço fiscal @sistemazero/fiscal (lida pelo gateway.config.ts).
# Local: http://localhost:3009 · Railway (rede privada): http://fiscal.railway.internal:3009
FISCAL_URL=http://localhost:3009
# Token interno injetado nas rotas admin /fiscal/admin/* (defesa em profundidade)
# — MESMO valor no INTERNAL_API_TOKEN do fiscal. Vazio = injeção desligada (só dev/local).
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
FISCAL_INTERNAL_TOKEN=
# Segredo HMAC de borda do fiscal (consumer `fiscal` para chamar /messaging/send).
# MESMO valor no FISCAL_HMAC_SECRET do fiscal. ≥16 chars; OBRIGATÓRIO em produção.
FISCAL_HMAC_SECRET=
# CIDRs autorizados a assinar como `fiscal`. Default: tudo — em produção restrinja.
# FISCAL_ALLOWED_CIDRS=fd00::/8

# URL do serviço de fórum @sistemazero/hub (lida pelo gateway.config.ts).
# Local: http://localhost:3010 · Railway (rede privada): http://hub.railway.internal:3010
HUB_URL=http://localhost:3010
# Token interno injetado nas rotas do aluno e admin do hub. MESMO valor no
# INTERNAL_API_TOKEN do hub. Vazio = injeção desligada (só dev/local).
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
HUB_INTERNAL_TOKEN=

# URL do serviço de marketing @sistemazero/marketing (lida pelo gateway.config.ts).
# Local: http://localhost:3011 · Railway (rede privada): http://marketing.railway.internal:3011
MARKETING_URL=http://localhost:3011
# Token interno injetado nas rotas /marketing/*. MESMO valor no INTERNAL_API_TOKEN
# do marketing. ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
MARKETING_INTERNAL_TOKEN=
# ── Marketing como consumer HMAC (lembrete de publicação via /messaging/send) ──
# Segredo HMAC de borda do marketing (MESMO valor no MARKETING_HMAC_SECRET do
# marketing). Vazio = consumer não cadastrado (lembrete desligado; só dev).
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
MARKETING_HMAC_SECRET=
# CIDRs autorizados a assinar como `marketing`. Default: tudo — em produção restrinja.
# MARKETING_ALLOWED_CIDRS=fd00::/8

# URL do serviço de help desk @sistemazero/helpdesk (lida pelo gateway.config.ts).
# Local: http://localhost:3013 · Railway (rede privada): http://helpdesk.railway.internal:3013
HELPDESK_URL=http://localhost:3013
# Token interno injetado nas rotas /helpdesk/*. MESMO valor no INTERNAL_API_TOKEN do
# helpdesk. Vazio = as rotas /helpdesk/* respondem 401 (o serviço exige o token).
# ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
# HELPDESK_INTERNAL_TOKEN=

# ── Auth como consumer HMAC (envio de e-mail de reset via /messaging/send) ────
# Segredo HMAC de borda do auth (MESMO valor no AUTH_HMAC_SECRET do auth).
# Vazio = consumer `auth` não cadastrado em dev/local (o auth usa o cliente no-op;
# e-mails desligados). >=16 chars; OBRIGATORIO em producao (fail-fast no boot).
AUTH_HMAC_SECRET=
# CIDRs autorizados a assinar como `auth`. Default: tudo — ⚠️ em PRODUÇÃO
# restrinja à rede privada (Railway: fd00::/8); o boot loga warn se aberto.
# AUTH_ALLOWED_CIDRS=fd00::/8
# Token interno injetado nas rotas S2S /auth/internal/* e admin /auth/admin/*
# (defesa em profundidade) — MESMO valor no AUTH_INTERNAL_TOKEN do auth. Vazio =
# injeção desligada (só dev). ≥16 chars; OBRIGATÓRIO em produção (fail-fast no boot).
AUTH_INTERNAL_TOKEN=

# DSN do Sentry (monitoramento de erros). Ausente = desligado (dev/local). Captura:
# exceções inesperadas (gateway.unhandled, process handlers, boot) + logs ERROR via
# espelho com política da BORDA: gateway.access 502/503/504 vira evento (upstream
# inalcançável/timeout/circuito — sinal que SÓ o gateway enxerga; fingerprint por
# rota+status); 500 NÃO espelha (dup do Sentry do upstream/pipeline.stage_failed).
# Sem PII (sendDefaultPii=false).
# SENTRY_DSN=
