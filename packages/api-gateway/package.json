{
  "name": "@sistemazero/api-gateway",
  "version": "0.1.0",
  "description": "API Gateway (Elysia + Bun): roteamento/proxy, auth plugável (JWT/sessão + HMAC), rate limiting, load balancing, CORS, logging e transformação — config-driven, stateless, pronto para escala.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@sentry/bun": "^10.56.0",
    "@sistemazero/core": "workspace:*",
    "elysia": "^1.4.9",
    "jose": "^6.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
