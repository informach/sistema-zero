NODE_ENV=development
# Porta do serviço de área de membros (gateway=3000, payments=3001, auth=3002, catalog=3003, members=3004).
PORT=3004
# Endereço de bind. `::` (default) é dual-stack IPv4+IPv6 — obrigatório p/ o
# private networking do Railway (members.railway.internal resolve IPv6).
HOST=::
MAX_REQUEST_BODY_BYTES=65536

# Postgres COMPARTILHADO do monorepo (porta 5433 em dev). Schema próprio `members`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
DATABASE_POOL_MAX=10

# Sentry (monitoramento de erros). Ausente = desligado (dev/local). Em produção,
# DSN do projeto `sistema-zero-members` (org informach-nucleo-de-aprendizag).
# SENTRY_DSN=

# Catálogo (fonte da verdade do "o que a oferta dá direito"). Chamada S2S direta na
# rede interna — a rota /catalog/offers/:slug/entitlements devolve o manifesto de
# entrega e exige o x-internal-token do catalog.
CATALOG_BASE_URL=http://localhost:3003
# Timeout por chamada ao catálogo (ms) — sem ele, um catálogo travado pendura o
# handler do webhook de concessão.
CATALOG_REQUEST_TIMEOUT_MS=10000
# Token interno enviado na chamada S2S de entitlements (= INTERNAL_API_TOKEN do
# catalog e CATALOG_INTERNAL_TOKEN do gateway). Vazio em dev/local (catálogo sem
# token); OBRIGATÓRIO em produção (>= 16 chars, boot falha sem ele).
# CATALOG_INTERNAL_TOKEN=troque-por-um-token-aleatorio

# Verificação dos webhooks de entrada (concessão/assinatura). O gateway re-assina a
# chamada do funil como consumer `gateway` usando ESTE segredo (= GATEWAY_HMAC_SECRET
# do gateway). ≥16 chars.
GATEWAY_HMAC_SECRET=troque-este-segredo-de-no-minimo-16-chars
# Tolerância de timestamp (anti-replay) na verificação do HMAC.
HMAC_TOLERANCE_SECONDS=300

# Defesa em profundidade das rotas do ALUNO **e do ADMIN**: o gateway injeta
# `x-internal-token` com ESTE valor (= MEMBERS_INTERNAL_TOKEN do gateway) e o members
# o exige — garante que a chamada (e os X-Auth-User-*) veio do gateway. Vazio =
# checagem desligada (dev sem gateway). ≥16 chars. OBRIGATÓRIO em produção (o boot
# falha sem ele se NODE_ENV=production).
INTERNAL_API_TOKEN=

# Carência (dias) somada ao fim do ciclo da assinatura ao calcular expiresAt
# (absorve atraso de notificação entre ciclos).
SUBSCRIPTION_GRACE_DAYS=3

# Retenção do dedupe de webhooks (processed_webhooks): o ciclo periódico interno
# (advisory lock — 1 réplica por ciclo) apaga linhas mais antigas que isto.
PROCESSED_WEBHOOKS_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_MS=21600000

# ── Quota de IA por CONTA (Pensa + descrição do Mural + recursos futuros) ──────
# Interações/dia e /mês por CONTA. Calibrado p/ o cliente não sentir o teto com o
# custo em centavos (gpt-4o-mini). Equipe é isenta (grava mas nunca recusa).
AI_LIMIT_DAILY=50
AI_LIMIT_MONTHLY=500

# ── Lembrete de RENOVAÇÃO (assinatura anual à vista Pix/boleto) ───────────────
# Janela (dias antes do vencimento) + ciclo do job (6h) + teto de contas por ciclo.
RENEWAL_REMINDER_DAYS_BEFORE=7
RENEWAL_REMINDER_INTERVAL_MS=21600000
RENEWAL_REMINDER_BATCH_LIMIT=200
# URL pública do FUNIL — base do link /renovar?oferta=<slug> no e-mail de renovação.
# OPCIONAL: ausente = o job de lembrete é no-op (não envia). Vazio QUEBRA o boot
# (é validado como URL). Dev: http://localhost:4321; produção: https://sistemazero.com.br.
# FUNNEL_URL=http://localhost:4321

# ── Tunables opcionais (têm default no schema; setar só p/ override) ──────────
# Teto de corpo (bytes) das rotas de Estúdio (entrega do aluno + autoria do bloco) —
# carregam o projeto INTEIRO, bem maior que os JSONs comuns. Default 2 MB.
MAX_STUDIO_BODY_BYTES=2097152
# TLS na conexão com o Postgres. Default false (rede privada do Railway). true →
# ssl:'require' se o banco passar a exigir TLS (Postgres externo/público).
DATABASE_SSL=false
# RBAC das rotas /members/admin/* — confere os headers X-Auth-User-* (defesa em
# profundidade). NÃO desligável em produção (boot falha); em dev fora do gateway pode ir false.
REQUIRE_ADMIN=true
# Teto de perfis kids (estilo Netflix) p/ matrícula ativa SEM maxProfiles no snapshot
# (compradores legados). Piso de compat; o teto real vem do produto/catálogo.
DEFAULT_KIDS_MAX_PROFILES=1
# Notificação ao HUB no grant (invalida o micro-cache de acesso na hora). OPCIONAL:
# ausente = não notifica (o TTL do hub, ~30s, cobre). Em prod, se setado, NÃO pode ser
# localhost (refine). Dev: deixe comentado.
# HUB_BASE_URL=http://localhost:3010
HUB_REQUEST_TIMEOUT_MS=4000

# ── Report semanal dos pais (Fase 5) + Lembrete de renovação ──────────────────
# O quarteto abaixo (AUTH_BASE_URL + AUTH_INTERNAL_TOKEN + GATEWAY_URL +
# MEMBERS_HMAC_SECRET) liga AMBOS os jobs de e-mail (report dos pais e lembrete de
# renovação); faltando qualquer um, o job vira no-op silencioso (dev).
# AUTH (S2S direto): e-mail/nome do responsável + nomes das crianças. OPCIONAL (URL) —
# comentado em dev; vazio QUEBRA o boot (validado como URL).
# AUTH_BASE_URL=http://localhost:3002
# Token interno do auth (≥16 chars). OPCIONAL — comentado em dev (vazio quebra o boot).
# AUTH_INTERNAL_TOKEN=troque-por-um-token-aleatorio
# Timeout por chamada ao auth (ms).
AUTH_REQUEST_TIMEOUT_MS=8000
# Envio do e-mail VIA GATEWAY (consumer HMAC `members`). OPCIONAL (URL) — comentado em dev.
# GATEWAY_URL=http://localhost:3000
# Segredo HMAC do consumer `members` no gateway (≥16 chars). OPCIONAL — comentado em dev.
# MEMBERS_HMAC_SECRET=troque-este-segredo-de-no-minimo-16-chars
# Gatilho do report: dia da semana (0=domingo … 6=sábado; default 5=sexta) + hora SP (0..23).
PARENT_REPORT_DOW=5
PARENT_REPORT_HOUR=17
# Ciclo do job (ms, default 1h) + teto de contas por ciclo.
PARENT_REPORT_INTERVAL_MS=3600000
PARENT_REPORT_BATCH_LIMIT=200
# URL pública do app kids (CTA "Ver na plataforma" do e-mail → /perfis). OPCIONAL (URL).
# KIDS_COMMUNITY_URL=http://localhost:3008
# Allowlist de PREFIXOS da foto do avatar (csv) — `PUT /members/avatar/photo` recusa URL
# fora deles (a foto vira <img> p/ outras crianças; URL externa = pixel-rastreador).
# ⚠️ OBRIGATÓRIA EM PRODUÇÃO (boot falha sem ela; setar ANTES do deploy). Comentada em
# dev = aceita qualquer http(s). Prefixo só-host ganha `/` final automático.
# staging: base pública do bucket `testes`; prod: cdn.sistemazero.com.br (R2 público).
# AVATAR_PHOTO_URL_PREFIXES=https://cdn.sistemazero.com.br/
