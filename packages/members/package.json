{
  "name": "@sistemazero/members",
  "version": "0.1.0",
  "description": "Área de membros: matrícula/entitlement (acesso por compra/assinatura), cursos (módulos/aulas polimórficas) e progresso — DDD + Hexagonal",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:pensa-db": "bun run scripts/test-pensa-db.ts",
    "pensa:maintenance": "bun run scripts/pensa-maintenance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "journey:bootstrap": "bun run scripts/bootstrap-kids-journey.ts",
    "career:finalize-first-steps": "bun run scripts/finalize-first-steps-rollout.ts",
    "entitlements:rollout-molda": "bun run scripts/rollout-molda-entitlements.ts",
    "journey:seed-adult": "bun run scripts/seed-adult-journey.ts",
    "journey:seed-creator": "bun run scripts/seed-creator-journey.ts",
    "journey:seed-production": "bun run scripts/seed-adult-journey-production.ts",
    "submissions:audit-lost": "bun run scripts/audit-lost-studio-submissions.ts",
    "submissions:restore": "bun run scripts/restore-studio-submissions.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "materials:backfill": "bun run scripts/backfill-materials-block.ts",
    "drafts:rebase-revisions": "bun run scripts/rebase-lesson-draft-revisions.ts",
    "desafio:reorganize": "bun run scripts/reorganize-desafio-primeiro-jogo.ts"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@sentry/bun": "^10.56.0",
    "@sistemazero/core": "workspace:*",
    "@sistemazero/studio": "workspace:*",
    "@sistemazero/pinta": "workspace:*",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.4.9",
    "postgres": "^3.4.7",
    "zod": "4.3.6",
    "@sistemazero/arquipelago-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "24.19.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
