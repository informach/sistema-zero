{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/members/Dockerfile",
    "watchPatterns": [
      "/packages/members/**",
      "/packages/core/**",
      "/packages/pinta/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/scripts/release/**"
    ]
  },
  "deploy": {
    "preDeployCommand": "bun run --filter @sistemazero/members db:migrate",
    "startCommand": "bun scripts/release/start.mjs packages/members/src/index.ts",
    "healthcheckPath": "/readyz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
