{
  "name": "@sistemazero/studio-language-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "verify:rpc": "node scripts/verify-rpc.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.worker-tests.json",
    "build:server": "bun build --cwd ../.. --no-env-file packages/studio-language-service/runtime/server.ts --target=node --external pyright --outfile=packages/studio-language-service/dist/server.mjs",
    "check": "biome check ."
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.10.3",
    "@sistemazero/core": "workspace:*",
    "pyright": "1.1.414",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "@types/bun": "1.3.11",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "wrangler": "4.120.1"
  }
}
