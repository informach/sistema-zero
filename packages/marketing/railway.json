{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/marketing/Dockerfile",
    "watchPatterns": [
      "/packages/marketing/**",
      "/packages/core/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "preDeployCommand": "bun run --filter @sistemazero/marketing db:migrate",
    "startCommand": "bun run --filter @sistemazero/marketing start",
    "healthcheckPath": "/readyz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
