# ── Obrigatórias ─────────────────────────────────────────────────────────────
# Postgres compartilhado do monorepo (dev: docker :5433). O package é dono do
# schema `marketing` (journal próprio `marketing_migrations`).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
# Defesa em profundidade: o gateway injeta `x-internal-token` com ESTE valor
# (MESMO do MARKETING_INTERNAL_TOKEN do gateway). ≥16 caracteres.
# ⚠️ NUNCA leve um valor `dev-*` a staging/produção — gere um aleatório ≥32.
INTERNAL_API_TOKEN=dev-internal-token-marketing

# ── Opcionais ────────────────────────────────────────────────────────────────
# PORT=3011
# HOST=::
# TLS na conexão com o Postgres (fora da rede privada do Railway):
# DATABASE_SSL=false
# Em dev SEM gateway (curl direto), desligue a checagem de role:
# REQUIRE_STAFF=false
# SENTRY_DSN=

# R2 (mídia). Ausentes → presign responde 503 amigável (MEDIA_NOT_CONFIGURED).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_MARKETING_BUCKET=
# MARKETING_MAX_UPLOAD_BYTES=2147483648
# R2_PRESIGN_PUT_TTL_SECONDS=3600
# R2_PRESIGN_GET_TTL_SECONDS=86400

# ── OAuth Google (Drive + YouTube) — grupo ATÔMICO: qualquer um ausente →
# rotas OAuth/Drive respondem 503 OAUTH_NOT_CONFIGURED (boot ok) ──────────────
# Console: https://console.cloud.google.com/apis/credentials — client Web com
# redirect URI `<OAUTH_PUBLIC_BASE_URL>/marketing/oauth/youtube/callback` e as
# APIs Drive + YouTube Data v3 HABILITADAS.
# ⚠️ PUBLICAR o app OAuth (em "Testing" o refresh token expira em 7 dias).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Chave da secret-box AES-256-GCM (32 bytes base64): `openssl rand -base64 32`
# MARKETING_TOKEN_ENC_KEY=
# Origem PÚBLICA do gateway (monta a redirect_uri fixa do callback).
# OAUTH_PUBLIC_BASE_URL=http://localhost:3000
# URL do marketing-app (destino do 302 pós-callback: /conexoes?connected=…).
# MARKETING_APP_URL=http://localhost:3012

# ── Lembrete WhatsApp (marketing → gateway → /messaging/send, HMAC) ───────────
# GATEWAY_URL=http://localhost:3000
# MARKETING_CONSUMER_ID=marketing
# Segredo HMAC de borda (MESMO valor no MARKETING_HMAC_SECRET do gateway).
# Ausente = lembrete desligado (a publicação ainda vai a awaiting_manual).
# MARKETING_HMAC_SECRET=
# CSV E.164 com DDI 55 (ex.: 5511999999999,5511888888888). Vazio = lembrete no-op.
# MARKETING_REMINDER_PHONES=
# MARKETING_REMINDER_RECIPIENT_NAME=Equipe
# MARKETING_REMINDER_TEMPLATE_KEY=marketing-reminder

# ── Knobs dos workers (defaults sensatos) ─────────────────────────────────────
# PUBLISHER_POLL_INTERVAL_MS=30000
# PUBLISHER_BATCH_SIZE=10
# PUBLISHER_CLAIM_LEASE_MS=600000
# REMINDER_MAX_ATTEMPTS=5
# REMINDER_RETRY_BASE_MS=60000
# REMINDER_RETRY_MAX_MS=1800000
# MEDIA_TRANSFER_POLL_INTERVAL_MS=15000
# MEDIA_TRANSFER_BATCH_SIZE=2
# MEDIA_TRANSFER_MAX_ATTEMPTS=5
# MEDIA_TRANSFER_LEASE_MS=1800000
# MEDIA_TRANSFER_TIMEOUT_MS=1800000
# TOKEN_REFRESH_INTERVAL_MS=600000
# TOKEN_REFRESH_MARGIN_MS=1200000

# ── OAuth Meta (grupo ATÔMICO — ausente = Instagram/Facebook em modo lembrete) ─
# App na Meta for Developers (Facebook Login), em LIVE MODE; redirect URI:
# <OAUTH_PUBLIC_BASE_URL>/marketing/oauth/facebook/callback
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v25.0
# Renova o user token 60d com esta folga (re-deriva os page tokens irmãos).
# META_TOKEN_RENEW_MARGIN_DAYS=10
# Lead do claim automático da Meta (container processa na espera). 10min.
# META_PUBLISH_LEAD_MS=600000

# ── Metrics-worker (decaimento; fallback nos YT_METRICS_* legados) ────────────
# METRICS_WORKER_INTERVAL_MS=21600000
# METRICS_MAX_AGE_DAYS=90
# METRICS_BATCH_SIZE=50

# ── OAuth TikTok (grupo ATÔMICO — ausente = TikTok em modo lembrete) ──────────
# App no TikTok for Developers (Login Kit + Content Posting API); redirect URI:
# <OAUTH_PUBLIC_BASE_URL>/marketing/oauth/tiktok/callback
# ⚠️ Sem auditoria do app, os posts via API saem PRIVADOS (SELF_ONLY).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Chunk do FILE_UPLOAD do Direct Post (clampado 5..64MB pela API). 16MiB.
# TT_UPLOAD_CHUNK_BYTES=16777216

# ── Arquivador R2→Drive (F4; roda com Google + R2 configurados) ───────────────
# Conteúdo PUBLICADO há N dias tem a mídia movida do R2 pro Drive (e apagada
# do R2 após o checkpoint). Exige reconectar o Google (escopo drive.file novo).
# MEDIA_ARCHIVER_INTERVAL_MS=3600000
# MEDIA_ARCHIVE_AFTER_DAYS=30
