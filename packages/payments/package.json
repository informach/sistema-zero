{
  "name": "@sistemazero/payments",
  "version": "0.1.0",
  "description": "Serviço de pagamentos/checkout (Pix, boleto, cartão) via Efí Pay — DDD + Hexagonal",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed-consumer.ts",
    "webhook:register": "bun run scripts/register-webhook.ts",
    "pix:key": "bun run scripts/create-pix-key.ts",
    "boleto:create": "bun run scripts/create-boleto.ts",
    "call-example": "bun run scripts/call-example.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@sistemazero/core": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.4.9",
    "node-forge": "^1.3.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-forge": "^1.3.11",
    "drizzle-kit": "^0.31.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
