# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/payments — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env` (já está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
# Endereço de bind. `::` (default) = dual-stack IPv4+IPv6 — OBRIGATÓRIO para o
# private networking do Railway (payments.railway.internal resolve IPv6).
# HOST=::
# Tolerância (em segundos) para o timestamp da assinatura HMAC (anti-replay).
# OBS: a mensagem assinada é "<ts>.<MÉTODO>.<path>.<idempotencyKey>.<corpo>"
# (sem chave: "<ts>.<MÉTODO>.<path>.<corpo>") — método+path impedem replay
# cross-endpoint; a Idempotency-Key impede replay trocando a chave.
HMAC_TOLERANCE_SECONDS=300
# Resolução do IP do consumidor p/ a allowlist CIDR. Depende de COMO o gateway
# alcança este serviço:
#  (a) private networking do Railway (payments.railway.internal — RECOMENDADO):
#      o gateway conecta DIRETO (sem proxy no meio) → TRUST_PROXY=false (usa o
#      IP do socket = IP privado do gateway; allowlist = faixa privada fd00::/8
#      ou o IP observado nos logs).
#  (b) via domínio PÚBLICO do payments: o edge do Railway é o único proxy →
#      TRUST_PROXY=true + TRUSTED_PROXY_HOPS=1 (a última entrada do XFF é a que
#      o edge anexou = IP de egress público do gateway; allowlist = esse IP).
#      Com Cloudflare na frente do domínio → HOPS=2.
# ⚠️ O gateway TAMBÉM anexa ao XFF o IP do cliente DELE (funil/usuário) antes de
# encaminhar — não confunda: para a allowlist deste serviço interessa o IP do
# CHAMADOR DIRETO (o gateway), nunca o do cliente final.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# Teto do corpo da requisição em bytes (anti-DoS por payload gigante). 64 KB.
MAX_REQUEST_BODY_BYTES=65536
# Rotas admin (/payments/admin/*): confere os headers X-Auth-User-* que o gateway
# injeta (defesa em profundidade). SEGURO por default (true); só desligue em dev
# quando bater no serviço SEM passar pelo gateway.
REQUIRE_ADMIN=true

# Banco de dados (PostgreSQL) — banco COMPARTILHADO do monorepo (`sistemazero`);
# este serviço é dono do schema `payments` (isolado por pgSchema). Porta 5433 em dev.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero

# Efí Pay — credenciais da aplicação (Conta Digital Efí)
EFI_CLIENT_ID=Client_Id_aqui
EFI_CLIENT_SECRET=Client_Secret_aqui
# true = homologação (sandbox), false = produção.
# ⚠️ Em produção (NODE_ENV=production) DEVE ser false — o boot FALHA se ficar true
# (evita apontar silenciosamente para o sandbox e gerar cobranças que não liquidam).
EFI_SANDBOX=true
# Timeout POR TENTATIVA de requisição HTTP à Efí (ms) — aborta sockets pendurados
# (mTLS/Bun). 20s: o handshake mTLS frio leva ~15-16s sob Bun; com 15s a request
# era abortada no fim do handshake (PIX 502 no funil).
EFI_REQUEST_TIMEOUT_MS=20000
# Teto de tempo da operação INTEIRA contra a Efí (tentativas + backoff, ms).
# Precisa caber no timeout do gateway (35s) e folgar ≥10s sob o TTL da reserva de
# idempotência (abaixo) — o boot valida as duas invariantes.
EFI_TOTAL_RETRY_BUDGET_MS=30000
# TTL da reserva IN_FLIGHT de idempotência (s). Recicla reservas presas por crash
# e é o lockout do retry pós-falha-com-efeito. DEVE cobrir o budget acima + 10s.
IDEMPOTENCY_IN_FLIGHT_TTL_SECONDS=60
# Certificado P12 da Efí. Use UMA das opções abaixo:
#  (a) Local/VM — caminho do arquivo:
EFI_CERTIFICATE_PATH=./secrets/efi-homologacao.p12
#  (b) Railway/PaaS — conteúdo do .p12 em base64 (tem prioridade sobre o PATH):
#      gere com:  base64 -w0 cert.p12   (Linux/macOS)
#      ou:        [Convert]::ToBase64String([IO.File]::ReadAllBytes("cert.p12"))   (PowerShell)
# EFI_CERTIFICATE_BASE64=
# Senha do P12 (só se o arquivo for protegido). Em branco/ausente = sem senha.
# EFI_CERTIFICATE_PASSWORD=
# Chave Pix da sua conta que recebe os pagamentos (para criar a cobrança /v2/cob)
EFI_PIX_KEY=sua-chave-pix-aqui
# Segredo compartilhado do webhook de ENTRADA (Efí). Se definido, os endpoints
# /webhooks/efi/* exigem ?token=<segredo> (ou header x-webhook-token) — registre
# o webhook com esse token na URL. ⚠️ Em produção é OBRIGATÓRIO (o boot falha
# sem ele: o webhook é público e cada item custa 1 INSERT + 1 chamada à Efí —
# sem o segredo é amplificação não autenticada). Em dev, AUSENTE = desabilitado
# (string vazia não é aceita). Defina um segredo forte e único:
# EFI_WEBHOOK_SECRET=

# Boleto/cartão (API Cobranças — SEM certificado/mTLS). Por padrão reusa as
# credenciais EFI_CLIENT_ID/SECRET acima (a mesma aplicação Efí pode ter os dois
# escopos); os overrides abaixo só são necessários para uma aplicação separada.
# EFI_COBRANCAS_CLIENT_ID=
# EFI_COBRANCAS_CLIENT_SECRET=
# Vencimento padrão do boleto (dias a partir de hoje) quando a request não informa.
EFI_BOLETO_DEFAULT_EXPIRES_DAYS=3
# URL pública que a Efí chama na mudança de status do boleto (notification_url).
# EFI_BOLETO_NOTIFICATION_URL=
# Multa/juros padrão do boleto em centésimos de % (200 = 2,00%), quando não vierem na request.
# EFI_BOLETO_FINE=200
# EFI_BOLETO_INTEREST=33

# Outbox poller
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100
# Após N falhas de publicação, o evento vira DEAD (dead-letter → não bloqueia a fila).
OUTBOX_MAX_ATTEMPTS=10

# Escala / resiliência
# Conexões do pool do Postgres por instância (N réplicas × este valor não pode
# estourar o max_connections do banco — use pooler/pgbouncer em escala).
# Default 20: o pool é compartilhado por hot path + 4 workers + leituras admin.
# OBS: o LISTEN usa +1 conexão dedicada (fora do pool) por instância.
DATABASE_POOL_MAX=20
# LISTEN/NOTIFY acorda os workers na hora (latência ~ms em vez de até o intervalo
# de poll). DESLIGUE (false) atrás de PgBouncer em transaction/statement pooling
# (não suporta LISTEN) — o poll periódico continua processando normalmente.
PG_LISTEN_ENABLED=true
# Limpeza periódica de chaves de idempotência expiradas (ms).
IDEMPOTENCY_CLEANUP_INTERVAL_MS=300000
# Retenção: linhas TERMINAIS (outbox publicado/dead, webhooks processados,
# entregas concluídas/dead) mais antigas que N dias são removidas no job de limpeza.
RETENTION_DAYS=30
# Rate limit por consumidor (req/min). Excedeu → 429. (Por instância.)
RATE_LIMIT_PER_MINUTE=600
# Teto GLOBAL das rotas /webhooks/efi/* (req/min, por instância; chave única —
# não por IP, o XFF do webhook não é confiável). Backpressure, não autenticação
# (essa é o EFI_WEBHOOK_SECRET). 429 não perde pagamento: a Efí re-tenta e a
# reconciliação é a rede de segurança.
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# Token do GET /metrics (header x-metrics-token ou Authorization: Bearer).
# ⚠️ OBRIGATÓRIO em produção (≥16 chars) — o serviço tem ingress público (webhook
# da Efí) e /metrics expõe telemetria operacional. Em dev, ausente = aberto.
# METRICS_TOKEN=

# Modo assíncrono (opt-in p/ picos): true = POST /payments responde 202 e um worker
# cria a cobrança na Efí depois (cliente consulta GET /payments/:id). false = síncrono.
ASYNC_CHARGE_CREATION=false
CHARGE_WORKER_INTERVAL_MS=1000
CHARGE_WORKER_BATCH_SIZE=20
# Cobranças criadas em paralelo por ciclo (vazão por instância).
CHARGE_WORKER_CONCURRENCY=5
CHARGE_MAX_ATTEMPTS=5
# Lease: tempo até um claim "preso" voltar à fila p/ nova tentativa (ms).
CHARGE_CLAIM_STALE_MS=60000

# Reconciliação (rede de segurança p/ webhooks perdidos)
RECONCILE_INTERVAL_MS=60000
RECONCILE_BATCH_SIZE=50

# Webhook de saída (notificar consumidores)
WEBHOOK_DELIVERY_INTERVAL_MS=2000
WEBHOOK_DELIVERY_BATCH_SIZE=50
WEBHOOK_DELIVERY_MAX_ATTEMPTS=8
# Entregas em paralelo por ciclo (lote cabe no lease → evita re-entrega duplicada).
WEBHOOK_DELIVERY_CONCURRENCY=5
