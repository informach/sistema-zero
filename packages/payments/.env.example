# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/payments — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env` (já está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
# Tolerância (em segundos) para o timestamp da assinatura HMAC (anti-replay).
# OBS: a mensagem assinada é "<ts>.<idempotencyKey>.<corpo>" (a Idempotency-Key
# entra na assinatura → replay não pode trocar a chave). Sem chave: "<ts>.<corpo>".
HMAC_TOLERANCE_SECONDS=300
# Confiar no header X-Forwarded-For (ligue só quando estiver atrás de proxy/LB confiável)
TRUST_PROXY=false
# Nº de proxies confiáveis na frente do app (IP do cliente = N-ésima entrada do
# X-Forwarded-For a partir da direita). Atrás de 1 proxy (Railway), use 1.
TRUSTED_PROXY_HOPS=1
# Teto do corpo da requisição em bytes (anti-DoS por payload gigante). 64 KB.
MAX_REQUEST_BODY_BYTES=65536

# Banco de dados (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payments

# Efí Pay — credenciais da aplicação (Conta Digital Efí)
EFI_CLIENT_ID=Client_Id_aqui
EFI_CLIENT_SECRET=Client_Secret_aqui
# true = homologação (sandbox), false = produção
EFI_SANDBOX=true
# Timeout por requisição HTTP à Efí (ms) — aborta sockets pendurados (mTLS/Bun).
EFI_REQUEST_TIMEOUT_MS=15000
# Certificado P12 da Efí. Use UMA das opções abaixo:
#  (a) Local/VM — caminho do arquivo:
EFI_CERTIFICATE_PATH=./secrets/efi-homologacao.p12
#  (b) Railway/PaaS — conteúdo do .p12 em base64 (tem prioridade sobre o PATH):
#      gere com:  base64 -w0 cert.p12   (Linux/macOS)
#      ou:        [Convert]::ToBase64String([IO.File]::ReadAllBytes("cert.p12"))   (PowerShell)
# EFI_CERTIFICATE_BASE64=
# Chave Pix da sua conta que recebe os pagamentos (para criar a cobrança /v2/cob)
EFI_PIX_KEY=sua-chave-pix-aqui
# Segredo compartilhado do webhook de ENTRADA (Efí). Se definido, o endpoint
# /webhooks/efi/pix exige ?token=<segredo> (ou header x-webhook-token) — registre
# o webhook com esse token na URL. Se vazio, vale só o mTLS na borda + re-consulta.
EFI_WEBHOOK_SECRET=defina-um-segredo-forte

# Outbox poller
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100
# Após N falhas de publicação, o evento vira DEAD (dead-letter → não bloqueia a fila).
OUTBOX_MAX_ATTEMPTS=10

# Escala / resiliência
# Conexões do pool do Postgres por instância (N réplicas × este valor não pode
# estourar o max_connections do banco — use pooler/pgbouncer em escala).
# OBS: o LISTEN usa +1 conexão dedicada (fora do pool) por instância.
DATABASE_POOL_MAX=10
# LISTEN/NOTIFY acorda os workers na hora (latência ~ms em vez de até o intervalo
# de poll). DESLIGUE (false) atrás de PgBouncer em transaction/statement pooling
# (não suporta LISTEN) — o poll periódico continua processando normalmente.
PG_LISTEN_ENABLED=true
# Limpeza periódica de chaves de idempotência expiradas (ms).
IDEMPOTENCY_CLEANUP_INTERVAL_MS=300000
# Rate limit por consumidor (req/min). Excedeu → 429. (Por instância.)
RATE_LIMIT_PER_MINUTE=600

# Modo assíncrono (opt-in p/ picos): true = POST /payments responde 202 e um worker
# cria a cobrança na Efí depois (cliente consulta GET /payments/:id). false = síncrono.
ASYNC_CHARGE_CREATION=false
CHARGE_WORKER_INTERVAL_MS=1000
CHARGE_WORKER_BATCH_SIZE=20
# Cobranças criadas em paralelo por ciclo (vazão por instância).
CHARGE_WORKER_CONCURRENCY=5
CHARGE_MAX_ATTEMPTS=5
# Lease: tempo até um claim "preso" voltar à fila p/ nova tentativa (ms).
CHARGE_CLAIM_STALE_MS=60000

# Reconciliação (rede de segurança p/ webhooks perdidos)
RECONCILE_INTERVAL_MS=60000
RECONCILE_BATCH_SIZE=50

# Webhook de saída (notificar consumidores)
WEBHOOK_DELIVERY_INTERVAL_MS=2000
WEBHOOK_DELIVERY_BATCH_SIZE=50
WEBHOOK_DELIVERY_MAX_ATTEMPTS=8
# Entregas em paralelo por ciclo (lote cabe no lease → evita re-entrega duplicada).
WEBHOOK_DELIVERY_CONCURRENCY=5
