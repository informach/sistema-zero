{
  "name": "@sistemazero/pinta",
  "version": "0.1.0",
  "description": "Pinta — editor de assets de jogos para crianças (pixel art, animações, tiles e desenho vetorial); consumido como TS source pelos apps do monorepo.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets/index.ts",
    "./lesson": "./src/lesson/index.ts",
    "./studio-library": "./src/export/studioLibrary.ts",
    "./styles.css": "./src/styles/pinta.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "gen:vector-fonts": "bun run scripts/gen-vector-fonts.ts",
    "dev": "vite --config playground/vite.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.546.0",
    "polygon-clipping": "^0.15.7",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@napi-rs/canvas": "^1.0.0",
    "@testing-library/react": "^16.0.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  }
}
