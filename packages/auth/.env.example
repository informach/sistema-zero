# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/auth — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env` (já está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3002
# Endereço de bind. `::` = dual-stack (IPv4+IPv6) — obrigatório p/ o private
# networking do Railway (`auth.railway.internal` resolve IPv6).
HOST=::
# Teto do corpo da requisição em bytes (anti-DoS). 16 KB (cadastros/login são pequenos).
MAX_REQUEST_BODY_BYTES=16384
# Confiar no header X-Forwarded-For (ligue só atrás de proxy/LB confiável — ex.: o gateway).
TRUST_PROXY=false
# Nº de proxies confiáveis na frente do app (IP do cliente = N-ésima entrada do
# X-Forwarded-For a partir da direita). Atrás de 1 proxy, use 1.
TRUSTED_PROXY_HOPS=1

# Banco COMPARTILHADO do monorepo (`sistemazero`); este package é dono do schema
# `auth` (isolado por pgSchema). Porta 5433 em dev (a 5432 costuma estar ocupada).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
# Conexões do pool por instância.
DATABASE_POOL_MAX=10

# ── JWT (emissão de tokens) ────────────────────────────────────────────────
# Algoritmo de assinatura: HS256 (segredo compartilhado, simples) ou RS256
# (par de chaves + JWKS; o gateway nunca segura a chave privada — recomendado p/ prod).
JWT_ALG=HS256
JWT_ISSUER=sistemazero-auth
JWT_AUDIENCE=sistemazero
# Tempo de vida do access token (segundos). Curto por segurança (refresh renova).
ACCESS_TOKEN_TTL_SECONDS=900
# Tempo de vida do refresh token (dias).
REFRESH_TOKEN_TTL_DAYS=30

# HS256: segredo simétrico (mín. 32 chars). DEVE ser igual ao JWT_HS256_SECRET do gateway.
JWT_HS256_SECRET=troque-este-segredo-de-no-minimo-32-caracteres

# RS256 (opcional; só quando JWT_ALG=RS256):
#  - JWT_PRIVATE_KEY: chave privada PKCS#8 PEM (assina os tokens).
#  - JWT_PUBLIC_KEY:  chave pública SPKI PEM (opcional; derivada da privada se ausente).
#  - JWT_KID:         identificador da chave exposto na JWKS (rotação).
# Em produção com RS256, JWT_PRIVATE_KEY é OBRIGATÓRIA (fail-fast no boot).
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KID=auth-key-1

# Política de senha (mínimo de caracteres no registro).
PASSWORD_MIN_LENGTH=10

# ── Reset/definição de senha ───────────────────────────────────────────────
# Validade do token de redefinição (minutos). Single-use, 1 token vivo por usuário.
RESET_TOKEN_TTL_MINUTES=60
# Cooldown POR CONTA entre pedidos públicos de reset (segundos; 0 desliga). O rate
# limit do gateway é por IP — isto fecha o spam de inbox por IPs distribuídos.
# NÃO se aplica aos fluxos S2S/convite.
RESET_REQUEST_COOLDOWN_SECONDS=60
# Base dos links enviados por e-mail (app community): `/redefinir-senha?token=...`.
COMMUNITY_URL=http://localhost:3007
# Token interno injetado pelo gateway nas rotas /auth/internal/* (defesa em
# profundidade). Vazio/ausente = checagem desligada (SÓ em dev — em PRODUÇÃO é
# OBRIGATÓRIO, ≥ 16 chars, fail-fast no boot). DEVE casar com o
# AUTH_INTERNAL_TOKEN do gateway.
# AUTH_INTERNAL_TOKEN=troque-este-token-interno

# ── OTP (login passwordless + recuperação de senha por código) ─────────────
# Validade do código de 6 dígitos (minutos). Um código ativo por (usuário, finalidade).
OTP_TTL_MINUTES=10
# Palpites errados antes de o código TRAVAR (anti-brute-force). O e-mail do código
# sai pelo mesmo caminho do reset (auth → gateway → messaging, template `otp`).
OTP_MAX_ATTEMPTS=5
# Cooldown POR CONTA entre pedidos de código (segundos; 0 desliga) — mesma lógica
# do RESET_REQUEST_COOLDOWN_SECONDS.
OTP_REQUEST_COOLDOWN_SECONDS=60

# ── Envio de e-mail (auth → gateway → messaging) ───────────────────────────
# O auth assina HMAC de borda como consumer `auth` (igual ao funil). Sem
# GATEWAY_URL + AUTH_HMAC_SECRET o envio fica DESLIGADO (no-op; best-effort).
# GATEWAY_URL=http://localhost:3000
AUTH_CONSUMER_ID=auth
# DEVE casar com o AUTH_HMAC_SECRET do gateway (mín. 16 chars).
# AUTH_HMAC_SECRET=troque-este-segredo-hmac-do-auth
