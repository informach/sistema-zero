{
  "name": "@sistemazero/auth",
  "version": "0.1.0",
  "description": "Serviço de identidade (IdP): registro/login, usuários, papéis (RBAC) e emissão de JWT (access + refresh) — DDD + Hexagonal",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed-admin.ts",
    "db:backfill-profiles": "bun run scripts/backfill-default-profiles.ts",
    "check": "biome check . && bun run check:migrations",
    "check:migrations": "bun run scripts/migration-safety.ts",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@sentry/bun": "^10.56.0",
    "@sistemazero/core": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.4.9",
    "jose": "^6.2.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
