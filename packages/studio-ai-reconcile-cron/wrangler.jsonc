{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistemazero-studio-ai-reconcile-unconfigured",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "vars": { "ENVIRONMENT": "unconfigured", "KIDS_ORIGIN": "" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "sistemazero-studio-ai-reconcile-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "KIDS_ORIGIN": "https://community-kids-staging.up.railway.app"
      },
      "secrets": { "required": ["STUDIO_AI_RECONCILE_CRON_SECRET"] },
      "triggers": { "crons": ["* * * * *"] }
    },
    "production": {
      "name": "sistemazero-studio-ai-reconcile-production",
      "vars": {
        "ENVIRONMENT": "production",
        "KIDS_ORIGIN": "https://kids.sistemazero.com.br"
      },
      "secrets": { "required": ["STUDIO_AI_RECONCILE_CRON_SECRET"] },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
