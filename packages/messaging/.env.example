# @sistemazero/messaging — exemplo de ambiente (sem segredos reais)
NODE_ENV=development
PORT=3006
# Bind dual-stack (IPv4+IPv6) — obrigatório p/ private networking do Railway (IPv6).
HOST=::

# Postgres compartilhado do monorepo (Docker na porta 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
DATABASE_POOL_MAX=10

# Admin: confere os X-Auth-User-* injetados pelo gateway (defesa em profundidade).
# Desligue (false) só em dev quando bater no serviço SEM passar pelo gateway.
# ⚠️ Em PRODUÇÃO o boot exige true (fail-closed).
REQUIRE_ADMIN=true
# Token interno injetado pelo gateway nas rotas de envio (S2S). Vazio = checagem desligada (dev).
# ⚠️ Em PRODUÇÃO o boot exige um valor (fail-closed).
MESSAGING_INTERNAL_TOKEN=

# Logos dos e-mails: EMBUTIDAS na mensagem (attachment inline + cid:, padrão do
# comunidade-sistema-zero) a partir de `assets/logo-sistema-zero-{light,dark}.png`.
# Nada a configurar — sem hospedagem externa, funciona igual em dev e prod.

# ── SendGrid (e-mail) ─────────────────────────────────────────────────────────
# Sem a key o serviço sobe; envios de e-mail enfileiram e falham no worker até
# configurar a key + cadastrar um remetente default (/messaging/admin/senders).
# SENDGRID_API_KEY=
# Chave pública (base64) do "Signed Event Webhook" — habilita a verificação ECDSA.
# ⚠️ Em PRODUÇÃO com SENDGRID_API_KEY, o boot a exige (fail-closed).
# SENDGRID_WEBHOOK_PUBLIC_KEY=
# Janela (s) de tolerância do timestamp assinado do webhook (anti-replay).
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=600

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
# ⚠️ NÃO deixe EVOLUTION_URL= vazio: a validação exige URL válida OU a var AUSENTE
# (descomente só quando tiver a URL real).
# EVOLUTION_URL=
# EVOLUTION_API_KEY=
# Segredo exigido em ?token= nos webhooks (defesa extra). ⚠️ Vazio falha o boot —
# OMITA a linha para desabilitar (dev). Em PRODUÇÃO o boot exige um valor (fail-closed).
# MESSAGING_WEBHOOK_TOKEN=

# ── Outbox / workers ──────────────────────────────────────────────────────────
# Teto MAIOR só p/ webhooks de status (a SendGrid posta LOTES de até 768KB).
WEBHOOK_MAX_BODY_BYTES=2097152
# Retenção de mensagens TERMINAIS (rendered_body cresce ~6KB/linha sem expurgo).
MESSAGES_RETENTION_DAYS=90
# Token do GET /metrics (≥16 chars; header x-metrics-token ou Bearer).
# ⚠️ Em PRODUÇÃO o boot o exige (fail-closed).
# METRICS_TOKEN=
# Sentry (erros; ausente = desligado). Em prod: DSN do projeto sistema-zero-messaging.
# SENTRY_DSN=

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
PG_LISTEN_ENABLED=true
SEND_POLL_INTERVAL_MS=3000
SEND_BATCH_SIZE=50
MAX_SEND_ATTEMPTS=5
# Lease do claim de envio (ms): mensagem presa em SENDING (crash) volta à fila
# depois disto. Deve cobrir o pior caso claim→update (lote sequencial + timeout).
SEND_CLAIM_LEASE_MS=600000
CLEANUP_INTERVAL_MS=300000
RETENTION_DAYS=30

# ── E-mail: throttle ──────────────────────────────────────────────────────────
EMAIL_RATE_PER_SEC=5

# ── WhatsApp: ritmo anti-ban (ver domain/services/pacing.ts) ──────────────────
WA_MIN_DELAY_MS=15000
WA_MAX_DELAY_MS=45000
WA_REST_AFTER_N=50
WA_REST_DURATION_MS=600000
WA_WARMUP_DAYS=10
WA_WARMUP_START_CAP=20
WA_LANE_LEASE_MS=60000
SEND_RETRY_BASE_MS=30000
SEND_RETRY_MAX_MS=3600000
