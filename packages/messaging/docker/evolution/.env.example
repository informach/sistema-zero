# Evolution API v2 — exemplo (copie p/ .env e preencha a chave)
# Chave de autenticação da API (header `apikey`) — a MESMA vai no EVOLUTION_API_KEY do messaging.
AUTHENTICATION_API_KEY=troque-me

SERVER_URL=http://localhost:8080
DEL_INSTANCE=false
LANGUAGE=en

# Banco: o MESMO Postgres do monorepo (sistemazero), schema separado `evolution`.
# `host.docker.internal` = host visto de dentro do container (Docker Desktop).
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@host.docker.internal:5433/sistemazero?schema=evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_dev
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Cache local (sem Redis em dev — 1 réplica)
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true
