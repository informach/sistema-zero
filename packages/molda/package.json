{
  "name": "@sistemazero/molda",
  "version": "0.1.0",
  "description": "Molda — a oficina 3D dos jogos kids (modelos low poly, texturas e céus HDR para o Estúdio); consumido como TS source pelos apps do monorepo.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets/index.ts",
    "./studio-library": "./src/export/studioLibrary.ts",
    "./styles.css": "./src/styles/molda.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "vite --config playground/vite.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.546.0",
    "three": "^0.184.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.0.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.14"
  }
}
