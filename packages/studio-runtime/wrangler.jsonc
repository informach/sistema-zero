{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistemazero-studio-runtime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "PRO_ARTIFACTS",
      "bucket_name": "sistemazero-studio-artifacts"
    },
    {
      "binding": "PYTHON_INPUTS",
      "bucket_name": "sistemazero-studio-artifacts"
    },
    {
      "binding": "PYTHON_PREVIEWS",
      "bucket_name": "sistemazero-studio-artifacts"
    }
  ],
  "containers": [
    {
      "class_name": "ProBuildSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 50
    },
    {
      "class_name": "ThreeDCheckSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CheckSandboxPool",
        "name": "CheckSandboxPools"
      },
      {
        "class_name": "ProBuildSandbox",
        "name": "ProBuildSandbox"
      },
      {
        "class_name": "ThreeDCheckSandbox",
        "name": "ThreeDCheckSandbox"
      },
      {
        "class_name": "PythonInspectionJob",
        "name": "PythonInspectionJobs"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ProBuildSandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["PythonInspectionJob"],
      "tag": "v2-python-inspection-jobs"
    },
    {
      "new_sqlite_classes": ["ThreeDCheckSandbox"],
      "tag": "v3-three-d-check-sandbox"
    },
    {
      "new_sqlite_classes": ["CheckSandboxPool"],
      "tag": "v4-exclusive-check-sandbox-pool"
    }
  ],
  "ratelimits": [
    {
      "name": "PYTHON_UPLOAD_RATE_LIMITER",
      "namespace_id": "27003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "BUILD_RATE_LIMITER",
      "namespace_id": "27001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "STUDIO_CHECK_WARMING_ENABLED": "1",
    "STUDIO_PYTHON_DISTRIBUTIONS_SHA256": "2c53c74ce96be00412438117a39bbcf82af763c6c99be3783beaa6317a00b57d",
    "STUDIO_PYTHON_PREVIEW_ORIGIN": "https://sistemazero-studio-runtime.helena-bcc.workers.dev",
    "PUBLICATION_AUTHORIZATION_URL": "https://kids.sistemazero.com.br/api/internal/studio-play",
    "PUBLICATION_AUTHORIZATION_ADULT_URL": "https://comunidade.sistemazero.com.br/api/internal/studio-play",
    "PUBLICATION_CLEANUP_URL": "https://kids.sistemazero.com.br/api/internal/studio-publication-cleanup",
    "PUBLICATION_CLEANUP_ADULT_URL": "https://comunidade.sistemazero.com.br/api/internal/studio-publication-cleanup"
  },
  "env": {
    "staging": {
      "name": "sistemazero-studio-runtime-staging",
      "vars": {
        "STUDIO_CHECK_WARMING_ENABLED": "1",
        "STUDIO_PYTHON_DISTRIBUTIONS_SHA256": "05294b0e0df2ed0a128bde227a927c7f88fef3db784baf59368ae0246ee22ead",
        "STUDIO_PYTHON_PREVIEW_ORIGIN": "https://sistemazero-studio-runtime-staging.helena-bcc.workers.dev",
        "PUBLICATION_AUTHORIZATION_URL": "https://community-kids-staging.up.railway.app/api/internal/studio-play",
        "PUBLICATION_AUTHORIZATION_ADULT_URL": "https://community-staging-66f2.up.railway.app/api/internal/studio-play",
        "PUBLICATION_CLEANUP_URL": "https://community-kids-staging.up.railway.app/api/internal/studio-publication-cleanup",
        "PUBLICATION_CLEANUP_ADULT_URL": "https://community-staging-66f2.up.railway.app/api/internal/studio-publication-cleanup"
      },
      "r2_buckets": [
        {
          "binding": "PRO_ARTIFACTS",
          "bucket_name": "sistemazero-studio-artifacts-staging"
        },
        {
          "binding": "PYTHON_INPUTS",
          "bucket_name": "sistemazero-studio-artifacts-staging"
        },
        {
          "binding": "PYTHON_PREVIEWS",
          "bucket_name": "sistemazero-studio-artifacts-staging"
        }
      ],
      "containers": [
        {
          "class_name": "ProBuildSandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-2",
          "max_instances": 50
        },
        {
          "class_name": "ThreeDCheckSandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-4",
          "max_instances": 10
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "CheckSandboxPool",
            "name": "CheckSandboxPools"
          },
          {
            "class_name": "ProBuildSandbox",
            "name": "ProBuildSandbox"
          },
          {
            "class_name": "ThreeDCheckSandbox",
            "name": "ThreeDCheckSandbox"
          },
          {
            "class_name": "PythonInspectionJob",
            "name": "PythonInspectionJobs"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "PYTHON_UPLOAD_RATE_LIMITER",
          "namespace_id": "27004",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "BUILD_RATE_LIMITER",
          "namespace_id": "27002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
