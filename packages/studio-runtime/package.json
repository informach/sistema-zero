{
  "name": "@sistemazero/studio-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "audit:image": "npm audit --package-lock-only --omit=dev --prefix runtime",
    "build:image": "docker build --tag sistemazero-studio-runtime:verify .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.10.3",
    "@sistemazero/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "@types/bun": "^1.3.14",
    "parse5": "7.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
