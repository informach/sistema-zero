{
  "name": "@sistemazero/studio-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:validation-profile": "bun scripts/validation-profile.ts",
    "check:validation-profile": "bun scripts/validation-profile.ts --check",
    "dev": "wrangler dev",
    "deploy": "bun run check:validation-profile && wrangler deploy",
    "deploy:staging": "bun run check:validation-profile && wrangler deploy --env staging",
    "audit:image": "npm audit --package-lock-only --omit=dev --prefix runtime",
    "build:image": "bun run check:validation-profile && docker build --load --platform linux/amd64 --provenance=false --tag sistemazero-studio-runtime:verify .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "typecheck:promoter": "node scripts/check-python-operational-types.ts",
    "test": "bun test",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.10.3",
    "@sistemazero/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "@types/bun": "^1.3.14",
    "@types/node": "24.19.0",
    "parse5": "7.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
