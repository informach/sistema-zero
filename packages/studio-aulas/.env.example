# Copie para `.env` e preencha. NUNCA commite o `.env` (está no .gitignore).
# As chaves só são exigidas quando você roda a etapa que as usa (voz/avatar);
# as etapas de roteiro, tela e montagem parcial rodam sem nenhuma chave.

# --- ElevenLabs (etapa 2: voz clonada) ---
# Painel: https://elevenlabs.io  →  Profile  →  API Key
ELEVENLABS_API_KEY=
# ID da SUA voz clonada (Voices → sua voz → "ID"). Ex.: 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=
# Opcional. Modelo de TTS. Deixe em branco para o padrão do cliente.
ELEVENLABS_MODEL_ID=

# --- HeyGen (etapa 3: avatar com lip-sync) ---
# Painel: https://app.heygen.com  →  Space Settings  →  API
HEYGEN_API_KEY=
# ID do avatar (Avatars → seu avatar → detalhes).
HEYGEN_AVATAR_ID=
