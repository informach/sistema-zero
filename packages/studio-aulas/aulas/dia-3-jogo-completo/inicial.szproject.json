{
  "id": "01KVZVXA9SBCXS1QYZ2VY6TWXK",
  "name": "Meu primeiro jogo",
  "createdAt": 1782407145785,
  "updatedAt": 1783018726772,
  "mode": "blocks",
  "files": {
    "index.html": "<!doctype html>\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Meu primeiro jogo</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
    "style.css": "",
    "script.js": "// Gerado pelo Sistema Zero Studio\n\nSZGame2D.setupStage(800, 480, \"#1a2240\");\nconst nave = SZGame2D.createShip({ x: 400, y: 410, w: 54, h: 62, body: \"#f87171\", wings: \"#60a5fa\" });\nconst tiros = SZGame2D.createGroup();\nconst asteroides = SZGame2D.createGroup();\nlet pontos = 0;\nSZGame2D.onKey(\"Space\", function () {\n  SZGame2D.spawnBullet(tiros, { x: SZGame2D.centerX(nave), y: SZGame2D.spriteY(nave), radius: 5, color: \"#a3e635\", vx: 0, vy: -9 });\n  SZGame2D.playShoot();\n});\nSZGame2D.gameLoop(function update() {\n  SZGame2D.clear();\n  SZGame2D.drawStarfield(ctx, 1);\n  SZGame2D.arrowsX(nave, 7);\n  SZGame2D.clampToScreen(nave, ctx);\n  SZGame2D.drawSprite(ctx, nave);\n  SZGame2D.updateGroup(tiros);\n  SZGame2D.pruneOffscreen(ctx, tiros, 40, function (sprite) {\n\n  });\n  SZGame2D.drawGroup(ctx, tiros);\n  if (SZGame2D.everyFrames(\"cada\", 40)) {\n    SZGame2D.spawnAsteroid(asteroides, { x: SZGame2D.randomX(), y: -30, size: 40, color: \"#aab1cf\", vx: 0, vy: 3 });\n  }\n  SZGame2D.updateGroup(asteroides);\n  SZGame2D.drawGroup(ctx, asteroides);\n  SZGame2D.pruneOffscreen(ctx, asteroides, 40, function (sprite) {\n\n  });\n  SZGame2D.overlapGroups(tiros, asteroides, function (tiro, asteroide) {\n    SZGame2D.removeFromGroup(tiros, tiro);\n    SZGame2D.removeFromGroup(asteroides, asteroide);\n    pontos = pontos + 1;\n    SZGame2D.explodeSprite(asteroide, \"#fb923c\");\n    SZGame2D.playExplosion();\n  });\n  SZGame2D.drawScore(ctx, \"Pontos:\", pontos, 12, 30, \"#ffffff\", 24);\n});\n"
  },
