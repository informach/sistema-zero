{
  "name": "@sistemazero/studio-aulas",
  "version": "0.1.0",
  "description": "Pipeline de produção de aulas do curso infantil (roteiro → voz → avatar → tela do Estúdio → balões/teoria → vídeo). Pacote de FERRAMENTA, isolado: não altera nenhum outro package; só importa @sistemazero/studio no harness de gravação.",
  "type": "module",
  "private": true,
  "module": "src/cli.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "remotion": "remotion studio remotion/index.ts",
    "aula": "bun run src/cli.ts",
    "aula:voz": "bun run src/cli.ts voz",
    "aula:avatar": "bun run src/cli.ts avatar",
    "aula:tela": "bun run src/cli.ts tela",
    "aula:render": "bun run src/cli.ts render",
    "aula:all": "bun run src/cli.ts all"
  },
  "dependencies": {
    "@sistemazero/studio": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@remotion/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
