# ── Obrigatórias ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
# Espelhado no HELPDESK_INTERNAL_TOKEN do api-gateway (defesa em profundidade).
INTERNAL_API_TOKEN=troque-por-um-token-de-16+chars

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3013
# HOST=::
# MAX_REQUEST_BODY_BYTES=524288
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# REQUIRE_STAFF=true          # false só em dev sem gateway
# SENTRY_DSN=

# ── OAuth Google (Gmail) — grupo ATÔMICO: qualquer um ausente → conexão 503 ──
# ⚠️ Client OAuth PRÓPRIO (separado do marketing), consent screen INTERNAL na
# org Workspace (app External em Testing expira o refresh token em 7 dias).
# Redirect URI: <OAUTH_PUBLIC_BASE_URL>/helpdesk/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 32 bytes em base64: openssl rand -base64 32
# HELPDESK_TOKEN_ENC_KEY=
# Origem pública do gateway (monta a redirect_uri do callback).
# OAUTH_PUBLIC_BASE_URL=http://localhost:3000
# URL do helpdesk-app (destino do 302 pós-callback).
# HELPDESK_APP_URL=http://localhost:3014
# Única caixa autorizada a alimentar a fila. Default: contato@sistemazero.com.br.
# HELPDESK_MAILBOX_ADDRESS=contato@sistemazero.com.br
# OAUTH_STATE_TTL_MINUTES=10

# ── Sync do Gmail ─────────────────────────────────────────────────────────────
# GMAIL_POLL_INTERVAL_MS=45000
# GMAIL_SYNC_LEASE_MS=120000
# GMAIL_SYNC_MAX_ATTEMPTS=5
# GMAIL_BACKFILL_QUERY=newer_than:7d
# GMAIL_FETCH_BATCH_SIZE=25
# TOKEN_REFRESH_MARGIN_MS=300000

# ── IA (OpenRouter) — fail-soft: ausente = tickets sem IA ─────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_HELPDESK_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_REFERER=
# AI_WORKER_INTERVAL_MS=15000
# AI_MAX_ATTEMPTS=3
# AI_TIMEOUT_MS=60000
# AI_MAX_THREAD_CHARS=24000

# ── Aviso por e-mail da resposta do PORTAL (gateway → messaging) — grupo ATÔMICO:
# qualquer um ausente = a resposta no portal segue funcionando, só o e-mail não sai ──
# Em deploy: http://api-gateway.railway.internal:3000
# GATEWAY_URL=http://localhost:3000
# Secret do consumer HMAC de borda `helpdesk` no gateway (o MESMO valor lá).
# HELPDESK_HMAC_SECRET=troque-por-32-chars-aleatorios
# S2S_TIMEOUT_MS=10000
# Origens PÚBLICAS das áreas do aluno (link do aviso: /ajuda e /responsavel/ajuda).
# COMMUNITY_URL=http://localhost:3007
# KIDS_COMMUNITY_URL=http://localhost:3008

# ── Retenção ──────────────────────────────────────────────────────────────────
# RETENTION_CLEANUP_INTERVAL_MS=21600000
