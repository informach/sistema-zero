# Certificado A1 (e-CNPJ) — escolha UM dos dois:
NFSE_CERT_PFX_PATH=spike/secrets/certificado.pfx
#NFSE_CERT_PFX_BASE64=
NFSE_CERT_PASSWORD=

# Ambiente — o spike SÓ roda em producao-restrita (default). NÃO setar producao.
#NFSE_AMBIENTE=producao-restrita

# Numeração de teste (série própria do sistema; Emissor Web usa a série dele)
NFSE_DPS_SERIE=2
NFSE_DPS_NUMERO=1

# Assinatura: sha1 (convenção NF-e, default) | sha256 (se a Sefin rejeitar sha1)
#NFSE_SIG_ALGO=sha1

# Lei 12.741 — alíquota efetiva do Simples (pTotTribSN); confirmar com o contador
#NFSE_PTOTTRIB_SN=8.24

# Código de tributação municipal de BH (confirmar no spike 00 via parametrização)
#NFSE_CTRIB_MUN=001

# Dados da nota de teste
#NFSE_TOMADOR_CPF=52998224725
#NFSE_TOMADOR_NOME=Comprador de Teste do Spike
#NFSE_VALOR=37.00
#NFSE_DESCRICAO=Pack Do Zero ao Herói - curso online (TESTE)
#NFSE_DCOMPET=2026-06-12
