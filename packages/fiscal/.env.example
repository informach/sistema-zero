# ── Básico ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Obrigatório quando NODE_ENV=production: 'staging' | 'production'.
# production ⇒ NFSE_AMBIENTE=producao · staging ⇒ producao-restrita (boot falha se cruzar).
#APP_ENV=staging
PORT=3009
HOST=::
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero

# ── Sefin Nacional ────────────────────────────────────────────────────────────
# producao-restrita (default) = homologação do governo (nota SEM validade jurídica).
# 'producao' é RECUSADO fora de NODE_ENV=production.
NFSE_AMBIENTE=producao-restrita
# Certificado A1 (e-CNPJ): base64 do .pfx no Railway, ou caminho local em dev.
#NFSE_CERT_PFX_BASE64=
NFSE_CERT_PFX_PATH=spike/secrets/certificado.pfx
NFSE_CERT_PASSWORD=
# Série PRÓPRIA do sistema (o Emissor Web usa a dele — sem conflito de numeração).
# ⚠️ A numeração na Sefin é por CNPJ+série e a Produção Restrita é COMPARTILHADA
# entre ambientes → use séries distintas: dev=901 · staging=902 · produção=2.
# REFINE: staging NÃO pode usar a série 2; produção NÃO pode usar 901/902 (boot falha).
NFSE_DPS_SERIE=901
# Algoritmo da assinatura XMLDSig: 'sha1' (aceito hoje) | 'sha256' (escape se a
# Sefin endurecer — SHA-1 está em depreciação nos DF-e). Default sha1.
#NFSE_SIG_ALGO=sha1
# Inscrição Municipal (BH exige — E0116). Obrigatória em produção.
NFSE_IM=13372670018
# Lei 12.741 (forma simplificada do Simples): alíquota efetiva — MUDA com o
# faturamento; atualize quando o contador avisar.
NFSE_PTOTTRIB_SN=8.24
# Código de tributação municipal de BH (aceito na Produção Restrita).
NFSE_CTRIB_MUN=001
# Prefixo da discriminação do serviço na nota: "<prefixo> - <nome do produto>".
NFSE_SERVICE_DESC_PREFIX=Treinamento on-line

# ── Agendamento ───────────────────────────────────────────────────────────────
# Oferta sem garantia declarada → emite após N dias (CDC art. 49 = 7).
NFSE_DEFAULT_GUARANTEE_DAYS=7
NFSE_EMIT_BUFFER_HOURS=12

# ── Integrações S2S ───────────────────────────────────────────────────────────
# ⚠️ Em produção/staging NÃO podem ser localhost (cada serviço é um host — boot falha).
PAYMENTS_BASE_URL=http://localhost:3001
# = INTERNAL_API_TOKEN do payments (rota interna GET /payments/internal/payments/:id).
#PAYMENTS_INTERNAL_TOKEN=
# = hmac_secret do consumer `fiscal` no payments (saída do db:seed de lá).
#PAYMENTS_WEBHOOK_HMAC_SECRET=
CATALOG_BASE_URL=http://localhost:3003
# E-mail da nota: gateway + consumer HMAC de borda `fiscal` (= FISCAL_HMAC_SECRET do gateway).
# CO-DEPENDENTES e OBRIGATÓRIOS em produção (APP_ENV=production): sem eles a nota é
# emitida mas o comprador NUNCA recebe o DANFSe (o cliente no-op NÃO marca enviado).
#GATEWAY_URL=http://localhost:3000
#FISCAL_HMAC_SECRET=
# URL DESTE serviço alcançável pelo MESSAGING (capability-URL do anexo PDF).
# Em produção: http://fiscal.railway.internal:3009 (NÃO pode ser localhost em prod).
FISCAL_SELF_URL=http://localhost:3009

# ── Borda própria ─────────────────────────────────────────────────────────────
# = FISCAL_INTERNAL_TOKEN do gateway (prova de origem nas rotas admin). Obrigatório em prod.
#INTERNAL_API_TOKEN=
REQUIRE_ADMIN=true
#METRICS_TOKEN=
#SENTRY_DSN=
