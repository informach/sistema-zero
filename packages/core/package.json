{
  "name": "@sistemazero/core",
  "version": "0.1.0",
  "description": "Utilidades compartilhadas do monorepo sistema-zero (security, logging, errors, result, http, time) — sem dependência de framework.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    "./identity": "./src/identity/index.ts",
    "./pensa": "./src/pensa/index.ts",
    "./live": "./src/live/index.ts",
    ".": "./src/index.ts",
    "./ai-credits": "./src/ai-credits/index.ts",
    "./journey": "./src/journey/index.ts",
    "./help": "./src/help/index.ts",
    "./referrals": "./src/referrals/index.ts",
    "./course/modality": "./src/course/modality.ts",
    "./course/module-animation": "./src/course/module-animation.ts",
    "./creations": "./src/creations/index.ts",
    "./security": "./src/security/index.ts",
    "./logging": "./src/logging/index.ts",
    "./errors": "./src/errors/index.ts",
    "./result": "./src/result/index.ts",
    "./http": "./src/http/index.ts",
    "./studio": "./src/studio/index.ts",
    "./staff": "./src/staff/index.ts",
    "./studio/*": "./src/studio/*.ts",
    "./time": "./src/time/index.ts",
    "./billing": "./src/billing/index.ts",
    "./zappy": "./src/zappy/index.ts",
    "./course/publication-media": "./src/course/publication-media.ts",
    "./course/publication": "./src/course/publication.ts",
    "./learning": "./src/learning/index.ts",
    "./learning/scene": "./src/learning/scene/index.ts",
    "./palette": "./src/palette/index.ts",
    "./profiles": "./src/profiles/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
