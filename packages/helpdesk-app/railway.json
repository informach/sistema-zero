{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/helpdesk-app/Dockerfile",
    "watchPatterns": [
      "/packages/helpdesk-app/**",
      "/packages/ui/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
