{
  "name": "@sistemazero/marketing-desktop",
  "version": "0.1.0",
  "description": "Produção colaborativa de marketing com execução local e sincronização com o Sistema Zero",
  "author": "Sistema Zero",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "bun run prepare:runtime && electron .",
    "prepare:runtime": "bun run scripts/prepare-runtime.ts",
    "package": "bun run scripts/package-release.ts",
    "package:review": "bun run build && electron-builder --dir --config.forceCodeSigning=false --publish never",
    "test": "bun test",
    "test:local": "bun run scripts/test-local.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "smoke": "bun run prepare:runtime && electron . --smoke",
    "prove:providers": "bun run scripts/prove-providers.ts"
  },
  "dependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@remotion/install-whisper-cpp": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@sistemazero/marketing-contracts": "workspace:*",
    "@sistemazero/marketing-import": "workspace:*",
    "@sistemazero/marketing-production": "workspace:*",
    "@sistemazero/marketing-workbench": "workspace:*",
    "@sistemazero/studio": "workspace:*",
    "@sistemazero/ui": "workspace:*",
    "electron-updater": "6.8.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.535",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@remotion/bundler": "4.0.535",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.0",
    "vite": "8.3.4"
  },
  "optionalDependencies": {
    "@remotion/compositor-win32-x64-msvc": "4.0.535",
    "@remotion/compositor-darwin-arm64": "4.0.535",
    "@remotion/compositor-darwin-x64": "4.0.535"
  }
}
