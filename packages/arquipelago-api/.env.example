# Serviço do Arquipélago Vagalume (@sistemazero/arquipelago-api)
PORT=3015
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero

# Quem vê o jogo: desligado | lista | aberto (sem valor: aberto em dev, desligado em deploy)
ARQUIPELAGO_MODO=aberto
# Públicos com o jogo ligado (csv): kids, adulto
ARQUIPELAGO_PUBLICOS=kids
# Modo lista: ids de perfil (Kids) ou de conta, separados por vírgula. A equipe sempre entra.
ARQUIPELAGO_LISTA=

# Cliente compilado (bun run --filter @sistemazero/arquipelago build)
# ARQUIPELAGO_CLIENTE_DIR=../arquipelago/dist/cliente
# ARQUIPELAGO_SERVIR_MAPAS=true

# Borda (obrigatório em deploy): o mesmo valor do header-inject do gateway
# INTERNAL_API_TOKEN=
# SENTRY_DSN=
