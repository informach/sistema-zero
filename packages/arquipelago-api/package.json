{
  "name": "@sistemazero/arquipelago-api",
  "version": "0.1.0",
  "description": "Serviço do Arquipélago Vagalume: acesso, salvamento por revisão, tempo livre do Kids, limite da família e publicação do cliente do jogo. Schema Postgres próprio (arquipelago).",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@sentry/bun": "^10.56.0",
    "@sistemazero/arquipelago-contracts": "workspace:*",
    "@sistemazero/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.9",
    "postgres": "^3.4.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
