{
  "name": "@sistemazero/pensa",
  "version": "0.1.0",
  "description": "Pensa — definição de jogos e planejamento por missões funcionais para crianças; consumido como TS source pelos apps do monorepo.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/pensa.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "bun test src",
    "e2e": "playwright test",
    "e2e:native": "playwright test --config playwright.native.config.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "vite --config playground/vite.config.ts"
  },
  "dependencies": {
    "@sistemazero/core": "workspace:*",
    "@sistemazero/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@happy-dom/global-registrator": "^20.10.2",
    "@testing-library/react": "^16.0.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.14"
  }
}
