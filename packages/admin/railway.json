{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/admin/Dockerfile",
    "watchPatterns": [
      "/packages/admin/**",
      "/packages/core/**",
      "/packages/member-shell/**",
      "/packages/helpdesk-contracts/**",
      "/packages/pinta/**",
      "/packages/studio/**",
      "/packages/ui/**",
      "/bun.lock",
      "/package.json",
      "/.dockerignore",
      "/scripts/release/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
