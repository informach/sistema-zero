# URL do API Gateway (o BFF do admin chama o gateway, nunca os serviços direto).
GATEWAY_URL=http://localhost:3000

# Segredo HS256 do JWT — DEVE ser o MESMO do @sistemazero/auth e do gateway.
# O BFF verifica o access token (assinatura) com ele para gatear o painel.
JWT_HS256_SECRET=dev-please-change-me-min-32-chars-long-secret

# Opcionais: se o auth emitir iss/aud, casar aqui ativa a checagem (defesa em profundidade).
# JWT_ISSUER=sistemazero-auth
# JWT_AUDIENCE=sistemazero

NODE_ENV=development

# ── Upload de mídia (opcionais — sem eles os uploaders mostram "indisponível") ──

# Cloudflare R2 (imagens de curso/blocos, anexos e legendas VTT re-hospedadas).
# Crie um bucket + token de API S3 no painel da Cloudflare (R2 → Manage API Tokens).
# Convenção: dev usa o bucket `testes` · prod usa `comunidade-sistema-zero`.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=testes
# URL pública do bucket (custom domain ou r2.dev) — SEM barra final.
# Dev (r2.dev do bucket testes): https://pub-<hash>.r2.dev · Prod: https://cdn.sistemazero.com.br
# R2_PUBLIC_URL=https://media.sistemazero.com.br
# Bucket PRIVADO p/ materiais didáticos (anexos de aula) — SEM acesso público/r2.dev;
# o aluno baixa pela rota autenticada do community, que aplica a marca d'água.
# Mesmas credenciais R2 acima. Convenção: dev `testes-privado` · prod `comunidade-sistema-zero-privado`.
# R2_PRIVATE_BUCKET=testes-privado

# Vimeo (vídeos das aulas: upload resumável TUS + capa + transcrição automática).
# Token de acesso com scopes: upload, private, video_files, edit, interact.
# VIMEO_ACCESS_TOKEN=
# Domínios autorizados a EMBEDAR os vídeos (privacy whitelist), CSV.
# Inclua o domínio do app do aluno (community) em produção + localhost p/ dev.
# VIMEO_WHITELIST_DOMAINS=sistemazero.com.br,www.sistemazero.com.br,localhost
# Pasta (project) do Vimeo onde os vídeos entram (best-effort pós-ticket; ausente = sem pasta).
# Dev = "Testes" (29469881) · Prod = "Comunidade Sistema Zero" (29469887).
# VIMEO_FOLDER_ID=29469881
