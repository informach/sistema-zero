{
  "name": "@sistemazero/studio",
  "version": "0.1.0",
  "description": "Sistema Zero Studio — IDE educacional embarcável (modos Blocos/Ponte/Código + preview, terminal, IA e extensões), consumido como TS source pelos apps do monorepo.",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/studio/StudioEditor.tsx",
    "./project": "./src/core/project.ts",
    "./course-models": "./src/core/courseModels.ts",
    "./pro-toolchain": "./src/core/proToolchain.ts",
    "./pro-assets": "./src/core/proAssets.ts",
    "./python-assets": "./src/core/pythonAssets.ts",
    "./capture": "./src/capture/index.ts",
    "./blank-project": "./src/core/blankProject.ts",
    "./project-document": "./src/core/projectDocument.ts",
    "./project-publication": "./src/core/projectPublication.ts",
    "./project-import": "./src/projects/importSnapshot.ts",
    "./python-language": "./src/python/language/httpProvider.ts",
    "./python-authoring": "./src/python/blocks/authoring.ts",
    "./python-course-unlocks": "./src/python/course-unlocks.ts",
    "./course-language-access": "./src/core/courseLanguageAccess.ts",
    "./python-activity": "./src/activity/python.ts",
    "./lesson-runtime": "./src/runtime/lessonEnvironment.ts",
    "./contextual-runtime": "./src/runtime/contextEnvironment.ts",
    "./runtime-authority": "./src/studio/runtime-environment.tsx",
    "./public-runtime": "./src/runtime/publicEnvironment.ts",
    "./mastery-review-runtime": "./src/runtime/masteryReviewEnvironment.ts",
    "./project-factory": "./src/core/projectFactory.ts",
    "./authoring-options": "./src/core/authoringOptions.ts",
    "./free-project-options": "./src/core/freeProjectOptions.ts",
    "./project-migrations": "./src/project-migrations/index.ts",
    "./local-persistence": "./src/persistence/local.ts",
    "./project-list": "./src/projects/ProjectList.tsx",
    "./arte": "./src/arte/index.ts",
    "./jardim-quiz-artes": "./src/arte/jardim-quiz.generated.ts",
    "./moedas-quiz-artes": "./src/arte/moedas-quiz.generated.ts",
    "./cabana-quiz-artes": "./src/arte/cabana-quiz.generated.ts",
    "./ilha-farol-scene": "./src/arte/ilha-farol-scene.generated.ts",
    "./controls": "./src/controls/projectControls.ts",
    "./server-project-checks": "./src/blockly/projectCheckAuthoring.ts",
    "./server-check": "./src/check/serverCheck.ts",
    "./server-python-snapshot": "./src/runtime/python/snapshot.ts",
    "./server-catalog": "./src/blockly/blockCatalog.ts",
    "./server-knowledge": "./src/official-extensions/serverKnowledge.ts",
    "./server-examples": "./src/examples/serverExamples.ts",
    "./tutor-safety": "./src/studio/tutorSafety.ts",
    "./tutor-mode": "./src/studio/tutorMode.ts",
    "./player": "./src/components/preview/StudioProjectPlayer.tsx",
    "./personal-assets": "./src/asset-library/personal.ts",
    "./styles.css": "./src/styles/studio.css",
    "./project-validation": "./src/state/projectValidation.ts",
    "./editable-project-validation": "./src/state/editableProjectValidation.ts",
    "./python-snapshot": "./src/runtime/python/snapshot.ts",
    "./python-project-validation": "./src/state/pythonProjectValidation.ts"
  },
  "imports": {
    "#core": "./src/core/index.ts",
    "#ir": "./src/ir/index.ts",
    "#blockly": "./src/blockly/index.ts",
    "#monaco": "./src/monaco/index.ts",
    "#parsers": "./src/parsers/index.ts",
    "#generators": "./src/generators/index.ts",
    "#preview": "./src/preview/index.ts",
    "#extensions": "./src/extensions/index.ts",
    "#official-extensions": "./src/official-extensions/index.ts",
    "#ai": "./src/ai/index.ts",
    "#ui": "./src/ui-internal/index.ts"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test": "node scripts/test-isolated.mjs",
    "gen:pro-kits": "bun scripts/gen-pro-kit-lock.ts && bun scripts/gen-pro-kit-sources.ts && bun scripts/gen-pro-kit-grid.ts",
    "check:pro-kits": "bun pro-kits/canvas-survival/scripts/generate-pack.ts --check && bun scripts/gen-pro-kit-lock.ts --check && bun scripts/gen-pro-kit-sources.ts --check && bun scripts/gen-pro-kit-grid.ts --check",
    "test:grid-games": "bun test ./pro-kits/grid-games/tests",
    "test:canvas-survival": "bun test ./pro-kits/canvas-survival/tests/model.test.ts ./pro-kits/canvas-survival/tests/assets.test.ts ./pro-kits/canvas-survival/tests/controller.test.ts ./src/components/code/pro-templates/games/shared-arena.test.ts ./src/components/code/pro-templates/games/canvas-survival.test.ts",
    "verify:grid-export": "bun scripts/verify-pro-grid-export.ts",
    "verify:canvas-export": "bun scripts/verify-canvas-export.ts",
    "gen:pro-typescript-libs": "bun scripts/gen-pro-typescript-libs.ts",
    "check:pro-typescript-libs": "bun scripts/gen-pro-typescript-libs.ts --check",
    "gen:python-text-sources": "bun scripts/gen-python-text-sources.ts",
    "check:python-text-sources": "bun scripts/gen-python-text-sources.ts --check",
    "gen:python-visual-examples": "bun scripts/generate-visual-reference-games.ts && bun scripts/python/generate-visual-example-block-metadata.ts",
    "check:python-visual-examples": "bun scripts/generate-visual-reference-games.ts --check && bun scripts/python/generate-visual-example-block-metadata.ts --check",
    "gen:pgzero-games": "bun --no-env-file scripts/generate-pgzero-games.ts",
    "check:pgzero-games": "bun --no-env-file scripts/generate-pgzero-games.ts --check",
    "gen:raylib-games": "bun --no-env-file scripts/generate-raylib-games.ts",
    "check:raylib-games": "bun --no-env-file scripts/generate-raylib-games.ts --check",
    "gen:pygame-games": "bun --no-env-file scripts/generate-pygame-games.ts",
    "check:pygame-games": "bun --no-env-file scripts/generate-pygame-games.ts --check",
    "gen:server-examples": "bun scripts/gen-server-examples.ts",
    "gen:game-2d-recipes": "bun scripts/gen-game-2d-recipes.ts",
    "check:game-2d-recipes": "bun scripts/gen-game-2d-recipes.ts --check",
    "gen:game-2d-advanced-recipes": "bun scripts/gen-game-2d-advanced-recipes.ts",
    "check:game-2d-advanced-recipes": "bun scripts/gen-game-2d-advanced-recipes.ts --check",
    "gen:snow-descent": "bun scripts/gen-snow-descent.ts",
    "check:snow-descent": "bun scripts/gen-snow-descent.ts --check",
    "gen:core-example-catalog": "bun scripts/gen-core-example-catalog.ts",
    "gen:reino-zero-ultra": "bun scripts/gen-reino-zero-ultra.ts",
    "check:reino-zero-ultra": "bun scripts/gen-reino-zero-ultra.ts --check",
    "gen:game-3d-examples": "bun scripts/gen-game-3d-examples.ts",
    "check:game-3d-examples": "bun scripts/gen-game-3d-examples.ts --check",
    "gen:world-3d-examples": "bun scripts/gen-world-3d-examples.ts",
    "check:world-3d-examples": "bun scripts/gen-world-3d-examples.ts --check",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "e2e:gallery": "playwright test e2e/examples-gallery.spec.ts --project=chromium",
    "e2e:security": "playwright test e2e/preview-security.spec.ts e2e/preview-executes-user-code.spec.ts",
    "e2e:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "e2e:flush": "playwright test e2e/reload-flush.spec.ts",
    "serve:e2e": "bun scripts/serve-e2e.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "gen:game-ui-fonts": "bun scripts/gen-game-ui-fonts.ts"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "0.17.1",
    "@sistemazero/ui": "workspace:*",
    "@babel/parser": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@blockly/field-colour": "^6.0.12",
    "@blockly/toolbox-search": "^3.1.9",
    "@monaco-editor/react": "^4.6.0",
    "@sistemazero/core": "workspace:*",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "blockly": "^12.5.1",
    "csso": "^5.0.5",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "monaco-editor": "^0.52.2",
    "parse5": "8.0.0",
    "react-resizable-panels": "^2.1.9",
    "sucrase": "^3.35.1",
    "terser": "^5.37.0",
    "three": "0.184.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource/baloo-2": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "@happy-dom/global-registrator": "^20.10.2",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "24.19.0",
    "@types/csso": "^5.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "8.1.6"
  }
}
