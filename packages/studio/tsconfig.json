{
  // Standalone (não estende o tsconfig.base do monorepo): o studio foi escrito
  // com verbatimModuleSyntax desligado, e os "#imports" do package.json exigem
  // moduleResolution bundler. Espelha o tsconfig.base do repo de origem.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // The public-player browser fixture imports the real kids host, matching its Vite alias.
    "paths": { "@/*": ["../community-kids/src/*"] },
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["bun", "vite/client"]
  },
  "include": [
    "src",
    "playground",
    "e2e",
    "e2e-runtime",
    "e2e-python-editor",
    "e2e-pro-full",
    "scripts/project-migrations",
    "scripts/build-python-runtime.ts",
    "scripts/python",
    "scripts/gen-pro-kit-*.ts",
    "scripts/verify-canvas-*.ts",
    "scripts/verify-pro-*.ts",
    "scripts/verify-python-*.ts",
    "test-setup.ts",
    "playwright.config.ts",
    "playwright.pro-full.config.ts",
    "playwright.python-games.config.ts",
    "playwright.python-runtime.config.ts",
    "playwright.python-editor.config.ts",
    "playwright.python-live.config.ts",
    "playwright.python-boot.config.ts",
    "playwright.python-bridge.config.ts",
    "playwright.python-builder.config.ts"
  ],
  "exclude": ["node_modules"]
}
