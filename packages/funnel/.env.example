# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/funnel — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env` (já está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=4321
FUNNEL_PUBLIC_URL=http://localhost:4321
# Atrás de proxy confiável (Railway), o IP real do cliente vem do ÚLTIMO hop do
# x-forwarded-for (rate limit). OBRIGATÓRIO explicitar true|false em produção.
TRUST_PROXY=false

# Banco COMPARTILHADO do monorepo (`sistemazero`); este package é dono do schema
# `funil` (isolado por pgSchema). Porta 5433 em dev (a 5432 costuma estar ocupada).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
DATABASE_POOL_MAX=5

# Gateway = BFF de pagamentos. O funil NUNCA chama o payments direto.
# Em PRODUÇÃO (Railway) prefira o private networking — sem egress nem ida à
# internet: GATEWAY_URL=http://api-gateway.railway.internal:3000
GATEWAY_URL=http://localhost:3000
# Identidade do funil como consumer de BORDA do gateway (HMAC).
FUNNEL_CONSUMER_ID=funnel
# Segredo HMAC do funil — o MESMO valor deve estar em gateway.config consumers[].
FUNNEL_HMAC_SECRET=

# Webhook (gateway → funil): o gateway valida a assinatura do payments e injeta
# este token no encaminhamento interno. O funil confere o token.
FUNNEL_INTERNAL_TOKEN=

# Base do app do aluno (@sistemazero/community) — link de definir senha no e-mail
# de boas-vindas pós-compra (`/redefinir-senha?token=...`).
COMMUNITY_URL=http://localhost:3007
# Base do app KIDS (@sistemazero/community-kids) — destino do funil kids (botão da
# /obrigado + link do welcome). Funil pro usa COMMUNITY_URL.
KIDS_COMMUNITY_URL=http://localhost:3008

# Sentry (erros). Vazio/ausente = desligado (dev). Em produção use o DSN do
# projeto sistema-zero-funnel (org informach-nucleo-de-aprendizag).
SENTRY_DSN=

# Oferta POR FUNIL — slug da oferta no @sistemazero/catalog (preço/inclusões cotados
# AO VIVO por ele). UMA env por funil: `FUNNEL_OFFER_<KEY>` (key = audience/produto em
# MAIÚSCULAS, não-alfanumérico → "_"). OBRIGATÓRIA e SEM fallback: faltando, o funil
# nem sobe (healthcheck falha). Trocar de oferta/campanha = só mudar a env (sem deploy).
FUNNEL_OFFER_PRO_NO_COMANDO_DA_IA=no-comando-da-ia
FUNNEL_OFFER_KIDS_DESAFIO_PRIMEIRO_JOGO=desafio-primeiro-jogo
FUNNEL_OFFER_KIDS_COMUNIDADE_DOS_CRIADORES=comunidade-dos-criadores-mensal
# PRODUCT_PRICE_CENTS = só rótulo de PREÇO de fallback quando a oferta não é encontrada.
PRODUCT_PRICE_CENTS=3700
PRODUCT_SKU=no-comando-da-ia
PRODUCT_NAME=No Comando da IA

# Admin — login com usuário REAL do auth (IdP) via gateway. A sessão é o JWT do
# auth em cookie HttpOnly (validado em /auth/me); o funil não guarda credencial.
# Crie o admin no auth:
#   bun run --filter @sistemazero/auth db:seed --email voce@exemplo.com \
#     --password "uma-senha-forte" --role admin

# Cartão (FUTURO — tokenização no browser via payment-token-efi)
# Astro só expõe ao browser as vars que começam com PUBLIC_.
PUBLIC_EFI_ACCOUNT_IDENTIFIER=
PUBLIC_EFI_SANDBOX=true
