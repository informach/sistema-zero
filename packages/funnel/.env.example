# ──────────────────────────────────────────────────────────────────────────
# @sistemazero/funnel — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env` (já está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=4321
FUNNEL_PUBLIC_URL=http://localhost:4321

# Banco COMPARTILHADO do monorepo (`sistemazero`); este package é dono do schema
# `funil` (isolado por pgSchema). Porta 5433 em dev (a 5432 costuma estar ocupada).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
DATABASE_POOL_MAX=5

# Gateway = BFF de pagamentos. O funil NUNCA chama o payments direto.
GATEWAY_URL=http://localhost:3000
# Identidade do funil como consumer de BORDA do gateway (HMAC).
FUNNEL_CONSUMER_ID=funnel
# Segredo HMAC do funil — o MESMO valor deve estar em gateway.config consumers[].
FUNNEL_HMAC_SECRET=

# Webhook (gateway → funil): o gateway valida a assinatura do payments e injeta
# este token no encaminhamento interno. O funil confere o token.
FUNNEL_INTERNAL_TOKEN=

# Produto / Oferta (catálogo é a fonte da verdade do preço/inclusões via gateway).
# CATALOG_OFFER_SLUG = slug da oferta ativa no @sistemazero/catalog.
CATALOG_OFFER_SLUG=no-comando-da-ia
# PRODUCT_* viram rótulos de descrição/fallback (o preço autoritativo vem da cotação).
PRODUCT_PRICE_CENTS=3700
PRODUCT_SKU=no-comando-da-ia
PRODUCT_NAME=No Comando da IA

# Admin — login in-app (cookie de sessão assinado) nas rotas /admin e /api/admin/*
ADMIN_USER=admin
ADMIN_PASSWORD=troque-este-segredo-forte
# Segredo que assina o cookie de sessão do admin (≥16 chars). Gere um valor forte.
ADMIN_SESSION_SECRET=troque-por-um-segredo-aleatorio-forte

# Cartão (FUTURO — tokenização no browser via payment-token-efi)
# Astro só expõe ao browser as vars que começam com PUBLIC_.
PUBLIC_EFI_ACCOUNT_IDENTIFIER=
PUBLIC_EFI_SANDBOX=true
