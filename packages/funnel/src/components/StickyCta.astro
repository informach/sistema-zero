---
// Barra de CTA fixa no rodapé da página de vendas. Aparece quando o CTA do hero
// sai da tela (IntersectionObserver sobre #cta-sentinel) e some quando ele volta.
// Nome/preço vêm da oferta (catálogo), repassados pela página.
interface Props {
  productName: string
  priceLabel: string
}
const { productName, priceLabel } = Astro.props
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-bg/85 backdrop-blur-md transition-transform duration-300 ease-out"
>
  <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3">
    <div class="hidden flex-col leading-tight sm:flex">
      <span class="text-sm font-bold text-ink">{productName}</span>
      <span class="text-xs text-muted">Pagamento único · acesso imediato</span>
    </div>
    <span class="hidden text-2xl font-extrabold text-lime sm:ml-auto sm:block">
      {priceLabel}
    </span>
    <button
      type="button"
      data-checkout-cta
      class="btn btn-primary w-full text-base sm:w-auto"
    >
      Garantir agora — {priceLabel}
    </button>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-cta')
  const sentinel = document.getElementById('cta-sentinel')
  if (bar && sentinel && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        const e = entries[0]
        if (e) bar.classList.toggle('translate-y-full', e.isIntersecting)
      },
      { rootMargin: '0px 0px -10% 0px' },
    )
    io.observe(sentinel)
  } else if (bar) {
    bar.classList.remove('translate-y-full')
  }
</script>
