---
// Renderiza um documento legal (Política de Privacidade / Termos de Uso).
import type { LegalDoc } from '../content/legal'

interface Props {
  doc: LegalDoc
  /** Fallback do link "← Voltar" para quem chega DIRETO na página (default `/`;
   *  o kids passa `/kids`). Quem veio navegando volta pela história do browser. */
  voltarHref?: string
}
const { doc, voltarHref = '/' } = Astro.props
---

<main class="mx-auto max-w-3xl px-4 pb-16 pt-10 sm:pt-14">
  <a href={voltarHref} data-voltar class="text-sm text-muted transition hover:text-lime">← Voltar</a>
  <h1 class="mt-6 text-3xl font-extrabold leading-tight sm:text-4xl">{doc.titulo}</h1>
  <p class="mt-2 text-sm text-muted">Última atualização: {doc.atualizadoEm}</p>

  {
    doc.secoes.map((secao) => (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-ink">{secao.titulo}</h2>
        {secao.paragrafos.map((p) => (
          <p class="mt-3 leading-relaxed text-muted">{p}</p>
        ))}
        {secao.bullets && (
          <ul class="mt-3 flex flex-col gap-2">
            {secao.bullets.map((b) => (
              <li class="flex items-start gap-2.5 leading-relaxed text-muted">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}
        {secao.posBullets?.map((p) => (
          <p class="mt-3 leading-relaxed text-muted">{p}</p>
        ))}
      </section>
    ))
  }
</main>

<script>
  // "← Voltar" retorna à página anterior do histórico quando o visitante veio
  // navegando pelo próprio site; quem chega direto (sem histórico ou vindo de
  // fora) segue o href de fallback do link.
  const voltar = document.querySelector<HTMLAnchorElement>('[data-voltar]')
  if (voltar) {
    voltar.addEventListener('click', (e) => {
      let mesmaOrigem = false
      try {
        mesmaOrigem =
          document.referrer !== '' && new URL(document.referrer).origin === window.location.origin
      } catch {
        mesmaOrigem = false
      }
      if (mesmaOrigem && window.history.length > 1) {
        e.preventDefault()
        window.history.back()
      }
    })
  }
</script>
