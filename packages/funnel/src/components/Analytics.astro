---
import { analyticsPage } from '../analytics/page-context'
import { quizDefinition } from '../analytics/quiz-definition'
import { getFunnelByKey } from '../funnels/registry'

const page = analyticsPage(Astro.url.pathname)
const funnel = page?.funnel ? getFunnelByKey(page.funnel) : null
const definition = funnel ? quizDefinition(funnel)?.id : ''
const release = process.env.RAILWAY_GIT_COMMIT_SHA || 'development'
---
{page && <aside id="sz-metrics-controls" data-path={page.path} data-public={String(page.publicText)} data-quiz={definition} data-release={release} aria-label="Preferências de privacidade" data-analytics-private>
  <button id="sz-metrics-manage" type="button" aria-controls="sz-metrics-notice" aria-expanded="false">Privacidade</button>
  <div id="sz-metrics-notice" hidden>
    <p>Medimos visitas, cliques e etapas para melhorar o site. Ao enviar seus dados no quiz ou na compra, sua navegação pode ser associada ao seu cadastro. As métricas não gravam o que você digita nos campos.</p>
    <p id="sz-metrics-state" role="status"></p>
    <div><button type="button" data-choice="accepted" hidden>Ativar métricas</button><button type="button" data-choice="rejected">Desativar métricas</button><button type="button" id="sz-metrics-close">Fechar</button></div>
    <a href={`/${funnel?.audience ?? 'kids'}/privacidade`}>Política de privacidade</a>
    <p id="sz-metrics-error" role="status" hidden>Não foi possível salvar. Tente novamente.</p>
  </div>
  <p id="sz-metrics-live" class="sz-metrics-visually-hidden" role="status"></p>
</aside>}
<style>
  #sz-metrics-controls { position: relative; z-index: 100; font: 14px/1.5 var(--font-sans, sans-serif); }
  #sz-metrics-notice { position: fixed; bottom: 16px; left: 16px; width: min(420px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; padding: 20px; border: 1px solid #cbd5e1; border-radius: 16px; background: #fff; color: #172554; box-shadow: 0 8px 40px #0002; }
  #sz-metrics-notice p { margin: 0 0 12px; }
  #sz-metrics-notice div { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
  #sz-metrics-notice button { padding: 9px 12px; border: 1px solid #4c56a5; border-radius: 8px; cursor: pointer; }
  #sz-metrics-notice a { text-decoration: underline; }
  #sz-metrics-manage { position: fixed; bottom: 4px; right: 8px; background: white; color: #334155; padding: 3px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 11px; cursor: pointer; }
  /* A barra fixa das ofertas (até 760px) ocupa o rodapé da tela: o botão sobe para não cobrir o CTA. */
  @media (max-width: 760px) {
    :global(body:has(.kof-mobar.is-visible)) #sz-metrics-manage { bottom: calc(var(--kof-mobar-altura, 4.5rem) + env(safe-area-inset-bottom) + 8px); }
  }
  /* Com o pré-checkout aberto, o botão não fica por cima do formulário modal. */
  :global(body:has([aria-modal="true"])) #sz-metrics-manage { display: none; }
  .sz-metrics-visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; }
</style>
<script>
  import { setupAnalytics } from '../analytics/consent'
  setupAnalytics()
</script>
