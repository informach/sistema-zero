---
// Corpo enxuto do presente quando o curso NÃO é o Cadê Todo Mundo (15/11/2026): curso para pais
// (`variante="pais"`) ou outro curso (`variante="curso"`). Sem as seções editoriais do Cadê: o
// topo com o título público e a apresentação da campanha, o nome do curso e o prazo da oferta,
// o que o presente inclui e o formulário. Copy em `presenteCursoCopy` (content/presente-curso.ts).
// Vai dentro do `PresenteLayout` (Kids, classes `.c9-*`/`.pk-*`) ou do `PresenteAdultoLayout`
// (adulto, `.cda-*`/`.pa-*`), conforme o público.
import type { ReferralGiftOfferView, ReferralGiftView } from '@sistemazero/core/referrals'
import type { EstadoPresente } from '../../content/presente'
import { presenteCursoCopy } from '../../content/presente-curso'
import { dataBrasilia } from '../../content/presente-resgate'
import BolsaResgate from '../../islands/BolsaResgate'
import type { ReferralGiftPage } from '../../server/referral-gift-page'

interface Props {
  gift: ReferralGiftView & { gift: ReferralGiftOfferView }
  kind: Exclude<ReferralGiftPage['kind'], 'not_found' | 'unavailable'>
  communityUrl: string
  variante: 'pais' | 'curso'
}
const { gift, kind, communityUrl, variante } = Astro.props
const audience = gift.audience === 'adult' ? 'adult' : 'kids'
const adulto = audience === 'adult'
const P = presenteCursoCopy(audience, gift.gift, variante)
const ready = kind === 'ready'
const campaign = gift.source.kind === 'campaign'
const lastClaimAt = gift.endsAt ? new Date(Date.parse(gift.endsAt) - 1).toISOString() : null
const nome = gift.source.name
const origem = (
  !campaign
    ? P.origem.pessoal
    : gift.source.context === 'event'
      ? P.origem.evento
      : P.origem.campanha
).replace('{{nome}}', adulto ? nome.toLocaleUpperCase('pt-BR') : nome)
const dia = (iso: string | null) => (iso ? dataBrasilia(iso, false) : '')
const estado: EstadoPresente | null =
  kind === 'ready'
    ? null
    : {
        ...P.estados[kind],
        titulo:
          kind === 'ended' && !gift.endsAt
            ? P.estados.endedSemData
            : P.estados[kind].titulo.replace(
                '{{data}}',
                dia(kind === 'scheduled' ? gift.startsAt : lastClaimAt),
              ),
      }
const fechado = kind === 'paused' || kind === 'ended'
const podeRetomar = fechado
const CORES = ['azul', 'rosa', 'verde']
const check = '<path d="M20 6 9 17l-5-5"></path>'
const seta = '<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>'
const resgate = {
  code: gift.code,
  referrerName: nome,
  communityUrl,
  audience,
  campaign,
  gift: gift.gift,
  variante,
} as const
---
{adulto ? (
  <>
    <section class="cda-secao cda-hero pa-hero" aria-labelledby="pc-titulo">
      <div class="cda-wrap">
        <div class="cda-hero__texto">
          <p class="cda-rotulo cor-verde">{origem}</p>
          {campaign && gift.source.description && <p class="cda-hero__lead">{gift.source.description}</p>}
          <h1 id="pc-titulo" class="cda-h1">{P.hero.titulo.antes}<span class="cda-destaque">{P.hero.titulo.destaque}</span></h1>
          <p class="cda-hero__lead">{P.hero.texto}</p>
          <ul class="cda-checks">
            {P.hero.beneficios.map((beneficio) => (
              <li>
                <svg class="cda-check" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" set:html={check} />
                <span>{beneficio}</span>
              </li>
            ))}
          </ul>
          {ready && (
            <div class="cda-acao">
              <a class="cda-btn cda-btn--grande" href="#resgatar">{P.hero.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={seta} /></a>
            </div>
          )}
          {estado && (
            <div class:list={['pa-estado', `cor-${fechado ? 'rosa' : 'azul'}`]} role="status">
              <span class="pa-estado__selo">{estado.etiqueta}</span>
              <h2 class="pa-estado__titulo">{estado.titulo}</h2>
              <p class="cda-suave">{estado.texto}</p>
              {podeRetomar && <a class="pa-link" href="#retomar">{P.estados.retomar.botao}</a>}
            </div>
          )}
        </div>
      </div>
    </section>
    <section class="cda-secao cda-secao--fundo-2" aria-labelledby="pc-condicoes">
      <div class="cda-wrap cda-coluna">
        <div class="cda-cabeca cda-cabeca--larga">
          <p class="cda-rotulo cor-amarelo">{P.condicoes.etiqueta}</p>
          <h2 id="pc-condicoes" class="cda-h2">{P.condicoes.titulo}</h2>
        </div>
        <div class="pa-cartoes">
          {P.condicoes.cartoes.map((cartao, index) => (
            <article class={`pa-cartao cor-${CORES[index % CORES.length]}`}>
              <h3 class="cda-rotulo">{cartao.titulo}</h3>
              <p>{cartao.texto}</p>
            </article>
          ))}
        </div>
        {ready && <a class="cda-btn cda-btn--grande pa-cta" href="#resgatar">{P.condicoes.cta}</a>}
      </div>
    </section>
    <section id="resgatar" class="cda-secao cda-secao--grade" aria-labelledby="pc-resgatar">
      <div class="cda-wrap cda-dupla cda-dupla--oferta">
        <div class="pa-texto">
          <p class="cda-rotulo cor-verde">{P.resgatar.etiqueta}</p>
          <h2 id="pc-resgatar" class="cda-h2">{P.resgatar.titulo}</h2>
          <p class="cda-suave">{P.resgatar.texto}</p>
        </div>
        <div class="pa-form">
          {ready ? (
            <BolsaResgate client:load {...resgate} />
          ) : (
            <div class="cda-coluna">
              {estado && (
                <div class:list={['pa-estado', `cor-${fechado ? 'rosa' : 'azul'}`]}>
                  <span class="pa-estado__selo">{estado.etiqueta}</span>
                  <h3 class="pa-estado__titulo">{estado.titulo}</h3>
                  <p class="cda-suave">{estado.texto}</p>
                </div>
              )}
              {podeRetomar && (
                <details id="retomar" class="pa-retomar">
                  <summary>{P.estados.retomar.botao}</summary>
                  <p class="cda-suave">{P.estados.retomar.texto}</p>
                  <BolsaResgate client:load {...resgate} retryOnly />
                </details>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  </>
) : (
  <>
    <section class="c9-sec c9-heroi" aria-labelledby="pc-titulo">
      <div class="c9-wrap">
        <div class="c9-heroi__texto">
          <span class="c9-selo pk-origem">{origem}</span>
          {campaign && gift.source.description && <p class="c9-heroi__lead">{gift.source.description}</p>}
          <h1 id="pc-titulo" class="c9-h1">{P.hero.titulo.antes}<span class="c9-h1__destaque pk-destaque">{P.hero.titulo.destaque}</span></h1>
          <p class="c9-heroi__lead">{P.hero.texto}</p>
          <ul class="c9-checks">
            {P.hero.beneficios.map((beneficio, index) => (
              <li>
                <span class:list={['c9-ladrilho', `c9-cor--${['verde', 'amarelo', 'azul-claro'][index % 3]}`]} aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
                </span>
                <span>{beneficio}</span>
              </li>
            ))}
          </ul>
          {ready && (
            <div class="c9-acao">
              <a class="c9-btn c9-btn--grande" href="#resgatar">{P.hero.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={seta} /></a>
            </div>
          )}
          {estado && (
            <div class:list={['pk-estado', `c9-cor--${fechado ? 'rosa' : 'azul-claro'}`]} role="status">
              <span class="c9-tag">{estado.etiqueta}</span>
              <h2 class="pk-estado__titulo">{estado.titulo}</h2>
              <p class="c9-p">{estado.texto}</p>
              {podeRetomar && <a class="pk-link" href="#retomar">{P.estados.retomar.botao}</a>}
            </div>
          )}
        </div>
      </div>
    </section>
    <section class="c9-sec c9-sec--creme" aria-labelledby="pc-condicoes">
      <div class="c9-wrap c9-pilha c9-gap-26">
        <div class="c9-cabeca">
          <span class="c9-tag c9-cor--branco">{P.condicoes.etiqueta}</span>
          <h2 id="pc-condicoes" class="c9-h2">{P.condicoes.titulo}</h2>
        </div>
        <div class="c9-grade c9-min-300 c9-grade--20">
          {P.condicoes.cartoes.map((cartao, index) => (
            <article class:list={['c9-cartao', `c9-cor--${CORES[index % CORES.length]}`]}>
              <h3 class="c9-cartao__titulo">{cartao.titulo}</h3>
              <div class="c9-cartao__texto"><p>{cartao.texto}</p></div>
            </article>
          ))}
        </div>
        {ready && <a class="c9-btn c9-btn--grande pk-cta" href="#resgatar">{P.condicoes.cta}</a>}
      </div>
    </section>
    <section id="resgatar" class="c9-sec pk-pontilhado" aria-labelledby="pc-resgatar">
      <div class="c9-wrap c9-lado c9-lado--topo">
        <div class="c9-pilha c9-gap-14 c9-b420">
          <span class="c9-tag c9-cor--amarelo">{P.resgatar.etiqueta}</span>
          <h2 id="pc-resgatar" class="c9-h2">{P.resgatar.titulo}</h2>
          <p class="c9-p">{P.resgatar.texto}</p>
        </div>
        <div class="pk-form">
          {ready ? (
            <BolsaResgate client:load {...resgate} />
          ) : (
            <div class="c9-pilha c9-gap-16">
              {estado && (
                <div class:list={['pk-estado', `c9-cor--${fechado ? 'rosa' : 'azul-claro'}`]}>
                  <span class="c9-tag">{estado.etiqueta}</span>
                  <h3 class="pk-estado__titulo">{estado.titulo}</h3>
                  <p class="c9-p">{estado.texto}</p>
                </div>
              )}
              {podeRetomar && (
                <details id="retomar" class="pk-retomar">
                  <summary>{P.estados.retomar.botao}</summary>
                  <p>{P.estados.retomar.texto}</p>
                  <BolsaResgate client:load {...resgate} retryOnly />
                </details>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  </>
)}
