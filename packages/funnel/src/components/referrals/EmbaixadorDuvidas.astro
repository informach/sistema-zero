---
// As dúvidas do programa de embaixadores no layout `.cdc` da página pública `/kids/embaixadores`.
// O texto mora em `EMBAIXADOR_DUVIDAS` (content/embaixador.ts), o mesmo do painel.
import { EMBAIXADOR_DUVIDAS as D } from '../../content/embaixador'
---
<section id="duvidas" class="section fundo-alt cor-roxo"><div class="wrap"><span class="kof-eyebrow">{D.etiqueta}</span><h2 class="kof-h2">{D.titulo}</h2><div class="gift-faq">{D.itens.map((item) => <details><summary>{item.pergunta}<span aria-hidden="true">+</span></summary><div class="gift-answer"><div class="gift-prose">{item.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}</div></div></details>)}</div></div></section>
