---
// Layout da página de recebimento do presente KIDS (`/bolsa/<codigo>` com o público `kids` e a
// prévia do Admin). Canvas "Presente Kids e adulto · proposta" (RecebimentoKids, 20/10/2026), na
// linguagem da página de 9 a 17: receitas em kids-oferta.css, layout em comunidade-917.css (`.c917`)
// e as peças do presente em presente-kids.css. O rodapé institucional fica fora do `.c917`.
import '../../styles/kids-oferta.css'
import '../../styles/comunidade-917.css'
import '../../styles/presente-kids.css'
import { PRESENTE_KIDS as P } from '../../content/presente'
import { COMUNIDADE_DOS_CRIADORES } from '../../funnels/comunidade-dos-criadores'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Footer from '../Footer.astro'

interface Props {
  title: string
  description: string
  /** Com o formulário aberto: o botão do topo e a barra fixa levam a ele. */
  ready?: boolean
  /** Sem o corpo do presente (link inválido, referrals fora do ar): sem os atalhos das seções. */
  secoes?: boolean
}
const { title, description, ready = false, secoes = true } = Astro.props
---
<BaseLayout title={title} description={description} noindex htmlClass="theme-kids">
  <div class="c917 pk-corpo">
    <a class="c9-pular" href="#conteudo">{P.pular}</a>
    <header class="c9-topo">
      <div class="c9-topo__barra">
        <a class="c9-marca" href="#topo" aria-label={P.topo.marcaAria}>
          <img src={P.topo.logo.src} alt={P.topo.logo.alt} width={P.topo.logo.width} height={P.topo.logo.height} decoding="async" />
        </a>
        {(secoes || ready) && (
          <nav class="c9-nav" aria-label={P.topo.navAria}>
            {secoes && P.topo.links.map((link) => <a class="c9-nav__link" href={link.href}>{link.label}</a>)}
            {ready && <a class="c9-btn c9-btn--topo pk-topo-cta" href="#resgatar">{P.topo.cta}</a>}
          </nav>
        )}
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    {ready && (
      <div class="kof-mobar c9-barra" data-presente-barra aria-hidden="true">
        <span class="c9-barra__preco"><strong>{P.barra.titulo}</strong><span>{P.barra.texto}</span></span>
        <a class="c9-btn" href="#resgatar" tabindex="-1">{P.barra.cta}</a>
      </div>
    )}
  </div>
  <!-- O mesmo Termo do aceite no formulário do presente (`BolsaResgate`): as regras de uso da área
       Kids estão no Termo da Comunidade Kids. Um Termo próprio do presente fica para a revisão jurídica. -->
  <Footer audience="kids" termosHref={`${COMUNIDADE_DOS_CRIADORES.basePath}/termos`} />
</BaseLayout>
<script>
  import { ligarBarraFixa } from '../../lib/barra-fixa'
  ligarBarraFixa('[data-presente-barra]', 'resgatar')
</script>
