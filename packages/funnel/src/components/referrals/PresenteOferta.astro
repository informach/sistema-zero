---
// Corpo da página de recebimento do presente KIDS (Canvas "Presente Kids e adulto · proposta",
// RecebimentoKids, 20/10/2026). Toda a copy vem de `PRESENTE_KIDS` (content/presente.ts); o layout
// é o da página de 9 a 17 (`.c917`) com as peças de presente-kids.css. Quem lê é o responsável;
// quem usa é a criança de 9 a 14 anos.
import type { ReferralGiftView } from '@sistemazero/core/referrals'
import { type EstadoPresente, PRESENTE_KIDS as P } from '../../content/presente'
import { dataBrasilia } from '../../content/presente-resgate'
import BolsaResgate from '../../islands/BolsaResgate'
import type { ReferralGiftPage } from '../../server/referral-gift-page'

interface Props {
  gift: ReferralGiftView
  kind: Exclude<ReferralGiftPage['kind'], 'not_found' | 'unavailable'>
  communityUrl: string
  preview?: boolean
}
const { gift, kind, communityUrl, preview = false } = Astro.props
const ready = kind === 'ready' && !preview
const campaign = gift.source.kind === 'campaign'
const nome = gift.source.name
const origem = (
  !campaign
    ? P.origem.pessoal
    : gift.source.context === 'event'
      ? P.origem.evento
      : P.origem.campanha
).replace('{{nome}}', nome)
const dia = (iso: string | null) => (iso ? dataBrasilia(iso, false) : '')
const estado: EstadoPresente | null =
  kind === 'ready'
    ? null
    : {
        ...P.estados[kind],
        titulo:
          kind === 'ended' && !gift.endsAt
            ? P.estados.endedSemData
            : P.estados[kind].titulo.replace(
                '{{data}}',
                dia(kind === 'scheduled' ? gift.startsAt : gift.endsAt),
              ),
      }
const corDoEstado = kind === 'paused' || kind === 'ended' ? 'rosa' : 'azul-claro'
const podeRetomar = !preview && (kind === 'ended' || kind === 'paused')
const check = '<path d="M20 6 9 17l-5-5"></path>'
const CORES_CHECKS = ['verde', 'amarelo', 'azul-claro']
const CORES_PASSOS = ['azul', 'amarelo', 'verde']
const CORES_CONDICOES = ['azul', 'rosa', 'verde']
---
{preview && <div class="c9-wrap"><p class="pk-previa" role="status">{P.previa}</p></div>}
<section class="c9-sec c9-heroi" aria-labelledby="pk-titulo">
  <div class="c9-wrap c9-heroi__grade">
    <div class="c9-heroi__texto">
      <span class="c9-selo pk-origem">{origem}</span>
      {campaign && gift.source.description && <p class="c9-heroi__lead">{gift.source.description}</p>}
      <h1 id="pk-titulo" class="c9-h1">{P.hero.titulo.antes}<span class="c9-h1__destaque pk-destaque">{P.hero.titulo.destaque}</span></h1>
      <p class="c9-heroi__lead">{P.hero.texto}</p>
      <ul class="c9-checks">
        {P.hero.beneficios.map((beneficio, index) => (
          <li>
            <span class:list={['c9-ladrilho', `c9-cor--${CORES_CHECKS[index]}`]} aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
            </span>
            <span>{beneficio}</span>
          </li>
        ))}
      </ul>
      {ready && (
        <div class="c9-acao">
          <a class="c9-btn c9-btn--grande" href="#resgatar">{P.hero.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
          <a class="pk-link" href="#jogo">{P.hero.link}</a>
        </div>
      )}
      {estado && !preview && (
        <div class:list={['pk-estado', `c9-cor--${corDoEstado}`]} role="status">
          <span class="c9-tag">{estado.etiqueta}</span>
          <h2 class="pk-estado__titulo">{estado.titulo}</h2>
          <p class="c9-p">{estado.texto}</p>
          {podeRetomar && <a class="pk-link" href="#retomar">{P.estados.retomar.botao}</a>}
        </div>
      )}
      <span class="c9-heroi__requisitos">{P.hero.requisitos}</span>
      {campaign && gift.endsAt && kind !== 'ended' && <p class="pk-prazo">{P.hero.prazoCampanha.replace('{{data}}', dataBrasilia(gift.endsAt))}</p>}
    </div>
    <div class="pk-heroi__visual">
      <figure class="pk-figura">
        <span class="pk-figura__rotulo">{P.hero.figura.rotulo}</span>
        <img src={P.hero.figura.imagem.src} alt={P.hero.figura.imagem.alt} width={P.hero.figura.imagem.width} height={P.hero.figura.imagem.height} loading="eager" decoding="async" fetchpriority="high" />
        <figcaption>
          <img src={P.hero.figura.zappy.src} alt={P.hero.figura.zappy.alt} width={P.hero.figura.zappy.width} height={P.hero.figura.zappy.height} loading="lazy" decoding="async" />
          <span><strong class="pk-figura__destaque">{P.hero.figura.destaque}</strong>{P.hero.figura.legenda}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section id="jogo" class="c9-sec c9-sec--branco" aria-labelledby="pk-jogo">
  <div class="c9-wrap c9-lado">
    <div class="c9-pilha c9-gap-14 c9-b440">
      <span class="c9-tag pk-cor--azul-fundo">{P.jogo.etiqueta}</span>
      <h2 id="pk-jogo" class="c9-h2">{P.jogo.titulo}</h2>
      {P.jogo.paragrafos.map((paragrafo) => <p class="c9-p">{paragrafo}</p>)}
      <p class="pk-nota">{P.jogo.nota}</p>
    </div>
    <img class="pk-tela c9-cor--azul" src={P.jogo.imagem.src} alt={P.jogo.imagem.alt} width={P.jogo.imagem.width} height={P.jogo.imagem.height} loading="lazy" decoding="async" />
  </div>
</section>

<section class="c9-sec c9-sec--chao" aria-labelledby="pk-aula">
  <div class="c9-wrap c9-pilha c9-gap-26">
    <div class="c9-cabeca">
      <span class="c9-tag c9-cor--branco">{P.aula.etiqueta}</span>
      <h2 id="pk-aula" class="c9-h2">{P.aula.titulo}</h2>
    </div>
    <div class="c9-lado pk-lado-24">
      <img class="pk-tela pk-tela--larga c9-cor--verde" src={P.aula.imagem.src} alt={P.aula.imagem.alt} width={P.aula.imagem.width} height={P.aula.imagem.height} loading="lazy" decoding="async" />
      <div class="pk-passos">
        {P.aula.passos.map((passo, index) => (
          <article class:list={['c9-cartao', `c9-cor--${CORES_PASSOS[index]}`]}>
            <h3 class="c9-cartao__titulo">{passo.titulo}</h3>
            <p class="c9-cartao__texto">{passo.texto}</p>
          </article>
        ))}
      </div>
    </div>
    <p class="c9-p pk-texto-largo">{P.aula.nota}</p>
  </div>
</section>

<section class="c9-sec c9-sec--branco" aria-labelledby="pk-mural">
  <div class="c9-wrap c9-lado">
    <img class="pk-tela pk-tela--topo c9-cor--rosa" src={P.mural.imagem.src} alt={P.mural.imagem.alt} width={P.mural.imagem.width} height={P.mural.imagem.height} loading="lazy" decoding="async" />
    <div class="c9-pilha c9-gap-14 c9-b440">
      <span class="c9-tag pk-cor--rosa-fundo">{P.mural.etiqueta}</span>
      <h2 id="pk-mural" class="c9-h2">{P.mural.titulo}</h2>
      {P.mural.paragrafos.map((paragrafo) => <p class="c9-p">{paragrafo}</p>)}
    </div>
  </div>
</section>

<section class="c9-sec c9-sec--navy" aria-labelledby="pk-plataforma">
  <div class="c9-wrap c9-lado">
    <div class="c9-pilha c9-gap-14 c9-b520">
      <span class="c9-tag c9-cor--amarelo">{P.plataforma.etiqueta}</span>
      <h2 id="pk-plataforma" class="c9-h2">{P.plataforma.titulo}</h2>
      {P.plataforma.paragrafos.map((paragrafo) => <p class="c9-p">{paragrafo}</p>)}
    </div>
    <img class="pk-foto" src={P.plataforma.imagem.src} alt={P.plataforma.imagem.alt} width={P.plataforma.imagem.width} height={P.plataforma.imagem.height} loading="lazy" decoding="async" />
  </div>
</section>

<section class="c9-sec c9-sec--creme" aria-labelledby="pk-condicoes">
  <div class="c9-wrap c9-pilha c9-gap-26">
    <div class="c9-cabeca">
      <span class="c9-tag c9-cor--branco">{P.condicoes.etiqueta}</span>
      <h2 id="pk-condicoes" class="c9-h2">{P.condicoes.titulo}</h2>
    </div>
    <div class="c9-grade c9-min-300 c9-grade--20">
      {P.condicoes.cartoes.map((cartao, index) => (
        <article class:list={['c9-cartao', `c9-cor--${CORES_CONDICOES[index]}`]}>
          <h3 class="c9-cartao__titulo">{cartao.titulo}</h3>
          <p class="c9-cartao__texto">{cartao.texto}</p>
        </article>
      ))}
    </div>
    {ready && <a class="c9-btn c9-btn--grande pk-cta" href="#resgatar">{P.condicoes.cta}</a>}
  </div>
</section>

<section id="duvidas" class="c9-sec c9-sec--branco" aria-labelledby="pk-duvidas">
  <div class="c9-wrap c9-pilha c9-gap-20">
    <h2 id="pk-duvidas" class="c9-h2">{P.duvidas.titulo}</h2>
    <div class="c9-grade c9-min-440 c9-grade--14 pk-duvidas">
      {P.duvidas.itens.map((item, index) => (
        <details class="c9-duvida pk-duvida" open={index === 0}>
          <summary>{item.pergunta}</summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="resgatar" class="c9-sec pk-pontilhado" aria-labelledby="pk-resgatar">
  <div class="c9-wrap c9-lado c9-lado--topo">
    <div class="c9-pilha c9-gap-14 c9-b420">
      <span class="c9-tag c9-cor--amarelo">{P.resgatar.etiqueta}</span>
      <h2 id="pk-resgatar" class="c9-h2">{P.resgatar.titulo}</h2>
      <p class="c9-p">{P.resgatar.texto}</p>
    </div>
    <div class="pk-form">
      {ready ? (
        <BolsaResgate client:load code={gift.code} referrerName={nome} communityUrl={communityUrl} audience="kids" />
      ) : preview ? (
        <div class="pk-estado c9-cor--verde"><p class="c9-p">{P.resgatar.previa}</p></div>
      ) : (
        <div class="c9-pilha c9-gap-16">
          {estado && (
            <div class:list={['pk-estado', `c9-cor--${corDoEstado}`]}>
              <span class="c9-tag">{estado.etiqueta}</span>
              <h3 class="pk-estado__titulo">{estado.titulo}</h3>
              <p class="c9-p">{estado.texto}</p>
            </div>
          )}
          {podeRetomar && (
            <details id="retomar" class="pk-retomar">
              <summary>{P.estados.retomar.botao}</summary>
              <p>{P.estados.retomar.texto}</p>
              <BolsaResgate client:load code={gift.code} referrerName={nome} communityUrl={communityUrl} audience="kids" retryOnly />
            </details>
          )}
        </div>
      )}
    </div>
  </div>
</section>
