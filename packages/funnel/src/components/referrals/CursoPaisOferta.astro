---
// Corpo das páginas de venda dos cursos para pais: o guia "Transformando o vilão em aliado"
// (`/kids/vilao-em-aliado`) e o curso da Vivianne (`/kids/como-ajudar-seu-filho-autista-nas-frustracoes`).
// Proposta de 26/11/2026: a MESMA estrutura das outras páginas de venda do funil Kids, no layout
// `.c917` e com as peças de `curso-pais.css` (`.cpv-*`): o topo com título, texto, botão e a
// ilustração (sem cartão de compra); a cena da casa; o que muda; como funciona; quem conduz; dúvidas;
// o bloco de compra (slot `compra`, a seção `#oferta` do corpo, venda, cupom ou presente); o
// fechamento. Curta e sem resumir aula. O presente do fim do guia é surpresa: só o selo da imagem.
import '../../styles/curso-pais.css'
import { DEPOIMENTOS_DE_PAIS, type DepoimentoDePais } from '../../content/curso-pais-vilao'
import type { GuiaPaisCopy } from '../../funnels/vilao-em-aliado/oferta'
import OfferImage from '../funnel/oferta/OfferImage.astro'

interface Props {
  /** A copy da página: a de venda ou a do modo presente. */
  copy: GuiaPaisCopy
  /** O selo do topo no lugar do padrão (no modo presente, quem dá o presente). */
  selo?: string
  /** Os depoimentos do curso (padrão: os do guia). A seção só aparece com ao menos um. */
  depoimentos?: readonly DepoimentoDePais[]
}
const { copy: P, selo, depoimentos = DEPOIMENTOS_DE_PAIS } = Astro.props
const check = '<path d="M20 6 9 17l-5-5"></path>'
const seta = '<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>'
const presente =
  '<rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"></path>'
const ICONES: Record<string, string> = {
  conversa: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>',
  recomecar:
    '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path>',
  estrela:
    '<path d="M11.5 2.8a.6.6 0 0 1 1 0l2.6 5.3 5.8.8a.6.6 0 0 1 .3 1l-4.2 4.1 1 5.8a.6.6 0 0 1-.8.6L12 17.7l-5.2 2.7a.6.6 0 0 1-.8-.6l1-5.8-4.2-4.1a.6.6 0 0 1 .3-1l5.8-.8Z"></path>',
}
const CORES_CHECKS = ['roxo', 'amarelo', 'rosa']
const CORES_MUDA = ['roxo', 'amarelo', 'verde']
const CORES_FORMATO = ['azul', 'rosa', 'verde']
const figuraDoQueMuda = P.oQueMuda.figuras?.[0]
---
<section class="c9-sec c9-sec--creme c9-heroi" aria-labelledby="cpv-titulo">
  <div class="c9-wrap c9-heroi__grade">
    <div class="c9-heroi__texto">
      <span class="c9-selo pk-origem">{selo ?? P.hero.selo}</span>
      <h1 id="cpv-titulo" class="c9-h1">{P.hero.titulo.antes}<span class="c9-h1__destaque">{P.hero.titulo.destaque}</span>{P.hero.titulo.depois}</h1>
      <p class="c9-heroi__lead">{P.hero.texto.antes}<strong>{P.hero.texto.nome}</strong>{P.hero.texto.depois}</p>
      <ul class="c9-checks">
        {P.hero.beneficios.map((beneficio, index) => (
          <li>
            <span class:list={['c9-ladrilho', `c9-cor--${CORES_CHECKS[index % CORES_CHECKS.length]}`]} aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
            </span>
            <span>{beneficio}</span>
          </li>
        ))}
      </ul>
      <div class="c9-acao">
        <a class="c9-btn c9-btn--grande" href="#oferta" data-analytics-id="cpv-topo-cta">{P.hero.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={seta} /></a>
        <a class="pk-link" href="#o-que-muda">{P.hero.link}</a>
      </div>
      <span class="c9-heroi__requisitos">{P.hero.requisitos}</span>
    </div>
    <div class="pk-heroi__visual cpv-heroi-visual">
      {P.hero.surpresa && (
        <span class="c9-chip c9-cor--rosa cpv-surpresa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={presente} />
          {P.hero.surpresa}
        </span>
      )}
      <figure class="pk-figura">
        <span class="pk-figura__rotulo">{P.hero.figura.rotulo}</span>
        <OfferImage image={P.hero.figura.imagem} eager />
      </figure>
    </div>
  </div>
</section>

<section id="na-sua-casa" class="c9-sec c9-sec--branco" aria-labelledby="cpv-cena">
  <div class="c9-wrap c9-lado">
    <div class="c9-pilha c9-gap-14 c9-b520">
      <span class="c9-tag c9-cor--amarelo">{P.cena.etiqueta}</span>
      <h2 id="cpv-cena" class="c9-h2">{P.cena.titulo}</h2>
    </div>
    <div class="c9-pilha c9-gap-14 c9-b520 cpv-cena-texto">
      {P.cena.paragrafos.map((paragrafo) => <p class="c9-p">{paragrafo}</p>)}
    </div>
  </div>
</section>

<section id="o-que-muda" class="c9-sec c9-sec--creme" aria-labelledby="cpv-muda">
  <div class="c9-wrap c9-pilha c9-gap-26">
    {figuraDoQueMuda ? (
      <div class="c9-lado">
        <div class="c9-pilha c9-gap-14 c9-b460">
          <h2 id="cpv-muda" class="c9-h2">{P.oQueMuda.titulo}</h2>
          <p class="c9-p">{P.oQueMuda.texto}</p>
        </div>
        <div class="pk-heroi__visual">
          <figure class="pk-figura">
            <span class="pk-figura__rotulo">{figuraDoQueMuda.rotulo}</span>
            <OfferImage image={figuraDoQueMuda.imagem} />
          </figure>
        </div>
      </div>
    ) : (
      <div class="c9-cabeca">
        <h2 id="cpv-muda" class="c9-h2">{P.oQueMuda.titulo}</h2>
        <p class="c9-p pk-texto-largo">{P.oQueMuda.texto}</p>
      </div>
    )}
    <div class="c9-grade c9-min-200 c9-grade--20">
      {P.oQueMuda.itens.map((item, index) => (
        <article class:list={['c9-etapa', `c9-cor--${CORES_MUDA[index % CORES_MUDA.length]}`]}>
          <span class:list={['c9-numero', { 'c9-numero--clara': index === 0 }]} aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[item.icone]} />
          </span>
          <h3 class="c9-etapa__titulo">{item.titulo}</h3>
          <p class="c9-etapa__texto">{item.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="como-funciona" class="c9-sec c9-sec--branco" aria-labelledby="cpv-formato">
  <div class="c9-wrap c9-lado cpv-formato">
    <div class="c9-pilha c9-gap-20 cpv-formato__texto">
      <div class="c9-pilha c9-gap-14">
        <span class="c9-tag c9-cor--branco">{P.formato.etiqueta}</span>
        <h2 id="cpv-formato" class="c9-h2">{P.formato.titulo}</h2>
      </div>
      <div class="c9-pilha c9-gap-14">
        {P.formato.itens.map((item, index) => (
          <article class:list={['c9-cartao', `c9-cor--${CORES_FORMATO[index % CORES_FORMATO.length]}`]}>
            <h3 class="c9-cartao__titulo">{item.titulo}</h3>
            <div class="c9-cartao__texto"><p>{item.texto}</p></div>
          </article>
        ))}
      </div>
    </div>
    <figure class="cpv-apostila">
      <OfferImage image={P.formato.imagem} />
    </figure>
  </div>
</section>

<section id="quem-conduz" class="c9-sec c9-sec--creme" aria-labelledby="cpv-quem">
  <div class="c9-wrap c9-lado">
    <div class="c9-pilha c9-gap-14 c9-b520">
      <span class="c9-tag c9-cor--amarelo">{P.quemConduz.etiqueta}</span>
      <h2 id="cpv-quem" class="c9-h2">{P.quemConduz.titulo}</h2>
      <p class="c9-p">{P.quemConduz.texto}</p>
    </div>
    <figure class="cpv-retrato">
      <OfferImage image={P.quemConduz.foto} zoom={false} />
    </figure>
  </div>
</section>

{depoimentos.length > 0 && (
  <section id="depoimentos" class="c9-sec c9-sec--branco" aria-labelledby="cpv-depoimentos">
    <div class="c9-wrap c9-pilha c9-gap-26">
      <div class="c9-cabeca">
        <span class="c9-tag c9-cor--branco">{P.depoimentos.etiqueta}</span>
        <h2 id="cpv-depoimentos" class="c9-h2">{P.depoimentos.titulo}</h2>
      </div>
      <div class="c9-grade c9-min-300 c9-grade--20">
        {depoimentos.map((depoimento) => (
          <figure class="cpv-citacao">
            <blockquote>{depoimento.texto}</blockquote>
            <figcaption>{depoimento.autor}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<section id="duvidas" class="c9-sec c9-sec--chao" aria-labelledby="cpv-duvidas">
  <div class="c9-wrap c9-pilha c9-gap-20">
    <h2 id="cpv-duvidas" class="c9-h2">{P.duvidas.titulo}</h2>
    <div class="c9-grade c9-min-440 c9-grade--14 pk-duvidas cpv-duvidas">
      {P.duvidas.itens.map((item, index) => (
        <details class="c9-duvida pk-duvida" open={index === 0}>
          <summary>{item.pergunta}</summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<slot name="compra" />

<section class="c9-fim" aria-labelledby="cpv-fim">
  <div class="c9-wrap c9-fim__grade">
    <div class="c9-pilha c9-gap-14 c9-b520">
      <h2 id="cpv-fim" class="c9-h2 c9-h2--fim">{P.fim.titulo}</h2>
      <a class="c9-btn c9-btn--grande c9-btn--amarelo" href="#oferta" data-analytics-id="cpv-fim-cta">{P.fim.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={seta} /></a>
      <span class="c9-nota">{P.fim.nota}</span>
    </div>
  </div>
</section>
