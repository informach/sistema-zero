---
// Corpo da página pública do minicurso para pais "Transformando o vilão em aliado"
// (`/kids/vilao-em-aliado`, 18/11/2026). Vai dentro do `PresenteLayout` (layout `.c917` e peças
// `.pk-*` do presente Kids) e só acrescenta as peças de `curso-pais.css` (`.cpv-*`). O cadastro é o
// formulário do presente na variante `pais`; sem campanha aberta, a página continua no ar com o
// estado no lugar do formulário. O presente do fim do curso é surpresa: nada aqui o revela.
import '../../styles/curso-pais.css'
import type { ReferralGiftOfferView } from '@sistemazero/core/referrals'
import { DEPOIMENTOS_DE_PAIS, CURSO_PAIS_VILAO as P } from '../../content/curso-pais-vilao'
import type { EstadoPresente } from '../../content/presente'
import BolsaResgate from '../../islands/BolsaResgate'
import OfferImage from '../funnel/oferta/OfferImage.astro'

interface Props {
  /** Dados do formulário quando a campanha entrega este curso; ausente = sem cadastro. */
  resgate?: {
    code: string
    referrerName: string
    communityUrl: string
    campaign: boolean
    gift: ReferralGiftOfferView
  }
  /** Com o formulário aberto. */
  ready: boolean
  /** O que mostrar no lugar do formulário quando ele está fechado. */
  estado?: EstadoPresente
  /** Campanha pausada ou encerrada: quem começou o cadastro pode concluir. */
  podeRetomar?: boolean
}
const { resgate, ready, estado, podeRetomar = false } = Astro.props
const formulario = resgate && ({ ...resgate, audience: 'kids', variante: 'pais' } as const)
const check = '<path d="M20 6 9 17l-5-5"></path>'
const seta = '<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>'
const CORES_CHECKS = ['roxo', 'amarelo', 'rosa']
const CORES_CARTOES = ['roxo', 'rosa', 'amarelo', 'azul', 'verde', 'azul-claro']
const CORES_AULAS = ['roxo', 'rosa', 'amarelo', 'azul-claro', 'verde', 'rosa', 'amarelo']
const CORES_PASSOS = ['roxo', 'rosa', 'amarelo', 'verde']
---
<section class="c9-sec c9-sec--creme c9-heroi" aria-labelledby="cpv-titulo">
  <div class="c9-wrap c9-heroi__grade">
    <div class="c9-heroi__texto">
      <span class="c9-selo pk-origem">{P.hero.selo}</span>
      <h1 id="cpv-titulo" class="c9-h1">{P.hero.titulo.antes}<span class="c9-h1__destaque">{P.hero.titulo.destaque}</span></h1>
      <p class="c9-heroi__lead">{P.hero.texto}</p>
      <ul class="c9-checks">
        {P.hero.beneficios.map((beneficio, index) => (
          <li>
            <span class:list={['c9-ladrilho', `c9-cor--${CORES_CHECKS[index % CORES_CHECKS.length]}`]} aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
            </span>
            <span>{beneficio}</span>
          </li>
        ))}
      </ul>
      {ready && (
        <div class="c9-acao">
          <a class="c9-btn c9-btn--grande" href="#resgatar">{P.hero.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={seta} /></a>
          <a class="pk-link" href="#aulas">{P.hero.link}</a>
        </div>
      )}
      {!ready && estado && (
        <div class:list={['pk-estado', `c9-cor--${podeRetomar ? 'rosa' : 'azul-claro'}`]} role="status">
          <span class="c9-tag">{estado.etiqueta}</span>
          <h2 class="pk-estado__titulo">{estado.titulo}</h2>
          <p class="c9-p">{estado.texto}</p>
          {podeRetomar && <a class="pk-link" href="#retomar">{P.estados.retomar.botao}</a>}
        </div>
      )}
      <span class="c9-heroi__requisitos">{P.hero.requisitos}</span>
    </div>
    <div class="pk-heroi__visual">
      <figure class="pk-figura">
        <span class="pk-figura__rotulo">{P.hero.figura.rotulo}</span>
        <OfferImage image={P.hero.figura.imagem} eager />
        <figcaption>
          <span><strong class="pk-figura__destaque">{P.hero.figura.destaque}</strong>{P.hero.figura.legenda}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section id="por-que" class="c9-sec c9-sec--branco" aria-labelledby="cpv-por-que">
  <div class="c9-wrap c9-pilha c9-gap-26">
    <div class="c9-pilha c9-gap-14 pk-texto-largo">
      <span class="c9-tag c9-cor--amarelo">{P.porQue.etiqueta}</span>
      <h2 id="cpv-por-que" class="c9-h2">{P.porQue.titulo}</h2>
      {P.porQue.paragrafos.map((paragrafo) => <p class="c9-p">{paragrafo}</p>)}
    </div>
    <div class="c9-grade c9-min-300 c9-grade--20">
      {P.porQue.comparacao.map((lado, index) => (
        <article class:list={['c9-cartao', `c9-cor--${index === 0 ? 'branco' : 'roxo'}`]}>
          <h3 class="c9-cartao__titulo">{lado.titulo}</h3>
          <ul class="cpv-lista">{lado.itens.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="para-quem" class="c9-sec c9-sec--chao" aria-labelledby="cpv-para-quem">
  <div class="c9-wrap c9-pilha c9-gap-26">
    <div class="c9-cabeca">
      <span class="c9-tag c9-cor--rosa">{P.paraQuem.etiqueta}</span>
      <h2 id="cpv-para-quem" class="c9-h2">{P.paraQuem.titulo}</h2>
      <p class="c9-p pk-texto-largo">{P.paraQuem.texto}</p>
    </div>
    <div class="c9-grade c9-min-300 c9-grade--20">
      {P.paraQuem.cartoes.map((cartao, index) => (
        <article class:list={['c9-cartao', `c9-cor--${CORES_CARTOES[index % CORES_CARTOES.length]}`]}>
          <h3 class="c9-cartao__titulo">{cartao.titulo}</h3>
          <div class="c9-cartao__texto"><p>{cartao.texto}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="aulas" class="c9-sec c9-sec--creme" aria-labelledby="cpv-aulas">
  <div class="c9-wrap c9-pilha c9-gap-26">
    <div class="c9-cabeca">
      <span class="c9-tag c9-cor--branco">{P.aulas.etiqueta}</span>
      <h2 id="cpv-aulas" class="c9-h2">{P.aulas.titulo}</h2>
      <p class="c9-p pk-texto-largo">{P.aulas.texto}</p>
    </div>
    <ol class="cpv-aulas">
      {P.aulas.itens.map((aula, index) => (
        <li class:list={['cpv-aula', `c9-cor--${CORES_AULAS[index % CORES_AULAS.length]}`]}>
          <h3>{aula.titulo}</h3>
          <p>{aula.texto}</p>
        </li>
      ))}
    </ol>
    {ready && <a class="c9-btn c9-btn--grande pk-cta" href="#resgatar">{P.hero.cta}</a>}
  </div>
</section>

<section id="quem-conduz" class="c9-sec c9-sec--branco" aria-labelledby="cpv-quem">
  <div class="c9-wrap c9-lado">
    <div class="c9-pilha c9-gap-14 c9-b520">
      <span class="c9-tag c9-cor--amarelo">{P.quemConduz.etiqueta}</span>
      <h2 id="cpv-quem" class="c9-h2">{P.quemConduz.titulo}</h2>
      {P.quemConduz.paragrafos.map((paragrafo) => <p class="c9-p">{paragrafo}</p>)}
      <figure class="cpv-citacao">
        <blockquote>{P.quemConduz.citacao.texto}</blockquote>
        <figcaption>{P.quemConduz.citacao.autor}</figcaption>
      </figure>
    </div>
    <figure class="cpv-retrato">
      <OfferImage image={P.quemConduz.foto} zoom={false} />
    </figure>
  </div>
</section>

{DEPOIMENTOS_DE_PAIS.length > 0 && (
  <section id="depoimentos" class="c9-sec c9-sec--creme" aria-labelledby="cpv-depoimentos">
    <div class="c9-wrap c9-pilha c9-gap-26">
      <div class="c9-cabeca">
        <span class="c9-tag c9-cor--branco">{P.depoimentos.etiqueta}</span>
        <h2 id="cpv-depoimentos" class="c9-h2">{P.depoimentos.titulo}</h2>
      </div>
      <div class="c9-grade c9-min-300 c9-grade--20">
        {DEPOIMENTOS_DE_PAIS.map((depoimento) => (
          <figure class="cpv-citacao">
            <blockquote>{depoimento.texto}</blockquote>
            <figcaption>{depoimento.autor}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<section id="como-funciona" class="c9-sec c9-sec--chao" aria-labelledby="cpv-como">
  <div class="c9-wrap c9-pilha c9-gap-26">
    <div class="c9-cabeca">
      <span class="c9-tag c9-cor--branco">{P.comoFunciona.etiqueta}</span>
      <h2 id="cpv-como" class="c9-h2">{P.comoFunciona.titulo}</h2>
    </div>
    <div class="c9-grade c9-min-200 c9-grade--20">
      {P.comoFunciona.passos.map((passo, index) => (
        <article class:list={['c9-cartao', `c9-cor--${CORES_PASSOS[index % CORES_PASSOS.length]}`]}>
          <h3 class="c9-cartao__titulo">{`${index + 1}. ${passo.titulo}`}</h3>
          <div class="c9-cartao__texto"><p>{passo.texto}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="duvidas" class="c9-sec c9-sec--branco" aria-labelledby="cpv-duvidas">
  <div class="c9-wrap c9-pilha c9-gap-20">
    <h2 id="cpv-duvidas" class="c9-h2">{P.duvidas.titulo}</h2>
    <div class="c9-grade c9-min-440 c9-grade--14 pk-duvidas">
      {P.duvidas.itens.map((item, index) => (
        <details class="c9-duvida pk-duvida" open={index === 0}>
          <summary>{item.pergunta}</summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="resgatar" class="c9-sec pk-pontilhado" aria-labelledby="cpv-resgatar">
  <div class="c9-wrap c9-lado c9-lado--topo">
    <div class="c9-pilha c9-gap-14 c9-b420">
      <span class="c9-tag c9-cor--amarelo">{P.resgatar.etiqueta}</span>
      <h2 id="cpv-resgatar" class="c9-h2">{P.resgatar.titulo}</h2>
      <p class="c9-p">{P.resgatar.texto}</p>
    </div>
    <div class="pk-form">
      {ready && formulario ? (
        <BolsaResgate client:load {...formulario} />
      ) : (
        <div class="c9-pilha c9-gap-16">
          {estado && (
            <div class:list={['pk-estado', `c9-cor--${podeRetomar ? 'rosa' : 'azul-claro'}`]}>
              <span class="c9-tag">{estado.etiqueta}</span>
              <h3 class="pk-estado__titulo">{estado.titulo}</h3>
              <p class="c9-p">{estado.texto}</p>
              <a class="pk-link" href="mailto:contato@sistemazero.com.br">{P.estados.contato}</a>
            </div>
          )}
          {podeRetomar && formulario && (
            <details id="retomar" class="pk-retomar">
              <summary>{P.estados.retomar.botao}</summary>
              <p>{P.estados.retomar.texto}</p>
              <BolsaResgate client:load {...formulario} retryOnly />
            </details>
          )}
        </div>
      )}
    </div>
  </div>
</section>
