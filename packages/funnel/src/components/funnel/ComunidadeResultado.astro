---
import { visualDe } from '../../funnels/comunidade-dos-criadores/oferta/visuals'
import type { Condition } from '../../funnels/comunidade-dos-criadores/quiz/engine'
import { quizPathWithHeadline } from '../../funnels/comunidade-dos-criadores/quiz/entry-copy'
import type { CommunityResult } from '../../funnels/comunidade-dos-criadores/quiz/result'
import ComunidadeQuizFeedback from '../../islands/ComunidadeQuizFeedback'
import ComunidadeRelato from './oferta/ComunidadeRelato.astro'
import ComunidadeVisual from './oferta/ComunidadeVisual.astro'

interface Props {
  result: CommunityResult
  imagesBase: string
  basePath: string
  funnel: string
  revision: number
  sessionToken: string
  /** A manchete que a família viu (`attribution.quizHeadline`): os links de volta ao quiz a mantêm. */
  headline?: string | null
}
const { result: r, imagesBase, basePath, revision, sessionToken, headline } = Astro.props
const quizPath = quizPathWithHeadline(basePath, headline)

// v5 (16/10/2026): o resultado é a ponte entre o diagnóstico e a oferta, na ordem dos níveis de
// consciência. O título nomeia o problema; o quadro devolve as respostas da família; o texto
// explica por que acontece e o que muda isso (a criação de jogos, ainda sem o produto); a
// Comunidade só aparece em "Onde isso acontece", com UMA tela real e os relatos; o botão leva à
// página de oferta do perfil. Sem preço aqui.
const ICONE_DA_CONDICAO: Record<Condition, string> = {
  ferramenta: 'construction',
  desenho: 'palette',
  formato: 'videocam',
  computador: 'computer',
  reforco: 'school',
}
// Uma sequência de telas (o cavaleiro do Pinta ao Estúdio, a reação ligada e desligada) não cabe
// numa coluna estreita: vai embaixo do texto.
const quadros = visualDe(r.visual)?.frames.length ?? 1
const telaLarga = quadros > 1
---
<main id="quiz" class="cq-result" data-quiz-profile={r.decision.profile} data-quiz-state={r.decision.state}>
  <section class="cq-res-hero" aria-labelledby="titulo-resultado">
    <div class="wrap cq-res-hero-grade">
      <div class="cq-res-hero-texto">
        <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">insights</span>O que as suas respostas mostram</span>
        {r.approximateNote && <p class="cq-res-aproximado">{r.approximateNote}</p>}
        <h1 id="titulo-resultado" class="kof-display">{r.title}</h1>
      </div>
      <img class="cq-res-zappy" src={`${imagesBase}/zappy-happy.webp`} alt="" width="300" height="300" />
    </div>
  </section>

  <section class="section cq-res-comeco">
    <div class="wrap cq-res-duas cq-res-duas--contou">
      <section class="cq-contou kof-banda" aria-labelledby="titulo-contou" data-quiz-told>
        <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">checklist</span>Com as suas palavras</span>
        <h2 id="titulo-contou" class="kof-display">O que você contou</h2>
        <ul>{r.told.map((linha) => <li>{linha}</li>)}</ul>
        <a class="cq-contou-rever" href={`${quizPath}#rever`}>Rever ou ajustar as respostas</a>
      </section>
      <div class="cq-res-texto">
        <div class="sub-head">
          <span class="kof-ladrilho kof-ladrilho--rosa" aria-hidden="true"><span class="material-symbols-rounded">lightbulb</span></span>
          <h2 class="kof-display">Por que isso acontece</h2>
        </div>
        <div class="prosa" data-quiz-why>{r.why.map((p) => <p>{p}</p>)}</div>
        <div class="sub-head cq-res-muda">
          <span class="kof-ladrilho kof-ladrilho--verde" aria-hidden="true"><span class="material-symbols-rounded">sports_esports</span></span>
          <h2 class="kof-display">O que muda isso</h2>
        </div>
        <div class="prosa" data-quiz-change>{r.change.map((p) => <p>{p}</p>)}</div>
      </div>
    </div>
  </section>

  <section class="fundo-folha cq-res-comunidade" aria-labelledby="titulo-onde" data-quiz-product-introduction>
    <div class="folha">
      <div class="wrap">
        <div class="cap-head cor-azul">
          <span class="cap-chip"><span class="material-symbols-rounded cap-chip-icone" aria-hidden="true">rocket_launch</span><span class="cap-chip-texto">Comunidade dos Criadores</span></span>
          <h2 id="titulo-onde" class="kof-display">Onde isso acontece</h2>
        </div>
        <div class:list={['bloco', 'cq-res-ponte', telaLarga ? 'bloco--largo' : 'bloco--lado']}>
          <div class="bloco-texto">
            <div class:list={['prosa', { 'prosa--colunas': telaLarga }]} data-quiz-where>{r.where.map((p) => <p>{p}</p>)}</div>
          </div>
          <div class="bloco-visuais"><ComunidadeVisual visual={r.visual} imagesBase={imagesBase} /></div>
        </div>
        <p class="cq-note cq-res-nota">{quadros > 1 ? 'Telas reais da plataforma. Elas podem ser ampliadas.' : 'Tela real da plataforma. Ela pode ser ampliada.'}</p>
        <div class="relatos relatos--soltas" data-quiz-relatos>
          {r.relatos.map((id) => <ComunidadeRelato id={id} imagesBase={imagesBase} variant="solta" />)}
        </div>

        {r.conditions.length > 0 && (
          <section class="cq-callout" aria-labelledby="titulo-condicoes">
            <div class="sub-head">
              <span class="kof-ladrilho kof-ladrilho--laranja" aria-hidden="true"><span class="material-symbols-rounded">info</span></span>
              <h2 id="titulo-condicoes" class="kof-display">Antes de seguir</h2>
            </div>
            <div class="cq-callout-itens">
              {r.conditions.map((c) => (
                <div class="prosa" data-quiz-condition={c.kind} data-quiz-condition-unmet={c.unmet ? 'sim' : 'nao'}>
                  <h3 class="kof-display"><span class="material-symbols-rounded" aria-hidden="true">{ICONE_DA_CONDICAO[c.kind]}</span>{c.title}</h3>
                  <p>{c.text}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </section>

  <section class="section cq-res-convite" aria-labelledby="titulo-convite">
    <div class="wrap">
      <div class="cq-res-cta kof-marca">
        <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">family_star</span>Comunidade dos Criadores</span>
        <h2 id="titulo-convite" class="kof-display">O próximo passo</h2>
        {r.next.map((p) => <p>{p}</p>)}
        <div class="cq-actions"><a class="kof-btn kof-btn--grande kof-btn--inversa" href={r.offerPath} data-quiz-offer>{r.cta}<span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>
  <div class="wrap cq-res-opiniao">
    <ComunidadeQuizFeedback client:load revision={revision} quizPath={quizPath} sessionToken={sessionToken} />
  </div>
</main>
