---
import atkinsonCorpo from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url'
import bricolageTitulo from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url'
import silkscreenPixel from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url'
import '../../../styles/comunidade-adulto.css'
import '../../../styles/desafio-adulto.css'
import { PAGINA_DESAFIO_ADULTO as P } from '../../../funnels/desafio-adulto/oferta/pagina'
import { precoDoDesafio, preencherPreco } from '../../../funnels/desafio-primeiro-jogo/oferta/preco'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPageData } from '../../../server/offer-page'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import '../../../styles/ofertas-adulto.css'
import AdultOfferBar from './AdultOfferBar.astro'
import OfferImage from './OfferImage.astro'
import OfferImageZoom from './OfferImageZoom.astro'

type Props = OfferPageData['bodyProps']
const { f, productName, priceReais, ofertaUrl, coupon } = Astro.props
const preco = precoDoDesafio(priceReais, coupon)
const fill = (texto: string) => preencherPreco(texto, preco)
const heroImg = P.hero.imagens[0]
---
<BaseLayout title={P.seoTitle} description={P.description} canonical={ofertaUrl} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass="theme-arcade">
  <ProductJsonLd slot="head" name={productName} description={P.description} price={priceReais} url={ofertaUrl} image={heroImg.src} />
  {[bricolageTitulo, atkinsonCorpo, silkscreenPixel].map((href) => <link slot="head" rel="preload" as="font" href={href} type="font/woff2" crossorigin="anonymous" />)}
  <link slot="head" rel="preload" as="image" href={heroImg.src} fetchpriority="high" />
<div class="cda da">
 <a class="cda-pular" href="#conteudo">
  {P.pularParaConteudo}
 </a>
 <header class="cda-topo">
  <div class="cda-wrap cda-topo__linha">
   <a aria-label="Sistema Zero, voltar ao topo" class="cda-topo__marca" href="#topo">
    <OfferImage image={P.topo.imagens[0]} zoom={false} eager />
    <span class="cda-topo__selo">
     {P.topo.rotulos[0]}
    </span>
   </a>
   <nav aria-label="Atalhos da página" class="cda-topo__nav">
    <a class="cda-topo__link" href="#como-funciona">
     {P.topo.acoes[0]}
    </a>
    <a class="cda-topo__link" href="#jogo">
     {P.topo.acoes[1]}
    </a>
    <a class="cda-btn cda-btn--compacta" href="#oferta">
     {P.topo.acoes[2]}
    </a>
   </nav>
  </div>
 </header>
 <main id="conteudo">
  <section aria-labelledby="adult-titulo" class="cda-secao cda-hero" id="inicio">
   <div class="cda-wrap cda-hero__grade">
    <div class="cda-hero__texto">
     <p class="cda-rotulo cor-verde">
      {P.hero.rotulos[0]}
     </p>
     <h1 class="cda-h1" id="adult-titulo">{P.hero.titulo.antes}<span class="cda-destaque">{P.hero.titulo.destaque}</span>{P.hero.titulo.depois}</h1>
     <p class="cda-hero__lead">
      {P.hero.texto}
     </p>
     <ul class="cda-checks">
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.hero.rotulos[1]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.hero.rotulos[2]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.hero.rotulos[3]}
       </span>
      </li>
     </ul>
     <div class="da-acoes">
      <a class="cda-btn cda-btn--grande" href="#oferta">
       {P.hero.acoes[0]}
      </a>
      <a class="da-link" href="#como-funciona">
       {P.hero.acoes[1]}
      </a>
     </div>
     <p class="cda-garantia">
      {fill(P.hero.paragrafos[0])}
     </p>
    </div>
    <div class="da-hero__visual">
     <figure class="da-tela">
      <div class="da-tela__barra">
       <span>
        {P.hero.rotulos[4]}
       </span>
       <span>
        {P.hero.rotulos[5]}
       </span>
      </div>
      <OfferImage image={P.hero.imagens[0]} linkClass="adult-image" eager />
      <figcaption class="cda-legenda">
       {P.hero.legendas[0]}
      </figcaption>
     </figure>
     <span class="da-faixa">
      {P.hero.rotulos[6]}
     </span>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-comeco" class="cda-secao cda-secao--fundo-2" id="comeco">
   <div class="cda-wrap da-pilha">
    <div class="cda-cabeca cda-cabeca--larga">
     <p class="cda-rotulo cor-verde">
      {P.comeco.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-comeco">
      {P.comeco.titulo}
     </h2>
     <p class="cda-suave">
      {P.comeco.paragrafos[0]}
     </p>
    </div>
    <div class="cda-dupla adult-start">
     <div class="cda-cabeca">
      <p class="cda-suave">
       {P.comeco.paragrafos[1]}
      </p>
      <p class="cda-suave">
       {P.comeco.paragrafos[2]}
      </p>
      <p class="adult-callout">
       {P.comeco.paragrafos[3]}
      </p>
     </div>
     <figure class="adult-figure">
      <OfferImage image={P.comeco.imagens[0]} linkClass="adult-image" />
      <figcaption class="cda-legenda">
       {P.comeco.legendas[0]}
      </figcaption>
     </figure>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-como-funciona" class="cda-secao" id="como-funciona">
   <div class="cda-wrap da-pilha">
    <div class="cda-cabeca cda-cabeca--larga">
     <p class="cda-rotulo cor-verde">
      {P.comoFunciona.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-como-funciona">
      {P.comoFunciona.titulo}
     </h2>
     <p class="cda-suave">
      {P.comoFunciona.paragrafos[0]}
     </p>
    </div>
    <div class="adult-comparison">
     <div class="adult-choice">
      <p class="cda-rotulo cor-azul">
       {P.comoFunciona.rotulos[1]}
      </p>
      <figure class="adult-figure">
       <OfferImage image={P.comoFunciona.imagens[0]} linkClass="adult-image" />
       <figcaption class="cda-legenda">
        {P.comoFunciona.legendas[0]}
       </figcaption>
      </figure>
     </div>
     <div class="adult-choice">
      <p class="cda-rotulo cor-rosa">
       {P.comoFunciona.rotulos[2]}
      </p>
      <figure class="adult-figure">
       <OfferImage image={P.comoFunciona.imagens[1]} linkClass="adult-image" />
       <figcaption class="cda-legenda">
        {P.comoFunciona.legendas[1]}
       </figcaption>
      </figure>
     </div>
    </div>
    <div class="adult-explanation">
     <strong>
      {P.comoFunciona.destaques[0]}
     </strong>
     <p>
      {P.comoFunciona.paragrafos[1]}
     </p>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-programacao" class="cda-secao cda-secao--fundo-2" id="programacao">
   <div class="cda-wrap da-pilha">
    <div class="cda-cabeca cda-cabeca--larga">
     <p class="cda-rotulo cor-verde">
      {P.programacao.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-programacao">
      {P.programacao.titulo}
     </h2>
     <p class="cda-suave">
      {P.programacao.paragrafos[0]}
     </p>
    </div>
    <div class="cda-dupla adult-programming">
     <figure class="adult-figure">
      <OfferImage image={P.programacao.imagens[0]} linkClass="adult-image" />
      <figcaption class="cda-legenda">
       {P.programacao.legendas[0]}
      </figcaption>
     </figure>
     <div class="cda-cabeca">
      <h3 class="cda-h3">
       {P.programacao.subtitulos[0]}
      </h3>
      <p class="cda-suave">
       {P.programacao.paragrafos[1]}
      </p>
      <ul class="adult-tests">
       <li>
        <span class="adult-dot cor-rosa">
        </span>
        <div>
         <strong>
          {P.programacao.destaques[0]}
         </strong>
         <p>
          {P.programacao.paragrafos[2]}
         </p>
        </div>
       </li>
       <li>
        <span class="adult-dot cor-verde">
        </span>
        <div>
         <strong>
          {P.programacao.destaques[1]}
         </strong>
         <p>
          {P.programacao.paragrafos[3]}
         </p>
        </div>
       </li>
      </ul>
      <p class="cda-suave">
       {P.programacao.paragrafos[4]}
      </p>
     </div>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-jogo" class="cda-secao" id="jogo">
   <div class="cda-wrap da-pilha">
    <div class="cda-cabeca cda-cabeca--larga">
     <p class="cda-rotulo cor-verde">
      {P.jogo.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-jogo">
      {P.jogo.titulo}
     </h2>
     <p class="cda-suave">
      {P.jogo.paragrafos[0]}
     </p>
    </div>
    <ol class="da-fases adult-phases">
     <li class="da-fase cor-azul">
      <span class="cda-rotulo cda-rotulo--pequeno">
       {P.jogo.rotulos[1]}
      </span>
      <h3 class="da-fase__titulo">
       {P.jogo.subtitulos[0]}
      </h3>
      <p class="da-fase__texto">
       {P.jogo.paragrafos[1]}
      </p>
      <p class="adult-phase-learning" set:html={P.jogo.paragrafos[2]} />
     </li>
     <li class="da-fase cor-rosa">
      <span class="cda-rotulo cda-rotulo--pequeno">
       {P.jogo.rotulos[2]}
      </span>
      <h3 class="da-fase__titulo">
       {P.jogo.subtitulos[1]}
      </h3>
      <p class="da-fase__texto">
       {P.jogo.paragrafos[3]}
      </p>
      <p class="adult-phase-learning" set:html={P.jogo.paragrafos[4]} />
     </li>
     <li class="da-fase cor-verde">
      <span class="cda-rotulo cda-rotulo--pequeno">
       {P.jogo.rotulos[3]}
      </span>
      <h3 class="da-fase__titulo">
       {P.jogo.subtitulos[2]}
      </h3>
      <p class="da-fase__texto">
       {P.jogo.paragrafos[5]}
      </p>
      <p class="adult-phase-learning" set:html={P.jogo.paragrafos[6]} />
     </li>
    </ol>
    <div class="adult-explanation">
     <strong>
      {P.jogo.destaques[0]}
     </strong>
     <p>
      {P.jogo.paragrafos[7]}
     </p>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-aula" class="cda-secao cda-secao--fundo-2" id="aula">
   <div class="cda-wrap da-pilha">
    <div class="cda-cabeca cda-cabeca--larga">
     <p class="cda-rotulo cor-verde">
      {P.aula.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-aula">
      {P.aula.titulo}
     </h2>
     <p class="cda-suave">
      {P.aula.paragrafos[0]}
     </p>
    </div>
    <div class="cda-dupla adult-aula">
     <figure class="adult-figure">
      <OfferImage image={P.aula.imagens[0]} linkClass="adult-image" />
      <figcaption class="cda-legenda">
       {P.aula.legendas[0]}
      </figcaption>
     </figure>
     <ol class="adult-method">
      <li>
       <span>
        {P.aula.rotulos[1]}
       </span>
       <div>
        <h3>
         {P.aula.subtitulos[0]}
        </h3>
        <p>
         {P.aula.paragrafos[1]}
        </p>
       </div>
      </li>
      <li>
       <span>
        {P.aula.rotulos[2]}
       </span>
       <div>
        <h3>
         {P.aula.subtitulos[1]}
        </h3>
        <p>
         {P.aula.paragrafos[2]}
        </p>
       </div>
      </li>
      <li>
       <span>
        {P.aula.rotulos[3]}
       </span>
       <div>
        <h3>
         {P.aula.subtitulos[2]}
        </h3>
        <p>
         {P.aula.paragrafos[3]}
        </p>
       </div>
      </li>
      <li>
       <span>
        {P.aula.rotulos[4]}
       </span>
       <div>
        <h3>
         {P.aula.subtitulos[3]}
        </h3>
        <p>
         {P.aula.paragrafos[4]}
        </p>
       </div>
      </li>
     </ol>
    </div>
    <div class="adult-review">
     <div class="cda-cabeca">
      <h3 class="cda-h3">
       {P.aula.subtitulos[4]}
      </h3>
      <p class="cda-suave">
       {P.aula.paragrafos[5]}
      </p>
     </div>
     <figure class="adult-figure">
      <OfferImage image={P.aula.imagens[1]} linkClass="adult-image" />
      <figcaption class="cda-legenda">
       {P.aula.legendas[1]}
      </figcaption>
     </figure>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-habilidades" class="cda-secao" id="habilidades">
   <div class="cda-wrap da-pilha">
    <div class="cda-cabeca cda-cabeca--larga">
     <p class="cda-rotulo cor-verde">
      {P.habilidades.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-habilidades">
      {P.habilidades.titulo}
     </h2>
     <p class="cda-suave">
      {P.habilidades.paragrafos[0]}
     </p>
    </div>
    <ul class="da-habilidades adult-skills">
     <li class="da-habilidade cor-amarelo">
      <span class="cda-rotulo">
       {P.habilidades.rotulos[1]}
      </span>
      <h3 class="da-habilidade__titulo">
       {P.habilidades.subtitulos[0]}
      </h3>
      <p class="da-habilidade__texto">
       {P.habilidades.paragrafos[1]}
      </p>
     </li>
     <li class="da-habilidade cor-verde">
      <span class="cda-rotulo">
       {P.habilidades.rotulos[2]}
      </span>
      <h3 class="da-habilidade__titulo">
       {P.habilidades.subtitulos[1]}
      </h3>
      <p class="da-habilidade__texto">
       {P.habilidades.paragrafos[2]}
      </p>
     </li>
     <li class="da-habilidade cor-azul">
      <span class="cda-rotulo">
       {P.habilidades.rotulos[3]}
      </span>
      <h3 class="da-habilidade__titulo">
       {P.habilidades.subtitulos[2]}
      </h3>
      <p class="da-habilidade__texto">
       {P.habilidades.paragrafos[3]}
      </p>
     </li>
     <li class="da-habilidade cor-rosa">
      <span class="cda-rotulo">
       {P.habilidades.rotulos[4]}
      </span>
      <h3 class="da-habilidade__titulo">
       {P.habilidades.subtitulos[3]}
      </h3>
      <p class="da-habilidade__texto">
       {P.habilidades.paragrafos[4]}
      </p>
     </li>
    </ul>
    <div class="adult-explanation">
     <strong>
      {P.habilidades.destaques[0]}
     </strong>
     <p>
      {P.habilidades.paragrafos[5]}
     </p>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-realizacao" class="cda-secao cda-secao--fundo-2" id="realizacao">
   <div class="cda-wrap cda-dupla">
    <div class="cda-cabeca">
     <p class="cda-rotulo cor-verde">
      {P.realizacao.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-realizacao">
      {P.realizacao.titulo}
     </h2>
     <p class="cda-suave">
      {P.realizacao.paragrafos[0]}
     </p>
     <p class="cda-suave">
      {P.realizacao.paragrafos[1]}
     </p>
     <p class="adult-callout">
      {P.realizacao.paragrafos[2]}
     </p>
     <p class="cda-suave">
      {P.realizacao.paragrafos[3]}
     </p>
    </div>
    <figure class="adult-figure adult-notebook">
     <OfferImage image={P.realizacao.imagens[0]} linkClass="adult-image" />
     <figcaption class="cda-legenda">
      {P.realizacao.legendas[0]}
     </figcaption>
    </figure>
   </div>
  </section>
  <section aria-labelledby="adult-para-quem" class="cda-secao" id="para-quem">
   <div class="cda-wrap cda-dupla">
    <div class="cda-cabeca">
     <p class="cda-rotulo cor-verde">
      {P.paraQuem.rotulos[0]}
     </p>
     <h2 class="cda-h2" id="adult-para-quem">
      {P.paraQuem.titulo}
     </h2>
     <ul class="da-perfis">
      <li class="cor-amarelo" set:html={P.paraQuem.itens[0]} />
      <li class="cor-rosa" set:html={P.paraQuem.itens[1]} />
      <li class="cor-azul" set:html={P.paraQuem.itens[2]} />
     </ul>
     <p class="cda-suave">
      {P.paraQuem.paragrafos[0]}
     </p>
    </div>
    <div class="adult-requirements">
     <p class="cda-rotulo cor-verde">
      {P.paraQuem.rotulos[1]}
     </p>
     <h3 class="cda-h3">
      {P.paraQuem.subtitulos[0]}
     </h3>
     <ul class="cda-checks">
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.paraQuem.rotulos[2]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.paraQuem.rotulos[3]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.paraQuem.rotulos[4]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.paraQuem.rotulos[5]}
       </span>
      </li>
     </ul>
     <p class="cda-suave">
      {P.paraQuem.paragrafos[1]}
     </p>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-quem-criou" class="cda-secao cda-secao--fundo-2" id="quem-criou">
   <div class="cda-wrap cda-dupla cda-dupla--fundadores">
    <figure class="cda-fundadores__foto">
     <OfferImage image={P.quemCriou.imagens[0]} zoom={false} />
    </figure>
    <div class="cda-cabeca">
     <p class="cda-rotulo cor-verde">
      {P.quemCriou.rotulos[0]}
     </p>
     <h2 class="cda-h2 cda-h2--menor" id="adult-quem-criou">
      {P.quemCriou.titulo}
     </h2>
     <p class="cda-suave">
      {P.quemCriou.paragrafos[0]}
     </p>
     <p class="cda-suave">
      {P.quemCriou.paragrafos[1]}
     </p>
     <p class="cda-suave">
      {P.quemCriou.paragrafos[2]}
     </p>
    </div>
   </div>
  </section>
  <section aria-labelledby="adult-oferta" class="cda-secao cda-secao--grade" id="oferta">
   <div class="cda-wrap cda-dupla cda-dupla--oferta">
    <div class="cda-cabeca cda-cabeca--oferta">
     <p class="cda-rotulo cor-verde">
      {P.oferta.rotulos[0]}
     </p>
     <h2 class="cda-h2 cda-h2--oferta" id="adult-oferta">
      {P.oferta.titulo}
     </h2>
     <p class="cda-suave">
      {P.oferta.paragrafos[0]}
     </p>
     <div class="cda-caixa cda-caixa--depois">
      <h3 class="cda-rotulo cda-rotulo--pequeno cor-verde">
       {P.oferta.subtitulos[0]}
      </h3>
      <ol class="cda-depois">
       <li  set:html={P.oferta.itens[0]} />
       <li  set:html={P.oferta.itens[1]} />
       <li  set:html={P.oferta.itens[2]} />
      </ol>
     </div>
    </div>
