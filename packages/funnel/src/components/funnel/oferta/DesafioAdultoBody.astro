        </path>
       </svg>
       <span>
        {P.oferta.rotulos[3]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.oferta.rotulos[4]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.oferta.rotulos[5]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.oferta.rotulos[6]}
       </span>
      </li>
      <li>
       <svg aria-hidden="true" class="cda-check" height="22" viewBox="0 0 24 24" width="22">
        <path d="M20 6 9 17l-5-5">
        </path>
       </svg>
       <span>
        {P.oferta.rotulos[7]}
       </span>
      </li>
     </ul>
     {preco.aviso && <p class="adult-coupon" role={preco.aviso.alerta ? 'alert' : 'status'}>{preco.aviso.texto}</p>}
        <button class="cda-btn cda-btn--grande" data-checkout-cta data-analytics-id="desafio-adulto-oferta-comprar" type="button">
      {P.oferta.acoes[0]}
     </button>
     <p class="da-cartao__garantia" set:html={P.oferta.paragrafos[3]} />
     <p class="adult-payment">
