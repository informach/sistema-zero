---
import {
  CURSO_PAIS_AUTISMO_PRESENTE,
  DEPOIMENTOS_CURSO_AUTISMO,
} from '../../../content/curso-pais-autismo'
import { prazoDaOferta } from '../../../content/presente-resgate'
// Página de venda do curso para pais "Como ajudar seu filho autista a lidar com frustrações e evitar
// crises" (`kids/como-ajudar-seu-filho-autista-nas-frustracoes`, 25/11/2026), com a psicóloga
// Vivianne Lima. Mesmo corpo do guia para pais (`CursoPaisOferta`, proposta de 26/11/2026: a estrutura
// das outras páginas de venda) com o bloco de compra na seção `#oferta`, embaixo. Venda: a copy de `cursoAutismoVenda` com o preço
// do catálogo (e o cupom já cotado) e o pré-checkout. Modo presente (`?presente=`, se um dia houver
// presente deste curso): a mesma página, com o cartão do presente e o cadastro numa janela.
import { cursoAutismoVenda } from '../../../funnels/autismo-frustracoes/oferta'
import { precoDoDesafio } from '../../../funnels/desafio-primeiro-jogo/oferta/preco'
import { comPreco } from '../../../funnels/vilao-em-aliado/oferta'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import { funnelOgImage } from '../../../lib/seo'
import { getDeps } from '../../../server/deps'
import type { OfferPageData } from '../../../server/offer-page'
import { cartaoDoPresente } from '../../../server/presente-cartao'
import CursoPaisOferta from '../../referrals/CursoPaisOferta.astro'
import PresenteLayout from '../../referrals/PresenteLayout.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import PrecoDoCartao from './PrecoDoCartao.astro'
import PresenteAcao from './PresenteAcao.astro'
import PresenteJanela from './PresenteJanela.astro'

type Props = OfferPageData['bodyProps']
const { f, productName, priceReais, coupon, presente, access } = Astro.props
const preco = precoDoDesafio(priceReais, coupon)
// O prazo da oferta do catálogo ("6 meses"); sem prazo em meses, as frases saem sem prazo.
const prazo =
  access?.mode === 'fixed' && access.durationUnit === 'months' && access.durationValue
    ? prazoDaOferta(access).dias
    : null
const venda = comPreco(cursoAutismoVenda(access?.guaranteeDays ?? null, prazo), preco.preco)
// Modo presente (`?presente=`, 26/11/2026): a página de venda inteira, com o selo de quem dá o
// presente e o MESMO cartão com o preço riscado até R$ 0 e o cadastro numa janela.
const contaUrl = getDeps().env.KIDS_COMMUNITY_URL.replace(/\/$/, '')
const cartao = presente
  ? cartaoDoPresente(presente, {
      communityUrl: contaUrl,
      priceReais,
      offerResolved: access != null,
    })
  : null
const origem = cartao?.etiqueta ?? null
// No presente, a copy de presente do curso em volta do cartão (nada de preço ou pagamento).
const P = cartao ? CURSO_PAIS_AUTISMO_PRESENTE : venda
// A página pública é o `basePath`; o `/oferta` do funil aponta para ela.
const canonical = new URL(f.basePath, Astro.site ?? Astro.url).toString()
// A seção da oferta: o texto ao lado do cartão completa o cartão (o prazo, o preço e a condição
// ficam só nele, na venda e no presente), sem repetir a linha dele.
const cabeca = P.compra
const barra = cartao
  ? {
      ...venda.barra,
      titulo: cartao.etiqueta,
      texto: cartao.precoFinal,
      cta: cartao.cta,
      presente: cartao.aberto,
    }
  : venda.barra
---
<PresenteLayout
  title={P.seoTitle}
  description={P.description}
  ready
  alvo="oferta"
  barra={barra}
  links={P.topo.links}
  cta={P.topo.cta}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  indexavel={!presente}
  canonical={canonical}
  termosHref={`${f.basePath}/termos`}
>
  <ProductJsonLd slot="head" name={productName} description={P.description} price={priceReais} url={canonical} image={funnelOgImage(f, Astro.site ?? Astro.url)} />
  <CursoPaisOferta copy={P} selo={origem ?? undefined} depoimentos={DEPOIMENTOS_CURSO_AUTISMO}>
    <section slot="compra" id="oferta" class="c9-sec pk-pontilhado" aria-labelledby="curso-autismo-oferta" data-analytics-id="curso-autismo-oferta-secao">
      <div class="c9-wrap c9-lado c9-lado--topo">
        <div class="c9-pilha c9-gap-14 c9-b420">
          <span class="c9-tag c9-cor--amarelo">{cabeca.etiqueta}</span>
          <h2 id="curso-autismo-oferta" class="c9-h2">{cabeca.titulo}</h2>
          <p class="c9-p">{cabeca.texto}</p>
          {!presente && preco.aviso && (preco.aviso.alerta || !preco.descontoPct) && <p class:list={['c9-cupom', { 'c9-cupom--alerta': preco.aviso.alerta }]} role={preco.aviso.alerta ? 'alert' : undefined}>{preco.aviso.texto}</p>}
        </div>
        {cartao ? (
        <article class="c9-plano" data-analytics-id="curso-autismo-oferta-presente">
          <span class="c9-tag c9-cor--amarelo pm-etiqueta">{cartao.etiqueta}</span>
          <h3 class="c9-plano__nome">{venda.oferta.selo}</h3>
          <PrecoDoCartao de={cartao.precoCheio} valor={cartao.precoFinal} sufixo={cartao.condicao} />
          <p class="c9-plano__texto">{cartao.texto}</p>
          <PresenteAcao cartao={cartao} classeBotao="c9-plano__btn" analyticsId="curso-autismo-oferta-presente-abrir" />
        </article>
        ) : (
        <article class="c9-plano" data-analytics-id="curso-autismo-oferta">
          <h3 class="c9-plano__nome">{venda.oferta.selo}</h3>
          <PrecoDoCartao de={preco.precoCheio} valor={preco.preco} sufixo={venda.oferta.sufixo} desconto={preco.precoCheio && preco.descontoPct ? `${preco.descontoPct}% de desconto` : null} classeDesconto="c9-tag c9-cor--rosa" />
          <p class="c9-plano__texto">{venda.oferta.texto}</p>
          <button type="button" class="c9-plano__btn" data-checkout-cta data-analytics-id="curso-autismo-oferta-comprar">{venda.oferta.cta}</button>
          {venda.oferta.garantia && <p class="c9-plano__texto">{venda.oferta.garantia}</p>}
        </article>
        )}
      </div>
    </section>
  </CursoPaisOferta>
  {cartao && <PresenteJanela cartao={cartao} />}
  {!presente && <PreCheckoutModal client:idle basePath={f.basePath} funnel={f.key} ofertaPadrao={Astro.props.offerPrimary ? undefined : Astro.props.offerSlug} couponCode={preco.codigo} />}
</PresenteLayout>
