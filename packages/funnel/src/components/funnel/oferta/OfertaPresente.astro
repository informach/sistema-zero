---
// O bloco de compra da página da oferta no MODO PRESENTE (`?presente=<código>`, 25/11/2026): no
// lugar do preço e do botão de compra, quem dá o presente, o formulário do resgate (`BolsaResgate`,
// o mesmo da página do presente) ou o estado da campanha (agendada, pausada, encerrada) com a
// retomada. A copy é a do presente de curso (`presenteCursoCopy`). Vai dentro da seção `#oferta`
// das páginas Kids (`.c917`, classes `.c9-*`/`.pk-*`) e adultas (`.cda`, `.cda-*`/`.pa-*`).
import '../../../styles/presente-kids.css'
import '../../../styles/presente-adulto.css'
import type { EstadoPresente } from '../../../content/presente'
import { presenteCursoCopy } from '../../../content/presente-curso'
import { dataBrasilia } from '../../../content/presente-resgate'
import BolsaResgate from '../../../islands/BolsaResgate'
import type { OfferGiftMode } from '../../../server/offer-page'
import { giftVariant } from '../../../server/referral-gift-page'

interface Props {
  presente: OfferGiftMode
  communityUrl: string
  /** O slug da oferta da página: vai no resgate (a escolha do embaixador). */
  oferta: string
  /** O formulário do guia para pais ("guia" no lugar de "curso"; `/kids/vilao-em-aliado`). */
  formulario?: 'guia'
  /** O id do bloco (padrão `resgatar`; `null` quando a página já tem a âncora em volta). */
  ancora?: string | null
}
const { presente, communityUrl, oferta, formulario, ancora = 'resgatar' } = Astro.props
const { gift, kind } = presente
const audience = gift.audience === 'adult' ? 'adult' : 'kids'
const adulto = audience === 'adult'
const variante = giftVariant(gift.gift, audience) === 'pais' ? 'pais' : 'curso'
const P = presenteCursoCopy(audience, gift.gift, variante)
const campaign = gift.source.kind === 'campaign'
const nome = gift.source.name
const origem = (
  !campaign
    ? P.origem.pessoal
    : gift.source.context === 'event'
      ? P.origem.evento
      : P.origem.campanha
).replace('{{nome}}', nome)
const ready = kind === 'ready'
const fechado = kind === 'paused' || kind === 'ended'
const lastClaimAt = gift.endsAt ? new Date(Date.parse(gift.endsAt) - 1).toISOString() : null
const estado: EstadoPresente | null = ready
  ? null
  : {
      ...P.estados[kind],
      titulo:
        kind === 'ended' && !gift.endsAt
          ? P.estados.endedSemData
          : P.estados[kind].titulo.replace(
              '{{data}}',
              (kind === 'scheduled' ? gift.startsAt : lastClaimAt)
                ? dataBrasilia(
                    (kind === 'scheduled' ? gift.startsAt : lastClaimAt) as string,
                    false,
                  )
                : '',
            ),
    }
const resgate = {
  code: gift.code,
  referrerName: nome,
  communityUrl,
  audience,
  campaign,
  gift: gift.gift,
  variante: formulario ?? variante,
  oferta,
} as const
---
{adulto ? (
  <article id={ancora ?? undefined} class="op-presente pa-form" aria-labelledby="op-presente-titulo">
    <p class="cda-rotulo cor-verde">{origem}</p>
    <h3 id="op-presente-titulo" class="cda-h3">{P.resgatar.titulo}</h3>
    <p class="cda-suave">{P.resgatar.texto}</p>
    {ready ? (
      <BolsaResgate client:load {...resgate} />
    ) : (
      <div class="cda-coluna">
        {estado && (
          <div class:list={['pa-estado', `cor-${fechado ? 'rosa' : 'azul'}`]}>
            <span class="pa-estado__selo">{estado.etiqueta}</span>
            <h4 class="pa-estado__titulo">{estado.titulo}</h4>
            <p class="cda-suave">{estado.texto}</p>
          </div>
        )}
        {fechado && (
          <details id="retomar" class="pa-retomar">
            <summary>{P.estados.retomar.botao}</summary>
            <p class="cda-suave">{P.estados.retomar.texto}</p>
            <BolsaResgate client:load {...resgate} retryOnly />
          </details>
        )}
      </div>
    )}
  </article>
) : (
  <article id={ancora ?? undefined} class="c9-plano op-presente pk-form" aria-labelledby="op-presente-titulo">
    <span class="c9-tag c9-cor--amarelo">{origem}</span>
    <h3 id="op-presente-titulo" class="c9-plano__nome">{P.resgatar.titulo}</h3>
    <p class="c9-plano__texto">{P.resgatar.texto}</p>
    {ready ? (
      <BolsaResgate client:load {...resgate} />
    ) : (
      <div class="c9-pilha c9-gap-16">
        {estado && (
          <div class:list={['pk-estado', `c9-cor--${fechado ? 'rosa' : 'azul-claro'}`]}>
            <span class="c9-tag">{estado.etiqueta}</span>
            <h4 class="pk-estado__titulo">{estado.titulo}</h4>
            <p class="c9-p">{estado.texto}</p>
          </div>
        )}
        {fechado && (
          <details id="retomar" class="pk-retomar">
            <summary>{P.estados.retomar.botao}</summary>
            <p>{P.estados.retomar.texto}</p>
            <BolsaResgate client:load {...resgate} retryOnly />
          </details>
        )}
      </div>
    )}
  </article>
)}
