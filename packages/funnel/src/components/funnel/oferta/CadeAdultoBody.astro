---
// Página de venda do Cadê Todo Mundo adulto (`pro/cade-todo-mundo`, 25/11/2026). Uma página por
// oferta: o corpo é o da página do presente adulto (`PresenteAdultoOferta`, seções aprovadas, tema
// arcade `.cda`) com o bloco de compra no slot `compra`, no cartão da oferta adulta do Desafio
// (`.da-cartao`). Venda: a copy de `cadeAdultoVenda`, o preço do catálogo com o cupom já cotado e o
// pré-checkout. Modo presente (`?presente=`, 26/11/2026): a MESMA página e o MESMO cartão da venda,
// com a etiqueta de quem dá o presente, o preço riscado até R$ 0 e "Quero o meu presente" abrindo o
// cadastro numa janela (`PresenteAcao` + `PresenteJanela`). O prazo e a garantia vêm do catálogo.
import '../../../styles/desafio-adulto.css'
import '../../../styles/ofertas-adulto.css'
import { presenteAdultoDaOferta } from '../../../content/presente-adulto'
import { prazoDaOferta } from '../../../content/presente-resgate'
import { cadeAdultoVenda } from '../../../funnels/cade-adulto/oferta'
import { precoDoDesafio } from '../../../funnels/desafio-primeiro-jogo/oferta/preco'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import { getDeps } from '../../../server/deps'
import type { OfferPageData } from '../../../server/offer-page'
import { cartaoDoPresente } from '../../../server/presente-cartao'
import { isCadeGift } from '../../../server/referral-gift-page'
import PresenteAdultoLayout from '../../referrals/PresenteAdultoLayout.astro'
import PresenteAdultoOferta from '../../referrals/PresenteAdultoOferta.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import PresenteAcao from './PresenteAcao.astro'
import PresenteJanela from './PresenteJanela.astro'

type Props = OfferPageData['bodyProps']
const { f, productName, priceReais, ofertaUrl, coupon, presente, access } = Astro.props
// O prazo é o da oferta de venda (1 ano); o do presente vai só no cartão (`cartaoDoPresente`).
const prazo = prazoDaOferta(access?.mode === 'fixed' ? access : null)
const venda = cadeAdultoVenda(prazo, access?.guaranteeDays ?? null)
const preco = precoDoDesafio(priceReais, coupon)
const communityUrl = getDeps().env.COMMUNITY_URL.replace(/\/$/, '')
const cartao = presente ? cartaoDoPresente(presente, { communityUrl, priceReais }) : null
const origem = cartao ? cartao.etiqueta.toLocaleUpperCase('pt-BR') : null
// No presente, as seções falam do presente (a copy aprovada da página do presente, com o prazo dele).
const P = presente
  ? presenteAdultoDaOferta(isCadeGift(presente.gift.gift) ? presente.gift.gift : undefined)
  : venda
// No presente, o texto ao lado do cartão diz o prazo do PRESENTE (não o "1 ano" da venda).
const cabeca = cartao ? { ...venda.oferta, texto: cartao.texto } : venda.oferta
const barra = cartao
  ? { titulo: cartao.etiqueta, texto: cartao.precoFinal, cta: cartao.cta, presente: cartao.aberto }
  : { titulo: preco.preco, texto: venda.barra.texto, cta: venda.barra.cta }
---
<PresenteAdultoLayout
  title={P.seoTitle}
  description={P.description}
  ready
  alvo="oferta"
  barra={barra}
  cta={P.topo.cta}
  indexavel={!presente}
  canonical={ofertaUrl}
  termosHref={`${f.basePath}/termos`}
>
  <ProductJsonLd slot="head" name={productName} description={P.description} price={priceReais} url={ofertaUrl} image={P.hero.tela.imagem.src} />
  <PresenteAdultoOferta copy={P} selo={origem ?? undefined} compra>
    <section slot="compra" id="oferta" class="cda-secao cda-secao--grade" aria-labelledby="cade-adulto-oferta" data-analytics-id="cade-adulto-oferta">
      <div class="cda-wrap cda-dupla cda-dupla--oferta">
        <div class="pa-texto">
          <p class="cda-rotulo cor-verde">{cabeca.etiqueta}</p>
          <h2 id="cade-adulto-oferta" class="cda-h2">{cabeca.titulo}</h2>
          <p class="cda-suave">{cabeca.texto}</p>
        </div>
        {cartao ? (
          <div class="da-cartao">
            <span class="da-cartao__selo">{venda.oferta.selo}</span>
            <p class="cda-rotulo cor-verde">{cartao.etiqueta}</p>
            <del class="adult-price-before">{cartao.precoCheio}</del>
            <p class="da-cartao__preco">{cartao.precoFinal}</p>
            <p class="cda-suave">{cartao.texto}</p>
            <PresenteAcao cartao={cartao} classeBotao="cda-btn cda-btn--grande" analyticsId="cade-adulto-oferta-presente" />
          </div>
        ) : (
          <div class="da-cartao">
            <span class="da-cartao__selo">{venda.oferta.selo}</span>
            {preco.precoCheio && <del class="adult-price-before">{preco.precoCheio}</del>}
            <p class="da-cartao__preco">{preco.preco}<span> {venda.oferta.sufixo}</span></p>
            <p class="cda-suave">{venda.oferta.texto}</p>
            {preco.aviso && <p class="adult-coupon" role={preco.aviso.alerta ? 'alert' : 'status'}>{preco.aviso.texto}</p>}
            <button class="cda-btn cda-btn--grande" data-checkout-cta data-analytics-id="cade-adulto-oferta-comprar" type="button">{venda.oferta.cta}</button>
            {venda.oferta.garantia && <p class="da-cartao__garantia">{venda.oferta.garantia}</p>}
          </div>
        )}
      </div>
      {cartao && <PresenteJanela cartao={cartao} />}
    </section>
  </PresenteAdultoOferta>
  {!presente && <PreCheckoutModal client:idle basePath={f.basePath} funnel={f.key} ofertaPadrao={Astro.props.offerPrimary ? undefined : Astro.props.offerSlug} couponCode={preco.codigo} />}
</PresenteAdultoLayout>
