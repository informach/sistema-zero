---
import '../../../styles/offer-image-zoom.css'
---
<dialog class="kof-image-dialog" data-offer-image-dialog aria-labelledby="offer-image-title">
  <div class="kof-image-dialog__top">
    <span id="offer-image-title">Imagem ampliada</span>
    <button type="button" aria-label="Fechar imagem ampliada" autofocus>Fechar</button>
  </div>
  <img alt="" decoding="async" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-offer-image-dialog]')
  const image = dialog?.querySelector('img')
  if (dialog && image && typeof dialog.showModal === 'function') {
    let opener: HTMLAnchorElement | null = null
    let previousOverflow = ''
    const closeImage = () => {
      if (!dialog.open) return
      dialog.close()
      // Finish this lifecycle synchronously: the native close event can arrive
      // after another image has already been opened.
      document.documentElement.style.overflow = previousOverflow
      image.removeAttribute('src')
      const previousOpener = opener
      opener = null
      previousOpener?.focus({ preventScroll: true })
    }
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-offer-zoom]') : null
      if (!link || dialog.open) return
      event.preventDefault()
      opener = link
      image.src = link.href
      image.alt = link.querySelector('img')?.alt ?? ''
      previousOverflow = document.documentElement.style.overflow
      document.documentElement.style.overflow = 'hidden'
      dialog.showModal()
    })
    dialog.querySelector('button')?.addEventListener('click', closeImage)
    dialog.addEventListener('keydown', (event) => {
      // The close button is the only control in this image-only dialog.
      if (event.key !== 'Tab') return
      event.preventDefault()
      dialog.querySelector('button')?.focus()
    })
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault()
      closeImage()
    })
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return
      const bounds = dialog.getBoundingClientRect()
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) closeImage()
    })
  }
</script>
