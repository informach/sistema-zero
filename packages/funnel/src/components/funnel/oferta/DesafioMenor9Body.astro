---
// Página do Desafio do Primeiro Jogo para crianças menores de 9 anos, criando junto com um adulto
// (copy e visuais aprovados em 05/11/2026). Copy em
// `desafio-primeiro-jogo/oferta/pagina-menor9.ts`; veste a linguagem da página "criar junto" da
// Comunidade (receitas em kids-oferta.css, layout `.cm9` em comunidade-menor9.css) e as peças
// próprias do Desafio em desafio-menor9.css. Pagamento único, preço do catálogo pela rota.
import '../../../styles/kids-oferta.css'
import '../../../styles/comunidade-menor9.css'
import '../../../styles/desafio-menor9.css'
import { PAGINA_DESAFIO_MENOR9 as P } from '../../../funnels/desafio-primeiro-jogo/oferta/pagina-menor9'
import { precoDoDesafio, preencherPreco } from '../../../funnels/desafio-primeiro-jogo/oferta/preco'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { funnelLinkWithAttribution } from '../../../lib/lead-attribution'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPageData } from '../../../server/offer-page'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import DesafioFigura from './DesafioFigura.astro'
import DesafioIcone from './DesafioIcone.astro'
import DesafioRelato from './DesafioRelato.astro'
import OfferImage from './OfferImage.astro'
import OfferImageZoom from './OfferImageZoom.astro'
import '../../../styles/desafio-pratica.css'

type Props = OfferPageData['bodyProps']
const { f, productName, priceReais, ofertaUrl, coupon } = Astro.props
const preco = precoDoDesafio(priceReais, coupon)
const fill = (texto: string) => preencherPreco(texto, preco)
const img = (src: string) => `/img/${src}`
const link = (path: string) => funnelLinkWithAttribution(path, Astro.url)

if (!P.heroi.titulo.includes(P.heroi.enfase)) throw new Error('Ênfase fora do título do herói')
const [tituloInicio = '', tituloFim = ''] = P.heroi.titulo.split(P.heroi.enfase)

const ONDA_DESCE = 'M0 30 C 240 0 480 60 720 30 S 1200 0 1440 30 V60 H0 Z'
const ONDA_SOBE = 'M0 30 C 240 60 480 0 720 30 S 1200 60 1440 30 V60 H0 Z'
const CORES_ETAPAS = ['rosa', 'amarelo', 'menta', 'azul']
const ICONES_ETAPAS = ['setas', 'chave', 'farol', 'certificado'] as const
const CORES_SESSAO = ['rosa', 'amarelo', 'menta', 'azul']
const PAPEIS = [
  { cor: 'rosa', icone: 'livro' },
  { cor: 'azul', icone: 'pergunta' },
  { cor: 'menta', icone: 'estrela' },
] as const
const CORES_DEPOIS = ['rosa', 'amarelo', 'menta']
const CAMINHO = [
  { icone: 'farol', cor: 'amarelo' },
  { icone: 'play', cor: 'azul' },
  { icone: 'estrela', cor: 'rosa' },
] as const
---

<BaseLayout title={P.seoTitle} description={P.description} canonical={ofertaUrl} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass="theme-kids">
  <ProductJsonLd slot="head" name={productName} description={P.description} price={priceReais} url={ofertaUrl} image={img(P.capa)} />
  <link slot="head" rel="preload" as="image" href={img(P.heroi.ilustracao.src)} fetchpriority="high" />
  <div class="cm9 dm9">
    <a class="cm9-pular" href="#conteudo">{P.topo.pular}</a>
    <header class="cm9-topo">
      <div class="cm9-wrap cm9-topo__barra">
        <a class="cm9-marca" href="#topo" aria-label={P.topo.logoLabel}>
          <img src={img(P.topo.logo.src)} alt={P.topo.logo.alt} width={P.topo.logo.width} height={P.topo.logo.height} decoding="async" />
        </a>
        <nav class="cm9-topo__nav" aria-label={P.topo.navLabel}>
          {P.topo.links.map((l) => <a class="cm9-topo__link" href={l.href}>{l.label}</a>)}
          <a class="cm9-cta cm9-cta--topo" href="#oferta" data-analytics-id="desafio-m9-topo-oferta">{P.topo.cta}</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <section class="cm9-sec cm9-sec--creme" aria-labelledby="dm9-titulo" data-analytics-id="desafio-m9-hero">
        <div class="cm9-wrap cm9-heroi">
          <div class="cm9-heroi__texto">
            <span class="cm9-selo"><DesafioIcone nome="farol" tamanho={20} /><span>{P.heroi.selo}</span></span>
            <h1 id="dm9-titulo" class="cm9-h1">{tituloInicio}<span class="cm9-enfase">{P.heroi.enfase}<svg class="cm9-enfase__onda" aria-hidden="true" viewBox="0 0 300 20" preserveAspectRatio="none"><path d="M3 13 C 60 4, 120 18, 180 9 S 270 5, 297 12" stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round"></path></svg></span>{tituloFim}</h1>
            <p class="cm9-lead">{P.heroi.texto}</p>
            <ul class="cm9-beneficios">
              <li><span class="cm9-bolinha cm9-fundo--rosa" aria-hidden="true"><DesafioIcone nome="estrela" tamanho={18} /></span><span>{P.heroi.beneficios[0]}</span></li>
              <li><span class="cm9-bolinha cm9-fundo--amarelo" aria-hidden="true"><DesafioIcone nome="mensagem" tamanho={18} /></span><span>{P.heroi.beneficios[1]}</span></li>
              <li><span class="cm9-bolinha cm9-fundo--menta" aria-hidden="true"><DesafioIcone nome="check" tamanho={18} /></span><span>{P.heroi.beneficios[2]}</span></li>
            </ul>
            <div class="cm9-acao">
              <a class="cm9-cta cm9-cta--grande" href="#oferta" data-analytics-id="desafio-m9-hero-oferta">{P.cta}</a>
              <span class="cm9-nota">{fill(P.condicoes)}</span>
            </div>
          </div>
          <div class="cm9-heroi__arte">
            <div class="cm9-heroi__mancha" aria-hidden="true"></div>
            <div class="cm9-heroi__circulo cm9-heroi__circulo--azul" aria-hidden="true"></div>
            <div class="cm9-heroi__circulo cm9-heroi__circulo--menta" aria-hidden="true"></div>
            <img class="cm9-heroi__ilustra" src={img(P.heroi.ilustracao.src)} alt={P.heroi.ilustracao.alt} width={P.heroi.ilustracao.width} height={P.heroi.ilustracao.height} loading="eager" decoding="async" fetchpriority="high" />
          </div>
        </div>
        <svg class="cm9-onda cm9-onda--branco" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_DESCE} fill="currentColor"></path></svg>
      </section>

      <section class="cm9-sec cm9-sec--branco" aria-labelledby="dm9-problema" data-analytics-id="desafio-m9-jeitos">
        <div class="cm9-wrap cm9-corpo cm9-pilha">
          <div class="cm9-cabeca">
            <h2 id="dm9-problema" class="cm9-h2">{P.problema.titulo}</h2>
            <p class="cm9-texto">{P.problema.texto}</p>
          </div>
          <div class="dm9-jeitos">
            <div class="dm9-jeito">
              <OfferImage image={P.problema.so.imagem} class="dm9-ilustra" zoom={false} />
              <h3 class="dm9-jeito__titulo">{P.problema.so.titulo}</h3>
              <p>{P.problema.so.texto}</p>
            </div>
            <div class="dm9-jeito dm9-jeito--junto">
              <OfferImage image={P.problema.junto.imagem} class="dm9-ilustra" zoom={false} />
              <h3 class="dm9-jeito__titulo">{P.problema.junto.titulo}</h3>
              <p>{P.problema.junto.texto}</p>
            </div>
          </div>
          <p class="cm9-problema__destaque dm9-destaque">{P.problema.destaque}</p>
        </div>
        <svg class="cm9-onda cm9-onda--amarelo-fundo" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_SOBE} fill="currentColor"></path></svg>
      </section>

      <section class="cm9-sec cm9-sec--amarelo-fundo" aria-labelledby="dm9-jogo" data-analytics-id="desafio-m9-farol">
        <div class="cm9-wrap cm9-corpo dm9-jogo">
          <div class="dm9-jogo__texto">
            <h2 id="dm9-jogo" class="cm9-h2">{P.jogo.titulo}</h2>
<p class="cm9-texto">{P.pratica.metodologia}</p>
            <ol class="dm9-etapas">
              {P.jogo.etapas.map((e, i) => (
                <li>
                  <span class:list={['dm9-etapa__icone', `cm9-fundo--${CORES_ETAPAS[i]}`]} aria-hidden="true"><DesafioIcone nome={ICONES_ETAPAS[i]!} tamanho={30} /></span>
                  <span><strong>{e.destaque}</strong> {e.texto}</span>
                </li>
              ))}
            </ol>
          </div>
          <figure class="dm9-jogo__tela">
            <OfferImage image={P.jogo.imagem} />
            <figcaption>{P.jogo.legenda}</figcaption>
          </figure>
        </div>
        <svg class="cm9-onda cm9-onda--branco" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_DESCE} fill="currentColor"></path></svg>
      </section>

      <section id="sessao" class="cm9-sec cm9-sec--branco" aria-labelledby="dm9-sessao" data-analytics-id="desafio-m9-sessao">
        <div class="cm9-wrap cm9-corpo cm9-pilha cm9-pilha--larga">
          <h2 id="dm9-sessao" class="cm9-h2 cm9-h2--m">{P.sessao.titulo}</h2>
          <ol class="dm9-sessao">
            {P.sessao.passos.map((passo, i) => (
              <li>
                <figure class="dm9-sessao__passo">
                  <OfferImage image={passo.imagem} />
                  <figcaption><span class:list={['cm9-passo__num', `cm9-fundo--${CORES_SESSAO[i]}`]} aria-hidden="true">{i + 1}</span><strong>{passo.texto}</strong></figcaption>
                </figure>
              </li>
            ))}
          </ol>
          <p class="dm9-nota">{P.sessao.nota}</p>
        <div class="dc-two-columns dc-sharing"><div class="dc-prose"><h3 class="cm9-h3">{P.pratica.compartilhar.titulo}</h3><p class="cm9-texto">{P.pratica.compartilhar.texto}</p></div><DesafioRelato id="AV02" /></div>
</div>
        <svg class="cm9-onda cm9-onda--menta" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_SOBE} fill="currentColor"></path></svg>
      </section>

      <section id="papel" class="cm9-sec cm9-sec--menta" aria-labelledby="dm9-papel" data-analytics-id="desafio-m9-papel">
        <div class="cm9-wrap cm9-corpo cm9-pilha cm9-pilha--larga">
          <div class="cm9-cabeca cm9-cabeca--larga">
            <h2 id="dm9-papel" class="cm9-h2 cm9-h2--m">{P.papel.titulo}</h2>
            <p class="cm9-texto cm9-texto--forte">{P.papel.texto}</p>
          </div>
          <ul class="cm9-grade cm9-grade--papeis">
            {P.papel.cartas.map((carta, i) => (
              <li class:list={['cm9-papel', `cm9-papel--${PAPEIS[i]!.cor}`]}>
                <span class="cm9-papel__icone" aria-hidden="true"><DesafioIcone nome={PAPEIS[i]!.icone} tamanho={44} /></span>
                <h3 class="cm9-papel__titulo">{carta.titulo}</h3>
                <p class="cm9-papel__texto">{carta.texto}</p>
              </li>
            ))}
          </ul>
        <div class="dc-parent-benefit"><div class="dc-prose"><h3 class="cm9-h3">{P.pratica.paisTitulo}</h3>{P.pratica.areaDosPais.map((paragrafo) => <p class="cm9-texto">{paragrafo}</p>)}<DesafioFigura image={P.pratica.paisImagem} legenda={P.pratica.paisLegenda} /></div></div>
</div>
        <svg class="cm9-onda cm9-onda--branco" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_DESCE} fill="currentColor"></path></svg>
      </section>

      <section id="habilidades" class="cm9-sec cm9-sec--branco" aria-labelledby="dm9-treina" data-analytics-id="desafio-m9-treina">
        <div class="cm9-wrap cm9-corpo cm9-pilha cm9-pilha--larga">
          <h2 id="dm9-treina" class="cm9-h2 cm9-h2--m">{P.treina.titulo}</h2>
          <ul class="dm9-habilidades">
            {P.treina.habilidades.map((h) => (
              <li class="dm9-habilidade dc-skill">
                <DesafioFigura image={h.imagem} legenda={h.legenda} ampliar={h.ampliar} />
                <h3 class="dm9-habilidade__titulo">{h.titulo}</h3>
                <p class="dm9-habilidade__texto">{h.texto}</p>
              </li>
            ))}
          </ul>
          <div class="dm9-faixa">
            <strong>{P.treina.faixa.titulo}</strong>
            <span>{P.treina.faixa.texto}</span>
          </div>
        <div class="dc-math"><h3 class="cm9-h3">{P.pratica.matematica.titulo}</h3><p class="cm9-texto">{P.pratica.matematica.texto}</p><div class="dc-pair">{P.pratica.matematica.imagens.map((figura) => <DesafioFigura image={figura.imagem} legenda={figura.legenda} />)}</div>{P.pratica.matematica.nota && <p class="cm9-texto">{P.pratica.matematica.nota}</p>}</div>
</div>
        <svg class="cm9-onda cm9-onda--rosa" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_SOBE} fill="currentColor"></path></svg>
      </section>

      <section class="cm9-sec cm9-sec--rosa" aria-labelledby="dm9-fundadores" data-analytics-id="desafio-m9-prova"><div class="cm9-wrap cm9-corpo cm9-pilha cm9-pilha--larga"><h2 id="dm9-fundadores" class="cm9-h2 cm9-h2--m">{P.pratica.familiaTitulo}</h2><div class="dc-two-columns dc-family"><div class="dc-prose"><figure class="dc-family-photo"><img src={img(P.pratica.familiaImagem.src)} alt={P.pratica.familiaImagem.alt} width={P.pratica.familiaImagem.width} height={P.pratica.familiaImagem.height} loading="lazy" decoding="async" /></figure>{P.pratica.familia.map((paragrafo) => <p class="cm9-texto">{paragrafo}</p>)}</div><div class="dc-family-quotes"><DesafioRelato id="AV04" /><DesafioRelato id="AV03" /></div></div></div><svg class="cm9-onda cm9-onda--creme" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_DESCE} fill="currentColor"></path></svg></section>

      <section id="para-comecar" class="cm9-sec cm9-sec--creme" aria-labelledby="desafio-preparo" data-analytics-id="desafio-m9-preparo"><div class="cm9-wrap cm9-corpo cm9-pilha cm9-pilha--larga"><h2 id="desafio-preparo" class="cm9-h2 cm9-h2--m">{P.pratica.preparoTitulo}</h2><div class="dc-two-columns dc-practical"><div class="dc-prose">{P.pratica.paraComecar.map((paragrafo) => <p class="cm9-texto">{paragrafo}</p>)}</div><DesafioFigura image={P.pratica.caderno} legenda={P.pratica.cadernoLegenda} class="dc-caderno" /></div></div><svg class="cm9-onda cm9-onda--laranja" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_DESCE} fill="currentColor"></path></svg></section>

<section id="oferta" class="cm9-sec cm9-sec--laranja" aria-labelledby="dm9-oferta" data-analytics-id="desafio-m9-oferta">
        <div class="cm9-wrap cm9-corpo cm9-corpo--planos cm9-pilha">
          <div class="cm9-cabeca">
            <h2 id="dm9-oferta" class="cm9-h2 cm9-h2--planos">{P.oferta.titulo}</h2>
            {preco.aviso && <p class:list={['cm9-cupom', { 'cm9-cupom--alerta': preco.aviso.alerta }]} role={preco.aviso.alerta ? 'alert' : undefined}>{preco.aviso.texto}</p>}
          </div>
          <div class="cm9-planos">
            <article class="cm9-plano dm9-plano" aria-labelledby="dm9-plano-nome">
              <h3 id="dm9-plano-nome" class="cm9-plano__nome">{P.oferta.selo}</h3>
              <p class="cm9-plano__preco">{preco.precoCheio && <s class="dm9-cheio">{preco.precoCheio}</s>}{preco.preco}<span> {P.oferta.sufixo}</span></p>
              <p class="cm9-plano__texto">{fill(P.oferta.porDia)}</p>
              <ul class="dm9-inclui" aria-label={P.oferta.incluiLabel}>
                {P.oferta.inclui.map((item) => <li><DesafioIcone nome="check" tamanho={20} /><span>{item}</span></li>)}
              </ul>
              <button type="button" class="cm9-plano__botao dm9-plano__botao" data-checkout-cta data-analytics-id="desafio-m9-oferta-comprar">{P.cta}</button>
              <p class="dm9-plano__garantia"><DesafioIcone nome="escudo" tamanho={22} /><span>{P.oferta.garantia}</span></p>
            </article>
            <div class="cm9-depois dm9-depois">
              <div class="cm9-depois__passos">
                <h3 class="cm9-depois__titulo">{P.oferta.depoisTitulo}</h3>
                <ol>
                  {P.oferta.depois.map((passo, i) => (
                    <li><span class={`cm9-depois__num cm9-fundo--${CORES_DEPOIS[i]}`} aria-hidden="true">{i + 1}</span><span>{passo}</span></li>
                  ))}
                </ol>
              </div>
            </div>
          </div>
        </div>
        <svg class="cm9-onda cm9-onda--branco" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_SOBE} fill="currentColor"></path></svg>
      </section>

      <section class="cm9-sec cm9-sec--branco" aria-labelledby="dm9-caminho" data-analytics-id="desafio-m9-continuidade">
        <div class="cm9-wrap cm9-corpo cm9-pilha">
          <h2 id="dm9-caminho" class="cm9-h2 cm9-h2--m">{P.continuidade.titulo}</h2>
          <ol class="dm9-caminho">
            {P.continuidade.passos.map((passo, i) => (
              <li class="dm9-caminho__passo">
                <span class:list={['dm9-caminho__icone', `cm9-fundo--${CAMINHO[i]!.cor}`]} aria-hidden="true"><DesafioIcone nome={CAMINHO[i]!.icone} tamanho={40} /></span>
                <strong>{passo.titulo}</strong>
                <span>{passo.texto}</span>
              </li>
            ))}
          </ol>
          <p class="cm9-texto">{P.continuidade.texto} <a class="dm9-link" href={link('/kids/comunidade-dos-criadores/oferta/criar-junto')} data-analytics-id="desafio-m9-comunidade">{P.continuidade.link}</a></p>
        </div>
        <svg class="cm9-onda cm9-onda--creme" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d={ONDA_DESCE} fill="currentColor"></path></svg>
      </section>

      <section id="duvidas" class="cm9-sec cm9-sec--creme" aria-labelledby="dm9-duvidas" data-analytics-id="desafio-m9-duvidas">
        <div class="cm9-wrap cm9-wrap--estreita cm9-corpo cm9-corpo--planos cm9-duvidas">
          <h2 id="dm9-duvidas" class="cm9-h2 cm9-h2--p">{P.duvidas.titulo}</h2>
          {P.duvidas.itens.map((d) => (
            <details class="cm9-duvida">
              <summary>{d.pergunta}</summary>
              <p>{fill(d.resposta)}{'link' in d && <> <a href={link(d.link.href)}>{d.link.texto}</a></>}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="cm9-sec cm9-sec--azul" aria-labelledby="dm9-fim" data-analytics-id="desafio-m9-convite">
        <div class="cm9-wrap cm9-wrap--media cm9-fim">
          <div class="cm9-fim__texto">
            <h2 id="dm9-fim" class="cm9-h2 cm9-h2--fim">{P.fechamento.titulo}</h2>
            <p class="cm9-nota">{fill(P.fechamento.texto)}</p>
            <button type="button" class="cm9-cta cm9-cta--grande" data-checkout-cta data-analytics-id="desafio-m9-convite-comprar">{P.fechamento.cta}</button>
          </div>
          <img class="cm9-fim__zappy" src={img(P.fechamento.zappy.src)} alt={P.fechamento.zappy.alt} width={P.fechamento.zappy.width} height={P.fechamento.zappy.height} loading="lazy" decoding="async" />
        </div>
      </section>
    </main>

    <div class="kof-mobar cm9-barra" data-mobar aria-hidden="true">
      <p class="kof-mobar__preco"><strong>{preco.preco}</strong> {P.barra.sufixo}</p>
      <a class="cm9-cta cm9-cta--barra" href="#oferta" tabindex="-1">{P.barra.cta}</a>
    </div>
  </div>
  <Footer audience={f.audience} vitalicio={f.lifetimeAccess} termosHref={`${f.basePath}/termos`} />
  <PreCheckoutModal client:idle basePath={f.basePath} funnel={f.key} couponCode={preco.codigo} />
  <OfferImageZoom />
</BaseLayout>

<script>
  // A barra fixa do celular, a mesma das outras páginas Kids: aparece depois da dobra e some quando a
  // oferta ou o rodapé entram na tela. Sem JS ela nasce escondida e `aria-hidden`.
  const barra = document.querySelector<HTMLElement>('[data-mobar]')
  const oferta = document.getElementById('oferta')
  const rodape = document.querySelector('footer')
  if (barra && oferta && 'IntersectionObserver' in window) {
    const link = barra.querySelector('a')
    let ofertaAVista = false
    let rodapeAVista = false
    let roladoAlemDaDobra = false
    let ultimo: boolean | null = null
    const aplicar = () => {
      const mostra = roladoAlemDaDobra && !ofertaAVista && !rodapeAVista
      if (mostra === ultimo) return
      ultimo = mostra
      barra.classList.toggle('is-visible', mostra)
      barra.setAttribute('aria-hidden', mostra ? 'false' : 'true')
      link?.setAttribute('tabindex', mostra ? '0' : '-1')
    }
    new IntersectionObserver(
      ([e]) => {
        ofertaAVista = Boolean(e?.isIntersecting)
        aplicar()
      },
      { rootMargin: '0px 0px -40% 0px' },
    ).observe(oferta)
    if (rodape)
      new IntersectionObserver(([e]) => {
        rodapeAVista = Boolean(e?.isIntersecting)
        aplicar()
      }).observe(rodape)
    const aoRolar = () => {
      roladoAlemDaDobra = window.scrollY > window.innerHeight * 0.9
      aplicar()
    }
    window.addEventListener('scroll', aoRolar, { passive: true })
    aoRolar()
  }
</script>
