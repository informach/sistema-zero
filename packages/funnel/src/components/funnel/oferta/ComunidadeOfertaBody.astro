<script>
  // Scroll reveal (mesmo padrão do DesafioOfertaBody).
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('visible')
          obs.unobserve(e.target)
        }
      }
    },
    { threshold: 0.14 },
  )
  for (const el of Array.from(document.querySelectorAll('.cdc .reveal'))) obs.observe(el)

  // Barra fixa mobile: aparece após a 1ª dobra, some perto dos planos.
  // ⚠️ `#planos` vive DENTRO de uma section `position: relative` → `offsetTop`
  // seria o offset LOCAL (pequeno, errado); mede a posição no DOCUMENTO via rect.
  const mobar = document.querySelector('.cdc .mobar')
  const planos = document.getElementById('planos')
  if (mobar) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY
      const showAfter = window.innerHeight * 0.9
      const hideNear = planos
        ? planos.getBoundingClientRect().top + y - window.innerHeight
        : Number.POSITIVE_INFINITY
      mobar.classList.toggle('visible', y > showAfter && y < hideNear)
    })
  }
</script>

