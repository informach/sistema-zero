    }
  }

  /* ===== hero ===== */
  .cdc .hero {
    background: linear-gradient(180deg, var(--ceu) 0%, var(--creme) 100%);
    padding-top: 54px;
  }
  .cdc .hero .grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 36px;
    align-items: center;
  }
  .cdc .hero h1 {
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .cdc .hero .lead {
    font-size: clamp(1.02rem, 2vw, 1.16rem);
    color: var(--tinta-suave);
    font-weight: 600;
    max-width: 560px;
    margin-bottom: 20px;
  }
  .cdc .hero-bullets {
    list-style: none;
    display: grid;
    gap: 12px;
    margin: 0 0 26px;
    padding: 0;
  }
  .cdc .hero-bullets li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-weight: 700;
  }
  .cdc .hero-bullets .tick {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--verde);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(55, 200, 113, 0.35);
    margin-top: 2px;
  }
  .cdc .hero-bullets .tick .material-symbols-rounded {
    font-size: 18px;
  }
  .cdc .seals {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 32px;
    font-weight: 700;
    color: var(--tinta-suave);
    font-size: 0.95rem;
  }
  .cdc .seals span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .cdc .seals .material-symbols-rounded {
    color: var(--verde);
    font-size: 20px;
  }
  .cdc .hero-art {
    position: relative;
  }
  .cdc .hero-art .glow {
    position: absolute;
    inset: 8% 6%;
    background: radial-gradient(circle, rgba(255, 206, 58, 0.5), transparent 65%);
    filter: blur(30px);
  }
  .cdc .hero-art img {
    position: relative;
    filter: drop-shadow(0 22px 30px rgba(28, 48, 90, 0.18));
  }
  /* Ilustrações são RECORTES (webp transparente, chroma cortado): integram no
     fundo da página com drop-shadow, como o hero e os balões de fala — NUNCA
     border-radius/box-shadow (viravam um "cartão com relevo" em volta do PNG
     transparente; feedback da usuária 13/07). Print/screenshot é a exceção e
     tem moldura própria (.shot). */
  .cdc .art img {
    border-radius: 0;
  }
  .cdc .deco {
    position: absolute;
    pointer-events: none;
  }
  .cdc .float {
    animation: cdc-float 5s ease-in-out infinite;
  }
  .cdc .float.slow {
    animation-duration: 7s;
  }
  .cdc .float.rev {
    animation-direction: reverse;
  }
  @keyframes cdc-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cdc .float {
      animation: none;
    }
  }
  .cdc .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.6;
    pointer-events: none;
  }

  /* ===== balões dos personagens (mesmo padrão do Desafio) ===== */
  .cdc .kid {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    max-width: 720px;
    margin: 46px auto 0;
    text-align: left;
  }
  .cdc .kid .char {
    flex-shrink: 0;
    width: 120px;
    text-align: center;
  }
  .cdc .kid .char img {
    border-radius: 0;
    filter: drop-shadow(0 10px 16px rgba(28, 48, 90, 0.2));
  }
  .cdc .kid .char .name {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--head);
    font-weight: 700;
    font-size: 0.88rem;
    color: #fff;
    background: var(--azul);
    padding: 3px 12px;
    border-radius: 12px;
  }
  .cdc .kid.verde .char .name {
    background: var(--verde);
  }
  .cdc .kid.rosa .char .name {
    background: var(--rosa);
  }
  .cdc .kid .bubble {
    position: relative;
    background: #fff;
    border: 2px solid #cfe6ff;
    border-radius: 22px;
    padding: 18px 22px;
    font-weight: 600;
    box-shadow: var(--sombra-sm);
    margin-bottom: 26px;
  }
  .cdc .kid .bubble::before {
    content: '';
    position: absolute;
    left: -12px;
    bottom: 24px;
    width: 22px;
    height: 22px;
    background: #fff;
    border-left: 2px solid #cfe6ff;
    border-bottom: 2px solid #cfe6ff;
    transform: rotate(45deg);
    border-radius: 0 0 0 6px;
  }
  @media (max-width: 560px) {
    .cdc .kid {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .cdc .kid .bubble::before {
      display: none;
    }
  }

  /* ===== faixa de confiança ===== */
  .cdc .stats-band {
    background: var(--navy);
    color: #fff;
    padding: 22px 0;
  }
  .cdc .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .cdc .stat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: left;
  }
  .cdc .stat .material-symbols-rounded {
    font-size: 30px;
    color: var(--amarelo);
    flex-shrink: 0;
  }
  .cdc .stat .l {
    font-weight: 700;
    font-size: 0.94rem;
    line-height: 1.35;
    opacity: 0.94;
  }
  @media (max-width: 720px) {
    .cdc .stats {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .cdc .stat {
      justify-content: flex-start;
    }
  }

  /* ===== seções de feature (imagem + texto) ===== */
  .cdc .feat {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 40px;
    align-items: center;
    max-width: 1000px;
    margin: 34px auto 0;
  }
  .cdc .feat-rev {
    grid-template-columns: 1.1fr 1fr;
  }
  .cdc .feat-rev > :first-child {
    order: 2;
  }
  .cdc .feat .art img {
    filter: drop-shadow(0 18px 28px rgba(28, 48, 90, 0.18));
  }
  .cdc .feat-txt {
    display: grid;
    gap: 14px;
    font-size: 1.04rem;
    color: var(--tinta-suave);
    font-weight: 600;
  }
  .cdc .feat-txt strong {
    color: var(--tinta);
  }
  @media (max-width: 860px) {
    .cdc .feat,
    .cdc .feat-rev {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .cdc .feat-rev > :first-child {
      order: 0;
    }
  }

  /* ===== paliativos ===== */
  .cdc .pal {
    display: grid;
    gap: 16px;
    max-width: 840px;
    margin: 34px auto 0;
  }
  .cdc .pal-item {
    background: #fff;
    border-radius: 20px;
    padding: 22px 24px;
    box-shadow: var(--sombra-sm);
    border: 1px solid var(--borda);
    display: flex;
    gap: 16px;
  }
  .cdc .pal-item .xi {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: #fdeaea;
    color: #e05353;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cdc .pal-item h4 {
    font-size: 1.1rem;
    margin-bottom: 5px;
  }
  .cdc .pal-item p {
    color: var(--tinta-suave);
    font-weight: 600;
  }

  /* ===== depoimentos ===== */
  .cdc .depo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1050px;
    margin: 34px auto 0;
    text-align: left;
  }
  .cdc .depo {
    background: #fff;
    border-radius: 22px;
    padding: 24px;
    box-shadow: var(--sombra);
    border: 1px solid var(--borda);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cdc .depo .stars {
    color: var(--amarelo);
    letter-spacing: 3px;
    font-size: 1.05rem;
  }
  .cdc .depo .quote {
    font-weight: 700;
    color: var(--tinta);
    flex: 1;
  }
  .cdc .depo .who {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cdc .depo .av {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: var(--sombra-sm);
  }
  .cdc .depo .av img {
    border-radius: 50%;
  }
  .cdc .depo .who-name {
    font-family: var(--head);
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.2;
  }
  .cdc .depo .who-name small {
    display: block;
    font-family: var(--body);
    font-weight: 600;
    color: var(--tinta-suave);
    font-size: 0.8rem;
  }
  @media (max-width: 860px) {
    .cdc .depo-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== banda CTA ===== */
  .cdc .ctaband {
    background: linear-gradient(135deg, var(--azul), var(--roxo));
    border-radius: 30px;
    padding: 42px 32px;
    text-align: center;
    color: #fff;
    box-shadow: var(--sombra);
  }
  .cdc .ctaband h3 {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    margin-bottom: 26px;
    color: #fff;
  }

  /* ===== método Z.E.R.O. ===== */
  .cdc .zero {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    max-width: 1050px;
    margin: 34px auto 0;
  }
  .cdc .zstep {
    background: #fff;
    border-radius: 22px;
    padding: 24px 20px;
    box-shadow: var(--sombra);
    border-top: 6px solid var(--c);
  }
  .cdc .zstep .zl {
    font-family: var(--head);
    font-weight: 800;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--c);
  }
  .cdc .zstep h4 {
    font-size: 1.08rem;
    margin: 6px 0 8px;
  }
  .cdc .zstep p {
    font-size: 0.94rem;
    color: var(--tinta-suave);
    font-weight: 600;
  }
  .cdc .z1 {
    --c: var(--rosa);
  }
  .cdc .z2 {
    --c: var(--azul);
  }
  .cdc .z3 {
    --c: var(--laranja);
  }
  .cdc .z4 {
    --c: var(--verde);
  }
  .cdc .zloop {
    text-align: center;
    font-family: var(--head);
    font-weight: 700;
    color: var(--roxo);
    margin-top: 20px;
  }
  .cdc .career {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    max-width: 900px;
    margin: 22px auto 0;
  }
  .cdc .lvl-pill {
    background: #fff;
    border-radius: 50px;
    padding: 10px 20px;
    font-family: var(--head);
    font-weight: 700;
    box-shadow: var(--sombra-sm);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 2px solid var(--c);
    color: var(--c);
  }
  .cdc .lvl-pill .material-symbols-rounded {
    font-size: 20px;
  }
  @media (max-width: 860px) {
    .cdc .zero {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .cdc .zero {
      grid-template-columns: 1fr;
    }
  }

  /* ===== decorados (o que desenvolve) ===== */
  .cdc .dev {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1050px;
    margin: 34px auto 0;
  }
  .cdc .dev-item {
    background: #fff;
    border-radius: 22px;
    padding: 24px 22px;
    box-shadow: var(--sombra-sm);
    border: 1px solid var(--borda);
  }
  .cdc .dev-item .di {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin-bottom: 14px;
  }
  .cdc .dev-item .di .material-symbols-rounded {
    font-size: 26px;
  }
  .cdc .dev-item h4 {
    font-size: 1.1rem;
    margin-bottom: 6px;
  }
  .cdc .dev-item p {
    font-size: 0.96rem;
    color: var(--tinta-suave);
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .cdc .dev {
      grid-template-columns: 1fr;
    }
  }

  /* ===== cards genéricos (plataforma / entregáveis / bônus) ===== */
  .cdc .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 1050px;
    margin: 34px auto 0;
    text-align: left;
  }
  .cdc .card {
    background: #fff;
    border-radius: 24px;
    padding: 24px;
    box-shadow: var(--sombra);
    border: 1px solid var(--borda);
    position: relative;
  }
  .cdc .card h3 {
    font-size: 1.14rem;
    margin-bottom: 8px;
  }
  .cdc .card p {
    font-size: 0.98rem;
    color: var(--tinta-suave);
    font-weight: 600;
  }
  .cdc .card .ci {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin-bottom: 14px;
  }
  .cdc .card .ci .material-symbols-rounded {
    font-size: 28px;
  }
  .cdc .card.destaque {
    background: linear-gradient(160deg, #eafbe4, #d5ecff);
  }
  .cdc .card .shot {
    margin: 0 0 14px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    /* Print INTEIRO (nada de corte — senão não dá pra ler): a imagem é contida e
       o vão é preenchido com o azul-céu claro da própria plataforma (#F0F9FF, a
       cor de fundo dos prints), compondo sem emenda. Altura fixa p/ o grid alinhar. */
    height: 200px;
    background: #f0f9ff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--borda);
  }
  .cdc .card .shot img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0;
  }
  /* Screenshot emoldurado no bloco de feature (Recados no Suporte): moldura branca
     arredondada + borda fina, imagem inteira (sem corte), sombra do card. */
  .cdc .shot-feat {
    background: #fff;
    border-radius: 18px;
    padding: 8px;
    border: 1px solid var(--borda);
    box-shadow: var(--sombra);
  }
  .cdc .shot-feat img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
  }
  .cdc .shot-slot {
    border-radius: 16px;
    min-height: 150px;
    background: repeating-linear-gradient(45deg, #eef3fb, #eef3fb 12px, #e6edf8 12px, #e6edf8 24px);
    border: 2px dashed #b9c6e0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 18px;
    color: #5b6f96;
    margin-bottom: 14px;
  }
  .cdc .shot-slot .material-symbols-rounded {
    font-size: 38px;
    margin-bottom: 6px;
  }
  .cdc .shot-slot .slot-t {
    font-family: var(--head);
    font-weight: 700;
    font-size: 0.98rem;
  }
  .cdc .shot-slot .slot-d {
    font-size: 0.84rem;
    margin-top: 4px;
    max-width: 300px;
    line-height: 1.4;
  }
  .cdc .shot-slot.tall {
    min-height: 320px;
    margin-bottom: 0;
  }
  .cdc .card.bonus {
    padding-top: 34px;
  }
  .cdc .bonus-tag {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--amarelo);
    color: #6b4d00;
    font-family: var(--head);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 4px 14px;
    border-radius: 40px;
    box-shadow: var(--sombra-sm);
  }
  .cdc .anchor-note {
    margin-top: 10px;
    font-weight: 700;
    color: var(--tinta);
  }
  .cdc .anchor-note s {
    color: var(--tinta-suave);
  }
  @media (max-width: 860px) {
    .cdc .cards {
      grid-template-columns: 1fr;
    }
  }

  /* ===== para quem é / não é ===== */
  .cdc .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 1000px;
    margin: 34px auto 0;
    text-align: left;
  }
  .cdc .two-box {
    background: #fff;
    border-radius: 24px;
    padding: 26px;
    box-shadow: var(--sombra);
  }
  .cdc .two-box.is {
    border-top: 6px solid var(--verde);
  }
  .cdc .two-box.isnt {
    border-top: 6px solid #e05353;
  }
  .cdc .two-box h3 {
    font-size: 1.16rem;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cdc .two-box ul {
    list-style: none;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .cdc .two-box li {
    display: flex;
    gap: 11px;
    font-weight: 600;
  }
  .cdc .two-box .mk {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin-top: 2px;
  }
  .cdc .two-box .mk .material-symbols-rounded {
    font-size: 16px;
  }
  .cdc .is .mk {
    background: var(--verde);
  }
  .cdc .isnt .mk {
    background: #e05353;
  }
  @media (max-width: 860px) {
    .cdc .two {
      grid-template-columns: 1fr;
    }
  }

  /* ===== comparativo de valor ===== */
  .cdc .compare {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 900px;
    margin: 34px auto 0;
  }
  .cdc .cmp {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    box-shadow: var(--sombra-sm);
    border: 1px solid var(--borda);
    text-align: center;
  }
  .cdc .cmp-t {
    font-weight: 700;
    color: var(--tinta-suave);
    font-size: 0.95rem;
    margin-bottom: 6px;
  }
  .cdc .cmp-v {
    font-family: var(--head);
    font-weight: 800;
    font-size: 1.22rem;
  }
  .cdc .cmp-u {
    font-size: 0.82rem;
    color: var(--tinta-suave);
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .cdc .compare {
      grid-template-columns: 1fr;
    }
  }

  /* ===== planos (mensal × anual) ===== */
  .cdc .plans {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 22px;
    max-width: 820px;
    margin: 40px auto 0;
    align-items: stretch;
    scroll-margin-top: 90px;
  }
  .cdc .plan {
    background: #fff;
    border-radius: var(--raio);
    padding: 30px 26px;
    box-shadow: var(--sombra);
    border: 2px solid var(--borda);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
  }
  .cdc .plan.destaque {
    border-color: var(--laranja);
    background: linear-gradient(170deg, #fff, #fff6e6);
  }
  .cdc .plan h4 {
    font-size: 1.2rem;
    color: var(--tinta-suave);
  }
  .cdc .plan.destaque h4 {
    color: var(--laranja);
  }
  .cdc .plan .from {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    font-weight: 600;
  }
  .cdc .plan .now {
    font-family: var(--head);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--navy);
  }
  .cdc .plan .now small {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--tinta-suave);
  }
  .cdc .plan.destaque .now {
    color: var(--laranja);
  }
  .cdc .plan .permonth {
    font-family: var(--head);
    font-weight: 700;
    color: var(--azul);
  }
  .cdc .plan .cond {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    font-weight: 600;
    flex: 1;
  }
  .cdc .plan .plan-btn {
    width: 100%;
    margin-top: 8px;
    font-size: 1.05rem;
    padding: 16px 18px;
    /* respiro pra sombra 3D dentro do card */
    margin-bottom: 10px;
  }
  .cdc .plan-badge {
    position: absolute;
    top: -14px;
