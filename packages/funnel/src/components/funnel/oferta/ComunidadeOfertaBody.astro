    <img src={img('tela-meu-espaco.webp')} srcset={tela2x('tela-meu-espaco.webp')} alt="Tela do Meu perfil, com o avatar da criança, o posto na Jornada e a escada de postos" width="1280" height="800" loading="lazy" decoding="async" />
