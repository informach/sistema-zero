---
// Quatro perfis e continuidade: docs/marketing/kids/comunidade-dos-criadores/copy/.
// As receitas visuais ficam em kids-oferta.css; o layout (`.cdc`), em comunidade-oferta.css.
import '../../../styles/kids-oferta.css'
import '../../../styles/comunidade-oferta.css'
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import { COMUNIDADE_PAGES } from '../../../funnels/comunidade-dos-criadores/oferta'
import {
  ENFASE_NUMA_LINHA,
  ICONES_DE_DUVIDAS,
} from '../../../funnels/comunidade-dos-criadores/oferta/arte'
import { DESTAQUES } from '../../../funnels/comunidade-dos-criadores/oferta/destaques'
import { FAQ, SHARED_COPY } from '../../../funnels/comunidade-dos-criadores/oferta/shared'
import type {
  ComunidadeFaqEntry,
  ComunidadeOffer,
  ComunidadePageId,
} from '../../../funnels/comunidade-dos-criadores/oferta/types'
import {
  FAQ_VISUALS,
  TOUR,
  visualDe,
} from '../../../funnels/comunidade-dos-criadores/oferta/visuals'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { formatBRLFromCents, formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import ComunidadeProsa from './ComunidadeProsa.astro'
import ComunidadeSection from './ComunidadeSection.astro'
import ComunidadeVisual from './ComunidadeVisual.astro'

interface Props {
  f: FunnelDef
  productName: string
  priceLabel: string
  priceLabelShort: string
  priceReais: string
  imagesBase: string
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  plans: OfferPlans | null
  profile?: ComunidadePageId
}
const { f, productName, imagesBase, ofertaUrl, plans, profile = 'tempo-de-tela' } = Astro.props
const page = COMUNIDADE_PAGES[profile]
const img = (file: string) => `${imagesBase}/${file}`
const heroVisual = visualDe(page.heroVisual)
const heroFrame = heroVisual?.frames[0]
if (!heroVisual || !heroFrame) throw new Error(`Herói sem tela real: ${page.heroVisual}`)
const heroSrc = img(heroFrame.file)
const heroSrcset = `${heroSrc} 1x, ${img(heroFrame.retina)} 2x`
const [titleStart, titleEnd] = page.hero.title.split(page.emphasis)
const enfaseEm = ENFASE_NUMA_LINHA[page.id]
// Jornada do Criador: incluído não significa liberado no primeiro acesso.
// A resolução por intervalo conserva qual oferta é a principal e qual é a irmã.
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
const mensalLabel = formatBRLFromCents(mensalCents)
const anualLabel = formatBRLFromCents(anualCents)
const anualPorMesLabel = formatBRLFromCents2(Math.round(anualCents / 12))
const priceReais = ((plans?.main.priceCents ?? mensalCents) / 100).toFixed(2)
const offer: ComunidadeOffer = page.offer ?? SHARED_COPY.offer
const faq: Record<string, ComunidadeFaqEntry> = page.faq ?? FAQ
const fillPrice = (text: string) =>
  text
    .replaceAll('{{preco_mensal}}', mensalLabel)
    .replaceAll('{{preco_anual}}', anualLabel)
    .replaceAll('{{equivalente_mensal_anual}}', anualPorMesLabel)
const benefitIcons = ['extension', 'brush', 'group']
const benefitColors = ['', 'kof-ladrilho--rosa', 'kof-ladrilho--verde']
const founder = SHARED_COPY.founder.groups.flatMap((group) => group.paragraphs)
const closing = page.closing.groups.flatMap((group) => group.paragraphs)
const faqIcons = ICONES_DE_DUVIDAS[page.id] ?? [
  'schedule',
  'school',
  'build',
  'devices',
  'diversity_3',
  'receipt_long',
]
const faqColors = ['', 'rosa', 'verde', 'roxo', 'laranja', 'amarelo']
const faqVisuals = (id: string) =>
  ((page.faqVisuals ?? FAQ_VISUALS)[id] ?? []).filter((visual) => visualDe(visual))
---

<BaseLayout title={page.seoTitle} description={page.description} canonical={ofertaUrl} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass="theme-kids">
  <ProductJsonLd slot="head" name={productName} description={page.description} price={priceReais} url={ofertaUrl} image={img('checkout-capa.webp')} />
  <link slot="head" rel="preload" as="image" href={heroSrc} imagesrcset={heroSrcset} fetchpriority="high" />
  <div class="cdc" data-comunidade-profile={profile}>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <header class="topbar">
      <div class="wrap nav">
        <a class="brand" href="#conteudo" aria-label="Comunidade dos Criadores, início">
          <img class="logo" src={img('logo-kids-escuro.svg')} alt="Sistema Zero Kids" width="279" height="26" decoding="async" />
        </a>
        <nav class="nav-links" aria-label="Partes da página">
          <a href="#experiencia">Experiência</a>
          <a href="#planos">Planos</a>
          <a href="#duvidas">Dúvidas</a>
        </nav>
        <div class="nav-right">
          <p class="nav-preco">No plano anual, equivalente a<strong>{anualPorMesLabel} por mês</strong></p>
          <a class="kof-btn kof-btn--compacta" href="#planos">Escolher um plano</a>
        </div>
      </div>
    </header>
    <main id="conteudo">
      <section class="hero section" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">stadia_controller</span>Comunidade dos Criadores · 9 a 14 anos</span>
            <h1 id="hero-title" class:list={['kof-display', { 'enfase-junta': enfaseEm }]} style={enfaseEm ? `--enfase-em: ${enfaseEm}` : undefined}>{titleStart}<em>{page.emphasis}</em>{titleEnd}</h1>
            <p class="kof-lead">{page.hero.description}</p>
            <ul class="hero-benefits">
              {page.hero.benefits.map((benefit, index) => (
                <li><span class:list={['kof-ladrilho', benefitColors[index]]} aria-hidden="true"><span class="material-symbols-rounded">{benefitIcons[index]}</span></span><span>{benefit}</span></li>
              ))}
            </ul>
            <div class="hero-actions">
              <a class="kof-btn kof-btn--grande" href={page.hero.primary.href}>{page.hero.primary.label}</a>
              <a class="kof-link" href={page.hero.secondary.href}>{page.hero.secondary.label}<span class="material-symbols-rounded" aria-hidden="true">arrow_downward</span></a>
            </div>
            <div class="requirements"><span class="kof-selo"><span class="material-symbols-rounded" aria-hidden="true">check_circle</span>{page.hero.requirements}</span></div>
          </div>
          <div class="hero-visual">
            <div class="hero-stage kof-marca">
              <span class="kof-decor decor-1" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
              <span class="kof-decor kof-decor--rosa decor-2" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
              <span class="kof-decor decor-3" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
              <img class="zappy" src={img('zappy-happy.webp')} alt="" width="300" height="300" loading="eager" decoding="async" />
              <figure class="hero-figura" data-visual={page.heroVisual}>
                <a class="quadro-link" href={img(heroFrame.retina)} target="_blank" rel="noopener" data-zoom aria-label={`Ampliar a imagem: ${heroFrame.alt}`}>
                  <div class="kof-tela kof-tela--sombra">
                    <div class="kof-tela__barra" aria-hidden="true">
                      <i></i><i></i><i></i>
                      <span class="kof-tela__url">{heroFrame.label}</span>
                      <span class="material-symbols-rounded quadro-lupa">zoom_in</span>
                    </div>
                    <img src={heroSrc} srcset={heroSrcset} alt={heroFrame.alt} width={heroFrame.width} height={heroFrame.height} loading="eager" decoding="async" fetchpriority="high" />
                  </div>
                </a>
                <figcaption>{heroVisual.caption}</figcaption>
              </figure>
              <span class="kof-chip kof-chip--verde flutua flutua--1"><span class="material-symbols-rounded" aria-hidden="true">rocket_launch</span>{page.heroChip}</span>
              <span class="kof-chip flutua flutua--2"><span class="material-symbols-rounded" aria-hidden="true">group</span>Até dois perfis</span>
              <img class="dede" src={img('dede-fala.webp')} alt="" width="360" height="869" loading="eager" decoding="async" />
            </div>
          </div>
        </div>
      </section>

      <section class="tour" aria-labelledby="title-tour">
        <div class="wrap">
          <h2 id="title-tour" class="tour-titulo kof-sobretitulo">Por dentro da Comunidade</h2>
          <ul class="tour-faixa">
            {TOUR.map((frame) => (
              <li class="tour-item">
                <a href={img(frame.retina)} target="_blank" rel="noopener" data-zoom aria-label={`Ampliar a imagem: ${frame.alt}`}>
                  <img src={img(frame.file)} alt={frame.alt} width={frame.width} height={frame.height} loading="lazy" decoding="async" />
                  <span class="tour-nome">{frame.label}<span class="material-symbols-rounded tour-lupa" aria-hidden="true">zoom_in</span></span>
                  <span class="tour-resumo">{frame.resumo}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {page.sections.map((section, index) => <ComunidadeSection section={section} imagesBase={imagesBase} index={index} experience={index === 1 && !page.sections.some((item) => item.id === 'experiencia')} />)}

      {page.showFounder !== false && <section class="section capitulo fundo-folha cor-rosa" id="origem" aria-labelledby="title-origem">
        <div class="folha">
          <div class="wrap origem-grid">
            <figure class="family-photo kof-reveal">
              <div class="family-palco kof-marca">
                <span class="kof-decor decor-1" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
                <span class="kof-decor kof-decor--rosa decor-2" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
                <img src={img('familia-helena-julio-kids.webp')} alt="Helena e Júlio: foto do casal e versão ilustrada dos dois" width="880" height="1019" loading="lazy" decoding="async" />
              </div>
              <figcaption>Helena e Júlio. A experiência em família que deu origem à Comunidade.</figcaption>
            </figure>
            <div class="origem-texto kof-reveal">
              <div class="cap-head">
                <span class="cap-chip"><span class="material-symbols-rounded cap-chip-icone" aria-hidden="true">favorite</span>Uma experiência em família</span>
                <h2 id="title-origem" class="kof-display">{SHARED_COPY.founder.title}</h2>
                <ComunidadeProsa paragraphs={founder.slice(0, 1)} class="cap-lead" />
              </div>
              <div class="prosa"><ComunidadeProsa paragraphs={founder.slice(1)} destaques={DESTAQUES.origem} /></div>
            </div>
          </div>
        </div>
      </section>}

      <section class="planos section fundo-alt cor-azul" id="assinatura" aria-labelledby="title-assinatura">
        <div class="wrap">
          <div class="cap-head cap-head--centro kof-reveal">
            <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">workspace_premium</span>Assinatura</span>
            <h2 id="title-assinatura" class="kof-display">{offer.title}</h2>
            <ComunidadeProsa paragraphs={offer.paragraphs.slice(0, 1)} class="cap-lead" />
          </div>
          <div class="value-story prosa kof-reveal">
            <ComunidadeProsa paragraphs={offer.paragraphs.slice(1)} destaques={DESTAQUES.assinatura} />
          </div>
          <ComunidadeVisual visual="perfis" imagesBase={imagesBase} class="planos-visual" />
          <div class="plans kof-reveal" id="planos">
            <article class="plan kof-carta kof-carta--fio">
              <h3>{offer.monthly.title}</h3>
              <p class="price">{mensalLabel}<span>por mês</span></p>
              {offer.monthly.paragraphs.map((paragraph) => <p>{fillPrice(paragraph)}</p>)}
              <button type="button" class="kof-btn kof-btn--cheia kof-btn--contorno" data-checkout-cta data-checkout-oferta={mensal?.slug}>{offer.monthly.cta}</button>
            </article>
            <article class="plan annual kof-marca">
              <span class="kof-eyebrow saving"><span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>12 meses de acesso</span>
              <h3>{offer.annual.title}</h3>
              <p class="price">{anualLabel}<span>por 12 meses</span></p>
              {offer.annual.paragraphs.map((paragraph) => <p>{fillPrice(paragraph)}</p>)}
              <button type="button" class="kof-btn kof-btn--cheia kof-btn--inversa" data-checkout-cta data-checkout-oferta={anual?.slug}>{offer.annual.cta}</button>
            </article>
          </div>
          {offer.period && <div class="guarantee guarantee--periodo kof-carta kof-carta--fio kof-reveal">
            <div class="guarantee-head">
              <span class="kof-ladrilho kof-ladrilho--grande" aria-hidden="true"><span class="material-symbols-rounded">event_available</span></span>
              <h3 class="kof-display">{offer.period.title}</h3>
            </div>
            <div class="guarantee-texto"><ComunidadeProsa paragraphs={offer.period.paragraphs} /></div>
          </div>}
          <div id="garantia" class="guarantee kof-carta kof-carta--fio kof-reveal">
            <div class="guarantee-head">
              <span class="kof-ladrilho kof-ladrilho--verde kof-ladrilho--grande" aria-hidden="true"><span class="material-symbols-rounded">verified_user</span></span>
              <h3 class="kof-display">{offer.guarantee.title}</h3>
            </div>
            <div class="guarantee-texto">
              <ComunidadeProsa paragraphs={offer.guarantee.paragraphs} />
            </div>
            <a href="/kids/termos" class="kof-link kof-link--inline">Consultar os termos da assinatura</a>
          </div>
          <p id="contratacao" class="checkout-note kof-carta kof-carta--fio">{offer.checkout}</p>
        </div>
      </section>

      <section class="section" id="duvidas" aria-labelledby="title-duvidas">
        <div class="wrap">
          <div class="cap-head kof-reveal cor-roxo">
            <span class="cap-chip"><span class="material-symbols-rounded cap-chip-icone" aria-hidden="true">help</span>Na prática, em casa</span>
            <h2 id="title-duvidas" class="kof-display">{page.faqTitle}</h2>
            {page.faqLinks && <p class="faq-atalhos">{page.faqLinks.map((link, index) => <>{index > 0 && ' · '}<a class="kof-link kof-link--inline" href={link.href}>{link.label}</a></>)}</p>}
          </div>
          <div class="duvidas-grid">
            <nav class="faq-nav-area" aria-label="Assuntos das perguntas">
              <ul class="faq-nav">
                {page.faqGroups.map((group, index) => (
                  <li>
                    <a href={`#assunto-${index}`}>
                      <span class:list={['kof-ladrilho', faqColors[index % faqColors.length] ? `kof-ladrilho--${faqColors[index % faqColors.length]}` : '']} aria-hidden="true"><span class="material-symbols-rounded">{faqIcons[index % faqIcons.length]}</span></span>
                      <span>{group.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="faq">
              {page.faqGroups.map((group, index) => (
                <div class="faq-group" id={`assunto-${index}`}>
                  <h3 class="kof-display">
                    <span class:list={['kof-ladrilho', faqColors[index % faqColors.length] ? `kof-ladrilho--${faqColors[index % faqColors.length]}` : '']} aria-hidden="true"><span class="material-symbols-rounded">{faqIcons[index % faqIcons.length]}</span></span>
                    {group.title}
                  </h3>
                  {group.questions.map((id) => {
                    const answer = faq[id]
                    if (!answer) throw new Error(`Dúvida sem resposta: ${id}`)
                    const visuals = faqVisuals(id)
                    return (
                      <details class="kof-carta kof-carta--fio" id={`duvida-${id}`}>
                        <summary>{answer.question}<span class="material-symbols-rounded faq-seta" aria-hidden="true">expand_more</span></summary>
                        <div class:list={['resposta', { 'resposta--visual': visuals.length > 0 }]}>
                          <div class="resposta-texto">
                            <ComunidadeProsa paragraphs={answer.paragraphs} />
                            {id === 'reembolso' && <a href="/kids/termos" class="kof-link kof-link--inline">Ver o canal e as condições nos termos da assinatura</a>}
                          </div>
                          {visuals.length > 0 && (
                            <div class="resposta-visuais">{visuals.map((visual) => <ComunidadeVisual visual={visual} imagesBase={imagesBase} variant="plana" />)}</div>
                          )}
                        </div>
                      </details>
                    )
                  })}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="convite section kof-banda" id="convite" aria-labelledby="title-convite">
        <div class="wrap convite-grid">
          <span class="kof-decor decor-a" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
          <div class="convite-copy kof-reveal">
            <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">celebration</span>{page.closing.eyebrow}</span>
            <h2 id="title-convite" class="kof-display">{page.closing.title}</h2>
            <ComunidadeProsa paragraphs={closing.slice(0, 1)} class="cap-lead" />
            <div class="prosa"><ComunidadeProsa paragraphs={closing.slice(1)} destaques={DESTAQUES[`${page.id}:convite`]} /></div>
            {page.closing.actions.map((action) => <a class="kof-btn kof-btn--grande kof-btn--sobre-navy" href={action.href}>{action.label}</a>)}
          </div>
          <figure class="convite-arte kof-reveal">
            <img src={img('ilustra-vitoria.webp')} alt="Ilustração de duas crianças e o Zappy comemorando uma criação" width="1000" height="943" loading="lazy" decoding="async" />
            <figcaption>Ilustração da experiência de criar e compartilhar com a família.</figcaption>
          </figure>
        </div>
      </section>
    </main>
    <div class="kof-mobar" data-mobar aria-hidden="true">
      <p class="kof-mobar__preco">No anual, equivalente a<strong>{anualPorMesLabel} por mês</strong></p>
      <a class="kof-btn" href="#planos" tabindex="-1">Escolher um plano</a>
    </div>
    <dialog class="zoom" data-zoom-dialog aria-label="Imagem ampliada">
      <form method="dialog">
        <button class="zoom-fechar" aria-label="Fechar a imagem ampliada"><span class="material-symbols-rounded" aria-hidden="true">close</span></button>
      </form>
      <img alt="" decoding="async" />
    </dialog>
  </div>
  <Footer audience={f.audience} vitalicio={f.lifetimeAccess} />
  <PreCheckoutModal client:idle basePath={f.basePath} funnel={f.key} continuidade={profile === 'continuar'} />
</BaseLayout>

<script>
  // Reveal ao rolar e a barra fixa do celular. Sem JS nada disto existe: o `.kof-reveal` só
  // esconde sob `html.kof-js`, e a barra nasce escondida e `aria-hidden`.
  document.documentElement.classList.add('kof-js')
  const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const revelar = document.querySelectorAll<HTMLElement>('.kof-reveal')
  if (reduz || !('IntersectionObserver' in window)) {
    for (const el of Array.from(revelar)) el.classList.add('is-visible')
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.classList.add('is-visible')
            io.unobserve(e.target)
          }
      },
      { rootMargin: '0px 0px -8% 0px' },
    )
    for (const el of Array.from(revelar)) io.observe(el)
  }

  const barra = document.querySelector<HTMLElement>('[data-mobar]')
  const planos = document.getElementById('planos')
  const rodape = document.querySelector('footer')
  if (barra && planos && 'IntersectionObserver' in window) {
    const link = barra.querySelector('a')
    let planosAVista = false
    let rodapeAVista = false
    let roladoAlemDaDobra = false
    let ultimo: boolean | null = null
    const aplicar = () => {
      const mostra = roladoAlemDaDobra && !planosAVista && !rodapeAVista
      if (mostra === ultimo) return
      ultimo = mostra
      barra.classList.toggle('is-visible', mostra)
      barra.setAttribute('aria-hidden', mostra ? 'false' : 'true')
      link?.setAttribute('tabindex', mostra ? '0' : '-1')
    }
    new IntersectionObserver(
      ([e]) => {
        planosAVista = Boolean(e?.isIntersecting)
        aplicar()
      },
      { rootMargin: '0px 0px -40% 0px' },
    ).observe(planos)
    if (rodape)
      new IntersectionObserver(([e]) => {
        rodapeAVista = Boolean(e?.isIntersecting)
        aplicar()
      }).observe(rodape)
    const aoRolar = () => {
      roladoAlemDaDobra = window.scrollY > window.innerHeight * 0.9
      aplicar()
    }
    window.addEventListener('scroll', aoRolar, { passive: true })
    aoRolar()
  }

  const abrirDuvida = () => {
    const id = window.location.hash.slice(1)
    if (!id.startsWith('duvida-')) return
    const detail = document.getElementById(id)
    if (!(detail instanceof HTMLDetailsElement)) return
    detail.open = true
    detail.scrollIntoView({ block: 'start' })
  }
  abrirDuvida()
  window.addEventListener('hashchange', abrirDuvida)

  // Ampliar uma tela sem sair da página. Sem JS (ou sem <dialog>) o link abre a imagem em outra aba.
  const zoom = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]')
  const zoomImg = zoom?.querySelector('img')
  if (zoom && zoomImg && typeof zoom.showModal === 'function') {
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0) return
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-zoom]')
      if (!link) return
      event.preventDefault()
      zoomImg.src = link.href
      zoomImg.alt = link.querySelector('img')?.alt ?? ''
      zoom.showModal()
    })
    // O clique fora da imagem (no fundo escuro) fecha.
    zoom.addEventListener('click', (event) => {
      if (event.target === zoom) zoom.close()
    })
    zoom.addEventListener('close', () => zoomImg.removeAttribute('src'))
  }
</script>
