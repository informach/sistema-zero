---
// Página de vendas da "Comunidade dos Criadores" (funil kids, ASSINATURA
// mensal/anual). Layout PRÓPRIO alinhado à paleta Pen da Comunidade Kids
// (chão azul-acinzentado, ação azul, Baloo 2/Nunito e relevo 3D). O CSS sob
// medida vive no `<style>` escopado abaixo, sob `.cdc` (tokens no wrapper, não
// no :root). Os CTAs de compra levam `data-checkout-cta` → PreCheckoutModal; os
// CTAs de PLANO levam também `data-checkout-oferta` (slug da oferta mensal/anual)
// → o modal anexa `?oferta=` e o checkout pré-seleciona o plano.
//
// Argumentação (30/09, v2 — docs/plans/2026-09-30-comunidade-criadores-analise-e-proposta-v2.md):
// "Ele já joga. Aqui ele aprende a criar os próprios jogos, e continua." Quinze
// blocos: hero → confiança → a dor com a causa → a alavanca → por que as saídas
// comuns não pegam → o que ele vai fazer → o mecanismo (por que continua) → as
// primeiras crianças → comparação com o gratuito e com a escola → para quem é →
// objeções → planos e valor → quem faz → FAQ → fechamento. `origem="desafio"`
// (e-mail de conclusão do Desafio, vídeo do certificado, telas do app) troca o
// hero pela variante de continuidade e omite os blocos de dor e de saídas.
// Copy segue o Light Copy (sem travessão, sem "!", sem "Não é X. É Y.", sem
// "mesmo que"/"sem precisar", tese com causa, depoimentos reais sem estrela) e
// não promete nada acima do catálogo: o que ainda vem é dito como "conforme
// entra". ⚠️ Não prometer "aviso por e-mail antes de toda renovação": o lembrete
// só existe para o anual à vista; o cartão recorrente não recebe aviso prévio.
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { formatBRLFromCents, formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 97,00" (não usado aqui; a página trabalha com os planos). */
  priceLabel: string
  /** "R$ 97" (fallback de exibição da oferta principal). */
  priceLabelShort: string
  /** "97.00" (JSON-LD — preço da oferta PRINCIPAL da env). */
  priceReais: string
  imagesBase: string
  /** Repassados pela rota; esta oferta padrão não os renderiza. */
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  /** Planos da assinatura (principal + irmã do alternador). null = catálogo fora. */
  plans: OfferPlans | null
  /** `'desafio'` = chegou pela conclusão do Desafio (hero de continuidade). */
  origem?: 'desafio' | null
}
const { f, productName, priceReais, imagesBase, ofertaUrl, plans, origem = null } = Astro.props

const posDesafio = origem === 'desafio'
const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`

// Normaliza mensal/anual por INTERVALO (sem assumir qual é a principal da env).
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)

// Preços de exibição com fallback PRÓPRIO (o da rota é o do NCI — R$ 37, errado
// aqui). Catálogo fora do ar → mostra os preços de tabela e os CTAs seguem
// funcionando sem pré-seleção de plano.
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
const mensalLabel = formatBRLFromCents(mensalCents) // "R$ 97"
const anualLabel = formatBRLFromCents(anualCents) // "R$ 797"
const anualPorMesLabel = formatBRLFromCents2(Math.round(anualCents / 12)) // "R$ 66,42"
const anualAncoraLabel = formatBRLFromCents(mensalCents * 12) // "R$ 1.164"
const economiaLabel = formatBRLFromCents(mensalCents * 12 - anualCents) // "R$ 367"
// Âncoras honestas derivadas do preço vivo (nunca fixas na copy).
const diaLabel = formatBRLFromCents2(Math.round(mensalCents / 30)) // "R$ 3,23"
const porCriancaLabel = formatBRLFromCents2(Math.round(mensalCents / 2)) // "R$ 48,50"
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('checkout-capa.webp')}
  />
  <link slot="head" rel="preload" as="image" href={img('hero.webp')} fetchpriority="high" />

  <div class="cdc">
    <!-- ===== TOPO FIXO ===== -->
    <header class="topbar">
      <div class="wrap nav">
        <div class="logo">
          <span class="badge"><span class="material-symbols-rounded">stadia_controller</span></span>
          Comunidade dos Criadores
        </div>
        <div class="price-mini">{mensalLabel}/mês</div>
        <a href="#planos" class="btn header-cta">
          <span class="material-symbols-rounded">bolt</span><span class="lbl">Quero assinar</span>
        </a>
      </div>
    </header>

    <!-- ===== BLOCO 01 · HERO (promessa + mecanismo em uma linha + prova mínima) ===== -->
    <section class="hero sec">
      <svg
        class="deco float slow rev"
        style="top:22%;right:6%;width:34px"
        viewBox="0 0 24 24"
        fill="var(--sz-community-pink-light)"
        aria-hidden="true"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <div class="blob" style="width:220px;height:220px;background:var(--sz-community-ground-alt);top:-40px;right:-40px">
      </div>
      <div class="blob" style="width:160px;height:160px;background:var(--sz-community-mint);bottom:20px;left:-50px">
      </div>
      <div class="wrap">
        <div class="grid">
          {
            !posDesafio ? (
              <div class="hero-copy">
                <span class="eyebrow">
                  Para crianças de 9 a 14 anos<br />que gostam de jogos e tecnologia
                </span>
                <h1>
                  Seu filho já joga. <span class="hl">Aqui ele aprende a criar os próprios jogos.</span>
                </h1>
                <p class="lead">
                  Na Comunidade dos Criadores, crianças de 9 a 14 anos transformam as próprias ideias
                  em jogos de verdade. As aulas guiam uma etapa por vez, uma pessoa de verdade
                  acompanha o que elas enviam, e cada jogo publicado ganha um link para a família
                  jogar. Terminou o primeiro, a Jornada do Criador mostra o próximo.
                </p>
                <ul class="hero-bullets">
                  <li>
                    <span class="tick"><span class="material-symbols-rounded">check</span></span>Na
                    primeira semana, um jogo publicado com link, feito por ele
                  </li>
                  <li>
                    <span class="tick"><span class="material-symbols-rounded">check</span></span>Cada
                    atividade enviada é lida por uma pessoa, que responde dentro da plataforma
                  </li>
                  <li>
                    <span class="tick"><span class="material-symbols-rounded">check</span></span>
                    {mensalLabel} por mês para até duas crianças, sem fidelidade, com 7 dias de garantia
                  </li>
                </ul>
                <div class="hero-cta">
                  <a href="#planos" class="btn big">
                    <span class="material-symbols-rounded">rocket_launch</span>Quero ver meu filho criando
                  </a>
                </div>
                <div class="seals">
                  <span><span class="material-symbols-rounded">check_circle</span>Acesso após aprovação</span>
                  <span><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span>
                  <span><span class="material-symbols-rounded">check_circle</span>Cancele quando quiser</span>
                </div>
              </div>
            ) : (
              <div class="hero-copy">
                <span class="eyebrow">Para quem já publicou o primeiro jogo</span>
                <h1>
                  O primeiro jogo ficou pronto. <span class="hl">Agora vem o caminho inteiro.</span>
                </h1>
                <p class="lead">
                  Seu filho já provou que consegue montar, testar e publicar. A Comunidade dos
                  Criadores é a continuação: novos cursos, a Jornada do Criador, uma pessoa lendo o
                  que ele envia e o Mural para cada jogo novo. O progresso do Desafio continua de onde
                  parou.
                </p>
                <ul class="hero-bullets">
                  <li>
                    <span class="tick"><span class="material-symbols-rounded">check</span></span>Ele
                    segue do ponto em que está, sem refazer nada
                  </li>
                  <li>
                    <span class="tick"><span class="material-symbols-rounded">check</span></span>Cada
                    curso concluído sobe um posto e libera o próximo
                  </li>
                  <li>
                    <span class="tick"><span class="material-symbols-rounded">check</span></span>Até 2
                    perfis, 7 dias de garantia, cancele quando quiser
                  </li>
                </ul>
                <div class="hero-cta">
                  <a href="#planos" class="btn big">
                    <span class="material-symbols-rounded">rocket_launch</span>Quero que ele continue criando
                  </a>
                </div>
                <div class="seals">
                  <span><span class="material-symbols-rounded">check_circle</span>Acesso após aprovação</span>
                  <span><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span>
                  <span><span class="material-symbols-rounded">check_circle</span>Cancele quando quiser</span>
                </div>
              </div>
            )
          }
          <figure class="art hero-art">
            <div class="glow"></div>
            <img
              src={img('hero.webp')}
              alt="Criança apontando orgulhosa para o jogo que ela mesma criou, com o vagalume Zappy comemorando ao lado"
              width="940"
              height="1366"
              fetchpriority="high"
            />
          </figure>
        </div>
        <!-- fala do Zappy pra criança (mesmo registro lúdico do Desafio) -->
        <div class="kid reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('zappy-fala.webp')}
                alt="Zappy, o vagalume da Comunidade dos Criadores"
                width="360"
                height="458"
                loading="lazy"
              />
            </figure>
            <span class="name">Zappy</span>
          </div>
          <div class="bubble">
            Oi, sou o Zappy. Aqui você começa com um jogo e libera novos projetos e ferramentas
            conforme avança. Quando publicar, pode mandar o link para a família inteira jogar.
            Chama seu pai, sua mãe ou seu responsável para ver isto com você.
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 02 · FAIXA DE CONFIANÇA (três fatos verificáveis) ===== -->
    <section class="stats-band">
      <div class="wrap">
        <div class="stats">
          <div class="stat">
            <span class="material-symbols-rounded">family_star</span>
            <div class="l">Feito por dois desenvolvedores<br />que começaram com o próprio filho</div>
          </div>
          <div class="stat">
            <span class="material-symbols-rounded">verified_user</span>
            <div class="l">Conta da criança vinculada ao responsável,<br />Clube moderado, sem chat aberto</div>
          </div>
          <div class="stat">
            <span class="material-symbols-rounded">devices</span>
            <div class="l">Abre no navegador, sem instalar nada,<br />sem contrato de fidelidade</div>
          </div>
        </div>
      </div>
    </section>

    {
      !posDesafio && (
        <section class="sec" id="dor">
          {/* ===== BLOCO 03 · A DOR COM A CAUSA ===== */}
          <div class="wrap">
            <div class="center">
              <span class="eyebrow">O que você vê da porta do quarto</span>
              <h2 class="reveal">
                Ele passa horas dentro do jogo.<br />Quando desliga, <span class="hl">não sobra nada que seja dele.</span>
              </h2>
            </div>
            <div class="feat">
              <figure class="art reveal">
                <img
                  src={img('ilustra-dor.webp')}
                  alt="Ilustração de uma criança concentrada em um jogo no computador"
                  width="1000"
                  height="577"
                  loading="lazy"
                />
              </figure>
              <div class="feat-txt">
                <p>
                  Você já parou na porta do quarto e ficou olhando seu filho jogar. O corpo inclinado
                  para a frente, os olhos fixos na tela, uma concentração que você gostaria de ver na
                  hora da lição. Ali dentro ele domina um mundo inteiro.
                </p>
                <p>
                  O que pesa vem depois. O jogo acaba, o computador desliga e o dia termina como
                  começou. Ele conhece cada canto de um mundo que outra pessoa construiu, e nada
                  daquilo tem o nome dele.
                </p>
                <p>
                  Isso acontece por um motivo simples. O jogo foi feito para ser jogado até o fim, com
                  fases, recompensas e um próximo desafio sempre pronto. Construir é outra atividade,
                  e o jogo não abre essa porta. Ele oferece o que foi decidido por outra pessoa. O
                  que ele não oferece é a chance de decidir uma regra, testar e ver a própria ideia
                  funcionando.
                </p>
                <p>
                  Limitar as horas continua importante, e a família continua no comando disso. Só
                  que o limite muda a quantidade. O que acontece dentro das horas que ficam é outra
                  decisão, e é dela que esta página trata.
                </p>
              </div>
            </div>
            <div class="tese reveal">
              A pergunta que vale a pena fazer é o que seu filho está aprendendo a fazer com o tempo
              de tela que ele já tem.
            </div>
          </div>
        </section>
      )
    }

    <!-- ===== BLOCO 04 · A ALAVANCA (o interesse como porta de entrada) ===== -->
    <section class="sec sec-amar" id="virada">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">O interesse já existe</span>
          <h2 class="reveal">
            O mesmo interesse que te preocupa é a melhor porta de entrada<br />para ele <span class="hl2">aprender a criar.</span>
          </h2>
        </div>
        <div class="feat feat-rev">
          <figure class="art reveal">
            <img
              src={img('ilustra-virada.webp')}
              alt="A mesma criança criando o próprio jogo, com blocos coloridos na tela e o Zappy ao lado"
              width="1100"
              height="630"
              loading="lazy"
            />
          </figure>
          <div class="feat-txt">
            <p>
              Criança que ama jogos quer entender como um jogo é feito. Ela já imaginou uma fase
              diferente, um personagem com um poder novo, uma regra que mudaria tudo. Essa vontade é
              o ponto de partida, e ela não precisa ser inventada por um curso.
            </p>
            <p>
              Para uma ideia dessas virar um jogo que funciona, ela precisa decidir o que acontece
              primeiro, montar a regra, testar, ver dar errado, corrigir e terminar. É exatamente o
              tipo de pensamento que você gostaria de ver, e ele aparece porque a criança quer chegar
              ao final do próprio jogo.
            </p>
            <p>
              Foi assim com o André, nosso filho. Aos 7 anos, quase todo o interesse dele terminava no
              jogar. Quando começamos a criar jogos juntos, ele passou a nos chamar para testar as
              regras dele e a explicar cada escolha. Hoje, aos 12, é ele quem dá voz ao Zappy dentro
              da plataforma. A história inteira está mais abaixo.
            </p>
            <div class="tese">
              Quando a criança escolhe o que criar e vê que consegue, a vontade de continuar vem de
              dentro. É isso que uma atividade imposta não consegue produzir.
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      !posDesafio && (
        <section class="sec" id="saidas">
          {/* ===== BLOCO 05 · POR QUE AS SAÍDAS COMUNS NÃO PEGAM ===== */}
          <div class="wrap">
            <div class="center">
              <span class="eyebrow">Você provavelmente já tentou</span>
              <h2 class="reveal">Três saídas comuns, e o ponto em que cada uma falha</h2>
            </div>
            <div class="pal">
              <div class="pal-item reveal">
                <span class="xi"><span class="material-symbols-rounded">timer</span></span>
                <div>
                  <h4>Limitar o tempo</h4>
                  <p>
                    Diminui as horas e costuma render briga. O que acontece dentro do jogo continua
                    igual, e ele volta para o mesmo lugar assim que pode. O limite é necessário;
                    sozinho, ele não muda o que a criança faz.
                  </p>
                </div>
              </div>
              <div class="pal-item reveal">
                <span class="xi"><span class="material-symbols-rounded">sports_soccer</span></span>
                <div>
                  <h4>Empurrar outro hobby</h4>
                  <p>
                    Esporte, música, um curso escolhido pelos pais. Quando a atividade não parte do
                    interesse da criança, ela vai de má vontade, aguenta um ou dois meses e larga. As
                    pesquisas sobre abandono em esporte e música apontam sempre os mesmos motivos:
                    deixou de ser divertido, ela não se sente capaz, não vê progresso.
                  </p>
                </div>
              </div>
              <div class="pal-item reveal">
                <span class="xi"><span class="material-symbols-rounded">construction</span></span>
                <div>
                  <h4>Deixar solto no Roblox Studio, no Scratch ou no YouTube</h4>
                  <p>
                    A ferramenta é boa e é gratuita. O que falta é um caminho na ordem certa, alguém
                    que olhe o que ela fez quando trava e um lugar seguro para mostrar. Muita criança
                    para nos cenários e nos personagens e volta a só jogar.
                  </p>
                </div>
              </div>
            </div>
            <div class="tese reveal">
              O que faz o interesse virar criação é a soma de três coisas: um caminho, uma pessoa e um
              lugar para mostrar. É isso que a Comunidade organiza.
            </div>
          </div>
        </section>
      )
    }

    <!-- ===== BLOCO 06 · O QUE ELE VAI FAZER (promessa concreta no tempo) ===== -->
    <section class="sec sec-tint" id="pratica">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Como fica na prática</span>
          <h2 class="reveal">
            Na primeira semana, o primeiro jogo publicado.<br />Depois, <span class="hl">um projeto de cada vez.</span>
          </h2>
        </div>
        <div class="evidence reveal">
          <p>O caminho, do primeiro acesso em diante:</p>
          <div class="evidence-links">
            <div>
              <strong>Primeira semana</strong>
              <span>
                O Desafio do Primeiro Jogo. Em aulas guiadas de uma etapa por vez, ele monta as
                regras de um jogo com cenário e personagens já preparados, publica com link e QR code
                e manda para a família jogar.
              </span>
            </div>
            <div>
              <strong>Primeiro mês</strong>
              <span>
                Os cursos seguintes. Ele altera regras, cria a própria versão de um jogo e envia as
                atividades para revisão. Cada curso concluído e publicado sobe um posto na Jornada do
                Criador.
              </span>
            </div>
            <div>
              <strong>Depois</strong>
              <span>
                Novos cursos e ferramentas abrem conforme ele avança, de Faísca até Lenda. A
                plataforma está em lançamento: os cursos de hoje e todos os que entrarem fazem parte
                da assinatura, e a Jornada mostra o que vem em seguida.
              </span>
            </div>
          </div>
        </div>
        <div class="evidence reveal">
          <p>
            Uma mudança pequena, para você ver o que acontece dentro de uma aula: ele quer que o
            personagem corra mais rápido.
          </p>
          <div class="evidence-links">
            <div>
              <strong>Ele faz uma previsão</strong>
              <span>Escolhe uma nova velocidade e pensa no que vai acontecer quando o jogo começar.</span>
            </div>
            <div>
              <strong>Coloca a ideia à prova</strong>
              <span>Roda o jogo e observa. O personagem ficou rápido demais? Ainda dá tempo de desviar?</span>
            </div>
            <div>
              <strong>Decide o que ajustar</strong>
              <span>Experimenta outro valor e compara. Agora tem uma razão para explicar a escolha.</span>
            </div>
          </div>
          <small>
            É esse ciclo, previsão, teste e ajuste, que se repete em cada projeto. Os primeiros projetos
            são guiados, com elementos preparados para a criança começar; a autoria cresce nas escolhas
            e nas versões seguintes.
          </small>
        </div>
        <div class="center" style="margin-top:40px;">
          <h3 style="font-size:clamp(1.2rem,2.4vw,1.5rem);">O que você vai ver e ouvir em casa</h3>
        </div>
        <div style="max-width:720px;margin:20px auto 0;">
          <ul class="hero-bullets">
            <li>
              <span class="tick"><span class="material-symbols-rounded">check</span></span>Um link no
              grupo da família e o contador de jogadas subindo.
            </li>
            <li>
              <span class="tick"><span class="material-symbols-rounded">check</span></span>Ele
              explicando por que a regra é assim e o que muda se trocar.
            </li>
            <li>
              <span class="tick"><span class="material-symbols-rounded">check</span></span>Uma
              tentativa que deu errado e a seguinte que deu certo.
            </li>
            <li>
              <span class="tick"><span class="material-symbols-rounded">check</span></span>Uma dúvida
              enviada e a resposta de uma pessoa dentro da plataforma.
            </li>
          </ul>
        </div>
        <div class="tese reveal">
          Pergunte o que ele mudou e peça para mostrar no jogo. A explicação dele é a sua janela para
          o que ele está entendendo.
        </div>
        <!-- fala da Debinha pra criança -->
        <div class="kid rosa reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('debinha-fala.webp')}
                alt="Debinha, personagem da Comunidade dos Criadores"
                width="360"
                height="640"
                loading="lazy"
              />
            </figure>
            <span class="name">Debinha</span>
          </div>
          <div class="bubble">
            O melhor momento é mandar o link do seu jogo no grupo da família e ficar espiando o
            contador de jogadas subir. Cada nova jogada mostra que alguém abriu uma criação sua.
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 07 · COMO A COMUNIDADE SUSTENTA A CONTINUIDADE (mecanismo) ===== -->
    <section class="sec" id="metodo">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Por que ele continua depois do primeiro jogo</span>
          <h2 class="reveal">
