---
// Página de vendas da "Comunidade dos Criadores" (funil kids, ASSINATURA
// mensal/anual). Layout PRÓPRIO no mesmo tema do Desafio (creme + azul +
// laranja, Baloo 2/Nunito, botões 3D, balões dos personagens), estrutura 8D em
// 19 blocos. O CSS sob medida vive no `<style>` escopado abaixo, sob `.cdc`
// (tokens no wrapper, não no :root). Os CTAs de compra levam `data-checkout-cta`
// → PreCheckoutModal; os CTAs de PLANO levam também `data-checkout-oferta`
// (slug da oferta mensal/anual) → o modal anexa `?oferta=` e o checkout
// pré-seleciona o plano. Copy segue o Light Copy (sem travessão, sem "!",
// sem "Não é X. É Y.", depoimentos reais, bônus ancorados).
import '@fontsource/material-symbols-rounded/400.css'
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { formatBRLFromCents } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 97,00" (não usado aqui; a página trabalha com os planos). */
  priceLabel: string
  /** "R$ 97" (fallback de exibição da oferta principal). */
  priceLabelShort: string
  /** "97.00" (JSON-LD — preço da oferta PRINCIPAL da env). */
  priceReais: string
  imagesBase: string
  /** Repassados pela rota; esta oferta padrão não os renderiza. */
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  /** Planos da assinatura (principal + irmã do alternador). null = catálogo fora. */
  plans: OfferPlans | null
}
const { f, productName, priceReais, imagesBase, ofertaUrl, plans } = Astro.props

const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`

// Normaliza mensal/anual por INTERVALO (sem assumir qual é a principal da env).
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)

// Preços de exibição com fallback PRÓPRIO (o da rota é o do NCI — R$ 37, errado
// aqui). Catálogo fora do ar → mostra os preços de tabela e os CTAs seguem
// funcionando sem pré-seleção de plano.
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
const mensalLabel = formatBRLFromCents(mensalCents) // "R$ 97"
const anualLabel = formatBRLFromCents(anualCents) // "R$ 797"
const anualPorMesLabel = formatBRLFromCents(Math.round(anualCents / 12)) // "R$ 66"
const anualAncoraLabel = formatBRLFromCents(mensalCents * 12) // "R$ 1.164"
const economiaLabel = formatBRLFromCents(mensalCents * 12 - anualCents) // "R$ 367"
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('checkout-capa.webp')}
  />
  <link slot="head" rel="preload" as="image" href={img('hero.webp')} fetchpriority="high" />

  <div class="cdc">
    <!-- ===== TOPO FIXO ===== -->
    <header class="topbar">
      <div class="wrap nav">
        <div class="logo">
          <span class="badge"><span class="material-symbols-rounded">stadia_controller</span></span>
          Comunidade dos Criadores
        </div>
        <div class="price-mini">{mensalLabel}/mês</div>
        <a href="#planos" class="btn header-cta">
          <span class="material-symbols-rounded">bolt</span><span class="lbl">Quero assinar</span>
        </a>
      </div>
    </header>

    <!-- ===== BLOCO 01 · HERO ===== -->
    <section class="hero sec">
      {/* Deco só do lado da ARTE: a estrela que ficava à esquerda caía em cima
          da headline e atrapalhava a leitura (feedback da usuária). */}
      <svg
        class="deco float slow rev"
        style="top:22%;right:6%;width:34px"
        viewBox="0 0 24 24"
        fill="#F368A6"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <div class="blob" style="width:220px;height:220px;background:#CDE8FF;top:-40px;right:-40px">
      </div>
      <div class="blob" style="width:160px;height:160px;background:#CFF3DC;bottom:20px;left:-50px">
      </div>
      <div class="wrap">
        <div class="grid">
          <div class="hero-copy">
            <span class="eyebrow"
              >Pra crianças de 9 a 14 anos<br />que vivem em jogos e tecnologia</span
            >
            <h1>
              As horas que o seu filho passa dentro do jogo escondem o maior <span class="hl"
                >talento dele</span
              >, esperando um lugar pra ir
            </h1>
            <p class="lead">
              Quando uma criança que ama games aprende a criar os próprios jogos, o tempo de jogo
              que hoje te preocupa passa a construir raciocínio, autonomia e orgulho do que ela faz.
              E pra ela, é só diversão.
            </p>
            <ul class="hero-bullets">
              <li>
                <span class="tick"><span class="material-symbols-rounded">check</span></span>A mesma
                cabeça que decora um jogo inteiro monta um jogo do zero, com telas, placar e
                final
              </li>
              <li>
                <span class="tick"><span class="material-symbols-rounded">check</span></span>Ele
                cria o próprio jogo, publica com um link de verdade e manda pros amigos e pros avós
                jogarem
              </li>
              <li>
                <span class="tick"><span class="material-symbols-rounded">check</span></span>A cada
                jogo que termina, ganha raciocínio, paciência e a certeza de que é capaz de criar,
                tudo brincando
              </li>
            </ul>
            <div class="hero-cta">
              <a href="#planos" class="btn big">
                <span class="material-symbols-rounded">rocket_launch</span>Quero que meu filho
                comece a criar
              </a>
            </div>
            <div class="seals">
              <span><span class="material-symbols-rounded">check_circle</span>Acesso na hora</span>
              <span
                ><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span
              >
              <span
                ><span class="material-symbols-rounded">check_circle</span>Cancele quando quiser</span
              >
            </div>
          </div>
          <figure class="art hero-art">
            <div class="glow"></div>
            <img
              src={img('hero.webp')}
              alt="Criança apontando orgulhosa para o jogo que ela mesma criou, com o robô Zappy comemorando ao lado"
              width="940"
              height="1366"
              fetchpriority="high"
            />
          </figure>
        </div>
        <!-- fala do Zappy pra criança (mesmo registro lúdico do Desafio) -->
        <div class="kid reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('zappy-fala.webp')}
                alt="Zappy, o robô da Comunidade dos Criadores"
                width="360"
                height="458"
                loading="lazy"
              />
            </figure>
            <span class="name">Zappy</span>
          </div>
          <div class="bubble">
            Oi, sou o Zappy. Aqui dentro a gente monta jogo de verdade: com fases, placar e até
            chefão. Depois você publica e manda o link pra família inteira jogar o seu jogo. Chama
            seu pai ou sua mãe pra ler esta página com você.
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAIXA DE CONFIANÇA ===== -->
    <section class="stats-band">
      <div class="wrap">
        <div class="stats">
          <div class="stat">
            <span class="material-symbols-rounded">verified_user</span>
            <div class="l">Comunidade moderada<br />por gente de verdade</div>
          </div>
          <div class="stat">
            <span class="material-symbols-rounded">devices</span>
            <div class="l">Abre no navegador,<br />sem instalar nada</div>
          </div>
          <div class="stat">
            <span class="material-symbols-rounded">family_star</span>
            <div class="l">Feito por uma família<br />que viveu essa virada</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 02 · DOR ===== -->
    <section class="sec" id="dor">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">O que passa pela sua cabeça</span>
          <h2 class="reveal">
            Ali, naquele jogo, ele é <span class="hl">inteiro</span>.<br />E é exatamente isso que
            mexe com você
          </h2>
        </div>
        <div class="feat">
          <figure class="art reveal">
            <img
              src={img('ilustra-dor.webp')}
              alt="Criança concentrada na frente do computador, apenas consumindo um jogo"
              width="1000"
              height="577"
              loading="lazy"
            />
          </figure>
          <div class="feat-txt">
            <p>
              Você já parou na porta do quarto e ficou só olhando o seu filho jogar, sem
              interromper. O corpo pra frente, os olhos que não piscam, uma concentração de horas
              que você queria ver na hora da lição e quase nunca vê.
            </p>
            <p>
              O que aperta o peito é ver todo esse mergulho, essa cabeça que aprende cada detalhe de
              um jogo em poucos dias, indo pra um lugar que no fim não devolve nada. Ele domina um
              mundo que outra pessoa criou, decora cada canto, e quando desliga, zera. Amanhã começa
              do zero de novo. Não sobra nada que seja dele.
            </p>
            <p>
              Essa atenção toda tem uma explicação que tira o peso das suas costas e das dele. O jogo
              foi construído pra prender atenção: recompensa a cada poucos segundos, uma fase sempre
              puxando a próxima. Preguiça e vício não explicam o que você vê da porta do quarto;
              engenharia de atenção explica. Seu filho está sendo bom numa máquina desenhada pra
              capturar exatamente isso, e pra ser vencida sem deixar rastro.
            </p>
          </div>
        </div>
        <div class="tese reveal">
          No fundo, o que passa pela sua cabeça é uma pergunta só, aquela que você às vezes nem
          termina de pensar: se ele consegue mergulhar assim nisso, imagina se toda essa energia
          fosse pra algo que ficasse pra ele.
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 03 · A VIRADA DE CHAVE ===== -->
    <section class="sec sec-amar" id="virada">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">A virada de chave</span>
          <h2 class="reveal">
            O que você achava que era a <span class="hl">fraqueza</span> dele<br />é, na verdade, a
            maior <span class="hl2">força</span>
          </h2>
        </div>
        <div class="feat feat-rev">
          <figure class="art reveal">
            <img
              src={img('ilustra-virada.webp')}
              alt="A mesma criança criando o próprio jogo, com blocos coloridos na tela e o Zappy ao lado"
              width="1100"
              height="630"
              loading="lazy"
            />
          </figure>
          <div class="feat-txt">
            <p>
              Esse interesse é o material mais valioso que o seu filho tem, e quase ninguém
              percebe isso a tempo. Toda criança que fica horas presa num jogo está treinando, sem
              saber, uma habilidade que muito adulto gostaria de ter: mergulhar de cabeça numa coisa
              e só largar quando domina.
            </p>
            <p>
              A criança que só joga e a criança que cria têm o mesmo interesse, na mesma quantidade.
              A diferença inteira está em pra onde esse interesse aponta.
            </p>
            <div class="tese">
              As horas que consomem deixam um recorde que some. As mesmas horas, apontadas pra criar,
              deixam um jogo que fica, com o nome dele, que a família inteira pode abrir e jogar.
              Mesma criança, mesmo tempo, dois destinos completamente diferentes.
            </div>
            <p style="margin-top:16px;">
              E virar essa chave é possível justamente porque a criança já gosta de games e
              tecnologia. Ninguém arrasta ela pra lugar nenhum. O caminho começa de dentro do que
              ela já ama.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 04 · PALIATIVO ===== -->
    <section class="sec" id="paliativo">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">O que costuma não pegar</span>
          <h2 class="reveal">
            Você já tentou redirecionar essas horas.<br />As saídas óbvias falham num ponto que <span
              class="hl2">ninguém conta</span
            >
          </h2>
        </div>
        <div class="pal">
          <div class="pal-item reveal">
            <span class="xi"><span class="material-symbols-rounded">timer_off</span></span>
            <div>
              <h4>Limitar o tempo de tela</h4>
              <p>
                Diminui as horas, mas o destino delas continua o mesmo. Ele volta pro mesmo lugar
                assim que pode, e no meio disso vira briga diária, culpa e cara feia. O interesse
                segue intacto, apontado pro mesmo canto.
              </p>
            </div>
          </div>
          <div class="pal-item reveal">
            <span class="xi"><span class="material-symbols-rounded">sports_soccer</span></span>
            <div>
              <h4>Empurrar outro hobby</h4>
              <p>
                Esporte, música, um curso que os pais escolhem. Quando a atividade fala com o que a
                criança ama, a atenção migra; quando chega de fora, ela faz de má vontade, aguenta um
                ou dois meses e larga, porque aquilo não acende nada dentro dela. Disciplina
                resolve pouco onde o interesse ainda nem nasceu.
              </p>
            </div>
          </div>
          <div class="pal-item reveal">
            <span class="xi"><span class="material-symbols-rounded">travel_explore</span></span>
            <div>
              <h4>Deixar solto no Roblox ou no YouTube</h4>
              <p>
                O editor do Roblox é ferramenta profissional em inglês, sem trilha e sem ninguém do
                lado quando ele trava. O YouTube é tutorial picado, sem sequência. A criança se
                perde na primeira dificuldade e volta a só jogar.
              </p>
            </div>
          </div>
        </div>
        <div class="tese reveal">
          Nenhuma dessas tentativas faz a única coisa que redireciona esse interesse de verdade:
          pegar a criança onde ela já está, dentro dos games e da tecnologia, e apontar ele pra
          criar, com um caminho na ordem certa e alguém junto quando ela trava.
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 05 · PROVA SOCIAL 1 (crianças reais) ===== -->
    <section class="sec sec-verde" id="prova">
      <div class="wrap center">
        <span class="eyebrow">Quem já virou a chave</span>
        <h2 class="reveal">As crianças que já saíram<br />do só jogar pra <span class="hl">criar</span></h2>
        <p class="sub">
          Elas entraram como quem só jogava. Hoje mostram os próprios jogos pra quem quiser ver.
        </p>
        <div class="depo-grid">
          <div class="depo reveal">
            <div class="stars">★★★★★</div>
            <p class="quote">
              "Fiz uma nave que atira nos asteroides e marca ponto. No fim eu peguei o link e mandei
              pro meu amigo jogar."
            </p>
            <div class="who">
              <span class="av"
                ><img
                  src={img('depo-rafael.webp')}
                  alt="Rafael"
                  width="160"
                  height="160"
                  loading="lazy"
                /></span
              >
              <span class="who-name">Rafael<small>criou e publicou o próprio jogo</small></span>
            </div>
          </div>
          <div class="depo reveal">
            <div class="stars">★★★★★</div>
            <p class="quote">
              "Achei que ia ser difícil, mas fui montando os bloquinhos e deu certo. No terceiro dia
              chamei a minha mãe pra ver o meu jogo."
            </p>
            <div class="who">
              <span class="av"
                ><img
                  src={img('depo-debora.webp')}
                  alt="Débora"
                  width="160"
                  height="160"
                  loading="lazy"
                /></span
              >
              <span class="who-name">Débora<small>criou e publicou o próprio jogo</small></span>
            </div>
          </div>
          <div class="depo reveal">
            <div class="stars">★★★★★</div>
            <p class="quote">
              "Eu já jogava um monte, agora eu faço os meus jogos. Esse foi o primeiro e já quero
              fazer um maior."
            </p>
            <div class="who">
              <span class="av"
                ><img
                  src={img('depo-andre.webp')}
                  alt="André"
                  width="160"
                  height="160"
                  loading="lazy"
                /></span
              >
              <span class="who-name">André<small>criou e publicou o próprio jogo</small></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 06 · CTA INTERMEDIÁRIO ===== -->
    <section class="sec sec-slim">
      <div class="wrap">
        <div class="ctaband reveal">
          <h3>Existe um lugar feito pra pegar esse interesse e apontar ele pra criação.</h3>
          <a href="#metodo" class="btn big">
            <span class="material-symbols-rounded">visibility</span>Quero conhecer por dentro
          </a>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 07 · MÉTODO Z.E.R.O. + CARREIRA ===== -->
    <section class="sec sec-tint" id="metodo">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">O método que faz terminar</span>
          <h2 class="reveal">
            Por que a criança larga quase toda criação na primeira dificuldade,<br />e por que aqui
            ela <span class="hl">volta na terça pra terminar</span>
          </h2>
          <p class="sub">
            A criança larga porque fica sozinha diante da tela em branco. Aqui ela segue um caminho
            com nome, ordem e um fim visível a cada volta: o Método Z.E.R.O.
          </p>
        </div>
        <div class="zero">
          <div class="zstep z1 reveal">
            <div class="zl">Z</div>
            <h4>Zerar a Bagunça</h4>
            <p>
              A ideia solta vira a Carta da Ideia do jogo. Conversando com o Zappy, o projeto começa
              organizado, com começo, meio e fim no papel.
            </p>
          </div>
          <div class="zstep z2 reveal">
            <div class="zl">E</div>
            <h4>Enxergar o Jogo</h4>
            <p>
              Antes de construir, ela vê: as telas desenhadas, o nome, as cores e o ícone. Ela para
              de se perder no meio do caminho.
            </p>
          </div>
          <div class="zstep z3 reveal">
            <div class="zl">R</div>
            <h4>Rodar as Missões</h4>
            <p>
              O jogo grande vira missões pequenas, uma de cada vez, com o professor acompanhando o
              que ela envia.
            </p>
          </div>
          <div class="zstep z4 reveal">
            <div class="zl">O</div>
            <h4>O Grande Lançamento</h4>
            <p>
              Caça aos bugs, um toque final e a publicação com link de verdade pra mandar pra
              família. Uma vitória que fica.
            </p>
          </div>
        </div>
        <div class="zloop reveal">
          Terminou o O, volta pro Z com um jogo mais ambicioso. O ciclo é o mesmo, o desafio é que
          cresce.
        </div>

        <div class="center" style="margin-top:52px;">
          <h2 class="reveal" style="font-size:clamp(1.4rem,2.8vw,2rem);">
            E acima do método, uma jornada: a <span class="hl2">Carreira de Criador</span>
          </h2>
          <p class="sub">
            O Z.E.R.O. é o que a criança faz. A Carreira é quem ela se torna: cada jogo publicado
            sobe um nível, como a faixa do judô, e nível que sobe não volta atrás.
          </p>
        </div>
        <div class="career reveal">
          <span class="lvl-pill" style="--c:#9aa3b8"
            ><span class="material-symbols-rounded">bolt</span>Faísca</span
          >
          <span class="lvl-pill" style="--c:var(--verde)"
            ><span class="material-symbols-rounded">build</span>Construtor</span
          >
          <span class="lvl-pill" style="--c:var(--azul)"
            ><span class="material-symbols-rounded">lightbulb</span>Inventor</span
          >
          <span class="lvl-pill" style="--c:var(--roxo)"
            ><span class="material-symbols-rounded">swords</span>Mestre dos Jogos</span
          >
          <span class="lvl-pill" style="--c:var(--rosa)"
            ><span class="material-symbols-rounded">military_tech</span>Lenda</span
          >
        </div>
        <div class="tese reveal">
          Isso funciona pelo mesmo motivo que faz o seu filho não largar o jogo que joga: o cérebro
          dele responde a ciclos curtos de esforço e resultado. Zero motivação forçada. É o
          mecanismo que já prende ele no jogo, agora trabalhando a favor de quem cria.
        </div>
        <!-- fala do Dedé pra criança -->
        <div class="kid verde reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('dede-fala.webp')}
                alt="Dedé, personagem da Comunidade dos Criadores"
                width="360"
                height="869"
                loading="lazy"
              />
            </figure>
            <span class="name">Dedé</span>
          </div>
          <div class="bubble">
            Cada jogo que você termina sobe a sua carreira. Eu comecei na Faísca e agora tô
            batalhando pra chegar em Mestre dos Jogos. Qual nome você vai dar pro seu primeiro jogo?
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 08 · O QUE DESENVOLVE (DECORADOS) ===== -->
    <section class="sec sec-rosa" id="desenvolve">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Enquanto ele acha que está brincando</span>
          <h2 class="reveal">O que cresce <span class="hl">por baixo</span> da diversão</h2>
          <p class="sub">
            O seu filho vai achar que está só montando joguinho. E é bom que ache, porque é assim
            que criança aprende de verdade, quando nem sente o esforço. Por baixo, uma coisa de cada
            vez, cresce tudo isto.
          </p>
        </div>
        <div class="dev">
          <div class="dev-item reveal">
            <div class="di" style="background:var(--azul)">
              <span class="material-symbols-rounded">account_tree</span>
            </div>
