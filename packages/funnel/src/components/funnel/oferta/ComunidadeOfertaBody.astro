---
// Copy e composição: docs/plans/2026-09-30-comunidade-copy-leitura-revisada.md.
// Ilustrações provisórias autorizadas, com substituições no briefing de materiais.
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { formatBRLFromCents, formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 97,00" (não usado aqui; a página trabalha com os planos). */
  priceLabel: string
  /** "R$ 97" (fallback de exibição da oferta principal). */
  priceLabelShort: string
  /** "97.00" (JSON-LD — preço da oferta PRINCIPAL da env). */
  priceReais: string
  imagesBase: string
  /** Repassados pela rota; esta oferta padrão não os renderiza. */
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  /** Planos da assinatura (principal + irmã do alternador). null = catálogo fora. */
  plans: OfferPlans | null
  /** Origem do link; não comprova conclusão individual do Desafio. */
  origem?: 'desafio' | null
}
const { f, productName, priceReais, imagesBase, ofertaUrl, plans, origem = null } = Astro.props

const posDesafio = origem === 'desafio'
const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`

// Normaliza mensal/anual por INTERVALO (sem assumir qual é a principal da env).
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)

// Preços de exibição com fallback PRÓPRIO (o da rota é o do NCI — R$ 37, errado
// aqui). Catálogo fora do ar → mostra os preços de tabela e os CTAs seguem
// funcionando sem pré-seleção de plano.
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
const mensalLabel = formatBRLFromCents(mensalCents) // "R$ 97"
const anualLabel = formatBRLFromCents(anualCents) // "R$ 797"
const anualPorMesLabel = formatBRLFromCents2(Math.round(anualCents / 12)) // "R$ 66,42"
const anualAncoraLabel = formatBRLFromCents(mensalCents * 12) // "R$ 1.164"
const economiaCents = mensalCents * 12 - anualCents
const economiaLabel = formatBRLFromCents(economiaCents) // "R$ 367"
---
<BaseLayout title={f.seoTitle} description={description} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass={f.theme ? `theme-${f.theme}` : undefined}>
<ProductJsonLd slot="head" name={productName} description={description} price={priceReais} url={ofertaUrl} image={img('checkout-capa.webp')} />
<link slot="head" rel="preload" as="image" href={img('preview-estudio.webp')} fetchpriority="high" />
<div class="cdc">
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<header class="topbar">
<div class="wrap nav"><a class="brand" href="#conteudo" aria-label="Comunidade dos Criadores, início"><span class="material-symbols-rounded" aria-hidden="true">stadia_controller</span><span>Comunidade<br />dos Criadores</span></a><a class="action compact" href="#planos">Escolher um plano</a>
</div>
</header>
<main id="conteudo">
<section class="hero section" aria-labelledby="hero-title">
<div class="wrap hero-grid">
<div class="hero-copy">
{!posDesafio ? (<>
<h1 id="hero-title">Seu filho aprende a criar <span>os próprios jogos</span>
</h1>
<p class="lead">
  Um projeto guiado ajuda seu filho a começar. Ele aprende a montar o jogo por partes e a testar as
  ideias que quer colocar no próprio jogo.
</p>
<ul class="hero-benefits">
<li>Praticar raciocínio e resolução de problemas ao montar uma regra e testar o resultado.</li>
<li>Desenhar um personagem ou montar uma fase para o jogo que ele está criando.</li>
<li>Convidar você para jogar o jogo que ele criou.</li>
</ul>
</>) : (<>
<h1 id="hero-title">Seu filho pode continuar <span>o caminho de criar jogos</span>
</h1>
<p class="lead">
  Projetos guiados e ferramentas de criação para retomar uma etapa ou desenvolver novas versões do
  que ele já começou.
</p>
<ul class="hero-benefits">
<li>Continuar de onde parou, aproveitando o progresso do perfil.</li>
<li>Experimentar outras ideias no jogo, com as ferramentas que já liberou.</li>
<li>Encontrar na Jornada os projetos disponíveis para sua etapa.</li>
</ul>
</>)}
<div class="hero-actions"><a class="action" href="#planos">{posDesafio ? 'Escolher um plano para continuar' : 'Escolher um plano para meu filho'}</a>
<a class="text-link" href="#aula">Ver uma aula por dentro <span aria-hidden="true">↓</span></a>
</div>
<div class="requirements">
<p>
  Para crianças de 9 a 14 anos que já conseguem ler e usar mouse e teclado com autonomia.
</p>
<p>
  É necessário um computador com internet.
</p>
</div>
</div>
<figure class="visual generated">
  <a href={img('preview-estudio.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Ilustração de blocos de comandos ao lado de um jogo de nave">
    <img src={img('preview-estudio.webp')} alt="Ilustração de blocos de comandos ao lado de um jogo de nave" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="high" />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>Uma ideia ganha regras, personagens e um jogo para experimentar.</figcaption>
</figure>
</div>
</section>
{!posDesafio ? (<> <section class="section tint" id="aprendizado" aria-labelledby="title-aprendizado">
<div class="wrap">
<h2 id="title-aprendizado">O jogo que seu filho te mostra conta só uma parte da história</h2>
<div class="story-row">
<div class="prose">
<p>
  Essa história pode começar numa conversa que vocês já têm em casa. Se seu filho gosta de jogos,
  talvez você já tenha ouvido uma ideia dele sobre uma fase: um personagem que poderia ter outro
  poder, um obstáculo que ele mudaria de lugar ou um final que imaginou diferente. Um comentário
  desses pode dar a vocês algo para explorar juntos.
</p>
<p>
  Você pode convidar seu filho a escolher uma dessas ideias e imaginar como ela funcionaria. Pense
  numa nave que atira em asteroides: a nave atiraria o tempo todo ou só quando o jogador apertasse
  uma tecla? Ao conversar sobre isso, seu filho começa a decidir como seria o jogo que tem em mente.
</p>
<p>
  Daí vem o convite para aprender a construir uma pequena versão desse jogo. Seu filho pode começar
  com uma montagem guiada, conhecer os comandos e descobrir como fazer a nave atirar ao apertar uma
  tecla. Entender essa primeira regra dá uma base para montar outras regras do jogo.
</p>
<p>
  Se você procura uma atividade que aproveite esse interesse para aprender, essa passagem faz
  diferença. Seu filho tem algo que quer ver acontecer na tela e um motivo para descobrir como
  fazer. O jogo que ele mostra depois carrega a história dessas tentativas.
</p>
</div>
<figure class="visual">
  <a href={img('ilustra-virada.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Personagens ilustrados imaginando uma criação">
    <img src={img('ilustra-virada.webp')} alt="Personagens ilustrados imaginando uma criação" width="1100" height="630" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Visão ilustrativa da plataforma</span>Uma ideia sobre o jogo pode virar um convite para aprender a criar.</figcaption>
</figure>
</div>
<div class="story-row reverse">
<div class="prose">
<h3>Uma regra pequena já pode te mostrar o que ele está aprendendo</h3>
<p>
  Naquele jogo de nave, seu filho pode querer que cada asteroide atingido valha um ponto. Para isso,
  precisa montar os comandos que fazem o jogo reconhecer o acerto, somar um ponto e mostrar o total.
  Organizar essa relação exercita o raciocínio lógico: o ponto só deve ser somado quando o tiro
  acerta o asteroide. Ao testar o jogo, seu filho consegue ver se a regra produziu o resultado que
  imaginou.
</p>
<p>
  Só que o teste pode trazer uma surpresa: o asteroide desaparece, mas o placar continua em zero. O
  ponto foi somado? O placar está mostrando o valor certo? Conferir uma parte por vez dá uma direção
  para a tentativa seguinte. É assim que a resolução de problemas entra no que ele está fazendo:
  procurar uma causa, testar uma mudança e observar se resolveu.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-regra.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Ilustração de um acerto no asteroide e da mudança de zero para um ponto">
    <img src={img('preview-regra.webp')} alt="Ilustração de um acerto no asteroide e da mudança de zero para um ponto" width="1536" height="1024" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>O tiro acerta, o jogo soma um ponto e o placar mostra o total. Exemplo ilustrativo de uma regra.</figcaption>
</figure>
</div>
<div class="argument-close">
<p>
  Quando os pontos começam a aparecer, outra ideia pode surgir: deixar a partida mais desafiadora.
  Seu filho poderia fazer os asteroides andarem mais rápido ou aparecerem com mais frequência.
  Imaginar essas alternativas trabalha a criatividade. Escolher uma delas e experimentar acrescenta
  uma pergunta importante: ficou bom de jogar?
</p>
<p>
  Se os asteroides ficarem rápidos demais, seu filho pode reduzir a velocidade e testar a partida de
  novo. Ao propor uma melhoria, colocá-la no jogo e avaliar como ficou a partida, pratica um jeito
  de inovar. O teste que deixou o jogo difícil demais também ensina algo sobre o ajuste seguinte.
  Lidar com o erro ganha uma razão que seu filho entende: continuar trabalhando no jogo que quer
  fazer funcionar.
</p>
<p>
  Você pode perceber um pedaço desse aprendizado quando seu filho conta que a fase estava difícil,
  mostra o que mudou e convida você a testar a nova versão do jogo. A conversa parte de uma mudança
  que ele fez e consegue apontar na tela. O jogo pronto também dá a vocês um motivo para reconhecer
  o esforço das tentativas anteriores.
</p>
</div>
</div>
</section> </>) : (<> <section class="section tint" id="continuidade">
<div class="wrap">
<h2>Talvez ele já tenha te contado o que mudaria no jogo</h2>
<div class="story-row">
<div class="prose">
<p>
  Uma regra que seu filho conseguiu montar dá uma base para novas experiências. Ele pode se
  perguntar o que aconteceria com outra escolha e desenvolver uma nova versão. Quem ainda está
  montando pode continuar a etapa começada; quem já terminou pode querer usar o que aprendeu em
  outro projeto.
</p>
<p>
  Se seu filho começou pelo Desafio do Primeiro Jogo, a assinatura permite continuar do ponto em que
  está. Ele pode concluir as etapas que faltam e conhecer os projetos disponíveis para sua etapa,
  sem reiniciar o percurso.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-regra.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Ilustração da mudança de uma regra de pontuação">
    <img src={img('preview-regra.webp')} alt="Ilustração da mudança de uma regra de pontuação" width="1536" height="1024" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>Mudar uma regra e testar a partida pode abrir uma nova possibilidade para o jogo.</figcaption>
</figure>
</div>
</div>
</section> </>)}
<section class="section" id="criacao" aria-labelledby="title-criacao">
<div class="wrap">
<h2 id="title-criacao">Se seu filho nunca programou, vamos começar por uma parte do jogo</h2>
<div id="aula" class="anchor-target">
<div class="story-row">
<div class="prose">
<p>
  Talvez, ao imaginar seu filho fazendo tudo isso, você se pergunte por onde ele começaria. Ele
  ainda precisa conhecer os comandos. Por isso, o começo é guiado: uma explicação mostra como montar
  uma parte do jogo, e ele experimenta aquela tarefa antes de seguir.
</p>
<p>
  Na Comunidade dos Criadores, a explicação e o lugar de montar ficam na mesma aula. Seu filho
  acompanha o que fazer, monta aquela parte e testa. Assim, você consegue ver como ele começa, e ele
  tem uma próxima ação para experimentar.
</p>
<p>
  Nas primeiras atividades, ele usa blocos de comandos que encaixa para dizer o que deve acontecer
  no jogo. O computador executa essas instruções, e ele vê o resultado na tela.
</p>
</div>
<figure class="visual">
  <a href={img('print-aula.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Visão ilustrativa de uma aula com explicação, comandos e resultado">
    <img src={img('print-aula.webp')} alt="Visão ilustrativa de uma aula com explicação, comandos e resultado" width="1280" height="720" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Visão ilustrativa da plataforma</span>A explicação e a montagem ficam na mesma aula. Esta imagem representa o formato, não uma gravação de aula.</figcaption>
</figure>
</div>
</div>
<div class="argument-close">
<h3>É justo querer saber se ele entendeu o que montou</h3>
<p>
  Ver o jogo funcionando pode deixar essa dúvida: quanto ele compreendeu e quanto acompanhou do
  exemplo? Na primeira montagem, a orientação mostra como usar um comando e onde ele entra. Quando a
  atividade permite uma alteração, a criança pode comparar o que montou com uma nova versão. Se
  mudar a regra que dá um ponto, por exemplo, o placar deve responder de outra maneira. Prever essa
  diferença e conferir o resultado exige relacionar o comando ao que acontece no jogo.
</p>
<p>
  No exemplo ilustrado acima, a mudança aparece no placar. Durante uma atividade que permita alterar
  a regra, comparar as duas versões do jogo ajuda a entender o efeito da mudança. É o tipo de
  conversa que vocês podem ter sobre o jogo do seu filho: qual era a ideia, o que ele mudou e o que
  aconteceu depois. Nas ferramentas que a Jornada já liberou para ele, seu filho também pode voltar
  ao projeto para experimentar outras versões.
</p>
</div>
<div class="story-row reverse">
<div class="prose">
<h3>Se desenhar não é a praia dele, há outro jeito de começar</h3>
<p>
  Seu filho pode se interessar pelas regras e não querer desenhar cada personagem antes de começar.
  Quando chega a hora de escolher o que aparece no jogo, o Estúdio oferece personagens, objetos e
  cenários prontos para usar.
</p>
<p>
  Assim, seu filho pode concentrar as escolhas no funcionamento do jogo: como o personagem se move,
  qual objetivo o jogador precisa alcançar e quais regras valem durante a partida. Com o personagem
  na tela, seu filho tem onde experimentar os comandos que está conhecendo.
</p>
<p>
  Escolher uma nave pronta resolve a aparência do personagem. Seu filho monta, com a orientação da
  aula, as regras de movimento e as outras ações da nave. Assim, aprende a programar usando um
  desenho que já está disponível.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-estudio.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Ilustração de personagens prontos e montagem das regras de um jogo">
    <img src={img('preview-estudio.webp')} alt="Ilustração de personagens prontos e montagem das regras de um jogo" width="1536" height="1024" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>Com um personagem pronto, seu filho pode se concentrar nas regras do jogo.</figcaption>
</figure>
</div>
<div class="story-row">
<div class="prose">
<h3>Aquele desenho que ele te mostra pode virar um personagem do jogo</h3>
<p>
  Se você reconhece seu filho na criança que vive inventando criaturas ou desenhando mundos, há
  outra possibilidade para explorar. Ele pode imaginar um personagem com uma aparência que não
  encontrou entre os elementos prontos e querer colocá-lo na própria criação.
</p>
<p>
  Para isso, ele encontra o Pinta, uma ferramenta de desenho feita para crianças. Seu filho pode
  desenhar ali o personagem que imaginou e levá-lo ao Estúdio para usar no jogo. Também pode criar
  objetos e cenários.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-pinta.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Ilustração do mesmo desenho de nave no Pinta e dentro do jogo">
    <img src={img('preview-pinta.webp')} alt="Ilustração do mesmo desenho de nave no Pinta e dentro do jogo" width="1536" height="1024" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>Desenhar o personagem, levá-lo ao Estúdio e experimentar como ele fica na partida.</figcaption>
</figure>
</div>
<div class="argument-close">
<p>
  Ao colocar o personagem que desenhou no cenário do jogo, seu filho encontra novas decisões: a cor
  do personagem permite enxergá-lo sobre o fundo? O personagem ficou grande demais para a fase? Seu
  filho pode ajustar o desenho no Pinta e testar de novo no jogo. Quando o personagem aparece na
  partida, ele reconhece o desenho que fez participando da brincadeira.
</p>
<p>
  Seu filho também pode usar um cenário pronto e desenhar apenas o personagem. Quem gosta de
  desenhar tem espaço para criar a aparência do jogo; quem prefere montar as regras pode usar os
  desenhos disponíveis.
</p>
<p>
  Nas aulas, a criança usa as ferramentas previstas para aquela atividade. O uso livre do Estúdio e
  do Pinta é liberado ao alcançar o posto Construtor, depois de concluir o curso obrigatório de
  entrada e publicar seu projeto.
</p>
</div>

</div>
</section>
<section class="section tint" id="relatos" aria-labelledby="title-relatos">
<div class="wrap">
<h2 id="title-relatos">A Débora chamou a mãe para ver. O Rafael quis que um amigo jogasse</h2>
<p class="section-intro">
  A Débora quis mostrar o jogo para a mãe, e o Rafael enviou o link para um amigo jogar. Os dois,
  junto com o André, testaram a plataforma antes do lançamento. Estas são as falas deles sobre o que
  fizeram.
</p>
<div class="testimonials">
<figure class="testimonial"><img src={img('depo-rafael.webp')} alt="Rafael" width="160" height="160" loading="lazy" decoding="async" />
<blockquote>
<p class="quote">
  “Fiz uma nave que atira nos asteroides e marca ponto. No fim eu peguei o link e mandei pro meu
  amigo jogar.”
</p>
</blockquote>
<figcaption><strong>Rafael</strong><span>Publicou o primeiro jogo</span>
</figcaption>
</figure>
<figure class="testimonial"><img src={img('depo-debora.webp')} alt="Débora" width="160" height="160" loading="lazy" decoding="async" />
<blockquote>
<p class="quote">
  “Achei que ia ser difícil, mas fui montando os bloquinhos e deu certo. No terceiro dia chamei a
  minha mãe pra ver o meu jogo.”
</p>
</blockquote>
<figcaption><strong>Débora</strong><span>Publicou o primeiro jogo</span>
</figcaption>
</figure>
<figure class="testimonial"><img src={img('depo-andre.webp')} alt="André" width="160" height="160" loading="lazy" decoding="async" />
<blockquote>
<p class="quote">
  “Eu já jogava um monte, agora eu faço os meus jogos. Esse foi o primeiro e já quero fazer um
  maior.”
</p>
</blockquote>
<figcaption><strong>André</strong><span>Filho dos criadores da plataforma</span>
</figcaption>
</figure>
</div>
<div class="section-action"><a class="action" href="#planos">Escolher um plano para meu filho</a>
</div>
</div>
</section>
<section class="section" id="jornada" aria-labelledby="title-jornada">
<div class="wrap">
<h2 id="title-jornada">Seu filho pode querer mudar o jogo logo depois de te mostrar</h2>
<div class="story-row">
<div class="prose">
<p>
  Ao ver alguém jogando, ele pode ter vontade de mudar o personagem, ajustar a dificuldade ou
  experimentar outra regra. Nas ferramentas que já liberou, pode voltar ao projeto e trabalhar
  nessas ideias. A nave que aprendeu a movimentar pode ganhar outra aparência; uma partida pode
  receber um desafio diferente. O que já construiu vira material para uma nova tentativa.
</p>
<p>
  Para encontrar de onde continuar, seu filho consulta a Jornada do Criador, o mapa dos cursos e das
  ferramentas que vai liberando. Ali ele vê o ponto em que está e quais etapas estão disponíveis.
  Pode seguir para outro projeto ou voltar a uma criação nas ferramentas que já tem abertas.
</p>
<p>
  A plataforma está em lançamento. A assinatura dá acesso aos cursos publicados e aos que forem
  adicionados durante o período contratado. Algumas ferramentas dependem do progresso e da
  publicação dos cursos necessários para chegar até elas.
</p>
</div>
<figure class="visual">
  <a href={img('print-jornada.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Visão ilustrativa do mapa da Jornada do Criador">
    <img src={img('print-jornada.webp')} alt="Visão ilustrativa do mapa da Jornada do Criador" width="1280" height="720" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Visão ilustrativa da plataforma</span>A Jornada organiza as etapas. A liberação depende do progresso e dos cursos publicados.</figcaption>
</figure>
</div>
<div class="support-note"><span class="material-symbols-rounded" aria-hidden="true">chat_bubble</span>
<div>
<h3>Se ele travar numa parte, pode contar onde ficou a dúvida</h3>
<p>
  Nos Recados, o canal de mensagens com a equipe dentro da plataforma, seu filho pode explicar o que
  está tentando fazer e onde encontrou dificuldade.
</p>
</div>
</div>
<div class="story-row reverse">
<div class="prose">
<h3>Você pode abrir o jogo dele e entrar na brincadeira</h3>
<p>
  Quando seu filho publica o jogo no Mural dos Criadores, recebe um link para compartilhar. Você
  abre esse link para jogar e pode pedir que seu filho mostre a parte que ele mais gostou de criar.
  Talvez seja a nave que desenhou; talvez seja a regra que deu trabalho até funcionar. A conversa
  nasce do jogo que vocês estão experimentando juntos.
</p>
</div>
<figure class="visual">
  <a href={img('print-mural.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Visão ilustrativa de jogos publicados no Mural">
    <img src={img('print-mural.webp')} alt="Visão ilustrativa de jogos publicados no Mural" width="1280" height="720" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Visão ilustrativa da plataforma</span>Depois de publicar, seu filho pode compartilhar o link do jogo.</figcaption>
</figure>
</div>
<div class="story-row">
<div class="prose">
<h3>Ele pode querer conversar sobre o jogo antes de terminar</h3>
<p>
  Às vezes, seu filho quer contar que está tentando fazer uma fase diferente ou mostrar o personagem
  que acabou de desenhar. No Clube, ele pode publicar essa ideia e conversar sobre a criação. As
  mensagens são verificadas antes de aparecer para as outras crianças.
</p>
<p>
  Se ele gosta de escolher como é representado, o Meu Espaço permite personalizar seu avatar, o
  personagem do perfil, e seu quarto virtual. Ali também ficam as conquistas registradas durante o
  uso. É um lugar que ele pode arrumar do próprio jeito e reconhecer como seu.
</p>
</div>
<figure class="visual">
  <a href={img('print-clube.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Visão ilustrativa do espaço de conversa sobre criações">
    <img src={img('print-clube.webp')} alt="Visão ilustrativa do espaço de conversa sobre criações" width="1280" height="720" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Visão ilustrativa da plataforma</span>No Clube, as mensagens passam por moderação antes de aparecer.</figcaption>
</figure>
</div>
</div>
</section>
<section class="section tint" id="familia" aria-labelledby="title-familia">
<div class="wrap">
<h2 id="title-familia">A gente também começou procurando um caminho para o nosso filho</h2>
<div class="story-row reverse">
<div class="prose"><!-- historia-andre:inicio -->
<p>
  Quando nosso filho André tinha sete anos, estávamos aprendendo a cuidar do equilíbrio na rotina
  dele. O André é autista nível 1 e tem hiperfoco em jogos. Esse interesse fazia parte da nossa vida
  em casa, e percebemos uma possibilidade de explorá-lo juntos: começar a criar jogos.
</p>
<!-- historia-andre:fim -->
<p>
  A gente é a Helena e o Júlio. Somos desenvolvedores de sistemas, formados em Sistemas de
  Informação, com mais de dez anos de experiência e passagem por lugares como o Banco do Brasil.
  Programar já fazia parte do nosso trabalho; criar com o André nos permitiu levar essa experiência
  para uma atividade em família.
</p>
<p>
  Ele passou a nos chamar para testar suas regras, explicar escolhas e imaginar a próxima versão.
  Foi dessa experiência que nasceu a Comunidade dos Criadores. Hoje, aos 12 anos, o André também é a
  voz do Zappy nas aulas.
</p>
<p>
  Essa experiência nos levou a preparar um começo guiado para outras crianças, em português, com
  ferramentas para montar os jogos e um jeito de mostrá-los à família. Foi o que aprendemos em casa
  que nos fez querer construir esse lugar. Seu filho pode chegar com outros interesses e descobrir
  nas atividades o que tem vontade de criar.
</p>
</div>
<figure class="family-photo"><img src={img('familia-helena-julio-kids.webp')} alt="Helena, Júlio e seus filhos" width="880" height="1019" loading="lazy" decoding="async" />
<figcaption>Helena, Júlio e família. A experiência que deu origem à Comunidade.</figcaption>
</figure>
</div>
</div>
</section>
<section class="section" id="rotina" aria-labelledby="title-rotina">
<div class="wrap">
<h2 id="title-rotina">Para funcionar aí na sua casa, essa atividade precisa caber na vida de vocês</h2>
<div class="section-intro">
<p>
  Talvez você tenha gostado da ideia e esteja pensando em como ela entraria numa semana comum. Seu
  filho pode precisar de companhia no começo, vocês têm horários para cumprir e já existem
  combinados sobre o computador. Essas questões também fazem parte da escolha.
</p>
</div>
<div class="objections">
<div class="objection">
<h3>Você pode estar perto sem assumir o papel de professor</h3>
<p>
  Você pode ajudar no acesso, combinar um momento para a atividade e ouvir o que seu filho quer
  mostrar. A explicação de programação está nas aulas, e as dúvidas podem ser enviadas pelos
  Recados. Algumas crianças precisam de mais companhia nas primeiras etapas; vocês vão percebendo
  isso no uso.
</p>
</div>
<div class="objection">
<h3>Os combinados sobre a tela continuam nas mãos de vocês</h3>
<p>
  Vocês podem reservar uma parte do tempo de tela já combinado para criar o jogo. Escolham uma etapa
  e um horário para parar, mantendo espaço para descanso, movimento e outras brincadeiras. Aprender
  a criar entra nesses combinados da família; não exige deixar de cuidar deles.
</p>
</div>
<div class="objection">
<h3>A inteligência artificial pode ajudar. Seu filho ainda tem decisões para aprender a tomar</h3>
<p>
  Talvez você se pergunte por que aprender programação se uma inteligência artificial já escreve
  código. Pense numa regra que seu filho quer para o jogo: o jogador ganha um ponto quando o
  personagem pega um objeto. Seu filho precisa explicar essa regra à ferramenta. Se a ferramenta
  gerar um jogo que soma pontos antes de o personagem pegar o objeto, seu filho precisa perceber que
  o resultado está diferente do que pediu.
</p>
<p>
  Ao montar e testar essas regras, ele pratica justamente esse entendimento. Uma ferramenta pode
  ajudar a produzir o jogo, e saber como ele funciona dá ao seu filho mais condições de dizer o que
  quer mudar e conferir o resultado.
</p>
</div>
<div class="objection">
<h3>Você pode conhecer a atividade com ele antes de assumir um compromisso maior</h3>
<p>
  Gostar de jogar pode despertar curiosidade pela criação. Olhar juntos os exemplos da página ajuda
  a conversar sobre essa outra atividade: ele gostaria de montar uma regra, desenhar um personagem
  ou experimentar uma ideia? Você pode perguntar qual dessas ideias ele teria vontade de
  experimentar. Essa conversa ajuda vocês a perceber o interesse antes de contratar.
</p>
<p>
  Para conhecer a rotina de uso, o mensal exige um compromisso inicial menor que o anual. A garantia
  e as condições de renovação estão junto dos planos abaixo.
</p>
</div>
</div>
</div>
</section>
<section class="section tint" id="assinatura" aria-labelledby="title-assinatura">
<div class="wrap">
<h2 id="title-assinatura">Por {mensalLabel} ao mês, você oferece esse caminho de criação ao seu filho</h2>
<div class="value-story">
<p>
  Quando chegar o momento que vocês reservaram para criar, seu filho encontra uma aula para
  acompanhar e o projeto em que vai trabalhar. Pode montar as regras, testar o jogo e, nas
  ferramentas liberadas, desenhar e experimentar outras versões. Ao publicar, recebe um link para
  mostrar o resultado.
</p>
<p>
  É esse conjunto que a assinatura da Comunidade oferece: aulas que mostram o que fazer, ferramentas
  para criar e um lugar para guardar e publicar os projetos. Você tem por onde começar com ele,
  acompanha o que está construindo e não precisa preparar as aulas de programação. Se surgir uma
  dúvida, ele pode enviá-la pelos Recados.
</p>
<p>
  Ferramentas e tutoriais gratuitos também permitem aprender e criar. A escolha pela assinatura faz
  sentido quando sua família quer esse percurso reunido, com os projetos guiados e os espaços de
  criação no mesmo ambiente. As aulas de entrada apresentam a criação por partes; a Jornada organiza
  a continuidade conforme os cursos são publicados.
</p>
<p>
  A assinatura permite até dois perfis de criança, cada um com seu próprio progresso e projetos. Se
  os dois filhos estão na faixa atendida, podem participar com o mesmo plano e avançar no próprio
  ritmo.
</p>
<p>
  As aulas não têm horário marcado: vocês escolhem quando acessar e podem retomar a atividade em
  outro momento. O formato não inclui encontros ao vivo.
</p>
</div>
<div class="plans" id="planos">
<article class="plan">
<h3>Plano mensal</h3>
<p class="price">{mensalLabel}<span>por mês</span>
</p>
<p>
  Renovação automática no cartão. Você pode cancelar a próxima renovação pela sua área, e o acesso
  continua até o fim do período pago.
</p><button type="button" class="action" data-checkout-cta data-checkout-oferta={mensal?.slug}>Escolher o plano mensal</button>
</article>
<article class="plan annual">{economiaCents > 0 && <p class="saving">
  Economia de {economiaLabel} em 12 meses
</p>}<h3>Plano anual</h3>
<p class="price">{anualLabel}<span>por 12 meses</span>
</p>
<p class="equivalent">
  Equivale a {anualPorMesLabel} por mês.
</p>{economiaCents > 0 && <p>
  Comparado a {anualAncoraLabel} por 12 mensalidades.
</p>}<p>
  Pix à vista ou cobrança anual recorrente no cartão. No Pix, é necessário contratar novamente após
  12 meses. No cartão, você pode cancelar a próxima renovação pela sua área.
</p><button type="button" class="action" data-checkout-cta data-checkout-oferta={anual?.slug}>Escolher o plano anual</button>
</article>
</div>
<div class="guarantee"><span class="material-symbols-rounded" aria-hidden="true">verified_user</span>
<div>
<h3>Sete dias para conhecer a experiência</h3>
<p>Na contratação, você tem sete dias para solicitar o reembolso integral pelo canal indicado nos <a href="/kids/termos" class="text-link">termos da assinatura</a>. Depois desse prazo, o cancelamento da renovação impede as próximas cobranças, e o acesso continua até o fim do período já pago.</p>
<p>
  A garantia vale para a contratação inicial e para cada nova contratação anual via Pix. As
  renovações automáticas no cartão seguem as condições dos termos.
</p>
</div>
</div>
</div>
</section>
<section class="section" id="duvidas" aria-labelledby="title-duvidas">
<div class="wrap">
<h2 id="title-duvidas">Sua decisão também depende do que acontece depois da compra</h2>
<div class="faq">
<details>
<summary>As ferramentas ficam todas abertas no primeiro acesso?</summary>
<div>
<p>
  Nas aulas, a criança usa os recursos previstos para a etapa. O uso livre das ferramentas acompanha
  a Jornada: Estúdio e Pinta no posto Construtor; Pensa, para organizar o projeto, e o assistente de
  inteligência artificial Zappy no Inventor; Molda, a ferramenta de criação em 3D, no Explorador de
  Mundos. Algumas liberações dependem de cursos que ainda serão publicados. A assinatura inclui as
  ferramentas, sem compra adicional para liberá-las.
</p>
</div>
</details>
<details>
<summary>Meu filho já fez o Desafio. Ele precisa repetir?</summary>
<div>
<p>
  Ele pode continuar do ponto em que está. Se ainda falta concluir uma etapa ou publicar o projeto
  necessário para avançar, a Jornada orienta esse próximo passo.
</p>
</div>
</details>
<details>
<summary>Posso cadastrar irmãos?</summary>
<div>
<p>
  Sim. A assinatura permite até dois perfis de criança, cada um com seu próprio progresso e seus
  projetos.
</p>
</div>
</details>
<details>
<summary>Preciso instalar algum programa?</summary>
<div>
<p>
  As atividades e ferramentas abrem no navegador do computador. É necessário acesso à internet e uso
  de mouse e teclado.
</p>
</div>
</details>
<details>
<summary>Como funciona a participação no Clube?</summary>
<div>
<p>
  As mensagens passam por moderação antes de aparecer. O perfil público começa desligado, e você
  administra os perfis pela área do responsável.
</p>
</div>
</details>
<details>
<summary>Como faço para cancelar?</summary>
<div>
<p>
  Na área do responsável, em Minhas compras, você pode cancelar a próxima renovação. O acesso
  continua até o fim do período pago. Para pedir o reembolso dentro da garantia, use o canal
  indicado nos termos, informando o e-mail da compra.
</p>
</div>
</details>
<details>
<summary>A garantia também vale nas renovações?</summary>
<div>
<p>
  Os sete dias valem para a contratação inicial e para cada nova contratação anual paga via Pix. As
  renovações automáticas no cartão seguem as condições dos termos. Cancelar a próxima renovação
  impede novas cobranças; solicitar o reembolso de uma contratação dentro da garantia é outro
  procedimento.
</p>
</div>
</details>
</div>
</div>
</section>
<section class="section tint" id="convite" aria-labelledby="title-convite">
<div class="wrap">
<h2 id="title-convite">Você pode entrar na brincadeira que seu filho aprendeu a criar</h2>
<div class="story-row">
<div class="prose">
<p>
  Seu filho pode convidar você para jogar o jogo que criou e apontar o personagem que desenhou. Pode
  mostrar a fase que estava difícil e contar como decidiu ajustá-la. Enquanto vocês experimentam o
  jogo, surge uma conversa sobre o que ele fez, tentou e conseguiu resolver.
</p>
<p>
  Na Comunidade, essa experiência começa por um projeto guiado e continua nas possibilidades que ele
  vai aprendendo a usar. Escolha o plano e, no primeiro acesso, abram juntos a atividade de entrada.
  Se ele já começou pelo Desafio, continuem do ponto em que está.
</p><a class="action" href="#planos">Escolher um plano para meu filho</a>
</div>
<figure class="visual">
  <a href={img('ilustra-vitoria.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem: Ilustração de uma criança mostrando a sua criação">
    <img src={img('ilustra-vitoria.webp')} alt="Ilustração de uma criança mostrando a sua criação" width="1000" height="943" loading="lazy" decoding="async"  />
  </a>
  <figcaption><span class="visual-label">Visão ilustrativa da plataforma</span>Um jogo para experimentar juntos e uma história de criação para seu filho contar.</figcaption>
</figure>
</div>
</div>
</section>
</main>
</div>
<Footer audience={f.audience} vitalicio={f.lifetimeAccess} />
<PreCheckoutModal client:idle basePath={f.basePath} funnel={f.key} />
</BaseLayout>

<style>
