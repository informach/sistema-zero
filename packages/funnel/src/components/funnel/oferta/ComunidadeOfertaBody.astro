---
// Página de vendas da "Comunidade dos Criadores" (funil kids, ASSINATURA
// mensal/anual). Layout PRÓPRIO alinhado à paleta Pen da Comunidade Kids
// (chão azul-acinzentado, ação azul, Baloo 2/Nunito e relevo 3D), estrutura 8D em
// 19 blocos. O CSS sob medida vive no `<style>` escopado abaixo, sob `.cdc`
// (tokens no wrapper, não no :root). Os CTAs de compra levam `data-checkout-cta`
// → PreCheckoutModal; os CTAs de PLANO levam também `data-checkout-oferta`
// (slug da oferta mensal/anual) → o modal anexa `?oferta=` e o checkout
// pré-seleciona o plano. Copy segue o Light Copy (sem travessão, sem "!",
// sem "Não é X. É Y.", depoimentos reais, bônus ancorados).
import '@fontsource/material-symbols-rounded/400.css'
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { formatBRLFromCents } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 97,00" (não usado aqui; a página trabalha com os planos). */
  priceLabel: string
  /** "R$ 97" (fallback de exibição da oferta principal). */
  priceLabelShort: string
  /** "97.00" (JSON-LD — preço da oferta PRINCIPAL da env). */
  priceReais: string
  imagesBase: string
  /** Repassados pela rota; esta oferta padrão não os renderiza. */
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  /** Planos da assinatura (principal + irmã do alternador). null = catálogo fora. */
  plans: OfferPlans | null
}
const { f, productName, priceReais, imagesBase, ofertaUrl, plans } = Astro.props

const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`

// Normaliza mensal/anual por INTERVALO (sem assumir qual é a principal da env).
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)

// Preços de exibição com fallback PRÓPRIO (o da rota é o do NCI — R$ 37, errado
// aqui). Catálogo fora do ar → mostra os preços de tabela e os CTAs seguem
// funcionando sem pré-seleção de plano.
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
const mensalLabel = formatBRLFromCents(mensalCents) // "R$ 97"
const anualLabel = formatBRLFromCents(anualCents) // "R$ 797"
const anualPorMesLabel = formatBRLFromCents(Math.round(anualCents / 12)) // "R$ 66"
const anualAncoraLabel = formatBRLFromCents(mensalCents * 12) // "R$ 1.164"
const economiaLabel = formatBRLFromCents(mensalCents * 12 - anualCents) // "R$ 367"
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('checkout-capa.webp')}
  />
  <link slot="head" rel="preload" as="image" href={img('hero.webp')} fetchpriority="high" />

  <div class="cdc">
    <!-- ===== TOPO FIXO ===== -->
    <header class="topbar">
      <div class="wrap nav">
        <div class="logo">
          <span class="badge"><span class="material-symbols-rounded">stadia_controller</span></span>
          Comunidade dos Criadores
        </div>
        <div class="price-mini">{mensalLabel}/mês</div>
        <a href="#planos" class="btn header-cta">
          <span class="material-symbols-rounded">bolt</span><span class="lbl">Quero assinar</span>
        </a>
      </div>
    </header>

    <!-- ===== BLOCO 01 · HERO ===== -->
    <section class="hero sec">
      {/* Deco só do lado da ARTE: a estrela que ficava à esquerda caía em cima
          da headline e atrapalhava a leitura (feedback da usuária). */}
      <svg
        class="deco float slow rev"
        style="top:22%;right:6%;width:34px"
        viewBox="0 0 24 24"
        fill="var(--sz-community-pink-light)"
        aria-hidden="true"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <div class="blob" style="width:220px;height:220px;background:var(--sz-community-ground-alt);top:-40px;right:-40px">
      </div>
      <div class="blob" style="width:160px;height:160px;background:var(--sz-community-mint);bottom:20px;left:-50px">
      </div>
      <div class="wrap">
        <div class="grid">
          <div class="hero-copy">
            <span class="eyebrow"
              >Para crianças de 9 a 14 anos<br />que gostam de jogos e tecnologia</span
            >
            <h1>
              Seu filho já passa horas envolvido com jogos. Na Comunidade, ele pode usar uma parte
              desse tempo para <span class="hl">criar os próprios jogos.</span>
            </h1>
            <p class="lead">
              A Comunidade dos Criadores é uma jornada online em que a criança aprende a planejar,
              construir, testar e publicar jogos, com projetos guiados, ferramentas próprias,
              acompanhamento de professor e uma carreira que mostra qual é o próximo passo.
            </p>
            <ul class="hero-bullets">
              <li>
                <span class="tick"><span class="material-symbols-rounded">check</span></span>Cursos e
                projetos organizados para cada etapa da criança
              </li>
              <li>
                <span class="tick"><span class="material-symbols-rounded">check</span></span>Ele
                cria, publica e compartilha jogos com um link de verdade
              </li>
              <li>
                <span class="tick"><span class="material-symbols-rounded">check</span></span>A cada
                conquista, a Carreira do Criador mostra o próximo passo
              </li>
            </ul>
            <div class="hero-cta">
              <a href="#planos" class="btn big">
                <span class="material-symbols-rounded">rocket_launch</span>Quero ver meu filho criando
              </a>
            </div>
            <div class="seals">
              <span><span class="material-symbols-rounded">check_circle</span>Acesso na hora</span>
              <span
                ><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span
              >
              <span
                ><span class="material-symbols-rounded">check_circle</span>Cancele quando quiser</span
              >
            </div>
          </div>
          <figure class="art hero-art">
            <div class="glow"></div>
            <img
              src={img('hero.webp')}
              alt="Criança apontando orgulhosa para o jogo que ela mesma criou, com o vagalume Zappy comemorando ao lado"
              width="940"
              height="1366"
              fetchpriority="high"
            />
          </figure>
        </div>
        <!-- fala do Zappy pra criança (mesmo registro lúdico do Desafio) -->
        <div class="kid reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('zappy-fala.webp')}
                alt="Zappy, o vagalume da Comunidade dos Criadores"
                width="360"
                height="458"
                loading="lazy"
              />
            </figure>
            <span class="name">Zappy</span>
          </div>
          <div class="bubble">
            Oi, sou o Zappy. Aqui você começa com um jogo e libera novos projetos e ferramentas
            conforme a sua carreira avança. Quando publicar, pode mandar o link para a família
            inteira jogar. Chama seu pai, sua mãe ou seu responsável para conhecer com você.
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAIXA DE CONFIANÇA ===== -->
    <section class="stats-band">
      <div class="wrap">
        <div class="stats">
          <div class="stat">
            <span class="material-symbols-rounded">verified_user</span>
            <div class="l">Comunidade moderada<br />por gente de verdade</div>
          </div>
          <div class="stat">
            <span class="material-symbols-rounded">devices</span>
            <div class="l">Abre no navegador,<br />sem instalar nada</div>
          </div>
          <div class="stat">
            <span class="material-symbols-rounded">family_star</span>
            <div class="l">Feito por uma família<br />que viveu essa virada</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 02 · DOR ===== -->
    <section class="sec" id="dor">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Vamos começar pelo que preocupa você</span>
          <h2 class="reveal">
            Mais tempo de tela não é a solução.<br />O ponto é o que acontece durante <span class="hl"
              >uma parte do tempo que já existe.</span
            >
          </h2>
        </div>
        <div class="feat">
          <figure class="art reveal">
            <img
              src={img('ilustra-dor.webp')}
              alt="Criança concentrada na frente do computador, apenas consumindo um jogo"
              width="1000"
              height="577"
              loading="lazy"
            />
          </figure>
          <div class="feat-txt">
            <p>
              Equilíbrio continua sendo importante. Uma atividade não deixa de precisar de limites
              só porque envolve aprendizado.
            </p>
            <p>
              Ao mesmo tempo, jogos e tecnologia já fazem parte da escola, das conversas e do tempo
              livre das crianças. A proposta da Comunidade não é chamar qualquer uso de tela de
              produtivo. É oferecer uma alternativa concreta para uma parte desse tempo.
            </p>
            <p>
              Em vez de apenas entrar em jogos criados por outras pessoas, seu filho também pode
              aprender a criar regras, personagens, desafios e mundos próprios.
            </p>
          </div>
        </div>
        <div class="tese reveal">
          A tela continua pedindo equilíbrio. O que muda aqui é o papel da criança durante uma
          parte dela: de quem recebe tudo pronto para quem toma decisões e constrói um projeto.
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 03 · A VIRADA DE CHAVE ===== -->
    <section class="sec sec-amar" id="virada">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Uma mudança concreta de papel</span>
          <h2 class="reveal">
            O interesse pelos jogos não precisa<br />terminar apenas no <span class="hl2">jogar.</span>
          </h2>
        </div>
        <div class="feat feat-rev">
          <figure class="art reveal">
            <img
              src={img('ilustra-virada.webp')}
              alt="A mesma criança criando o próprio jogo, com blocos coloridos na tela e o Zappy ao lado"
              width="1100"
              height="630"
              loading="lazy"
            />
          </figure>
          <div class="feat-txt">
            <p>
              Quando joga, seu filho entra em um mundo pronto, aprende as regras e tenta vencer
              desafios definidos por outra pessoa.
            </p>
            <p>
              Quando cria, ele escolhe uma ideia, organiza as partes, monta comandos, testa o
              resultado, encontra erros e decide o que precisa mudar.
            </p>
            <div class="tese">
              O jogo continua interessante para a criança. A diferença é que agora existe autoria.
              Ao final de um projeto, ela tem algo que pode abrir, jogar, explicar e compartilhar.
            </div>
            <p style="margin-top:16px;">
              A Comunidade parte de um interesse que já existe e apresenta uma nova possibilidade
              dentro dele. Não substitui os limites da família. Acrescenta um caminho de criação.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 04 · PALIATIVO ===== -->
    <section class="sec" id="paliativo">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">O primeiro jogo é só o começo</span>
          <h2 class="reveal">
            Depois da primeira criação, a criança precisa<br />saber <span class="hl2"
              >o que fazer em seguida.</span
            >
          </h2>
        </div>
        <div class="pal">
          <div class="pal-item reveal">
            <span class="xi"><span class="material-symbols-rounded">sports_esports</span></span>
            <div>
              <h4>O primeiro jogo mostra que é possível</h4>
              <p>
                A criança deixa de imaginar e vê uma criação própria funcionando. Essa primeira
                entrega torna o próximo projeto mais fácil de visualizar.
              </p>
            </div>
          </div>
          <div class="pal-item reveal">
            <span class="xi"><span class="material-symbols-rounded">route</span></span>
            <div>
              <h4>Uma sequência evita a tela em branco</h4>
              <p>
                Em vez de terminar um curso e ficar sem saber para onde ir, ela encontra outro
                projeto com dificuldade compatível com o que já aprendeu.
              </p>
            </div>
          </div>
          <div class="pal-item reveal">
            <span class="xi"><span class="material-symbols-rounded">military_tech</span></span>
            <div>
              <h4>A carreira organiza a continuidade</h4>
              <p>
                Cursos, projetos, ferramentas e conquistas aparecem em uma ordem clara. A criança
                enxerga o que concluiu e qual é o próximo passo.
              </p>
            </div>
          </div>
        </div>
        <div class="tese reveal">
          Um curso isolado pode ensinar um projeto. A Comunidade organiza uma jornada para que a
          primeira criação encontre uma próxima etapa.
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 05 · PROVA SOCIAL 1 (crianças reais) ===== -->
    <section class="sec sec-verde" id="prova">
      <div class="wrap center">
        <span class="eyebrow">Projetos que podem ser vistos e jogados</span>
        <h2 class="reveal">Quando a ideia sai da cabeça<br />e começa a <span class="hl">funcionar</span></h2>
        <p class="sub">
          Estes relatos falam de resultados observáveis: montar, testar, publicar e mostrar uma
          criação própria.
        </p>
        <div class="depo-grid">
          <div class="depo reveal">
            <div class="stars">★★★★★</div>
            <p class="quote">
              "Fiz uma nave que atira nos asteroides e marca ponto. No fim eu peguei o link e mandei
              pro meu amigo jogar."
            </p>
            <div class="who">
              <span class="av"
                ><img
                  src={img('depo-rafael.webp')}
                  alt="Rafael"
                  width="160"
                  height="160"
                  loading="lazy"
                /></span
              >
              <span class="who-name">Rafael<small>criou e publicou o próprio jogo</small></span>
            </div>
          </div>
          <div class="depo reveal">
            <div class="stars">★★★★★</div>
            <p class="quote">
              "Achei que ia ser difícil, mas fui montando os bloquinhos e deu certo. No terceiro dia
              chamei a minha mãe pra ver o meu jogo."
            </p>
            <div class="who">
              <span class="av"
                ><img
                  src={img('depo-debora.webp')}
                  alt="Débora"
                  width="160"
                  height="160"
                  loading="lazy"
                /></span
              >
              <span class="who-name">Débora<small>criou e publicou o próprio jogo</small></span>
            </div>
          </div>
          <div class="depo reveal">
            <div class="stars">★★★★★</div>
            <p class="quote">
              "Eu já jogava um monte, agora eu faço os meus jogos. Esse foi o primeiro e já quero
              fazer um maior."
            </p>
            <div class="who">
              <span class="av"
                ><img
                  src={img('depo-andre.webp')}
                  alt="André"
                  width="160"
                  height="160"
                  loading="lazy"
                /></span
              >
              <span class="who-name">André<small>criou e publicou o próprio jogo</small></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 06 · CTA INTERMEDIÁRIO ===== -->
    <section class="sec sec-slim">
      <div class="wrap">
        <div class="ctaband reveal">
          <h3>O primeiro jogo pode ser uma conquista. A Comunidade mostra o caminho depois dele.</h3>
          <a href="#metodo" class="btn big">
            <span class="material-symbols-rounded">visibility</span>Quero conhecer por dentro
          </a>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 07 · MÉTODO Z.E.R.O. + CARREIRA ===== -->
    <section class="sec sec-tint" id="metodo">
      <div class="wrap">
        <div class="center">
          <span class="eyebrow">Como a continuidade funciona</span>
          <h2 class="reveal">
            Um projeto de cada vez, com etapas que ajudam<br />a criança a <span class="hl"
              >tirar a ideia do papel.</span
            >
          </h2>
          <p class="sub">
            O Método Z.E.R.O. organiza cada criação em partes menores, do planejamento à
            publicação. Assim, a criança não precisa começar diante de uma tela em branco.
          </p>
        </div>
        <div class="zero">
          <div class="zstep z1 reveal">
            <div class="zl">Z</div>
            <h4>Zerar a Bagunça</h4>
            <p>
              A ideia solta vira a Carta da Ideia do jogo. Conversando com o Zappy, o projeto começa
              organizado, com começo, meio e fim no papel.
            </p>
          </div>
          <div class="zstep z2 reveal">
            <div class="zl">E</div>
            <h4>Enxergar o Jogo</h4>
            <p>
              Antes de construir, ela vê: as telas desenhadas, o nome, as cores e o ícone. Ela para
              de se perder no meio do caminho.
            </p>
          </div>
          <div class="zstep z3 reveal">
            <div class="zl">R</div>
            <h4>Rodar as Missões</h4>
            <p>
              O jogo grande vira missões pequenas, uma de cada vez, com o professor acompanhando o
              que ela envia.
            </p>
          </div>
          <div class="zstep z4 reveal">
            <div class="zl">O</div>
            <h4>O Grande Lançamento</h4>
            <p>
              Caça aos bugs, um toque final e a publicação com link de verdade pra mandar pra
              família. Uma vitória que fica.
            </p>
          </div>
        </div>
        <div class="zloop reveal">
          Terminou o O, volta pro Z com um jogo mais ambicioso. O ciclo é o mesmo, o desafio é que
          cresce.
        </div>

        <div class="center" style="margin-top:52px;">
          <h2 class="reveal" style="font-size:clamp(1.4rem,2.8vw,2rem);">
            E acima do método, uma jornada: a <span class="hl2">Carreira de Criador</span>
          </h2>
          <p class="sub">
            O Z.E.R.O. organiza o projeto. A Carreira organiza a jornada: cursos concluídos e
            projetos publicados registram o avanço, como as faixas do judô. Cada novo posto libera
            cursos e ferramentas que combinam com o que a criança já aprendeu.
          </p>
        </div>
        <div class="career reveal">
          <span class="lvl-pill" style="--c:var(--sz-community-field)"
            ><span class="material-symbols-rounded">bolt</span>Faísca</span
          >
          <span class="lvl-pill" style="--c:var(--verde)"
            ><span class="material-symbols-rounded">build</span>Construtor</span
          >
          <span class="lvl-pill" style="--c:var(--azul)"
            ><span class="material-symbols-rounded">lightbulb</span>Inventor</span
          >
          <span class="lvl-pill" style="--c:var(--verde)"
            ><span class="material-symbols-rounded">explore</span>Explorador de Mundos</span
          >
          <span class="lvl-pill" style="--c:var(--roxo)"
            ><span class="material-symbols-rounded">swords</span>Mestre dos Jogos</span
          >
          <span class="lvl-pill" style="--c:var(--azul)"
            ><span class="material-symbols-rounded">castle</span>Arquiteto de Mundos</span
          >
          <span class="lvl-pill" style="--c:var(--laranja)"
            ><span class="material-symbols-rounded">auto_awesome</span>Gênio da Criação</span
          >
          <span class="lvl-pill" style="--c:var(--rosa)"
            ><span class="material-symbols-rounded">military_tech</span>Lenda</span
          >
        </div>
        <div class="tese reveal">
          Toda a plataforma faz parte da assinatura. A liberação gradual não esconde uma compra
          extra. Ela apresenta os recursos em uma ordem que acompanha o avanço da criança.
        </div>
        <!-- fala do Dedé pra criança -->
        <div class="kid verde reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('dede-fala.webp')}
                alt="Dedé, personagem da Comunidade dos Criadores"
                width="360"
                height="869"
                loading="lazy"
              />
            </figure>
            <span class="name">Dedé</span>
          </div>
          <div class="bubble">
            Cada aventura que você conclui e cada projeto que publica fazem a sua carreira andar.
            Eu comecei na Faísca e agora tô batalhando pra chegar em Mestre dos Jogos. Qual nome
            você vai dar pro seu primeiro jogo?
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BLOCO 08 · O QUE DESENVOLVE (DECORADOS) ===== -->
    <section class="sec sec-rosa" id="desenvolve">
      <div class="wrap">
        <div class="center">
        <span class="eyebrow">O que acontece durante um projeto</span>
        <h2 class="reveal">
          Criar um jogo exige muito mais<br />do que <span class="hl">apertar botões.</span>
        </h2>
        <p class="sub">
          Enquanto o jogo ganha forma, a criança precisa tomar decisões, testar possibilidades e
          entender a relação entre cada comando e o resultado que aparece na tela.
          </p>
        </div>
        <div class="dev">
          <div class="dev-item reveal">
            <div class="di" style="background:var(--azul)">
              <span class="material-symbols-rounded">account_tree</span>
            </div>
            <h4>Raciocínio lógico</h4>
            <p>
              Relacionar cada comando ao que acontece no jogo e investigar por que algo não
              funcionou como esperado.
            </p>
          </div>
          <div class="dev-item reveal">
            <div class="di" style="background:var(--verde)">
              <span class="material-symbols-rounded">restart_alt</span>
            </div>
            <h4>Resiliência</h4>
            <p>
              Testar uma ideia, observar o resultado, fazer ajustes e tentar novamente quando
              alguma parte não funciona.
            </p>
          </div>
          <div class="dev-item reveal">
            <div class="di" style="background:var(--laranja)">
