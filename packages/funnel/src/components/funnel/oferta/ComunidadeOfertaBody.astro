---
// Copy e composição: docs/plans/2026-09-30-comunidade-copy-leitura-revisada.md.
// Desenho (30/09/2026, "a oficina do criador"): docs/plans/2026-09-30-comunidade-redesenho-visual.md.
// As receitas da identidade kids (botão, carta, eyebrow, chip, ladrilho, banda, moldura de tela)
// vivem em src/styles/kids-oferta.css; aqui fica só o LAYOUT da página, prefixado por `.cdc`.
// As telas `tela-*.webp` são capturas REAIS do kids em staging (scripts/captura-telas-kids.ts).
import '../../../styles/kids-oferta.css'
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { formatBRLFromCents, formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 97,00" (não usado aqui; a página trabalha com os planos). */
  priceLabel: string
  /** "R$ 97" (fallback de exibição da oferta principal). */
  priceLabelShort: string
  /** "97.00" (JSON-LD — preço da oferta PRINCIPAL da env). */
  priceReais: string
  imagesBase: string
  /** Repassados pela rota; esta oferta padrão não os renderiza. */
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  /** Planos da assinatura (principal + irmã do alternador). null = catálogo fora. */
  plans: OfferPlans | null
  /** Origem do link; não comprova conclusão individual do Desafio. */
  origem?: 'desafio' | null
}
const { f, productName, priceReais, imagesBase, ofertaUrl, plans, origem = null } = Astro.props

const posDesafio = origem === 'desafio'
const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`
/** As telas reais têm a versão @2x para telas de alta densidade. */
const tela2x = (file: string) => `${img(file)} 1x, ${img(file.replace('.webp', '@2x.webp'))} 2x`

// Normaliza mensal/anual por INTERVALO (sem assumir qual é a principal da env).
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)

// Preços de exibição com fallback PRÓPRIO (o da rota é o do NCI — R$ 37, errado
// aqui). Catálogo fora do ar → mostra os preços de tabela e os CTAs seguem
// funcionando sem pré-seleção de plano.
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
const mensalLabel = formatBRLFromCents(mensalCents) // "R$ 97"
const anualLabel = formatBRLFromCents(anualCents) // "R$ 797"
const anualPorMesLabel = formatBRLFromCents2(Math.round(anualCents / 12)) // "R$ 66,42"
const anualAncoraLabel = formatBRLFromCents(mensalCents * 12) // "R$ 1.164"
const economiaCents = mensalCents * 12 - anualCents
const economiaLabel = formatBRLFromCents(economiaCents) // "R$ 367"

/** Os oito postos da Jornada do Criador, na ordem, com a arte que o kids usa no mapa. */
const jornada = [
  { slug: 'noob', nome: 'Faísca' },
  { slug: 'coder', nome: 'Construtor(a)' },
  { slug: 'hacker', nome: 'Inventor(a)' },
  { slug: 'explorer', nome: 'Explorador(a) de Mundos' },
  { slug: 'elite', nome: 'Mestre dos Jogos' },
  { slug: 'architect', nome: 'Arquiteto(a) de Mundos' },
  { slug: 'champion', nome: 'Gênio da Criação' },
  { slug: 'god', nome: 'Lenda' },
]
---
<BaseLayout title={f.seoTitle} description={description} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass={f.theme ? `theme-${f.theme}` : undefined}>
<ProductJsonLd slot="head" name={productName} description={description} price={priceReais} url={ofertaUrl} image={img('checkout-capa.webp')} />
<link slot="head" rel="preload" as="image" href={img('tela-aula.webp')} imagesrcset={tela2x('tela-aula.webp')} fetchpriority="high" />
<div class="cdc">
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

<!-- ═══════════════ Topo navy ═══════════════ -->
<header class="topbar">
<div class="wrap nav">
<a class="brand" href="#conteudo" aria-label="Comunidade dos Criadores, início"><img class="logo" src={img('logo-kids-escuro.svg')} alt="Sistema Zero Kids" width="279" height="26" decoding="async" /></a>
<div class="nav-right">
<p class="nav-preco">Assinatura a partir de <strong>{anualPorMesLabel} por mês</strong></p>
<a class="kof-btn kof-btn--compacta" href="#planos">Escolher um plano</a>
</div>
</div>
</header>

<main id="conteudo">

<!-- ═══════════════ 01 · Herói ═══════════════ -->
<section class="hero section" aria-labelledby="hero-title">
<div class="wrap hero-grid">
<div class="hero-copy">
<span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">stadia_controller</span>Comunidade dos Criadores · 9 a 14 anos</span>
{!posDesafio ? (<>
<h1 id="hero-title" class="kof-display">Seu filho aprende a criar <em>os próprios jogos</em></h1>
<p class="kof-lead">
  Um projeto guiado ajuda seu filho a começar. Ele aprende a montar o jogo por partes e a testar as
  ideias que quer colocar no próprio jogo.
</p>
<ul class="hero-benefits">
<li><span class="kof-ladrilho" aria-hidden="true"><span class="material-symbols-rounded">extension</span></span><span>Praticar raciocínio e resolução de problemas ao montar uma regra e testar o resultado.</span></li>
<li><span class="kof-ladrilho kof-ladrilho--rosa" aria-hidden="true"><span class="material-symbols-rounded">brush</span></span><span>Desenhar um personagem ou montar uma fase para o jogo que ele está criando.</span></li>
<li><span class="kof-ladrilho kof-ladrilho--verde" aria-hidden="true"><span class="material-symbols-rounded">sports_esports</span></span><span>Convidar você para jogar o jogo que ele criou.</span></li>
</ul>
</>) : (<>
<h1 id="hero-title" class="kof-display">Seu filho pode continuar <em>o caminho de criar jogos</em></h1>
<p class="kof-lead">
  Projetos guiados e ferramentas de criação para retomar uma etapa ou desenvolver novas versões do
  que ele já começou.
</p>
<ul class="hero-benefits">
<li><span class="kof-ladrilho" aria-hidden="true"><span class="material-symbols-rounded">play_arrow</span></span><span>Continuar de onde parou, aproveitando o progresso do perfil.</span></li>
<li><span class="kof-ladrilho kof-ladrilho--rosa" aria-hidden="true"><span class="material-symbols-rounded">science</span></span><span>Experimentar outras ideias no jogo, com as ferramentas que já liberou.</span></li>
<li><span class="kof-ladrilho kof-ladrilho--verde" aria-hidden="true"><span class="material-symbols-rounded">map</span></span><span>Encontrar na Jornada os projetos disponíveis para sua etapa.</span></li>
</ul>
</>)}
<div class="hero-actions">
<a class="kof-btn kof-btn--grande" href="#planos">{posDesafio ? 'Escolher um plano para continuar' : 'Escolher um plano para meu filho'}</a>
<a class="kof-link" href="#aula">Ver uma aula por dentro <span class="material-symbols-rounded" aria-hidden="true">arrow_downward</span></a>
</div>
<div class="requirements">
<span class="kof-selo"><span class="material-symbols-rounded" aria-hidden="true">check_circle</span>Para crianças de 9 a 14 anos que já conseguem ler e usar mouse e teclado com autonomia.</span>
<span class="kof-selo"><span class="material-symbols-rounded" aria-hidden="true">check_circle</span>É necessário um computador com internet.</span>
</div>
</div>
<div class="hero-visual">
<div class="hero-stage kof-marca">
<span class="kof-decor decor-1" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
<span class="kof-decor kof-decor--rosa decor-2" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
<span class="kof-decor decor-3" aria-hidden="true"><span class="material-symbols-rounded">star</span></span>
<img class="zappy" src={img('zappy-happy.webp')} alt="" width="300" height="300" loading="eager" decoding="async" />
<figure class="kof-tela kof-tela--sombra hero-tela">
<div class="kof-tela__barra" aria-hidden="true"><i></i><i></i><i></i><span class="kof-tela__url">Uma aula da Comunidade</span></div>
<img src={img('tela-aula.webp')} srcset={tela2x('tela-aula.webp')} alt="Tela de uma aula da Comunidade: o Zappy explica, a criança testa a regra no jogo e marca o que descobriu" width="1280" height="860" loading="eager" decoding="async" fetchpriority="high" />
</figure>
<span class="kof-chip kof-chip--verde flutua flutua--1"><span class="material-symbols-rounded" aria-hidden="true">rocket_launch</span>Jogo publicado</span>
<span class="kof-chip flutua flutua--2"><span class="material-symbols-rounded" aria-hidden="true">group</span>Até dois perfis</span>
<img class="dede" src={img('dede-fala.webp')} alt="" width="360" height="869" loading="eager" decoding="async" />
</div>
</div>
</div>
</section>

<!-- ═══════════════ 02 · Argumento (ou continuidade, vindo do Desafio) ═══════════════ -->
{!posDesafio ? (<> <section class="section" id="aprendizado" aria-labelledby="title-aprendizado">
<div class="wrap">
<span class="kof-sobretitulo">Como ele aprende</span>
<h2 id="title-aprendizado" class="kof-display">O jogo que seu filho te mostra conta só uma parte da história</h2>
<div class="story-row kof-reveal">
<div class="prose">
<p>
  Essa história pode começar numa conversa que vocês já têm em casa. Se seu filho gosta de jogos,
  talvez você já tenha ouvido uma ideia dele sobre uma fase: um personagem que poderia ter outro
  poder, um obstáculo que ele mudaria de lugar ou um final que imaginou diferente. Um comentário
  desses pode dar a vocês algo para explorar juntos.
</p>
<p>
  Você pode convidar seu filho a escolher uma dessas ideias e imaginar como ela funcionaria. Pense
  numa nave que atira em asteroides: a nave atiraria o tempo todo ou só quando o jogador apertasse
  uma tecla? Ao conversar sobre isso, seu filho começa a decidir como seria o jogo que tem em mente.
</p>
<p>
  Daí vem o convite para aprender a construir uma pequena versão desse jogo. Seu filho pode começar
  com uma montagem guiada, conhecer os comandos e descobrir como fazer a nave atirar ao apertar uma
  tecla. Entender essa primeira regra dá uma base para montar outras regras do jogo.
</p>
<p>
  Se você procura uma atividade que aproveite esse interesse para aprender, essa passagem faz
  diferença. Seu filho tem algo que quer ver acontecer na tela e um motivo para descobrir como
  fazer. O jogo que ele mostra depois carrega a história dessas tentativas.
</p>
</div>
<figure class="visual arte">
  <img src={img('ilustra-virada.webp')} alt="Ilustração de um menino montando os blocos de um jogo numa tela e o Zappy apontando o jogo rodando na outra" width="1100" height="630" loading="lazy" decoding="async" />
  <figcaption><span class="visual-label">Ilustração</span>Uma ideia sobre o jogo pode virar um convite para aprender a criar.</figcaption>
</figure>
</div>
<div class="story-row reverse kof-reveal">
<div class="prose">
<h3 class="kof-display">Uma regra pequena já pode te mostrar o que ele está aprendendo</h3>
<p>
  Naquele jogo de nave, seu filho pode querer que cada asteroide atingido valha um ponto. Para isso,
  precisa montar os comandos que fazem o jogo reconhecer o acerto, somar um ponto e mostrar o total.
  Organizar essa relação exercita o raciocínio lógico: o ponto só deve ser somado quando o tiro
  acerta o asteroide. Ao testar o jogo, seu filho consegue ver se a regra produziu o resultado que
  imaginou.
</p>
<p>
  Só que o teste pode trazer uma surpresa: o asteroide desaparece, mas o placar continua em zero. O
  ponto foi somado? O placar está mostrando o valor certo? Conferir uma parte por vez dá uma direção
  para a tentativa seguinte. É assim que a resolução de problemas entra no que ele está fazendo:
  procurar uma causa, testar uma mudança e observar se resolveu.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-regra.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem (abre em nova aba): Ilustração de um acerto no asteroide e da mudança de zero para um ponto">
    <img src={img('preview-regra.webp')} alt="Ilustração de um acerto no asteroide e da mudança de zero para um ponto" width="1536" height="1024" loading="lazy" decoding="async" />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>O tiro acerta, o jogo soma um ponto e o placar mostra o total. Exemplo ilustrativo de uma regra.</figcaption>
</figure>
</div>
<div class="fecho kof-carta kof-carta--fio kof-reveal">
<span class="kof-ladrilho kof-ladrilho--amarelo" aria-hidden="true"><span class="material-symbols-rounded">lightbulb</span></span>
<div>
<p>
  Quando os pontos começam a aparecer, outra ideia pode surgir: deixar a partida mais desafiadora.
  Seu filho poderia fazer os asteroides andarem mais rápido ou aparecerem com mais frequência.
  Imaginar essas alternativas trabalha a criatividade. Escolher uma delas e experimentar acrescenta
  uma pergunta importante: ficou bom de jogar?
</p>
<p>
  Se os asteroides ficarem rápidos demais, seu filho pode reduzir a velocidade e testar a partida de
  novo. Ao propor uma melhoria, colocá-la no jogo e avaliar como ficou a partida, pratica um jeito
  de inovar. O teste que deixou o jogo difícil demais também ensina algo sobre o ajuste seguinte.
  Lidar com o erro ganha uma razão que seu filho entende: continuar trabalhando no jogo que quer
  fazer funcionar.
</p>
<p>
  Você pode perceber um pedaço desse aprendizado quando seu filho conta que a fase estava difícil,
  mostra o que mudou e convida você a testar a nova versão do jogo. A conversa parte de uma mudança
  que ele fez e consegue apontar na tela. O jogo pronto também dá a vocês um motivo para reconhecer
  o esforço das tentativas anteriores.
</p>
</div>
</div>
</div>
</section> </>) : (<> <section class="section" id="continuidade" aria-labelledby="title-continuidade">
<div class="wrap">
<span class="kof-sobretitulo">Para quem já começou</span>
<h2 id="title-continuidade" class="kof-display">Talvez ele já tenha te contado o que mudaria no jogo</h2>
<div class="story-row kof-reveal">
<div class="prose">
<p>
  Uma regra que seu filho conseguiu montar dá uma base para novas experiências. Ele pode se
  perguntar o que aconteceria com outra escolha e desenvolver uma nova versão. Quem ainda está
  montando pode continuar a etapa começada; quem já terminou pode querer usar o que aprendeu em
  outro projeto.
</p>
<p>
  Se seu filho começou pelo Desafio do Primeiro Jogo, a assinatura permite continuar do ponto em que
  está. Ele pode concluir as etapas que faltam e conhecer os projetos disponíveis para sua etapa,
  sem reiniciar o percurso.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-regra.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem (abre em nova aba): Ilustração da mudança de uma regra de pontuação">
    <img src={img('preview-regra.webp')} alt="Ilustração da mudança de uma regra de pontuação" width="1536" height="1024" loading="lazy" decoding="async" />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>Mudar uma regra e testar a partida pode abrir uma nova possibilidade para o jogo.</figcaption>
</figure>
</div>
</div>
</section> </>)}

<!-- ═══════════════ 03 · A aula por dentro, o Estúdio e o Pinta ═══════════════ -->
<section class="section" id="criacao" aria-labelledby="title-criacao">
<div class="wrap">
<span class="kof-sobretitulo">A aula por dentro</span>
<h2 id="title-criacao" class="kof-display">Se seu filho nunca programou, vamos começar por uma parte do jogo</h2>
<div id="aula" class="anchor-target">
<div class="story-row kof-reveal">
<div class="prose">
<p>
  Talvez, ao imaginar seu filho fazendo tudo isso, você se pergunte por onde ele começaria. Ele
  ainda precisa conhecer os comandos. Por isso, o começo é guiado: uma explicação mostra como montar
  uma parte do jogo, e ele experimenta aquela tarefa antes de seguir.
</p>
<p>
  Na Comunidade dos Criadores, a explicação e o lugar de montar ficam na mesma aula. Seu filho
  acompanha o que fazer, monta aquela parte e testa. Assim, você consegue ver como ele começa, e ele
  tem uma próxima ação para experimentar.
</p>
<p>
  Nas primeiras atividades, ele usa blocos de comandos que encaixa para dizer o que deve acontecer
  no jogo. O computador executa essas instruções, e ele vê o resultado na tela.
</p>
</div>
<figure class="visual tela">
  <a class="kof-tela" href={img('tela-aula-topo@2x.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem (abre em nova aba): Tela de uma aula, com o vídeo da explicação ao lado do experimento para testar o que o vídeo explicou">
    <span class="kof-tela__barra" aria-hidden="true"><i></i><i></i><i></i><span class="kof-tela__url">Aula · O que um toque faz?</span></span>
    <img src={img('tela-aula-topo.webp')} srcset={tela2x('tela-aula-topo.webp')} alt="Tela de uma aula, com o vídeo da explicação ao lado do experimento para testar o que o vídeo explicou" width="1280" height="800" loading="lazy" decoding="async" />
  </a>
  <figcaption><span class="visual-label">Tela da plataforma</span>A explicação e o experimento ficam na mesma aula: o vídeo de um lado, a prática do outro.</figcaption>
</figure>
</div>
</div>
<div class="fecho kof-carta kof-carta--fio kof-reveal">
<span class="kof-ladrilho" aria-hidden="true"><span class="material-symbols-rounded">psychology</span></span>
<div>
<h3 class="kof-display">É justo querer saber se ele entendeu o que montou</h3>
<p>
  Ver o jogo funcionando pode deixar essa dúvida: quanto ele compreendeu e quanto acompanhou do
  exemplo? Na primeira montagem, a orientação mostra como usar um comando e onde ele entra. Quando a
  atividade permite uma alteração, a criança pode comparar o que montou com uma nova versão. Se
  mudar a regra que dá um ponto, por exemplo, o placar deve responder de outra maneira. Prever essa
  diferença e conferir o resultado exige relacionar o comando ao que acontece no jogo.
</p>
<p>
  No exemplo ilustrado acima, a mudança aparece no placar. Durante uma atividade que permita alterar
  a regra, comparar as duas versões do jogo ajuda a entender o efeito da mudança. É o tipo de
  conversa que vocês podem ter sobre o jogo do seu filho: qual era a ideia, o que ele mudou e o que
  aconteceu depois. Nas ferramentas que a Jornada já liberou para ele, seu filho também pode voltar
  ao projeto para experimentar outras versões.
</p>
</div>
</div>
<div class="story-row reverse kof-reveal">
<div class="prose">
<h3 class="kof-display">Se desenhar não é a praia dele, há outro jeito de começar</h3>
<p>
  Seu filho pode se interessar pelas regras e não querer desenhar cada personagem antes de começar.
  Quando chega a hora de escolher o que aparece no jogo, o Estúdio oferece personagens, objetos e
  cenários prontos para usar.
</p>
<p>
  Assim, seu filho pode concentrar as escolhas no funcionamento do jogo: como o personagem se move,
  qual objetivo o jogador precisa alcançar e quais regras valem durante a partida. Com o personagem
  na tela, seu filho tem onde experimentar os comandos que está conhecendo.
</p>
<p>
  Escolher uma nave pronta resolve a aparência do personagem. Seu filho monta, com a orientação da
  aula, as regras de movimento e as outras ações da nave. Assim, aprende a programar usando um
  desenho que já está disponível.
</p>
</div>
<figure class="visual generated">
  <a href={img('preview-estudio.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem (abre em nova aba): Ilustração de personagens prontos e montagem das regras de um jogo">
    <img src={img('preview-estudio.webp')} alt="Ilustração de personagens prontos e montagem das regras de um jogo" width="1536" height="1024" loading="lazy" decoding="async" />
  </a>
  <figcaption><span class="visual-label">Ilustração da experiência</span>Com um personagem pronto, seu filho pode se concentrar nas regras do jogo.</figcaption>
</figure>
</div>
<div class="story-row kof-reveal">
<div class="prose">
<h3 class="kof-display">Aquele desenho que ele te mostra pode virar um personagem do jogo</h3>
<p>
  Se você reconhece seu filho na criança que vive inventando criaturas ou desenhando mundos, há
  outra possibilidade para explorar. Ele pode imaginar um personagem com uma aparência que não
  encontrou entre os elementos prontos e querer colocá-lo na própria criação.
</p>
<p>
  Para isso, ele encontra o Pinta, uma ferramenta de desenho feita para crianças. Seu filho pode
  desenhar ali o personagem que imaginou e levá-lo ao Estúdio para usar no jogo. Também pode criar
  objetos e cenários.
</p>
</div>
<figure class="visual tela">
  <a class="kof-tela" href={img('tela-pinta@2x.webp')} target="_blank" rel="noopener" aria-label="Ampliar imagem (abre em nova aba): Tela do Pinta com os desenhos guardados na conta da criança, uma nave e um asteroide">
    <span class="kof-tela__barra" aria-hidden="true"><i></i><i></i><i></i><span class="kof-tela__url">Pinta · Meus desenhos</span></span>
    <img src={img('tela-pinta.webp')} srcset={tela2x('tela-pinta.webp')} alt="Tela do Pinta com os desenhos guardados na conta da criança, uma nave e um asteroide" width="1280" height="800" loading="lazy" decoding="async" />
  </a>
  <figcaption><span class="visual-label">Tela da plataforma</span>Os desenhos ficam guardados na conta e podem ir para o Estúdio.</figcaption>
</figure>
</div>
<div class="fecho kof-carta kof-carta--fio kof-reveal">
<span class="kof-ladrilho kof-ladrilho--rosa" aria-hidden="true"><span class="material-symbols-rounded">palette</span></span>
<div>
<p>
  Ao colocar o personagem que desenhou no cenário do jogo, seu filho encontra novas decisões: a cor
  do personagem permite enxergá-lo sobre o fundo? O personagem ficou grande demais para a fase? Seu
  filho pode ajustar o desenho no Pinta e testar de novo no jogo. Quando o personagem aparece na
  partida, ele reconhece o desenho que fez participando da brincadeira.
</p>
<p>
  Seu filho também pode usar um cenário pronto e desenhar apenas o personagem. Quem gosta de
  desenhar tem espaço para criar a aparência do jogo; quem prefere montar as regras pode usar os
  desenhos disponíveis.
</p>
<p>
  Nas aulas, a criança usa as ferramentas previstas para aquela atividade. O uso livre do Estúdio e
  do Pinta é liberado ao alcançar o posto Construtor, depois de concluir o curso obrigatório de
  entrada e publicar seu projeto.
</p>
</div>
</div>
</div>
</section>

