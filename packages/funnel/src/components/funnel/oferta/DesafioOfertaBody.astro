<script>
  // Scroll reveal (mesma lógica do mockup).
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('visible')
          obs.unobserve(e.target)
        }
      }
    },
    { threshold: 0.14 },
  )
  for (const el of Array.from(document.querySelectorAll('.dpj .reveal'))) obs.observe(el)

  // FAQ accordion.
  for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>('.dpj .faq-q'))) {
    btn.addEventListener('click', () => {
      const ans = btn.nextElementSibling
      const isOpen = ans?.classList.contains('open')
      for (const a of Array.from(document.querySelectorAll('.dpj .faq-a'))) a.classList.remove('open')
      for (const q of Array.from(document.querySelectorAll('.dpj .faq-q'))) q.classList.remove('active')
      if (!isOpen && ans) {
        ans.classList.add('open')
        btn.classList.add('active')
      }
    })
  }

  // Floating CTA mobile: aparece após a 1ª dobra, some perto da oferta.
  const floating = document.querySelector('.dpj .floating-cta')
  const oferta = document.getElementById('oferta')
  if (floating) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY
      const showAfter = window.innerHeight * 0.9
      const hideNear = oferta ? oferta.offsetTop - window.innerHeight : Number.POSITIVE_INFINITY
      floating.classList.toggle('visible', y > showAfter && y < hideNear)
    })
  }
</script>

