---
// Página de vendas do "Desafio do Primeiro Jogo" (funil kids). Layout PRÓPRIO,
// porte fiel da página colorida aprovada pela usuária (tema creme claro, azul +
// laranja, Baloo 2/Nunito, botões 3D, balões dos personagens, decorações
// flutuantes). É uma OFERTA PADRÃO: a personalização por perfil vive só na tela
// de resultado (que é o elo entre o quiz e esta página). O CSS sob medida vive
// no `<style>` escopado abaixo, sob `.dpj` (não vaza para as páginas
// compartilhadas). Os CTAs de compra levam `data-checkout-cta` → o
// PreCheckoutModal (mesma ilha do NCI) abre o checkout.
import '@fontsource/material-symbols-rounded/400.css'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import type { CouponPresentation } from '../../../lib/coupon-query'
import { formatBRLFromCents } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 37,00" (boxes de preço). */
  priceLabel: string
  /** "R$ 37" (botões e copy). */
  priceLabelShort: string
  /** "37.00" (JSON-LD). */
  priceReais: string
  imagesBase: string
  /** Repassado pela rota (o resultado envia ?perfil= para o tracking); a oferta padrão não o renderiza. */
  perfil: string | null
  /** Repassado pela rota (?quer= do quiz); a oferta padrão não o renderiza. */
  quer?: string | null
  ofertaUrl: string
  coupon: CouponPresentation
}
const { f, productName, priceLabel, priceLabelShort, priceReais, imagesBase, ofertaUrl, coupon } =
  Astro.props

const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`
const validCoupon = coupon.status === 'valid' ? coupon : null
const checkoutCouponCode = coupon.status === 'none' ? null : coupon.code
const displayedTotal = validCoupon
  ? formatBRLFromCents(validCoupon.finalPriceCents)
  : priceLabelShort
const discountLabel = validCoupon ? formatBRLFromCents(validCoupon.discountCents) : null
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('hero-desafio.webp')}
  />
  <link slot="head" rel="preload" as="image" href={img('hero.webp')} fetchpriority="high" />

  <div class="dpj">
    <!-- ===== TOPO FIXO ===== -->
    <header class="topbar">
      <div class="wrap nav">
        <div class="logo">
          <span class="badge"><span class="material-symbols-rounded">rocket_launch</span></span>
          Desafio do Primeiro Jogo
        </div>
        <div class="price-mini">
          {validCoupon ? <><s>{priceLabelShort}</s> {displayedTotal}</> : priceLabelShort}
        </div>
        <a href="#oferta" class="btn header-cta">
          <span class="material-symbols-rounded">bolt</span><span class="lbl">Quero começar</span>
        </a>
      </div>
    </header>

    <!-- ===== HERO ===== -->
    <section class="hero sec">
      <svg class="deco float" style="top:12%;left:4%;width:46px" viewBox="0 0 24 24" fill="#FFCE3A"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <svg
        class="deco float slow rev"
        style="top:22%;right:6%;width:34px"
        viewBox="0 0 24 24"
        fill="#F368A6"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <div class="blob" style="width:220px;height:220px;background:#CDE8FF;top:-40px;right:-40px">
      </div>
      <div class="blob" style="width:160px;height:160px;background:#CFF3DC;bottom:20px;left:-50px">
      </div>
      <div class="wrap">
        <div class="grid">
          <div class="hero-copy">
            <span class="eyebrow">Para crianças a partir de 9 anos que gostam de jogos e tecnologia</span>
            <h1>
              Seu filho não precisa de mais tempo de tela. Precisa descobrir o que consegue
              <span class="hl">criar com uma parte dele.</span>
            </h1>
            <p class="lead">
              Em cinco dias guiados, ele transforma comandos visuais em um jogo de nave feito por
              ele — com tiros, asteroides, pontos, vidas, vitória, derrota e um link para
              compartilhar.
            </p>
            <div class="chips">
              <span class="chip"
                ><span class="material-symbols-rounded">bolt</span>Uma parte funcionando por dia</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">child_care</span>A partir dos 9 anos</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">favorite</span>Você não precisa programar</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">schedule</span>30 dias de acesso</span
              >
            </div>
            <div class="hero-cta">
              <a href="#oferta" class="btn big">
                <span class="material-symbols-rounded">sports_esports</span>Quero transformar parte
                desse tempo em criação
              </a>
            </div>
            <div class="seals">
              <span><span class="material-symbols-rounded">check_circle</span>Sem instalar programas</span>
              <span
                ><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span
              >
              <span
                ><span class="material-symbols-rounded">check_circle</span>Pagamento único</span
              >
            </div>
            <p class="scope-note">
              {
                validCoupon
                  ? `De ${priceLabelShort} por ${displayedTotal}, pagamento único · cupom ${validCoupon.code} aplicado · 30 dias de acesso · garantia de 7 dias`
                  : `${priceLabel}, pagamento único · 30 dias de acesso · garantia de 7 dias`
              }
            </p>
            {
              (coupon.status === 'invalid' || coupon.status === 'error') && (
                <p class="coupon-alert" role="alert">
                  <strong>Cupom {coupon.code || 'informado'}:</strong> {coupon.message} O checkout não
                  fará cobrança sem você confirmar o valor.
                </p>
              )
            }
          </div>
          <figure class="art hero-art">
            <div class="glow"></div>
            <img
              src={img('hero.webp')}
              alt="Criança criando o primeiro jogo no computador com o Zappy ao lado e os pais atrás"
              width="1000"
              height="1263"
              fetchpriority="high"
            />
          </figure>
        </div>
        <!-- personagem como apoio visual; a comunicação comercial segue dirigida aos pais -->
        <div class="kid reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('zappy-fala.webp')}
                alt="Zappy, o vagalume do desafio"
                width="360"
                height="458"
                loading="lazy"
              />
            </figure>
            <span class="name">Zappy</span>
          </div>
          <div class="bubble">
            Seu papel é reservar o momento e celebrar as pequenas entregas. O caminho técnico
            aparece passo a passo para a criança, e você não precisa entender de programação para
            acompanhar.
          </div>
        </div>
      </div>
    </section>

    <!-- ===== STATS ===== -->
    <section class="stats-band">
      <div class="wrap">
        <div class="stats">
          <div class="stat"><div class="n">5 etapas</div><div class="l">uma parte nova por encontro</div></div>
          <div class="stat">
            <div class="n">30 dias</div><div class="l">para organizar a trilha</div>
          </div>
          <div class="stat">
            <div class="n">{priceLabelShort}</div><div class="l">uma vez, sem mensalidade</div>
          </div>
        </div>
        <div class="market">
          A proposta não é acrescentar horas à rotina. É trocar uma pequena parte do consumo que já
          existe por um projeto curto, com decisões e um resultado criado pela criança.
        </div>
      </div>
    </section>

    <!-- ===== DUAS TELAS ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">Tela demais preocupa. Você tem razão em se preocupar.</span>
        <h2 class="reveal">O mesmo computador.<br />Uma postura diferente diante dele.</h2>
        <p class="sub">
          A proposta não é aumentar o tempo nem chamar qualquer tela de aprendizado. É fazer uma
          troca pequena e concreta dentro do tempo que já existe.
        </p>
        <div class="two">
          <div class="screen neg reveal">
            <h3>
              <span class="material-symbols-rounded">sentiment_dissatisfied</span>Antes
            </h3>
            <figure class="art">
              <img
                src={img('crianca-passiva.webp')}
                alt="Criança entediada no sofá, rolando vídeos no celular"
                width="880"
                height="692"
                loading="lazy"
              />
            </figure>
            <p>
              O jogo chega pronto. Seu filho segue as regras, vence fases criadas por outra pessoa e
              fecha a tela sem algo próprio para mostrar.
            </p>
            <div class="tags">
              <div class="tag">
                <span class="material-symbols-rounded">timer_off</span>Regras definidas por outra pessoa
              </div>
              <div class="tag">
                <span class="material-symbols-rounded">block</span>Sem um projeto próprio no final
              </div>
            </div>
          </div>
          <div class="screen pos reveal">
            <h3>
              <span class="material-symbols-rounded">celebration</span>Durante o Desafio
            </h3>
            <figure class="art">
              <img
                src={img('crianca-criando.webp')}
                alt="A mesma criança empolgada criando o jogo da nave, com o Zappy comemorando"
                width="880"
                height="581"
                loading="lazy"
              />
            </figure>
            <p>
              Ele escolhe, monta, testa, encontra um erro, ajusta e vê o jogo responder ao que fez.
              No fim, chama alguém para jogar uma criação que antes existia apenas como ideia.
            </p>
            <div class="tags">
              <div class="tag">
                <span class="material-symbols-rounded">stadia_controller</span>Comandos e regras que ele montou
              </div>
              <div class="tag">
                <span class="material-symbols-rounded">emoji_events</span>Uma versão jogável para compartilhar
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== A ATENÇÃO DELE (coração) ===== -->
    <section class="sec culpa">
      <div class="wrap center">
        <span class="eyebrow">Não é mais tela. É outra direção para uma parte dela.</span>
        <h2 class="reveal">Uma troca pequena, concreta<br />e possível de acompanhar.</h2>
        <p class="sub">
          Jogos, vídeos e tecnologia já aparecem em casa, na escola e nas conversas das crianças.
          Durante cinco etapas, uma parte desse tempo passa a ter um projeto, decisões e um resultado.
        </p>
        <div class="box reveal">
          <div class="box-grid">
            <figure class="art alivio-art">
              <img
                src={img('alivio.webp')}
                alt="Zappy com a mão no peito e um coração ao lado, passando calma"
                width="520"
                height="746"
                loading="lazy"
              />
            </figure>
            <p>
              O Desafio começa no interesse que a criança já demonstra e oferece uma sequência
              curta: montar uma parte, testar o que aconteceu e avançar para a próxima decisão.
            </p>
          </div>
        </div>
        <div class="thesis reveal">
          Enquanto cria, seu filho pratica ações que não aparecem quando ele só joga: dividir um
          projeto, relacionar comando e efeito, testar, observar, ajustar e decidir como o jogo funciona.
        </div>
        <div class="shift">
          <div class="card reveal">
            <div class="from">Só seguir regras prontas</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Esse interesse é o
              Definir regras e efeitos
            </div>
            <p>
              A criança escolhe movimento, dificuldade e consequência dentro do projeto.
            </p>
          </div>
          <div class="card reveal">
            <div class="from">Horas que só consomem</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Uma parte do tempo que cria
            </div>
            <p>
              A família mantém seus limites e troca apenas uma parte do consumo por uma criação.
            </p>
          </div>
          <div class="card reveal">
            <div class="from">Parar no primeiro erro</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Testar, observar e ajustar
            </div>
            <p>
              O erro vira informação sobre qual bloco ou regra precisa mudar.
            </p>
          </div>
        </div>
        <div class="thesis verde reveal">
          Cada criança vive a experiência de um jeito. O Desafio oferece prática guiada; não promete
          resultado escolar, clínico ou comportamental específico.
        </div>
      </div>
    </section>

    <!-- ===== COMO FUNCIONA ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">O projeto dos cinco dias</span>
        <h2 class="reveal">Cinco dias. Uma parte nova do jogo<br />funcionando a cada dia.</h2>
        <p class="sub">
          A sequência é recomendada; cada família pode organizar os encontros dentro dos 30 dias
          de acesso.
        </p>
      </div>
      <div class="wrap">
        <div class="days">
          <div class="day reveal">
            <div class="num">1</div>
            <div>
              <h3>A nave ganha vida</h3>
              <p>
                Seu filho conhece o estúdio, monta a base e vê o primeiro comando aparecer na tela.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia1.webp')}
                alt="Jogo do Dia 1: a nave voando no espaço"
                width="791"
                height="476"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">2</div>
            <div>
              <h3>A nave responde</h3>
              <p>
                Ele cria movimento e tiro e percebe que cada bloco muda o comportamento do jogo.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia2.webp')}
                alt="Jogo do Dia 2: a nave atirando no espaço"
                width="653"
                height="393"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">3</div>
            <div>
              <h3>O desafio aparece</h3>
              <p>
                Asteroides entram em cena, se movem e transformam a criação em algo jogável.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia3.webp')}
                alt="Jogo do Dia 3: os asteroides caindo enquanto a nave atira"
                width="655"
                height="391"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">4</div>
            <div>
              <h3>O jogo passa a lembrar</h3>
              <p>
                Pontos, vidas, colisões e feedback dão consequência às escolhas.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia4.webp')}
                alt="Jogo do Dia 4: o placar de pontos e os corações de vida na tela"
                width="654"
                height="396"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">5</div>
            <div>
              <h3>Começo, vitória e derrota</h3>
              <p>
                Ele fecha o ciclo, testa e publica um link para outras pessoas jogarem.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia5.webp')}
                alt="Jogo do Dia 5: a tela de início do jogo pronto, com o nome Nave contra Asteroides"
                width="875"
                height="526"
                loading="lazy"
              />
            </figure>
          </div>
        </div>
        <!-- personagem como apoio visual; copy dirigida aos pais -->
        <div class="kid verde reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('dede-fala.webp')}
                alt="Dedé, personagem do desafio"
                width="360"
                height="869"
                loading="lazy"
              />
            </figure>
            <span class="name">Dedé</span>
          </div>
          <div class="bubble">
            Os “cinco dias” são a sequência recomendada. Se a rotina apertar, vocês podem pausar e
            retomar o progresso durante os 30 dias de acesso.
          </div>
        </div>
        <div class="thesis compacta reveal">
          <b>Uma entrega por etapa:</b> cada encontro termina com uma parte observável do jogo
          funcionando, para que a criança entenda o que o comando que montou mudou na tela.
        </div>
        <div class="center como-cta">
          <a href="#oferta" class="btn">
            <span class="material-symbols-rounded">rocket_launch</span>Quero transformar parte desse tempo em criação
          </a>
        </div>
      </div>
    </section>

    <!-- ===== POR DENTRO DA PLATAFORMA ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">Olha por dentro</span>
        <h2 class="reveal">O estúdio onde ele cria abre<br />dentro da própria aula</h2>
        <p class="sub">
          Sem instalar nada, sem configurar nada. Ele entra, arrasta os blocos e vê o jogo acontecer
          ali do lado. Tudo no mesmo lugar.
        </p>
        <div class="browser reveal">
          <div class="bar">
            <i></i><i></i><i></i><span class="url">kids.sistemazero.com.br</span>
          </div>
          <figure class="art">
            <img
              src={img('print-estudio.webp')}
              alt="A plataforma por dentro: a aula, o estúdio com os blocos e o jogo rodando"
              width="1100"
              height="1532"
              loading="lazy"
            />
          </figure>
        </div>
        <p class="sub plat-note">Ele arrasta os blocos e vê o jogo acontecer do lado.</p>
      </div>
    </section>

    <!-- ===== ENTREGÁVEIS ===== -->
    <section class="sec gifts">
      <div class="wrap center">
        <span class="eyebrow">O que está incluído</span>
        <h2 class="reveal">Tudo o que ele precisa para chegar<br />ao primeiro jogo pronto</h2>
        <p class="sub">
          A trilha, as instruções e o ambiente de criação ficam reunidos no mesmo acesso.
        </p>
        <div class="gift-grid">
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-trilha.webp')}
                alt="Trilha guiada de 5 dias"
                width="760"
                height="570"
                loading="lazy"
              />
            </figure>
            <h4>Trilha guiada de 5 dias</h4>
            <p>Uma atividade por dia, com começo, meio e fim.</p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-estudio.webp')}
                alt="Estúdio e blocos feitos pra criança"
                width="760"
                height="376"
                loading="lazy"
              />
            </figure>
            <h4>Estúdio e blocos feitos pra criança</h4>
            <p>
              Abre dentro da própria aula, sem instalar programas. A criança monta o projeto com
              comandos visuais em blocos.
            </p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-link.webp')}
                alt="Link do jogo pra compartilhar"
                width="486"
                height="538"
                loading="lazy"
              />
            </figure>
            <h4>Link do jogo pra compartilhar</h4>
            <p>
              No fim, ela publica o jogo e gera um link pra mandar pros amigos e a família jogarem,
              no computador ou no celular.
            </p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-video.webp')}
                alt="Passo a passo em vídeo"
                width="760"
                height="434"
                loading="lazy"
              />
            </figure>
            <h4>Passo a passo em vídeo</h4>
            <p>Aulas em vídeo e instruções dentro da própria atividade.</p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-mapa.webp')}
                alt="Mapa dos pais"
                width="760"
                height="1075"
                loading="lazy"
              />
            </figure>
            <h4>Mapa dos pais</h4>
            <p>
              Uma página simples explicando como acompanhar, em português de quem não entende de
              tecnologia.
            </p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-certificado.webp')}
                alt="Certificado de conclusão"
                width="760"
                height="569"
                loading="lazy"
              />
            </figure>
            <h4>Certificado de conclusão</h4>
            <p>Em PDF ou imagem, gerado ao terminar o desafio.</p>
          </div>
        </div>
        <!-- personagem como apoio visual; copy dirigida aos pais -->
        <div class="kid rosa reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('debinha-fala.webp')}
                alt="Debinha, personagem do desafio"
                width="360"
                height="640"
                loading="lazy"
              />
            </figure>
            <span class="name">Debinha</span>
          </div>
          <div class="bubble">
            Ao terminar, seu filho pode publicar o jogo e compartilhar o link com a família. A
            criação acontece no computador; o jogo publicado pode ser aberto em outros dispositivos.
          </div>
        </div>
        <p class="scope-note">
          Inclui 30 dias de acesso contados da aprovação do pagamento. Este produto não inclui
          acompanhamento individual; as orientações ficam disponíveis durante esse período.
        </p>
      </div>
    </section>

    <!-- ===== O QUE ELE DESENVOLVE ===== -->
    <section class="sec menta">
      <div class="wrap center">
        <span class="eyebrow">O que a experiência exercita</span>
        <h2 class="reveal">Ações que não aparecem<br />quando ele só joga.</h2>
        <p class="sub">
          A proposta é oferecer prática guiada dentro de um projeto concreto, sem prometer um
          resultado escolar ou comportamental.
        </p>
        <div class="gift-grid">
          <div class="gift reveal">
