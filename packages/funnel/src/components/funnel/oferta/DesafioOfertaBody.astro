<script>
  // Scroll reveal (mesma lógica do mockup).
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('visible')
          obs.unobserve(e.target)
        }
      }
    },
    { threshold: 0.14 },
  )
  for (const el of Array.from(document.querySelectorAll('.dpj .reveal'))) obs.observe(el)

  // Barra fixa mobile: aparece após a 1ª dobra, some perto da oferta.
  const mobar = document.querySelector('.dpj .mobar')
  const oferta = document.getElementById('oferta')
  if (mobar) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY
      const showAfter = window.innerHeight * 0.9
      const hideNear = oferta ? oferta.offsetTop - window.innerHeight : Number.POSITIVE_INFINITY
      mobar.classList.toggle('visible', y > showAfter && y < hideNear)
    })
  }
</script>

