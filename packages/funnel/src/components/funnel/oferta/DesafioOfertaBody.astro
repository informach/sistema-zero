    direction: ltr;
    -webkit-font-feature-settings: 'liga';
    font-feature-settings: 'liga';
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Paleta kids (creme + azul + laranja) + base ===== */
  .dpj {
    --azul: #1e88e5;
    --azul-esc: #1560a8;
    --laranja: #fb8c00;
    --laranja-cta: #ff9a1f;
    --rosa: #f368a6;
    --verde: #37c871;
    --verde-menta: #dff6e6;
    --amarelo: #ffce3a;
    --creme: #fff7e9;
    --ceu: #e4f2ff;
    --menta-bg: #e6f8ec;
    --lilas: #efe7ff;
    --navy: #0c1e3e;
    --tinta: #26314a;
    --tinta-suave: #5c6b85;
    --branco: #ffffff;
    --borda: #eae3d3;
    --sombra: 0 14px 40px rgba(28, 48, 90, 0.12);
    --sombra-sm: 0 8px 22px rgba(28, 48, 90, 0.1);
    --raio: 26px;
    --raio-sm: 16px;
    --head: 'Baloo 2', ui-sans-serif, system-ui, sans-serif;
    --body: 'Nunito', ui-sans-serif, system-ui, sans-serif;
    --maxw: 1120px;

    font-family: var(--body);
    color: var(--tinta);
    background: var(--creme);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    /* `clip` (e não `hidden`): overflow hidden criaria um scroll container e
       quebraria o position: sticky da faixa do topo. */
    overflow-x: clip;
  }
  .dpj h1,
  .dpj h2,
  .dpj h3,
  .dpj h4 {
    font-family: var(--head);
    line-height: 1.14;
    letter-spacing: -0.01em;
    font-weight: 700;
    margin: 0;
  }
  .dpj p {
    margin: 0;
  }
  .dpj img {
    max-width: 100%;
    display: block;
  }
  .dpj a {
    text-decoration: none;
    color: inherit;
  }
  .dpj .wrap {
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 22px;
  }
  .dpj .sec {
    padding: 74px 0;
    position: relative;
    overflow: hidden;
  }
  .dpj .center {
    text-align: center;
  }
  .dpj .eyebrow {
    display: inline-block;
    font-family: var(--head);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--azul);
    background: #fff;
    border: 2px solid #cfe6ff;
    padding: 6px 16px;
    border-radius: 22px;
    box-shadow: var(--sombra-sm);
    margin-bottom: 18px;
    line-height: 1.45;
    text-align: center;
  }
  .dpj .sec h2 {
    font-size: clamp(1.7rem, 4.4vw, 2.6rem);
    font-weight: 700;
  }
  .dpj .sub {
    font-size: clamp(1rem, 2.1vw, 1.18rem);
    color: var(--tinta-suave);
    max-width: 640px;
    margin: 14px auto 0;
  }

  /* ===== botões (3D com sombra dura) ===== */
  .dpj .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    border: none;
    font-family: var(--head);
    font-weight: 600;
    font-size: 1.08rem;
    color: #3a2400;
    background: linear-gradient(180deg, #ffb53f, #ff9a1f);
    border-radius: 16px;
    padding: 16px 30px;
    box-shadow:
      0 10px 0 #d8760a,
      0 18px 30px rgba(255, 154, 31, 0.34);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
    text-align: center;
    line-height: 1.15;
  }
  .dpj .btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 12px 0 #d8760a,
      0 22px 36px rgba(255, 154, 31, 0.42);
  }
  .dpj .btn:active {
    transform: translateY(4px);
    box-shadow:
      0 6px 0 #d8760a,
      0 12px 20px rgba(255, 154, 31, 0.34);
  }
  .dpj .btn .material-symbols-rounded {
    font-size: 22px;
  }
  .dpj .btn.big {
    font-size: 1.22rem;
    padding: 20px 38px;
  }
  /* Respiro pós-CTA: a sombra 3D ocupa ~10px visuais abaixo do botão, então os
     textos que vêm em seguida ganham espaçamento extra pra não grudar nela. */
  .dpj .seals {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    justify-content: center;
    margin-top: 32px;
    color: var(--tinta-suave);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .dpj .seals span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dpj .seals .material-symbols-rounded {
    font-size: 19px;
    color: var(--verde);
  }
  .dpj .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 22px 0 8px;
  }
  .dpj .chip {
    background: #fff;
    border: 2px solid #e7eefb;
    border-radius: 999px;
    padding: 9px 16px;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--tinta);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    box-shadow: var(--sombra-sm);
  }
  .dpj .chip .material-symbols-rounded {
    font-size: 18px;
    color: var(--laranja);
  }

  /* ===== arte ===== */
  .dpj .art {
    position: relative;
    width: 100%;
    margin: 0;
  }
  .dpj .art img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* ===== balão dos personagens ===== */
  .dpj .kid {
    position: relative;
    display: flex;
    gap: 20px;
    align-items: center;
    max-width: 720px;
    margin: 30px auto 0;
  }
  .dpj .kid .char {
    flex: 0 0 140px;
    width: 140px;
    text-align: center;
  }
  .dpj .kid .char .art img {
    max-height: 170px;
    width: auto;
    margin: 0 auto;
  }
  .dpj .kid .char .name {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--head);
    font-weight: 600;
    font-size: 0.9rem;
    color: #fff;
    background: var(--azul);
    padding: 4px 16px;
    border-radius: 999px;
    box-shadow: var(--sombra-sm);
  }
  .dpj .kid .bubble {
    position: relative;
    flex: 1;
    background: #fff;
    border: 3px solid var(--amarelo);
    border-radius: 22px;
    padding: 18px 22px;
    box-shadow: var(--sombra-sm);
    font-size: 1.04rem;
    color: var(--tinta);
    text-align: left;
  }
  .dpj .kid .bubble::before {
    content: '';
    position: absolute;
    left: -13px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 22px;
    height: 22px;
    background: #fff;
    border-left: 3px solid var(--amarelo);
    border-bottom: 3px solid var(--amarelo);
  }
  .dpj .kid.rosa .bubble {
    border-color: var(--rosa);
  }
  .dpj .kid.rosa .bubble::before {
    border-color: var(--rosa);
  }
  /* `.char` entra no seletor para superar a base (o escopo do Astro soma um
     atributo por elo, então o seletor mais longo da base venceria sem ele). */
  .dpj .kid.rosa .char .name {
    background: var(--rosa);
  }
  .dpj .kid.verde .bubble {
    border-color: var(--verde);
  }
  .dpj .kid.verde .bubble::before {
    border-color: var(--verde);
  }
  .dpj .kid.verde .char .name {
    background: var(--verde);
  }
  .dpj .kid.fecho {
    margin-top: 30px;
  }
  @media (max-width: 560px) {
    .dpj .kid {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
    .dpj .kid .bubble::before {
      display: none;
    }
  }

  /* ===== topo fixo ===== */
  .dpj .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 247, 233, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--borda);
  }
  .dpj .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
  }
  .dpj .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--head);
    font-weight: 700;
    font-size: 1.12rem;
    color: var(--azul-esc);
  }
  .dpj .logo .badge {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: linear-gradient(150deg, #37a6f5, #1e88e5);
    display: grid;
    place-items: center;
    color: #fff;
    box-shadow: var(--sombra-sm);
  }
  .dpj .logo .badge .material-symbols-rounded {
    font-size: 22px;
  }
  .dpj .nav .price-mini {
    margin-left: auto;
    margin-right: 14px;
    font-weight: 900;
    color: var(--tinta);
    font-size: 0.92rem;
  }
  .dpj .nav .price-mini s {
    color: var(--tinta-suave);
    font-weight: 700;
  }
  .dpj .header-cta {
    padding: 11px 20px;
    font-size: 0.98rem;
    /* A sombra 3D ocupa 6px abaixo do botão: a margem compensa para o conjunto
       (botão + sombra) ficar visualmente centrado na faixa. */
    margin-bottom: 6px;
    box-shadow:
      0 6px 0 #d8760a,
      0 10px 18px rgba(255, 154, 31, 0.3);
  }
  .dpj .header-cta:hover {
    box-shadow:
      0 8px 0 #d8760a,
      0 14px 22px rgba(255, 154, 31, 0.4);
  }
  @media (max-width: 560px) {
    .dpj .nav .price-mini {
      display: none;
    }
  }

  /* ===== decorações flutuantes ===== */
  .dpj .deco {
    position: absolute;
    pointer-events: none;
    opacity: 0.9;
    z-index: 0;
  }
  .dpj .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    z-index: 0;
    opacity: 0.6;
    pointer-events: none;
  }
  .dpj .float {
    animation: dpj-float 6s ease-in-out infinite;
  }
  .dpj .float.slow {
    animation-duration: 9s;
  }
  .dpj .float.rev {
    animation-direction: reverse;
  }
  @keyframes dpj-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }
  .dpj .sec > .wrap {
    position: relative;
    z-index: 2;
  }

  /* ===== reveal ===== */
  .dpj .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .dpj .reveal.visible {
    opacity: 1;
    transform: none;
  }

  /* ===== hero ===== */
  .dpj .hero {
    background: linear-gradient(180deg, #dceeff 0%, #e9f7ef 62%, var(--creme) 100%);
    padding-top: 52px;
  }
  .dpj .hero .grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 36px;
    align-items: center;
  }
  .dpj .hero .hero-copy {
    text-align: center;
  }
  .dpj .hero h1 {
    font-size: clamp(2rem, 5.2vw, 3.35rem);
    font-weight: 700;
  }
  .dpj .hero h1 .hl {
    color: var(--azul);
    position: relative;
    white-space: nowrap;
  }
  .dpj .hero .lead {
    font-size: clamp(1.02rem, 2.3vw, 1.24rem);
    color: #41506e;
    margin: 18px auto 0;
    max-width: 560px;
  }
  .dpj .hero-cta {
    margin-top: 22px;
    text-align: center;
  }
  .dpj .hero-art {
    position: relative;
  }
  .dpj .hero-art .glow {
    position: absolute;
    inset: -6% -4%;
    background: radial-gradient(circle at 55% 45%, rgba(30, 136, 229, 0.16), transparent 62%);
    z-index: 0;
  }
  .dpj .hero-art img {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 860px) {
    .dpj .hero .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .dpj .hero .lead {
      margin-left: auto;
      margin-right: auto;
    }
    .dpj .hero-art {
      order: -1;
      max-width: 460px;
      margin: 0 auto;
    }
  }

  /* ===== stats ===== */
  .dpj .stats-band {
    background: linear-gradient(180deg, #1e88e5, #1560a8);
    color: #fff;
    padding: 46px 0;
  }
  .dpj .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    text-align: center;
  }
  .dpj .stat {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 20px;
    padding: 22px 14px;
  }
  .dpj .stat .n {
    font-family: var(--head);
    font-weight: 700;
    font-size: clamp(1.8rem, 5vw, 2.7rem);
    color: var(--amarelo);
  }
  .dpj .stat .l {
    font-weight: 700;
    opacity: 0.95;
    font-size: 0.98rem;
  }
  .dpj .market {
    max-width: 760px;
    margin: 26px auto 0;
    text-align: center;
    font-size: 1rem;
    opacity: 0.96;
    background: rgba(0, 0, 0, 0.12);
    padding: 14px 20px;
    border-radius: 16px;
  }
  .dpj .market small {
    opacity: 0.7;
    display: block;
    margin-top: 4px;
    font-size: 0.78rem;
  }
  @media (max-width: 560px) {
    .dpj .stats {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  /* ===== duas telas ===== */
  .dpj .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-top: 40px;
  }
  .dpj .screen {
    border-radius: var(--raio);
    padding: 26px;
    box-shadow: var(--sombra);
    position: relative;
    overflow: hidden;
    text-align: left;
    /* Coluna flex: as tags de destaque alinham no rodapé dos DOIS cards,
       mesmo com ilustrações de alturas diferentes. */
    display: flex;
    flex-direction: column;
  }
  .dpj .screen.neg {
    background: #f1f3f7;
    border: 2px solid #e2e6ee;
  }
  .dpj .screen.pos {
    background: linear-gradient(180deg, #fffdf5, #fff4da);
    border: 2px solid #ffe1a0;
  }
  .dpj .screen h3 {
    font-size: 1.24rem;
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .dpj .screen.neg h3 {
    color: #7a8397;
  }
  .dpj .screen.pos h3 {
    color: var(--laranja);
  }
  .dpj .screen .art {
    margin: 16px 0;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dpj .screen .art img {
    max-height: 100%;
    width: auto;
    max-width: 100%;
    margin: 0 auto;
  }
  .dpj .screen p {
    color: #4a566e;
    margin-bottom: 14px;
  }
  .dpj .screen.neg p {
    color: #7a8397;
  }
  .dpj .tags {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: auto;
  }
  .dpj .tag {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 0.95rem;
    background: #fff;
    border-radius: 12px;
    padding: 10px 13px;
  }
  .dpj .tag .material-symbols-rounded {
    font-size: 20px;
  }
  .dpj .screen.neg .tag {
    color: #8a93a6;
  }
  .dpj .screen.neg .tag .material-symbols-rounded {
    color: #aab2c2;
  }
  .dpj .screen.pos .tag {
    color: #2f7d4e;
  }
  .dpj .screen.pos .tag .material-symbols-rounded {
    color: var(--verde);
  }
  @media (max-width: 760px) {
    .dpj .two {
      grid-template-columns: 1fr;
    }
  }

  /* ===== o foco dele ===== */
  .dpj .culpa {
    background: var(--menta-bg);
  }
  .dpj .culpa .box {
    background: #fff;
    border-radius: var(--raio);
    padding: 28px;
    box-shadow: var(--sombra);
    max-width: 820px;
    margin: 34px auto 0;
    text-align: left;
  }
  .dpj .box-grid {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 22px;
    align-items: center;
  }
  .dpj .alivio-art img {
    max-height: 190px;
    width: auto;
    margin: 0 auto;
  }
  .dpj .culpa .box p {
    color: #4a566e;
  }
  .dpj .thesis {
    background: linear-gradient(180deg, #fff7e9, #ffefcf);
    border: 2px solid #ffe0a3;
    border-radius: var(--raio);
    padding: 24px 26px;
    margin: 24px auto 0;
    max-width: 820px;
    text-align: left;
  }
  .dpj .thesis b {
    color: var(--laranja-cta);
  }
  .dpj .thesis.verde {
    text-align: center;
    background: linear-gradient(180deg, #eaf9f0, #ddf6e6);
    border-color: #b7e9c8;
  }
  .dpj .thesis.compacta {
    max-width: 760px;
    margin-top: 26px;
  }
  .dpj .shift {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 30px;
  }
  .dpj .shift .card {
    background: #fff;
    border-radius: var(--raio);
    padding: 22px;
    box-shadow: var(--sombra-sm);
    border-top: 6px solid var(--azul);
    text-align: left;
  }
  .dpj .shift .card:nth-child(2) {
    border-top-color: var(--verde);
  }
  .dpj .shift .card:nth-child(3) {
    border-top-color: var(--rosa);
  }
  .dpj .shift .from {
    color: var(--tinta-suave);
    font-weight: 800;
    font-size: 0.86rem;
    text-decoration: line-through;
    opacity: 0.75;
  }
  .dpj .shift .to {
    font-family: var(--head);
    font-weight: 600;
    color: var(--tinta);
    font-size: 1.08rem;
    margin: 4px 0 8px;
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .dpj .shift .to .material-symbols-rounded {
    color: var(--verde);
    font-size: 20px;
  }
  .dpj .shift .card p {
    color: #4a566e;
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .dpj .shift {
      grid-template-columns: 1fr;
    }
    .dpj .box-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .dpj .alivio-art img {
      max-height: 150px;
    }
  }

  /* ===== como funciona ===== */
  .dpj .days {
    display: grid;
    gap: 26px;
    margin-top: 40px;
  }
  .dpj .day {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
    align-items: center;
    background: #fff;
    border-radius: 28px;
    padding: 24px;
    box-shadow: var(--sombra);
    position: relative;
    text-align: left;
  }
  /* nos dias pares a imagem vai pra ESQUERDA (o figure é o último no DOM, então precisa de
     order negativa; com `order: 2` a regra não saía do lugar e a trilha ficava toda alinhada) */
  .dpj .day:nth-child(even) .day-art {
    order: -1;
  }
  .dpj .day .num {
    position: absolute;
    top: -16px;
    left: 24px;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: linear-gradient(150deg, #37a6f5, #1e88e5);
    color: #fff;
    font-family: var(--head);
    font-weight: 700;
    font-size: 1.5rem;
    display: grid;
    place-items: center;
    box-shadow: var(--sombra-sm);
  }
  .dpj .day:nth-child(2) .num {
    background: linear-gradient(150deg, #4bd886, #2f9e57);
  }
  .dpj .day:nth-child(3) .num {
    background: linear-gradient(150deg, #ff8fc0, #e0559a);
  }
  .dpj .day:nth-child(4) .num {
    background: linear-gradient(150deg, #ffb53f, #ef6c00);
  }
  .dpj .day:nth-child(5) .num {
    background: linear-gradient(150deg, #3d5896, #0c1e3e);
  }
  .dpj .day h3 {
    font-size: 1.4rem;
    margin: 8px 0;
  }
  .dpj .day p {
    color: #4a566e;
  }
  .dpj .day .print-frame {
    border-radius: 18px;
    overflow: hidden;
    background: var(--navy);
    box-shadow:
      inset 0 0 0 6px rgba(255, 255, 255, 0.06),
      var(--sombra-sm);
  }
  .dpj .como-cta {
    margin-top: 26px;
  }
  @media (max-width: 760px) {
    .dpj .day {
      grid-template-columns: 1fr;
    }
    .dpj .day:nth-child(even) .day-art {
      order: 0;
    }
  }

  /* ===== por dentro da plataforma ===== */
  .dpj .browser {
