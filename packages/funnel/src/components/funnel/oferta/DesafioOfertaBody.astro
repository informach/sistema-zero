---
// Página de vendas do "Desafio do Primeiro Jogo" (funil kids). Layout PRÓPRIO,
// com a composição aprovada e a identidade canônica da Comunidade Kids
// (paleta Pen, Baloo 2/Nunito, botões 3D, balões dos personagens e decorações
// flutuantes). É uma OFERTA PADRÃO: a personalização por perfil vive só na tela
// de resultado (que é o elo entre o quiz e esta página). O CSS sob medida vive
// no `<style>` escopado abaixo, sob `.dpj` (não vaza para as páginas
// compartilhadas). Os CTAs de compra levam `data-checkout-cta` → o
// PreCheckoutModal (mesma ilha do NCI) abre o checkout.
import { desafioDesejoLabel } from '../../../funnels/desafio-primeiro-jogo/quiz'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import type { CouponPresentation } from '../../../lib/coupon-query'
import { formatBRLFromCents } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 37,00" (boxes de preço). */
  priceLabel: string
  /** "R$ 37" (botões e copy). */
  priceLabelShort: string
  /** "37.00" (JSON-LD). */
  priceReais: string
  imagesBase: string
  /** Repassado pela rota para o tracking. */
  perfil: string | null
  /** Desejo declarado no quiz, quando a visita vem da tela de resultado. */
  quer?: string | null
  ofertaUrl: string
  coupon: CouponPresentation
}
const {
  f,
  productName,
  priceLabel,
  priceLabelShort,
  priceReais,
  imagesBase,
  quer,
  ofertaUrl,
  coupon,
} = Astro.props

const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`
const validCoupon = coupon.status === 'valid' ? coupon : null
const checkoutCouponCode = coupon.status === 'none' ? null : coupon.code
const displayedTotal = validCoupon
  ? formatBRLFromCents(validCoupon.finalPriceCents)
  : priceLabelShort
const discountLabel = validCoupon ? formatBRLFromCents(validCoupon.discountCents) : null
const desejoDoQuiz = desafioDesejoLabel(quer)
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('hero-desafio.webp')}
  />
  <link slot="head" rel="preload" as="image" href={img('hero.webp')} fetchpriority="high" />

  <div class="dpj">
    <!-- ===== TOPO FIXO ===== -->
    <header class="topbar">
      <div class="wrap nav">
        <div class="logo">
          <span class="badge"><span class="material-symbols-rounded">rocket_launch</span></span>
          Desafio do Primeiro Jogo
        </div>
        <div class="price-mini">
          {validCoupon ? <><s>{priceLabelShort}</s> {displayedTotal}</> : priceLabelShort}
        </div>
        <a href="#oferta" class="btn header-cta">
          <span class="material-symbols-rounded">bolt</span><span class="lbl">Quero começar</span>
        </a>
      </div>
    </header>

    <!-- ===== HERO ===== -->
    <section class="hero sec">
      <svg class="deco float" style="top:12%;left:4%;width:46px" viewBox="0 0 24 24" fill="var(--sz-community-yellow)"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <svg
        class="deco float slow rev"
        style="top:22%;right:6%;width:34px"
        viewBox="0 0 24 24"
        fill="var(--sz-community-pink-light)"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <div class="blob" style="width:220px;height:220px;background:var(--sz-community-ground-alt);top:-40px;right:-40px">
      </div>
      <div class="blob" style="width:160px;height:160px;background:var(--sz-community-mint);bottom:20px;left:-50px">
      </div>
      <div class="wrap">
        <div class="grid">
          <div class="hero-copy">
            <span class="eyebrow">Para famílias com crianças a partir de 9 anos que gostam de jogos</span>
            <h1>
              Seu filho passa horas envolvido com jogos. E se uma parte desse tempo terminasse em
              <span class="hl">um jogo criado por ele?</span>
            </h1>
            <p class="lead">
              Em cinco etapas guiadas, ele monta um jogo de nave com tiros, asteroides, pontos,
              vidas, vitória e derrota. No final, publica um link para mostrar o que criou.
            </p>
            {
              desejoDoQuiz && (
                <p class="quiz-echo">
                  No quiz, você disse que gostaria de ver seu filho {desejoDoQuiz}. O Desafio
                  transforma essa vontade em um primeiro projeto curto e possível de concluir.
                </p>
              )
            }
            <div class="chips">
              <span class="chip"
                ><span class="material-symbols-rounded">bolt</span>Uma parte funcionando por dia</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">child_care</span>A partir dos 9 anos</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">favorite</span>Você apoia sem precisar ensinar</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">schedule</span>30 dias de acesso</span
              >
            </div>
            <div class="hero-cta">
              <a href="#oferta" class="btn big">
                <span class="material-symbols-rounded">sports_esports</span>Quero ver meu filho criar
                o primeiro jogo
              </a>
            </div>
            <div class="seals">
              <span><span class="material-symbols-rounded">check_circle</span>Sem instalar programas</span>
              <span
                ><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span
              >
              <span
                ><span class="material-symbols-rounded">check_circle</span>Pagamento único</span
              >
            </div>
            <p class="scope-note">
              {
                validCoupon
                  ? `De ${priceLabelShort} por ${displayedTotal}, pagamento único · cupom ${validCoupon.code} aplicado · 30 dias de acesso · garantia de 7 dias`
                  : `${priceLabel}, pagamento único · 30 dias de acesso · garantia de 7 dias`
              }
            </p>
            {
              (coupon.status === 'invalid' || coupon.status === 'error') && (
                <p class="coupon-alert" role="alert">
                  <strong>Cupom {coupon.code || 'informado'}:</strong> {coupon.message} O checkout não
                  fará cobrança sem você confirmar o valor.
                </p>
              )
            }
          </div>
          <figure class="art hero-art">
            <div class="glow"></div>
            <img
              src={img('hero.webp')}
              alt="Criança criando o primeiro jogo no computador com o Zappy ao lado e os pais atrás"
              width="1000"
              height="1263"
              fetchpriority="high"
            />
          </figure>
        </div>
        <!-- personagem como apoio visual; a comunicação comercial segue dirigida aos pais -->
        <div class="kid reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('zappy-fala.webp')}
                alt="Zappy, o vagalume do desafio"
                width="360"
                height="458"
                loading="lazy"
              />
            </figure>
            <span class="name">Zappy</span>
          </div>
          <div class="bubble">
            Seu papel é reservar o momento e celebrar as pequenas entregas. As aulas mostram o
            caminho para a criança, passo a passo. Você acompanha sem precisar ensinar.
          </div>
        </div>
      </div>
    </section>

    <!-- ===== STATS ===== -->
    <section class="stats-band">
      <div class="wrap">
        <div class="stats">
          <div class="stat"><div class="n">5 etapas</div><div class="l">uma parte nova por encontro</div></div>
          <div class="stat">
            <div class="n">30 dias</div><div class="l">para organizar a trilha</div>
          </div>
          <div class="stat">
            <div class="n">{priceLabelShort}</div><div class="l">uma vez, sem mensalidade</div>
          </div>
        </div>
        <div class="market">
          A proposta não é aumentar o tempo de tela. É dar outra direção para uma parte do tempo
          digital que já existe na rotina.
        </div>
      </div>
    </section>

    <!-- ===== DUAS TELAS ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">Vamos começar pelo que preocupa você</span>
        <h2 class="reveal">Mais tempo de tela não é a resposta.</h2>
        <p class="sub">
          Uma atividade não deixa de exigir equilíbrio só porque é educativa. Ao mesmo tempo,
          jogos e tecnologia já fazem parte da rotina, da escola e das conversas das crianças. A
          oportunidade aqui é mudar o que acontece durante uma pequena parte desse tempo.
        </p>
        <div class="two">
          <div class="screen neg reveal">
            <h3>
              <span class="material-symbols-rounded">sentiment_dissatisfied</span>Quando ele só joga
            </h3>
            <figure class="art">
              <img
                src={img('crianca-passiva.webp')}
                alt="Criança entediada no sofá, rolando vídeos no celular"
                width="880"
                height="692"
                loading="lazy"
              />
            </figure>
            <p>
              O jogo chega pronto. Seu filho segue as regras, vence fases criadas por outra pessoa e
              fecha a tela sem algo próprio para mostrar.
            </p>
            <div class="tags">
              <div class="tag">
                <span class="material-symbols-rounded">timer_off</span>Regras definidas por outra pessoa
              </div>
              <div class="tag">
                <span class="material-symbols-rounded">block</span>Sem um projeto próprio no final
              </div>
            </div>
          </div>
          <div class="screen pos reveal">
            <h3>
              <span class="material-symbols-rounded">celebration</span>Quando ele cria o jogo
            </h3>
            <figure class="art">
              <img
                src={img('crianca-criando.webp')}
                alt="A mesma criança empolgada criando o jogo da nave, com o Zappy comemorando"
                width="880"
                height="581"
                loading="lazy"
              />
            </figure>
            <p>
              Ele escolhe, monta, testa, encontra um erro, ajusta e vê o jogo responder ao que fez.
              No fim, chama alguém para jogar uma criação que antes existia apenas como ideia.
            </p>
            <div class="tags">
              <div class="tag">
                <span class="material-symbols-rounded">stadia_controller</span>Comandos e regras que ele montou
              </div>
              <div class="tag">
                <span class="material-symbols-rounded">emoji_events</span>Uma versão jogável para compartilhar
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== A ATENÇÃO DELE (coração) ===== -->
    <section class="sec culpa">
      <div class="wrap center">
        <span class="eyebrow">O interesse já está aí</span>
        <h2 class="reveal">O que ele pratica<br />enquanto o jogo ganha forma.</h2>
        <p class="sub">
          Enquanto seu filho se envolve com a nave, os tiros e os asteroides, ele precisa tomar
          decisões para fazer o jogo funcionar. É isso que transforma uma parte do tempo digital
          em experiência de criação.
        </p>
        <div class="box reveal">
          <div class="box-grid">
            <figure class="art alivio-art">
              <img
                src={img('alivio.webp')}
                alt="Zappy com a mão no peito e um coração ao lado, passando calma"
                width="520"
                height="746"
                loading="lazy"
              />
            </figure>
            <p>
              O Desafio parte de algo que a criança já conhece. Em vez de receber todas as regras
              prontas, ela monta uma parte, testa o que aconteceu e decide o próximo ajuste.
            </p>
          </div>
        </div>
        <div class="thesis reveal">
          Para chegar ao jogo pronto, seu filho organiza o projeto em partes, relaciona cada
          comando ao que acontece na tela, encontra erros e testa soluções. Tudo isso aparece no
          próprio jogo, sem depender de uma promessa abstrata.
        </div>
        <div class="shift">
          <div class="card reveal">
            <div class="from">Quando a nave sai da tela</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Ele aprende a criar um
              limite
            </div>
            <p>
              A criança combina posição, movimento e condição para manter a nave dentro do espaço
              do jogo.
            </p>
          </div>
          <div class="card reveal">
            <div class="from">Quando o ponto não aparece</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Ele relaciona causa e
              consequência
            </div>
            <p>
              Ele verifica a colisão, o valor da pontuação e a ordem dos comandos até o placar
              responder.
            </p>
          </div>
          <div class="card reveal">
            <div class="from">Quando um comando falha</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Ele procura, testa e
              corrige
            </div>
            <p>
              O erro vira uma pista. Ele observa o resultado, muda um bloco e testa de novo.
            </p>
          </div>
        </div>
        <div class="thesis verde reveal">
          Cada criança vive a experiência de um jeito. O Desafio oferece prática guiada; não promete
          resultado escolar, clínico ou comportamental específico.
        </div>
      </div>
    </section>

    <!-- ===== COMO FUNCIONA ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">O projeto dos cinco dias</span>
        <h2 class="reveal">Cinco dias. Uma parte nova do jogo<br />funcionando a cada dia.</h2>
        <p class="sub">
          A sequência é recomendada; cada família pode organizar os encontros dentro dos 30 dias
          de acesso.
        </p>
      </div>
      <div class="wrap">
        <div class="days">
          <div class="day reveal">
            <div class="num">1</div>
            <div>
              <h3>A nave ganha vida</h3>
              <p>
                Seu filho conhece o estúdio, monta a base e vê o primeiro comando aparecer na tela.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia1.webp')}
                alt="Jogo do Dia 1: a nave voando no espaço"
                width="788"
                height="474"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">2</div>
            <div>
              <h3>A nave responde</h3>
              <p>
                Ele cria movimento e tiro e percebe que cada bloco muda o comportamento do jogo.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia2.webp')}
                alt="Jogo do Dia 2: a nave atirando no espaço"
                width="788"
                height="474"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">3</div>
            <div>
              <h3>O desafio aparece</h3>
              <p>
                Asteroides entram em cena, se movem e transformam a criação em algo jogável.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia3.webp')}
                alt="Jogo do Dia 3: os asteroides caindo enquanto a nave atira"
                width="788"
                height="474"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">4</div>
            <div>
              <h3>O jogo passa a lembrar</h3>
              <p>
                Pontos, vidas, colisões e feedback dão consequência às escolhas.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia4.webp')}
                alt="Jogo do Dia 4: o placar de pontos e os corações de vida na tela"
                width="788"
                height="474"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">5</div>
            <div>
              <h3>Começo, vitória e derrota</h3>
              <p>
                Ele fecha o ciclo, testa e publica um link para outras pessoas jogarem.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia5.webp')}
                alt="Jogo do Dia 5: a tela de início do jogo pronto, com o nome Nave contra Asteroides"
                width="788"
                height="474"
                loading="lazy"
              />
            </figure>
          </div>
        </div>
        <!-- personagem como apoio visual; copy dirigida aos pais -->
        <div class="kid verde reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('dede-fala.webp')}
                alt="Dedé, personagem do desafio"
                width="360"
                height="869"
                loading="lazy"
              />
            </figure>
            <span class="name">Dedé</span>
          </div>
          <div class="bubble">
            Os “cinco dias” são a sequência recomendada. Se a rotina apertar, vocês podem pausar e
            retomar o progresso durante os 30 dias de acesso.
          </div>
        </div>
        <div class="thesis compacta reveal">
          <b>Uma entrega por etapa:</b> cada encontro termina com uma parte observável do jogo
          funcionando, para que a criança entenda o que o comando que montou mudou na tela.
        </div>
        <div class="center como-cta">
          <a href="#oferta" class="btn">
            <span class="material-symbols-rounded">rocket_launch</span>Quero ver meu filho criar o
            primeiro jogo
          </a>
        </div>
      </div>
    </section>

    <!-- ===== POR DENTRO DA PLATAFORMA ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">Olha por dentro</span>
        <h2 class="reveal">Veja o caminho que seu filho percorre<br />até o jogo ficar pronto</h2>
        <p class="sub">
          Não é uma coleção de vídeos soltos. A plataforma mostra a próxima etapa, apresenta a ideia
          e abre o espaço de criação no momento de colocar a mão na massa.
        </p>
        <div class="platform-tour">
          <article class="platform-step reveal">
            <div class="platform-copy">
              <span>1</span>
              <h3>Ele sabe por onde começar e qual é o próximo passo</h3>
              <p>
                A trilha organiza o projeto em cinco etapas. O progresso fica visível para a criança
                voltar e continuar de onde parou.
              </p>
            </div>
            <div class="browser">
              <div class="bar">
                <i></i><i></i><i></i><span class="url">kids.sistemazero.com.br</span>
              </div>
              <figure class="art">
                <img
                  src={img('plataforma-trilha.webp')}
                  alt="Trilha atual do Desafio, com os cinco dias e o progresso da criança"
                  width="1180"
                  height="808"
                  loading="lazy"
                />
              </figure>
            </div>
          </article>
          <article class="platform-step reveal">
            <div class="platform-copy">
              <span>2</span>
              <h3>Cada aula entrega uma tarefa pequena de cada vez</h3>
              <p>
                Em vez de receber tudo de uma vez, ele observa uma ideia, faz a parte proposta e
                testa o resultado antes de avançar.
              </p>
            </div>
            <div class="browser">
              <div class="bar">
                <i></i><i></i><i></i><span class="url">kids.sistemazero.com.br</span>
              </div>
              <figure class="art">
                <img
                  src={img('plataforma-aula.webp')}
                  alt="Aula atual do Desafio dividida em seções curtas e sequenciais"
                  width="1180"
                  height="502"
                  loading="lazy"
                />
              </figure>
            </div>
          </article>
          <article class="platform-step reveal">
            <div class="platform-copy">
              <span>3</span>
              <h3>Em pontos importantes, ele experimenta antes de programar</h3>
              <p>
                A criança compara situações na tela, responde ao que observou e chega ao Estúdio já
                entendendo a lógica que vai usar.
              </p>
            </div>
            <div class="browser">
              <div class="bar">
                <i></i><i></i><i></i><span class="url">kids.sistemazero.com.br</span>
              </div>
              <figure class="art">
                <img
                  src={img('plataforma-experimento.webp')}
                  alt="Experimento interativo do Desafio comparando a proteção da nave entre batidas"
                  width="1180"
                  height="1007"
                  loading="lazy"
                />
              </figure>
            </div>
          </article>
          <article class="platform-step reveal">
            <div class="platform-copy">
              <span>4</span>
              <h3>Depois, ele monta e vê o jogo funcionar na mesma tela</h3>
              <p>
                O Estúdio abre dentro da atividade, sem instalação. A paleta mostra os blocos daquela
                etapa, e o resultado aparece ao lado para testar e corrigir.
              </p>
            </div>
            <div class="browser">
              <div class="bar">
                <i></i><i></i><i></i><span class="url">kids.sistemazero.com.br</span>
              </div>
              <figure class="art">
                <img
                  src={img('plataforma-estudio.webp')}
                  alt="Estúdio atual do Desafio com blocos de programação e o jogo funcionando ao lado"
                  width="1180"
                  height="912"
                  loading="lazy"
                />
              </figure>
            </div>
          </article>
        </div>
        <p class="sub plat-note">
          As telas acima foram montadas com o conteúdo e os blocos do próprio Desafio.
        </p>
      </div>
    </section>

    <!-- ===== ENTREGÁVEIS ===== -->
    <section class="sec gifts">
      <div class="wrap center">
        <span class="eyebrow">O que está incluído</span>
        <h2 class="reveal">Tudo o que ele precisa para chegar<br />ao primeiro jogo pronto</h2>
        <p class="sub">
          A trilha, as instruções e o ambiente de criação ficam reunidos no mesmo acesso.
        </p>
        <div class="gift-grid">
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('plataforma-trilha.webp')}
                alt="Trilha guiada com a introdução e os cinco dias do Desafio"
                width="1180"
                height="808"
                loading="lazy"
              />
            </figure>
            <h4>Introdução + trilha guiada de 5 dias</h4>
