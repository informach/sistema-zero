---
// Página de vendas do "Desafio do Primeiro Jogo" (funil kids). Layout PRÓPRIO,
// fiel ao mockup da usuária (tema azul-marinho, ciano + laranja, Fredoka/Nunito,
// gradientes/brilhos/reveal). O CSS sob medida vive no `<style>` escopado abaixo,
// sob `.dpj` (não vaza para as páginas compartilhadas). Os CTAs de compra levam
// `data-checkout-cta` → o PreCheckoutModal (mesma ilha do NCI) abre o checkout.
import '@fontsource/material-symbols-outlined/400.css'
import { EMPRESA } from '../../../content/legal'
import { AVISO_LEGAL_KIDS } from '../../../content/legal-kids'
import { desafioDesejoLabel } from '../../../funnels/desafio-primeiro-jogo/quiz'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 37,00" (boxes de preço). */
  priceLabel: string
  /** "R$ 37" (botões e copy). */
  priceLabelShort: string
  /** "37.00" (JSON-LD). */
  priceReais: string
  imagesBase: string
  perfil: string | null
  /** Desejo (P10) como enum não-PII vindo do quiz; retoma "você disse que sonha ver...". */
  quer?: string | null
  ofertaUrl: string
}
const {
  f,
  productName,
  priceLabel,
  priceLabelShort,
  priceReais,
  imagesBase,
  perfil,
  quer,
  ofertaUrl,
} = Astro.props

// Linha de intro por perfil (vem do quiz, ?perfil=). Usa a `abertura` do hero do
// funil; sem perfil/sem quiz cai na variação padrão (ou some).
const heroData = f.content.hero
const introPerfil =
  (perfil ? heroData?.porPerfil[perfil]?.abertura : undefined) ?? heroData?.padrao?.abertura
// Eco do desejo (P10) no ponto de decisão. null = tráfego frio (sem quiz) → não renderiza.
const desejo = desafioDesejoLabel(quer)

const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`
const ano = new Date().getFullYear()
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('hero-desafio.webp')}
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={img('hero-desafio.webp')}
    fetchpriority="high"
  />

  <div class="dpj">
    <!-- ===== 1. HERO ===== -->
    <section class="hero">
      <div class="container">
        <img
          class="hero-art reveal"
          src={img('hero-desafio.webp')}
          alt="Desafio do Primeiro Jogo em 3 dias: duas crianças animadas ao lado do robô Zappy"
          width="1000"
          height="1000"
          fetchpriority="high"
        />
        {introPerfil && <p class="perfil-intro reveal">{introPerfil}</p>}
        <h1 class="hero-h1 reveal">
          Use o <span class="word-orange">interesse intenso</span> do seu filho a favor dele: em 3
          dias, ele monta o <span class="word-cyan">primeiro jogo</span>
        </h1>
        <p class="hero-sub reveal">
          Uma trilha guiada, com uma vitória por dia, para transformar uma parte do foco que hoje vai
          para jogos, vídeos, tutoriais ou temas favoritos em uma criação feita por ele. No fim, ele
          monta um jogo de nave que atira em asteroides e gera um link para a família e os amigos
          jogarem.
        </p>
        <div class="pitadas reveal">
          <span class="pitada"
            ><span class="material-symbols-outlined">bolt</span>Resultado já no primeiro dia</span
          >
          <span class="pitada"
            ><span class="material-symbols-outlined">child_care</span>A partir dos 9 anos</span
          >
          <span class="pitada"
            ><span class="material-symbols-outlined">school</span>Você não precisa saber nada</span
          >
          <span class="pitada"
            ><span class="material-symbols-outlined">timer</span>Uma hora por dia</span
          >
        </div>
        <a href="#oferta" class="cta-btn reveal">
          <span class="material-symbols-outlined">rocket_launch</span>
          Quero o primeiro jogo do meu filho em 3 dias
        </a>
        <div class="trust-row reveal">
          <span class="trust-pill"
            ><span class="material-symbols-outlined">lock_open</span>Acesso na hora</span
          >
          <span class="trust-pill"
            ><span class="material-symbols-outlined">verified</span>Garantia de 7 dias</span
          >
          <span class="trust-pill"
            ><span class="material-symbols-outlined">payments</span>Pagamento único</span
          >
        </div>
      </div>
    </section>

    <!-- ===== 2. COMPARAÇÃO PRIMÁRIA ===== -->
    <section class="bg-light section-compare">
      <div class="container">
        <p class="eyebrow reveal">O mesmo foco, dois destinos</p>
        <h2 class="sec-title reveal">
          O mesmo <span class="hl-cyan">foco intenso</span> pode se perder na tela ou virar uma
          <span class="hl-orange">criação</span>
        </h2>
        <p class="sec-sub reveal">
          A energia é a mesma. O que muda é para onde ela aponta.
        </p>
        <div class="comp2">
          <div class="comp-side comp-bad reveal">
            <div class="comp-head">
              <span class="comp-icon x"><span class="material-symbols-outlined">close</span></span
              >O foco que só se gasta
            </div>
            <p class="comp-scene">
              A criança mergulha horas no jogo e no vídeo que outra pessoa fez, e levanta do computador
              com a cabeça cheia e as mãos vazias. No domingo à noite, todo aquele foco escorreu sem
              deixar nada.
            </p>
            <div class="comp-metric">
              <span>Horas de foco intenso, nada construído</span>
              <span>Nada que tenha saído das mãos dele</span>
            </div>
          </div>
          <div class="comp-side comp-good reveal">
            <div class="comp-head">
              <span class="comp-icon v"><span class="material-symbols-outlined">check</span></span
              >O foco que constrói
            </div>
            <p class="comp-scene">
              A criança aponta o mesmo foco para criar. Uma hora por dia, ela segue o passo a passo e
              vê o personagem ganhar vida na tela. No terceiro dia, chama a família para mostrar o jogo
              que ela mesma montou.
            </p>
            <div class="comp-metric">
              <span>3 dias, 1 jogo feito por ele</span>
              <span>Algo concreto pra mostrar e contar</span>
            </div>
          </div>
        </div>
        <img
          class="paraquem-art reveal"
          src={img('comparacao-criancas.webp')}
          alt="Duas crianças animadas, prontas para criar o próprio jogo"
          width="700"
          height="933"
          loading="lazy"
        />
      </div>
    </section>

    <!-- ===== 3. TABELA COMPARAÇÃO ===== -->
    <section class="bg-deep">
      <div class="container">
        <span class="shimmer-line reveal"></span>
        <p class="eyebrow reveal">O que muda na prática</p>
        <h2 class="sec-title reveal">
          A diferença está no <span class="hl-cyan">caminho</span>, não no seu filho
        </h2>
        <p class="sec-sub reveal">
          Um foco intenso se perde num tutorial solto, e ganha corpo numa trilha feita pra terminar.
        </p>
        <div class="ctable">
          <div class="ctable-row head">
            <div class="ctable-cell left">Tutorial solto no YouTube</div>
            <div class="ctable-cell right">Trilha do Primeiro Jogo</div>
          </div>
          <div class="ctable-row">
            <div class="ctable-cell left">
              <span class="material-symbols-outlined">close</span>Precisa instalar e configurar antes
              de criar qualquer coisa
            </div>
            <div class="ctable-cell right">
              <span class="material-symbols-outlined">check</span>Estúdio aberto na própria aula, sem
              instalar nada, e blocos feitos pra criança montar o jogo
            </div>
          </div>
          <div class="ctable-row">
            <div class="ctable-cell left">
              <span class="material-symbols-outlined">close</span>A criança se perde na quinta
              instrução e fecha o vídeo
            </div>
            <div class="ctable-cell right">
              <span class="material-symbols-outlined">check</span>Um passo isolado por vez, com
              retorno visual na tela
            </div>
          </div>
          <div class="ctable-row">
            <div class="ctable-cell left">
              <span class="material-symbols-outlined">close</span>O resultado nunca fica pronto,
              sempre falta uma parte
            </div>
            <div class="ctable-cell right">
              <span class="material-symbols-outlined">check</span>Uma vitória por dia, jogo completo
              no terceiro
            </div>
          </div>
          <div class="ctable-row">
            <div class="ctable-cell left">
              <span class="material-symbols-outlined">close</span>Você precisa sentar do lado
              interpretando cada passo
            </div>
            <div class="ctable-cell right">
              <span class="material-symbols-outlined">check</span>A criança avança com autonomia, você
              só garante o tempo
            </div>
          </div>
          <div class="ctable-row">
            <div class="ctable-cell left">
              <span class="material-symbols-outlined">close</span>Termina a tarde frustrado, sem nada
              pra mostrar
            </div>
            <div class="ctable-cell right">
              <span class="material-symbols-outlined">check</span>Termina chamando a família pra ver o
              jogo funcionando
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 4. DIÁLOGO MENTAL NEGATIVO ===== -->
    <section class="bg-grid">
      <div class="container">
        <p class="eyebrow reveal">A gente sabe o que passa na sua cabeça</p>
        <h2 class="sec-title reveal">
          Você olha esse foco todo e pensa que, se fosse pra algo <span class="hl-orange">útil</span>,
          seria outra história
        </h2>
        <p class="sec-sub reveal">E aí vêm aqueles pensamentos que você não fala pra ninguém.</p>
        <div class="thoughts">
          <div class="thought reveal">
            Ele sabe tudo do jogo favorito, mas esquece o dever de casa. <strong>Esse foco todo devia
            dar em alguma coisa.</strong>
          </div>
          <div class="thought reveal">
            Ele passa horas no mesmo assunto sem cansar. <strong>E essa energia toda vai pro ralo.</strong>
          </div>
          <div class="thought reveal">
            Esse foco intenso às vezes atrapalha o resto. <strong>Queria que ele virasse uma força de
            verdade.</strong>
          </div>
          <div class="thought reveal">
            No fim das contas, vira só mais tela. <strong>E eu fico assistindo o tempo passar.</strong>
          </div>
          <div class="thought reveal">
            As férias estão chegando. <strong>Vai ser o dia inteiro no mesmo jogo outra vez.</strong>
          </div>
          <div class="thought reveal">
            Todo mundo fala em programação pra criança. <strong>Mas eu não sei se serve pro meu filho,
            do jeito que ele é.</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 5. A CULPA NÃO É SUA ===== -->
    <section class="bg-light">
      <div class="container culpa-block">
        <p class="eyebrow reveal">Sobre esse foco que às vezes parece atrapalhar</p>
        <h2 class="sec-title reveal" style="text-align:left">
          O seu filho consegue focar como poucos. Só que esse foco nunca foi apontado pra criação.
        </h2>
        <p class="sec-sub reveal" style="text-align:left;margin-bottom:36px">
          A intensidade que atrapalha na hora de largar o jogo é a mesma que constrói, quando ganha
          direção.
        </p>

        <p class="culpa-sub reveal">Você provavelmente já reparou:</p>
        <ul class="culpa-list reveal">
          <li>
            <span class="material-symbols-outlined">check_circle</span>Ele decora cada detalhe do que
            ama, e às vezes o dever de casa fica pra trás.
          </li>
          <li>
            <span class="material-symbols-outlined">check_circle</span>Ele passa horas no mesmo
            assunto sem cansar, e você pensa que essa energia toda podia virar algo útil.
          </li>
          <li>
            <span class="material-symbols-outlined">check_circle</span>Ele larga um monte de coisa no
            meio do caminho, menos aquilo em que é fixado.
          </li>
        </ul>

        <div class="culpa-alivio reveal">
          Repara no que isso mostra: foco não falta, falta direção. O caminho é dar a essa energia um
          destino que ele mesmo queira seguir até o fim, em vez de tentar obrigá-lo a se concentrar. É
          o que estes 3 dias fazem: pegam o foco que já existe e transformam em algo criado por ele.
        </div>

        <p class="culpa-sub reveal">O que faz esse foco ir até o fim:</p>
        <div class="culpa-shift reveal">
          <div class="shift-card">
            <div class="shift-flow">
              <span class="shift-old"
                ><span class="material-symbols-outlined">close</span>Estudar primeiro, criar depois</span
              ><span class="material-symbols-outlined">arrow_forward</span><span class="shift-new"
                ><span class="material-symbols-outlined">check</span>Criar desde o primeiro minuto</span
              >
            </div>
            <p>
              O cérebro da criança foi calibrado pra resultado rápido. Por isso o personagem se mexe
              já no Dia 1, antes de qualquer explicação longa. A vitória vem antes do cansaço.
            </p>
          </div>
          <div class="shift-card">
            <div class="shift-flow">
              <span class="shift-old"
                ><span class="material-symbols-outlined">close</span>Curso longo de muitas aulas</span
              ><span class="material-symbols-outlined">arrow_forward</span><span class="shift-new"
                ><span class="material-symbols-outlined">check</span>Uma vitória por dia, três dias</span
              >
            </div>
            <p>
              O que cabe na atenção de uma criança é uma sessão curta que fecha com algo pronto. Três
              dias, três conquistas que ela vê na tela.
            </p>
          </div>
          <div class="shift-card">
            <div class="shift-flow">
              <span class="shift-old"
                ><span class="material-symbols-outlined">close</span>Pai ensinando do lado</span
              ><span class="material-symbols-outlined">arrow_forward</span><span class="shift-new"
                ><span class="material-symbols-outlined">check</span>Trilha que guia a criança com
                autonomia</span
              >
            </div>
            <p>
              Quando o caminho está claro o suficiente, a criança não precisa de ninguém interpretando
              instrução. Você garante o computador e o horário, ela faz o resto no ritmo dela.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 6. FAÇA AS CONTAS ===== -->
    <section class="bg-deep">
      <div class="container">
        <span class="shimmer-line orange reveal"></span>
        <p class="eyebrow reveal">Coloca na ponta do lápis</p>
        <h2 class="sec-title reveal">
          Pega a mensalidade da escola de programação e <span class="hl-orange">faz a conta comigo</span>
        </h2>
        <p class="sec-sub reveal">
          Antes de assinar mensalidade, vale comparar o que você arrisca de cada lado.
        </p>
        <div class="contas-grid">
          <div class="conta-card conta-a reveal">
            <h3><span class="material-symbols-outlined">trending_down</span>Escola de programação infantil</h3>
            <div class="conta-line"><span>Mensalidade</span><span>R$ 200 a R$ 350</span></div>
            <div class="conta-line"><span>Matrícula inicial</span><span>cobrada à parte</span></div>
            <div class="conta-line">
              <span>Quando vê o primeiro jogo pronto</span><span>semanas depois</span>
            </div>
            <div class="conta-line">
              <span>Se ele desistir na 2ª semana</span><span>já pagou o mês</span>
            </div>
            <div class="conta-line total">
              <span>Risco até a 1ª prova real</span><span class="val">R$ 200+</span>
            </div>
          </div>
          <div class="conta-card conta-b reveal">
            <h3><span class="material-symbols-outlined">trending_up</span>Desafio do Primeiro Jogo</h3>
            <div class="conta-line">
              <span>Pagamento</span><span>{priceLabelShort}, uma vez</span>
            </div>
            <div class="conta-line"><span>Matrícula ou mensalidade</span><span>nenhuma</span></div>
            <div class="conta-line"><span>Quando vê algo na tela</span><span>no 1º dia</span></div>
            <div class="conta-line"><span>Quando o jogo fica pronto</span><span>no 3º dia</span></div>
            <div class="conta-line total">
              <span>Risco total</span><span class="val">{priceLabelShort}</span>
            </div>
          </div>
        </div>
        <p class="conta-impacto reveal">
          Pelo preço de um lanche, você descobre se vale a pena investir no caminho completo, com o
          jogo na mão. A primeira mensalidade de escola custa
          <span class="num">mais de 5 vezes isso</span>, antes de qualquer prova de que funciona pro
          seu filho.
        </p>
        <p class="conta-impacto reveal">
          E tem o outro custo, o das muitas horas por ano em que esse foco já vai para a tela sem
          virar nada feito por ele.
        </p>
        <p class="hyp-note reveal" style="color:var(--text-tertiary)">
          Valores de mensalidade são exemplos baseados na média do mercado. Confira os preços
          praticados na sua cidade.
        </p>
      </div>
    </section>

    <!-- ===== 7. CENTRO DA ATENÇÃO ===== -->
    <section class="bg-dark">
      <div class="container">
        <p class="eyebrow reveal">O que muda quando o personagem ganha vida</p>
        <h2 class="sec-title reveal">Tudo gira em torno do <span class="hl-cyan">jogo na tela</span></h2>
        <p class="sec-sub reveal">
          No primeiro dia, a criança faz o personagem se mexer. A partir daí, tudo o que importa
          começa a acontecer.
        </p>
        <div class="centro-wrap">
          <div class="centro-core reveal">
            <img
              class="centro-art"
              src={img('estudio-jogo.webp')}
              alt="Tela do Sistema Zero Studio: os blocos à esquerda e o jogo de nave rodando"
              width="820"
              height="463"
              loading="lazy"
            />
            <h3 style="margin-top:18px">O jogo na tela</h3>
            <p>
              O personagem que responde ao comando da criança e prova, na hora, que ela consegue
              criar.
            </p>
          </div>
          <ul class="centro-list reveal">
            <li><span class="material-symbols-outlined">chevron_right</span>Resultado no primeiro dia</li>
            <li><span class="material-symbols-outlined">chevron_right</span>Ela começou e terminou algo</li>
            <li><span class="material-symbols-outlined">chevron_right</span>Vira criadora, não só jogadora</li>
            <li><span class="material-symbols-outlined">chevron_right</span>Algo concreto pra mostrar</li>
            <li><span class="material-symbols-outlined">chevron_right</span>Link pra mandar pros amigos jogarem</li>
            <li><span class="material-symbols-outlined">chevron_right</span>Confiança de "eu consigo"</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== 8. DINÂMICA DE ACESSO ===== -->
    <section class="bg-light">
      <div class="container">
        <p class="eyebrow reveal">Do acesso ao jogo pronto</p>
        <h2 class="sec-title reveal">É mais simples do que parece. Olha o caminho:</h2>
        <p class="sec-sub reveal">
          Três dias, uma vitória por dia, tudo dentro do mesmo ambiente, sem instalar nada.
        </p>
        <div class="steps">
          <div class="step-card reveal">
            <div class="step-badge">1</div>
            <h3>A nave ganha vida</h3>
            <p>
              Seguindo o passo a passo, a criança monta os primeiros blocos e vê a nave dela aparecer
              no espaço e voar com as setas.
            </p>
          </div>
          <div class="step-card reveal">
            <div class="step-badge">2</div>
            <h3>O jogo ganha ação</h3>
            <p>
              Ela faz a nave atirar, os asteroides caírem e marca um ponto a cada asteroide
              destruído.
            </p>
          </div>
          <div class="step-card reveal">
            <div class="step-badge">3</div>
            <h3>Pronto pra mostrar</h3>
            <p>
              Ela cria a tela de vitória, testa o jogo inteiro e gera um link pra mandar pros amigos e
              a família jogarem.
            </p>
          </div>
        </div>
        <p class="metodo-label reveal">O método: Trilha do Primeiro Jogo</p>
        <img
          class="metodo-art reveal"
          src={img('trilha-3-dias.webp')}
          alt="Trilha do Primeiro Jogo: o método em 3 dias, do personagem ganhar vida ao jogo pronto"
          width="1200"
          height="675"
          loading="lazy"
        />
        <div style="text-align:center;margin-top:40px" class="reveal">
          <a href="#oferta" class="cta-btn cyan">
            <span class="material-symbols-outlined">sports_esports</span>
            Quero começar o desafio hoje
          </a>
          <p class="access-note">
            Acesso imediato após a confirmação. Pagamento único. Acesso vitalício.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== 9. QUEM É O ESPECIALISTA ===== -->
    <section class="bg-deep esp-section">
      <div class="container">
        <p class="eyebrow reveal">Quem conduz o desafio</p>
        <h2 class="sec-title reveal">Quem está por trás do <span class="hl-orange">Desafio</span></h2>
        <p class="sec-sub reveal">
          Helena e Júlio, do @criecomhelenaejulio, criando junto com crianças reais.
        </p>
        <div class="esp-wrap">
          <img
            class="esp-photo-img reveal"
            src={img('helena-julio-familia.webp')}
            alt="Helena e Júlio, criadores do desafio"
            width="760"
            height="797"
            loading="lazy"
          />
          <div class="esp-text reveal">
            <h3>Helena e Júlio</h3>
            <p class="esp-tag">Criação de jogos para crianças a partir dos 9 anos</p>
            <p>
              Somos Helena e Júlio, <span class="hl-orange">desenvolvedores de sistemas</span>
              formados em Sistemas de Informação. Há mais de dez anos a gente cria software de verdade,
              com passagem por empresas como o Banco do Brasil, e hoje no setor agrícola. Programar é o
              nosso dia a dia.
            </p>
            <p>
              Mas quem nos trouxe até aqui foi o nosso filho, o <span class="hl-orange">André</span>,
              <span class="hl-orange">autista nível 1</span>, com hiperfoco em jogos. Quando ele tinha
              7 anos, a gente estava muito preocupada: o foco dele vivia só no jogar, e isso
              atrapalhava o resto. A virada veio quando a gente parou de competir com os jogos e passou
              a ensinar o André a <span class="hl-orange">criar os próprios</span>, em vez de só jogar
              o que os outros fazem. Ele entrou de cabeça, cheio de ideias.
            </p>
            <p>
