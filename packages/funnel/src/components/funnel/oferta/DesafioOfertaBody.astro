    background: linear-gradient(180deg, #06101a 0%, #0a1726 100%);
  }
  /* Seção "quem conduz": fundo IGUAL ao da arte (#000811) p/ a foto fundir sem emenda. */
  .dpj .esp-section {
    background: #000811;
  }
  .dpj .bg-grid {
    background-color: #081320;
    background-image:
      linear-gradient(rgba(14, 165, 233, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(14, 165, 233, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .dpj .bg-light {
    background: var(--light-bg);
    color: var(--ink-light);
  }
  /* Seção 2 (comparação): fundo IGUAL ao da arte (#e9f0f8) p/ a imagem fundir sem emenda. */
  .dpj .section-compare {
    background: #e9f0f8;
  }
  .dpj .bg-light h2,
  .dpj .bg-light h3,
  .dpj .bg-light h4 {
    color: var(--ink-light);
  }
  .dpj .bg-orange {
    background: linear-gradient(135deg, #f9a825 0%, #f57c00 100%);
    color: #1a1207;
  }
  .dpj .bg-orange h2,
  .dpj .bg-orange h3 {
    color: #1a1207;
  }

  /* ===== Animação scroll ===== */
  .dpj .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  .dpj .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  @keyframes dpj-floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes dpj-shimmer {
    0%,
    100% {
      opacity: 0.4;
      width: 60px;
    }
    50% {
      opacity: 1;
      width: 96px;
    }
  }
  .dpj .shimmer-line {
    width: 64px;
    height: 3px;
    border-radius: 3px;
    margin: 0 auto 26px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: dpj-shimmer 3s ease-in-out infinite;
  }
  .dpj .shimmer-line.orange {
    background: linear-gradient(90deg, transparent, var(--accent-2), transparent);
  }

  /* ===== Section headers ===== */
  .dpj .eyebrow {
    text-align: center;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
    font-family: var(--font-body);
  }
  .dpj .bg-light .eyebrow {
    color: #0277bd;
  }
  .dpj .bg-orange .eyebrow {
    color: #7a3e00;
  }
  .dpj .sec-title {
    text-align: center;
    font-size: clamp(1.7rem, 4.2vw, 2.7rem);
    font-weight: 700;
    margin-bottom: 16px;
  }
  .dpj .sec-sub {
    text-align: center;
    font-size: 1.08rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 52px;
    line-height: 1.65;
  }
  .dpj .bg-light .sec-sub {
    color: #4c5d70;
  }
  .dpj .bg-orange .sec-sub {
    color: #4a2e08;
  }
  .dpj .hl-cyan {
    color: var(--accent);
  }
  .dpj .hl-orange {
    color: var(--accent-2);
  }
  .dpj .bg-light .hl-cyan {
    color: #0277bd;
  }
  .dpj .bg-light .hl-orange {
    color: #e07b00;
  }
  /* Intro por perfil: retoma o diagnóstico de forma IMPLÍCITA (sem anunciar), leve. */
  .dpj .perfil-intro {
    text-align: center;
    font-family: var(--font-head);
    font-weight: 500;
    color: var(--accent);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 560px;
    margin: 0 auto 16px;
  }
  /* Eco do desejo (P10) no ponto de decisão da oferta. */
  .dpj .diag-desejo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    max-width: 660px;
    margin: 0 auto 34px;
    padding: 15px 22px;
    background: var(--orange-glow);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 14px;
    text-align: center;
    font-size: 1.04rem;
    color: var(--text-secondary);
  }
  .dpj .diag-desejo .material-symbols-outlined {
    font-size: 20px;
    color: var(--accent-2);
    flex-shrink: 0;
  }

  /* ===== Header ===== */
  .dpj .brand {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.18rem;
    color: var(--text-primary);
  }
  /* ===== CTA buttons ===== */
  .dpj .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 38px;
    font-family: var(--font-head);
    font-size: 1.08rem;
    font-weight: 700;
    color: #1a1207;
    background: var(--cta-color);
    border: none;
    border-radius: 14px;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 6px 26px rgba(245, 158, 11, 0.38);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .dpj .cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 34px rgba(245, 158, 11, 0.5);
  }
  .dpj .cta-btn .material-symbols-outlined {
    font-size: 22px;
  }
  .dpj .cta-btn.cyan {
    background: var(--accent);
    color: #04222f;
    box-shadow: 0 6px 26px rgba(14, 165, 233, 0.4);
  }
  .dpj .cta-btn.cyan:hover {
    box-shadow: 0 12px 34px rgba(14, 165, 233, 0.52);
  }

  .dpj .access-note {
    text-align: center;
    font-size: 0.86rem;
    color: var(--text-tertiary);
    margin-top: 14px;
  }
  .dpj .bg-light .access-note {
    color: #6b7c8e;
  }

  .dpj .trust-row {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .dpj .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .dpj .trust-pill .material-symbols-outlined {
    font-size: 17px;
    color: var(--accent);
  }

  /* ===== HERO ===== */
  .dpj .hero {
    /* Fundo IGUAL ao da arte do hero (#00030e) p/ a imagem fundir sem emenda. */
    background: #00030e;
    padding-top: 48px;
    padding-bottom: 80px;
    text-align: center;
  }
  .dpj .hero-h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 700;
    max-width: 22ch;
    margin: 0 auto 22px;
  }
  .dpj .hero-h1 .word-cyan {
    color: var(--accent);
  }
  .dpj .hero-h1 .word-orange {
    color: var(--accent-2);
  }
  .dpj .hero-sub {
    font-size: 1.16rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 28px;
  }
  .dpj .pitadas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 720px;
    margin: 0 auto 34px;
  }
  .dpj .pitada {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 15px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .dpj .pitada .material-symbols-outlined {
    font-size: 16px;
    color: var(--accent-2);
  }
  .dpj .mascote {
    font-size: 3.2rem;
    margin: 0 auto 8px;
    animation: dpj-floaty 3.5s ease-in-out infinite;
    width: max-content;
  }
  .dpj .hero-art {
    display: block;
    width: 100%;
    max-width: 350px;
    height: auto;
    margin: 0 auto 14px;
  }

  /* ===== Comparação primária ===== */
  .dpj .comp2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    max-width: 920px;
    margin: 0 auto;
  }
  .dpj .comp-side {
    border-radius: 18px;
    padding: 30px 26px;
  }
  .dpj .comp-bad {
    background: #eef2f6;
    border: 1.5px solid #d7dee6;
  }
  .dpj .comp-good {
    background: #e8f7ff;
    border: 1.5px solid #b6e3fb;
  }
  .dpj .comp-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.18rem;
    margin-bottom: 12px;
    color: var(--ink-light);
  }
  .dpj .comp-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .dpj .comp-icon.x {
    background: var(--fail-red-dim);
    color: var(--fail-red);
  }
  .dpj .comp-icon.v {
    background: var(--ok-green-dim);
    color: var(--ok-green);
  }
  .dpj .comp-icon .material-symbols-outlined {
    font-size: 22px;
  }
  .dpj .comp-scene {
    font-size: 0.98rem;
    color: #4c5d70;
    line-height: 1.6;
    margin-bottom: 18px;
  }
  .dpj .comp-metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dpj .comp-metric span {
    font-size: 0.9rem;
    color: #36475a;
    padding: 9px 12px;
    background: rgba(255, 255, 255, 0.65);
    border-radius: 9px;
  }
  .dpj .comp-bad .comp-metric span {
    color: #7a5050;
  }
  .dpj .comp-good .comp-metric span {
    color: #0b5e7e;
    background: rgba(255, 255, 255, 0.8);
  }
  .dpj .hyp-note {
    text-align: center;
    font-size: 0.82rem;
    color: #6b7c8e;
    margin-top: 22px;
  }
  .dpj .paraquem-art {
    display: block;
    width: 100%;
    max-width: 240px;
    height: auto;
    margin: 36px auto 0;
  }

  /* ===== Tabela comparação ===== */
  .dpj .ctable {
    max-width: 880px;
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .dpj .ctable-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .dpj .ctable-row.head .ctable-cell {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.02rem;
  }
  .dpj .ctable-cell {
    padding: 16px 18px;
    font-size: 0.95rem;
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }
  .dpj .ctable-cell.left {
    background: var(--surface-1);
    color: var(--text-secondary);
    border-right: 1px solid var(--border);
  }
  .dpj .ctable-cell.right {
    background: rgba(14, 165, 233, 0.07);
    color: var(--text-primary);
  }
  .dpj .ctable-row:nth-child(even) .ctable-cell.left {
    background: var(--surface-2);
  }
  .dpj .ctable-row:nth-child(even) .ctable-cell.right {
    background: rgba(14, 165, 233, 0.11);
  }
  .dpj .ctable-cell .material-symbols-outlined {
    font-size: 19px;
    margin-top: 1px;
    flex-shrink: 0;
  }
  .dpj .ctable-cell.left .material-symbols-outlined {
    color: var(--fail-red);
  }
  .dpj .ctable-cell.right .material-symbols-outlined {
    color: var(--ok-green);
  }
  .dpj .ctable-row.head .ctable-cell.left {
    background: #1a2433;
    color: var(--text-secondary);
  }
  .dpj .ctable-row.head .ctable-cell.right {
    background: var(--accent);
    color: #04222f;
  }

  /* ===== Diálogo mental (balões) ===== */
  .dpj .thoughts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    max-width: 880px;
    margin: 0 auto;
  }
  .dpj .thought {
    background: var(--glass-bg);
    backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    border-radius: 18px 18px 18px 6px;
    padding: 22px 24px;
    position: relative;
    font-size: 1rem;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.55;
  }
  .dpj .thought strong {
    color: var(--accent-2);
    font-style: normal;
  }
  .dpj .thought::before {
    content: '“';
    position: absolute;
    top: 6px;
    left: 14px;
    font-size: 2.4rem;
    color: var(--accent);
    opacity: 0.25;
    font-family: Georgia, serif;
  }

  /* ===== Culpa não é sua ===== */
  .dpj .culpa-block {
    max-width: 800px;
    margin: 0 auto;
  }
  .dpj .culpa-sub {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--accent);
    margin: 0 0 16px;
  }
  .dpj .bg-light .culpa-sub {
    color: #0277bd;
  }
  .dpj .culpa-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
    padding: 0;
  }
  .dpj .culpa-list li {
    display: flex;
    gap: 12px;
    font-size: 1.02rem;
    color: #3c4d60;
    line-height: 1.55;
  }
  .dpj .culpa-list .material-symbols-outlined {
    color: var(--accent-2);
    font-size: 22px;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .dpj .culpa-alivio {
    background: var(--light-surface);
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    padding: 24px 26px;
    margin-bottom: 40px;
    font-size: 1.05rem;
    color: #36475a;
    line-height: 1.6;
  }
  .dpj .culpa-shift {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .dpj .shift-card {
    background: var(--light-surface);
    border: 1px solid var(--light-border);
    border-radius: 14px;
    padding: 22px 24px;
  }
  .dpj .shift-card .shift-flow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .dpj .shift-old {
    color: var(--fail-red);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .dpj .shift-new {
    color: var(--ok-green);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .dpj .shift-flow .material-symbols-outlined {
    font-size: 18px;
    color: var(--text-tertiary);
  }
  .dpj .shift-card p {
    font-size: 1rem;
    color: #44566a;
    line-height: 1.6;
  }

  /* ===== Faça as contas ===== */
  .dpj .contas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    max-width: 920px;
    margin: 0 auto;
  }
  .dpj .conta-card {
    border-radius: 18px;
    padding: 30px 28px;
  }
  .dpj .conta-a {
    background: rgba(239, 106, 106, 0.08);
    border: 1px solid rgba(239, 106, 106, 0.25);
  }
  .dpj .conta-b {
    background: rgba(34, 192, 138, 0.08);
    border: 1px solid rgba(34, 192, 138, 0.28);
  }
  .dpj .conta-card h3 {
    font-size: 1.12rem;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dpj .conta-a h3 {
    color: #ff8f8f;
  }
  .dpj .conta-b h3 {
    color: #4fd6a6;
  }
  .dpj .conta-line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.96rem;
    color: var(--text-secondary);
  }
  .dpj .conta-line.total {
    border-bottom: none;
    margin-top: 10px;
    padding-top: 16px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.18rem;
    color: var(--text-primary);
  }
  .dpj .conta-line.total .val {
    color: var(--accent-2);
  }
  .dpj .conta-b .conta-line.total .val {
    color: var(--ok-green);
  }
  .dpj .conta-impacto {
    text-align: center;
    max-width: 760px;
    margin: 32px auto 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    color: var(--text-primary);
    line-height: 1.35;
  }
  .dpj .conta-impacto .num {
    color: var(--accent-2);
  }

  /* ===== Centro da atenção ===== */
  .dpj .centro-wrap {
    max-width: 940px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    align-items: center;
  }
  .dpj .centro-core {
    background: linear-gradient(150deg, var(--accent), #0b7bb0);
    border-radius: 22px;
    padding: 46px 30px;
    text-align: center;
    box-shadow: 0 18px 50px rgba(14, 165, 233, 0.3);
    position: relative;
  }
  .dpj .centro-core h3 {
    color: #fff;
    font-size: 1.4rem;
    margin-bottom: 8px;
  }
  .dpj .centro-core p {
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.95rem;
  }
  .dpj .centro-art {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.4);
  }
  .dpj .centro-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0;
  }
  .dpj .centro-list li {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 13px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .dpj .centro-list .material-symbols-outlined {
    color: var(--accent-2);
    font-size: 18px;
    flex-shrink: 0;
  }

  /* ===== Dinâmica de acesso ===== */
  .dpj .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 940px;
    margin: 0 auto;
  }
  .dpj .step-card {
    background: var(--light-surface);
    border: 1px solid var(--light-border);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: center;
    position: relative;
  }
  .dpj .step-badge {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.3rem;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), #0b7bb0);
  }
  .dpj .step-card:nth-child(2) .step-badge {
    background: linear-gradient(135deg, var(--accent-2), #e07b00);
    color: #1a1207;
  }
  .dpj .step-card:nth-child(3) .step-badge {
    background: linear-gradient(135deg, var(--ok-green), #15976a);
  }
  .dpj .step-card h3 {
    color: var(--ink-light);
    font-size: 1.08rem;
    margin-bottom: 8px;
  }
  .dpj .step-card p {
    color: #5a6b7d;
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .dpj .metodo-label {
    text-align: center;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--ink-light);
    font-size: 1.15rem;
    margin: 48px auto 16px;
  }
  .dpj .metodo-art {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
    border-radius: 18px;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.25);
  }


  /* ===== Especialista ===== */
  .dpj .esp-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 38px;
    align-items: start;
    max-width: 980px;
    margin: 0 auto;
  }
  .dpj .esp-photo-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .dpj .esp-text h3 {
    font-size: 1.5rem;
    margin-bottom: 6px;
  }
  .dpj .esp-text .esp-tag {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 18px;
    font-family: var(--font-body);
  }
  .dpj .esp-text p {
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.65;
    margin-bottom: 14px;
  }
  .dpj .esp-text p strong {
    color: var(--text-primary);
  }

