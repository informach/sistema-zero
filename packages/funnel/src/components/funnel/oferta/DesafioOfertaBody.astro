---
import '../../../styles/kids-oferta.css'
import '../../../styles/comunidade-oferta.css'
import '../../../styles/desafio-farol.css'
import { EMPRESA } from '../../../content/legal'
import {
  DESAFIO_OFFERS,
  type DesafioOfferId,
  desafioSection,
  INCLUDED,
  SECTION_ART,
} from '../../../funnels/desafio-primeiro-jogo/offer'
import { DESAFIO_FAQ, DESAFIO_SECTIONS } from '../../../funnels/desafio-primeiro-jogo/offer-copy'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { funnelLinkWithAttribution } from '../../../lib/lead-attribution'
import { formatBRLFromCents } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import { getDeps } from '../../../server/deps'
import type { OfferPageData } from '../../../server/offer-page'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import ComunidadeImageZoom from './ComunidadeImageZoom.astro'
import DesafioVisual from './DesafioVisual.astro'

type Props = OfferPageData['bodyProps'] & { profile?: DesafioOfferId }
const {
  f,
  productName,
  priceLabelShort,
  priceReais,
  ofertaUrl,
  coupon,
  profile = 'primeiro-jogo',
} = Astro.props
const page = DESAFIO_OFFERS[profile]
const communityImages = '/img/comunidade-dos-criadores'
const validCoupon = coupon.status === 'valid' ? coupon : null
const price = validCoupon ? formatBRLFromCents(validCoupon.finalPriceCents) : priceLabelShort
const checkoutCouponCode = coupon.status === 'none' ? null : coupon.code
const copy = (text: string) => text.replaceAll('{{preco}}', price)
const link = (path: string) => funnelLinkWithAttribution(path, Astro.url)
const checkout = link(`${f.basePath}/checkout`)
const memberUrl = getDeps().env.KIDS_COMMUNITY_URL
const first = page.faqFirst as readonly string[]
const faqGroups = [
  {
    title: 'O começo que vocês procuram',
    icon: 'family_star',
    entries: first.map((id) => DESAFIO_FAQ.find((q) => q.id === id)!),
  },
  {
    title: 'A atividade, a rotina e o apoio',
    icon: 'extension',
    entries: DESAFIO_FAQ.slice(0, 11).filter((q) => !first.includes(q.id)),
  },
  {
    title: 'Acesso, compra e próximos passos',
    icon: 'receipt_long',
    entries: DESAFIO_FAQ.slice(11).filter((q) => !first.includes(q.id)),
  },
]
const faqVisuals: Record<string, string> = {
  'duvida-1': 'aula',
  'duvida-2': 'farol',
  'duvida-3': 'regra',
  'duvida-4': 'aula',
  'duvida-5': 'ajuda',
  'duvida-6': 'aula',
  'duvida-7': 'caderno',
  'duvida-11': 'regra',
  'duvida-12': 'mural',
  'duvida-14': 'mural',
}
---
<BaseLayout title={page.seoTitle} description={f.seoDescription} canonical={ofertaUrl} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass="theme-kids">
  <ProductJsonLd slot="head" name={productName} description={f.seoDescription} price={priceReais} url={ofertaUrl} image={`${f.imagesBase}/farol-capa.webp`}/>
  <link slot="head" rel="preload" as="image" href={`${f.imagesBase}/farol-jogo.png`} fetchpriority="high"/>
  <div class="cdc df" data-desafio-profile={profile}>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <header class="topbar"><div class="wrap nav">
      <a class="brand" href={link('/')} aria-label="Sistema Zero Kids, página inicial"><img class="logo" src={`${communityImages}/logo-kids-escuro.svg`} alt="Sistema Zero Kids" width="279" height="26"/></a>
      <nav class="nav-links" aria-label="Navegação do Desafio"><a href="#experiencia">A experiência</a><a href={link('/como-funciona/')} data-analytics-id="desafio-nav-como-funciona">Como funciona</a><a href="#duvidas">Dúvidas</a></nav>
      <div class="nav-right"><p class="nav-preco">Pagamento único<strong>{price}</strong></p><a class="kof-btn kof-btn--compacta" href="#oferta" data-analytics-id="desafio-nav-oferta">Conhecer a oferta</a></div>
    </div></header>
    <main id="conteudo">
      <section class="hero section" aria-labelledby="hero-title" data-analytics-id="desafio-hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <span class="kof-eyebrow"><span class="material-symbols-rounded" aria-hidden="true">sports_esports</span>Desafio do Primeiro Jogo · 9 a 14 anos</span>
            <h1 class="kof-display" id="hero-title">{page.title}<em>{page.emphasis}</em></h1>
            <p class="kof-lead">{page.lead}</p><p class="df-hero-detail">{page.detail}</p>
            <ul class="hero-benefits">
              {['Conhecer jogando, montar os blocos e testar.', 'Explicações que pode pausar e rever.', 'Uma criação para publicar e mostrar à família.'].map((text,i) => <li><span class:list={['kof-ladrilho', ['','kof-ladrilho--rosa','kof-ladrilho--verde'][i]]} aria-hidden="true"><span class="material-symbols-rounded">{['extension','play_circle','share'][i]}</span></span><span>{text}</span></li>)}
            </ul>
            <p class="df-price-line">{validCoupon && <s>{priceLabelShort}</s>} <strong>{price}, pagamento único.</strong> Curso e Mural completo por 30 dias a partir da aprovação. Depois, Mural visitante para ver e jogar. Sem renovação automática.</p>
            {validCoupon && <p class="df-note">Cupom {validCoupon.code} aplicado nesta cotação.</p>}
            {(coupon.status === 'invalid' || coupon.status === 'error') && <p class="df-alert" role="alert">{coupon.message} Confira o valor antes de confirmar o pagamento.</p>}
            <div class="hero-actions"><a class="kof-btn kof-btn--grande" href={checkout} data-checkout-cta data-analytics-id="desafio-hero-comprar">Quero começar o Desafio<span aria-hidden="true">→</span></a><a class="kof-link" href="#aventura">Ver o que meu filho vai criar<span aria-hidden="true">↓</span></a></div>
            <p class="requirements df-note">Computador com internet, mouse e teclado. Aulas gravadas e ajuda por mensagens. <a class="kof-link kof-link--inline" href="#requisitos">Confira as condições.</a></p>
          </div>
          <div class="hero-visual df-hero-visual"><div class="kof-palco df-hero-stage"><span class="kof-chip kof-chip--verde">Um personagem. Uma chave. Uma decisão.</span><DesafioVisual visual="farol" eager/><img class="df-zappy" src={`${communityImages}/zappy-happy.webp`} alt="" width="300" height="300"/><span class="kof-chip">O primeiro convite é conhecer a aventura.</span></div></div>
        </div>
      </section>

      {page.sections.map((id,index) => { const section=desafioSection(id,profile); const art=SECTION_ART[id]; return <section id={id} class:list={['section capitulo',`cor-${art.color}`,index%3===1?'fundo-folha':index%3===2?'fundo-alt':'']} aria-labelledby={`title-${id}`} data-analytics-id={`desafio-${id}`}>
        <div class="wrap">
          <div class="cap-head"><span class="cap-chip"><span class="material-symbols-rounded cap-chip-icone" aria-hidden="true">{art.icon}</span><span class="cap-chip-texto">{art.label}</span></span><h2 class="kof-display" id={`title-${id}`}>{section.title}</h2><p class="cap-lead">{copy(section.paragraphs[0]!)}</p></div>
          <div class:list={['df-section-grid',{ 'df-inverse':index%2===1 }]}>
            <div class="prosa">{section.paragraphs.slice(1).map(p=><p>{copy(p)}</p>)}
              {id==='experiencia' && <p><a class="kof-link kof-link--inline" href={link('/como-funciona/')} data-analytics-id="desafio-experiencia-como-funciona">Conheça também o jeito de aprender da plataforma</a>. A página mostra o percurso geral; esta compra inclui o curso do Farol e o acesso descrito aqui.</p>}
              {id==='familia' && <a class="kof-link" href={link(`${f.basePath}/quiz`)} data-analytics-id="desafio-familia-quiz">Receber uma orientação para o começo do meu filho<span aria-hidden="true">→</span></a>}
            </div>
            <div class="df-section-visual"><DesafioVisual visual={art.visual}/></div>
          </div>
        </div>
      </section>})}

      <section class="section fundo-folha cor-rosa" id="quem-prepara" data-analytics-id="desafio-quem-prepara"><div class="wrap df-section-grid">
        <figure class="family-photo"><img src={`${communityImages}/familia-helena-julio-kids.webp`} alt="Helena e Júlio, criadores do Sistema Zero" width="880" height="1019" loading="lazy"/><figcaption>Helena e Júlio · Sistema Zero</figcaption></figure>
        <div class="prosa"><span class="kof-eyebrow">Quem prepara a experiência</span><h2 class="kof-display">Um começo que você pode conhecer por dentro</h2><p>Somos Helena e Júlio, criadores do Sistema Zero. No Desafio, reunimos o projeto do Farol, a sequência de explicações e o espaço para montar, testar e mostrar a criação.</p><p>Você pode conhecer o jogo, os passos da montagem e o caminho de ajuda antes de decidir. As imagens desta página mostram o projeto e recursos da plataforma. Quando uma tela usa outro curso para explicar a interface, a legenda identifica esse exemplo.</p><a class="kof-link" href={link('/como-funciona/')} data-analytics-id="desafio-autores-como-funciona">Ver a experiência de aprendizagem<span aria-hidden="true">→</span></a></div>
      </div></section>

      <section class="section fundo-alt cor-azul" id="requisitos" aria-labelledby="title-requisitos" data-analytics-id="desafio-requisitos"><div class="wrap">
        <div class="cap-head"><span class="cap-chip"><span class="material-symbols-rounded cap-chip-icone" aria-hidden="true">computer</span><span class="cap-chip-texto">Para começar em casa</span></span><h2 class="kof-display" id="title-requisitos">O projeto e o formato precisam fazer sentido para vocês</h2></div>
        <div class="df-requirements">
          <article class="kof-carta kof-carta--fio prosa"><h3 class="kof-display">Um computador para montar</h3><p>Seu filho usa computador ou notebook com internet, mouse e teclado. A atividade abre no navegador. Celular e tablet permitem conhecer esta página, mas não substituem o computador para programar o projeto.</p></article>
          <article class="kof-carta kof-carta--fio prosa"><h3 class="kof-display">Um começo guiado</h3><p>A orientação é voltada a crianças e adolescentes de 9 a 14 anos. Ele precisa acompanhar a leitura e usar mouse e teclado. Vale estar junto na primeira tentativa para descobrir o apoio de que precisa. O Farol é introdutório e usa arte preparada.</p></article>
          <article class="kof-carta kof-carta--fio prosa"><h3 class="kof-display">Aulas gravadas e ajuda por mensagens</h3><p>Ele pode pausar a explicação para montar e voltar ao trecho durante o acesso. As dúvidas seguem por mensagens e podem exigir espera. Se vocês precisam de professor ao vivo acompanhando toda a atividade, esta oferta não inclui esse atendimento.</p></article>
        </div>
        <p class="df-after-note">O projeto é feito no Estúdio do Sistema Zero. Este curso não ensina a criar dentro do Roblox ou Minecraft, nem a desenhar personagens. <a class="kof-link kof-link--inline" href={link(`${f.basePath}/quiz`)}>O quiz pode ajudar a comparar a proposta com o que vocês procuram.</a></p>
      </div></section>

      <section class="section df-offer cor-verde" id="oferta" aria-labelledby="title-oferta" data-analytics-id="desafio-oferta"><div class="wrap">
        <div class="cap-head cap-head--centro"><span class="kof-eyebrow">Uma primeira experiência completa</span><h2 class="kof-display" id="title-oferta">O que vocês recebem para construir o Farol</h2><p class="cap-lead">Um projeto com começo, montagem e uma criação para mostrar. A Comunidade fica como uma escolha de continuidade.</p></div>
        <div class="df-offer-grid">
          <article class="kof-carta kof-carta--fio df-included"><ul>{INCLUDED.map(item=><li><span class="material-symbols-rounded" aria-hidden="true">check_circle</span><span>{item}</span></li>)}</ul><p>O Estúdio incluído é o das atividades guiadas. Outros cursos e ferramentas livres da Comunidade pertencem à assinatura e às liberações da Jornada.</p></article>
          <article class="kof-carta df-price-card"><h3 class="kof-display">Desafio do Primeiro Jogo</h3><p>A Chave do Farol</p>{validCoupon && <p>De <s>{priceLabelShort}</s>, com o cupom {validCoupon.code}:</p>}<p class="df-price">{price}</p><p><strong>Pagamento único. Sem renovação automática.</strong></p><a class="kof-btn kof-btn--grande" href={checkout} data-checkout-cta data-analytics-id="desafio-oferta-comprar">Começar o Desafio por {price}<span aria-hidden="true">→</span></a><p>Você confere os dados do responsável e o valor antes de confirmar o pagamento por Pix ou cartão.</p><p>Garantia de sete dias corridos a contar da compra. Para solicitar reembolso, escreva para <a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a> com o e-mail usado na compra. <a href="/kids/termos">Confira as condições.</a></p></article>
        </div>
        <ol class="df-timeline"><li><strong>Na aprovação do pagamento</strong><span>Começam os 30 dias de acesso. O primeiro login não reinicia esse prazo.</span></li><li><strong>Durante os 30 dias</strong><span>Curso e Mural completo: publicar, comentar, reagir, ver e jogar, conforme as regras do espaço.</span></li><li><strong>Depois do prazo</strong><span>O curso expira; o Mural permanece visitante, para ver e jogar. O link do jogo continua enquanto a publicação estiver disponível.</span></li></ol>
        <p class="df-after-note">Já tem acesso ao Desafio ou uma assinatura que o inclui? <a class="kof-link kof-link--inline" href={memberUrl} data-analytics-id="desafio-acesso-existente">Entre na sua conta para conferir e continuar.</a></p>
      </div></section>

      <section class="section" id="duvidas" aria-labelledby="title-duvidas" data-analytics-id="desafio-duvidas"><div class="wrap">
        <div class="cap-head cor-roxo"><span class="cap-chip"><span class="material-symbols-rounded cap-chip-icone" aria-hidden="true">help</span><span class="cap-chip-texto">Na prática, em casa</span></span><h2 class="kof-display" id="title-duvidas">Para começar com seu filho</h2></div>
        <div class="duvidas-grid"><nav class="faq-nav-area" aria-label="Assuntos das perguntas"><ul class="faq-nav">{faqGroups.map((group,i)=><li><a href={`#assunto-${i}`}><span class="kof-ladrilho" aria-hidden="true"><span class="material-symbols-rounded">{group.icon}</span></span><span>{group.title}</span></a></li>)}</ul></nav>
          <div class="faq">{faqGroups.map((group,i)=><div class="faq-group" id={`assunto-${i}`}><h3 class="kof-display">{group.title}</h3>{group.entries.map(q=><details class="kof-carta kof-carta--fio" id={q.id} data-analytics-id={`desafio-${q.id}`}><summary>{copy(q.title)}<span class="material-symbols-rounded faq-seta" aria-hidden="true">expand_more</span></summary><div class:list={['resposta',{ 'resposta--visual':!!faqVisuals[q.id] }]}><div class="resposta-texto prosa">{q.id==='duvida-19'?<><p>Você pode solicitar reembolso integral em até sete dias corridos a contar da compra. Envie o pedido para <a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a>, informando o e-mail usado na compra. O prazo de garantia não aumenta, pausa nem reinicia os 30 dias de acesso.</p><a class="kof-link kof-link--inline" href="/kids/termos">Ver as condições de garantia e reembolso</a></>:q.paragraphs.map(p=><p>{copy(p)}</p>)}</div>{faqVisuals[q.id] && <div class="resposta-visuais"><DesafioVisual visual={faqVisuals[q.id]!} compact/></div>}</div></details>)}</div>)}</div>
        </div>
      </div></section>

      <section class="section fundo-folha cor-rosa" id="continuidade" data-analytics-id="desafio-continuidade"><div class="wrap df-continuity prosa"><span class="kof-eyebrow">Quando fizer sentido continuar</span><h2 class="kof-display">{DESAFIO_SECTIONS.continuidade.title}</h2>{DESAFIO_SECTIONS.continuidade.paragraphs.map(p=><p>{copy(p)}</p>)}<div class="hero-actions"><a class="kof-link" href={link('/kids/comunidade-dos-criadores/oferta')} data-analytics-id="desafio-comunidade">Conhecer a Comunidade e os planos<span aria-hidden="true">→</span></a><a class="kof-link" href={link('/como-funciona/')} data-analytics-id="desafio-continuidade-como-funciona">Ver como funciona a plataforma<span aria-hidden="true">→</span></a></div></div></section>
      <section class="section kof-banda df-closing" data-analytics-id="desafio-convite"><div class="wrap prosa"><span class="kof-eyebrow">Um começo para conhecer juntos</span><h2 class="kof-display">O primeiro convite pode ser para conhecer a aventura</h2><p>Mostre o Farol ao seu filho e conversem sobre o que ele gostaria de experimentar. Se fizer sentido para vocês, o Desafio oferece a orientação para construir as regras, testar o jogo e aprender a mostrá-lo.</p><a class="kof-btn kof-btn--grande kof-btn--sobre-navy" href={checkout} data-checkout-cta data-analytics-id="desafio-convite-comprar">Quero começar o Desafio<span aria-hidden="true">→</span></a><p>{price} uma vez. Curso e Mural completo por 30 dias; depois, Mural visitante. Para 9 a 14 anos, no computador.</p></div></section>
    </main>
    <ComunidadeImageZoom/>
  </div>
  <Footer audience="kids" vitalicio={false}/>
  <PreCheckoutModal client:load basePath={f.basePath} funnel={f.key} couponCode={checkoutCouponCode}/>
</BaseLayout>
