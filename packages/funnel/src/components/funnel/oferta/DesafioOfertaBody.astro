---
// Página de vendas do "Desafio do Primeiro Jogo" (funil kids). Layout PRÓPRIO,
// porte fiel da página colorida aprovada pela usuária (tema creme claro, azul +
// laranja, Baloo 2/Nunito, botões 3D, balões dos personagens, decorações
// flutuantes). É uma OFERTA PADRÃO: a personalização por perfil vive só na tela
// de resultado (que é o elo entre o quiz e esta página). O CSS sob medida vive
// no `<style>` escopado abaixo, sob `.dpj` (não vaza para as páginas
// compartilhadas). Os CTAs de compra levam `data-checkout-cta` → o
// PreCheckoutModal (mesma ilha do NCI) abre o checkout.
import '@fontsource/material-symbols-rounded/400.css'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { funnelOgImage } from '../../../lib/seo'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  f: FunnelDef
  productName: string
  /** "R$ 37,00" (boxes de preço). */
  priceLabel: string
  /** "R$ 37" (botões e copy). */
  priceLabelShort: string
  /** "37.00" (JSON-LD). */
  priceReais: string
  imagesBase: string
  /** Repassado pela rota (o resultado envia ?perfil= para o tracking); a oferta padrão não o renderiza. */
  perfil: string | null
  /** Repassado pela rota (?quer= do quiz); a oferta padrão não o renderiza. */
  quer?: string | null
  ofertaUrl: string
}
const { f, productName, priceLabelShort, priceReais, imagesBase, ofertaUrl } = Astro.props

const description = f.seoDescription
const img = (file: string) => `${imagesBase}/${file}`
---

<BaseLayout
  title={f.seoTitle}
  description={description}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image={img('hero-desafio.webp')}
  />
  <link slot="head" rel="preload" as="image" href={img('hero.webp')} fetchpriority="high" />

  <div class="dpj">
    <!-- ===== TOPO FIXO ===== -->
    <header class="topbar">
      <div class="wrap nav">
        <div class="logo">
          <span class="badge"><span class="material-symbols-rounded">rocket_launch</span></span>
          Desafio do Primeiro Jogo
        </div>
        <div class="price-mini"><s>R$ 97</s> {priceLabelShort}</div>
        <a href="#oferta" class="btn header-cta">
          <span class="material-symbols-rounded">bolt</span><span class="lbl">Quero começar</span>
        </a>
      </div>
    </header>

    <!-- ===== HERO ===== -->
    <section class="hero sec">
      <svg class="deco float" style="top:12%;left:4%;width:46px" viewBox="0 0 24 24" fill="#FFCE3A"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <svg
        class="deco float slow rev"
        style="top:22%;right:6%;width:34px"
        viewBox="0 0 24 24"
        fill="#F368A6"
        ><path d="M12 2l2.4 6.9L21 9.3l-5.2 4.1L17.6 21 12 16.9 6.4 21l1.8-7.6L3 9.3l6.6-.4z"
        ></path></svg
      >
      <div class="blob" style="width:220px;height:220px;background:#CDE8FF;top:-40px;right:-40px">
      </div>
      <div class="blob" style="width:160px;height:160px;background:#CFF3DC;bottom:20px;left:-50px">
      </div>
      <div class="wrap">
        <div class="grid">
          <div class="hero-copy">
            <span class="eyebrow"
              >Para crianças a partir de 9 anos<br />que vivem em jogos e tecnologia</span
            >
            <h1>
              O mesmo foco que ele coloca no jogo <span class="hl">dos outros</span> pode virar o primeiro
              jogo <span class="hl">dele</span>, em 5 dias
            </h1>
            <p class="lead">
              Uma trilha guiada, uma vitória por dia, dentro de um estúdio que abre na própria aula.
              No primeiro dia a nave dele já voa na tela. No quinto, ele te chama pra ver o jogo
              pronto, manda o link pros amigos, e nem percebe que passou a semana aprendendo de
              verdade. Achou que estava brincando.
            </p>
            <div class="chips">
              <span class="chip"
                ><span class="material-symbols-rounded">bolt</span>Resultado no 1º dia</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">child_care</span>A partir dos 9 anos</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">favorite</span>Você não precisa saber nada</span
              >
              <span class="chip"
                ><span class="material-symbols-rounded">schedule</span>40 min por dia</span
              >
            </div>
            <div class="hero-cta">
              <a href="#oferta" class="btn big">
                <span class="material-symbols-rounded">sports_esports</span>Quero ver o primeiro
                jogo do meu filho
              </a>
            </div>
            <div class="seals">
              <span><span class="material-symbols-rounded">check_circle</span>Acesso na hora</span>
              <span
                ><span class="material-symbols-rounded">check_circle</span>Garantia de 7 dias</span
              >
              <span
                ><span class="material-symbols-rounded">check_circle</span>Pagamento único</span
              >
            </div>
          </div>
          <figure class="art hero-art">
            <div class="glow"></div>
            <img
              src={img('hero.webp')}
              alt="Criança criando o primeiro jogo no computador com o Zappy ao lado e os pais atrás"
              width="1000"
              height="1263"
              fetchpriority="high"
            />
          </figure>
        </div>
        <!-- fala do Zappy pra criança -->
        <div class="kid reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('zappy-fala.webp')}
                alt="Zappy, o robô do desafio"
                width="360"
                height="458"
                loading="lazy"
              />
            </figure>
            <span class="name">Zappy</span>
          </div>
          <div class="bubble">
            Oi, sou o Zappy. Se você curte jogo, chama seu pai ou sua mãe e senta aqui do lado. Em 5
            dias a gente faz uma nave voar de verdade na tela, e o jogo é todo seu. Bora criar?
          </div>
        </div>
      </div>
    </section>

    <!-- ===== STATS ===== -->
    <section class="stats-band">
      <div class="wrap">
        <div class="stats">
          <div class="stat"><div class="n">5 dias</div><div class="l">até o jogo pronto</div></div>
          <div class="stat">
            <div class="n">40 min</div><div class="l">por dia, no ritmo dele</div>
          </div>
          <div class="stat">
            <div class="n">{priceLabelShort}</div><div class="l">uma vez, sem mensalidade</div>
          </div>
        </div>
        <div class="market">
          Em 2024, 79,5 milhões de crianças de 8 a 12 anos entraram no Roblox. Quase todas gastam
          esse foco jogando o que outra pessoa criou. Este desafio aponta o foco do seu filho pro
          outro lado: o de quem cria.
          <small>Fonte: Brasil de Fato, 2024</small>
        </div>
      </div>
    </section>

    <!-- ===== DUAS TELAS ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">O mesmo foco, duas direções</span>
        <h2 class="reveal">
          Tem o filho que gasta o foco na tela,<br />e o filho que cria com ele
        </h2>
        <p class="sub">A mesma criança, o mesmo computador, duas tardes que terminam muito diferentes.</p>
        <div class="two">
          <div class="screen neg reveal">
            <h3>
              <span class="material-symbols-rounded">sentiment_dissatisfied</span>A tela que só
              passa o tempo
            </h3>
            <figure class="art">
              <img
                src={img('crianca-passiva.webp')}
                alt="Criança entediada no sofá, rolando vídeos no celular"
                width="880"
                height="692"
                loading="lazy"
              />
            </figure>
            <p>
              Ele rola vídeo atrás de vídeo, joga o jogo que outra pessoa montou e levanta do
              computador com as mãos vazias. No domingo à noite bate aquela sensação de tempo que
              escorreu pelo ralo, e nada pra mostrar.
            </p>
            <div class="tags">
              <div class="tag">
                <span class="material-symbols-rounded">timer_off</span>3 horas de tela, zero coisa
                criada
              </div>
              <div class="tag">
                <span class="material-symbols-rounded">block</span>Nada pra contar no dia seguinte
              </div>
            </div>
          </div>
          <div class="screen pos reveal">
            <h3>
              <span class="material-symbols-rounded">celebration</span>A tela que vira criação
            </h3>
            <figure class="art">
              <img
                src={img('crianca-criando.webp')}
                alt="A mesma criança empolgada criando o jogo da nave, com o Zappy comemorando"
                width="880"
                height="581"
                loading="lazy"
              />
            </figure>
            <p>
              Ele senta quarenta minutos, segue o passo a passo e vê o personagem ganhar vida por
              causa do que ele mesmo montou. No último dia, é ele quem chama você na sala pra ver o
              jogo rodando.
            </p>
            <div class="tags">
              <div class="tag">
                <span class="material-symbols-rounded">stadia_controller</span>5 dias, 1 jogo
                jogável no fim
              </div>
              <div class="tag">
                <span class="material-symbols-rounded">emoji_events</span>Algo concreto pra mostrar
                e contar
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== O FOCO DELE (coração) ===== -->
    <section class="sec culpa">
      <div class="wrap center">
        <span class="eyebrow">Sobre aquele foco que parece não largar</span>
        <h2 class="reveal">
          O foco que ele dá pro jogo não é defeito.<br />É a coisa mais rara que ele tem.
        </h2>
        <p class="sub">
          Você já viu ele ficar horas fixado num jogo ou num assunto de tecnologia, e em outras
          coisas o foco simplesmente não vem. Isso não é preguiça, e não é problema.
        </p>
        <div class="box reveal">
          <div class="box-grid">
            <figure class="art alivio-art">
              <img
                src={img('alivio.webp')}
                alt="Zappy com a mão no peito e um coração ao lado, passando calma"
                width="520"
                height="746"
                loading="lazy"
              />
            </figure>
            <p>
              Esse foco intenso e concentrado num assunto só tem nome: <b>hiperfoco</b>. Muita gente
              trata como algo pra controlar, um problema a resolver. Só que focar fundo em uma coisa
              é uma capacidade que a maioria dos adultos queria ter e não tem. O que decide se esse
              foco vira força na vida dele ou fica sendo tempo jogado fora não é o tamanho do foco.
              É a direção.
            </p>
          </div>
        </div>
        <div class="thesis reveal">
          Hoje ele aponta esse foco pra <b>consumir</b>: jogar o jogo que outra pessoa criou,
          assistir o vídeo que outro gravou. No dia em que esse mesmo foco aponta pra <b>criar</b>,
          tudo muda de lugar. A tarde que ia embora jogando vira uma tarde construindo. E como ele
          ama o assunto, ele nem sente que está aprendendo. Ele acha que está brincando. É
          exatamente brincando que uma criança aprende de verdade, e é assim que ela desenvolve
          raciocínio, lógica e persistência, sem peso nenhum.
        </div>
        <div class="shift">
          <div class="card reveal">
            <div class="from">Esse foco é um problema</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Esse foco é o talento
              dele
            </div>
            <p>
              O que parecia a fraqueza é onde ele tem facilidade natural. Falta só apontar pra
              direção certa.
            </p>
          </div>
          <div class="card reveal">
            <div class="from">Foco que só consome</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Foco que cria
            </div>
            <p>
              Mesmo tempo de tela, resultado diferente. No lugar de mais um jogo jogado, um jogo
              feito por ele.
            </p>
          </div>
          <div class="card reveal">
            <div class="from">Aprender é chato</div>
            <div class="to">
              <span class="material-symbols-rounded">arrow_circle_right</span>Aprender achando que
              brinca
            </div>
            <p>
              Como ele ama jogo e tecnologia, ele desenvolve habilidade de verdade sem sentir que
              está estudando.
            </p>
          </div>
        </div>
        <div class="thesis verde reveal">
          Essa é uma daquelas habilidades que só valem mais com o tempo. Apontar esse foco pra criar
          agora, brincando, é uma das coisas mais baratas que você pode fazer pelo futuro dele.
        </div>
      </div>
    </section>

    <!-- ===== COMO FUNCIONA ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">Do acesso ao jogo pronto</span>
        <h2 class="reveal">É mais simples do que parece.<br />Olha o caminho inteiro:</h2>
        <p class="sub">
          Cinco dias, uma vitória por dia, tudo dentro do mesmo estúdio, sem instalar nada no
          computador.
        </p>
      </div>
      <div class="wrap">
        <div class="days">
          <div class="day reveal">
            <div class="num">1</div>
            <div>
              <h3>A nave ganha vida</h3>
              <p>
                Seguindo o passo a passo, ele monta os primeiros blocos com a própria mão, sente que
                a ordem dos passos importa, e faz a nave aparecer no espaço e voar com as setas. Os
                blocos já vêm com a parte difícil encaixada, então ele cria com lógica de verdade,
                sem escrever uma linha de código.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia1.webp')}
                alt="Jogo do Dia 1: a nave voando no espaço"
                width="791"
                height="476"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">2</div>
            <div>
              <h3>A nave atira</h3>
              <p>
                Ele monta o grupo dos tiros e a área que escuta o teclado. Aperta a tecla, o tiro
                sai da nave com som e tudo. É aqui que ele descobre duas ideias que todo criador de
                jogos usa: guardar muitas coisas do mesmo tipo e fazer o jogo responder na hora.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia2.webp')}
                alt="Jogo do Dia 2: a nave atirando no espaço"
                width="653"
                height="393"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">3</div>
            <div>
              <h3>Os asteroides chegam</h3>
              <p>
                Uma chuva de pedras espaciais começa a cair, cada uma num lugar sorteado, e os tiros
                dele explodem as pedras com fogo e som. O que era uma tela bonita vira um jogo com
                graça de jogar.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia3.webp')}
                alt="Jogo do Dia 3: os asteroides caindo enquanto a nave atira"
                width="655"
                height="391"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">4</div>
            <div>
              <h3>Pontos e vidas</h3>
              <p>
                Cada acerto passa a valer ponto no placar, e a nave ganha vidas em coraçõezinhos na
                tela. É o dia em que entram os blocos de Programação, com a primeira variável dele
                guardando a pontuação.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia4.webp')}
                alt="Jogo do Dia 4: o placar de pontos e os corações de vida na tela"
                width="654"
                height="396"
                loading="lazy"
              />
            </figure>
          </div>
          <div class="day reveal">
            <div class="num">5</div>
            <div>
              <h3>Virou jogo de verdade</h3>
              <p>
                Ele cria a regra da vitória ao destruir 26 asteroides, monta as telas de início,
                vitória e derrota, testa o jogo inteiro do começo ao fim e gera um link pra família
                e os amigos jogarem. Sai dali com o primeiro joguinho jogável dele.
              </p>
            </div>
            <figure class="art day-art print-frame">
              <img
                src={img('print-dia5.webp')}
                alt="Jogo do Dia 5: a tela de início do jogo pronto, com o nome Nave contra Asteroides"
                width="875"
                height="526"
                loading="lazy"
              />
            </figure>
          </div>
        </div>
        <!-- fala do Dedé pra criança -->
        <div class="kid verde reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('dede-fala.webp')}
                alt="Dedé, personagem do desafio"
                width="360"
                height="869"
                loading="lazy"
              />
            </figure>
            <span class="name">Dedé</span>
          </div>
          <div class="bubble">
            No Dia 2 você faz a nave atirar. Sério. Você aperta e o tiro sai. No dia seguinte os
            asteroides começam a cair, e cada pedra que você acerta explode na tela. É aí que fica
            divertido de verdade.
          </div>
        </div>
        <div class="thesis compacta reveal">
          <b>Por que uma vitória por dia:</b> um foco forte vai naturalmente pra onde a recompensa chega
          rápido. Por isso o resultado aparece já no primeiro dia, pra prender o interesse dele desde
          o começo, no ritmo que ele curte.
        </div>
        <div class="center como-cta">
          <a href="#oferta" class="btn">
            <span class="material-symbols-rounded">rocket_launch</span>Quero começar o desafio hoje
          </a>
        </div>
      </div>
    </section>

    <!-- ===== POR DENTRO DA PLATAFORMA ===== -->
    <section class="sec">
      <div class="wrap center">
        <span class="eyebrow">Olha por dentro</span>
        <h2 class="reveal">O estúdio onde ele cria abre<br />dentro da própria aula</h2>
        <p class="sub">
          Sem instalar nada, sem configurar nada. Ele entra, arrasta os blocos e vê o jogo acontecer
          ali do lado. Tudo no mesmo lugar.
        </p>
        <div class="browser reveal">
          <div class="bar">
            <i></i><i></i><i></i><span class="url">kids.sistemazero.com.br</span>
          </div>
          <figure class="art">
            <img
              src={img('print-estudio.webp')}
              alt="A plataforma por dentro: a aula, o estúdio com os blocos e o jogo rodando"
              width="1100"
              height="1532"
              loading="lazy"
            />
          </figure>
        </div>
        <p class="sub plat-note">Ele arrasta os blocos e vê o jogo acontecer do lado.</p>
      </div>
    </section>

    <!-- ===== ENTREGÁVEIS ===== -->
    <section class="sec gifts">
      <div class="wrap center">
        <span class="eyebrow">O que seu filho leva nesses 5 dias</span>
        <h2 class="reveal">Tudo que vem junto pra ele<br />chegar no jogo pronto</h2>
        <p class="sub">
          Além do desafio guiado, vem tudo que ajuda a criança a chegar no jogo pronto, e um guia
          simples pra você acompanhar sem entender nada de tecnologia.
        </p>
        <div class="gift-grid">
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-trilha.webp')}
                alt="Trilha guiada de 5 dias"
                width="760"
                height="570"
                loading="lazy"
              />
            </figure>
            <h4>Trilha guiada de 5 dias</h4>
            <p>Uma atividade por dia, com começo, meio e fim.</p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-estudio.webp')}
                alt="Estúdio e blocos feitos pra criança"
                width="760"
                height="376"
                loading="lazy"
              />
            </figure>
            <h4>Estúdio e blocos feitos pra criança</h4>
            <p>
              Abre dentro da própria aula, sem instalar nada. A parte chata já vem resolvida. Ela
              monta o jogo peça por peça, com lógica de verdade e sem escrever código.
            </p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-link.webp')}
                alt="Link do jogo pra compartilhar"
                width="486"
                height="538"
                loading="lazy"
              />
            </figure>
            <h4>Link do jogo pra compartilhar</h4>
            <p>
              No fim, ela publica o jogo e gera um link pra mandar pros amigos e a família jogarem,
              no computador ou no celular.
            </p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-video.webp')}
                alt="Passo a passo em vídeo"
                width="760"
                height="434"
                loading="lazy"
              />
            </figure>
            <h4>Passo a passo em vídeo</h4>
            <p>Curto, direto e no jeito que uma criança consegue acompanhar sozinha.</p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-mapa.webp')}
                alt="Mapa dos pais"
                width="760"
                height="1075"
                loading="lazy"
              />
            </figure>
            <h4>Mapa dos pais</h4>
            <p>
              Uma página simples explicando como acompanhar, em português de quem não entende de
              tecnologia.
            </p>
          </div>
          <div class="gift reveal">
            <figure class="art">
              <img
                src={img('entrega-certificado.webp')}
                alt="Certificado de conclusão"
                width="760"
                height="569"
                loading="lazy"
              />
            </figure>
            <h4>Certificado de conclusão</h4>
            <p>Em PDF ou imagem, gerado ao terminar o desafio.</p>
          </div>
        </div>
        <!-- fala da Debinha pra criança -->
        <div class="kid rosa reveal">
          <div class="char">
            <figure class="art">
              <img
                src={img('debinha-fala.webp')}
                alt="Debinha, personagem do desafio"
                width="360"
                height="640"
                loading="lazy"
              />
            </figure>
            <span class="name">Debinha</span>
          </div>
          <div class="bubble">
