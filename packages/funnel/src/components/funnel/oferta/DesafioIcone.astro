---
// Ícones de traço das páginas do Desafio (Kids e adulta), desenhados no Canvas de 21/10/2026. Usam
// `currentColor`: a cor vem do CSS de cada página (tokens), nunca de um valor escrito aqui.
// Sempre decorativos ao lado de um texto que diz a mesma coisa (`aria-hidden`).
import type { NomeIconeDesafio } from './desafio-icones'

interface Props {
  nome: NomeIconeDesafio
  tamanho?: number
}
const { nome, tamanho = 24 } = Astro.props
---

<svg aria-hidden="true" width={tamanho} height={tamanho} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={nome === 'check' ? 3 : 2} stroke-linecap="round" stroke-linejoin="round">
  {nome === 'check' && <path d="M20 6 9 17l-5-5" />}
  {nome === 'setas' && (
    <>
      <rect x="9" y="2.5" width="6" height="6" rx="1.5" />
      <rect x="2" y="9.5" width="6" height="6" rx="1.5" />
      <rect x="9" y="9.5" width="6" height="6" rx="1.5" fill="currentColor" fill-opacity="0.25" />
      <rect x="16" y="9.5" width="6" height="6" rx="1.5" />
    </>
  )}
  {nome === 'chave' && (
    <>
      <circle cx="7.5" cy="12" r="4.5" />
      <circle cx="7.5" cy="12" r="1.4" fill="currentColor" />
      <path d="M12 12h9M18 12v3M21 12v2" />
    </>
  )}
  {nome === 'farol' && (
    <>
      <path d="M12 2l2.5 4h-5z" fill="currentColor" fill-opacity="0.25" />
      <path d="M9.5 6h5l1 15h-7z" />
      <path d="M9.2 10.5h5.6M8.9 15h6.2" />
      <path d="M3 5l3 1.5M21 5l-3 1.5M2 9h3M22 9h-3" />
    </>
  )}
  {nome === 'certificado' && (
    <>
      <circle cx="12" cy="9" r="6" />
      <path d="M12 6l1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2L8.8 8.3 11 8z" fill="currentColor" />
      <path d="M8.5 14L7 22l5-2.5 5 2.5-1.5-8" />
    </>
  )}
  {nome === 'planejar' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="2" />
      <path d="M8 8l1.5 1.5L12 7M8 13l1.5 1.5L12 12M14 8h3M14 13h3M8 17h9" />
    </>
  )}
  {nome === 'porta' && (
    <>
      <rect x="12" y="3" width="9" height="18" rx="1" />
      <circle cx="18.5" cy="12" r="0.8" fill="currentColor" />
      <circle cx="5.5" cy="12" r="2.5" />
      <path d="M8 12h3M10 12v2" />
    </>
  )}
  {nome === 'tentar' && (
    <>
      <path d="M20 12a8 8 0 1 1-2.3-5.7" />
      <path d="M20 4v5h-5" />
    </>
  )}
  {nome === 'foco' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" />
    </>
  )}
  {nome === 'natacao' && (
    <>
      <path d="M7 9a5 5 0 0 1 10 0z" fill="currentColor" fill-opacity="0.25" />
      <path d="M2 14c2 0 2-1.5 4-1.5s2 1.5 4 1.5 2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5M2 19c2 0 2-1.5 4-1.5s2 1.5 4 1.5 2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5" />
    </>
  )}
  {nome === 'musica' && (
    <>
      <path d="M9 18V5l12-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="18" cy="16" r="3" />
    </>
  )}
  {nome === 'lampada' && (
    <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z" />
  )}
  {nome === 'painel' && (
    <>
      <rect x="3" y="4" width="18" height="14" rx="2" />
      <path d="M7 14l3-3 3 2 4-5" />
    </>
  )}
  {nome === 'mensagem' && <path d="M4 5h16v10H10l-4 4v-4H4z" />}
  {nome === 'relogio' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {nome === 'computador' && (
    <>
      <rect x="3" y="4" width="18" height="12" rx="2" />
      <path d="M8 20h8M12 16v4" />
    </>
  )}
  {nome === 'escudo' && (
    <>
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {nome === 'play' && <path d="M8 5v14l11-7z" fill="currentColor" />}
  {nome === 'estrela' && <path d="M12 2.5l2.9 6.4 7 .7-5.2 4.7 1.5 6.9L12 17.6l-6.2 3.6 1.5-6.9L2.1 9.6l7-.7z" />}
  {nome === 'livro' && (
    <>
      <path d="M2 5h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z" />
      <path d="M22 5h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z" />
    </>
  )}
  {nome === 'pergunta' && (
    <>
      <path d="M4 5h16v10H10l-4 4v-4H4z" />
      <path d="M10 8.5a2 2 0 1 1 2.5 1.9c-.4.1-.5.5-.5.8v.6M12 13.3v.1" />
    </>
  )}
</svg>
