---
// Oferta Kids aprovada em 06/11/2026; a continuidade compartilha este corpo.
import '../../../styles/kids-oferta.css'
import '../../../styles/comunidade-917.css'
import { COMUNIDADE_PRECO_FALLBACK } from '../../../funnels/comunidade-dos-criadores/content'
import { cupomDaOferta } from '../../../funnels/comunidade-dos-criadores/oferta/cupom'
import { calcularEconomiaAnual } from '../../../funnels/comunidade-dos-criadores/oferta/economia'
import { PAGINA_9A17 } from '../../../funnels/comunidade-dos-criadores/oferta/pagina-9a17'
import { PAGINA_CONTINUAR } from '../../../funnels/comunidade-dos-criadores/oferta/pagina-continuar'
import ComunidadePratica from './ComunidadePratica.astro'
import OfferImage from './OfferImage.astro'
import OfferImageZoom from './OfferImageZoom.astro'
import '../../../styles/comunidade-pratica.css'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import type { CouponPresentation } from '../../../lib/coupon-query'
import { formatBRLFromCents, formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'

interface Props {
  continuidade?: boolean
  f: FunnelDef
  productName: string
  priceLabel: string
  priceLabelShort: string
  priceReais: string
  imagesBase: string
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  plans: OfferPlans | null
  coupon: CouponPresentation
}
const { f, productName, imagesBase, ofertaUrl, plans, coupon, continuidade = false } = Astro.props
const P = continuidade ? PAGINA_CONTINUAR : PAGINA_9A17
const cupom = cupomDaOferta(coupon)
const img = (file: string) => `${imagesBase}/${file}`

// A resolução por intervalo conserva qual oferta é a principal e qual é a irmã.
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)
// Com o catálogo no ar, um plano sem oferta ao vivo não é oferecido: o botão dele não teria slug e o
// checkout abriria no outro plano. Sem catálogo (plans nulo), os dois aparecem com o preço de reserva.
const mostraMensal = !plans || mensal !== null
const mostraAnual = !plans || anual !== null
const mensalCents = mensal?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_PRECO_FALLBACK.anualCents
// Economia só com os dois preços AO VIVO (nunca contra o fallback); sem ela o selo sai.
const economiaAnualCents = calcularEconomiaAnual(mensal?.priceCents, anual?.priceCents)
const precos: Record<string, string> = {
  '{{preco_mensal}}': formatBRLFromCents(mensalCents),
  '{{preco_anual}}': formatBRLFromCents(anualCents),
  '{{equivalente_mensal_anual}}': formatBRLFromCents2(Math.round(anualCents / 12)),
  '{{economia_anual}}': formatBRLFromCents(economiaAnualCents),
}
const fill = (text: string) =>
  Object.entries(precos).reduce((acc, [marcador, valor]) => acc.replaceAll(marcador, valor), text)
const priceReais = ((plans?.main.priceCents ?? mensalCents) / 100).toFixed(2)

const CORES_HEROI = ['verde', 'amarelo', 'azul-claro']
const CORES_DEPOIS = ['verde', 'amarelo', 'rosa', 'azul-claro']
---

<BaseLayout title={P.seoTitle} description={P.description} canonical={ofertaUrl} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} htmlClass="theme-kids">
  <ProductJsonLd slot="head" name={productName} description={P.description} price={priceReais} url={ofertaUrl} image={img(P.capa)} />
  <link slot="head" rel="preload" as="image" href={P.hero.tela.src} fetchpriority="high" />
  <div class="c917 cpr">
    <a class="c9-pular" href="#conteudo">{P.topo.pular}</a>
    <header class="c9-topo">
      <div class="c9-topo__barra">
        <a class="c9-marca" href="#topo" aria-label={P.topo.logoLabel}>
          <img src={img(P.topo.logo.file)} alt={P.topo.logo.alt} width={P.topo.logo.width} height={P.topo.logo.height} loading="lazy" decoding="async" />
        </a>
        <nav class="c9-nav" aria-label={P.topo.navLabel}>
          {P.topo.links.map((link) => <a class="c9-nav__link" href={link.href}>{link.label}</a>)}
          <a class="c9-btn c9-btn--topo" href={P.topo.cta.href}>{P.topo.cta.label}</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <section class="c9-sec c9-heroi" aria-labelledby="c9-titulo">
        <div class="c9-wrap c9-heroi__grade">
          <div class="c9-heroi__texto">
            <span class="c9-selo">{P.hero.eyebrow}</span>
            <h1 id="c9-titulo" class="c9-h1">{P.hero.title}<span class="c9-h1__destaque">{P.hero.destaque}</span></h1>
            <p class="c9-heroi__lead">{P.hero.description}</p>
            <ul class="c9-checks">
              {P.hero.benefits.map((benefit, index) => (
                <li>
                  <span class:list={['c9-ladrilho', `c9-cor--${CORES_HEROI[index]}`]} aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                  </span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
            <div class="c9-heroi__acao">
              <a class="c9-btn c9-btn--grande" href="#planos">{P.cta}<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
              <span class="c9-nota">{P.garantiaCurta}</span>
              <a class="cpr-secondary" href={P.hero.secondary.href}>{P.hero.secondary.label}</a>
            </div>
            <span class="c9-heroi__requisitos">{P.hero.requirements}</span>
          </div>
          <div class="c9-heroi__visual">
            <figure class="c9-heroi__tela">
              <OfferImage image={P.hero.tela} eager linkClass="cpr-hero-image" />
            </figure>
            <figure class="c9-heroi__foto">
              <img src={img(P.hero.foto.file)} alt={P.hero.foto.alt} width={P.hero.foto.width} height={P.hero.foto.height} loading="lazy" decoding="async" />
              <figcaption>{P.hero.fotoLegenda}</figcaption>
            </figure>
            <span class="c9-chip c9-cor--verde c9-heroi__chip1">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>{P.hero.chips[0]}
            </span>
            <span class="c9-chip c9-cor--rosa c9-heroi__chip2">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>{P.hero.chips[1]}
            </span>
          </div>
        </div>
      </section>

      <ComunidadePratica sections={P.sections} />

      <section id="planos" class="c9-sec c9-sec--azul" aria-labelledby="c9-planos">
        <div class="c9-wrap c9-wrap--planos c9-pilha c9-gap-26">
          <div class="c9-pilha c9-gap-12 c9-cabeca--860">
            <h2 id="c9-planos" class="c9-h2 c9-h2--planos">{P.planos.title}</h2>
            <p class="c9-p">{P.planos.paragraph}</p>
            {cupom.aviso && <p class:list={['c9-cupom', { 'c9-cupom--alerta': cupom.aviso.alerta }]} role={cupom.aviso.alerta ? 'alert' : undefined}>{cupom.aviso.texto}</p>}
          </div>
          <div class="c9-linha c9-gap-24 c9-linha--esticada">
            <ul class="c9-inclui" aria-label={P.planos.incluiLabel}>
              {P.planos.inclui.map((item) => (
                <li>
                  <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {mostraMensal && (
            <article class="c9-plano">
              <h3 class="c9-plano__nome">{P.planos.mensal.title}</h3>
              <p class="c9-plano__preco">{fill(P.planos.mensal.preco)}<span>{P.planos.mensal.sufixo}</span></p>
              <p class="c9-plano__texto">{fill(P.planos.mensal.text)}</p>
              <button type="button" class="c9-plano__btn" data-checkout-cta data-checkout-oferta={mensal?.slug}>{P.planos.mensal.cta}</button>
              <span class="c9-plano__nota">{P.planos.mensal.nota}</span>
            </article>
            )}
            {mostraAnual && (
            <article class="c9-plano c9-plano--anual">
              <h3 class="c9-plano__nome">{P.planos.anual.title}</h3>
              {economiaAnualCents > 0 && <span class="c9-economia">{fill(P.planos.anual.selo)}</span>}
              <p class="c9-plano__preco">{fill(P.planos.anual.preco)}<span>{P.planos.anual.sufixo}</span></p>
              <p class="c9-plano__texto">{fill(P.planos.anual.text)}</p>
              <button type="button" class="c9-plano__btn" data-checkout-cta data-checkout-oferta={anual?.slug}>{P.planos.anual.cta}</button>
              <span class="c9-plano__nota">{P.planos.anual.nota}</span>
            </article>
            )}
          </div>
          <div class="c9-linha c9-gap-18 c9-linha--esticada">
            <div class="c9-depois">
              <h3 class="c9-depois__titulo">{P.planos.depoisTitle}</h3>
              <ol>
                {P.planos.depois.map((passo, index) => (
                  <li><span class:list={['c9-depois__num', `c9-cor--${CORES_DEPOIS[index]}`]} aria-hidden="true">{index + 1}</span><span>{passo}</span></li>
                ))}
              </ol>
            </div>
            <p class="c9-garantia">
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
              <span><strong>{P.planos.garantia.strong}</strong>{P.planos.garantia.text}</span>
            </p>
          </div>
        </div>
      </section>

      <section id="duvidas" class="c9-sec c9-sec--chao" aria-labelledby="c9-duvidas">
        <div class="c9-wrap c9-wrap--estreito c9-pilha c9-gap-12">
          <h2 id="c9-duvidas" class="c9-h2 c9-h2--menor c9-duvidas__titulo">{P.faqTitle}</h2>
          {P.faq.map((item) => (
            <details class="c9-duvida">
              <summary>{item.question}</summary>
              <p>{fill(item.answer)}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="c9-fim" aria-labelledby="c9-fim">
        <div class="c9-wrap c9-fim__grade">
          <div class="c9-pilha c9-gap-14 c9-b520">
            <h2 id="c9-fim" class="c9-h2 c9-h2--fim">{P.closing.title}</h2>
            <a class="c9-btn c9-btn--grande c9-btn--amarelo" href="#planos">{P.cta}</a>
            <span class="c9-nota">{P.garantiaCurta}</span>
          </div>
          <img class="c9-fim__zappy" src={img(P.closing.zappy.file)} alt={P.closing.zappy.alt} width={P.closing.zappy.width} height={P.closing.zappy.height} loading="lazy" decoding="async" />
        </div>
      </section>
    </main>

    <div class="kof-mobar c9-barra" data-mobar aria-hidden="true">
      <span class="c9-barra__preco">{mostraMensal && <strong>{fill(P.barra.preco)}</strong>}{mostraMensal && mostraAnual && <span>{fill(P.barra.alternativa)}</span>}</span>
      <a class="c9-btn" href="#planos" tabindex="-1">{P.barra.cta}</a>
    </div>
  </div>
  <Footer audience={f.audience} vitalicio={f.lifetimeAccess} termosHref={`${f.basePath}/termos`} />
  <OfferImageZoom />
  <PreCheckoutModal client:idle basePath={f.basePath} funnel={f.key} couponCode={cupom.codigo} {continuidade} />
</BaseLayout>

<script>
  // Barra fixa do celular (só abaixo de 760px, pelo CSS): aparece depois da dobra e some enquanto
  // os planos ou o rodapé estão à vista. Sem JS ela nunca aparece (nasce escondida e aria-hidden).
  const barra = document.querySelector<HTMLElement>('[data-mobar]')
  const planos = document.getElementById('planos')
  const rodape = document.querySelector('footer')
  if (barra && planos && 'IntersectionObserver' in window) {
    const link = barra.querySelector('a')
    let planosAVista = false
    let rodapeAVista = false
    let roladoAlemDaDobra = false
    let ultimo: boolean | null = null
    const aplicar = () => {
      const mostra = roladoAlemDaDobra && !planosAVista && !rodapeAVista
      if (mostra === ultimo) return
      ultimo = mostra
      barra.classList.toggle('is-visible', mostra)
      barra.setAttribute('aria-hidden', mostra ? 'false' : 'true')
      link?.setAttribute('tabindex', mostra ? '0' : '-1')
    }
    new IntersectionObserver(
      ([e]) => {
        planosAVista = Boolean(e?.isIntersecting)
        aplicar()
      },
      { rootMargin: '0px 0px -40% 0px' },
    ).observe(planos)
    if (rodape)
      new IntersectionObserver(([e]) => {
        rodapeAVista = Boolean(e?.isIntersecting)
        aplicar()
      }).observe(rodape)
    const aoRolar = () => {
      roladoAlemDaDobra = window.scrollY > window.innerHeight * 0.9
      aplicar()
    }
    window.addEventListener('scroll', aoRolar, { passive: true })
    aoRolar()
  }
</script>
