---
import atkinsonCorpo from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url'
import bricolageTitulo from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url'
import silkscreenPixel from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url'
import '../../../styles/comunidade-adulto.css'
import { COMUNIDADE_ADULTO_PRECO_FALLBACK } from '../../../funnels/comunidade-adulto/content'
import { PAGINA_ADULTO_CONTINUAR } from '../../../funnels/comunidade-adulto/oferta/continuar'
import { PAGINA_ADULTO } from '../../../funnels/comunidade-adulto/oferta/pagina'
import { cupomDaOferta } from '../../../funnels/comunidade-dos-criadores/oferta/cupom'
import { calcularEconomiaAnual } from '../../../funnels/comunidade-dos-criadores/oferta/economia'
import type { FunnelDef } from '../../../funnels/registry'
import PreCheckoutModal from '../../../islands/PreCheckoutModal'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import type { CouponPresentation } from '../../../lib/coupon-query'
import { formatBRLFromCents, formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import type { OfferPlans } from '../../../server/catalog'
import Footer from '../../Footer.astro'
import ProductJsonLd from '../../seo/ProductJsonLd.astro'
import '../../../styles/ofertas-adulto.css'
import AdultOfferBar from './AdultOfferBar.astro'
import OfferImage from './OfferImage.astro'
import OfferImageZoom from './OfferImageZoom.astro'

interface Props {
  f: FunnelDef
  productName: string
  priceLabel: string
  priceLabelShort: string
  priceReais: string
  imagesBase: string
  perfil: string | null
  quer?: string | null
  ofertaUrl: string
  plans: OfferPlans | null
  coupon: CouponPresentation
  continuidade?: boolean
}
const { f, productName, imagesBase, ofertaUrl, plans, coupon, continuidade = false } = Astro.props
const P = continuidade ? PAGINA_ADULTO_CONTINUAR : PAGINA_ADULTO
const cupom = cupomDaOferta(coupon)

// Planos ao vivo, normalizados por intervalo (sem assumir qual é a principal da env).
const byInterval = (n: number) =>
  plans?.main.intervalMonths === n
    ? plans.main
    : plans?.alt?.intervalMonths === n
      ? plans.alt
      : null
const mensal = byInterval(1)
const anual = byInterval(12)
// Com o catálogo no ar, um plano sem oferta ao vivo não é oferecido: o botão dele não teria slug e o
// checkout abriria no outro plano. Sem catálogo (plans nulo), os dois aparecem com o preço de reserva.
const mostraMensal = !plans || mensal !== null
const mostraAnual = !plans || anual !== null
const mensalCents = mensal?.priceCents ?? COMUNIDADE_ADULTO_PRECO_FALLBACK.mensalCents
const anualCents = anual?.priceCents ?? COMUNIDADE_ADULTO_PRECO_FALLBACK.anualCents
// A economia só existe com os DOIS preços ao vivo; sem ela, o selo do anual sai.
const economiaAnualCents = calcularEconomiaAnual(mensal?.priceCents, anual?.priceCents)
const precos: Record<string, string> = {
  '{{preco_mensal}}': formatBRLFromCents(mensalCents),
  '{{preco_anual}}': formatBRLFromCents(anualCents),
  '{{equivalente_mensal_anual}}': formatBRLFromCents2(Math.round(anualCents / 12)),
  '{{economia_anual}}': formatBRLFromCents(economiaAnualCents),
}
const fill = (texto: string) =>
  Object.entries(precos).reduce((acc, [marcador, valor]) => acc.replaceAll(marcador, valor), texto)
const priceReais = ((plans?.main.priceCents ?? mensalCents) / 100).toFixed(2)
const heroImg = P.hero.imagens[0]
const condicoes = [
  mostraMensal ? `Mensal: ${precos['{{preco_mensal}}']}` : null,
  mostraAnual ? `Anual: ${precos['{{preco_anual}}']}` : null,
  '7 dias de garantia na contratação.',
]
  .filter(Boolean)
  .join(' · ')
