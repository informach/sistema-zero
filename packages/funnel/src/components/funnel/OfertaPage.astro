---
import { COMUNIDADE_ADULTO } from '../../funnels/comunidade-adulto'
import type { ComunidadeAdultoSubpagina } from '../../funnels/comunidade-adulto/oferta'
import { COMUNIDADE_DOS_CRIADORES } from '../../funnels/comunidade-dos-criadores'
import type { ComunidadeOfertaId } from '../../funnels/comunidade-dos-criadores/oferta/types'
import { DESAFIO_PRIMEIRO_JOGO } from '../../funnels/desafio-primeiro-jogo'
import type { DesafioOfferId } from '../../funnels/desafio-primeiro-jogo/offer'
import type { OfferPageData } from '../../server/offer-page'
import Comunidade917Body from './oferta/Comunidade917Body.astro'
import ComunidadeAdultoContinuarBody from './oferta/ComunidadeAdultoContinuarBody.astro'
import ComunidadeAdultoOfertaBody from './oferta/ComunidadeAdultoOfertaBody.astro'
import ComunidadeContinuarBody from './oferta/ComunidadeContinuarBody.astro'
import ComunidadeMenor9Body from './oferta/ComunidadeMenor9Body.astro'
import DesafioOfertaBody from './oferta/DesafioOfertaBody.astro'
import NoComandoOfertaBody from './oferta/NoComandoOfertaBody.astro'

// Cada funil tem o seu corpo de oferta, escolhido pela CHAVE do funil (nunca por exclusão: um funil
// novo sem corpo declarado falha alto em vez de cair na página de outro produto).
interface Props extends OfferPageData {
  /** Comunidade Kids: a página 9 a 17 (`/oferta`), a "criar junto" ou a de continuidade. */
  comunidadePage?: ComunidadeOfertaId
  /** Comunidade adulta: a continuidade (`/oferta/continuar`); sem valor, a página principal. */
  comunidadeAdultoPage?: ComunidadeAdultoSubpagina
  desafioProfile?: DesafioOfferId
}
const {
  bodyProps,
  plans,
  comunidadePage = '9a17',
  comunidadeAdultoPage,
  desafioProfile = 'primeiro-jogo',
} = Astro.props
const { f } = bodyProps
const corpo = f.content.sales
  ? 'sales'
  : f.key === COMUNIDADE_DOS_CRIADORES.key
    ? 'comunidade'
    : f.key === COMUNIDADE_ADULTO.key
      ? 'comunidade-adulto'
      : f.key === DESAFIO_PRIMEIRO_JOGO.key
        ? 'desafio'
        : null
if (!corpo) throw new Error(`Funil sem corpo de oferta declarado: ${f.key}`)
---

{
  corpo === 'sales' ? (
    <NoComandoOfertaBody {...bodyProps} />
  ) : corpo === 'comunidade' ? (
    comunidadePage === 'criar-junto' ? (
      <ComunidadeMenor9Body {...bodyProps} plans={plans} />
    ) : comunidadePage === 'continuar' ? (
      <ComunidadeContinuarBody {...bodyProps} plans={plans} />
    ) : (
      <Comunidade917Body {...bodyProps} plans={plans} />
    )
  ) : corpo === 'comunidade-adulto' ? (
    comunidadeAdultoPage === 'continuar' ? (
      <ComunidadeAdultoContinuarBody {...bodyProps} plans={plans} />
    ) : (
      <ComunidadeAdultoOfertaBody {...bodyProps} plans={plans} />
    )
  ) : (
    <DesafioOfertaBody {...bodyProps} profile={desafioProfile} />
  )
}
