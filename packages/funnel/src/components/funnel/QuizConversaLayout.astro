---
// A moldura das telas dos quizzes em conversa (Comunidade Kids v6 e adulta, 20/10/2026): sem topo
// nem rodapé do site; a própria ilha desenha a marca e o "Sair", como no Canvas de 19/10. Os
// tokens dos dois temas vêm de `kids-oferta.css` (Kids) e `theme-arcade.css` (adulto, importado
// pelo global.css).
import '../../styles/kids-oferta.css'
import '../../styles/quiz-spin.css'
import BaseLayout from '../../layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  ogImage: string
  tema: 'kids' | 'adulto'
}
const { title, description, ogImage, tema } = Astro.props
---
<BaseLayout title={title} description={description} ogImage={ogImage} htmlClass={tema === 'adulto' ? 'theme-arcade' : 'theme-kids'} noindex={true}>
  <slot />
</BaseLayout>
