---
// Cabeçalho de seção da página de vendas: título centralizado (padrão do design).
// O FAQ usa align="left".
interface Props {
  title: string
  align?: 'center' | 'left'
  class?: string
}
const { title, align = 'center', class: klass = '' } = Astro.props
---

<h2
  class={`text-2xl font-extrabold leading-tight text-ink sm:text-3xl ${
    align === 'center' ? 'text-center' : 'text-left'
  } ${klass}`}
>
  {title}
</h2>
