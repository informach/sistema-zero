---
import { PRODUTO } from '../content/copy'

// Nome do produto exibido ao lado do logo. Por funil — ausente cai no NCI (compat).
interface Props {
  productName?: string
}
const { productName = PRODUTO.nome } = Astro.props
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-4">
    <img
      src="/img/logo-sistema-zero.svg"
      alt="Sistema Zero"
      class="h-3.5 w-auto sm:h-4"
      decoding="async"
    />
    <span class="text-sm text-muted">· {productName}</span>
  </div>
</header>
