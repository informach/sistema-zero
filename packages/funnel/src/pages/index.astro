---
import '../styles/kids-oferta.css'
import { COMUNIDADE_ADULTO as adulto } from '../funnels/comunidade-adulto'
import { COMUNIDADE_DOS_CRIADORES as kids } from '../funnels/comunidade-dos-criadores'
import BaseLayout from '../layouts/BaseLayout.astro'
import { funnelLinkWithAttribution } from '../lib/lead-attribution'

// Página da bio do Instagram @criecomhelenaejulio (Canvas `PaginaBio.html`, 19/10/2026): quem
// somos, a frase "Criar jogos não tem idade." e dois caminhos, um para cada quiz. Sem atalho para
// a oferta (decisão da dona): quem chega pela bio responde o quiz e recebe o resultado. Os links
// preservam a atribuição sanitizada; a raiz não cria lead.
export const prerender = false
Astro.response.headers.set('cache-control', 'no-store')
const link = (path: string) => funnelLinkWithAttribution(path, Astro.url)
---
<BaseLayout title="Helena e Júlio | Sistema Zero" description="A gente ensina a fazer jogos. Criar jogos não tem idade. Escolha se é para você ou para o seu filho ou filha, e em 3 minutos a gente mostra por onde começar." htmlClass="theme-kids">
  <main class="bio" id="bio">
    <div class="bio-coluna">
      <div class="bio-topo">
        <img class="bio-foto" src={`${kids.imagesBase}/helena-julio-perfil.webp`} alt="Helena e Júlio" width="360" height="360" fetchpriority="high" />
        <p class="bio-quem"><strong>Helena e Júlio</strong><span>A gente ensina a fazer jogos</span></p>
        <h1 class="bio-titulo">Criar jogos não tem idade.</h1>
        <p class="bio-lead">Escolha abaixo se é para você ou para o seu filho ou filha. Em 3 minutos, a gente mostra por onde começar.</p>
      </div>

      <nav class="bio-caminhos" aria-label="Para quem é">
        <!-- O cartão adulto leva a classe do tema arcade só para ler os tokens `--cda-*`. -->
        <a class="theme-arcade bio-cartao bio-cartao--adulto" href={link(`${adulto.basePath}/quiz`)} data-analytics-id="bio-quiz-adulto">
          <span class="bio-cartao-texto">
            <strong>É para mim</strong>
            <span>Tenho 18 anos ou mais e sempre quis fazer um jogo.</span>
          </span>
          <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
        </a>
        <a class="bio-cartao bio-cartao--kids" href={link(`${kids.basePath}/quiz`)} data-analytics-id="bio-quiz-infantil">
          <span class="bio-cartao-texto">
            <strong>É para meu filho ou filha</strong>
            <span>De 9 a 17 anos, ou menor de 9 criando comigo.</span>
          </span>
          <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
        </a>
      </nav>

      <!-- Não é <footer>: o `.theme-kids footer` do global.css (o rodapé largo do site) pintaria uma
           faixa com borda atrás da marca e dos dois links. -->
      <div class="bio-pe">
        <img class="bio-marca" src="/logo_white.svg" alt="Sistema Zero" width="515" height="44" loading="lazy" decoding="async" />
        <p class="bio-legal"><a href="/privacidade">Privacidade</a><span aria-hidden="true">·</span><a href="/termos">Termos de uso</a></p>
      </div>
    </div>
  </main>
</BaseLayout>
<style>
  .bio {
    min-height: 100svh;
    box-sizing: border-box;
    padding: 3rem 1.25rem 2.5rem;
    display: flex;
    justify-content: center;
    background:
      radial-gradient(60% 45% at 50% -8%, color-mix(in oklab, var(--kof-lilas) 75%, transparent), transparent 72%),
      radial-gradient(38% 40% at 100% 100%, color-mix(in oklab, var(--kof-menta) 70%, transparent), transparent 72%),
      var(--kof-chao);
    color: var(--kof-tinta);
    font-family: var(--kof-corpo);
  }
  .bio-coluna {
    width: 100%;
    max-width: 27.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }
  .bio-topo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
  }
  .bio-foto {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--kof-carta);
    box-shadow: 0 6px 18px color-mix(in oklab, var(--kof-tinta) 14%, transparent);
  }
  .bio-quem {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .bio-quem strong {
    font-size: 1.1875rem;
  }
  .bio-quem span {
    font-size: 0.9375rem;
    color: var(--kof-tinta-suave);
  }
  .bio-titulo {
    margin: 0.5rem 0 0;
    font-family: "Bricolage Grotesque", system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.1rem, 9vw, 2.8rem);
    line-height: 1.02;
    text-wrap: balance;
  }
  .bio-lead {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .bio-caminhos {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .bio-cartao {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.375rem;
    border: 3px solid;
    border-radius: 22px;
    text-decoration: none;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }
  .bio-cartao svg {
    flex: 0 0 auto;
  }
  .bio-cartao-texto {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .bio-cartao-texto strong {
    line-height: 1.05;
  }
  .bio-cartao-texto span {
    font-size: 1rem;
    line-height: 1.4;
  }
  .bio-cartao--adulto {
    background: var(--cda-fundo);
    border-color: var(--cda-fundo);
    color: var(--cda-branco);
    box-shadow: 6px 6px 0 var(--cda-amarelo);
  }
  .bio-cartao--adulto strong {
    font-family: var(--cda-titulo);
    font-size: 1.625rem;
  }
  .bio-cartao--adulto .bio-cartao-texto span {
    color: var(--cda-texto-suave);
  }
  .bio-cartao--kids {
    background: var(--kof-carta);
    border-color: var(--kof-tinta);
    color: var(--kof-tinta);
    box-shadow: 6px 6px 0 var(--kof-acao);
  }
  .bio-cartao--kids strong {
    font-family: var(--kof-display);
    font-weight: 800;
    font-size: 1.6875rem;
  }
  .bio-cartao:hover {
    transform: translate(-1px, -1px);
  }
  .bio-cartao:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }
  .bio-cartao:focus-visible {
    outline: 3px solid var(--kof-acao);
    outline-offset: 4px;
  }
  .bio-pe {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }
  .bio-marca {
    width: 6.875rem;
    height: auto;
    opacity: 0.85;
  }
  .bio-legal {
    margin: 0;
    display: flex;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--kof-tinta-suave);
  }
  .bio-legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bio-legal a:hover {
    color: var(--kof-tinta);
  }
  @media (prefers-reduced-motion: reduce) {
    .bio-cartao {
      transition: none;
    }
  }
</style>
