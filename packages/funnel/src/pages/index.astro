---
// Entrada do site → funil default (multi-funil: ver src/funnels). A entrada de um
// funil é o quiz quando ele tem; senão, a própria oferta. Hoje cai em
// /pro/no-comando-da-ia/quiz.
import { DEFAULT_FUNNEL } from '../funnels/registry'

export const prerender = false
const entry = DEFAULT_FUNNEL.steps.quiz
  ? `${DEFAULT_FUNNEL.basePath}/quiz`
  : `${DEFAULT_FUNNEL.basePath}/oferta`
return Astro.redirect(entry, 302)
---
