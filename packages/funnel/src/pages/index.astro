---
import '../styles/kids-oferta.css'
import '../styles/comunidade-oferta.css'
import { COMUNIDADE_DOS_CRIADORES as comunidade } from '../funnels/comunidade-dos-criadores'
import { DESAFIO_PRIMEIRO_JOGO as desafio } from '../funnels/desafio-primeiro-jogo'
import BaseLayout from '../layouts/BaseLayout.astro'
import { funnelLinkWithAttribution } from '../lib/lead-attribution'
export const prerender = false
Astro.response.headers.set('cache-control', 'no-store')
const link = (path: string) => funnelLinkWithAttribution(path, Astro.url)
---
<BaseLayout title="Crie com Helena e Júlio | Sistema Zero" description="Seu filho aprende criando jogos. Aulas, experiências, ferramentas e ajuda na mesma plataforma, para crianças de 9 a 14 anos." htmlClass="theme-kids">
  <main class="cdc bio" id="bio">
    <div class="bio-card">
      <img class="bio-avatar" src={`${desafio.imagesBase}/avatar-helena-julio.webp`} alt="Helena e Júlio" width="360" height="360" fetchpriority="high" />
      <p class="bio-byline">Helena e Júlio · Sistema Zero</p>
      <h1 class="kof-display">Seu filho aprende <em>criando jogos.</em></h1>
      <p class="bio-lead">Aulas, experiências, ferramentas e ajuda na mesma plataforma.</p>
      <p class="bio-age">Comunidade dos Criadores · 9 a 14 anos</p>
      <nav class="bio-links" aria-label="Escolha por onde começar">
        <a class="kof-btn" href={link(`${comunidade.basePath}/oferta`)} data-analytics-id="bio-comunidade">Conhecer a Comunidade e os planos<span aria-hidden="true">→</span></a>
        <a class="bio-link" href={link('/como-funciona/')} data-analytics-id="bio-como-funciona"><span>Ver como meu filho aprende<small>Veja as aulas e a criação de jogos por dentro</small></span><span aria-hidden="true">→</span></a>
        <a class="bio-link" href={link(`${comunidade.basePath}/quiz`)} data-analytics-id="bio-quiz"><span>Descobrir um caminho para meu filho<small>Responda ao quiz da Comunidade</small></span><span aria-hidden="true">→</span></a>
        <a class="bio-link" href={link(`${desafio.basePath}/oferta`)} data-analytics-id="bio-desafio"><span>Conhecer o Desafio do Primeiro Jogo<small>Uma experiência para começar a criar</small></span><span aria-hidden="true">→</span></a>
      </nav>
      <footer><a href="/kids/privacidade">Privacidade</a><span aria-hidden="true"> · </span><a href="/kids/termos">Termos de uso</a></footer>
    </div>
  </main>
</BaseLayout>
<style>
  .bio { min-height: 100svh; padding: 32px 20px 48px; display: grid; place-items: center; background: radial-gradient(ellipse at top, #dedcfb 0, transparent 60%), var(--color-bg); }
  .bio-card { width: min(100%, 510px); text-align: center; }
  .bio-avatar { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; margin: 0 auto 16px; border: 5px solid white; box-shadow: 0 5px 0 #c9c6eb; }
  .bio-byline { font-size: .9rem; font-weight: 800; margin-bottom: 10px; }
  .bio .kof-display { font-size: clamp(2rem, 7vw, 2.8rem); line-height: 1.08; margin: 0; }
  .bio-lead { font-size: 1.05rem; line-height: 1.5; max-width: 390px; margin: 14px auto 8px; }
  .bio-age { font-size: .8rem; color: var(--color-muted); margin-bottom: 24px; }
  .bio-links { display: grid; gap: 12px; }
  .bio-links a { width: 100%; justify-content: space-between; text-align: left; gap: 14px; }
  .bio-link { display: flex; align-items: center; padding: 17px 20px; border: 1.5px solid #d4d1eb; border-radius: 16px; background: white; box-shadow: 0 3px 0 #d4d1eb; font-weight: 800; text-decoration: none; transition: transform .15s; }
  .bio-link:hover { transform: translateY(-2px); }
  .bio-link small { display: block; margin-top: 4px; font-weight: 500; font-size: .78rem; color: var(--color-muted); }
  .bio footer { margin-top: 28px; font-size: .75rem; color: var(--color-muted); }
  .bio footer a { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .bio-link { transition: none; } }
</style>
