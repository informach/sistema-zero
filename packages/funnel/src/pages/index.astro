---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { LANDING, PRODUTO } from '../content/copy'
import { PERGUNTA_1 } from '../content/quiz-config'
import Pergunta1Cards from '../islands/Pergunta1Cards'
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = true
---

<BaseLayout title={`${PRODUTO.nome} — Diagnóstico de criação com IA`} description={LANDING.subtitulo}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <section class="text-center">
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{LANDING.h1}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">{LANDING.subtitulo}</p>
      <p
        class="mt-5 inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-sm text-cyan"
      >
        ⏱ {LANDING.tempo}
      </p>
    </section>

    <section class="mt-10">
      <h2 class="mb-5 text-center text-xl font-bold">{PERGUNTA_1.titulo}</h2>
      <Pergunta1Cards client:visible />
    </section>
  </main>
  <Footer />
</BaseLayout>
