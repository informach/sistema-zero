---
// Entrada do site → funil KIDS (Desafio do Primeiro Jogo). A entrada de um funil é
// o quiz quando ele tem; senão, a própria oferta. Referenciamos o funil kids
// explicitamente (não o DEFAULT_FUNNEL global, que ainda é o PRO e segue como
// fallback de oferta/lead-scope) → cai em /kids/desafio-primeiro-jogo/quiz.
import { DESAFIO_PRIMEIRO_JOGO } from '../funnels/desafio-primeiro-jogo'

export const prerender = false
const home = DESAFIO_PRIMEIRO_JOGO
const entry = home.steps.quiz ? `${home.basePath}/quiz` : `${home.basePath}/oferta`
return Astro.redirect(entry, 302)
---
