---
import Quiz from '../islands/Quiz'
import BaseLayout from '../layouts/BaseLayout.astro'

// SSR de propósito (full review 06/2026): página pré-renderizada é servida
// estática SEM passar pela middleware → ficava SEM security headers (CSP/HSTS/
// X-Frame-Options) em produção, onde NÃO há CDN/proxy p/ repô-los — e o quiz é
// a página onde o usuário passa a sessão inteira. O shell é trivial de renderizar;
// o cache público curto compensa.
export const prerender = false

Astro.response.headers.set('cache-control', 'public, max-age=60, stale-while-revalidate=300')
---

<BaseLayout title="Quiz · No Comando da IA" noindex={true}>
  {/* Pré-carrega os cards da P1 (background-image numa ilha → senão só baixam após
      hidratar + a chamada à API). O preload scanner acha no <head> e baixa em paralelo. */}
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/q1-card-a.webp" type="image/webp" />
    <link rel="preload" as="image" href="/img/q1-card-b.webp" type="image/webp" />
    <link rel="preload" as="image" href="/img/q1-card-c.webp" type="image/webp" />
    <link rel="preload" as="image" href="/img/q1-card-d.webp" type="image/webp" />
  </Fragment>
  <Quiz client:load />
</BaseLayout>
