---
import ComunidadeSection from '../../components/funnel/oferta/ComunidadeSection.astro'
import EmbaixadorDuvidas from '../../components/referrals/EmbaixadorDuvidas.astro'
import PresenteDuvidas from '../../components/referrals/PresenteDuvidas.astro'
import PresenteExperiencia from '../../components/referrals/PresenteExperiencia.astro'
import PresenteLayout from '../../components/referrals/PresenteLayout.astro'
import { AMBASSADOR_SECTIONS } from '../../content/presente'
import EmbaixadorPainel, { type EmbaixadorPainelProps } from '../../islands/EmbaixadorPainel'
import { getDeps } from '../../server/deps'
export const prerender = false
Astro.response.headers.set('cache-control', 'private, no-store')
Astro.response.headers.set('referrer-policy', 'no-referrer')
const token = (Astro.params.token ?? '').trim()
let view: Omit<EmbaixadorPainelProps, 'token'> | null = null
let gatewayDown = false
if (/^[A-Za-z0-9_-]{16,64}$/.test(token)) {
  const result = await getDeps().gateway.getAmbassadorByToken(token)
  if (result.status === 200) view = result.body as Omit<EmbaixadorPainelProps, 'token'>
  else if (result.status !== 404) gatewayDown = true
}
if (!view) Astro.response.status = gatewayDown ? 503 : 404
// Uma URL privada não entra em canonical nem og:url.
const canonical = new URL('/kids/embaixadores', Astro.site ?? Astro.url).href
---
<PresenteLayout title="Seu painel de embaixador | Sistema Zero" description="Compartilhe uma primeira experiência de criação com outras famílias." canonical={canonical} action={view ? { href: '#painel', label: 'Meu link de convite' } : undefined}>
  {view ? <>
    <section id="painel" class="section"><div class="wrap gift-panel"><div class="gift-panel-title"><span class="kof-eyebrow">Seu espaço de embaixador</span><h1 class="kof-h2">Olá, {view.name.split(' ')[0]}. Quem você quer convidar?</h1><p>Você pode oferecer a outra família sete dias do curso Cadê Todo Mundo?, sem custo. A criança conhece uma forma de criar com tecnologia, e o responsável decide quando começar.</p></div><p class="gift-private"><strong>Guarde esta página só para você.</strong> Ela dá acesso ao seu painel e à sua chave Pix. Para convidar uma família, use o link público do presente que aparece abaixo.</p><div class="gift-interactive"><EmbaixadorPainel client:load token={token} {...view} /></div></div></section>
    {AMBASSADOR_SECTIONS.map((section, index) => <ComunidadeSection section={section} index={index} imagesBase="/img/comunidade-dos-criadores" />)}
    <PresenteExperiencia ambassador action={{ href: '#painel', label: 'Quero compartilhar meu convite' }} />
    <EmbaixadorDuvidas />
    <PresenteDuvidas ambassador />
    <section class="section"><div class="wrap gift-form-wrap"><h2 class="kof-h2">Um convite pessoal pode abrir esse primeiro caminho.</h2><div class="gift-prose"><p>Conte para a família por que você lembrou dela. Compartilhe seu link e deixe o responsável conhecer a proposta com calma. A decisão de começar, e de continuar depois, é dele.</p></div><a class="kof-btn" href="#painel">Voltar ao meu link de convite</a></div></section>
  </> : <section class="section"><div class="wrap gift-status"><h1>{gatewayDown ? 'Não conseguimos abrir seu painel agora.' : 'Esta página não está disponível.'}</h1><p>{gatewayDown ? 'Recarregue em alguns instantes. Não é necessário fazer outro cadastro.' : 'Confira se o link do e-mail foi copiado por inteiro. Você também pode acessar o painel pela Área dos pais, se o cadastro estiver vinculado à sua conta.'}</p><a class="kof-link" href="mailto:contato@sistemazero.com.br">Pedir ajuda à equipe</a></div></section>}
</PresenteLayout>
