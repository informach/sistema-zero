---
import CtaButton from '../components/CtaButton.astro'
import Footer from '../components/Footer.astro'
import ImageSlot from '../components/ImageSlot.astro'
import SectionHeading from '../components/SectionHeading.astro'
import ProductJsonLd from '../components/seo/ProductJsonLd.astro'
import { CTA } from '../content/copy'
import { SALES } from '../content/sales-sections'
import PreCheckoutModal from '../islands/PreCheckoutModal'
import BaseLayout from '../layouts/BaseLayout.astro'
import { formatBRLFromCents2 } from '../lib/money'
import { getActiveOffer } from '../server/catalog'
import { getDeps } from '../server/deps'

// SSR (não prerender): nome/preço vêm do catálogo em runtime. Marketing sem dado
// por-usuário → cacheável na borda; reflete mudança de preço da oferta em ~1min.
export const prerender = false

const { env, gateway } = getDeps()
const offer = await getActiveOffer(gateway, env.CATALOG_OFFER_SLUG)
const productName = offer?.productName || env.PRODUCT_NAME
const priceCents = offer?.priceCents ?? env.PRODUCT_PRICE_CENTS
const priceLabel = formatBRLFromCents2(priceCents)
const priceReais = (priceCents / 100).toFixed(2)

Astro.response.headers.set('cache-control', 'public, max-age=60, stale-while-revalidate=300')

const description =
  'Um guia direto para tirar sua ideia do papel com IA sem virar refém dela. Aprenda a comandar a IA com o método Z.E.R.O.'
const ofertaUrl = new URL('/oferta', Astro.site ?? Astro.url).toString()
const trust = ['Garantia de 7 dias', 'Pagamento via Pix ou cartão de crédito', 'Acesso imediato']
---

<BaseLayout title={`${productName} — Pare de pedir código no escuro`} description={description}>
  <ProductJsonLd
    slot="head"
    name={productName}
    description={description}
    price={priceReais}
    url={ofertaUrl}
    image="/img/sales-hero.webp"
  />

  <!-- Sem header: a página de oferta tem apenas footer. -->
  <main>
    <!-- ── Seção 1 — Hero ─────────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 pb-14 pt-10 sm:pt-14">
      <p class="text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-line/70 bg-card/50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.18em] text-lime"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
          Ebook + kit prático
        </span>
      </p>

      <h1
        class="mt-7 text-balance text-center text-3xl font-extrabold leading-[1.12] sm:text-[2.75rem]"
      >
        {SALES.s1.titulo}
      </h1>

      <div class="mx-auto max-w-2xl">
        {
          SALES.s1.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>

      <div class="mt-9">
        <ImageSlot
          src="/img/sales-hero.webp"
          alt="No Comando da IA"
          ratio="16 / 9"
          class="rounded-2xl"
        />
      </div>

      <div
        class="mx-auto mt-9 max-w-md rounded-2xl border border-lime/40 bg-card/60 p-6 text-center sm:p-7"
      >
        <p class="text-sm font-semibold text-muted">por apenas</p>
        <p class="mt-1 text-5xl font-extrabold text-lime">{priceLabel}</p>
        <p class="mt-2 text-sm text-muted">Pagamento único · acesso imediato</p>
        <CtaButton label={CTA.principal} class="mt-5 w-full" />
        <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted">
          {
            trust.map((t) => (
              <li class="inline-flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5 text-lime" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M4 10.5l3.5 3.5L16 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Seção 2 — Para quem é ──────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s2.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s2.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
      <p class="mt-8 text-sm font-bold text-ink">{SALES.s2.introLista}</p>
      <ul class="mt-3 flex flex-col gap-2.5">
        {
          SALES.s2.bullets.map((b) => (
            <li class="flex items-start gap-3 rounded-xl border border-line/60 bg-card/40 px-4 py-3.5 text-sm leading-relaxed text-ink">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-lime"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 10.5l3.5 3.5L16 6"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── Seção 3 — A armadilha ──────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s3.titulo} />
      <div
        class="mt-7 rounded-2xl border border-line/60 border-l-4 border-l-lime/70 bg-card/40 p-6 sm:p-7"
      >
        {
          SALES.s3.paragrafos.map((p) => (
            <p class="leading-relaxed text-muted [&:not(:first-child)]:mt-4">{p}</p>
          ))
        }
      </div>
    </section>

    <!-- ── Seção 4 — Antes e depois ───────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s4.titulo} />
      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-line/60 bg-card/40 p-5">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-muted">
            {SALES.s4.cabecalho.antes}
          </p>
          <ul class="flex flex-col gap-3.5">
            {
              SALES.s4.linhas.map(([antes]) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-red-400/80"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 6l8 8M14 6l-8 8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span>{antes}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-2xl border border-lime/40 bg-lime/5 p-5">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-lime">
            {SALES.s4.cabecalho.depois}
          </p>
          <ul class="flex flex-col gap-3.5">
            {
              SALES.s4.linhas.map(([, depois]) => (
                <li class="flex items-start gap-2.5 text-sm font-semibold leading-relaxed text-ink">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-lime"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10.5l3.5 3.5L16 6"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{depois}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Seção 5 — Método Z.E.R.O. ──────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s5.titulo} />
      <div class="mt-7 flex flex-col gap-2.5">
        {
          SALES.s5.metodo.map((m) => (
            <div class="flex gap-4 rounded-xl border border-line/60 bg-card/40 p-5">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-lime text-xl font-extrabold text-[#0b0f14]">
                {m.letra}
              </span>
              <div>
                <p class="font-bold text-ink">{m.titulo}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted">{m.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Seção 5B — Primeiros passos ────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s5b.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s5b.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
      <p class="mt-8 text-sm font-bold text-ink">{SALES.s5b.introExemplos}</p>
      <div class="mt-3 flex flex-col gap-2.5">
        {
          SALES.s5b.exemplos.map((e) => (
            <div class="flex items-start gap-3.5 rounded-xl border border-line/60 bg-card/40 p-4">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-lime/15 text-lime">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M4 10.5l3.5 3.5L16 6"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-ink">{e.titulo}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-muted">{e.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center leading-relaxed text-muted">
        {SALES.s5b.fechamento}
      </p>
    </section>

    <!-- ── Seção 6 — O que você recebe ────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s6.titulo} />
      <div
        class="mx-auto mt-7 flex max-w-2xl items-start gap-3.5 rounded-2xl border border-lime/40 bg-card/50 p-5"
      >
        <svg
          class="mt-0.5 h-6 w-6 shrink-0 text-lime"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 5.5A1.5 1.5 0 015.5 4H11v15.5l-.8-.5a4 4 0 00-2.2-.66H5.5A1.5 1.5 0 014 16.84V5.5z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
          <path
            d="M20 5.5A1.5 1.5 0 0018.5 4H13v15.5l.8-.5a4 4 0 012.2-.66h2.5A1.5 1.5 0 0020 16.84V5.5z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <p class="text-sm font-semibold leading-relaxed text-ink">{SALES.s6.ebook}</p>
      </div>

      <div class="mt-6">
        <ImageSlot
          src="/img/recebe-ebook-kit.webp"
          alt="Ebook No Comando da IA com o kit prático de aplicação"
          ratio="16 / 9"
          class="rounded-2xl"
        />
      </div>

      <p class="mt-8 text-sm font-bold text-ink">{SALES.s6.kitTitulo}</p>
      <div class="mt-3">
        <ImageSlot
          src="/img/recebe-anexos.webp"
          alt="Anexos do kit prático de aplicação impressos"
          ratio="16 / 9"
          class="rounded-2xl"
        />
      </div>
      <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
        {
          SALES.s6.kit.map((item) => (
            <div class="flex items-center gap-3 rounded-xl border border-line/60 bg-card/40 px-4 py-3.5">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-lime/15 text-lime">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M4 10.5l3.5 3.5L16 6"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="text-sm font-semibold text-ink">{item}</span>
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <CtaButton label={CTA.principal} class="w-full sm:w-auto" />
      </div>
    </section>

    <!-- ── Seção 7 — O resultado final ────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s7.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s7.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <CtaButton label={CTA.principal} class="w-full sm:w-auto" />
      </div>
    </section>

    <!-- ── Seção 8 — Bônus ────────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s8.titulo} />
      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        {
          SALES.s8.bonus.map((b) => (
            <div class="flex flex-col gap-4 rounded-2xl border border-line/60 bg-card/40 p-5">
              <span class="self-start rounded-md bg-lime px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-[#0b0f14]">
                Bônus
              </span>
              <ImageSlot src={b.img} alt={b.imgAlt} ratio="4 / 3" class="rounded-xl" />
              <div>
                <p class="font-bold text-lime">{b.titulo}</p>
                <p class="mt-2 text-sm leading-relaxed text-muted">{b.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Seção 9 — O que não é ──────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s9.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s9.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
    </section>

    <!-- ── Seção 9B — Para onde te leva ───────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s9b.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s9b.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
      <p class="mt-8 text-sm font-bold text-ink">{SALES.s9b.introLista}</p>
      <ul class="mt-3 flex flex-col gap-2.5">
        {
          SALES.s9b.bullets.map((b) => (
            <li class="flex items-start gap-3 rounded-xl border border-line/60 bg-card/40 px-4 py-3.5 text-sm leading-relaxed text-muted">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-lime"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 10.5l3.5 3.5L16 6"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 font-semibold leading-relaxed text-ink">{SALES.s9b.fechamento}</p>
    </section>

    <!-- ── Seção 10 — Por que agora ───────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s10.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s10.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
    </section>

    <!-- ── Seção 11 — Quem criou ──────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s11.titulo} />
      <div class="mx-auto max-w-2xl">
        {
          SALES.s11.paragrafos.map((p) => (
            <p class="mt-5 text-center leading-relaxed text-muted">{p}</p>
          ))
        }
      </div>
      <div class="mt-7">
        <ImageSlot
          src={SALES.s11.foto.src}
          alt={SALES.s11.foto.alt}
          ratio="16 / 9"
          class="rounded-2xl"
        />
      </div>
      <p class="mt-8 text-sm font-bold text-ink">{SALES.s11.legendaPrints}</p>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {
          SALES.s11.prints.map((img) => (
            <figure>
              <ImageSlot src={img.src} alt={img.alt} ratio="4 / 3" class="rounded-xl" />
              <figcaption class="mt-2 text-xs font-semibold leading-relaxed text-muted">
                {img.legenda}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- ── Seção 12 — Garantia ────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <div class="flex items-start gap-4 rounded-2xl border border-line/60 bg-card/50 p-6">
        <svg
          class="mt-0.5 h-9 w-9 shrink-0 text-lime"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6l7-3z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
          <path
            d="M9 12l2 2 4-4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <div>
          <h2 class="font-bold text-ink">{SALES.s12.titulo}</h2>
          {
            SALES.s12.paragrafos.map((p) => (
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{p}</p>
            ))
          }
        </div>
      </div>
      <div class="mt-8 text-center">
        <CtaButton label={CTA.comecar} class="w-full sm:w-auto" />
      </div>
    </section>

    <!-- ── Seção 13 — FAQ ─────────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
      <SectionHeading title={SALES.s13.titulo} align="left" />
      <div class="mt-6 flex flex-col gap-2.5">
        {
          SALES.s13.faq.map((item) => (
            <details class="group rounded-xl border border-line/60 bg-card/40 px-5 py-4 transition hover:border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-bold text-ink [&::-webkit-details-marker]:hidden">
                {item.pergunta}
                <svg
                  class="h-5 w-5 shrink-0 text-muted transition-transform duration-200 group-[[open]]:rotate-180"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M5 8l5 5 5-5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.resposta}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ── CTA final ──────────────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-4 pb-10 pt-4">
      <div class="rounded-2xl border border-line/60 bg-card/60 p-8 text-center sm:p-10">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-cyan">{productName}</p>
        <div class="mt-4 flex items-baseline justify-center gap-2">
          <span class="text-sm text-muted">por apenas</span>
          <span class="text-5xl font-extrabold text-lime">{priceLabel}</span>
        </div>
        <p class="mt-3 text-sm text-muted">
          Pagamento único via Pix ou cartão de crédito · garantia de 7 dias
        </p>
        <div class="mt-7 flex justify-center">
          <CtaButton label={CTA.principal} class="w-full sm:w-auto" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PreCheckoutModal client:idle />
</BaseLayout>
