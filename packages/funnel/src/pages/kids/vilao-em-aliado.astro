---
// Página pública e indexável do guia para pais "Transformando o vilão em aliado" (25/11/2026): a
// página de venda do funil `kids/vilao-em-aliado` (o mesmo corpo de `/kids/vilao-em-aliado/oferta`).
// O guia virou curso pago normal; o presente sai pelos links de campanha e de embaixador, que abrem
// esta página no modo presente (`?presente=`). O endereço antigo da campanha do guia é tratado pelo
// redirecionamento genérico de campanha (middleware), sem código fixo aqui.
import OfertaPage from '../../components/funnel/OfertaPage.astro'
import { resolveOfferPage } from '../../server/offer-page'

export const prerender = false
const page = await resolveOfferPage(
  { audience: 'kids', produto: 'vilao-em-aliado' },
  Astro.url,
  Astro.site,
)
if (page instanceof Response) return page
Astro.response.headers.set(
  'cache-control',
  page.noStore ? 'no-store' : 'public, max-age=60, stale-while-revalidate=300',
)
---
<OfertaPage {...page} />
