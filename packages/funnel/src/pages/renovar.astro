---
import { FUNNEL_KEYS, getFunnelByKey } from '../funnels/registry'
import { getActiveOffer } from '../server/catalog'
import { getDeps } from '../server/deps'

export const prerender = false

// Destino do LEMBRETE de renovação do plano anual à vista (e-mail do members):
// `/renovar?oferta=<slug>` → resolve o FUNIL que vende a oferta e manda ao
// checkout dele. O slug pode ser a oferta PRINCIPAL do funil (env
// FUNNEL_OFFER_*) ou a IRMÃ do alternador (altOffer da principal, no catálogo)
// — nesse caso o `?oferta=` repassado pré-seleciona o plano certo no checkout.
Astro.response.headers.set('cache-control', 'no-store')

const slug = (Astro.url.searchParams.get('oferta') ?? '').trim().toLowerCase()
const { env, gateway } = getDeps()

let dest = '/'
if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  const direct = FUNNEL_KEYS.find((key) => env.offerByFunnel[key] === slug)
  if (direct) {
    const f = getFunnelByKey(direct)
    if (f) dest = `${f.basePath}/checkout`
  } else {
    for (const key of FUNNEL_KEYS) {
      const principal = env.offerByFunnel[key]
      if (!principal) continue
      const offer = await getActiveOffer(gateway, principal)
      if (offer?.altOffer?.slug === slug) {
        const f = getFunnelByKey(key)
        if (f) {
          dest = `${f.basePath}/checkout?oferta=${encodeURIComponent(slug)}`
          break
        }
      }
    }
  }
}

return Astro.redirect(dest, 302)
---
