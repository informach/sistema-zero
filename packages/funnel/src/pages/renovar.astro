---
import { getDeps } from '../server/deps'
import { pageForOffer } from '../server/page-offer'

export const prerender = false

// Destino do LEMBRETE de renovação do plano anual à vista (e-mail do members):
// `/renovar?oferta=<slug>` → a página do PRODUTO da oferta (catálogo, 25/11/2026) e o checkout
// dela; a oferta que não é a principal vai com `?oferta=` (pré-seleciona o plano certo).
Astro.response.headers.set('cache-control', 'no-store')

const slug = (Astro.url.searchParams.get('oferta') ?? '').trim().toLowerCase()
const { gateway, log } = getDeps()

if (slug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  for (const audience of ['kids', 'adult'] as const) {
    const page = await pageForOffer(gateway, slug, audience, { log })
    if (page)
      return Astro.redirect(
        page.primary
          ? `${page.funnel.basePath}/checkout`
          : `${page.funnel.basePath}/checkout?oferta=${encodeURIComponent(slug)}`,
        302,
      )
  }
}

return Astro.redirect('/', 302)
---
