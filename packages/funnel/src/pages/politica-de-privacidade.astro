---
import Footer from '../components/Footer.astro'
import LegalDocument from '../components/LegalDocument.astro'
import { PRIVACIDADE } from '../content/legal'
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = true
---

<BaseLayout title={`${PRIVACIDADE.titulo} — No Comando da IA`} description={PRIVACIDADE.descricao}>
  <LegalDocument doc={PRIVACIDADE} />
  <Footer />
</BaseLayout>
