---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { clearLeadCookie } from '../lib/lead-session'
import { getDeps } from '../server/deps'

// SSR (não estática) só para EXPIRAR o cookie do lead após a compra: assim um novo
// checkout começa limpo (sem CPF/dados antigos; nome/e-mail/telefone voltam da URL).
export const prerender = false

const { env } = getDeps()
Astro.response.headers.set('cache-control', 'no-store')
Astro.response.headers.append('set-cookie', clearLeadCookie(env.NODE_ENV === 'production'))
---

<BaseLayout title="Compra confirmada — No Comando da IA" noindex={true}>
  <Header />
  <main class="mx-auto max-w-xl px-4 py-20 text-center">
    <div class="text-5xl">✅</div>
    <h1 class="mt-4 text-3xl font-bold">Pagamento confirmado!</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Obrigado por assumir o comando. Você vai receber o acesso ao
      <strong class="text-ink">No Comando da IA</strong> e ao kit prático no seu e-mail em instantes.
    </p>
    <p class="mt-2 text-muted">Se não encontrar, confira a caixa de spam ou promoções.</p>
    <a href="/oferta" class="btn btn-ghost mt-8">Voltar à página</a>
  </main>
  <Footer />
</BaseLayout>
