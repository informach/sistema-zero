---
import { COMUNIDADE_DOS_CRIADORES } from '../../funnels/comunidade-dos-criadores'

// Endereço antigo (até 20/10/2026, um Termo por público). O Kids continua apontando para o Termo
// da assinatura, o mais procurado pelos links da plataforma; o Pro vai ao índice dos Termos.
export const prerender = false

const audience = Astro.params.audience
if (audience !== 'pro' && audience !== 'kids') return new Response(null, { status: 404 })
return Astro.redirect(
  audience === 'kids' ? `${COMUNIDADE_DOS_CRIADORES.basePath}/termos` : '/termos',
  301,
)
---
