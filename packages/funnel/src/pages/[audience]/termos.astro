---
import Footer from '../../components/Footer.astro'
import LegalDocument from '../../components/LegalDocument.astro'
import { TERMOS } from '../../content/legal'
import { TERMOS_KIDS } from '../../content/legal-kids'
import BaseLayout from '../../layouts/BaseLayout.astro'

// SSR de propósito: pré-renderizada não passa pela middleware → sem security
// headers em produção (sem CDN p/ repô-los). Conteúdo estático → cache curto.
export const prerender = false

// Público resolvido pela URL. Inválido → 404 (não vira catch-all). Espelha
// [audience]/index.astro.
const audience = Astro.params.audience
if (audience !== 'pro' && audience !== 'kids') return new Response(null, { status: 404 })

const doc = audience === 'kids' ? TERMOS_KIDS : TERMOS
const areaLabel = audience === 'kids' ? 'Sistema Zero Kids' : 'Sistema Zero'

Astro.response.headers.set('cache-control', 'public, max-age=300, stale-while-revalidate=3600')
---

<BaseLayout
  title={`${doc.titulo} · ${areaLabel}`}
  description={doc.descricao}
  htmlClass={audience === 'kids' ? 'theme-kids' : undefined}
>
  {/* Fallback do kids = a bio da raiz (o /kids redirecionaria pro quiz). */}
  <LegalDocument doc={doc} voltarHref={audience === 'kids' ? '/' : `/${audience}`} />
  <Footer audience={audience} />
</BaseLayout>
