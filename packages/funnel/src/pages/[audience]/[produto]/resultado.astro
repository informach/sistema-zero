---
import { leadBelongsToFunnel } from '../../../funnels/lead-scope'
import { getFunnel, isQuizComplete } from '../../../funnels/registry'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getLeadId } from '../../../lib/lead-session'
import { funnelOgImage } from '../../../lib/seo'
import { getDeps } from '../../../server/deps'

export const prerender = false

Astro.response.headers.set('cache-control', 'no-store')

// Funil resolvido pela URL; sem o passo de resultado / sem quiz com perfil → 404.
const f = getFunnel(Astro.params.audience, Astro.params.produto)
if (!f) return new Response(null, { status: 404 })
const result = f.content.result
const quiz = f.content.quiz
if (!f.steps.resultado || !result || !quiz?.computePerfil) {
  return new Response(null, { status: 404 })
}

const quizPath = `${f.basePath}/quiz`
const leadId = getLeadId(Astro.request)
if (!leadId) return Astro.redirect(quizPath)

const { repo } = getDeps()
const lead = await repo.getLead(leadId)
if (!lead) return Astro.redirect(quizPath)
if (!leadBelongsToFunnel(lead.funnel, f.key)) return Astro.redirect(quizPath)

// Resultado aberto sem o quiz respondido: volta pro quiz (sem diagnóstico vazio).
const answers = lead.quizAnswers ?? {}
if (!isQuizComplete(quiz, answers)) return Astro.redirect(quizPath)

await repo.insertEvent(lead.id, 'viu_resultado', 'resultado')

// Perfil: usa o persistido (se válido p/ este funil) ou roda o motor do funil agora
// e persiste (one-shot). Viaja na URL p/ o hero da oferta.
const stored =
  lead.perfilResultado && lead.perfilResultado in result.profiles ? lead.perfilResultado : null
const perfil = stored ?? quiz.computePerfil(answers)
if (!stored) await repo.updateLead(lead.id, { perfilResultado: perfil })

const bloco = result.profiles[perfil]
if (!bloco) return Astro.redirect(quizPath)
const rc = (s: string) => (result.renderCorpo ? result.renderCorpo(s, answers) : s)
// Diagnóstico em blocos (`secoes`) quando o funil os define; senão, corpo corrido (fallback).
// Seção que resolve vazia (ex.: bloco de custo condicional omitido) é descartada.
const secoesRender = bloco.secoes
  ?.map((s) => ({ rotulo: s.rotulo, texto: rc(s.texto) }))
  .filter((s) => s.texto.length > 0)
const secoes = secoesRender && secoesRender.length > 0 ? secoesRender : null
const corpo = bloco.corpo ? rc(bloco.corpo) : null
const destaque = result.destaque ? rc(result.destaque) : null
// Segmento enum não-PII do desejo (P10) p/ a oferta retomar; só quando existe (Desafio).
const querSeg = typeof answers.o_que_quer === 'string' ? `&quer=${answers.o_que_quer}` : ''
const ofertaHref = `${f.basePath}/oferta?perfil=${perfil}${querSeg}`
const fecho = rc(result.fecho)
---

<BaseLayout
  title={`Seu diagnóstico · ${f.productName}`}
  description={f.seoDescription}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  noindex={true}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <!-- Sem header/footer: a tela é a continuação direta do quiz. -->
  <div class="relative min-h-screen">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_75%_55%_at_50%_-12%,rgba(66,232,224,0.12),transparent_60%)]"
    >
    </div>
    <!-- Barra cheia no topo: o quiz terminou. -->
    <div class="fixed inset-x-0 top-0 z-20 h-1.5 bg-gradient-to-r from-cyan to-lime"></div>

    <main class="mx-auto max-w-2xl px-4 py-20 sm:py-24">
      <p
        class="reveal-up inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-cyan"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
        Seu diagnóstico
      </p>

      <h1
        class="reveal-up mt-5 text-balance text-3xl font-extrabold leading-[1.1] text-ink sm:text-[2.5rem]"
        style="animation-delay: 60ms"
      >
        {bloco.titulo}
      </h1>

      {
        secoes ? (
          <div
            class="reveal-up card mt-8 border-line/80 bg-card-2/60 px-6 sm:px-7"
            style="animation-delay: 120ms"
          >
            {secoes.map((s, i) => (
              <div class={i > 0 ? 'border-t border-line/60 py-5' : 'py-5'}>
                <div class="mb-2 flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-cyan" />
                  <span class="text-xs font-bold uppercase tracking-[0.14em] text-cyan">
                    {s.rotulo}
                  </span>
                </div>
                <p class="text-base leading-relaxed text-ink/90">{s.texto}</p>
              </div>
            ))}
          </div>
        ) : (
          <div
            class="reveal-up card mt-8 border-line/80 bg-card-2/60 p-6 sm:p-7"
            style="animation-delay: 120ms"
          >
            <p class="text-base leading-relaxed text-ink/90 sm:text-lg">{corpo}</p>
          </div>
        )
      }

      {
        destaque && (
          <div
            class="reveal-up mt-6 border-l-4 border-cyan bg-cyan/10 py-4 pl-4 pr-4"
            style="animation-delay: 160ms"
          >
            <p class="text-base leading-relaxed text-ink/90">{destaque}</p>
          </div>
        )
      }

      <p
        class="reveal-up mt-7 text-lg font-semibold leading-snug text-ink"
        style="animation-delay: 200ms"
      >
        {fecho}
      </p>

      <a
        href={ofertaHref}
        class="reveal-up btn btn-primary mt-10 w-full text-center sm:w-auto"
        style="animation-delay: 240ms"
      >
        {bloco.cta} →
      </a>
    </main>
  </div>
</BaseLayout>
