---
import ComunidadeQuizLayout from '../../../components/funnel/ComunidadeQuizLayout.astro'
import ComunidadeResultado from '../../../components/funnel/ComunidadeResultado.astro'
import DesafioQuizLayout from '../../../components/funnel/DesafioQuizLayout.astro'
import DesafioResultado from '../../../components/funnel/DesafioResultado.astro'
import { quizRevision } from '../../../funnels/comunidade-dos-criadores/quiz/engine'
import { buildCommunityResult } from '../../../funnels/comunidade-dos-criadores/quiz/result'
import { buildDesafioResult } from '../../../funnels/desafio-primeiro-jogo/quiz/result'
import { leadBelongsToFunnel } from '../../../funnels/lead-scope'
import { getFunnel, isQuizComplete } from '../../../funnels/registry'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { funnelLinkWithAttribution } from '../../../lib/lead-attribution'
import { getLeadId } from '../../../lib/lead-session'
import { funnelOgImage } from '../../../lib/seo'
import { getDeps } from '../../../server/deps'
import { desafioQuizPrice } from '../../../server/desafio-price'
import { quizSessionToken } from '../../../server/quiz-session'

export const prerender = false

Astro.response.headers.set('cache-control', 'no-store')

// Funil resolvido pela URL; sem o passo de resultado / sem quiz com perfil → 404.
const f = getFunnel(Astro.params.audience, Astro.params.produto)
if (!f) return new Response(null, { status: 404 })
const quizUrl = funnelLinkWithAttribution(`${f.basePath}/quiz`, Astro.url)
const result = f.content.result
const quiz = f.content.quiz
if (!f.steps.resultado || !result || !quiz?.computePerfil) {
  return new Response(null, { status: 404 })
}

const leadId = getLeadId(Astro.request)
if (!leadId) return Astro.redirect(quizUrl)

const { repo } = getDeps()
const lead = await repo.getLead(leadId)
if (!lead) return Astro.redirect(quizUrl)
if (!leadBelongsToFunnel(lead.funnel, f.key)) return Astro.redirect(quizUrl)

// Resultado aberto sem o quiz respondido: volta pro quiz (sem resultado vazio).
const answers = lead.quizAnswers ?? {}
if (!isQuizComplete(quiz, answers)) return Astro.redirect(quizUrl)

const communityResult = quiz.presentation === 'comunidade' ? buildCommunityResult(answers) : null
const desafioResult = quiz.presentation === 'desafio' ? buildDesafioResult(answers) : null
if (quiz.presentation === 'desafio' && !desafioResult) return Astro.redirect(quizUrl)
const desafioPrice = desafioResult ? await desafioQuizPrice(f) : null
if (quiz.presentation === 'comunidade' && !communityResult) return Astro.redirect(quizUrl)

await repo.insertEvent(
  lead.id,
  'viu_resultado',
  'resultado',
  communityResult
    ? {
        quiz_version: answers._quiz_version,
        revision: quizRevision(answers),
        perfil_principal: communityResult.decision.profile,
        estado: communityResult.decision.state,
        adequacao: communityResult.decision.adequacy,
        destino: communityResult.offerPath,
      }
    : desafioResult
      ? {
          quiz_version: answers._quiz_version,
          revision: quizRevision(answers),
          perfil_principal: desafioResult.decision.principal,
          estado: desafioResult.decision.state,
          adequacao: desafioResult.decision.adequacy,
          proximo_passo: desafioResult.decision.next,
          destino: desafioResult.decision.offerPath,
        }
      : undefined,
  desafioResult ? `${lead.id}:desafio-result:${quizRevision(answers)}` : undefined,
)

// Perfil: usa o persistido (se válido p/ este funil) ou roda o motor do funil agora
// e persiste (one-shot). Viaja na URL p/ o hero da oferta.
const stored =
  lead.perfilResultado && lead.perfilResultado in result.profiles ? lead.perfilResultado : null
const perfil = stored ?? quiz.computePerfil(answers)
if (!communityResult && !desafioResult && !stored)
  await repo.updateLead(lead.id, { perfilResultado: perfil })

const bloco = perfil ? result.profiles[perfil] : undefined
if (!communityResult && !desafioResult && !bloco) return Astro.redirect(quizUrl)
const rc = (s: string) => (result.renderCorpo ? result.renderCorpo(s, answers) : s)
// Resultado em blocos (`secoes`) quando o funil os define; senão, corpo corrido (fallback).
// Seção que resolve vazia (ex.: bloco de custo condicional omitido) é descartada.
const secoesRender = bloco?.secoes
  ?.map((s) => ({ rotulo: s.rotulo, texto: rc(s.texto) }))
  .filter((s) => s.texto.length > 0)
const secoes = secoesRender && secoesRender.length > 0 ? secoesRender : null
const corpo = bloco?.corpo ? rc(bloco.corpo) : null
const destaque = result.destaque ? rc(result.destaque) : null
// Segmento enum não-PII do desejo para a oferta retomar; só quando existe (Desafio).
const querSeg =
  typeof answers.resultado_desejado === 'string' ? `&quer=${answers.resultado_desejado}` : ''
const ofertaHref = `${f.basePath}/oferta?perfil=${perfil}${querSeg}`
const fecho = rc(result.fecho)
---

{desafioResult ? (
  <DesafioQuizLayout title="Seu primeiro passo com jogos | Sistema Zero" description={f.seoDescription} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}>
    <DesafioResultado result={desafioResult} basePath={f.basePath} priceLabel={desafioPrice}/>
  </DesafioQuizLayout>
) : communityResult ? (
  <ComunidadeQuizLayout title="Seu ponto de partida | Sistema Zero" description={f.seoDescription} imagesBase={f.imagesBase} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}>
    <ComunidadeResultado result={communityResult} imagesBase={f.imagesBase} basePath={f.basePath} funnel={f.key} revision={quizRevision(answers)} sessionToken={quizSessionToken(lead.id)} />
  </ComunidadeQuizLayout>
) : bloco && (<BaseLayout
  title={`Seu mapa de criação | ${f.productName}`}
  description={f.seoDescription}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  noindex={true}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <!-- Sem header/footer: a tela é a continuação direta do quiz. -->
  <div class="relative min-h-screen">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_75%_55%_at_50%_-12%,color-mix(in_srgb,var(--color-cyan)_12%,transparent),transparent_60%)]"
    >
    </div>
    <!-- Barra cheia no topo: o quiz terminou. -->
    <div class="fixed inset-x-0 top-0 z-20 h-1.5 bg-gradient-to-r from-cyan to-lime"></div>

    <main class="mx-auto max-w-2xl px-4 py-20 sm:py-24">
      <p
        class="reveal-up inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-cyan"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
        Seu mapa de criação
      </p>

      <h1
        class="reveal-up mt-5 text-balance text-3xl font-extrabold leading-[1.1] text-ink sm:text-[2.5rem]"
        style="animation-delay: 60ms"
      >
        {bloco.titulo}
      </h1>

      {
        secoes ? (
          <div
            class="reveal-up card mt-8 border-line/80 bg-card-2/60 px-6 sm:px-7"
            style="animation-delay: 120ms"
          >
            {secoes.map((s, i) => (
              <div class={i > 0 ? 'border-t border-line/60 py-5' : 'py-5'}>
                <div class="mb-2 flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-cyan" />
                  <span class="text-xs font-bold uppercase tracking-[0.14em] text-cyan">
                    {s.rotulo}
                  </span>
                </div>
                <p class="text-base leading-relaxed text-ink/90">{s.texto}</p>
              </div>
            ))}
          </div>
        ) : (
          <div
            class="reveal-up card mt-8 border-line/80 bg-card-2/60 p-6 sm:p-7"
            style="animation-delay: 120ms"
          >
            <p class="text-base leading-relaxed text-ink/90 sm:text-lg">{corpo}</p>
          </div>
        )
      }

      {
        destaque && (
          <div
            class="reveal-up mt-6 border-l-4 border-cyan bg-cyan/10 py-4 pl-4 pr-4"
            style="animation-delay: 160ms"
          >
            <p class="text-base leading-relaxed text-ink/90">{destaque}</p>
          </div>
        )
      }

      <p
        class="reveal-up mt-7 text-lg font-semibold leading-snug text-ink"
        style="animation-delay: 200ms"
      >
        {fecho}
      </p>

      <a
        href={ofertaHref}
        class="reveal-up btn btn-primary mt-10 w-full text-center sm:w-auto"
        style="animation-delay: 240ms"
      >
        {bloco.cta} →
      </a>
    </main>
  </div>
</BaseLayout>)}
