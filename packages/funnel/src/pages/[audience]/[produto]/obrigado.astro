---
import Footer from '../../../components/Footer.astro'
import Header from '../../../components/Header.astro'
import { EMPRESA } from '../../../content/legal'
import { getFunnel } from '../../../funnels/registry'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {
  computeFixedAccessExpiry,
  fixedAccessFromSnapshot,
  formatSaoPauloDateTime,
} from '../../../lib/access-period'
import { getLeadId } from '../../../lib/lead-session'
import { funnelOgImage } from '../../../lib/seo'
import { getDeps } from '../../../server/deps'
import { parsePurchasedOfferSnapshot } from '../../../server/purchased-offer-snapshot'

// SSR (não estática): lê a aprovação e o snapshot congelado para mostrar a data
// contratual exata. O checkout já rejeita/recria leads pagos em uma nova compra;
// manter a sessão aqui permite recarregar a confirmação sem perder o comprovante.
export const prerender = false

// Funil resolvido pela URL. Inexistente → 404.
const f = getFunnel(Astro.params.audience, Astro.params.produto)
if (!f) return new Response(null, { status: 404 })

const { env, repo } = getDeps()
Astro.response.headers.set('cache-control', 'no-store')

const leadId = getLeadId(Astro.request)
const lead = leadId ? await repo.getLead(leadId) : null
const paymentContext = lead?.paymentId ? await repo.paymentContext(lead.paymentId) : null
const purchased = parsePurchasedOfferSnapshot(paymentContext?.offerSnapshot ?? null)
const fixedAccess = fixedAccessFromSnapshot(purchased)
const approved = Boolean(lead?.paidAt)
const accessEnd =
  approved && lead?.paidAt && fixedAccess
    ? computeFixedAccessExpiry(lead.paidAt, fixedAccess)
    : null
const buyerEmail = paymentContext?.email ?? lead?.email ?? null
const isTimedChallenge = f.key === 'kids/desafio-primeiro-jogo' && fixedAccess !== null
const isCommunity = f.key === 'kids/comunidade-dos-criadores'

// CTA p/ a área de membros (mesma base do link do e-mail de boas-vindas). Por
// audiência: o funil kids leva ao app KIDS, não ao community adulto.
const communityUrl = f.audience === 'kids' ? env.KIDS_COMMUNITY_URL : env.COMMUNITY_URL

// O que a compra entrega + próximos passos vêm do conteúdo do funil.
const { entrega, passos } = f.content.obrigado
// Frase de abertura por funil (kids fala da criança; default = NCI "assumir o comando").
const introObrigado = f.content.obrigado.intro ?? 'Obrigado por assumir o comando.'
const productName = f.productName
// Artigo do produto ("acesso AO Desafio" × "acesso À Comunidade") — do FunnelCopy.
const acessoArtigo = f.content.copy.artigo === 'a' ? 'à' : 'ao'
const pageTitle = approved
  ? `Compra confirmada | ${productName}`
  : `Pagamento em análise | ${productName}`
const confirmationTitle = approved
  ? isTimedChallenge
    ? 'Pagamento aprovado. Agora o primeiro jogo pode sair do papel.'
    : isCommunity
      ? 'Assinatura confirmada. Agora vamos preparar o primeiro acesso.'
      : 'Pagamento confirmado!'
  : 'Pagamento ainda aguardando confirmação.'
---

<BaseLayout
  title={pageTitle}
  description={f.seoDescription}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  noindex={true}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <Header productName={productName} />
  <main class:list={['mx-auto max-w-2xl px-4 py-14 sm:py-20', { 'kids-thanks': f.theme === 'kids' }]}>
    <!-- ── Confirmação ──────────────────────────────────────────────────── -->
    <section class="kids-thanks-hero reveal-up text-center">
      <div class:list={['check-badge mx-auto', { pending: !approved }]} aria-hidden="true">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none">
          {
            approved ? (
              <path
                d="M5 12.5l4.5 4.5L19 7.5"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            ) : (
              <>
                <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="2" />
                <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </>
            )
          }
        </svg>
      </div>
      <h1 class="mt-6 text-3xl font-extrabold sm:text-4xl">{confirmationTitle}</h1>
      <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-muted">
        {
          approved ? (
            isTimedChallenge && accessEnd ? (
              <>
                Seu acesso vai até <strong class="text-ink">{formatSaoPauloDateTime(accessEnd)}</strong>.
                {buyerEmail ? <> Enviamos para <strong class="text-ink">{buyerEmail}</strong> o link para criar sua senha e entrar na área da família.</> : ' O link de acesso foi enviado ao e-mail da compra.'}
              </>
            ) : (
              <>{introObrigado} O seu acesso {acessoArtigo} <strong class="text-ink">{productName}</strong> está a caminho do seu e-mail.</>
            )
          ) : isTimedChallenge ? (
            <>Os 30 dias ainda não começaram. Assim que o pagamento for aprovado, enviaremos o acesso e a data final para o e-mail da compra.</>
          ) : (
            <>Assim que o pagamento for aprovado, enviaremos as instruções de acesso para o e-mail da compra.</>
          )
        }
      </p>
    </section>

    <!-- ── Sua compra ───────────────────────────────────────────────────── -->
    <section class="kids-thanks-purchase card reveal-up mt-12 p-5 sm:p-6" style="animation-delay: 120ms">
      <div class="kids-thanks-purchase-row flex items-center gap-5 sm:gap-7">
        <div class="relative shrink-0">
          <div
            class="kids-thanks-product-glow absolute -inset-3 rounded-2xl bg-gradient-to-br from-lime/35 to-cyan/25 blur-xl"
            aria-hidden="true"
          >
          </div>
          <img
            src={`${f.imagesBase}/${f.checkoutImage ?? 'produto-capa.webp'}`}
            alt={`Capa do curso ${productName}`}
            width="112"
            height="112"
            class="kids-thanks-product-image relative aspect-square w-24 -rotate-2 rounded-lg border border-line/60 object-cover shadow-xl sm:w-28"
            decoding="async"
          />
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Sua compra</p>
          <h2 class="mt-1 text-xl font-bold">{productName}</h2>
          <ul class="mt-3 flex flex-col gap-1.5 text-sm text-muted">
            {
              entrega.map((item) => (
                <li class="flex items-start gap-2">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-lime"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 12.5l4.5 4.5L19 7.5"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Como acessar ─────────────────────────────────────────────────── -->
    <section class="kids-thanks-steps reveal-up mt-12" style="animation-delay: 240ms">
      <h2 class="text-center text-xl font-bold">
        {
          isTimedChallenge
            ? 'O primeiro caminho dentro da plataforma'
            : isCommunity
              ? 'Os primeiros passos da sua família'
              : 'Como acessar'
        }
      </h2>
      <ol class="mt-6 flex flex-col gap-3">
        {
          passos.map((passo, i) => (
            <li class="card flex items-start gap-4 p-4 sm:p-5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-lime/40 bg-lime/10 text-sm font-bold text-lime">
                {i + 1}
              </span>
              <div class="min-w-0">
                <p class="font-bold">{passo.titulo}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted">
                  {passo.texto}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      {
        approved && (
          <a href={communityUrl} class="btn btn-primary mt-8 w-full">
            {isTimedChallenge
              ? 'Criar acesso e abrir a primeira etapa →'
              : isCommunity
                ? 'Criar perfil e abrir a Comunidade →'
                : 'Ir para a área de membros →'}
          </a>
        )
      }

      <p class="mt-5 text-center text-sm text-muted">
        Não recebeu o e-mail? Fale com a gente em
        <a
          href={`mailto:${EMPRESA.email}`}
          class="font-semibold text-ink underline decoration-line underline-offset-4 transition hover:text-lime"
        >
          {EMPRESA.email}
        </a>
      </p>
    </section>
  </main>
  <Footer audience={f.audience} vitalicio={f.lifetimeAccess ?? false} />
</BaseLayout>

<style>
  /* Selo de confirmação: círculo lime com glow + pop de entrada (o bloco global
     de prefers-reduced-motion zera a animação p/ quem prefere menos movimento). */
  .check-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-lime) 45%, transparent);
    background-color: color-mix(in srgb, var(--color-lime) 12%, transparent);
    color: var(--color-lime);
    box-shadow: 0 0 40px color-mix(in srgb, var(--color-lime) 30%, transparent);
    animation: check-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .check-badge.pending {
    border-color: color-mix(in srgb, var(--color-cyan) 45%, transparent);
    background-color: color-mix(in srgb, var(--color-cyan) 12%, transparent);
    color: var(--color-cyan);
    box-shadow: 0 0 40px color-mix(in srgb, var(--color-cyan) 24%, transparent);
  }

  @keyframes check-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    60% {
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
