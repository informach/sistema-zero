---
import OfertaPage from '../../../../components/funnel/OfertaPage.astro'
import {
  isComunidadeOfertaAntiga,
  isComunidadeSubpagina,
} from '../../../../funnels/comunidade-dos-criadores/oferta'
import { isDesafioOffer } from '../../../../funnels/desafio-primeiro-jogo/offer'
import { resolveOfferPage } from '../../../../server/offer-page'

export const prerender = false

const profile = Astro.params.perfilOferta
const kids = Astro.params.audience === 'kids'
const desafio = kids && Astro.params.produto === 'desafio-primeiro-jogo' && isDesafioOffer(profile)
const comunidade = kids && Astro.params.produto === 'comunidade-dos-criadores'

// As cinco páginas de perfil da Comunidade (até 20/10/2026) viraram a página de 9 a 17: os links
// antigos chegam lá com a mesma query (atribuição e cupom).
if (comunidade && isComunidadeOfertaAntiga(profile))
  return Astro.redirect(`/kids/comunidade-dos-criadores/oferta${Astro.url.search}`, 301)
if (!desafio && !(comunidade && isComunidadeSubpagina(profile)))
  return new Response(null, { status: 404 })
if (desafio && profile === 'primeiro-jogo')
  return Astro.redirect(`/kids/desafio-primeiro-jogo/oferta${Astro.url.search}`, 301)
const page = await resolveOfferPage(Astro.params, Astro.url, Astro.site)
if (page instanceof Response) return page
Astro.response.headers.set(
  'cache-control',
  desafio ? 'no-store' : 'public, max-age=60, stale-while-revalidate=300',
)
---

<OfertaPage {...page} comunidadePage={comunidade && isComunidadeSubpagina(profile) ? profile : undefined} desafioProfile={desafio && isDesafioOffer(profile) ? profile : undefined}/>
