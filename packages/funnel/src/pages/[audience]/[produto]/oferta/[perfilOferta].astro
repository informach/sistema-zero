---
import OfertaPage from '../../../../components/funnel/OfertaPage.astro'
import { isComunidadePage } from '../../../../funnels/comunidade-dos-criadores/oferta'
import { isDesafioOffer } from '../../../../funnels/desafio-primeiro-jogo/offer'
import { resolveOfferPage } from '../../../../server/offer-page'

export const prerender = false

const profile = Astro.params.perfilOferta
const desafio = Astro.params.produto === 'desafio-primeiro-jogo' && isDesafioOffer(profile)
if (
  Astro.params.audience !== 'kids' ||
  (!desafio && (Astro.params.produto !== 'comunidade-dos-criadores' || !isComunidadePage(profile)))
)
  return new Response(null, { status: 404 })

if (!desafio && profile === 'tempo-de-tela') {
  return Astro.redirect(`/kids/comunidade-dos-criadores/oferta${Astro.url.search}`, 301)
}
if (desafio && profile === 'primeiro-jogo')
  return Astro.redirect(`/kids/desafio-primeiro-jogo/oferta${Astro.url.search}`, 301)
const page = await resolveOfferPage(Astro.params, Astro.url, Astro.site)
if (page instanceof Response) return page
Astro.response.headers.set(
  'cache-control',
  desafio ? 'no-store' : 'public, max-age=60, stale-while-revalidate=300',
)
---

<OfertaPage {...page} comunidadeProfile={!desafio && isComunidadePage(profile) ? profile : undefined} desafioProfile={desafio && isDesafioOffer(profile) ? profile : undefined}/>
