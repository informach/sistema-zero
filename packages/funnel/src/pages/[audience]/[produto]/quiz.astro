---
import { quizDefinition } from '../../../analytics/quiz-definition'
import QuizConversaLayout from '../../../components/funnel/QuizConversaLayout.astro'
import { QUIZ_ENTRY as ADULT_QUIZ_ENTRY } from '../../../funnels/comunidade-adulto/quiz/entry-copy'
import { QUIZ_ENTRY } from '../../../funnels/comunidade-dos-criadores/quiz/entry-copy'
import { QUIZ_ENTRY as DESAFIO_ADULTO_QUIZ_ENTRY } from '../../../funnels/desafio-adulto/quiz/entry-copy'
import { QUIZ_ENTRY as DESAFIO_QUIZ_ENTRY } from '../../../funnels/desafio-primeiro-jogo/quiz/entry-copy'
import { getFunnel, getFunnelByKey, quizHeadlineId } from '../../../funnels/registry'
import ComunidadeAdultoQuiz from '../../../islands/ComunidadeAdultoQuiz'
import ComunidadeQuiz from '../../../islands/ComunidadeQuiz'
import DesafioAdultoQuiz from '../../../islands/DesafioAdultoQuiz'
import DesafioQuiz from '../../../islands/DesafioQuiz'
import Quiz from '../../../islands/Quiz'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { funnelOgImage } from '../../../lib/seo'

// SSR de propósito: página pré-renderizada é servida estática SEM passar pela
// middleware → ficaria SEM security headers em produção. O shell é trivial; o
// HTML revalidado a cada abertura: uma atualização do quiz não pode ficar presa em cache.
export const prerender = false

// Funil resolvido pela URL; sem o passo de quiz habilitado → 404.
const f = getFunnel(Astro.params.audience, Astro.params.produto)
if (!f) return new Response(null, { status: 404 })
if (!f.steps.quiz || !f.content.quiz) return new Response(null, { status: 404 })

Astro.response.headers.set('cache-control', 'no-store')

const quiz = f.content.quiz
const quizDefinitionId = quizDefinition(f)!.id
// Teste A/B da manchete (quizzes que declaram `headlines`): `?manchete=<id>` mostra a
// alternativa; o resto, a padrão.
const headline = quizHeadlineId(quiz, Astro.url.searchParams.get('manchete'))
// Kids, 18 ou mais: a saída leva ao quiz adulto quando o funil adulto está registrado.
const adulto = getFunnelByKey('pro/comunidade-dos-criadores')
const adultQuizPath = adulto?.steps.quiz ? `${adulto.basePath}/quiz` : undefined
// Adulto, menos de 18: a saída leva ao quiz Kids (dos responsáveis).
const kids = getFunnelByKey('kids/comunidade-dos-criadores')
const kidsQuizPath = kids?.steps.quiz ? `${kids.basePath}/quiz` : undefined
// No Desafio, as saídas ficam entre os dois quizzes do Desafio (os anúncios do Desafio levam a eles).
const desafioAdulto = getFunnelByKey('pro/desafio-primeiro-jogo')
const desafioAdultQuizPath = desafioAdulto?.steps.quiz
  ? `${desafioAdulto.basePath}/quiz`
  : undefined
const desafioKids = getFunnelByKey('kids/desafio-primeiro-jogo')
const desafioKidsQuizPath = desafioKids?.steps.quiz ? `${desafioKids.basePath}/quiz` : undefined
// Ao concluir: vai ao diagnóstico (se o funil tiver) ou direto à oferta.
const donePath = f.steps.resultado ? `${f.basePath}/resultado` : `${f.basePath}/oferta`

// Pré-carrega as imagens da P1 (se houver) — o preload scanner as acha no <head>
// e baixa em paralelo (sem isso só baixariam após hidratar + chamar a API).
const firstStep = quiz.steps[0]
const q1Images =
  firstStep && firstStep.tipo === 'multipla_escolha'
    ? firstStep.opcoes.map((o) => o.image).filter((s): s is string => Boolean(s))
    : []
---

{quiz.presentation === 'desafio-kids' ? (
  <QuizConversaLayout title={`${DESAFIO_QUIZ_ENTRY.pageTitle} | Sistema Zero`} description={DESAFIO_QUIZ_ENTRY.description} ogImage={new URL(`${f.imagesBase}/zappy-fala.webp`, Astro.site ?? Astro.url).toString()} tema="kids">
    <DesafioQuiz client:load funnel={f.key} basePath={f.basePath} quizDefinitionId={quizDefinitionId} headline={headline} adultQuizPath={desafioAdultQuizPath} />
    <noscript><p>Ative o JavaScript no navegador para responder ao quiz.</p></noscript>
  </QuizConversaLayout>
) : quiz.presentation === 'desafio-adulto' ? (
  <QuizConversaLayout title={`${DESAFIO_ADULTO_QUIZ_ENTRY.pageTitle} | Sistema Zero`} description={DESAFIO_ADULTO_QUIZ_ENTRY.description} tema="adulto">
    <DesafioAdultoQuiz client:load funnel={f.key} basePath={f.basePath} quizDefinitionId={quizDefinitionId} headline={headline} kidsQuizPath={desafioKidsQuizPath} />
    <noscript><p>Ative o JavaScript no navegador para responder ao quiz.</p></noscript>
  </QuizConversaLayout>
) : quiz.presentation === 'comunidade' ? (
  <QuizConversaLayout title={`${QUIZ_ENTRY.pageTitle} | Sistema Zero`} description={QUIZ_ENTRY.description} ogImage={new URL(`${f.imagesBase}/zappy-happy.webp`, Astro.site ?? Astro.url).toString()} tema="kids">
    <ComunidadeQuiz client:load funnel={f.key} basePath={f.basePath} quizDefinitionId={quizDefinitionId} headline={headline} adultQuizPath={adultQuizPath} />
    <noscript><p>Ative o JavaScript no navegador para responder ao quiz.</p></noscript>
  </QuizConversaLayout>
) : quiz.presentation === 'comunidade-adulto' ? (
  <QuizConversaLayout title={`${ADULT_QUIZ_ENTRY.pageTitle} | Sistema Zero`} description={ADULT_QUIZ_ENTRY.description} ogImage={funnelOgImage(f, Astro.site ?? Astro.url)} tema="adulto">
    <ComunidadeAdultoQuiz client:load funnel={f.key} basePath={f.basePath} quizDefinitionId={quizDefinitionId} headline={headline} kidsQuizPath={kidsQuizPath} />
    <noscript><p>Ative o JavaScript no navegador para responder ao quiz.</p></noscript>
  </QuizConversaLayout>
) : (<BaseLayout
  title={`Quiz | ${f.productName}`}
  description={f.seoDescription}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  noindex={true}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <Fragment slot="head">
    {q1Images.map((src) => <link rel="preload" as="image" href={src} type="image/webp" />)}
  </Fragment>
  <Quiz
    client:load
    steps={quiz.steps}
    total={quiz.total}
    landing={f.content.landing}
    funnel={f.key}
    quizDefinitionId={quizDefinitionId}
    donePath={donePath}
  />
</BaseLayout>)}
