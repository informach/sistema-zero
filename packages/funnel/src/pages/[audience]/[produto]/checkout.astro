---
import Footer from '../../../components/Footer.astro'
import { leadBelongsToFunnel } from '../../../funnels/lead-scope'
import { getFunnel } from '../../../funnels/registry'
import CheckoutForm from '../../../islands/CheckoutForm'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { ContactSchema } from '../../../lib/contact-schema'
import { getLeadId, leadCookie } from '../../../lib/lead-session'
import { formatBRLFromCents2 } from '../../../lib/money'
import { getActiveOffer } from '../../../server/catalog'
import { getDeps } from '../../../server/deps'

export const prerender = false

// Funil resolvido pela URL. Inexistente → 404.
const f = getFunnel(Astro.params.audience, Astro.params.produto)
if (!f) return new Response(null, { status: 404 })

const ofertaPath = `${f.basePath}/oferta`
// Pós-pagamento: vai ao upsell (se o funil tiver) ou direto ao obrigado.
const successPath = f.steps.upsell ? `${f.basePath}/upsell` : `${f.basePath}/obrigado`

Astro.response.headers.set('cache-control', 'no-store')

const { repo, env, gateway } = getDeps()

// Lead da sessão (cookie). Lead já PAGO não é reaproveitado: nova compra = novo
// lead (sem CPF/dados antigos) — defesa extra à expiração do cookie na /obrigado.
let leadId = getLeadId(Astro.request)
let lead = leadId ? await repo.getLead(leadId) : null
if (lead?.paidAt || (lead && !leadBelongsToFunnel(lead.funnel, f.key))) {
  lead = null
  leadId = null
}

// Contato dos query params (?nome&email&telefone) que o modal de pré-checkout
// anexa à URL — fallback p/ cookie perdido. Validado UMA vez: serve de prefill
// e de GATE para criar lead novo.
const sp = Astro.url.searchParams
const fromQuery = {
  nome: sp.get('nome')?.trim() ?? '',
  email: sp.get('email')?.trim() ?? '',
  telefone: sp.get('telefone')?.trim() ?? '',
}
const queryContact = ContactSchema.safeParse(fromQuery)

if (!lead) {
  // Sem lead E sem contato válido na URL → volta p/ a oferta SEM criar lead.
  // (Antes o insert rodava antes do guard: bot/crawler batendo em /checkout
  // inseria uma linha no banco por hit.)
  if (!queryContact.success) return Astro.redirect(ofertaPath)
  // Contato válido na URL: cria o lead já com ele persistido (recupera o
  // telefone p/ cartão/boleto, por exemplo) e a origem do funil.
  const created = await repo.createLead(f.key)
  leadId = created.id
  Astro.response.headers.append('set-cookie', leadCookie(leadId, env.NODE_ENV === 'production'))
  await repo.updateLead(leadId, queryContact.data)
  lead = await repo.getLead(leadId)
} else if (!lead.email && queryContact.success) {
  // Lead existente ainda sem contato: persiste o da URL.
  await repo.updateLead(lead.id, queryContact.data)
  lead = { ...lead, ...queryContact.data }
}

// CPF NUNCA é pré-preenchido (decisão do usuário): dado sensível, digitado a cada
// compra. Nome/e-mail vêm do lead/URL (o pré-checkout os fornece pela URL).
const initialContact = {
  nome: lead?.nome ?? fromQuery.nome,
  email: lead?.email ?? fromQuery.email,
  cpf: '',
}

// Sem e-mail não há para quem entregar o produto → volta para a oferta, onde o
// modal de pré-checkout coleta nome/e-mail/telefone.
if (!initialContact.email) return Astro.redirect(ofertaPath)

// Preço/nome vêm do catálogo (fonte da verdade); fallback p/ rótulos do funil se fora.
const offer = await getActiveOffer(gateway, f.catalogOfferSlug)
const priceCents = offer?.priceCents ?? env.PRODUCT_PRICE_CENTS
const productName = offer?.productName || f.productName
const priceLabel = formatBRLFromCents2(priceCents)
---

<BaseLayout
  title={`Pagamento · ${productName}`}
  noindex={true}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <!-- Sem header: o checkout abre direto no card do produto (estilo Hotmart). -->
  <main class="mx-auto max-w-xl px-4 py-10 sm:py-12">
    <!-- ── Produto ─────────────────────────────────────────────────────── -->
    <div class="flex items-center gap-4 rounded-2xl border border-line/70 bg-card/50 p-4 sm:p-5">
      <img
        src={`${f.imagesBase}/produto-capa.webp`}
        alt={`Capa do ebook ${productName}`}
        width="480"
        height="679"
        class="w-16 shrink-0 rounded-lg border border-line/60 sm:w-20"
        decoding="async"
      />
      <div>
        <h1 class="text-lg font-bold leading-snug text-ink">{productName}</h1>
        <p class="mt-0.5 text-sm text-muted">{f.byline}</p>
        <p class="mt-1.5 text-xl font-extrabold text-lime">{priceLabel}</p>
        <p class="text-xs text-muted">Pagamento único · acesso imediato</p>
      </div>
    </div>

    <!-- ── Dados pessoais + forma de pagamento (ilha) ──────────────────── -->
    <div class="mt-6">
      <CheckoutForm
        client:load
        initialContact={initialContact}
        priceCents={priceCents}
        allowCoupon={offer?.allowsCoupon === true}
        successPath={successPath}
      />
    </div>

    <p class="mt-6 text-center text-xs text-muted">
      Pagamento processado com segurança. Garantia de 7 dias.
    </p>
  </main>

  <Footer />
</BaseLayout>
