---
import Footer from '../../../components/Footer.astro'
import { leadBelongsToFunnel } from '../../../funnels/lead-scope'
import { getFunnel } from '../../../funnels/registry'
import CheckoutForm from '../../../islands/CheckoutForm'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {
  computeFixedAccessExpiry,
  fixedAccessFromOffer,
  fixedAccessLabel,
  formatSaoPauloDateTime,
} from '../../../lib/access-period'
import { ContactSchema } from '../../../lib/contact-schema'
import { sanitizeLeadAttribution } from '../../../lib/lead-attribution'
import { getLeadId, leadCookie } from '../../../lib/lead-session'
import { formatBRLFromCents2 } from '../../../lib/money'
import { funnelOgImage } from '../../../lib/seo'
import { getActiveOffer } from '../../../server/catalog'
import { resolveCouponPresentation } from '../../../server/coupon-presentation'
import { getDeps } from '../../../server/deps'
import { resolveOfferSlug } from '../../../server/offer'
import { checkOfferContract } from '../../../server/offer-contract'

export const prerender = false

// Funil resolvido pela URL. Inexistente → 404.
const f = getFunnel(Astro.params.audience, Astro.params.produto)
if (!f) return new Response(null, { status: 404 })

// Pós-pagamento: vai ao upsell (se o funil tiver) ou direto ao obrigado.
const successPath = f.steps.upsell ? `${f.basePath}/upsell` : `${f.basePath}/obrigado`

Astro.response.headers.set('cache-control', 'no-store')

const { repo, env, gateway, log } = getDeps()

// Lead da sessão (cookie). Lead já PAGO não é reaproveitado: nova compra = novo
// lead (sem CPF/dados antigos) — defesa extra à expiração do cookie na /obrigado.
let leadId = getLeadId(Astro.request)
let lead = leadId ? await repo.getLead(leadId) : null
if (lead?.paidAt || (lead && !leadBelongsToFunnel(lead.funnel, f.key))) {
  lead = null
  leadId = null
}

// Contato dos query params (?nome&email&telefone) que o modal de pré-checkout
// anexa à URL — fallback p/ cookie perdido. Validado UMA vez: serve de prefill
// e de GATE para criar lead novo.
const sp = Astro.url.searchParams
const fromQuery = {
  nome: sp.get('nome')?.trim() ?? '',
  email: sp.get('email')?.trim() ?? '',
  telefone: sp.get('telefone')?.trim() ?? '',
}
const queryContact = ContactSchema.safeParse(fromQuery)
const queryAttribution = sanitizeLeadAttribution({
  utmSource: sp.get('utm_source'),
  utmMedium: sp.get('utm_medium'),
  utmCampaign: sp.get('utm_campaign'),
  utmContent: sp.get('utm_content'),
  eventCode: sp.get('event_code') ?? sp.get('event'),
  initialCouponCode: sp.get('coupon') ?? sp.get('cupom'),
  landingPath: Astro.url.pathname,
})

// O checkout SEMPRE abre (o pré-checkout é só um facilitador): sem lead e sem
// contato, o formulário abre vazio e a pessoa preenche tudo aqui, sem perder a
// venda. Quem cai direto ganha o lead pelo próprio formulário (POST /api/leads
// no mount, idempotente) — bot/crawler sem JS segue sem inserir linha no banco.
if (!lead && queryContact.success) {
  // Contato válido na URL (veio do pré-checkout): cria o lead já com ele
  // persistido (recupera o telefone p/ cartão/boleto, por exemplo) e a origem
  // do funil.
  const created = await repo.createLead(f.key, queryAttribution)
  leadId = created.id
  Astro.response.headers.append('set-cookie', leadCookie(leadId, env.NODE_ENV === 'production'))
  await repo.updateLead(leadId, queryContact.data)
  lead = await repo.getLead(leadId)
} else if (lead && queryContact.success) {
  // Lead pré-existente pode estar sem ALGUM dado (ex.: telefone do pré-checkout que
  // não chegou a persistir): preenche só o que está EM BRANCO com o contato da URL,
  // sem sobrescrever o que já existe.
  const c = queryContact.data
  const patch: { nome?: string; email?: string; telefone?: string } = {}
  if (!lead.nome) patch.nome = c.nome
  if (!lead.email) patch.email = c.email
  if (!lead.telefone) patch.telefone = c.telefone
  if (Object.keys(patch).length > 0) {
    await repo.updateLead(lead.id, patch)
    lead = { ...lead, ...patch }
  }
}

// CPF NUNCA é pré-preenchido (decisão do usuário): dado sensível, digitado a cada
// compra. Nome/e-mail vêm do lead/URL (o pré-checkout os fornece pela URL).
const initialContact = {
  nome: lead?.nome ?? fromQuery.nome,
  email: lead?.email ?? fromQuery.email,
  cpf: '',
  // Telefone pré-preenchido (lead ou pré-checkout); editável e reenviado no checkout.
  telefone: lead?.telefone ?? fromQuery.telefone,
}

// Preço/nome vêm do catálogo (fonte da verdade); fallback p/ rótulos do funil se fora.
// Oferta vem da env do funil (FUNNEL_OFFER_<KEY>). MESMA fonte do checkout/cobrança.
const offerSlug = resolveOfferSlug(env, f.key)
const offer = await getActiveOffer(gateway, offerSlug, { log })
const contractCheck = checkOfferContract(f.offerContract, offer)
if (!contractCheck.ok) {
  log('checkout.offer_contract_mismatch', {
    funnel: f.key,
    offerSlug,
    reason: contractCheck.reason,
    expected: contractCheck.expected,
    actual: contractCheck.actual,
  })
  return new Response('Esta oferta está temporariamente indisponível.', { status: 503 })
}
const initialCoupon = await resolveCouponPresentation(gateway, offerSlug, sp)
// Uma cotação válida é mais nova e mais autoritativa que o cache curto da view.
const priceCents =
  initialCoupon.status === 'valid'
    ? initialCoupon.listPriceCents
    : (offer?.priceCents ?? env.PRODUCT_PRICE_CENTS)
const productName = offer?.productName || f.productName
const fixedAccess = fixedAccessFromOffer(offer)
const accessLabel = fixedAccess ? fixedAccessLabel(fixedAccess) : null
const estimatedAccessEnd = fixedAccess
  ? formatSaoPauloDateTime(computeFixedAccessExpiry(new Date(), fixedAccess))
  : null
const guaranteeDays = offer?.guaranteeDays ?? 7

// Assinatura: sufixo /mês|/ano no preço + oferta IRMÃ do alternador (catálogo).
const isSubscription = offer?.pricingMode === 'subscription'
const interval = isSubscription ? (offer?.billingIntervalMonths ?? null) : null
const priceSuffix = interval === 1 ? '/mês' : interval === 12 ? '/ano' : ''
const priceLabel = `${formatBRLFromCents2(priceCents)}${priceSuffix}`
const priceNote = isSubscription
  ? interval === 12
    ? 'Assinatura anual · acesso imediato'
    : 'Assinatura mensal · acesso imediato'
  : fixedAccess
    ? `Pagamento único · ${accessLabel} a partir da aprovação`
    : 'Pagamento único · acesso imediato'

// Oferta irmã (alternador mensal↔anual): busca a view p/ preço/intervalo. Falha
// do catálogo degrada SEM alternador (o checkout da principal segue funcionando).
let altOffer: {
  slug: string
  label: string | null
  priceCents: number
  billingIntervalMonths: number | null
} | null = null
if (isSubscription && offer?.altOffer) {
  const alt = await getActiveOffer(gateway, offer.altOffer.slug, { log })
  if (alt && alt.pricingMode === 'subscription' && alt.billingIntervalMonths) {
    altOffer = {
      slug: alt.slug,
      label: offer.altOffer.label,
      priceCents: alt.priceCents,
      billingIntervalMonths: alt.billingIntervalMonths,
    }
  }
}

// `?oferta=<slug da irmã>` (link /renovar do e-mail de renovação) pré-seleciona
// o plano no alternador — o servidor segue validando a escolha na cobrança.
const requestedOffer = (sp.get('oferta') ?? '').trim().toLowerCase()
const initialChoice: 'main' | 'alt' = altOffer && requestedOffer === altOffer.slug ? 'alt' : 'main'
---

<BaseLayout
  title={`Pagamento | ${productName}`}
  description={f.seoDescription}
  ogImage={funnelOgImage(f, Astro.site ?? Astro.url)}
  noindex={true}
  htmlClass={f.theme ? `theme-${f.theme}` : undefined}
>
  <!-- Sem header: o checkout abre direto no card do produto (estilo Hotmart). -->
  <main class="mx-auto max-w-xl px-4 py-10 sm:py-12">
    {
      f.key === 'kids/desafio-primeiro-jogo' && (
        <div class="mb-6 text-center">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Checkout seguro</p>
          <h1 class="mt-2 text-2xl font-extrabold text-ink sm:text-3xl">
            Falta um passo para começar o primeiro jogo.
          </h1>
        </div>
      )
    }
    <!-- ── Produto ─────────────────────────────────────────────────────── -->
    <div class="flex items-center gap-4 rounded-2xl border border-line/70 bg-card/50 p-4 sm:p-5">
      <img
        src={`${f.imagesBase}/${f.checkoutImage ?? 'produto-capa.webp'}`}
        alt={`Capa do curso ${productName}`}
        class="size-16 shrink-0 rounded-lg border border-line/60 object-cover sm:size-20"
        decoding="async"
      />
      <div>
        <h1 class="text-lg font-bold leading-snug text-ink">{productName}</h1>
        <p class="mt-0.5 text-sm text-muted">{f.byline}</p>
        <p class="mt-1.5 text-xl font-extrabold text-lime">{priceLabel}</p>
        <p class="text-xs text-muted">{priceNote}</p>
      </div>
    </div>

    <!-- ── Dados pessoais + forma de pagamento (ilha) ──────────────────── -->
    <div class="mt-6">
      <CheckoutForm
        client:load
        funnel={f.key}
        initialContact={initialContact}
        priceCents={priceCents}
        allowCoupon={offer?.allowsCoupon === true}
        successPath={successPath}
        isKids={f.audience === 'kids'}
        installmentsMax={offer?.installmentsMax ?? null}
        pricingMode={offer?.pricingMode ?? 'one_time'}
        billingIntervalMonths={offer?.billingIntervalMonths ?? null}
        offerSlug={offerSlug}
        altOffer={altOffer}
        initialChoice={initialChoice}
        initialCoupon={initialCoupon}
        accessLabel={accessLabel}
        estimatedAccessEnd={estimatedAccessEnd}
        guaranteeDays={guaranteeDays}
        termsHref={`/${f.audience}/termos`}
        privacyHref={`/${f.audience}/privacidade`}
      />
    </div>

    <p class="mt-6 text-center text-xs text-muted">
      Pagamento processado com segurança. Garantia de {guaranteeDays} dias.
    </p>
  </main>

  <Footer audience={f.audience} vitalicio={f.lifetimeAccess ?? false} />
</BaseLayout>
