---
import PresenteLayout from '../../components/referrals/PresenteLayout.astro'
import PresenteOferta from '../../components/referrals/PresenteOferta.astro'
import { getDeps } from '../../server/deps'
import { resolveReferralGiftPage } from '../../server/referral-gift-page'
export const prerender = false
Astro.response.headers.set('cache-control', 'private, no-store')
const codigo = (Astro.params.codigo ?? '').trim().toLowerCase()
const { gateway, env } = getDeps()
const page = await resolveReferralGiftPage(gateway, codigo)
if (page.kind === 'not_found') Astro.response.status = 404
if (page.kind === 'unavailable') Astro.response.status = 503
const communityUrl = env.KIDS_COMMUNITY_URL.replace(/\/$/, '')
---
<PresenteLayout title="Seu presente: Cadê Todo Mundo? | Sistema Zero" description="Seu filho pode aprender a fazer um jogo de procurar personagens funcionar. Sete dias de curso gratuito, sem cartão." action={page.kind === 'ready' ? { href: '#resgatar', label: 'Quero o presente' } : undefined}>
  {'gift' in page ? <PresenteOferta gift={page.gift} kind={page.kind} communityUrl={communityUrl} /> : <section class="section"><div class="wrap gift-status"><h1>{page.kind === 'unavailable' ? 'Não conseguimos abrir seu convite agora.' : 'Este convite não está disponível.'}</h1><p>{page.kind === 'unavailable' ? 'Tente recarregar a página em alguns instantes. Isso não cria um cadastro nem começa o prazo do curso.' : 'Confira se o link foi copiado por inteiro. Se precisar, fale com a pessoa que enviou o convite ou com a nossa equipe.'}</p><a class="kof-link" href="mailto:contato@sistemazero.com.br">Falar com o Sistema Zero</a><a class="kof-link" href={`${communityUrl}/login`}>Já tenho conta: entrar na plataforma</a></div></section>}
</PresenteLayout>
