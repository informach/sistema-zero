---
// Página pública do presente (`/bolsa/<codigo>`). O público vem do CÓDIGO (20/10/2026):
// `kids` → PresenteLayout + PresenteOferta (o responsável cadastra, app Kids); `adult` →
// PresenteAdultoLayout + PresenteAdultoOferta (a própria pessoa cadastra, app adulto). Código
// inexistente ou referrals fora do ar não revela público: a tela de status usa o tema Kids, o de
// antes do presente adulto.
// O curso vem da OFERTA do presente (15/11/2026, `gift` da leitura pública, `giftVariant`): o Cadê
// Todo Mundo (ou leitura antiga, sem `gift`) usa a página editorial de cada público; curso para
// pais e outro curso usam o corpo enxuto `PresenteCursoOferta`, com o nome e o prazo da oferta.
import PresenteAdultoLayout from '../../components/referrals/PresenteAdultoLayout.astro'
import PresenteAdultoOferta from '../../components/referrals/PresenteAdultoOferta.astro'
import PresenteCursoOferta from '../../components/referrals/PresenteCursoOferta.astro'
import PresenteLayout from '../../components/referrals/PresenteLayout.astro'
import PresenteOferta from '../../components/referrals/PresenteOferta.astro'
import { PRESENTE_KIDS, presenteKidsDaOferta } from '../../content/presente'
import { presenteAdultoDaOferta } from '../../content/presente-adulto'
import { presenteCursoCopy } from '../../content/presente-curso'
import { getDeps } from '../../server/deps'
import { giftVariant, resolveReferralGiftPage } from '../../server/referral-gift-page'
export const prerender = false
Astro.response.headers.set('cache-control', 'private, no-store')
const codigo = (Astro.params.codigo ?? '').trim().toLowerCase()
const { gateway, env } = getDeps()
const page = await resolveReferralGiftPage(gateway, codigo)
if (page.kind === 'not_found') Astro.response.status = 404
if (page.kind === 'unavailable') Astro.response.status = 503
const semBarra = (url: string) => url.replace(/\/$/, '')
const status =
  page.kind === 'not_found' ? PRESENTE_KIDS.estados.naoEncontrado : PRESENTE_KIDS.estados.foraDoAr
const oferta = 'gift' in page ? page.gift.gift : undefined
const variante = giftVariant(oferta)
// Curso enxuto (pais ou outro curso): título, descrição e barra vêm da oferta.
const curso =
  'gift' in page && oferta && variante !== 'cade'
    ? {
        gift: { ...page.gift, gift: oferta },
        copy: presenteCursoCopy(page.audience, oferta, variante),
        variante,
      }
    : null
const cadeKids = presenteKidsDaOferta(oferta)
const cadeAdulto = presenteAdultoDaOferta(oferta)
---
{'gift' in page ? (
  page.audience === 'adult' ? (
    curso ? (
      <PresenteAdultoLayout title={curso.copy.seoTitle} description={curso.copy.description} ready={page.kind === 'ready'} barra={curso.copy.barra} secoes={false}>
        <PresenteCursoOferta gift={curso.gift} kind={page.kind} communityUrl={semBarra(env.COMMUNITY_URL)} variante={curso.variante} />
      </PresenteAdultoLayout>
    ) : (
      <PresenteAdultoLayout title={cadeAdulto.seoTitle} description={cadeAdulto.description} ready={page.kind === 'ready'} barra={cadeAdulto.barra}>
        <PresenteAdultoOferta gift={page.gift} kind={page.kind} communityUrl={semBarra(env.COMMUNITY_URL)} />
      </PresenteAdultoLayout>
    )
  ) : curso ? (
    <PresenteLayout title={curso.copy.seoTitle} description={curso.copy.description} ready={page.kind === 'ready'} barra={curso.copy.barra} secoes={false}>
      <PresenteCursoOferta gift={curso.gift} kind={page.kind} communityUrl={semBarra(env.KIDS_COMMUNITY_URL)} variante={curso.variante} />
    </PresenteLayout>
  ) : (
    <PresenteLayout title={cadeKids.seoTitle} description={cadeKids.description} ready={page.kind === 'ready'} barra={cadeKids.barra}>
      <PresenteOferta gift={page.gift} kind={page.kind} communityUrl={semBarra(env.KIDS_COMMUNITY_URL)} />
    </PresenteLayout>
  )
) : (
  <PresenteLayout title={PRESENTE_KIDS.seoTitle} description={PRESENTE_KIDS.description} secoes={false}>
    <section class="c9-sec pk-pontilhado"><div class="c9-wrap">
      <div class="pk-estado pk-estado--pagina c9-cor--azul-claro">
        <span class="c9-tag">{status.etiqueta}</span>
        <h1 class="pk-estado__titulo">{status.titulo}</h1>
        <p class="c9-p">{status.texto}</p>
        <a class="pk-link" href="mailto:contato@sistemazero.com.br">{PRESENTE_KIDS.estados.contato}</a>
      </div>
    </div></section>
  </PresenteLayout>
)}
