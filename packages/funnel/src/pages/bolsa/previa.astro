---
// Prévia do presente para o Admin (`/bolsa/previa?audience=kids|adult&title=…`): só apresentação
// escapada e datas, sem buscar campanha nem aceitar cadastro. O código `previa` é reservado no
// referrals. `audience` ausente ou desconhecido = `kids`.
import { isGiftAudience, type ReferralGiftView } from '@sistemazero/core/referrals'
import PresenteAdultoLayout from '../../components/referrals/PresenteAdultoLayout.astro'
import PresenteAdultoOferta from '../../components/referrals/PresenteAdultoOferta.astro'
import PresenteLayout from '../../components/referrals/PresenteLayout.astro'
import PresenteOferta from '../../components/referrals/PresenteOferta.astro'
import { PRESENTE_KIDS } from '../../content/presente'
import { PRESENTE_ADULTO } from '../../content/presente-adulto'
import { getEnv } from '../../lib/env'
export const prerender = false
Astro.response.headers.set('cache-control', 'private, no-store')
const params = Astro.url.searchParams
const context = params.get('context')
const audienceParam = params.get('audience')
const audience = isGiftAudience(audienceParam) ? audienceParam : 'kids'
const validDate = (value: string | null) =>
  value && Number.isFinite(Date.parse(value)) ? new Date(value).toISOString() : null
const gift: ReferralGiftView = {
  code: '',
  displayName: '',
  ownerKind: 'campaign',
  state: 'active',
  giftAvailable: true,
  audience,
  source: {
    kind: 'campaign',
    name: (params.get('title') || 'Uma experiência gratuita no Sistema Zero').slice(0, 160),
    context: context === 'event' || context === 'ad' ? context : 'other',
    description: (params.get('description') ?? '').slice(0, 600),
  },
  startsAt: validDate(params.get('startsAt')),
  endsAt: validDate(params.get('endsAt')),
}
const env = getEnv()
const semBarra = (url: string) => url.replace(/\/$/, '')
---
{audience === 'adult' ? (
  <PresenteAdultoLayout title={PRESENTE_ADULTO.previaTitle} description={PRESENTE_ADULTO.description}>
    <PresenteAdultoOferta gift={gift} kind="ready" communityUrl={semBarra(env.COMMUNITY_URL)} preview />
  </PresenteAdultoLayout>
) : (
  <PresenteLayout title={PRESENTE_KIDS.previaTitle} description={PRESENTE_KIDS.description}>
    <PresenteOferta gift={gift} kind="ready" communityUrl={semBarra(env.KIDS_COMMUNITY_URL)} preview />
  </PresenteLayout>
)}
