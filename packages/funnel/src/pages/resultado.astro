---
import { FECHO_COMPARTILHADO, RESULT_PROFILES } from '../content/result-profiles'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLeadId } from '../lib/lead-session'
import { isPerfil } from '../lib/perfil'
import { projetoLabel, renderTemplate } from '../lib/result-template'
import { computePerfil } from '../lib/scoring'
import { getDeps } from '../server/deps'

export const prerender = false

Astro.response.headers.set('cache-control', 'no-store')

const leadId = getLeadId(Astro.request)
if (!leadId) return Astro.redirect('/')

const { repo } = getDeps()
const lead = await repo.getLead(leadId)
if (!lead) return Astro.redirect('/')

// Resultado aberto direto, sem o quiz respondido (nem a P1): volta pra landing,
// em vez de mostrar um diagnóstico vazio.
if (!lead.segmento) return Astro.redirect('/')

await repo.insertEvent(lead.id, 'viu_resultado', 'resultado')

// Perfil: usa o já calculado (persistido) ou roda o motor de pontuação agora e
// persiste (one-shot — só grava se ainda não havia). Viaja na URL p/ o hero da oferta.
const stored = isPerfil(lead.perfilResultado) ? lead.perfilResultado : null
const perfil =
  stored ??
  computePerfil({
    segmento: lead.segmento,
    relacao_ia: lead.relacaoIa,
    ja_quebrou: lead.jaQuebrou,
    trava_principal: lead.travaPrincipal,
    custo_principal: lead.custoPrincipal,
    mudanca_desejada: lead.mudancaDesejada,
    proximo_passo: lead.proximoPasso,
  })
if (!stored) await repo.updateLead(lead.id, { perfilResultado: perfil })

const bloco = RESULT_PROFILES[perfil]
const corpo = renderTemplate(bloco.corpo, {
  projeto: projetoLabel(lead.tipoCriar),
  custoMensalCents: lead.custoMensal,
})
const ofertaHref = `/oferta?perfil=${perfil}`
---

<BaseLayout title="Seu diagnóstico · No Comando da IA" noindex={true}>
  <!-- Sem header/footer: a tela é a continuação direta do quiz. -->
  <div class="relative min-h-screen">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_75%_55%_at_50%_-12%,rgba(66,232,224,0.12),transparent_60%)]"
    >
    </div>
    <!-- Barra cheia no topo: o quiz terminou. -->
    <div class="fixed inset-x-0 top-0 z-20 h-1.5 bg-gradient-to-r from-cyan to-lime"></div>

    <main class="mx-auto max-w-2xl px-4 py-20 sm:py-24">
      <p
        class="reveal-up inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-cyan"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-cyan"></span>
        Seu diagnóstico
      </p>

      <h1
        class="reveal-up mt-5 text-balance text-3xl font-extrabold leading-[1.1] text-ink sm:text-[2.5rem]"
        style="animation-delay: 60ms"
      >
        {bloco.titulo}
      </h1>

      <div
        class="reveal-up card mt-8 border-line/80 bg-card-2/60 p-6 sm:p-7"
        style="animation-delay: 120ms"
      >
        <p class="text-base leading-relaxed text-ink/90 sm:text-lg">{corpo}</p>
      </div>

      <p class="reveal-up mt-6 leading-relaxed text-muted" style="animation-delay: 180ms">
        {FECHO_COMPARTILHADO}
      </p>

      <a
        href={ofertaHref}
        class="reveal-up btn btn-primary mt-10 w-full text-center sm:w-auto"
        style="animation-delay: 240ms"
      >
        {bloco.cta} →
      </a>
    </main>
  </div>
</BaseLayout>
