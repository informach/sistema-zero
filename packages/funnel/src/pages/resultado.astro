---
import Footer from '../components/Footer.astro'
import { RESULTADO } from '../content/copy'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLeadId } from '../lib/lead-session'
import { getResultMessage } from '../lib/result-text'
import { getDeps } from '../server/deps'

export const prerender = false

Astro.response.headers.set('cache-control', 'no-store')

const leadId = getLeadId(Astro.request)
if (!leadId) return Astro.redirect('/')

const { repo } = getDeps()
const lead = await repo.getLead(leadId)
if (!lead) return Astro.redirect('/')

await repo.insertEvent(lead.id, 'viu_resultado', 'resultado')
const mensagem = getResultMessage(lead.segmento)
---

<BaseLayout title="Seu diagnóstico — No Comando da IA" noindex={true}>
  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-2xl font-bold leading-snug sm:text-3xl">{RESULTADO.titulo}</h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{mensagem}</p>
    <p class="mt-5 text-lg leading-relaxed text-muted">{RESULTADO.paragrafoFinal}</p>
    <a href="/oferta" class="btn btn-primary mt-10 w-full text-center sm:w-auto">{RESULTADO.cta}</a>
  </main>
  <Footer />
</BaseLayout>
