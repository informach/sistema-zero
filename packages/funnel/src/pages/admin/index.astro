---
import AdminDashboard from '../../islands/admin/AdminDashboard'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { verifyAdminSession } from '../../lib/admin-session'
import { getDeps } from '../../server/deps'

export const prerender = false

Astro.response.headers.set('cache-control', 'no-store')

// Sessão por cookie assinado (login in-app). Sem sessão → tela de login.
const { env } = getDeps()
if (!verifyAdminSession(Astro.request, env.ADMIN_SESSION_SECRET)) {
  return Astro.redirect('/admin/login')
}
---

<BaseLayout title="Admin — No Comando da IA" noindex={true}>
  <main class="mx-auto max-w-6xl px-4 py-8">
    <AdminDashboard client:load />
  </main>
</BaseLayout>
