---
import AdminLogin from '../../islands/admin/AdminLogin'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { resolveAdmin } from '../../lib/admin-auth'
import { getDeps } from '../../server/deps'

export const prerender = false

Astro.response.headers.set('cache-control', 'no-store')

// Já logado (sessão admin válida no auth)? Vai direto pro painel.
const { gateway, env } = getDeps()
const auth = await resolveAdmin(Astro.request, gateway, env.NODE_ENV === 'production')
if (auth) {
  if (auth.setCookies)
    for (const c of auth.setCookies) Astro.response.headers.append('set-cookie', c)
  return Astro.redirect('/admin')
}
---

<BaseLayout title="Entrar — Admin" noindex={true}>
  <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_50%_0%,rgba(196,240,66,0.10),transparent_60%)]"
    >
    </div>
    <AdminLogin client:load />
  </div>
</BaseLayout>
