---
import Analytics from '../components/Analytics.astro'
import {
  COMPARTILHAMENTO,
  compartilhamentoDoCaminho,
  PALAVRAS_PROIBIDAS,
} from '../content/compartilhamento'
import {
  DEFAULT_SHARE_IMAGE,
  isShareCard,
  SHARE_IMAGE_HEIGHT,
  SHARE_IMAGE_WIDTH,
  shareImageType,
} from '../lib/seo'
import '@fontsource/plus-jakarta-sans/latin-400.css'
import '@fontsource/plus-jakarta-sans/latin-600.css'
import '@fontsource/plus-jakarta-sans/latin-700.css'
import '@fontsource/plus-jakarta-sans/latin-800.css'
// Fontes do tema KIDS (Baloo 2 títulos / Nunito corpo — a MESMA dupla da
// comunidade kids, para o aluno sentir que continua no mesmo lugar). Os
// @font-face ficam declarados em todo o site, mas os WOFF2 só baixam nas
// páginas `.theme-kids`.
import '@fontsource/baloo-2/latin-500.css'
import '@fontsource/baloo-2/latin-600.css'
import '@fontsource/baloo-2/latin-700.css'
import '@fontsource/baloo-2/latin-800.css'
import '@fontsource/nunito/latin-400.css'
import '@fontsource/nunito/latin-600.css'
import '@fontsource/nunito/latin-700.css'
import '@fontsource/nunito/latin-800.css'
// Fonte self-hosted dos ícones usados nas páginas públicas. Mantida no layout
// para o build preservar o @font-face e todas as rotas compartilharem a fonte.
import '@fontsource/material-symbols-rounded/400.css'
import '../styles/global.css'
import balooTitle from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url'
import nunitoBody from '@fontsource/nunito/files/nunito-latin-400-normal.woff2?url'
import nunitoBold from '@fontsource/nunito/files/nunito-latin-800-normal.woff2?url'

interface Props {
  title: string
  description?: string
  noindex?: boolean
  canonical?: string
  /** A imagem de compartilhamento; sem ela, o cartão do site. Relativa vira absoluta. */
  ogImage?: string
  /** O texto alternativo da imagem de compartilhamento (padrão: o título). */
  ogImageAlt?: string
  /** Classe no <html>. Usado pelo /admin (`"dark"`) p/ ativar o tema compartilhado. */
  htmlClass?: string
}

const {
  title,
  description = 'Sistema Zero: aprenda criando, do primeiro projeto ao resultado.',
  noindex = false,
  canonical,
  ogImage,
  ogImageAlt,
  htmlClass = '',
} = Astro.props

// Compartilhamento (26/11/2026): sempre uma imagem, sempre absoluta, com tipo e, nos cartões
// 1200×630 do funil, largura e altura (`lib/seo.ts`).
const shareImage = new URL(ogImage ?? DEFAULT_SHARE_IMAGE, Astro.site ?? Astro.url).toString()
const shareType = shareImageType(shareImage)
const shareCard = isShareCard(shareImage)
// O texto que aparece ao compartilhar (26/11/2026, `content/compartilhamento.ts`): o aprovado de cada
// produto (venda, checkout e obrigado) e da bio; nas outras páginas, o título e a descrição dela,
// mas nunca com "Pagamento" ou "oferta" (aí vale o texto do site).
const aprovado = compartilhamentoDoCaminho(Astro.url.pathname)
const doSite = COMPARTILHAMENTO.bio
const proibido = (texto: string) => PALAVRAS_PROIBIDAS.test(texto)
const shareTitle = aprovado?.titulo ?? (proibido(title) ? (doSite?.titulo ?? title) : title)
const shareDescription =
  aprovado?.descricao ?? (proibido(description) ? (doSite?.descricao ?? description) : description)

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString()
---

<!doctype html>
<html lang="pt-BR" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {htmlClass.includes('theme-kids') && [balooTitle, nunitoBody, nunitoBold].map(href => <link rel="preload" as="font" href={href} type="font/woff2" crossorigin="anonymous" />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Sistema Zero" />
    <meta property="og:image" content={shareImage} />
    {shareImage.startsWith('https:') && <meta property="og:image:secure_url" content={shareImage} />}
    {shareType && <meta property="og:image:type" content={shareType} />}
    {shareCard && <meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />}
    {shareCard && <meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />}
    <meta property="og:image:alt" content={ogImageAlt ?? shareTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body id="topo" class="min-h-screen bg-bg text-ink antialiased">
    <slot />
    <Analytics />
  </body>
</html>
