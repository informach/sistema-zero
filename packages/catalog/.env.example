# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Porta do serviço de catálogo (gateway=3000, payments=3001, auth=3002, catalog=3003).
PORT=3003
# Endereço de bind. `::` (default) = dual-stack IPv4+IPv6 — obrigatório no Railway
# (private networking resolve IPv6). Não mude em produção.
HOST=::
# Teto do corpo da requisição (bytes). Cadastros de produto/oferta são pequenos. 64 KB.
MAX_REQUEST_BODY_BYTES=65536

# ── Banco (Postgres COMPARTILHADO do monorepo — schema `catalog`) ───────────
# Mesmo Postgres do payments/auth/funnel (Docker porta 5433). A migration cria o schema.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistemazero
DATABASE_POOL_MAX=10

# ── Micro-cache das leituras públicas ───────────────────────────────────────
# TTL (ms) do cache em memória de GET /catalog/{offers,products}/:slug (hot path
# da página de vendas do funil). Ausente → 30000 (30s) em produção, 0 fora dela.
# 0 desliga. A quote (valor de cobrança) NUNCA é cacheada. Staleness máxima de
# preço/copy após edição no admin = este TTL (por réplica).
# PUBLIC_CACHE_TTL_MS=30000

# ── Autorização admin ───────────────────────────────────────────────────────
# As rotas de escrita (POST/PATCH) são protegidas por JWT (role admin/staff) NO GATEWAY,
# que injeta os headers X-Auth-User-* confiáveis. Este serviço confere o role como
# defesa em profundidade. Em dev, fora do gateway, é possível desligar a checagem.
# Em PRODUÇÃO não pode ser desligada (boot falha).
REQUIRE_ADMIN=true

# ── Token interno (defesa em profundidade) ──────────────────────────────────
# Prova de origem nas rotas admin/escrita + redeem (o gateway injeta x-internal-token
# via header-inject = CATALOG_INTERNAL_TOKEN do gateway) e na rota S2S de entitlements
# (o members envia o mesmo valor = CATALOG_INTERNAL_TOKEN do members). Vazio em dev
# (checagem desligada); OBRIGATÓRIO em produção (>= 16 chars, boot falha sem ele).
# INTERNAL_API_TOKEN=troque-por-um-token-aleatorio

# DSN do Sentry (monitoramento de erros). Ausente = desligado (dev/local). Captura:
# exceções inesperadas (500 do error-handler, process handlers) + TODO log de nível
# ERROR (espelho — "log ERROR = sinal alertável"). Sem PII (sendDefaultPii=false).
# SENTRY_DSN=
